// case: probes/fill_reshape
// clause: box 15 probe: `fill` of narrow, Bool and wide elements through slices, views and a parameter, and `reshape` of local and module-level arrays (view.fill, view.reshape)
// entry: run; args: none

I16[6] cells = [1, 2, 3, 4, 5, 6];
I256[2, 2] wide;

void paint(inout I64[_, _] a, I64 v) {
    fill(a[1, ..], v);
    fill(transpose(a)[0, ..], v + 1);
}

export I64 run() {
    I64[2, 3] m;
    paint(m, 4);
    Bool[3] b;
    fill(b[1..], true);
    I128[3] w;
    fill(reverse(w, 0)[0..2], -(1 as I128 << 100));
    I64[24] flat;
    for i in 0..24 {
        flat[i] = i;
    }
    fill(reshape(flat, 6, 4)[1, 1..3], -1);
    fill(reshape(cells, 2, 3)[1, ..], 0);
    fill(wide, 7);
    fill(reshape(wide, 4)[1..3], -3);
    I64 r = m[0, 0] * 1000 + m[1, 2] * 100 + reshape(flat, 2, 3, 4)[1, 2, 3] + reshape(reshape(flat, 4, 6), 24)[5];
    if (b[0] || !b[2] || w[0] != 0 || w[2] != -(1 as I128 << 100)) {
        return -1;
    }
    if (wide[0, 0] != 7 || wide[0, 1] != -3 || wide[1, 0] != -3 || reshape(wide, 4)[3] != 7) {
        return -2;
    }
    return r * 100 + sum(I64, cells) + transpose(reshape(flat, 4, 6))[5, 0];
}
