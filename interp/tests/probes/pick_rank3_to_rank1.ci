// case: probes/pick_rank3_to_rank1
// clause: box 13 unit 7 probe: rank-1 views picked from a rank-3 array, passed to a size parameter (view.pick, view.end)
// entry: run; args: none

I64 last[n](in I64[n] v) {
    return v[n - 1] * 10 + n;
}

export I64 run() {
    I64[2, 3, 4] t;
    t[1, 2, 3] = 7;
    t[0, 2, 1] = 5;
    return last(t[1, 2]) * 1000 + last(t[0, .., 1]);
}
