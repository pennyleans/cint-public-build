// case: probes/struct_fields_rank
// clause: BX22-06 probe: struct fields of rank 2 to 4 read and written by element, passed as views and rows, copied with their struct, assigned whole and constructed
// entry: run; args: none

struct Motion { I64[4, 3] pos; I64[4] gm; I64 tick; }
struct Flags { Bool[2, 2] on; U8[2, 3, 2] code; I16[1, 2, 2, 3] four; }
struct State { Motion m; Flags f; }

I64 total[n](in I64[n, 3] v) {
    I64 s = 0;
    for i in 0..n {
        for j in 0..3 {
            s += v[i, j] * (i * 3 + j + 1);
        }
    }
    return s;
}

void paint(inout I64[_, _] v, I64 base) {
    for i in 0..extent(v, 0) {
        for j in 0..extent(v, 1) {
            v[i, j] = base + i * 10 + j;
        }
    }
}

I64 row_sum(in I64[_] r) {
    return r[0] + r[1] + r[2];
}

void advance(inout Motion m) {
    m.pos[3, 2] += 5;
    m.tick += 1;
}

export I64 run() {
    State s;
    paint(s.m.pos, 1);
    advance(s.m);
    s.f.on[1, 0] = true;
    s.f.code[1, 2, 1] = 200 as U8;
    s.f.four[0, 1, 1, 2] = -3 as I16;
    State t = s;
    s.m.pos[0, 0] = 99;
    I64[4, 3] a;
    a[2, 1] = 8;
    I64[4] g;
    g[3] = 4;
    Motion c = Motion(a, g, 5);
    t.m.pos[1..3, ..] = c.pos[..2, ..];
    I64 r = total(t.m.pos) + row_sum(t.m.pos[3]) + c.pos[2, 1] * 1000;
    if (t.f.on[1, 0]) {
        r += (t.f.code[1, 2, 1] as I64) + (t.f.four[0, 1, 1, 2] as I64) + t.m.tick;
    }
    return r + s.m.pos[0, 0];
}
