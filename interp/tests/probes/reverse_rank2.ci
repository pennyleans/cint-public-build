// case: probes/reverse_rank2
// clause: box 13 unit 7 probe: reverse along each dimension of a rank-2 array (view.reverse)
// entry: run; args: none

export I64 run() {
    I64[2, 3] m;
    for i in 0..2 {
        for j in 0..3 {
            m[i, j] = i * 10 + j;
        }
    }
    in I64[_, _] r = reverse(m, 1);
    in I64[_, _] q = reverse(m, 0);
    return r[0, 0] * 10000 + r[1, 2] * 100 + q[0, 1] + extent(r, 1) * 1000000;
}
