// Module-level handles in a checkpoint on both backends (box 13, decision on OQ-242;
// rt/OPEN.md RT-OQ-50; interp/tests/state_host.c). Each `run` counts its call, removes from
// `jobs` the slot `oldest` names from its third call on, moves `newest` into `oldest`,
// inserts ten times its count as `newest`, allocates its count of elements in `trail` as
// `span` and fills them with its count. It returns, as decimal digits, the value `oldest`
// names (from its second call on), the value `newest` names and the sum of `span`. A run after
// a restore returns what the run after the checkpoint returned only when the handles came
// back with the pool and the arena.

Pool(I64, 2) jobs;
Arena(I64, 64) trail;
I64 calls = 0;
Handle(I64) oldest;
Handle(I64) newest;
Handle(I64[]) span;

export I64 run() {
    calls += 1;
    if (calls > 2) {
        jobs.remove(oldest);
    }
    oldest = newest;
    newest = jobs.insert(calls * 10);
    span = trail.alloc(calls);
    for i in 0..calls {
        trail[span][i] = calls;
    }
    I64 d = jobs[newest] * 100 + sum(trail[span]);
    if (calls > 1) {
        d += jobs[oldest] * 10000;
    }
    return d;
}
