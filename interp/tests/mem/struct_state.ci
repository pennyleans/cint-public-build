// Module-level structs in a checkpoint on both backends (box 15, decision on OQ-260; rt/OPEN.md
// RT-OQ-51; interp/tests/state_host.c). Each `run` counts its call, shifts the count into
// `track.last`, counts it in `track.hits` by its remainder mod 4, flips the Bool of the cell of
// `track.cells` at its remainder mod 2, adds it to `track.grid` (rank 2) in the row of its
// remainder mod 2, and adds it to `tail.n`, then returns the digits of `track.last` (three),
// `track.hits` (four), the cells' Bools (two) and `tail.n`'s last. A run after a restore returns
// what the run after the checkpoint returned only when the structs came back.

struct Cell { I64 count; Bool odd; }
struct Track { I64[3] last; U8[4] hits; Cell[2] cells; I64[2, 2] grid; }
struct Tail { I64 n; I64 sq; }

I64 calls = 0;
Track track = Track([7, 8, 9], [0, 0, 0, 0], [Cell(0, false), Cell(0, true)], [[0, 0], [0, 0]]);
Tail tail;

void shift(inout I64[_] xs, I64 v) {
    xs[0] = xs[1];
    xs[1] = xs[2];
    xs[2] = v;
}

export I64 run() {
    calls += 1;
    shift(track.last, calls);
    track.hits[calls % 4] += 1;
    track.cells[calls % 2].odd = !track.cells[calls % 2].odd;
    track.cells[calls % 2].count += calls;
    track.grid[calls % 2, 1] += calls;
    tail.n += calls;
    tail.sq = tail.n * tail.n;
    I64 d = track.last[0] * 100 + track.last[1] * 10 + track.last[2];
    for i in 0..4 {
        d = d * 10 + track.hits[i] as I64;
    }
    for i in 0..2 {
        d = d * 10;
        if (track.cells[i].odd) {
            d += 1;
        }
    }
    return d * 10 + tail.n % 10;
}
