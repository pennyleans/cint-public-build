// compiler/scan.ci: source text to tokens (SPEC-04 3.1 to 3.9 and 18.1; SPEC-09 CINTC-01,
// CINTC-02, DIAG-01; slice 2 task 2.10a).
//
// Two phases, as SPEC-04 LS-282 orders diagnostics by the earliest phase that finds one
// (decision patch D-11). check_text applies the source-text rules of SPEC-04 3.1 and 3.2
// to the whole file: C1002 (a byte-order mark, invalid UTF-8, a NUL byte), C1003 (a
// forbidden invisible or bidirectional character), C1004 (a control character or a CR not
// followed by LF). Only a file without such an error is lexed. The lexer then produces one
// Token per token of SPEC-04 18.1 and a final TK_EOF, and reports C1005, C1012, C1013,
// C1020 to C1024, C1030 to C1032, C1034, C1038, and C1050. Each token gets at most one
// diagnostic, the first that `cint_ref` would raise for it, and scanning resumes after it,
// so the least diagnostic is the one `cint_ref` reports.
//
// Positions (DIAG-01): lines are 1-based; columns are 1-based and nscalar Unicode scalar
// values, so a UTF-8 continuation byte does not advance the column and a tab counts one.
// A CR LF pair is one line end. Token.start and Token.len are byte offsets into the source.
//
// Literals. A literal of more than 4,096 bits of magnitude is C1023 at its first character
// (SPEC-04 LS-31, decision patch D-17). The scanner decides this from the digits alone: for
// radixes 16, 8 and 2 from the digit nscalar and the leading digit, for radix 10 and the
// balanced ternary of radix 3 by comparing the digits with those of 2^4096. Literal values
// are converted by fold.ci. A character literal's scalar value is in Token.aux.
//
// Holes. scan_hole lexes the text of an interpolation hole for the parser (SPEC-04 9.2) in
// the way `cint_ref` lexes it: on demand, so a lexing error is no diagnostic but a TK_ERROR
// token that ends the hole's tokens, whose start is the offset where that token began
// (whitespace included) and whose position is where the lexer stopped.
//
// Divergences from `cint_ref` (compiler/OPEN.md CINTC-OQ-06): a digit is an ASCII digit
// (SPEC-04 18.1 `digit`), where `cint_ref` also takes other Unicode decimal digits after a
// numeral's `.` and in a fixed-point type name.
//
// Bound (CINTC-13): O(n) for n source bytes; a C1023 comparison is O(1,234) or O(2,585).

import limits;

// One token: kind (TK_*), sub (OP_*, KW_*, or a literal's radix), the byte offset and
// length of its text, its line and column, the index after its matching bracket (parse.ci
// sets it for `(` and `[`), and aux (an identifier's class, a character's scalar value).
export struct Token {
    I32 kind;
    I32 sub;
    I32 start;
    I32 len;
    I32 line;
    I32 col;
    I32 match;
    I32 aux;
}

// Bytes of one Token: the element size of the token table (CINTC-02, CINTC-14).
export const I64 TOKEN_BYTES = 32;

// Token kinds. TK_ERROR occurs only in the tokens of a hole.
export const I32 TK_EOF = 0;
export const I32 TK_IDENT = 1;
export const I32 TK_KEYWORD = 2;
export const I32 TK_INT = 3;
export const I32 TK_FRAC = 4;
export const I32 TK_CHAR = 5;
export const I32 TK_STRING = 6;
export const I32 TK_BYTES = 7;
export const I32 TK_FIXED = 8;
export const I32 TK_OP = 9;
export const I32 TK_ERROR = 10;

// Operators (Token.sub of TK_OP), SPEC-04 3.9 and 18.6.
export const I32 OP_ADD = 1;
export const I32 OP_SUB = 2;
export const I32 OP_MUL = 3;
export const I32 OP_DIV = 4;
export const I32 OP_REM = 5;
export const I32 OP_LT = 6;
export const I32 OP_GT = 7;
export const I32 OP_BAND = 8;
export const I32 OP_BOR = 9;
export const I32 OP_BXOR = 10;
export const I32 OP_TILDE = 11;
export const I32 OP_BANG = 12;
export const I32 OP_QUESTION = 13;
export const I32 OP_COLON = 14;
export const I32 OP_ASSIGN = 15;
export const I32 OP_LPAREN = 16;
export const I32 OP_RPAREN = 17;
export const I32 OP_LBRACKET = 18;
export const I32 OP_RBRACKET = 19;
export const I32 OP_LBRACE = 20;
export const I32 OP_RBRACE = 21;
export const I32 OP_COMMA = 22;
export const I32 OP_SEMI = 23;
export const I32 OP_DOT = 24;
export const I32 OP_AT = 25;
export const I32 OP_SHL = 26;
export const I32 OP_SHR = 27;
export const I32 OP_ADD_WRAP = 28;
export const I32 OP_SUB_WRAP = 29;
export const I32 OP_MUL_WRAP = 30;
export const I32 OP_ADD_SAT = 31;
export const I32 OP_SUB_SAT = 32;
export const I32 OP_MUL_SAT = 33;
export const I32 OP_EQ = 34;
export const I32 OP_NE = 35;
export const I32 OP_LE = 36;
export const I32 OP_GE = 37;
export const I32 OP_AND = 38;
export const I32 OP_OR = 39;
export const I32 OP_INC = 40;
export const I32 OP_DEC = 41;
export const I32 OP_ADD_ASSIGN = 42;
export const I32 OP_SUB_ASSIGN = 43;
export const I32 OP_MUL_ASSIGN = 44;
export const I32 OP_DIV_ASSIGN = 45;
export const I32 OP_REM_ASSIGN = 46;
export const I32 OP_BAND_ASSIGN = 47;
export const I32 OP_BOR_ASSIGN = 48;
export const I32 OP_BXOR_ASSIGN = 49;
export const I32 OP_RANGE = 50;
export const I32 OP_SHL_ASSIGN = 51;
export const I32 OP_SHR_ASSIGN = 52;
export const I32 OP_ADD_WRAP_ASSIGN = 53;
export const I32 OP_SUB_WRAP_ASSIGN = 54;
export const I32 OP_MUL_WRAP_ASSIGN = 55;
export const I32 OP_ADD_SAT_ASSIGN = 56;
export const I32 OP_SUB_SAT_ASSIGN = 57;
export const I32 OP_MUL_SAT_ASSIGN = 58;
export const I32 OP_RANGE_INCL = 59;
