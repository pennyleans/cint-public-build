export const I32 OP_AS_TRY = 64;

// Keywords (Token.sub of TK_KEYWORD), the reserved words of SPEC-04 3.4.
export const I32 KW_AS = 1;
export const I32 KW_ASSERT = 2;
export const I32 KW_BREAK = 3;
export const I32 KW_BY = 4;
export const I32 KW_CASE = 5;
export const I32 KW_CATCH = 6;
export const I32 KW_CONST = 7;
export const I32 KW_CONTINUE = 8;
export const I32 KW_DEFAULT = 9;
export const I32 KW_DEFER = 10;
export const I32 KW_DO = 11;
export const I32 KW_ELSE = 12;
export const I32 KW_ENUM = 13;
export const I32 KW_ERROR = 14;
export const I32 KW_EXPECT_FAULT = 15;
export const I32 KW_EXPORT = 16;
export const I32 KW_FALLTHROUGH = 17;
export const I32 KW_FALSE = 18;
export const I32 KW_FOR = 19;
export const I32 KW_IF = 20;
export const I32 KW_IMPORT = 21;
