    reduce r14 = sum(a[i]);
    reduce r15 = sum(a[i]);
    reduce r16 = sum(a[i]);
    reduce r17 = sum(a[i]);
    reduce r18 = sum(a[i]);
    reduce r19 = sum(a[i]);
    reduce r20 = sum(a[i]);
    reduce r21 = sum(a[i]);
    reduce r22 = sum(a[i]);
    reduce r23 = sum(a[i]);
    reduce r24 = sum(a[i]);
    reduce r25 = sum(a[i]);
    reduce r26 = sum(a[i]);
    reduce r27 = sum(a[i]);
    reduce r28 = sum(a[i]);
    reduce r29 = sum(a[i]);
    reduce r30 = sum(a[i]);
}

export I64 run() {
    I64[2] a = [3, 4];
    I64 r0 = 0;
    I64 r1 = 0;
    I64 r2 = 0;
    I64 r3 = 0;
    I64 r4 = 0;
    I64 r5 = 0;
    I64 r6 = 0;
    I64 r7 = 0;
