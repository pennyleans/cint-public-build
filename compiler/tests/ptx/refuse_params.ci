    I64 r17 = 0;
    I64 r18 = 0;
    I64 r19 = 0;
    I64 r20 = 0;
    I64 r21 = 0;
    I64 r22 = 0;
    I64 r23 = 0;
    I64 r24 = 0;
    I64 r25 = 0;
    I64 r26 = 0;
    I64 r27 = 0;
    I64 r28 = 0;
    I64 r29 = 0;
    I64 r30 = 0;
    k(a, r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15, r16, r17, r18, r19,
            r20, r21, r22, r23, r24, r25, r26, r27, r28, r29, r30);
    return r0 + r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15 +
        r16 + r17 + r18 + r19 + r20 + r21 + r22 + r23 + r24 + r25 + r26 + r27 + r28 + r29 + r30;
