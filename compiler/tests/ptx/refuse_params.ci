// The refusal of an entry with more than rt/cint_cuda.h's 61 parameters after p_base,
// p_end and p_fault (two for each of 31 `reduce` targets, and the view a) by
// compiler/back_ptx.ci (box 11 unit 3; compiler/tests/ptx_suite.py).

kernel k[n](in I64[n] a, out I64 r0, out I64 r1, out I64 r2, out I64 r3, out I64 r4, out I64 r5,
        out I64 r6, out I64 r7, out I64 r8, out I64 r9, out I64 r10, out I64 r11, out I64 r12,
        out I64 r13, out I64 r14, out I64 r15, out I64 r16, out I64 r17, out I64 r18, out I64 r19,
        out I64 r20, out I64 r21, out I64 r22, out I64 r23, out I64 r24, out I64 r25, out I64 r26,
        out I64 r27, out I64 r28, out I64 r29, out I64 r30) over [i: n] {
    reduce r0 = sum(a[i]);
    reduce r1 = sum(a[i]);
    reduce r2 = sum(a[i]);
    reduce r3 = sum(a[i]);
    reduce r4 = sum(a[i]);
    reduce r5 = sum(a[i]);
    reduce r6 = sum(a[i]);
    reduce r7 = sum(a[i]);
    reduce r8 = sum(a[i]);
    reduce r9 = sum(a[i]);
