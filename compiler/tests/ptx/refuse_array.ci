// The refusal of a local array in a work-item body by compiler/back_ptx.ci (box 11 unit 3;
// compiler/tests/ptx_suite.py).

kernel k[n](in I64[n] a, out I64[n] r) over [i: n] {
    I64[2] t = [a[i], 1];
    r[i] = t[0] + t[1];
}

export I64 run() {
    I64[2] a = [3, 4];
    I64[2] r;
    k(a, r);
    return r[1];
}
