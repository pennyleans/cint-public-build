// `fill` and `reshape` (SPEC-04 LS-145; SPEC-02 V-10, V-11; box 15): `fill` at every
// integer type, Bool and the wide types, into local and module-level arrays, slices,
// transposed, reversed and reshaped views and an `inout` parameter; `reshape` of local and
// module-level arrays of ranks 1 to 4 and of another reshape, as a value, an argument and
// the destination or source of `copy`; then an index past a reshaped extent faults.

I32[6] cells = [1, 2, 3, 4, 5, 6];
I512[2, 2] wide;

void paint(inout I64[_, _] a, I64 v) {
    fill(a[1, ..], v);
    fill(transpose(a)[0, ..], v + 1);
}

I64 corner(in I64[_, _] a) {
    return a[extent(a, 0) - 1, extent(a, 1) - 1];
}

void main() {
    I8[3] i8;
    fill(i8, -128);
    I16[3] i16;
    fill(i16[1..], 32767);
    I32[3] i32;
    fill(reverse(i32, 0)[0..2], -7);
    I64[3] i64;
    fill(i64, 9223372036854775807);
    "{i8[2]} {i16[0]} {i16[2]} {i32[0]} {i32[2]} {i64[1]}\n";
    U8[2] u8;
    fill(u8, 255);
    U16[2] u16;
    fill(u16, 65535);
    U32[2] u32;
    fill(u32, 4294967295);
    U64[2] u64;
    fill(u64, 18446744073709551615);
    Bool[2] b;
    fill(b, true);
    "{u8[1]} {u16[1]} {u32[1]} {u64[1]} {b[0]} {b[1]}\n";
    I128[2] w128;
    fill(w128, -170141183460469231731687303715884105728);
    I256[3] w256;
    fill(w256[1..3], 1 as I256 << 200);
    I1024[2] w1024;
    fill(w1024, (1 as I1024 << 1000) - 1);
    "{w128[1]} {w256[0]} {w256[2]:x} {w1024[0] == (1 as I1024 << 1000) - 1}\n";

    I64[2, 3] m;
    paint(m, 4);
    "{m[0, 0]} {m[0, 1]} {m[1, 0]} {m[1, 2]} {corner(m)}\n";

    I64[24] flat;
    for i in 0..24 {
        flat[i] = i;
    }
    "{reshape(flat, 2, 3, 4)[1, 2, 3]} {reshape(flat, 4, 6)[3, 0]} {reshape(flat, 1, 2, 3, 4)[0, 1, 0, 2]}\n";
    "{reshape(reshape(flat, 4, 6), 24)[23]} {sum(reshape(flat, 6, 4)[5, ..])} {corner(reshape(flat, 3, 8))}\n";
    "{transpose(reshape(flat, 4, 6))[5, 3]} {extent(reshape(flat, 2, 12), 1)} {size(reshape(flat, 3, 2, 4))}\n";
    I64[4, 6] grid = reshape(flat, 4, 6);
    "{grid[2, 5]} {sum(reshape(grid, 24))}\n";
    copy(reshape(flat, 4, 6)[0, ..], reshape(flat, 4, 6)[3, ..]);
    fill(reshape(flat, 6, 4)[1, 1..3], -1);
    "{flat[0]} {flat[5]} {flat[6]} {flat[7]} {flat[18]}\n";
    I64[0] none = [];
    fill(reshape(none, 0, 3), 1);
    "{extent(reshape(none, 2, 0, 5), 2)}\n";

    fill(reshape(cells, 2, 3)[1, ..], 0);
    fill(wide, -1);
    fill(reshape(wide, 4)[1..3], 3);
    "{sum(cells)} {reshape(cells, 3, 2)[0, 1]} {wide[0, 0]} {wide[0, 1]} {wide[1, 1]}\n";

    I64[2, 2, 2] cube;
    fill(cube, 1);
    "{reshape(cube, 2, 4)[1, 3]} {reshape(cube, 8)[flat[0] - 10]}\n";
}
