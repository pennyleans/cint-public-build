// compiler/back_qbe.ci: the cpu-qbe backend (SPEC-09 BACK-18; docs/design/cpu-qbe.md).
//
// Verified SIR of one module to one QBE SSA module, and the program-level SSA (`cint-program`),
// which QBE, an assembler and a linker turn into the program; no C compiler sees emitted code.
// The functions, descriptors and symbols are the ones back_c.ci writes in C (EMIT-22 names,
// the cint-rt-3 structures, the observer entries of CONF-13), so the runtime, cint-harness
// and `cint run` take a cpu-qbe program as they take a cpu-c17 one.
//
// Values. Every integer of 64 bits or fewer and every Bool is one QBE `l` temporary holding
// its value: sign-extended for a signed type, zero-extended for an unsigned one, 0 or 1 for
// Bool. A wrapping result is cut back to its type with one extension. SIR temporary d is
// `%t<d>`, slot k (a parameter or a local) is `%s<k>`; QBE builds SSA from them.
//
// Checks. Every operation that can fault calls the runtime's cpu-qbe entry point for it
// (rt/cint_qbe.c), the helper emitted C inlines, so its record, site and fuel are the C
// build's by construction (BACK-03); its int32 result branches to the function's one fault
// exit, `@fault`, which returns 0. Calls take cint_rt_call_enter's protocol, never the lean
// one, so funcs[].lean is not read.
//
// Phases. Q1 admits the scalar surface: the integer and Bool types, locals, arithmetic,
// conversions, comparisons, the integer built-ins of narrow results, assertions, prints,
// structured control flow, calls within the program, fuel, `test` blocks, scripts, `main`
// and observer entries. Q2 adds scalar module state, and arrays and views of scalars in a
// function's frame: index checks, slices, picks, transposes, reversals, copies, reductions,
// `equal`, `fill`, `reshape`, byte strings and the frame arena's charges, and records of Bool
// and integer fields with the root's record catalog. check_qbe refuses
// every other function, slot, type and node with its capability (CAP_*), so a build never
// falls back to cpu-c17.

import back_c;
import decl;
import emit;
import fold;
import limits;
import lowering;
import parse;
import resolve;
import scan;
import sha256;
import verify;

export const I64 CAP_ENTRY = 1;
export const I64 CAP_STORAGE = 2;
export const I64 CAP_NODE = 3;
export const I64 CAP_TYPE = 4;
export const I64 CAP_MODULE = 5;
export const I64 CAP_SYMBOL = 6;

// QBE (1.2 and the 1.3 pin) reads an identifier of at most NString - 1 = 79 bytes after its
// sigil, and a cint_module path component C(P) leaves room for the longest suffix back_qbe
// writes after `cg` C(P), `_qp<node>_<piece>` with ten digits each: 24 bytes.
const I64 QBE_NAME_MAX = 79;
const I64 SUFFIX_MAX = 24;
// The bytes an internal name may have before it is hashed (cg_part, fn_sym).
const I64 NAME_BUF = 1024;

// The runtime ABI version, CINT_ABI_VERSION of rt/cint_rt.h (tools/cint_qbe_check.py checks it).
const I64 ABI_VERSION = 196612;

// The state of one writing: the function being written, the module, and the block state
// (term 1 after a jump or a return, so the next instruction opens a fresh block @u<nlab>).
struct QState {
    I64 fn;
    I64 root;
    I64 module;
    I64 at;
    I64 len;
    I64 term;
    I64 nlab;
    I64 nsir;
    I64 nslot;
    I64 nfunc;
}

// ---------------------------------------------------------------- capabilities

// A value in one `l` temporary: Bool, an integer of 64 bits or fewer, or fixed point of 64 bits
// or fewer, which is its storage integer (SPEC-01 IM-57).
Bool scalar(I32 ty) {
    return ty == lowering.T_BOOL || (ty >= lowering.T_I8 && ty <= lowering.T_I64) ||
        (ty >= lowering.T_U8 && ty <= lowering.T_U64) || (lowering.is_q(ty) && !lowering.is_limbs(ty));
}

// Whether the values of ty are signed: a signed integer, or fixed point, whose storage integer is.
Bool signed(I32 ty) {
    return lowering.is_signed(back_c.st_of(ty));
}

// A local array of scalars with a static extent (SK_ARRAY), or a view parameter of rank 1 of
// scalars (SK_VIEW): Q2's array storage.
Bool array_slot(in lowering.SirSlot[_] slots, I64 k) {
    I32 sk = slots[k].kind;
    return (sk == lowering.SK_ARRAY || sk == lowering.SK_VIEW || sk == lowering.SK_APLACE) &&
        layout_ok(slots, elem_of(slots[k].ty));
}

I64 fn_refusal(in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, I64 fn, Bool root) {
    I32 allowed = lowering.FN_EXPORT | lowering.FN_SCRIPT | lowering.FN_MAIN | lowering.FN_OBSERVE |
        lowering.FN_USED | lowering.FN_FAULT | lowering.FN_FALLS | lowering.FN_IMPORT | lowering.FN_TEST |
        lowering.FN_OBSERVES | lowering.FN_SPEC | lowering.FN_FRAME | lowering.FN_ISTRUCT | lowering.FN_ICONST |
        lowering.FN_IVAR | lowering.FN_ERRU | lowering.FN_EXTERN | lowering.FN_UNRESTRICTED | lowering.FN_GRANTS |
        lowering.FN_ARGS | lowering.FN_SCRATCH;
    if ((funcs[fn].flags & lowering.FN_ERRU) != 0) {
        allowed = allowed | 16711680;   // the error set's underlying type (lowering.func_etag)
    }
    // An entry has a wrapper with the C ABI: an export of the root module (A-12), a script,
    // `main` or an observer. A library module's export is called by QBE-built code only.
    I32 entry = lowering.FN_SCRIPT | lowering.FN_MAIN | lowering.FN_OBSERVE;
    if (root) { entry = entry | lowering.FN_EXPORT; }
    if ((funcs[fn].flags & ~allowed) != 0) {
        return CAP_ENTRY;
    }
    // A root export's cx wrapper (A-12) binds views and records and copies a record result
    // (w_cx); one with a `Grants` parameter has no wrapper. Scripts, `main` and observers take
    // scalars only.
    I32 other = lowering.FN_SCRIPT | lowering.FN_MAIN | lowering.FN_OBSERVE;
    Bool cx = root && (funcs[fn].flags & lowering.FN_EXPORT) != 0 && (funcs[fn].flags & lowering.FN_GRANTS) == 0;
    Bool wrapped = cx && (funcs[fn].flags & other) == 0;
    // A record result (by the caller's address) of a function that is not an entry, or of a
    // public export that is not an error union.
    Bool rec = funcs[fn].result >= lowering.T_STRUCT && layout_ok(slots, funcs[fn].result) &&
        ((funcs[fn].flags & entry) == 0 || (wrapped && (funcs[fn].flags & lowering.FN_ERRU) == 0));
    Bool hres = boxed(funcs[fn].result) && (funcs[fn].flags & entry) == 0;
    if (funcs[fn].result != lowering.T_NONE && !scalar(funcs[fn].result) && !rec && !hres) {
        return CAP_TYPE;
    }
    if ((funcs[fn].flags & (lowering.FN_IMPORT | lowering.FN_EXTERN)) != 0) {
        return 0;
    }
    I64 p0 = funcs[fn].pslot0 as I64;
    for p in p0..p0 + (funcs[fn].nparam as I64) {
        // A `Grants` handle, and `main`'s program arguments (FN_ARGS, its last parameter).
        Bool args = (funcs[fn].flags & lowering.FN_ARGS) != 0 &&
            p == p0 + (funcs[fn].nparam as I64) - 1 && slots[p].kind == lowering.SK_VIEW;
        if (lowering.is_grants(slots, p) || args) {
            continue;
        }
        // A view or record parameter of a function that is not an entry, or of a public export.
        Bool view = ((slots[p].kind == lowering.SK_VIEW && array_slot(slots, p)) || view_slot(slots, p) ||
            ((slots[p].kind == lowering.SK_SPARAM || slots[p].kind == lowering.SK_SREF) && record_slot(slots, p))) &&
            ((funcs[fn].flags & entry) == 0 || wrapped);
        Bool hp = boxed(slots[p].ty) && (funcs[fn].flags & entry) == 0;
        // An arena or a pool parameter is its identifier (C's uint32_t).
        Bool cp = (slots[p].kind == lowering.SK_ARENA_R || slots[p].kind == lowering.SK_POOL_R) &&
            (funcs[fn].flags & entry) == 0;
        if (cp) { continue; }
        if (!view && (slots[p].kind != lowering.SK_PARAM || !(scalar(slots[p].ty) || hp))) {
            return CAP_STORAGE;
        }
    }
    for k in funcs[fn].lslot0 as I64..funcs[fn].lslot_end as I64 {
        // An error set's description (a test block's, for SO_ERROR) and a conversion's runs
        // are data, not storage.
        I32 sk = slots[k].kind;
        if (sk == lowering.SK_ESET || sk == lowering.SK_EVAL || sk == lowering.SK_WIDEN || sk == lowering.SK_WRUN) {
            continue;
        }
        // A lease (40 bytes), an arena or pool held at run time (its identifier), a handle.
        if (sk == lowering.SK_LEASE || sk == lowering.SK_ARENA_R || sk == lowering.SK_POOL_R || scalar_place(slots, k) ||
                ((sk == lowering.SK_LOCAL || sk == lowering.SK_HIDDEN) && boxed(slots[k].ty))) {
            continue;
        }
        Bool arr = ((slots[k].kind == lowering.SK_ARRAY || slots[k].kind == lowering.SK_APLACE) &&
            array_slot(slots, k)) || view_slot(slots, k) ||
            ((slots[k].kind == lowering.SK_STRUCT || slots[k].kind == lowering.SK_SPLACE) && record_slot(slots, k));
        if (!arr && ((slots[k].kind != lowering.SK_LOCAL && slots[k].kind != lowering.SK_HIDDEN) ||
                !scalar(slots[k].ty))) {
            return CAP_STORAGE;
        }
    }
    return 0;
}

// Whether each argument of extern call i is a scalar, a string literal or a rank-1 view of a
// scalar element type.
Bool host_args_ok(in lowering.Sir[_] sir, in lowering.SirSlot[_] slots, I64 i) {
    for g in i - (sir[i].c as I64)..i {
        I64 e = sir[g].e as I64;
        if (e != 0 && e != 4 && !(e == 1 && any_view(slots, sir[g].a as I64))) {
            return false;
        }
    }
    return true;
}

// A pool element's place of scalar type (SK_SPLACE, SO_PREF): its address in `%s<k>`.
Bool scalar_place(in lowering.SirSlot[_] slots, I64 k) {
    return slots[k].kind == lowering.SK_SPLACE && scalar(slots[k].ty);
}

// Whether box 12 node i is admitted: its container's element is a scalar or a laid out record
// (a view of an allocation, SO_MVIEW, is a view slot), and a pool's element is reached by its
// place (SO_PREF) as a record's.
Bool mem_ok(in lowering.Sir[_] sir, in lowering.SirSlot[_] slots, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    if (k == lowering.SO_LEASE) { return true; }
    I64 c = sir[i].a as I64;
    if (k != lowering.SO_MEMBER) { c = sir[i].b as I64; }
    I32 ety = slots[c].ty;
    if (!(scalar(ety) || lowering.is_limbs(ety) || (ety >= lowering.T_STRUCT && layout_ok(slots, ety)))) { return false; }
    if (k == lowering.SO_MVIEW) { return view_slot(slots, sir[i].a as I64); }
    if (k == lowering.SO_PREF) { return record_slot(slots, sir[i].a as I64) || scalar_place(slots, sir[i].a as I64); }
    return true;
}

// ---------------------------------------------------------------- wide integers (Q3)
//
// A wide value is boxed (its limbs in frame storage, `%t<d>` their address), and every
// operation on one calls rt/cint_qbe_wide.c's cint_qw_<name>, cint_wide.h's cint_<name> out of
// line, with the operands emitted C gives the helper (back_c.c_wide): wide values by address,
// narrow values as `l`, the result by address, a count as its type's tag and address.

// A narrow integer: an operand or a result of a conversion that a wide one has on its other side.
Bool narrow_int(I32 ty) {
    return scalar(ty) && ty != lowering.T_BOOL;
}

// Whether wide node i (back_c.wide_node) is admitted: wide integers, not 128-bit fixed point
// (back_c.q_limbs_node), and no result-returning form.
Bool wide_ok(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I32 ty = sir[i].ty;
    if (back_c.q_limbs_node(sir, i) || back_c.q_node(sir, i)) {
        return false;
    }
    switch (k) {
        case lowering.SO_BIN:
            return sir[i].f != 3;
        case lowering.SO_CMP, lowering.SO_UN, lowering.SO_PRINT_VALUE:
            return true;
        case lowering.SO_AS:
            I32 from = sir[i].f;
            return (lowering.is_wide(ty) || narrow_int(ty)) && (lowering.is_wide(from) || narrow_int(from));
        default:
            // SO_BUILTIN
            I32 bo = lowering.builtin_opty(sir, i);
            if (!lowering.is_wide(bo) && !narrow_int(bo)) { return false; }
            if (!lowering.builtin_faults(sir, i) || lowering.builtin_rotates(sir, i) ||
                    sir[i].f as I64 == fold.BI_MULDIV) {
                return true;
            }
            return boxed(ty);
    }
}

// `$cint_qw_` and the name of binary node i (back_c.helper): add to shr, then _wrap, _sat or
// _result, then the type's suffix.
void qw_bin[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, I64 i) {
    text(w, dst, "$cint_qw_");
    switch (sir[i].c) {
        case lowering.B_ADD: text(w, dst, "add");
        case lowering.B_SUB: text(w, dst, "sub");
        case lowering.B_MUL: text(w, dst, "mul");
        case lowering.B_DIV: text(w, dst, "div");
        case lowering.B_REM: text(w, dst, "rem");
        case lowering.B_SHL: text(w, dst, "shl");
        case lowering.B_SHR: text(w, dst, "shr");
        case lowering.B_AND: text(w, dst, "and");
        case lowering.B_OR: text(w, dst, "or");
        default: text(w, dst, "xor");
    }
    if (sir[i].c < lowering.B_AND) {
        if (sir[i].f == 1) { text(w, dst, "_wrap"); }
        else if (sir[i].f == 2) { text(w, dst, "_sat"); }
    }
    emit.w_byte(w, dst, '_');
    back_c.ty_suffix(w, dst, sir[i].ty);
}

// `, l <operand v>`.
void arg_l[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in QState[_] q, I64 v) {
    text(w, dst, ", l ");
    opnd(w, dst, sir, funcs, q, v);
}

// `(l %ctx, <site>` of node i, after a checked entry point's name.
void qw_ctx[b](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] pbytes, inout QState[_] q, in lowering.Sir[_] sir,
        I64 i) {
    text(w, dst, "(l %ctx, ");
    site(w, dst, pbytes, q, sir[i].site as I64);
}

// `, l %t<dst>)` of node i, then the fault check when checked.
void qw_end[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, inout QState[_] q, I64 i,
        Bool checked_call) {
    text(w, dst, ", l ");
    tmp(w, dst, sir, i);
    line(w, dst, ")");
    if (checked_call) { checked(w, dst, q); }
}

// Wide node i (back_c.c_wide).
void w_wide[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    switch (k) {
        case lowering.SO_BIN:
            I32 op = sir[i].c;
            Bool shift = op == lowering.B_SHL || op == lowering.B_SHR;
            if (op >= lowering.B_AND || ((sir[i].f == 1 || sir[i].f == 2) && op != lowering.B_SHL)) {
                // Bitwise, wrapping and saturating forms never fault.
                ins(w, dst, q);
                text(w, dst, "call ");
                qw_bin(w, dst, sir, i);
                text(w, dst, "(l ");
                opnd(w, dst, sir, funcs, q, a);
                arg_l(w, dst, sir, funcs, q, bb);
                qw_end(w, dst, sir, q, i, false);
                return;
            }
            if (shift) {
                // The count first: a narrow one goes through %out.
                I32 ct = lowering.value_type(sir, funcs, slots, q[0].fn, bb);
                if (!lowering.is_wide(ct)) {
                    ins(w, dst, q);
                    text(w, dst, "storel ");
                    opnd(w, dst, sir, funcs, q, bb);
                    line(w, dst, ", %out");
                }
            }
            ins(w, dst, q);
            text(w, dst, "%ok =w call ");
            qw_bin(w, dst, sir, i);
            qw_ctx(w, dst, pbytes, q, sir, i);
            arg_l(w, dst, sir, funcs, q, a);
            if (shift) {
                I32 ct = lowering.value_type(sir, funcs, slots, q[0].fn, bb);
                text(w, dst, ", w ");
                num(w, dst, ct as I64);
                if (lowering.is_wide(ct)) { arg_l(w, dst, sir, funcs, q, bb); } else { text(w, dst, ", l %out"); }
            } else {
                arg_l(w, dst, sir, funcs, q, bb);
            }
            qw_end(w, dst, sir, q, i, true);
        case lowering.SO_UN:
            ins(w, dst, q);
            if (sir[i].c == lowering.U_NEG && sir[i].f == 0) {
                text(w, dst, "%ok =w call $cint_qw_neg_");
                back_c.ty_suffix(w, dst, ty);
                qw_ctx(w, dst, pbytes, q, sir, i);
                arg_l(w, dst, sir, funcs, q, a);
                qw_end(w, dst, sir, q, i, true);
                return;
            }
            if (sir[i].c == lowering.U_NEG) { text(w, dst, "call $cint_qw_neg_wrap_"); }
            else { text(w, dst, "call $cint_qw_not_"); }
            back_c.ty_suffix(w, dst, ty);
            text(w, dst, "(l ");
            opnd(w, dst, sir, funcs, q, a);
            qw_end(w, dst, sir, q, i, false);
        case lowering.SO_CMP:
            ins(w, dst, q);
            text(w, dst, "%xr =w call $cint_qw_");
            switch (sir[i].c) {
                case lowering.CMP_EQ: text(w, dst, "eq_");
                case lowering.CMP_NE: text(w, dst, "ne_");
                case lowering.CMP_LT: text(w, dst, "lt_");
                case lowering.CMP_LE: text(w, dst, "le_");
                case lowering.CMP_GT: text(w, dst, "gt_");
                default: text(w, dst, "ge_");
            }
            back_c.ty_suffix(w, dst, back_c.st_of(sir[i].f));
            text(w, dst, "(l ");
            opnd(w, dst, sir, funcs, q, a);
            arg_l(w, dst, sir, funcs, q, bb);
            line(w, dst, ")");
            ins(w, dst, q);
            tmp(w, dst, sir, i);
            line(w, dst, " =l extuw %xr");
        case lowering.SO_AS:
            I32 from = sir[i].f;
            if (from == ty) {
                ins(w, dst, q);
                text(w, dst, "blit ");
                opnd(w, dst, sir, funcs, q, a);
                text(w, dst, ", ");
                tmp(w, dst, sir, i);
                blit_n(w, dst, ty);
                return;
            }
            ins(w, dst, q);
            if (sir[i].c == 0) {
                text(w, dst, "%ok =w call $cint_qw_as_");
            } else if (lowering.is_wide(ty)) {
                text(w, dst, "call $cint_qw_as_");
            } else {
                tmp(w, dst, sir, i);
                text(w, dst, " =l call $cint_qw_as_");
            }
            if (sir[i].c == lowering.AS_SAT) { text(w, dst, "sat_"); }
            else if (sir[i].c != 0) { text(w, dst, "wrap_"); }
            back_c.ty_suffix(w, dst, ty);
            text(w, dst, "_from_");
            back_c.ty_suffix(w, dst, from);
            if (sir[i].c == 0) {
                qw_ctx(w, dst, pbytes, q, sir, i);
                arg_l(w, dst, sir, funcs, q, a);
                if (lowering.is_wide(ty)) {
                    qw_end(w, dst, sir, q, i, true);
                } else {
                    line(w, dst, ", l %out)");
                    checked(w, dst, q);
                    load_out(w, dst, sir, q, i);
                }
                return;
            }
            text(w, dst, "(l ");
            opnd(w, dst, sir, funcs, q, a);
            if (lowering.is_wide(ty)) { qw_end(w, dst, sir, q, i, false); } else { line(w, dst, ")"); }
        case lowering.SO_BUILTIN:
            I64 id = sir[i].f as I64;
            I32 bo = lowering.builtin_opty(sir, i);
            I64 nv = lowering.builtin_arity(sir, i);
            ins(w, dst, q);
            if (!lowering.builtin_faults(sir, i)) {
                // uabs, min, max and mul_full never fault.
                text(w, dst, "call $cint_qw_");
                fold.render_builtin(w, dst, id);
                emit.w_byte(w, dst, '_');
                back_c.ty_suffix(w, dst, bo);
                text(w, dst, "(l ");
                opnd(w, dst, sir, funcs, q, a);
                if (nv > 1) { arg_l(w, dst, sir, funcs, q, bb); }
                qw_end(w, dst, sir, q, i, false);
                return;
            }
            if (lowering.builtin_rotates(sir, i)) {
                I32 ct = lowering.value_type(sir, funcs, slots, q[0].fn, bb);
                if (!lowering.is_wide(ct)) {
                    text(w, dst, "storel ");
                    opnd(w, dst, sir, funcs, q, bb);
                    line(w, dst, ", %out");
                    ins(w, dst, q);
                }
                text(w, dst, "%ok =w call $cint_qw_");
                fold.render_builtin(w, dst, id);
                emit.w_byte(w, dst, '_');
                back_c.ty_suffix(w, dst, bo);
                qw_ctx(w, dst, pbytes, q, sir, i);
                arg_l(w, dst, sir, funcs, q, a);
                text(w, dst, ", w ");
                num(w, dst, ct as I64);
                if (lowering.is_wide(ct)) { arg_l(w, dst, sir, funcs, q, bb); } else { text(w, dst, ", l %out"); }
                qw_end(w, dst, sir, q, i, true);
                return;
            }
            // muldiv names its result's tag and writes a narrow result at its width; the others
            // go through cint_builtin_<t>, with 0 for an operand they do not take.
            if (id == fold.BI_MULDIV) { text(w, dst, "%ok =w call $cint_qw_muldiv_"); }
            else { text(w, dst, "%ok =w call $cint_qw_builtin_"); }
            back_c.ty_suffix(w, dst, bo);
            qw_ctx(w, dst, pbytes, q, sir, i);
            text(w, dst, ", w ");
            if (id == fold.BI_MULDIV) { num(w, dst, ty as I64); } else { num(w, dst, id); }
            text(w, dst, ", w ");
            num(w, dst, sir[i].val & 255);
            for j in 0..3 {
                if (j < nv) {
                    I64 v = a;
                    if (j == 1) { v = bb; } else if (j == 2) { v = sir[i].c as I64; }
                    arg_l(w, dst, sir, funcs, q, v);
                } else {
                    text(w, dst, ", l 0");
                }
            }
            if (boxed(ty)) {
                qw_end(w, dst, sir, q, i, true);
            } else {
                line(w, dst, ", l %out)");
                checked(w, dst, q);
                ins(w, dst, q);
                tmp(w, dst, sir, i);
                text(w, dst, " =l ");
                load_op(w, dst, ty);
                line(w, dst, " %out");
            }
        default:
            // SO_PRINT_VALUE: the decimal of a wide value (SPEC-04 LS-193), or its formatted text.
            ins(w, dst, q);
            if (sir[i].e == 0) { text(w, dst, "%ok =w call $cint_rt_print_wide(l %ctx, w "); }
            else { text(w, dst, "%ok =w call $cint_rt_print_format_wide(l %ctx, w "); }
            num(w, dst, ty as I64);
            arg_l(w, dst, sir, funcs, q, a);
            if (sir[i].e != 0) {
                text(w, dst, ", w ");
                num(w, dst, sir[i].e as I64);
                text(w, dst, ", w ");
                num(w, dst, sir[i].f as I64);
                text(w, dst, ", l ");
                num(w, dst, sir[i].val);
                text(w, dst, ", l ");
                num(w, dst, sir[i].c as I64);
            }
            bool_checked(w, dst, q);
    }
}

// ---------------------------------------------------------------- fixed point (Q3)
//
// A fixed-point value of 64 bits or fewer is its storage integer (scalar, signed): loaded,
// stored, compared, passed and returned as that integer is. An operation on one (back_c.q_node)
// calls rt/cint_qbe_fixed.c's cint_qf_<name>_<s>, cint_fixed.h's helper out of line, with the
// constants emitted C gives it (back_c.c_q): f, the mode and the type words (rt_tag). `+%`, `+|`,
// `-%`, `-|`, add_result, sub_result, min and max are the storage integer's (IM-60).

// Whether q_node i is admitted: 64 bits or fewer on each side, and an operation cint_fixed.h has.
Bool q_ok(in lowering.Sir[_] sir, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    if (back_c.q_limbs_node(sir, i)) {
        return q_limbs_ok(sir, i);
    }
    switch (k) {
        case lowering.SO_BIN:
            I32 op = sir[i].c;
            if (op < lowering.B_ADD || op > lowering.B_DIV) { return false; }
            if (sir[i].f == 3) { return (sir[i + 1].op & lowering.OP_MASK) == lowering.SO_ETAG; }
            return sir[i].f == 0 || (op != lowering.B_DIV && (sir[i].f == 1 || sir[i].f == 2));
        case lowering.SO_AS:
            if (!scalar(sir[i].f)) { return false; }
            return sir[i].c != 2 || (sir[i + 1].op & lowering.OP_MASK) == lowering.SO_ETAG;
        case lowering.SO_BUILTIN:
            I64 id = sir[i].f as I64;
            if (id == fold.BI_QMUL || id == fold.BI_MUL_INT) {
                return scalar(lowering.builtin_opty(sir, i)) && scalar(lowering.builtin_btype(sir, i));
            }
            return id == fold.BI_MIN || id == fold.BI_MAX || id == fold.BI_ABS || id == fold.BI_SQRT;
        default:
            // SO_UN (neg) and SO_PRINT_VALUE.
            return true;
    }
}

// `w <v>` after a comma.
void arg_w[b](inout emit.Writer[_] w, inout U8[b] dst, I64 v) {
    text(w, dst, ", w ");
    num(w, dst, v);
}

// Fixed-point node i (back_c.c_q).
void w_q[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    I64 f = lowering.frac_of(ty);
    switch (k) {
        case lowering.SO_BIN:
            I32 op = sir[i].c;
            if (op != lowering.B_MUL && op != lowering.B_DIV && sir[i].f != 0) {
                w_bin(w, dst, sir, funcs, slots, pbytes, q, i);
                return;
            }
            ins(w, dst, q);
            if (sir[i].f == 3) {
                // mul_result and div_result round by the mode; the tag to the SO_ETAG node right
                // after, the value when the tag is 0.
                text(w, dst, "%xr =w call $cint_qf_");
                if (op == lowering.B_MUL) { text(w, dst, "mul_result_"); } else { text(w, dst, "div_result_"); }
                suffix(w, dst, ty);
                text(w, dst, "(w ");
                num(w, dst, f);
                arg_w(w, dst, sir[i].val);
                arg_l(w, dst, sir, funcs, q, a);
                arg_l(w, dst, sir, funcs, q, bb);
                line(w, dst, ", l %out)");
                if (sir[i + 1].dst >= 0) {
                    ins(w, dst, q);
                    tmp(w, dst, sir, i + 1);
                    line(w, dst, " =l extuw %xr");
                }
                if (sir[i].dst >= 0) { load_out(w, dst, sir, q, i); }
                return;
            }
            if (sir[i].f != 0) {
                tmp(w, dst, sir, i);
                if (sir[i].f == 1) { text(w, dst, " =l call $cint_qf_mul_wrap_"); } else { text(w, dst, " =l call $cint_qf_mul_sat_"); }
                suffix(w, dst, ty);
                text(w, dst, "(w ");
                num(w, dst, f);
                arg_w(w, dst, sir[i].val);
                arg_l(w, dst, sir, funcs, q, a);
                arg_l(w, dst, sir, funcs, q, bb);
                line(w, dst, ")");
                return;
            }
            text(w, dst, "%ok =w call $cint_qf_");
            switch (op) {
                case lowering.B_ADD: text(w, dst, "add_");
                case lowering.B_SUB: text(w, dst, "sub_");
                case lowering.B_MUL: text(w, dst, "mul_");
                default: text(w, dst, "div_");
            }
            suffix(w, dst, ty);
            qw_ctx(w, dst, pbytes, q, sir, i);
            arg_w(w, dst, f);
            if (op == lowering.B_MUL || op == lowering.B_DIV) { arg_w(w, dst, sir[i].val); }
            arg_l(w, dst, sir, funcs, q, a);
            arg_l(w, dst, sir, funcs, q, bb);
        case lowering.SO_UN:
            ins(w, dst, q);
            text(w, dst, "%ok =w call $cint_qf_neg_");
            suffix(w, dst, ty);
            qw_ctx(w, dst, pbytes, q, sir, i);
            arg_w(w, dst, f);
            arg_l(w, dst, sir, funcs, q, a);
        case lowering.SO_AS:
            I32 from = sir[i].f;
            I32 c = sir[i].c;
            ins(w, dst, q);
            if (c == lowering.AS_RAW) {
                // A cast between two types of one width.
                tmp(w, dst, sir, i);
                norm_op(w, dst, ty);
                opnd(w, dst, sir, funcs, q, a);
                emit.w_nl(w, dst);
                return;
            }
            if (c == 0) {
                text(w, dst, "%ok =w call $cint_qf_as_");
            } else if (c == 2) {
                text(w, dst, "%xr =w call $cint_qf_as_result_");
            } else {
                tmp(w, dst, sir, i);
                if (c == 1) { text(w, dst, " =l call $cint_qf_as_wrap_"); } else { text(w, dst, " =l call $cint_qf_as_sat_"); }
            }
            suffix(w, dst, ty);
            if (c == 0) {
                qw_ctx(w, dst, pbytes, q, sir, i);
                text(w, dst, ", w ");
            } else {
                text(w, dst, "(w ");
            }
            num(w, dst, rt_tag(from));
            arg_w(w, dst, rt_tag(ty));
            arg_w(w, dst, sir[i].val);
            arg_l(w, dst, sir, funcs, q, a);
            if (c == 1 || c == lowering.AS_SAT) {
                line(w, dst, ")");
                return;
            }
            if (c == 2) {
                line(w, dst, ", l %out)");
                if (sir[i + 1].dst >= 0) {
                    ins(w, dst, q);
                    tmp(w, dst, sir, i + 1);
                    line(w, dst, " =l extuw %xr");
                }
                if (sir[i].dst >= 0) { load_out(w, dst, sir, q, i); }
                return;
            }
        case lowering.SO_BUILTIN:
            I64 id = sir[i].f as I64;
            if (id == fold.BI_MIN || id == fold.BI_MAX) {
                w_builtin(w, dst, sir, funcs, slots, pbytes, q, i);
                return;
            }
            ins(w, dst, q);
            text(w, dst, "%ok =w call $cint_qf_");
            fold.render_builtin(w, dst, id);
            emit.w_byte(w, dst, '_');
            suffix(w, dst, ty);
            qw_ctx(w, dst, pbytes, q, sir, i);
            if (id == fold.BI_QMUL) {
                // qmul(R, a, b) for a and b of their own types (IM-63).
                arg_w(w, dst, rt_tag(lowering.builtin_opty(sir, i)));
                arg_w(w, dst, rt_tag(lowering.builtin_btype(sir, i)));
            }
            arg_w(w, dst, f);
            if (id == fold.BI_QMUL || id == fold.BI_SQRT) {
                arg_w(w, dst, sir[i].val & 255);
            } else if (id == fold.BI_MUL_INT) {
                arg_w(w, dst, rt_tag(lowering.builtin_btype(sir, i)));
            }
            arg_l(w, dst, sir, funcs, q, a);
            if (id == fold.BI_QMUL || id == fold.BI_MUL_INT) {
                // The integer as its 64-bit pattern (IM-64).
                arg_l(w, dst, sir, funcs, q, bb);
            }
        default:
            // A print of a fixed-point value (SPEC-04 LS-207, LS-208): its decimal, or as the
            // hole's form gives it (lowering.print_form).
            ins(w, dst, q);
            text(w, dst, "%ok =w call $cint_rt_print_format_fixed(l %ctx, w ");
            num(w, dst, rt_tag(ty));
            arg_l(w, dst, sir, funcs, q, a);
            if (sir[i].e == 0) {
                text(w, dst, ", w 0, w 32, l 0, l 0");
            } else {
                arg_w(w, dst, sir[i].e as I64);
                arg_w(w, dst, sir[i].f as I64);
                text(w, dst, ", l ");
                num(w, dst, sir[i].val);
                text(w, dst, ", l ");
                num(w, dst, sir[i].c as I64);
            }
            bool_checked(w, dst, q);
            return;
    }
    // The checked helpers: the result through %out.
    line(w, dst, ", l %out)");
    checked(w, dst, q);
    load_out(w, dst, sir, q, i);
}

// ---------------------------------------------------------------- 128-bit fixed point (Q3)
//
// Fixed point of storage I128 (OQ-292) is boxed as an I128 is (lowering.is_limbs), and each
// operation on it (back_c.q_limbs_node) is what back_c.c_q_limbs writes: one call of
// cint_rt_q_limbs with the operation, the form, the mode and the three type words (rt_tag),
// a print by cint_rt_print_q_limbs, and as.raw, min and max as the storage integer's (IM-60).
// Every operand goes by address: a limbs value is its box, a narrow value its 64-bit pattern in
// %qa or %qb. A narrow result comes back through %out at its C width (put_result).

// Whether q_limbs_node i is admitted: the forms back_c.c_q_limbs writes, no result form.
Bool q_limbs_ok(in lowering.Sir[_] sir, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    switch (k) {
        case lowering.SO_PRINT_VALUE, lowering.SO_UN:
            return true;
        case lowering.SO_BIN:
            return sir[i].c >= lowering.B_ADD && sir[i].c <= lowering.B_DIV && sir[i].f >= 0 && sir[i].f <= 2;
        case lowering.SO_AS:
            return sir[i].c != 2 && q_side(sir[i].f) && q_side(sir[i].ty);
        case lowering.SO_BUILTIN:
            I64 id = sir[i].f as I64;
            if (id == fold.BI_QMUL || id == fold.BI_MUL_INT) {
                return q_side(lowering.builtin_opty(sir, i)) && q_side(lowering.builtin_btype(sir, i));
            }
            return id == fold.BI_MIN || id == fold.BI_MAX || id == fold.BI_ABS || id == fold.BI_SQRT;
        default:
            return false;
    }
}

// An operand or result type of a q_limbs node: limbs, or a narrow integer or fixed point.
Bool q_side(I32 ty) {
    return lowering.is_limbs(ty) || (scalar(ty) && ty != lowering.T_BOOL);
}

// `, l <address>` of operand v of type ty: its box, or its pattern stored at %<cell>.
void q_limbs_arg[b, n](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        inout QState[_] q, I64 v, I32 ty, in U8[n] cell) {
    if (lowering.is_limbs(ty)) {
        arg_l(w, dst, sir, funcs, q, v);
        return;
    }
    ins(w, dst, q);
    text(w, dst, "storel ");
    opnd(w, dst, sir, funcs, q, v);
    text(w, dst, ", %");
    line(w, dst, cell);
}

// Whether function fn has a q_limbs node or a reduction on 128-bit fixed point, which take the
// cells %qa and %qb.
Bool uses_q_limbs(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, I64 fn) {
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        if ((sir[i].op & lowering.FL_LIVE) != 0 && (back_c.q_limbs_node(sir, i) ||
                ((sir[i].op & lowering.OP_MASK) == lowering.SO_REDUCE && lowering.is_q(sir[i].ty) &&
                (lowering.is_limbs(sir[i].ty) || lowering.is_limbs(sir[i].val as I32))))) {
            return true;
        }
    }
    return false;
}

// q_limbs node i (back_c.c_q_limbs).
void w_q_limbs[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    I64 id = sir[i].f as I64;
    if (k == lowering.SO_PRINT_VALUE) {
        ins(w, dst, q);
        text(w, dst, "%ok =w call $cint_rt_print_q_limbs(l %ctx, w ");
        num(w, dst, rt_tag(ty));
        arg_l(w, dst, sir, funcs, q, a);
        if (sir[i].e == 0) {
            text(w, dst, ", w 0, w 32, l 0, l 0");
        } else {
            arg_w(w, dst, sir[i].e as I64);
            arg_w(w, dst, sir[i].f as I64);
            text(w, dst, ", l ");
            num(w, dst, sir[i].val);
            text(w, dst, ", l ");
            num(w, dst, sir[i].c as I64);
        }
        bool_checked(w, dst, q);
        return;
    }
    if (k == lowering.SO_AS && sir[i].c == lowering.AS_RAW) {
        // The storage bits: a box to a box of the same 16 bytes.
        ins(w, dst, q);
        text(w, dst, "blit ");
        opnd(w, dst, sir, funcs, q, a);
        text(w, dst, ", ");
        tmp(w, dst, sir, i);
        blit_n(w, dst, ty);
        return;
    }
    if (k == lowering.SO_BUILTIN && (id == fold.BI_MIN || id == fold.BI_MAX)) {
        ins(w, dst, q);
        if (id == fold.BI_MIN) { text(w, dst, "call $cint_qw_min_i128(l "); } else { text(w, dst, "call $cint_qw_max_i128(l "); }
        opnd(w, dst, sir, funcs, q, a);
        arg_l(w, dst, sir, funcs, q, bb);
        qw_end(w, dst, sir, q, i, false);
        return;
    }
    I64 op = 4;   // back_c's CQ_*: neg
    I64 form = sir[i].f as I64;
    I64 mode = 0;
    I32 ta = ty;
    I32 tb = lowering.T_NONE;
    if (k == lowering.SO_BIN) {
        tb = ty;
        op = 1 + (sir[i].c - lowering.B_ADD) as I64;
        if (sir[i].c == lowering.B_DIV) { op = 5; }
        if (sir[i].c == lowering.B_MUL || sir[i].c == lowering.B_DIV) { mode = sir[i].val; }
    } else if (k == lowering.SO_AS) {
        op = 10;
        ta = sir[i].f;
        mode = sir[i].val;
        form = sir[i].c as I64;
        if (form == lowering.AS_SAT as I64) { form = 2; }
    } else if (k == lowering.SO_BUILTIN) {
        form = 0;
        ta = lowering.builtin_opty(sir, i);
        mode = sir[i].val & 255;
        if (id == fold.BI_ABS) {
            op = 6;
        } else if (id == fold.BI_SQRT) {
            op = 7;
        } else {
            op = 8;
            if (id == fold.BI_QMUL) { op = 9; }
            tb = lowering.builtin_btype(sir, i);
        }
    }
    if (!lowering.is_limbs(ta)) { q_limbs_arg(w, dst, sir, funcs, q, a, ta, "qa"); }
    if (tb != lowering.T_NONE && !lowering.is_limbs(tb)) { q_limbs_arg(w, dst, sir, funcs, q, bb, tb, "qb"); }
    ins(w, dst, q);
    text(w, dst, "%ok =w call $cint_rt_q_limbs(l %ctx, ");
    site(w, dst, pbytes, q, sir[i].site as I64);
    arg_w(w, dst, op);
    arg_w(w, dst, form);
    arg_w(w, dst, mode);
    arg_w(w, dst, rt_tag(ta));
    arg_w(w, dst, rt_tag(tb));
    arg_w(w, dst, rt_tag(ty));
    if (lowering.is_limbs(ta)) { arg_l(w, dst, sir, funcs, q, a); } else { text(w, dst, ", l %qa"); }
    if (tb == lowering.T_NONE) {
        text(w, dst, ", l 0");
    } else if (lowering.is_limbs(tb)) {
        arg_l(w, dst, sir, funcs, q, bb);
    } else {
        text(w, dst, ", l %qb");
    }
    if (lowering.is_limbs(ty)) {
        text(w, dst, ", l ");
        tmp(w, dst, sir, i);
    } else {
        text(w, dst, ", l %out");
    }
    if (form == 0) {
        bool_checked(w, dst, q);
    } else {
        // `%` and `|` forms never fault.
        line(w, dst, ")");
    }
    if (!lowering.is_limbs(ty)) {
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        text(w, dst, " =l ");
        load_op(w, dst, ty);
        line(w, dst, " %out");
    }
}

// ---------------------------------------------------------------- lane Q (S-1 U-1)
//
// SPEC-01 IM-190 to IM-192: `hadd`, `rhadd` and `rshr` on 8 to 64 bits and `rmulh` on 16 and
// 32, integer or fixed point, as QBE on the values as `l`, extended from their type
// (back_c.c_laneq is the model). Every width uses the identities (a & b) + S(a ^ b, 1),
// (a | b) - S(a ^ b, 1) and S(a, k) + ((a << 1) >> k & 1), S the type's right shift, whose terms
// lie in the type; the last is a itself at k = 0, so a count needs no branch. Only `rshr` by a
// count that is not a constant in 0 to w - 1 calls the runtime, for the check and its record.

// The type of the count of `rshr` node i, of one of the first nfunc functions.
I32 lane_count_type(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, I64 nfunc,
        I64 i) {
    I64 v = sir[i].b as I64;
    if (v >= 0) {
        return sir[v].ty;
    }
    for fn in 0..nfunc {
        if ((funcs[fn].first as I64) <= i && i <= (funcs[fn].last as I64)) {
            return lowering.value_type(sir, funcs, slots, fn, v);
        }
    }
    return lowering.T_NONE;
}

// Whether node i is a lane Q built-in of a narrow type; node_ok also requires a narrow count of
// `rshr`.
Bool lane_node(in lowering.Sir[_] sir, I64 i) {
    return (sir[i].op & lowering.OP_MASK) == lowering.SO_BUILTIN && fold.builtin_lane(sir[i].f as I64) &&
        scalar(sir[i].ty);
}

// `    %<r> =l <op> <x>, <y>` with x and y written by the caller as text.
void lane_op[b, n, m, k, j](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, in U8[n] r, in U8[m] op,
        in U8[k] x, in U8[j] y) {
    ins(w, dst, q);
    text(w, dst, r);
    text(w, dst, " =l ");
    text(w, dst, op);
    emit.w_byte(w, dst, ' ');
    text(w, dst, x);
    text(w, dst, ", ");
    line(w, dst, y);
}

// `    %<r> =l sar <x>, <y>` when sg, else with `shr`.
void lane_sh[b, n, k, j](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, Bool sg, in U8[n] r,
        in U8[k] x, in U8[j] y) {
    if (sg) {
        lane_op(w, dst, q, r, "sar", x, y);
    } else {
        lane_op(w, dst, q, r, "shr", x, y);
    }
}

// Lane node i.
void w_lane[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I64 id = sir[i].f as I64;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    I64 wd = width(ty);
    ins(w, dst, q);
    text(w, dst, "%la =l copy ");
    opnd(w, dst, sir, funcs, q, a);
    emit.w_nl(w, dst);
    ins(w, dst, q);
    text(w, dst, "%lb =l copy ");
    opnd(w, dst, sir, funcs, q, bb);
    emit.w_nl(w, dst);
    if (id == fold.BI_RMULH) {
        // (A * K + 2^(w-2)) >> (w - 1), whose one value above the maximum is the maximum + 1.
        lane_op(w, dst, q, "%lx", "mul", "%la", "%lb");
        ins(w, dst, q);
        text(w, dst, "%lx =l add %lx, ");
        num(w, dst, 1 << (wd - 2));
        emit.w_nl(w, dst);
        ins(w, dst, q);
        text(w, dst, "%lx =l sar %lx, ");
        num(w, dst, wd - 1);
        emit.w_nl(w, dst);
        ins(w, dst, q);
        text(w, dst, "%ly =l csgtl %lx, ");
        num(w, dst, (1 << (wd - 1)) - 1);
        emit.w_nl(w, dst);
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        line(w, dst, " =l sub %lx, %ly");
        return;
    }
    Bool sg = signed(ty);
    if (id == fold.BI_RSHR) {
        if (back_c.rshr_const(sir, i) < 0) {
            ins(w, dst, q);
            text(w, dst, "%ok =w call $cint_qbe_rshr_count(l %ctx, ");
            site(w, dst, pbytes, q, sir[i].site as I64);
            text(w, dst, ", w ");
            num(w, dst, rt_tag(ty));
            text(w, dst, ", l %la, l %lb, w ");
            num(w, dst, lowering.value_type(sir, funcs, slots, q[0].fn, bb) as I64);
            line(w, dst, ")");
            checked(w, dst, q);
        }
        lane_sh(w, dst, q, sg, "%lx", "%la", "%lb");
        lane_op(w, dst, q, "%ly", "shl", "%la", "1");
        lane_op(w, dst, q, "%ly", "shr", "%ly", "%lb");
        lane_op(w, dst, q, "%ly", "and", "%ly", "1");
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        line(w, dst, " =l add %lx, %ly");
        return;
    }
    // hadd, rhadd
    if (id == fold.BI_HADD) {
        lane_op(w, dst, q, "%lx", "and", "%la", "%lb");
    } else {
        lane_op(w, dst, q, "%lx", "or", "%la", "%lb");
    }
    lane_op(w, dst, q, "%ly", "xor", "%la", "%lb");
    lane_sh(w, dst, q, sg, "%ly", "%ly", "1");
    ins(w, dst, q);
    tmp(w, dst, sir, i);
    if (id == fold.BI_HADD) {
        line(w, dst, " =l add %lx, %ly");
    } else {
        line(w, dst, " =l sub %lx, %ly");
    }
}

// Whether node i is in the Q1 surface of the function it is in.
Bool node_ok(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, I64 nfunc, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I32 ty = sir[i].ty;
    if (lane_node(sir, i)) {
        return sir[i].f as I64 != fold.BI_RSHR || narrow_int(lane_count_type(sir, funcs, slots, nfunc, i));
    }
    if (back_c.q_node(sir, i)) {
        return q_ok(sir, i);
    }
    if (back_c.wide_node(sir, i)) {
        return wide_ok(sir, funcs, slots, i);
    }
    switch (k) {
        case lowering.SO_CONST, lowering.SO_LOAD, lowering.SO_STORE, lowering.SO_DISCARD:
            // A handle is copied between its temporaries, locals and parameters (boxed).
            return ty == lowering.T_NONE || scalar(ty) || (boxed(ty) && (k != lowering.SO_CONST || sir[i].val == 0 ||
                lowering.is_limbs(ty)));
        case lowering.SO_UN, lowering.SO_PRINT_VALUE:
            return ty == lowering.T_NONE || scalar(ty);
        case lowering.SO_CMP:
            return scalar(ty) && scalar(sir[i].f);
        case lowering.SO_MEMBER, lowering.SO_MVIEW, lowering.SO_LEASE, lowering.SO_PREF:
            return mem_ok(sir, slots, i);
        case lowering.SO_BIN:
            // f 3, a result-returning form, writes its tag to the SO_ETAG right after.
            return scalar(ty) && (sir[i].f <= 2 || (sir[i].f == 3 && sir[i].c <= lowering.B_SHL));
        case lowering.SO_ETAG:
            I32 ek = sir[sir[i].a as I64].op & lowering.OP_MASK;
            return scalar(ty) && (ek == lowering.SO_CALL || ek == lowering.SO_AS || ek == lowering.SO_BIN ||
                ek == lowering.SO_MEMBER);
        case lowering.SO_WIDEN:
            return scalar(ty);
        case lowering.SO_ERROR:
            return true;
        case lowering.SO_AS:
            // `as?` (c 2) wraps, and its SO_ETAG right after holds the tag.
            return scalar(ty) && scalar(sir[i].f) && sir[i].c <= lowering.AS_SAT &&
                (sir[i].c == 2 || (sir[i + 1].op & lowering.OP_MASK) != lowering.SO_ETAG);
        case lowering.SO_ARG:
            I64 ga = sir[i].a as I64;
            return sir[i].e == 0 || sir[i].e == 4 || sir[i].e == 5 || sir[i].e == 9 || ((sir[i].e == 1 || sir[i].e == 2) &&
                any_view(slots, ga)) || (sir[i].e == 7 && view_slot(slots, ga)) ||
                ((sir[i].e == 3 || sir[i].e == 6) && record_slot(slots, ga));
        case lowering.SO_ICHECK:
            // An element of an array or a view, or (c > 0) of the array field c - 1 of a record.
            if (sir[i].c > 0) { return record_slot(slots, sir[i].a as I64); }
            return any_view(slots, sir[i].a as I64);
        case lowering.SO_ELOAD, lowering.SO_ESTORE, lowering.SO_VFILL:
            return (scalar(ty) || lowering.is_limbs(ty)) && any_view(slots, sir[i].a as I64);
        case lowering.SO_SHAPE, lowering.SO_COPY_SHAPE, lowering.SO_CALIAS:
            Bool other = sir[i].c < 0 || any_view(slots, sir[i].c as I64);
            if (k == lowering.SO_CALIAS) { other = any_view(slots, sir[i].b as I64); }
            return any_view(slots, sir[i].a as I64) && other;
        case lowering.SO_ACOPY:
            return any_view(slots, sir[i].a as I64) && any_view(slots, sir[i].b as I64);
        case lowering.SO_VBEGIN:
            return view_slot(slots, sir[i].a as I64) && (sir[i].e == 3 || any_view(slots, sir[i].b as I64));
        case lowering.SO_VEND, lowering.SO_VTRANS, lowering.SO_VREV, lowering.SO_VRESHAPE:
            return view_slot(slots, sir[i].a as I64) && any_view(slots, sir[i].b as I64);
        case lowering.SO_VPICK, lowering.SO_VSLICE, lowering.SO_EOFF:
            return view_slot(slots, sir[i].a as I64);
        case lowering.SO_VEXT:
            return any_view(slots, sir[i].a as I64);
        case lowering.SO_VCOPY:
            return (scalar(ty) || lowering.is_limbs(ty)) && any_view(slots, sir[i].a as I64) &&
                any_view(slots, sir[i].b as I64);
        case lowering.SO_REDUCE:
            // The reductions and equal, of narrow or wide integers and of fixed point; a
            // fixed-point dot rounds by its mode.
            I64 op = (sir[i].f & 15) as I64;
            return (scalar(ty) || lowering.is_limbs(ty)) && (scalar(sir[i].val as I32) || lowering.is_limbs(sir[i].val as I32)) &&
                ((sir[i].f >> 4) == 0 || (op == 9 && lowering.is_q(ty))) && op >= 1 && op <= 10 &&
                any_view(slots, sir[i].a as I64) && (sir[i].b < 0 || any_view(slots, sir[i].b as I64));
        case lowering.SO_AINIT:
            return (scalar(ty) || lowering.is_limbs(ty)) && slots[sir[i].a as I64].kind == lowering.SK_ARRAY && array_slot(slots, sir[i].a as I64);
        case lowering.SO_SDATA:
            return true;
        case lowering.SO_FRAME:
            // The frame arena's charges, and the list marks of its charges and run-time storage.
            return sir[i].f >= 0 && sir[i].f <= 3;
        case lowering.SO_VDIM, lowering.SO_VALLOC:
            return view_slot(slots, sir[i].a as I64);
        case lowering.SO_CALL:
            I64 a = sir[i].a as I64;
            if (sir[i].b == 1) {
                // An extern's call: scalar arguments and results, and rank-1 views.
                return (funcs[a].result == lowering.T_NONE || scalar(funcs[a].result)) && host_args_ok(sir, slots, i);
            }
            return sir[i].b == 0 &&
                ((sir[i].f == 0 && (funcs[a].result == lowering.T_NONE || scalar(funcs[a].result) ||
                boxed(funcs[a].result))) ||
                (sir[i].f > 0 && record_slot(slots, (sir[i].f - 1) as I64)));
        case lowering.SO_RETURN:
            return sir[i].b <= 1 || sir[i].b == 3 || (sir[i].b == 2 && record_slot(slots, sir[i].a as I64));
        case lowering.SO_FLOAD, lowering.SO_FSTORE:
            return (scalar(ty) || boxed(ty)) && record_slot(slots, sir[i].a as I64);
        case lowering.SO_EFLOAD, lowering.SO_EFSTORE:
            return (scalar(ty) || boxed(ty)) && any_view(slots, sir[i].a as I64) && elem_of(slots[sir[i].a as I64].ty) >= lowering.T_STRUCT;
        case lowering.SO_FELOAD, lowering.SO_FESTORE, lowering.SO_FSCOPY, lowering.SO_FACOPY, lowering.SO_SCOPY:
            return record_slot(slots, sir[i].a as I64) && (k != lowering.SO_SCOPY || record_slot(slots, sir[i].b as I64));
        case lowering.SO_FSLOAD, lowering.SO_FREF, lowering.SO_AFREF:
            return record_slot(slots, sir[i].b as I64);
        case lowering.SO_EREF:
            // An element of an array or a view of records, or (e > 0) of the array field e - 1
            // of a record.
            if (sir[i].e > 0) { return record_slot(slots, sir[i].b as I64); }
            return any_view(slots, sir[i].b as I64) && elem_of(slots[sir[i].b as I64].ty) >= lowering.T_STRUCT;
        case lowering.SO_ASSERT:
            return sir[i].b == 0 || scalar(sir[sir[i].a as I64].f);
        case lowering.SO_BUILTIN:
            I64 id = sir[i].f as I64;
            return scalar(ty) && scalar(lowering.builtin_opty(sir, i)) && !lowering.is_q(lowering.builtin_opty(sir, i)) &&
                id >= fold.BI_ABS &&
                id <= fold.BI_ROTR && (id != fold.BI_MUL_FULL || (ty != lowering.T_I64 && ty != lowering.T_U64) ||
                (lowering.builtin_opty(sir, i) != lowering.T_I64 && lowering.builtin_opty(sir, i) != lowering.T_U64));
        case lowering.SO_LOCAL, lowering.SO_FUEL, lowering.SO_PRINT_BEGIN, lowering.SO_PRINT_BYTES,
                lowering.SO_PRINT_END, lowering.SO_IF, lowering.SO_ARM, lowering.SO_THEN, lowering.SO_ARM_END,
                lowering.SO_ELSE, lowering.SO_LOOP, lowering.SO_TEST, lowering.SO_NEXT, lowering.SO_SWITCH,
                lowering.SO_CASE, lowering.SO_DEFAULT, lowering.SO_ITEM, lowering.SO_HI, lowering.SO_BODY,
                lowering.SO_CASE_END, lowering.SO_BREAK, lowering.SO_CONTINUE, lowering.SO_END, lowering.SO_BLOCK:
            return true;
        default:
            return false;
    }
}

// The byte count of back_c.comp(s, at, n), the EMIT-22 component C(x).
I64 comp_len(in U8[_] s, I64 at, I64 n) {
    emit.Writer[1] m;
    U8[1] unused;
    emit.w_measure(m);
    back_c.comp(m, unused, s, at, n);
    return m[0].pos;
}

// `h` and the first 20 bytes of the SHA-256 of s[0..n), as 40 lowercase hex digits: the hashed
// part of an internal name too long for QBE (BACK-18). No EMIT-22 name has it, since C(x) begins
// with `_`.
void hash_name[b, m](inout emit.Writer[_] w, inout U8[b] dst, in U8[m] s, I64 n) {
    U8[32] d;
    sha256.sha_digest(s, 0, n, d);
    emit.w_byte(w, dst, 'h');
    for k in 0..20 {
        emit.w_hex(w, dst, d[k] as U64, 2);
    }
}

// The module part of a `cg` name of the module at pbytes[at..at + nb): C(P), or, when `cg` C(P)
// with the longest suffix passes QBE_NAME_MAX, hash_name of the bytes `cg` C(P) (BACK-18).
void cg_part[b](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] pbytes, I64 at, I64 nb) {
    if (2 + comp_len(pbytes, at, nb) + SUFFIX_MAX <= QBE_NAME_MAX) {
        back_c.comp(w, dst, pbytes, at, nb);
        return;
    }
    U8[1024] s;
    emit.Writer[1] m;
    emit.w_emit(m, NAME_BUF);
    emit.w_text(m, s, "cg");
    back_c.comp(m, s, pbytes, at, nb);
    hash_name(w, dst, s, m[0].pos);
}

// CAP_SYMBOL when a public name of the module is longer than QBE reads (QBE_NAME_MAX): `cm`
// C(P), or the `cx` C(P) C(name) of a root export's row; or when an internal name is longer
// than the NAME_BUF bytes its hash is formed from. Internal names over QBE_NAME_MAX are hashed
// (cg_part, fn_sym).
I64 symbol_refusal(in U8[_] src, in scan.Token[_] toks, in lowering.SirFunc[_] funcs, in lowering.LState[_] ls,
        in U8[_] pbytes, in back_c.PMod[_] pm, I64 module_index, Bool root, inout I64[2] why) {
    I64 at = pm[module_index + 1].path_at;
    I64 cp = comp_len(pbytes, at, back_c.stem_bytes(pbytes, at, pm[module_index + 1].path_len));
    if (2 + cp > QBE_NAME_MAX) {
        why[0] = CAP_SYMBOL;
        return CAP_SYMBOL;
    }
    for fn in 0..ls[0].nfunc {
        if (funcs[fn].name < 0) { continue; }
        I64 pc = cp;
        if ((funcs[fn].flags & lowering.FN_IMPORT) != 0) {
            I64 ia = funcs[fn].lslot0 as I64;
            pc = comp_len(pbytes, ia, back_c.stem_bytes(pbytes, ia, funcs[fn].lslot_end as I64));
        }
        I64 tk = funcs[fn].name as I64;
        I64 n = 2 + pc + comp_len(src, toks[tk].start as I64, toks[tk].len as I64);
        Bool row = root && (funcs[fn].flags & lowering.FN_EXPORT) != 0 &&
            (funcs[fn].flags & (lowering.FN_IMPORT | lowering.FN_GRANTS)) == 0;
        if (n > NAME_BUF || (row && n > QBE_NAME_MAX)) {
            why[0] = CAP_SYMBOL;
            why[1] = funcs[fn].first as I64;
            return CAP_SYMBOL;
        }
    }
    return 0;
}

// Whether slot k is a parameter of an import row (its callee's, laid out with the module's).
Bool import_param(in lowering.SirFunc[_] funcs, in lowering.LState[_] ls, I64 k) {
    for fn in 0..ls[0].nfunc {
        I64 p0 = funcs[fn].pslot0 as I64;
        if ((funcs[fn].flags & (lowering.FN_IMPORT | lowering.FN_EXTERN)) != 0 &&
                (funcs[fn].flags & (lowering.FN_IVAR | lowering.FN_ISTRUCT)) == 0 &&
                k >= p0 && k < p0 + (funcs[fn].nparam as I64)) {
            return true;
        }
    }
    return false;
}

// 0 when the module is in the admitted surface; otherwise the capability, with why[1] the
// node where the refusal is reported (the function's first node for CAP_ENTRY, CAP_STORAGE
// of a slot kind and CAP_SYMBOL of a function).
export I64 check_qbe(in U8[_] src, in scan.Token[_] toks, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in lowering.LState[_] ls, in limits.Decl[_] decls, in U8[_] pbytes,
        in back_c.PMod[_] pm, I64 module_index, inout I64[2] why) {
    why[0] = 0;
    why[1] = 0;
    Bool root = module_index == pm[0].path_at - 1;
    if (symbol_refusal(src, toks, funcs, ls, pbytes, pm, module_index, root, why) != 0) {
        return CAP_SYMBOL;
    }
    if (root && !catalog_ok(decls)) {
        why[0] = CAP_MODULE;
        return CAP_MODULE;
    }
    // Module-level structs and views, and arrays of other than scalars, are not written yet.
    I64 first_local = ls[0].nslot;
    for fn in 0..ls[0].nfunc {
        if ((funcs[fn].flags & lowering.FN_IMPORT) == 0 && funcs[fn].nparam > 0 && (funcs[fn].pslot0 as I64) < first_local) {
            first_local = funcs[fn].pslot0 as I64;
        }
        if ((funcs[fn].flags & lowering.FN_IMPORT) == 0 && funcs[fn].lslot_end > funcs[fn].lslot0 &&
                (funcs[fn].lslot0 as I64) < first_local) {
            first_local = funcs[fn].lslot0 as I64;
        }
    }
    I64 nmem = 0;
    for k in 0..ls[0].nslot {
        if (slots[k].kind == lowering.SK_ARENA_M || slots[k].kind == lowering.SK_POOL_M) { nmem += 1; }
    }
    if (nmem > 64) {
        // More arenas and pools than w_memories holds.
        why[0] = CAP_STORAGE;
        return CAP_STORAGE;
    }
    for k in 0..first_local {
        if (import_param(funcs, ls, k)) { continue; }
        I32 sk = slots[k].kind;
        Bool marr = lowering.module_array(slots, k) && (scalar(lowering.array_elem(slots[k].ty)) ||
            lowering.is_limbs(lowering.array_elem(slots[k].ty)));
        // A module-level record (box 15, OQ-260) is laid out as a local one is; one of size 0,
        // which C's struct gives a byte, is refused.
        if ((sk == lowering.SK_ARRAY && !marr) || sk == lowering.SK_NVIEW || sk == lowering.SK_VIEW ||
                (lowering.module_struct(slots, k as I64) && (!layout_ok(slots, slots[k].ty) ||
                ty_size(slots, slots[k].ty) == 0)) ||
                (sk == lowering.SK_GLOBAL && !scalar(slots[k].ty) && !boxed(slots[k].ty))) {
            why[0] = CAP_STORAGE;
            return CAP_STORAGE;
        }
    }
    for fn in 0..ls[0].nfunc {
        I64 r = fn_refusal(funcs, slots, fn, root);
        if (r != 0) {
            why[0] = r;
            why[1] = funcs[fn].first as I64;
            return r;
        }
    }
    for i in 0..ls[0].nsir {
        I32 k = sir[i].op & lowering.OP_MASK;
        if ((sir[i].op & lowering.FL_LIVE) != 0 && (k == lowering.SO_LOAD || k == lowering.SO_STORE)) {
            // module state, struct fields and the other slot kinds are Q2's
            I32 sk = slots[sir[i].a as I64].kind;
            Bool scalar_global = (sk == lowering.SK_GLOBAL || sk == lowering.SK_IGLOBAL) &&
                (scalar(slots[sir[i].a as I64].ty) || (sk == lowering.SK_GLOBAL && boxed(slots[sir[i].a as I64].ty)));
            if (sk != lowering.SK_PARAM && sk != lowering.SK_LOCAL && sk != lowering.SK_HIDDEN && !scalar_global &&
                    !scalar_place(slots, sir[i].a as I64)) {
                why[0] = CAP_STORAGE;
                why[1] = i;
                return CAP_STORAGE;
            }
        }
        if ((sir[i].op & lowering.FL_LIVE) != 0 && !node_ok(sir, funcs, slots, ls[0].nfunc, i)) {
            why[0] = CAP_NODE;
            why[1] = i;
            return CAP_NODE;
        }
    }
    return 0;
}

// ---------------------------------------------------------------- writing

void text[b, n](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] s) {
    emit.w_text(w, dst, s);
}

void line[b, n](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] s) {
    emit.w_text(w, dst, s);
    emit.w_nl(w, dst);
}

void num[b](inout emit.Writer[_] w, inout U8[b] dst, I64 v) {
    emit.w_i64(w, dst, v);
}

// The start of an instruction: a fresh block after a jump, then the indent.
void ins[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q) {
    if (q[0].term != 0) {
        text(w, dst, "@u");
        num(w, dst, q[0].nlab);
        emit.w_nl(w, dst);
        q[0].nlab += 1;
        q[0].term = 0;
    }
    text(w, dst, "    ");
}

// Label @L<i>_<s> of node i.
void lab_ref[b](inout emit.Writer[_] w, inout U8[b] dst, I64 i, U8 s) {
    text(w, dst, "@L");
    num(w, dst, i);
    emit.w_byte(w, dst, '_');
    emit.w_byte(w, dst, s);
}

// After a jump (term 1) the block @u<nlab> may be a branch's target (SO_THEN, SO_TEST), so it is
// opened, empty, before the label.
void lab[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 i, U8 s) {
    if (q[0].term != 0) {
        text(w, dst, "@u");
        num(w, dst, q[0].nlab);
        emit.w_nl(w, dst);
        q[0].nlab += 1;
    }
    lab_ref(w, dst, i, s);
    emit.w_nl(w, dst);
    q[0].term = 0;
}

void jump[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 i, U8 s) {
    ins(w, dst, q);
    text(w, dst, "jmp ");
    lab_ref(w, dst, i, s);
    emit.w_nl(w, dst);
    q[0].term = 1;
}

// `jnz %ok, @u<n>, @fault` and the block @u<n>: the check of the call just written.
void checked[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q) {
    text(w, dst, "    jnz %ok, @u");
    num(w, dst, q[0].nlab);
    line(w, dst, ", @fault");
    text(w, dst, "@u");
    num(w, dst, q[0].nlab);
    emit.w_nl(w, dst);
    q[0].nlab += 1;
}

// The value of operand v of function fn: node v's temporary, or the slot of parameter -(v + 1).
void opnd[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in QState[_] q, I64 v) {
    if (v >= 0) {
        text(w, dst, "%t");
        num(w, dst, sir[v].dst as I64);
    } else {
        text(w, dst, "%s");
        num(w, dst, (funcs[q[0].fn].pslot0 as I64) - v - 1);
    }
}

void tmp[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, I64 i) {
    text(w, dst, "%t");
    num(w, dst, sir[i].dst as I64);
}

// `:site $<module symbol>_qs<k>`, site k as the aggregate the runtime takes by value.
void site[b](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] pbytes, in QState[_] q, I64 k) {
    text(w, dst, ":site $cg");
    cg_part(w, dst, pbytes, q[0].at, back_c.stem_bytes(pbytes, q[0].at, q[0].len));
    text(w, dst, "_qs");
    num(w, dst, k);
}

void mod_sym[b](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] pbytes, in QState[_] q) {
    text(w, dst, "$cg");
    cg_part(w, dst, pbytes, q[0].at, back_c.stem_bytes(pbytes, q[0].at, q[0].len));
}

// The type suffix of the runtime's names: i8 to u64.
void suffix[b](inout emit.Writer[_] w, inout U8[b] dst, I32 ty) {
    if (signed(ty)) {
        emit.w_byte(w, dst, 'i');
    } else {
        emit.w_byte(w, dst, 'u');
    }
    num(w, dst, fold.ty_width(ty as I64));
}

// The width of ty in bits; Bool is 1.
I64 width(I32 ty) {
    if (ty == lowering.T_BOOL) {
        return 1;
    }
    return fold.ty_width(ty as I64);
}

// `=l <ext> <src>`: the value of src cut back to type ty (a copy for 64 bits and Bool).
void norm_op[b](inout emit.Writer[_] w, inout U8[b] dst, I32 ty) {
    I64 bits = width(ty);
    Bool s = signed(ty);
    if (bits == 8 && s) { text(w, dst, " =l extsb "); }
    else if (bits == 8) { text(w, dst, " =l extub "); }
    else if (bits == 16 && s) { text(w, dst, " =l extsh "); }
    else if (bits == 16) { text(w, dst, " =l extuh "); }
    else if (bits == 32 && s) { text(w, dst, " =l extsw "); }
    else if (bits == 32) { text(w, dst, " =l extuw "); }
    else { text(w, dst, " =l copy "); }
}

// `%t<d> =l <ext> %x`: node i's value from the 64-bit pattern in %x.
void norm_x[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, inout QState[_] q, I64 i, I32 ty) {
    ins(w, dst, q);
    tmp(w, dst, sir, i);
    norm_op(w, dst, ty);
    line(w, dst, "%x");
}

// A checked call's result: `%t<d> =l loadl %out` after checked().
void load_out[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, inout QState[_] q, I64 i) {
    ins(w, dst, q);
    tmp(w, dst, sir, i);
    line(w, dst, " =l loadl %out");
}

void call_ctx[b, n](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, in U8[n] fname) {
    ins(w, dst, q);
    text(w, dst, "%ok =w call $");
    text(w, dst, fname);
    text(w, dst, "(l %ctx");
}

// The symbol of function fn: back_c's EMIT-22 name (fn_symbol), `ci` C(P) C(name), or
// `cg` C(P) `_script` or `_tb<j>` for a script and test j.
void fn_sym[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.SirFunc[_] funcs, in U8[_] pbytes, in QState[_] q, I64 fn) {
    emit.w_byte(w, dst, '$');
    if (funcs[fn].name < 0) {
        text(w, dst, "cg");
        cg_part(w, dst, pbytes, q[0].at, back_c.stem_bytes(pbytes, q[0].at, q[0].len));
        if (funcs[fn].name == -1) {
            text(w, dst, "_script");
        } else {
            text(w, dst, "_tb");
            num(w, dst, -2 - (funcs[fn].name as I64));
        }
        return;
    }
    text(w, dst, "ci");
    I64 at = q[0].at;
    I64 nb = back_c.stem_bytes(pbytes, q[0].at, q[0].len);
    if ((funcs[fn].flags & lowering.FN_IMPORT) != 0) {
        at = funcs[fn].lslot0 as I64;
        nb = back_c.stem_bytes(pbytes, at, funcs[fn].lslot_end as I64);
    }
    I64 ns = toks[funcs[fn].name as I64].start as I64;
    I64 nn = toks[funcs[fn].name as I64].len as I64;
    if (2 + comp_len(pbytes, at, nb) + comp_len(src, ns, nn) <= QBE_NAME_MAX) {
        back_c.comp(w, dst, pbytes, at, nb);
        back_c.comp(w, dst, src, ns, nn);
        return;
    }
    // `cih` and the hash of the whole name (BACK-18).
    U8[1024] s;
    emit.Writer[1] m;
    emit.w_emit(m, NAME_BUF);
    emit.w_text(m, s, "ci");
    back_c.comp(m, s, pbytes, at, nb);
    back_c.comp(m, s, src, ns, nn);
    hash_name(w, dst, s, m[0].pos);
}

// ---------------------------------------------------------------- nodes

void w_bin[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 op = sir[i].c;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    if (op >= lowering.B_AND) {
        // Two values of one type in canonical form give a canonical result.
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        if (op == lowering.B_AND) { text(w, dst, " =l and "); }
        else if (op == lowering.B_OR) { text(w, dst, " =l or "); }
        else { text(w, dst, " =l xor "); }
        opnd(w, dst, sir, funcs, q, a);
        text(w, dst, ", ");
        opnd(w, dst, sir, funcs, q, bb);
        emit.w_nl(w, dst);
        return;
    }
    if (sir[i].f == 1 && op <= lowering.B_MUL) {
        // add, sub, mul wrapping: the low 64 bits, cut back to the type.
        ins(w, dst, q);
        if (op == lowering.B_ADD) { text(w, dst, "%x =l add "); }
        else if (op == lowering.B_SUB) { text(w, dst, "%x =l sub "); }
        else { text(w, dst, "%x =l mul "); }
        opnd(w, dst, sir, funcs, q, a);
        text(w, dst, ", ");
        opnd(w, dst, sir, funcs, q, bb);
        emit.w_nl(w, dst);
        norm_x(w, dst, sir, q, i, ty);
        return;
    }
    if (sir[i].f == 3) {
        // A result-returning form (box 12): the tag to the SO_ETAG node right after, the
        // value when the tag is 0; a shift's count by its type's tag.
        ins(w, dst, q);
        text(w, dst, "%xr =w call $cint_qbe_result_");
        suffix(w, dst, ty);
        text(w, dst, "(w ");
        num(w, dst, op as I64);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, a);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, bb);
        text(w, dst, ", w ");
        num(w, dst, lowering.value_type(sir, funcs, slots, q[0].fn, bb) as I64);
        line(w, dst, ", l %out)");
        if (sir[i + 1].dst >= 0) {
            ins(w, dst, q);
            tmp(w, dst, sir, i + 1);
            line(w, dst, " =l extuw %xr");
        }
        if (sir[i].dst >= 0) { load_out(w, dst, sir, q, i); }
        return;
    }
    if (sir[i].f == 2) {
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        text(w, dst, " =l call $cint_qbe_sat_");
        suffix(w, dst, ty);
        text(w, dst, "(w ");
        num(w, dst, op as I64);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, a);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, bb);
        line(w, dst, ")");
        return;
    }
    ins(w, dst, q);
    if (op == lowering.B_SHL || op == lowering.B_SHR) {
        // shl.checked, shl.wrap (f 1) and shr.checked: the count's pattern and tag.
        text(w, dst, "%ok =w call $cint_qbe_shift_");
        suffix(w, dst, ty);
        text(w, dst, "(l %ctx, ");
        site(w, dst, pbytes, q, sir[i].site as I64);
        text(w, dst, ", w ");
        if (op == lowering.B_SHR) { num(w, dst, 2); } else { num(w, dst, sir[i].f as I64); }
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, a);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, bb);
        text(w, dst, ", w ");
        num(w, dst, lowering.value_type(sir, funcs, slots, q[0].fn, bb) as I64);
        line(w, dst, ", l %out)");
    } else {
        text(w, dst, "%ok =w call $cint_qbe_");
        switch (op) {
            case lowering.B_ADD: text(w, dst, "add_");
            case lowering.B_SUB: text(w, dst, "sub_");
            case lowering.B_MUL: text(w, dst, "mul_");
            case lowering.B_DIV: text(w, dst, "div_");
            default: text(w, dst, "rem_");
        }
        suffix(w, dst, ty);
        text(w, dst, "(l %ctx, ");
        site(w, dst, pbytes, q, sir[i].site as I64);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, a);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, bb);
        line(w, dst, ", l %out)");
    }
    checked(w, dst, q);
    load_out(w, dst, sir, q, i);
}

void w_builtin[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I64 id = sir[i].f as I64;
    I32 ty = sir[i].ty;
    I32 bo = lowering.builtin_opty(sir, i);
    I64 nv = lowering.builtin_arity(sir, i);
    if (id == fold.BI_MUL_FULL) {
        // The exact product of two narrow values of 32 bits or fewer fits 64 bits.
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        text(w, dst, " =l mul ");
        opnd(w, dst, sir, funcs, q, sir[i].a as I64);
        text(w, dst, ", ");
        opnd(w, dst, sir, funcs, q, sir[i].b as I64);
        emit.w_nl(w, dst);
        return;
    }
    if (id == fold.BI_UABS) {
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        text(w, dst, " =l call $cint_qbe_uabs_");
        suffix(w, dst, bo);
        text(w, dst, "(l ");
        opnd(w, dst, sir, funcs, q, sir[i].a as I64);
        line(w, dst, ")");
        return;
    }
    if (id == fold.BI_MIN || id == fold.BI_MAX) {
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        text(w, dst, " =l call $cint_qbe_minmax_");
        suffix(w, dst, bo);
        text(w, dst, "(w ");
        if (id == fold.BI_MAX) { num(w, dst, 1); } else { num(w, dst, 0); }
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, sir[i].a as I64);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, sir[i].b as I64);
        line(w, dst, ")");
        return;
    }
    ins(w, dst, q);
    text(w, dst, "%ok =w call $cint_qbe_builtin_");
    suffix(w, dst, ty);
    text(w, dst, "(l %ctx, ");
    site(w, dst, pbytes, q, sir[i].site as I64);
    text(w, dst, ", w ");
    num(w, dst, id);
    text(w, dst, ", w ");
    num(w, dst, bo as I64);
    text(w, dst, ", w ");
    num(w, dst, sir[i].val & 255);
    text(w, dst, ", w ");
    if (lowering.builtin_rotates(sir, i)) {
        num(w, dst, lowering.value_type(sir, funcs, slots, q[0].fn, sir[i].b as I64) as I64);
    } else if (id == fold.BI_MULDIV) {
        num(w, dst, ty as I64);
    } else {
        num(w, dst, 0);
    }
    for j in 0..3 {
        text(w, dst, ", l ");
        if (j < nv) {
            I64 v = sir[i].a as I64;
            if (j == 1) { v = sir[i].b as I64; }
            else if (j == 2) { v = sir[i].c as I64; }
            opnd(w, dst, sir, funcs, q, v);
        } else {
            num(w, dst, 0);
        }
    }
    line(w, dst, ", l %out)");
    checked(w, dst, q);
    load_out(w, dst, sir, q, i);
}

void w_as[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 from = sir[i].f;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    if (from == lowering.T_BOOL || sir[i].c == 1 || sir[i].c == 2) {
        // From Bool (0 or 1), `as%` and `as?`: the pattern cut back to the target.
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        norm_op(w, dst, ty);
        opnd(w, dst, sir, funcs, q, a);
        emit.w_nl(w, dst);
        return;
    }
    if (sir[i].c == lowering.AS_SAT) {
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        text(w, dst, " =l call $cint_qbe_as_sat(w ");
        num(w, dst, from as I64);
        text(w, dst, ", w ");
        num(w, dst, ty as I64);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, a);
        line(w, dst, ")");
        return;
    }
    call_ctx(w, dst, q, "cint_qbe_as");
    text(w, dst, ", ");
    site(w, dst, pbytes, q, sir[i].site as I64);
    text(w, dst, ", w ");
    num(w, dst, from as I64);
    text(w, dst, ", w ");
    num(w, dst, ty as I64);
    text(w, dst, ", l ");
    opnd(w, dst, sir, funcs, q, a);
    line(w, dst, ", l %out)");
    checked(w, dst, q);
    load_out(w, dst, sir, q, i);
}

// The tag of SO_ETAG node i (box 12). A call's and a result form's were written with their
// node; `as?` gives ArithError.narrow, 4, when the wrapped value is not the source's: their
// patterns differ, or the signedness does and the source is negative.
void w_etag[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        inout QState[_] q, I64 i) {
    I64 a = sir[i].a as I64;
    if ((sir[a].op & lowering.OP_MASK) != lowering.SO_AS || sir[i].dst < 0 || back_c.q_node(sir, a)) {
        return;
    }
    I32 from = sir[a].f;
    if (from == lowering.T_BOOL) {
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        line(w, dst, " =l copy 0");
        return;
    }
    ins(w, dst, q);
    text(w, dst, "%xe =w ceql ");
    tmp(w, dst, sir, a);
    text(w, dst, ", ");
    opnd(w, dst, sir, funcs, q, sir[a].a as I64);
    emit.w_nl(w, dst);
    if (signed(from) != signed(sir[a].ty)) {
        ins(w, dst, q);
        text(w, dst, "%xn =w csltl ");
        opnd(w, dst, sir, funcs, q, sir[a].a as I64);
        line(w, dst, ", 0");
        ins(w, dst, q);
        line(w, dst, "%xe =w cugtw %xe, %xn");
    }
    ins(w, dst, q);
    line(w, dst, "%xe =w xor %xe, 1");
    ins(w, dst, q);
    line(w, dst, "%xl =l extuw %xe");
    ins(w, dst, q);
    tmp(w, dst, sir, i);
    line(w, dst, " =l mul %xl, 4");
}

// SO_WIDEN node i (back_c.c_widens): tag a moved by the run of SK_WIDEN slot b that holds it,
// per run in tag order, the last without a test. The tags are in range, so nothing wraps.
void w_widen[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, inout QState[_] q, I64 i) {
    I64 k = sir[i].b as I64;
    I64 r = k + 1;
    while (r < q[0].nslot && slots[r].kind == lowering.SK_WRUN) {
        Bool more = r + 1 < q[0].nslot && slots[r + 1].kind == lowering.SK_WRUN;
        if (more) {
            ins(w, dst, q);
            text(w, dst, "%xw =w culel ");
            opnd(w, dst, sir, funcs, q, sir[i].a as I64);
            text(w, dst, ", ");
            num(w, dst, slots[r].name as I64);
            emit.w_nl(w, dst);
            ins(w, dst, q);
            text(w, dst, "jnz %xw, @w");
            num(w, dst, i);
            emit.w_byte(w, dst, '_');
            num(w, dst, r);
            text(w, dst, ", @w");
            num(w, dst, i);
            emit.w_byte(w, dst, 'n');
            num(w, dst, r);
            emit.w_nl(w, dst);
            text(w, dst, "@w");
            num(w, dst, i);
            emit.w_byte(w, dst, '_');
            num(w, dst, r);
            emit.w_nl(w, dst);
        }
        ins(w, dst, q);
        tmp(w, dst, sir, i);
        text(w, dst, " =l add ");
        opnd(w, dst, sir, funcs, q, sir[i].a as I64);
        text(w, dst, ", ");
        num(w, dst, slots[r].ty as I64);
        emit.w_nl(w, dst);
        if (more) {
            ins(w, dst, q);
            text(w, dst, "jmp @w");
            num(w, dst, i);
            emit.w_byte(w, dst, 'e');
            emit.w_nl(w, dst);
            text(w, dst, "@w");
            num(w, dst, i);
            emit.w_byte(w, dst, 'n');
            num(w, dst, r);
            emit.w_nl(w, dst);
        }
        r += 1;
    }
    text(w, dst, "@w");
    num(w, dst, i);
    emit.w_byte(w, dst, 'e');
    emit.w_nl(w, dst);
}

// A switch's dispatch (back_c.c_dispatch): one test per item in case order, a jump to the
// default or the end after the last; an item that covers the whole type ends the tests.
void w_dispatch[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        inout QState[_] q, I64 sw) {
    I32 ty = sir[sw].ty;
    Bool s = signed(ty);
    I64 c = sir[sw].b as I64;
    I64 dflt = -1;
    while (c >= 0) {
        if ((sir[c].op & lowering.OP_MASK) == lowering.SO_DEFAULT) {
            dflt = c;
        }
        I64 j = c + 1;
        while ((sir[j].op & lowering.OP_MASK) == lowering.SO_ITEM) {
            if (verify.whole_item(sir, sw, j)) {
                jump(w, dst, q, c, 'c');
                return;
            }
            ins(w, dst, q);
            text(w, dst, "%lo =l ");
            if (s) { text(w, dst, "csgel "); } else { text(w, dst, "cugel "); }
            opnd(w, dst, sir, funcs, q, sir[sw].a as I64);
            text(w, dst, ", ");
            num(w, dst, sir[j].val);
            emit.w_nl(w, dst);
            text(w, dst, "    %hi =l ");
            if (s) { text(w, dst, "cslel "); } else { text(w, dst, "culel "); }
            opnd(w, dst, sir, funcs, q, sir[sw].a as I64);
            text(w, dst, ", ");
            num(w, dst, sir[j + 1].val);
            emit.w_nl(w, dst);
            line(w, dst, "    %in =l and %lo, %hi");
            text(w, dst, "    jnz %in, ");
            lab_ref(w, dst, c, 'c');
            text(w, dst, ", @u");
            num(w, dst, q[0].nlab);
            emit.w_nl(w, dst);
            text(w, dst, "@u");
            num(w, dst, q[0].nlab);
            emit.w_nl(w, dst);
            q[0].nlab += 1;
            j += 2;
        }
        c = sir[c].b as I64;
    }
    if (dflt >= 0) {
        jump(w, dst, q, dflt, 'c');
    } else {
        jump(w, dst, q, sw, 'e');
    }
}

// A call of an extern (back_c.host_call), SO_CALL node i with b 1: each argument as a
// cint_value of 200 bytes in %hv, a scalar by cint_rt_arg_scalar or a rank-1 view by
// cint_rt_arg_view, read for `in` and write for `out`; then row host_index of the module's host
// import table through cint_qbe_host_call, which charges the call's fuel, faults on the host's
// refusal and writes the value to %out and an error union's tag to %et.
void w_host_call[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I64 a = sir[i].a as I64;
    I64 nargs = sir[i].c as I64;
    I64 p0 = funcs[a].pslot0 as I64;
    for j in 0..nargs {
        I64 g = i - nargs + j;
        I32 pty = slots[p0 + j].ty;
        ins(w, dst, q);
        text(w, dst, "%ha =l add %hv, ");
        num(w, dst, 200 * j);
        emit.w_nl(w, dst);
        if (sir[g].e == 0) {
            ins(w, dst, q);
            text(w, dst, "call $cint_rt_arg_scalar(l %ha, w ");
            num(w, dst, rt_tag(pty));
            text(w, dst, ", l ");
            opnd(w, dst, sir, funcs, q, sir[g].a as I64);
            line(w, dst, ")");
            continue;
        }
        if (sir[g].e == 4) {
            ins(w, dst, q);
            text(w, dst, "%a");
            num(w, dst, 4 * g);
            text(w, dst, " =l copy ");
            node_data(w, dst, pbytes, q, 'd', sir[g].a as I64);
            emit.w_nl(w, dst);
            ins(w, dst, q);
            text(w, dst, "%a");
            num(w, dst, 4 * g + 1);
            line(w, dst, " =l copy 0");
            ins(w, dst, q);
            text(w, dst, "%a");
            num(w, dst, 4 * g + 2);
            text(w, dst, " =l copy ");
            num(w, dst, sir[sir[g].a as I64].c as I64);
            emit.w_nl(w, dst);
            ins(w, dst, q);
            text(w, dst, "%a");
            num(w, dst, 4 * g + 3);
            line(w, dst, " =l copy 1");
        } else {
            view_parts(w, dst, q, slots, sir[g].a as I64, 0, 'a', 4 * g);
        }
        ins(w, dst, q);
        text(w, dst, "call $cint_rt_arg_view(l %ha, w ");
        num(w, dst, rt_tag(lowering.array_elem(pty)));
        for z in 0..4 {
            text(w, dst, ", l ");
            vt(w, dst, 'a', 4 * g + z);
        }
        if (slots[p0 + j].live == 2) { line(w, dst, ", w 1)"); } else { line(w, dst, ", w 0)"); }
    }
    call_ctx(w, dst, q, "cint_qbe_host_call");
    text(w, dst, ", ");
    site(w, dst, pbytes, q, sir[i].site as I64);
    text(w, dst, ", w ");
    num(w, dst, back_c.host_index(funcs, a));
    text(w, dst, ", l %hv, w ");
    num(w, dst, nargs);
    text(w, dst, ", w ");
    num(w, dst, rt_tag(funcs[a].result));
    text(w, dst, ", w ");
    num(w, dst, back_c.host_errors(funcs, slots, a));
    line(w, dst, ", l %out, l %et)");
    checked(w, dst, q);
    if (sir[i].dst >= 0) {
        load_out(w, dst, sir, q, i);
    }
    if ((funcs[a].flags & lowering.FN_ERRU) != 0 && sir[i + 1].dst >= 0) {
        ins(w, dst, q);
        tmp(w, dst, sir, i + 1);
        line(w, dst, " =l loadl %et");
    }
}

// The runtime's tag of type ty (rt/cint_rt.h CINT_TAG_*, cintc's codes): a `Grants` handle
// is an I64, `void` 0.
I64 rt_tag(I32 ty) {
    if (ty == lowering.T_GRANTS) { return lowering.T_I64 as I64; }
    if (ty == lowering.T_NONE) { return 0; }
    // A module-level handle's CINT_TAG_HANDLE (rt/OPEN.md RT-OQ-50).
    if (ty == lowering.T_HANDLE) { return 0x75; }
    // A fixed-point type word, CINT_QT(storage, f) (rt/cint_fixed.h; IM-146 tag 31).
    if (lowering.is_q(ty)) { return fold.q_frac(ty as I64) * 65536 + 0x3100 + (back_c.st_of(ty) as I64); }
    return ty as I64;
}

void w_call[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, in U8[_] pbytes,
        inout QState[_] q, I64 i) {
    I64 a = sir[i].a as I64;
    // The parts of each view argument, and a size parameter's extent, before the call.
    for j in i - (sir[i].c as I64)..i {
        if (sir[j].e == 1) {
            view_parts(w, dst, q, slots, sir[j].a as I64, 0, 'a', 4 * j);
        } else if (sir[j].e == 2) {
            ext_get(w, dst, q, slots, sir[j].a as I64, sir[j].f as I64, 'a', 4 * j);
        }
    }
    call_ctx(w, dst, q, "cint_qbe_call_enter");
    text(w, dst, ", ");
    site(w, dst, pbytes, q, sir[i].site as I64);
    line(w, dst, ")");
    checked(w, dst, q);
    text(w, dst, "    %ok =w call ");
    fn_sym(w, dst, src, toks, funcs, pbytes, q, a);
    text(w, dst, "(l %ctx");
    for j in i - (sir[i].c as I64)..i {
        if (sir[j].e == 1 || sir[j].e == 2) {
            I64 parts = 1;
            if (sir[j].e == 1) { parts = 4; }
            for g in 0..parts {
                text(w, dst, ", l ");
                vt(w, dst, 'a', 4 * j + g);
            }
        } else if (sir[j].e == 4) {
            // A string literal passed to a view: its bytes, origin 0, its length, stride 1.
            text(w, dst, ", l ");
            node_data(w, dst, pbytes, q, 'd', sir[j].a as I64);
            text(w, dst, ", l 0, l ");
            num(w, dst, sir[sir[j].a as I64].c as I64);
            text(w, dst, ", l 1");
        } else if (sir[j].e == 5) {
            text(w, dst, ", l ");
            num(w, dst, sir[sir[j].a as I64].c as I64);
        } else if (sir[j].e == 9) {
            // An arena or a pool: its identifier.
            text(w, dst, ", l ");
            I64 ck = sir[j].a as I64;
            if (slots[ck].kind == lowering.SK_ARENA_M || slots[ck].kind == lowering.SK_POOL_M) {
                num(w, dst, lowering.container_id(slots, ck));
            } else {
                text(w, dst, "%s");
                num(w, dst, ck);
            }
        } else if (sir[j].e == 7 || sir[j].e == 3 || sir[j].e == 6) {
            // A view of rank 2 to 4, or a record: its address; the callee copies a value.
            text(w, dst, ", l ");
            vt(w, dst, 's', sir[j].a as I64);
        } else {
            text(w, dst, ", l ");
            opnd(w, dst, sir, funcs, q, sir[j].a as I64);
        }
    }
    if (sir[i].f > 0) {
        // A record result goes to its slot.
        text(w, dst, ", l %s");
        num(w, dst, (sir[i].f - 1) as I64);
    } else if (boxed(funcs[a].result)) {
        // A handle result goes to the call's temporary, or to a scratch handle.
        if (sir[i].dst >= 0) {
            text(w, dst, ", l ");
            tmp(w, dst, sir, i);
        } else {
            text(w, dst, ", l %mh");
        }
    } else if (funcs[a].result != lowering.T_NONE) {
        text(w, dst, ", l %out");
    }
    if ((funcs[a].flags & lowering.FN_ERRU) != 0) {
        text(w, dst, ", l %et");
    }
    line(w, dst, ")");
    checked(w, dst, q);
    if (sir[i].dst >= 0 && !boxed(funcs[a].result)) {
        load_out(w, dst, sir, q, i);
    }
    if ((funcs[a].flags & lowering.FN_ERRU) != 0 && sir[i + 1].dst >= 0) {
        // The tag goes to the SO_ETAG node right after the call (box 12).
        ins(w, dst, q);
        tmp(w, dst, sir, i + 1);
        line(w, dst, " =l loadl %et");
    }
    line(w, dst, "    call $cint_qbe_call_leave(l %ctx)");
}

// Whether function fn makes a box 12 call or takes a handle result it discards: the cells
// %mt (a result form's tag), %mv (a scalar to insert), %mc (a child's identifier) and %mh.
Bool uses_mem(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, I64 fn) {
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        I32 k = sir[i].op & lowering.OP_MASK;
        if (k == lowering.SO_MEMBER || k == lowering.SO_MVIEW || k == lowering.SO_PREF || k == lowering.SO_LEASE) {
            return true;
        }
        if (k == lowering.SO_CALL && sir[i].b == 0 && boxed(funcs[sir[i].a as I64].result)) {
            return true;
        }
    }
    return false;
}

// The container operand of a box 12 call: a module's arena or pool by its identifier, or the
// slot that holds one at run time.
void container[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.SirSlot[_] slots, I64 k) {
    text(w, dst, ", w ");
    if (slots[k].kind == lowering.SK_ARENA_M || slots[k].kind == lowering.SK_POOL_M) {
        num(w, dst, lowering.container_id(slots, k));
    } else {
        text(w, dst, "%s");
        num(w, dst, k);
    }
}

// `%ok =w call $cint_mem_<name>(l %ctx, :site, l $cg<P>_mem`: a box 12 call (back_c.c_mem_open).
void mem_call[b, n](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] pbytes, inout QState[_] q,
        in lowering.Sir[_] sir, I64 i, in U8[n] name) {
    ins(w, dst, q);
    text(w, dst, "%ok =w call $cint_mem_");
    text(w, dst, name);
    text(w, dst, "(l %ctx, ");
    site(w, dst, pbytes, q, sir[i].site as I64);
    text(w, dst, ", l ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_mem");
}

// The end of a box 12 call returning C bool: only its low byte is defined, so it is extended
// before the test (and so for every bool the runtime returns to QBE code).
void bool_checked[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q) {
    line(w, dst, ")");
    line(w, dst, "    %ok =w extub %ok");
    checked(w, dst, q);
}

// Box 12 node i (back_c.c_node SO_MEMBER, SO_MVIEW, SO_LEASE, SO_PREF; rt/cint_mem.h). A
// handle goes by value as `:handle`, which QBE copies as C passes 32 bytes.
void w_mem[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    if (k == lowering.SO_MVIEW) {
        mem_call(w, dst, pbytes, q, sir, i, "view");
        container(w, dst, slots, bb);
        text(w, dst, ", :handle ");
        opnd(w, dst, sir, funcs, q, sir[i].c as I64);
        text(w, dst, ", l %s");
        num(w, dst, a);
        text(w, dst, ", l %s");
        num(w, dst, a + 1);
        bool_checked(w, dst, q);
        return;
    }
    if (k == lowering.SO_LEASE) {
        mem_call(w, dst, pbytes, q, sir, i, "lease");
        text(w, dst, ", l %s");
        num(w, dst, a);
        bool_checked(w, dst, q);
        return;
    }
    if (k == lowering.SO_PREF) {
        // The address of the pool's element, 0 (a fault) when the handle does not check.
        ins(w, dst, q);
        text(w, dst, "%s");
        num(w, dst, a);
        text(w, dst, " =l call $cint_mem_deref(l %ctx, ");
        site(w, dst, pbytes, q, sir[i].site as I64);
        text(w, dst, ", l ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_mem");
        container(w, dst, slots, bb);
        text(w, dst, ", :handle ");
        opnd(w, dst, sir, funcs, q, sir[i].c as I64);
        line(w, dst, ")");
        text(w, dst, "    jnz %s");
        num(w, dst, a);
        text(w, dst, ", @u");
        num(w, dst, q[0].nlab);
        line(w, dst, ", @fault");
        text(w, dst, "@u");
        num(w, dst, q[0].nlab);
        emit.w_nl(w, dst);
        q[0].nlab += 1;
        return;
    }
    I64 mb = sir[i].c as I64;
    Bool res = mb == resolve.MB_ALLOC_RESULT || mb == resolve.MB_INSERT_RESULT;
    I32 ety = slots[a].ty;
    if (res) {
        ins(w, dst, q);
        line(w, dst, "storel 0, %mt");
    }
    if (mb == resolve.MB_INSERT || mb == resolve.MB_INSERT_RESULT) {
        if (ety < lowering.T_STRUCT && !boxed(ety)) {
            // A scalar element's bytes: the value in a cell, little-endian at its own width.
            ins(w, dst, q);
            text(w, dst, "storel ");
            opnd(w, dst, sir, funcs, q, bb);
            line(w, dst, ", %mv");
        }
        mem_call(w, dst, pbytes, q, sir, i, "insert");
        container(w, dst, slots, a);
        text(w, dst, ", l ");
        if (boxed(ety)) {
            opnd(w, dst, sir, funcs, q, bb);
        } else if (ety < lowering.T_STRUCT) {
            text(w, dst, "%mv");
        } else {
            text(w, dst, "%s");
            num(w, dst, sir[i].f as I64);
        }
    } else if (mb == resolve.MB_ALLOC || mb == resolve.MB_ALLOC_RESULT) {
        mem_call(w, dst, pbytes, q, sir, i, "alloc");
        container(w, dst, slots, a);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, bb);
    } else if (mb == resolve.MB_CHILD) {
        mem_call(w, dst, pbytes, q, sir, i, "child");
        container(w, dst, slots, a);
        text(w, dst, ", l ");
        opnd(w, dst, sir, funcs, q, bb);
        text(w, dst, ", l %mc");
        bool_checked(w, dst, q);
        ins(w, dst, q);
        text(w, dst, "%s");
        num(w, dst, sir[i].f as I64);
        line(w, dst, " =l loaduw %mc");
        return;
    } else if (mb == resolve.MB_RESET) {
        mem_call(w, dst, pbytes, q, sir, i, "reset");
        container(w, dst, slots, a);
        bool_checked(w, dst, q);
        return;
    } else {
        mem_call(w, dst, pbytes, q, sir, i, "remove");
        container(w, dst, slots, a);
        text(w, dst, ", :handle ");
        opnd(w, dst, sir, funcs, q, bb);
        bool_checked(w, dst, q);
        return;
    }
    // alloc and insert: the result form flag, the handle's temporary, the tag's cell.
    if (res) { text(w, dst, ", w 1, l "); } else { text(w, dst, ", w 0, l "); }
    if (sir[i].dst >= 0) { tmp(w, dst, sir, i); } else { text(w, dst, "%mh"); }
    if (res) { text(w, dst, ", l %mt"); } else { text(w, dst, ", l 0"); }
    bool_checked(w, dst, q);
    if (res && sir[i + 1].dst >= 0) {
        ins(w, dst, q);
        tmp(w, dst, sir, i + 1);
        line(w, dst, " =l loaduh %mt");
    }
}

// The module's arena and pool table (back_c.c_memories; rt/cint_mem.h): per arena or pool k
// $cg<P>_mt<k>, its element type (back_c.qbe_type_bytes), and for a record element
// $cg<P>_ml<k>, each definition's size and field offsets; $cg<P>_mn<k>, its name; then
// $cg<P>_memd, one 56-byte cint_mem_decl each, and $cg<P>_mem, the 16-byte cint_mem_table.
// Returns false when a table outgrows what this writer holds (64 containers, 256 definitions).
Bool w_memories[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.SirFunc[_] funcs, inout lowering.SirSlot[_] slots, in lowering.LState[_] ls,
        in limits.Decl[_] decls, in U8[_] pbytes, in back_c.PMod[_] pm, in QState[_] q) {
    I64[257] defs;
    I64[64] tls;
    I64[64] nls;
    I64 nmem = 0;
    for k in 0..ls[0].nslot {
        if (slots[k].kind != lowering.SK_ARENA_M && slots[k].kind != lowering.SK_POOL_M) { continue; }
        if (nmem == 64) { return false; }
        I32 ety = slots[k].ty;
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_mt");
        num(w, dst, nmem);
        text(w, dst, " = {{ b");
        I64 tl = back_c.qbe_type_bytes(w, dst, src, toks, funcs, slots, ls, pbytes, pm, q[0].module, decls, ety, defs);
        if (tl < 0) { return false; }
        line(w, dst, " }}");
        I64 nl = 0;
        if (ety >= lowering.T_STRUCT) {
            text(w, dst, "data ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_ml");
            num(w, dst, nmem);
            text(w, dst, " = align 4 {{ ");
            nl = layout_rows(w, dst, slots, defs);
            line(w, dst, " }}");
        }
        I64 tk = slots[k].name as I64;
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_mn");
        num(w, dst, nmem);
        text(w, dst, " = {{ ");
        bytes(w, dst, src, toks[tk].start as I64, toks[tk].len as I64);
        line(w, dst, " }}");
        tls[nmem] = tl;
        nls[nmem] = nl;
        nmem += 1;
    }
    if (nmem == 0) { return true; }
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_memd = align 8 {{ ");
    I64 m = 0;
    for k in 0..ls[0].nslot {
        if (slots[k].kind != lowering.SK_ARENA_M && slots[k].kind != lowering.SK_POOL_M) { continue; }
        I32 ety = slots[k].ty;
        I64 eb = size_of(ety);
        if (ety >= lowering.T_STRUCT) { eb = ty_size(slots, ety); }
        if (m > 0) { text(w, dst, ", "); }
        // kind, elem_bytes, capacity, type, layout, type_len, layout_len, cell 0, name_len, name.
        text(w, dst, "w ");
        if (slots[k].kind == lowering.SK_ARENA_M) { num(w, dst, 1); } else { num(w, dst, 2); }
        text(w, dst, ", w ");
        num(w, dst, eb);
        text(w, dst, ", l ");
        num(w, dst, slots[k].live as I64);
        text(w, dst, ", l ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_mt");
        num(w, dst, m);
        text(w, dst, ", l ");
        if (ety >= lowering.T_STRUCT) {
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_ml");
            num(w, dst, m);
        } else {
            num(w, dst, 0);
        }
        text(w, dst, ", w ");
        num(w, dst, tls[m]);
        text(w, dst, ", w ");
        num(w, dst, nls[m]);
        text(w, dst, ", w 0, w ");
        num(w, dst, toks[slots[k].name as I64].len as I64);
        text(w, dst, ", l ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_mn");
        num(w, dst, m);
        m += 1;
    }
    line(w, dst, " }}");
    text(w, dst, "export data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_mem = align 8 {{ w ");
    num(w, dst, nmem);
    text(w, dst, ", w ");
    num(w, dst, q[0].module);
    text(w, dst, ", l ");
    mod_sym(w, dst, pbytes, q);
    line(w, dst, "_memd }}");
    return true;
}

// Print pieces: the data $<module>_qp<i>_<k> holds node i's piece k of at most 1,024 bytes.
void w_print_bytes[b](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] pbytes, inout QState[_] q,
        in lowering.Sir[_] sir, I64 i) {
    I64 left = sir[i].c as I64;
    I64 piece = 0;
    while (left > 0) {
        I64 n = left;
        if (n > 1024) { n = 1024; }
        call_ctx(w, dst, q, "cint_qbe_print_bytes");
        text(w, dst, ", l ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_qp");
        num(w, dst, i);
        emit.w_byte(w, dst, '_');
        num(w, dst, piece);
        text(w, dst, ", l ");
        num(w, dst, n);
        line(w, dst, ")");
        checked(w, dst, q);
        left -= n;
        piece += 1;
    }
}

void w_node[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, in U8[_] pbytes,
        inout QState[_] q, I64 i) {
    I64 fn = q[0].fn;
    I32 k = sir[i].op & lowering.OP_MASK;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    if (lane_node(sir, i)) {
        w_lane(w, dst, sir, funcs, slots, pbytes, q, i);
        return;
    }
    if (back_c.q_limbs_node(sir, i)) {
        w_q_limbs(w, dst, sir, funcs, slots, pbytes, q, i);
        return;
    }
    if (back_c.q_node(sir, i)) {
        w_q(w, dst, sir, funcs, slots, pbytes, q, i);
        return;
    }
    if (back_c.wide_node(sir, i)) {
        w_wide(w, dst, sir, funcs, slots, pbytes, q, i);
        return;
    }
    switch (k) {
        case lowering.SO_CONST:
            if (sir[i].dst < 0) {
                return;   // a module variable's initial value (global_init), in the state image
            }
            if (lowering.is_limbs(ty)) {
                // A wide constant's limbs are module data (w_wide_consts).
                ins(w, dst, q);
                text(w, dst, "blit ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_wk");
                num(w, dst, i);
                text(w, dst, ", ");
                tmp(w, dst, sir, i);
                blit_n(w, dst, ty);
                return;
            }
            if (boxed(ty)) {
                // The null handle (node_ok admits no other handle constant).
                ins(w, dst, q);
                text(w, dst, "call $cint_qbe_zero(l ");
                tmp(w, dst, sir, i);
                line(w, dst, ", l 32)");
                return;
            }
            ins(w, dst, q);
            tmp(w, dst, sir, i);
            text(w, dst, " =l copy ");
            num(w, dst, sir[i].val);
            emit.w_nl(w, dst);
        case lowering.SO_LOAD:
            if (boxed(ty) && slots[a].kind != lowering.SK_GLOBAL && slots[a].kind != lowering.SK_IGLOBAL) {
                ins(w, dst, q);
                text(w, dst, "blit %s");
                num(w, dst, a);
                text(w, dst, ", ");
                tmp(w, dst, sir, i);
                blit_n(w, dst, ty);
                return;
            }
            if ((slots[a].kind == lowering.SK_GLOBAL || slots[a].kind == lowering.SK_IGLOBAL) && boxed(ty)) {
                state_addr(w, dst, sir, slots, q, a);
                ins(w, dst, q);
                text(w, dst, "blit %ga, ");
                tmp(w, dst, sir, i);
                blit_n(w, dst, ty);
                return;
            }
            if (scalar_place(slots, a)) {
                ins(w, dst, q);
                tmp(w, dst, sir, i);
                text(w, dst, " =l ");
                load_op(w, dst, slots[a].ty);
                text(w, dst, " %s");
                num(w, dst, a);
                emit.w_nl(w, dst);
                return;
            }
            if (slots[a].kind == lowering.SK_GLOBAL || slots[a].kind == lowering.SK_IGLOBAL) {
                state_addr(w, dst, sir, slots, q, a);
                ins(w, dst, q);
                tmp(w, dst, sir, i);
                text(w, dst, " =l ");
                load_op(w, dst, slots[a].ty);
                line(w, dst, " %ga");
                return;
            }
            ins(w, dst, q);
            tmp(w, dst, sir, i);
            text(w, dst, " =l copy %s");
            num(w, dst, a);
            emit.w_nl(w, dst);
        case lowering.SO_STORE:
            if ((slots[a].kind == lowering.SK_GLOBAL || slots[a].kind == lowering.SK_IGLOBAL) && boxed(slots[a].ty)) {
                state_addr(w, dst, sir, slots, q, a);
                ins(w, dst, q);
                text(w, dst, "blit ");
                opnd(w, dst, sir, funcs, q, bb);
                text(w, dst, ", %ga");
                blit_n(w, dst, slots[a].ty);
                return;
            }
            if (scalar_place(slots, a)) {
                ins(w, dst, q);
                store_op(w, dst, slots[a].ty);
                emit.w_byte(w, dst, ' ');
                opnd(w, dst, sir, funcs, q, bb);
                text(w, dst, ", %s");
                num(w, dst, a);
                emit.w_nl(w, dst);
                return;
            }
            if (slots[a].kind == lowering.SK_GLOBAL || slots[a].kind == lowering.SK_IGLOBAL) {
                state_addr(w, dst, sir, slots, q, a);
                ins(w, dst, q);
                store_op(w, dst, slots[a].ty);
                emit.w_byte(w, dst, ' ');
                opnd(w, dst, sir, funcs, q, bb);
                line(w, dst, ", %ga");
                return;
            }
            if (boxed(slots[a].ty)) {
                ins(w, dst, q);
                text(w, dst, "blit ");
                opnd(w, dst, sir, funcs, q, bb);
                text(w, dst, ", %s");
                num(w, dst, a);
                blit_n(w, dst, slots[a].ty);
                return;
            }
            ins(w, dst, q);
            text(w, dst, "%s");
            num(w, dst, a);
            text(w, dst, " =l copy ");
            opnd(w, dst, sir, funcs, q, bb);
            emit.w_nl(w, dst);
        case lowering.SO_MEMBER, lowering.SO_MVIEW, lowering.SO_LEASE, lowering.SO_PREF:
            w_mem(w, dst, sir, funcs, slots, pbytes, q, i);
        case lowering.SO_VDIM:
            // Extent d of a run-time-sized local array, before its SO_VALLOC.
            ins(w, dst, q);
            text(w, dst, "%xa =l add %s");
            num(w, dst, a);
            text(w, dst, ", ");
            num(w, dst, 24 + 8 * (sir[i].f as I64));
            emit.w_nl(w, dst);
            ins(w, dst, q);
            text(w, dst, "storel ");
            opnd(w, dst, sir, funcs, q, bb);
            line(w, dst, ", %xa");
        case lowering.SO_VALLOC:
            call_ctx(w, dst, q, "cint_qbe_scratch");
            text(w, dst, ", ");
            site(w, dst, pbytes, q, sir[i].site as I64);
            text(w, dst, ", l %s");
            num(w, dst, a);
            text(w, dst, ", l ");
            num(w, dst, sir[i].f as I64);
            text(w, dst, ", l ");
            num(w, dst, ty_size(slots, ty));
            line(w, dst, ")");
            checked(w, dst, q);
        case lowering.SO_BIN:
            w_bin(w, dst, sir, funcs, slots, pbytes, q, i);
        case lowering.SO_BUILTIN:
            w_builtin(w, dst, sir, funcs, slots, pbytes, q, i);
        case lowering.SO_UN:
            ins(w, dst, q);
            if (sir[i].c == lowering.U_NEG) {
                text(w, dst, "%ok =w call $cint_qbe_neg_");
                suffix(w, dst, ty);
                text(w, dst, "(l %ctx, ");
                site(w, dst, pbytes, q, sir[i].site as I64);
                text(w, dst, ", l ");
                opnd(w, dst, sir, funcs, q, a);
                line(w, dst, ", l %out)");
                checked(w, dst, q);
                load_out(w, dst, sir, q, i);
            } else if (sir[i].c == lowering.U_LNOT) {
                tmp(w, dst, sir, i);
                text(w, dst, " =l xor ");
                opnd(w, dst, sir, funcs, q, a);
                line(w, dst, ", 1");
            } else {
                text(w, dst, "%x =l xor ");
                opnd(w, dst, sir, funcs, q, a);
                line(w, dst, ", -1");
                norm_x(w, dst, sir, q, i, ty);
            }
        case lowering.SO_CMP:
            ins(w, dst, q);
            tmp(w, dst, sir, i);
            Bool s = signed(sir[i].f);
            switch (sir[i].c) {
                case lowering.CMP_EQ: text(w, dst, " =l ceql ");
                case lowering.CMP_NE: text(w, dst, " =l cnel ");
                case lowering.CMP_LT:
                    if (s) { text(w, dst, " =l csltl "); } else { text(w, dst, " =l cultl "); }
                case lowering.CMP_LE:
                    if (s) { text(w, dst, " =l cslel "); } else { text(w, dst, " =l culel "); }
                case lowering.CMP_GT:
                    if (s) { text(w, dst, " =l csgtl "); } else { text(w, dst, " =l cugtl "); }
                default:
                    if (s) { text(w, dst, " =l csgel "); } else { text(w, dst, " =l cugel "); }
            }
            opnd(w, dst, sir, funcs, q, a);
            text(w, dst, ", ");
            opnd(w, dst, sir, funcs, q, bb);
            emit.w_nl(w, dst);
        case lowering.SO_AS:
            w_as(w, dst, sir, funcs, pbytes, q, i);
        case lowering.SO_CALL:
            if (sir[i].b == 1) {
                w_host_call(w, dst, sir, funcs, slots, pbytes, q, i);
            } else {
                w_call(w, dst, src, toks, sir, funcs, slots, pbytes, q, i);
            }
        case lowering.SO_FUEL:
            if (i != funcs[fn].first as I64 || funcs[fn].entry == 0) {
                call_ctx(w, dst, q, "cint_qbe_fuel");
                text(w, dst, ", ");
                site(w, dst, pbytes, q, sir[i].site as I64);
                text(w, dst, ", l ");
                num(w, dst, sir[i].val);
                line(w, dst, ")");
                checked(w, dst, q);
            }
        case lowering.SO_RETURN:
            if ((funcs[fn].flags & lowering.FN_ERRU) != 0) {
                // The error tag, 0 when the result holds the value (back_c's `*etag`).
                ins(w, dst, q);
                text(w, dst, "storel ");
                if (sir[i].b == 3) { opnd(w, dst, sir, funcs, q, a); } else { emit.w_byte(w, dst, '0'); }
                line(w, dst, ", %etag");
            }
            if (sir[i].b == 1 && boxed(funcs[fn].result)) {
                ins(w, dst, q);
                text(w, dst, "blit ");
                opnd(w, dst, sir, funcs, q, a);
                text(w, dst, ", %result");
                blit_n(w, dst, funcs[fn].result);
            } else if (sir[i].b == 1) {
                ins(w, dst, q);
                text(w, dst, "storel ");
                opnd(w, dst, sir, funcs, q, a);
                line(w, dst, ", %result");
            } else if (sir[i].b == 2) {
                addr_e(w, dst, q, 0, a, 0);
                ins(w, dst, q);
                line(w, dst, "%e1 =l copy %result");
                blit_e(w, dst, q, ty_size(slots, slots[a].ty));
            }
            frame_return(w, dst, funcs, q);
            ins(w, dst, q);
            line(w, dst, "ret 1");
            q[0].term = 1;
        case lowering.SO_ETAG:
            w_etag(w, dst, sir, funcs, q, i);
        case lowering.SO_WIDEN:
            w_widen(w, dst, sir, funcs, slots, q, i);
        case lowering.SO_ERROR:
            // An error leaving a test block (LS-315): the test fails with it.
            ins(w, dst, q);
            text(w, dst, "call $cint_rt_error_result(l %ctx, l ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_es");
            num(w, dst, sir[i].c as I64);
            text(w, dst, ", l ");
            opnd(w, dst, sir, funcs, q, a);
            line(w, dst, ")");
        case lowering.SO_ASSERT:
            ins(w, dst, q);
            text(w, dst, "jnz ");
            opnd(w, dst, sir, funcs, q, a);
            text(w, dst, ", @u");
            num(w, dst, q[0].nlab + 1);
            text(w, dst, ", @u");
            num(w, dst, q[0].nlab);
            emit.w_nl(w, dst);
            text(w, dst, "@u");
            num(w, dst, q[0].nlab);
            emit.w_nl(w, dst);
            I64 pass = q[0].nlab + 1;
            q[0].nlab += 2;
            text(w, dst, "    %ok =w call $cint_qbe_assert(l %ctx, ");
            site(w, dst, pbytes, q, sir[i].site as I64);
            if (sir[i].b == 1) {
                text(w, dst, ", w ");
                num(w, dst, rt_tag(sir[a].f));
                text(w, dst, ", l ");
                opnd(w, dst, sir, funcs, q, sir[a].a as I64);
                text(w, dst, ", l ");
                opnd(w, dst, sir, funcs, q, sir[a].b as I64);
            } else {
                text(w, dst, ", w 0, l 0, l 0");
            }
            line(w, dst, ")");
            text(w, dst, "    jnz %ok, @u");
            num(w, dst, pass);
            line(w, dst, ", @fault");
            text(w, dst, "@u");
            num(w, dst, pass);
            emit.w_nl(w, dst);
        case lowering.SO_PRINT_BEGIN:
            call_ctx(w, dst, q, "cint_qbe_print_begin");
            text(w, dst, ", ");
            site(w, dst, pbytes, q, sir[i].site as I64);
            line(w, dst, ")");
            checked(w, dst, q);
        case lowering.SO_PRINT_BYTES:
            w_print_bytes(w, dst, pbytes, q, sir, i);
        case lowering.SO_PRINT_VALUE:
            call_ctx(w, dst, q, "cint_qbe_print_value");
            text(w, dst, ", w ");
            num(w, dst, ty as I64);
            text(w, dst, ", l ");
            opnd(w, dst, sir, funcs, q, a);
            text(w, dst, ", w ");
            num(w, dst, sir[i].e as I64);
            text(w, dst, ", w ");
            num(w, dst, sir[i].f as I64);
            text(w, dst, ", l ");
            num(w, dst, sir[i].val);
            text(w, dst, ", w ");
            num(w, dst, sir[i].c as I64);
            line(w, dst, ")");
            checked(w, dst, q);
        case lowering.SO_PRINT_END:
            call_ctx(w, dst, q, "cint_qbe_print_end");
            line(w, dst, ")");
            checked(w, dst, q);
        case lowering.SO_THEN:
            ins(w, dst, q);
            text(w, dst, "jnz ");
            opnd(w, dst, sir, funcs, q, a);
            text(w, dst, ", @u");
            num(w, dst, q[0].nlab);
            text(w, dst, ", ");
            lab_ref(w, dst, i, 'f');
            emit.w_nl(w, dst);
            q[0].term = 1;
        case lowering.SO_TEST:
            ins(w, dst, q);
            text(w, dst, "jnz ");
            opnd(w, dst, sir, funcs, q, a);
            text(w, dst, ", @u");
            num(w, dst, q[0].nlab);
            text(w, dst, ", ");
            lab_ref(w, dst, bb, 'e');
            emit.w_nl(w, dst);
            q[0].term = 1;
        case lowering.SO_SWITCH:
            w_dispatch(w, dst, sir, funcs, q, i);
        case lowering.SO_ICHECK:
            w_icheck(w, dst, sir, funcs, slots, pbytes, q, i);
        case lowering.SO_ELOAD:
            elem_addr(w, dst, sir, funcs, slots, q, a, bb);
            field_move(w, dst, sir, funcs, q, i, true, 0);
        case lowering.SO_ESTORE:
            elem_addr(w, dst, sir, funcs, slots, q, a, bb);
            field_move(w, dst, sir, funcs, q, i, false, sir[i].c as I64);
        case lowering.SO_LOCAL:
            // An array starts at zero where it is declared, each time (SPEC-04 LS-67).
            I64 zb = 0;
            if (slots[a].kind == lowering.SK_ARRAY) { zb = lowering.array_extent(slots[a].ty) * elem_size(slots, a); }
            if (slots[a].kind == lowering.SK_STRUCT) { zb = ty_size(slots, slots[a].ty); }
            if (zb > 0) {
                ins(w, dst, q);
                text(w, dst, "call $cint_qbe_zero(l %s");
                num(w, dst, a);
                text(w, dst, ", l ");
                num(w, dst, zb);
                line(w, dst, ")");
            }
        case lowering.SO_FLOAD, lowering.SO_FSTORE, lowering.SO_EFLOAD, lowering.SO_EFSTORE, lowering.SO_FELOAD,
                lowering.SO_FESTORE, lowering.SO_SCOPY, lowering.SO_FSCOPY, lowering.SO_FSLOAD, lowering.SO_FACOPY,
                lowering.SO_FREF, lowering.SO_AFREF, lowering.SO_EREF:
            w_record(w, dst, sir, funcs, slots, pbytes, q, i);
        case lowering.SO_SHAPE, lowering.SO_COPY_SHAPE:
            w_shape(w, dst, sir, slots, pbytes, q, i);
        case lowering.SO_ACOPY:
            w_acopy(w, dst, sir, slots, q, i);
        case lowering.SO_VBEGIN, lowering.SO_VPICK, lowering.SO_VSLICE, lowering.SO_VEND, lowering.SO_VTRANS,
                lowering.SO_VREV, lowering.SO_EOFF, lowering.SO_VCOPY, lowering.SO_REDUCE, lowering.SO_VEXT,
                lowering.SO_CALIAS, lowering.SO_AINIT, lowering.SO_VFILL, lowering.SO_VRESHAPE:
            w_view(w, dst, sir, funcs, slots, pbytes, q, i);
        case lowering.SO_FRAME:
            w_frame(w, dst, sir, funcs, pbytes, q, i);
        case lowering.SO_CASE_END:
            if (sir[i].c == 0) {
                jump(w, dst, q, bb, 'e');
            }
        case lowering.SO_BREAK:
            jump(w, dst, q, a, 'e');
        case lowering.SO_CONTINUE:
            jump(w, dst, q, a, 'n');
        default:
            // SO_LOCAL of a scalar (its slot is zero from the function's start, as in C),
            // SO_DISCARD, SO_ARG (read by its call) and the structure nodes write nothing.
            return;
    }
}

// One node in order (back_c.c_step): the labels and jumps of structured control flow, else
// the node itself when it is live.
void w_step[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, in U8[_] pbytes,
        inout QState[_] q, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    Bool live = (sir[i].op & lowering.FL_LIVE) != 0;
    I64 a = sir[i].a as I64;
    if (k == lowering.SO_LOOP && (sir[i].op & lowering.FL_HEAD) != 0) {
        lab(w, dst, q, i, 'h');
    } else if (k == lowering.SO_ARM_END) {
        if (live) {
            jump(w, dst, q, sir[i].b as I64, 'e');
        }
        if ((sir[a].op & lowering.FL_FALSE) != 0) {
            lab(w, dst, q, a, 'f');
        }
    } else if (k == lowering.SO_NEXT) {
        if ((sir[a].op & lowering.FL_NEXT) != 0) {
            lab(w, dst, q, a, 'n');
        }
    } else if (k == lowering.SO_CASE || k == lowering.SO_DEFAULT) {
        if ((sir[a].op & lowering.FL_LIVE) != 0 && (k == lowering.SO_CASE || verify.dispatch_falls(sir, a))) {
            lab(w, dst, q, i, 'c');
        }
    } else if (k == lowering.SO_END) {
        if (live && (sir[a].op & lowering.OP_MASK) == lowering.SO_LOOP) {
            jump(w, dst, q, a, 'h');
        }
        if ((sir[a].op & lowering.FL_END) != 0) {
            lab(w, dst, q, a, 'e');
        }
    } else if (live) {
        w_node(w, dst, src, toks, sir, funcs, slots, pbytes, q, i);
    }
}

// Function fn: `function w <symbol>(l %ctx, l %s<param>..., l %result)`, 1 on return, 0 at
// @fault; every local slot starts at 0 (back_c.c_func's initializers).
// ---------------------------------------------------------------- module state

// Whether SIR node i is a module variable's initial value (back_c.global_init).
Bool global_init(in lowering.Sir[_] sir, I64 i) {
    return (sir[i].op & lowering.OP_MASK) == lowering.SO_CONST && sir[i].dst < 0 && sir[i].a >= 0;
}

// The bytes of a scalar of type ty: Bool 1.
I64 size_of(I32 ty) {
    if (ty == lowering.T_BOOL) { return 1; }
    if (ty == lowering.T_HANDLE) { return 32; }
    return fold.ty_width(ty as I64) / 8;
}

// A value held in memory, not in one `l` temporary: a handle (rt/cint_mem.h cint_handle, 32
// bytes), or the limbs of a wide integer or a 128-bit fixed-point value (rt/cint_wide.h,
// size_of bytes). Its temporary `%t<d>`, local or parameter `%s<k>` is the address of its own
// bytes, zeroed at the function's start, so a load, a store, an argument and a result copy bytes.
Bool boxed(I32 ty) {
    return ty == lowering.T_HANDLE || lowering.is_limbs(ty);
}

// `, <n>` and a newline: the bytes of a boxed value of type ty, for `blit`.
void blit_n[b](inout emit.Writer[_] w, inout U8[b] dst, I32 ty) {
    text(w, dst, ", ");
    num(w, dst, size_of(ty));
    emit.w_nl(w, dst);
}

// Four `storel 0` from address %<v>: a handle's zero.
void zero32[b, n](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] v) {
    for j in 0..4 {
        text(w, dst, "    %xz =l add %");
        text(w, dst, v);
        text(w, dst, ", ");
        num(w, dst, 8 * j);
        emit.w_nl(w, dst);
        line(w, dst, "    storel 0, %xz");
    }
}

// `l <limb>, ...` of wide SO_CONST node ci of type ty (back_c.const_limbs).
void limbs_data[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, I64 ci, I32 ty, in U8[_] lits, in limits.Decl[_] decls) {
    I64[16] limb;
    back_c.const_limbs(src, toks, sir, ci, ty, limb, lits, decls);
    for k in 0..size_of(ty) / 8 {
        if (k > 0) { text(w, dst, ", "); }
        text(w, dst, "l ");
        num(w, dst, limb[k]);
    }
}

// `$cg<P>_wk<i>`: the limbs of each wide constant node i of a function, which SO_CONST copies.
void w_wide_consts[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in U8[_] pbytes, in QState[_] q, in U8[_] lits,
        in limits.Decl[_] decls) {
    for i in 0..q[0].nsir {
        if ((sir[i].op & lowering.OP_MASK) == lowering.SO_CONST && sir[i].dst >= 0 &&
                (sir[i].op & lowering.FL_LIVE) != 0 && lowering.is_limbs(sir[i].ty)) {
            text(w, dst, "data ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_wk");
            num(w, dst, i);
            text(w, dst, " = align 8 {{ ");
            limbs_data(w, dst, src, toks, sir, i, sir[i].ty, lits, decls);
            line(w, dst, " }}");
        }
    }
}

// The state block's layout, as back_c's C struct `cg<P>_state` has it: the module variables in
// declaration order, each at its natural alignment; a module-level array (box 13 MLA) at its
// element's, with at least one element. Returns slot k's offset, or the block's size, a
// multiple of its alignment, when k is -1.
I64 state_layout(in lowering.Sir[_] sir, in lowering.SirSlot[_] slots, I64 nsir, I64 k) {
    I64 off = 0;
    I64 al = 1;
    for i in 0..nsir {
        if (global_init(sir, i)) {
            I64 g = sir[i].a as I64;
            I64 sz = size_of(lowering.array_elem(slots[g].ty));
            I64 ea = sz;
            if (boxed(lowering.array_elem(slots[g].ty))) { ea = 8; }   // cint_handle's and limbs' alignment
            if (lowering.module_struct(slots, g)) {
                sz = ty_size(slots, slots[g].ty);
                ea = ty_align(slots, slots[g].ty);
            }
            if (lowering.module_array(slots, g)) {
                I64 ext = lowering.array_extent(slots[g].ty);
                if (ext < 1) { ext = 1; }
                sz = sz * ext;
            }
            off = (off + ea - 1) / ea * ea;
            if (g == k) { return off; }
            off += sz;
            if (ea > al) { al = ea; }
        }
    }
    return (off + al - 1) / al * al;
}

// Whether field value v names a module-level array slot, of the nslot slots.
Bool names_array(in lowering.SirSlot[_] slots, I64 nslot, I32 v) {
    return v >= 0 && (v as I64) < nslot && lowering.module_array(slots, v as I64);
}

// Whether function fn reads or writes module state (back_c.uses_state).
Bool uses_state(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, I64 nslot,
        I64 fn) {
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        I32 k = sir[i].op & lowering.OP_MASK;
        if ((sir[i].op & lowering.FL_LIVE) != 0 && (k == lowering.SO_LOAD || k == lowering.SO_STORE) &&
                slots[sir[i].a as I64].kind == lowering.SK_GLOBAL) {
            return true;
        }
        if ((sir[i].op & lowering.FL_LIVE) != 0 && back_c.array_node(k) &&
                (names_array(slots, nslot, sir[i].a) || names_array(slots, nslot, sir[i].b) ||
                names_array(slots, nslot, sir[i].c) || (k == lowering.SO_VSLICE && names_array(slots, nslot, sir[i].e)))) {
            return true;
        }
        if ((sir[i].op & lowering.FL_LIVE) != 0 && back_c.names_struct(sir, slots, nslot, i, k)) {
            return true;
        }
    }
    return false;
}

// `%ga =l add %gst, <offset>`: the address of module variable k in the block cint_rt_state
// gave the function (`%gst`).
// An imported variable's address is `%gv<j>`, of its import row j (import_state).
void state_addr[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirSlot[_] slots,
        inout QState[_] q, I64 k) {
    ins(w, dst, q);
    if (slots[k].kind == lowering.SK_IGLOBAL) {
        text(w, dst, "%ga =l copy %gv");
        num(w, dst, slots[k].live as I64);
        emit.w_nl(w, dst);
        return;
    }
    text(w, dst, "%ga =l add %gst, ");
    num(w, dst, state_layout(sir, slots, q[0].nsir, k));
    emit.w_nl(w, dst);
}

// Whether function fn reads or writes the imported variable of import row j (back_c).
Bool uses_import_var(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, I64 fn,
        I64 j) {
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        I32 k = sir[i].op & lowering.OP_MASK;
        if ((sir[i].op & lowering.FL_LIVE) != 0 && (k == lowering.SO_LOAD || k == lowering.SO_STORE) &&
                slots[sir[i].a as I64].kind == lowering.SK_IGLOBAL && (slots[sir[i].a as I64].live as I64) == j) {
            return true;
        }
    }
    return false;
}

// `%gv<j>`, the address of each imported variable function fn uses (back_c.import_state): the
// block of its module P (cint_rt_state) plus the variable's offset in P's variable table
// (cint_state.vars at 24, cint_state_var.offset at 16 of its 40 bytes).
void import_state[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, I64 nfunc, I64 fn) {
    for j in 0..nfunc {
        if ((funcs[j].flags & lowering.FN_IVAR) != 0 && uses_import_var(sir, funcs, slots, fn, j)) {
            I64 at = funcs[j].lslot0 as I64;
            I64 nb = back_c.stem_bytes(pbytes, at, funcs[j].lslot_end as I64);
            text(w, dst, "    %gb");
            num(w, dst, j);
            text(w, dst, " =l call $cint_qbe_state(l %ctx, l $cg");
            cg_part(w, dst, pbytes, at, nb);
            line(w, dst, "_state_desc)");
            text(w, dst, "    jnz %gb");
            num(w, dst, j);
            text(w, dst, ", @iv");
            num(w, dst, j);
            line(w, dst, ", @fault");
            text(w, dst, "@iv");
            num(w, dst, j);
            emit.w_nl(w, dst);
            text(w, dst, "    %gt =l add $cg");
            cg_part(w, dst, pbytes, at, nb);
            line(w, dst, "_state_desc, 24");
            line(w, dst, "    %gt =l loadl %gt");
            text(w, dst, "    %gt =l add %gt, ");
            num(w, dst, 40 * (funcs[j].ntemp as I64) + 16);
            emit.w_nl(w, dst);
            line(w, dst, "    %gt =l loaduw %gt");
            text(w, dst, "    %gv");
            num(w, dst, j);
            text(w, dst, " =l add %gb");
            num(w, dst, j);
            line(w, dst, ", %gt");
        }
    }
}

// The QBE load of a value of type ty, extended to `l` from its type.
void load_op[b](inout emit.Writer[_] w, inout U8[b] dst, I32 ty) {
    I64 bits = width(ty);
    Bool s = signed(ty);
    if (bits == 1 || (bits == 8 && !s)) { text(w, dst, "loadub"); }
    else if (bits == 8) { text(w, dst, "loadsb"); }
    else if (bits == 16 && s) { text(w, dst, "loadsh"); }
    else if (bits == 16) { text(w, dst, "loaduh"); }
    else if (bits == 32 && s) { text(w, dst, "loadsw"); }
    else if (bits == 32) { text(w, dst, "loaduw"); }
    else { text(w, dst, "loadl"); }
}

// The QBE store of a value of type ty at its width.
void store_op[b](inout emit.Writer[_] w, inout U8[b] dst, I32 ty) {
    I64 bits = width(ty);
    if (bits <= 8) { text(w, dst, "storeb"); }
    else if (bits == 16) { text(w, dst, "storeh"); }
    else if (bits == 32) { text(w, dst, "storew"); }
    else { text(w, dst, "storel"); }
}

// ---------------------------------------------------------------- records

// A record (struct) has the C layout of back_c's struct, which is check.record_layout's
// (SPEC-04 LS-73): fields in declaration order, each at its natural alignment, the size a
// multiple of the largest. Q2 lays out Bool, integer fields of 64 bits or fewer, records and
// fixed arrays of them; layout_ok refuses the rest (wide, fixed point, handles, zero sizes).

// The element type of a field or slot type ty that is an array (itself otherwise).
I32 elem_of(I32 ty) {
    if (ty < lowering.T_STRUCT) {
        return ty & lowering.ELEM_MASK;
    }
    if (lowering.field_array(ty) || ty >= lowering.T_STRUCT + lowering.SARRAY_STEP) {
        return lowering.array_elem(ty);
    }
    return ty;
}

// The element count of field type ty: its extent for an array field, else 1.
I64 count_of(I32 ty) {
    if (lowering.field_array(ty)) {
        return lowering.array_extent(ty);
    }
    return 1;
}

// The size (want 0) or alignment (want 1) of record type sty, or -1 when it has no layout
// here. Records nest without recursion (SPEC-09 5.3): a stack of the records being laid out,
// at most 64 deep.
I64 rec_layout(in lowering.SirSlot[_] slots, I32 sty, I64 want) {
    I64[258] sd;
    I64[258] fj;
    I64[258] off;
    I64[258] al;
    I64 top = 0;
    sd[0] = (sty - lowering.T_STRUCT) as I64;
    fj[0] = 0;
    off[0] = 0;
    al[0] = 1;
    I64 rsize = 0;
    I64 ralign = 1;
    Bool child = false;
    while (top >= 0) {
        I64 s = sd[top];
        if (s < 0 || slots[s].kind != lowering.SK_SDECL || slots[s].ty < 0) {
            return -1;
        }
        if (child) {
            // The record field fj[top] just laid out: rsize bytes at alignment ralign, n times.
            I64 n = count_of(slots[s + 1 + fj[top]].ty);
            off[top] = (off[top] + ralign - 1) / ralign * ralign + rsize * n;
            if (ralign > al[top]) { al[top] = ralign; }
            fj[top] += 1;
            child = false;
        }
        if (fj[top] == slots[s].ty as I64) {
            rsize = (off[top] + al[top] - 1) / al[top] * al[top];
            ralign = al[top];
            top -= 1;
            child = true;
            continue;
        }
        I32 ft = slots[s + 1 + fj[top]].ty;
        I32 e = elem_of(ft);
        if (e < lowering.T_STRUCT) {
            // A handle is 32 bytes at alignment 8 (check.record_layout, cint_handle).
            I64 z = size_of(e);
            I64 za = z;
            if (boxed(e)) { za = 8; }
            if (!scalar(e) && !boxed(e)) { return -1; }
            off[top] = (off[top] + za - 1) / za * za + z * count_of(ft);
            if (za > al[top]) { al[top] = za; }
            fj[top] += 1;
            continue;
        }
        if (top == 257) { return -1; }
        top += 1;
        sd[top] = (e - lowering.T_STRUCT) as I64;
        fj[top] = 0;
        off[top] = 0;
        al[top] = 1;
    }
    if (want == 0) { return rsize; }
    return ralign;
}

// Whether lowering type ty (a field's, an element's or a slot's) has a layout here.
Bool layout_ok(in lowering.SirSlot[_] slots, I32 ty) {
    I32 e = elem_of(ty);
    if (e < lowering.T_STRUCT) {
        return scalar(e) || lowering.is_limbs(e);
    }
    return rec_layout(slots, e, 0) >= 0;
}

I64 ty_align(in lowering.SirSlot[_] slots, I32 ty) {
    I32 e = elem_of(ty);
    if (boxed(e)) { return 8; }
    if (e < lowering.T_STRUCT) {
        return size_of(e);
    }
    return rec_layout(slots, e, 1);
}

// The bytes of a value of field type ty (an array field's whole storage), or of one record.
I64 ty_size(in lowering.SirSlot[_] slots, I32 ty) {
    I32 e = elem_of(ty);
    if (e < lowering.T_STRUCT) {
        return size_of(e) * count_of(ty);
    }
    return rec_layout(slots, e, 0) * count_of(ty);
}

// The frame bytes of n bytes of storage: a multiple of 8, at least 8 (a record of logical size
// zero still has an address).
I64 frame_bytes(I64 n) {
    if (n < 8) { return 8; }
    return (n + 7) / 8 * 8;
}

// The offset of field j of record type ty.
I64 field_off(in lowering.SirSlot[_] slots, I32 ty, I64 j) {
    I64 sd = (ty - lowering.T_STRUCT) as I64;
    I64 off = 0;
    for g in 0..j + 1 {
        I32 ft = slots[sd + 1 + g].ty;
        I64 fa = ty_align(slots, ft);
        off = (off + fa - 1) / fa * fa;
        if (g == j) { return off; }
        off += ty_size(slots, ft);
    }
    return off;
}

// A record slot: a local (SK_STRUCT), a parameter by value (SK_SPARAM, the callee's copy) or
// by address (SK_SREF), or a place (SK_SPLACE, an address SO_FREF or SO_EREF gave). Each is
// `%s<k>`, the record's address.
Bool record_slot(in lowering.SirSlot[_] slots, I64 k) {
    return k >= 0 && lowering.is_struct_slot(slots, k) && layout_ok(slots, slots[k].ty);
}

// `%ea =l add %s<k>, <off>`.
void at_off[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 k, I64 off) {
    ins(w, dst, q);
    text(w, dst, "%ea =l add %s");
    num(w, dst, k);
    text(w, dst, ", ");
    num(w, dst, off);
    emit.w_nl(w, dst);
}

// `blit <from>, <to>, <n>` with both addresses in %e0 and %e1; nothing for n 0.
void blit_e[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 n) {
    if (n > 0) {
        ins(w, dst, q);
        text(w, dst, "blit %e0, %e1, ");
        num(w, dst, n);
        emit.w_nl(w, dst);
    }
}

// `%e<j> =l add %s<k>, <off>`.
void addr_e[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 j, I64 k, I64 off) {
    ins(w, dst, q);
    vt(w, dst, 'e', j);
    text(w, dst, " =l add %s");
    num(w, dst, k);
    text(w, dst, ", ");
    num(w, dst, off);
    emit.w_nl(w, dst);
}

// Node i's value to or from the field at %ea: a scalar by its width, a handle by `blit` (its
// temporary and its operand are the addresses of 32 bytes).
void field_move[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        inout QState[_] q, I64 i, Bool load, I64 v) {
    I32 ty = sir[i].ty;
    ins(w, dst, q);
    if (boxed(ty) && load) {
        text(w, dst, "blit %ea, ");
        tmp(w, dst, sir, i);
        blit_n(w, dst, ty);
    } else if (boxed(ty)) {
        text(w, dst, "blit ");
        opnd(w, dst, sir, funcs, q, v);
        text(w, dst, ", %ea");
        blit_n(w, dst, ty);
    } else if (load) {
        tmp(w, dst, sir, i);
        text(w, dst, " =l ");
        load_op(w, dst, ty);
        line(w, dst, " %ea");
    } else {
        store_op(w, dst, ty);
        emit.w_byte(w, dst, ' ');
        opnd(w, dst, sir, funcs, q, v);
        line(w, dst, ", %ea");
    }
}

// A record node (back_c's SO_FLOAD to SO_FACOPY).
void w_record[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    I64 c = sir[i].c as I64;
    switch (k) {
        case lowering.SO_FLOAD, lowering.SO_FSTORE:
            at_off(w, dst, q, a, field_off(slots, slots[a].ty, c));
            field_move(w, dst, sir, funcs, q, i, k == lowering.SO_FLOAD, bb);
        case lowering.SO_EFLOAD, lowering.SO_EFSTORE:
            // Field c of element b of an array or a view of records.
            elem_addr(w, dst, sir, funcs, slots, q, a, bb);
            ins(w, dst, q);
            text(w, dst, "%ea =l add %ea, ");
            num(w, dst, field_off(slots, elem_of(slots[a].ty), c));
            emit.w_nl(w, dst);
            field_move(w, dst, sir, funcs, q, i, k == lowering.SO_EFLOAD, sir[i].f as I64);
        case lowering.SO_FELOAD, lowering.SO_FESTORE:
            // Element b of the array field c of record slot a.
            I32 ft = lowering.field_type(slots, slots[a].ty, c);
            ins(w, dst, q);
            text(w, dst, "%ea =l mul ");
            opnd(w, dst, sir, funcs, q, bb);
            text(w, dst, ", ");
            num(w, dst, ty_size(slots, elem_of(ft)));
            emit.w_nl(w, dst);
            text(w, dst, "    %ea =l add %ea, ");
            num(w, dst, field_off(slots, slots[a].ty, c));
            emit.w_nl(w, dst);
            text(w, dst, "    %ea =l add %s");
            num(w, dst, a);
            line(w, dst, ", %ea");
            field_move(w, dst, sir, funcs, q, i, k == lowering.SO_FELOAD, sir[i].f as I64);
        case lowering.SO_SCOPY:
            addr_e(w, dst, q, 0, bb, 0);
            addr_e(w, dst, q, 1, a, 0);
            blit_e(w, dst, q, ty_size(slots, slots[a].ty));
        case lowering.SO_FSCOPY:
            // Field c of record slot a := record slot b.
            addr_e(w, dst, q, 0, bb, 0);
            addr_e(w, dst, q, 1, a, field_off(slots, slots[a].ty, c));
            blit_e(w, dst, q, ty_size(slots, lowering.field_type(slots, slots[a].ty, c)));
        case lowering.SO_FSLOAD:
            // Record slot a := field c of slot b.
            addr_e(w, dst, q, 0, bb, field_off(slots, slots[bb].ty, c));
            addr_e(w, dst, q, 1, a, 0);
            blit_e(w, dst, q, ty_size(slots, slots[a].ty));
        case lowering.SO_FACOPY:
            // Fixed array slot b into the array field c of fresh record slot a.
            addr_e(w, dst, q, 0, bb, 0);
            addr_e(w, dst, q, 1, a, field_off(slots, slots[a].ty, c));
            blit_e(w, dst, q, ty_size(slots, lowering.field_type(slots, slots[a].ty, c)));
        case lowering.SO_FREF, lowering.SO_AFREF:
            // Place a := the address of field c of slot b.
            ins(w, dst, q);
            vt(w, dst, 's', a);
            text(w, dst, " =l add %s");
            num(w, dst, bb);
            text(w, dst, ", ");
            num(w, dst, field_off(slots, slots[bb].ty, c));
            emit.w_nl(w, dst);
        case lowering.SO_EREF:
            // Place a := checked element c of slot b, or (e > 0) of the array field e - 1 of
            // record slot b.
            if (sir[i].e > 0) {
                I64 fj = (sir[i].e - 1) as I64;
                ins(w, dst, q);
                text(w, dst, "%ea =l mul ");
                opnd(w, dst, sir, funcs, q, c);
                text(w, dst, ", ");
                num(w, dst, ty_size(slots, elem_of(lowering.field_type(slots, slots[bb].ty, fj))));
                emit.w_nl(w, dst);
                text(w, dst, "    %ea =l add %ea, ");
                num(w, dst, field_off(slots, slots[bb].ty, fj));
                emit.w_nl(w, dst);
                ins(w, dst, q);
                vt(w, dst, 's', a);
                text(w, dst, " =l add %s");
                num(w, dst, bb);
                line(w, dst, ", %ea");
            } else {
                elem_addr(w, dst, sir, funcs, slots, q, bb, c);
                ins(w, dst, q);
                vt(w, dst, 's', a);
                line(w, dst, " =l copy %ea");
            }
        default:
            return;
    }
}

// The record catalog (back_c.c_catalog), which the root module carries for the program:
// every record's cint_record_layout, in module order then declaration order (catalog_id),
// and its cint_record_field rows. The declaration table's layout is the C layout for Bool,
// integer and record fields and their arrays; a catalog with another field type is refused.
Bool catalog_ok(in limits.Decl[_] d) {
    for r in 1..d[0].a {
        if (d[r].kind != limits.DK_STRUCT) { continue; }
        I64 f = decl.next_member(d, r);
        for j in 0..d[r].a {
            I64 tag = decl.row_tag(d, f);
            if (!(tag == 1 || tag == 0x71 || tag == 0x72 || tag == 0x74 || (tag >= 0x11 && tag <= 0x18) || (tag >= 0x21 && tag <= 0x27) ||
                    scalar(tag as I32) || lowering.is_q(tag as I32))) {
                return false;
            }
            f = decl.next_member(d, f);
        }
    }
    return true;
}

// A cint_type (rt/cint_rt.h) as data items: `h code, b storage, b 0, h frac_bits, h 0, w
// record_id, w 0`. Fixed point is code 0x31 with its storage tag and f (back_c.catalog_type), a
// record 0x71 with its layout's index rid; another type is its runtime tag.
void ctype_data[b](inout emit.Writer[_] w, inout U8[b] dst, I32 ty, I64 rid) {
    text(w, dst, "h ");
    if (lowering.is_q(ty)) {
        num(w, dst, 0x31);
        text(w, dst, ", b ");
        num(w, dst, back_c.st_of(ty) as I64);
        text(w, dst, ", b 0, h ");
        num(w, dst, fold.q_frac(ty as I64));
        text(w, dst, ", h 0, w 0, w 0");
        return;
    }
    // An error set's field (decl.ERRSET_TAG) is CINT_TAG_BOOL, as back_c.tag_name's default
    // writes it (compiler/OPEN.md cpu-qbe item 19).
    if (ty == 0x71) { num(w, dst, 0x71); } else if (ty == 0x72) { num(w, dst, 1); } else { num(w, dst, rt_tag(ty)); }
    text(w, dst, ", b 0, b 0, h 0, h 0, w ");
    num(w, dst, rid);
    text(w, dst, ", w 0");
}

void w_catalog[b](inout emit.Writer[_] w, inout U8[b] dst, in limits.Decl[_] d, in back_c.PMod[_] pm,
        in U8[_] pbytes, in QState[_] q) {
    I64 nmod = pm[0].path_at;
    for r in 1..d[0].a {
        if (d[r].kind != limits.DK_STRUCT) { continue; }
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_rf");
        num(w, dst, r);
        text(w, dst, " = align 8 {{ ");
        if (d[r].a == 0) {
            text(w, dst, "z 8");
        }
        I64 f = decl.next_member(d, r);
        for j in 0..d[r].a {
            I64 tag = decl.row_tag(d, f);
            if (j > 0) { text(w, dst, ", "); }
            text(w, dst, "w ");
            num(w, dst, d[f].a);
            text(w, dst, ", w ");
            num(w, dst, decl.row_count(d, f));
            text(w, dst, ", ");
            I64 rid = 0;
            if (tag == 0x71) { rid = back_c.catalog_id(pm, d, d[f].ref as I64); }
            ctype_data(w, dst, tag as I32, rid);
            f = decl.next_member(d, f);
        }
        line(w, dst, " }}");
    }
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_records = align 8 {{ ");
    I64 n = 0;
    for order in 1..=nmod {
        for r in 1..d[0].a {
            if (d[r].kind != limits.DK_STRUCT || pm[(d[r].module as I64) + 1].flags / 4 != order) {
                continue;
            }
            if (n > 0) { text(w, dst, ", "); }
            text(w, dst, "w ");
            num(w, dst, d[r].b);
            text(w, dst, ", w ");
            I64 bt = d[r].b;
            if (bt == 0) { num(w, dst, d[r].align as I64); }
            else if (bt % 8 == 0) { num(w, dst, 8); }
            else if (bt % 4 == 0) { num(w, dst, 4); }
            else if (bt % 2 == 0) { num(w, dst, 2); }
            else { num(w, dst, 1); }
            text(w, dst, ", w ");
            num(w, dst, d[r].a);
            text(w, dst, ", w 0, l ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_rf");
            num(w, dst, r);
            n += 1;
        }
    }
    if (n == 0) { text(w, dst, "z 8"); }
    line(w, dst, " }}");
}

// ---------------------------------------------------------------- arrays and views

// A local array (SK_ARRAY) is `%s<k>`, the address of its elements in the frame (`alloc8`). A
// view parameter of rank 1 (SK_VIEW) is four values, as the C function takes them
// (back_c.c_view_arg): `%s<k>` its elements, `%o<k>` its origin, `%n<k>` its extent and `%d<k>`
// its stride, origin and stride in elements (SPEC-03 M-24a). A view slot (SK_NVIEW) is `%s<k>`,
// the address of its cint_vdesc (88 bytes: base, origin, rank, four extents, four strides); a
// view parameter of rank 2 to 4 arrives as the address of the caller's and is copied. Elements
// have their C layout, so a runtime call that takes a view reads what emitted C gives it.

const I64 VD_ORIGIN = 8;
const I64 VD_RANK = 16;
const I64 VD_SHAPE = 24;
const I64 VD_STRIDE = 56;

Bool nview(in lowering.SirSlot[_] slots, I64 k) {
    return slots[k].kind == lowering.SK_NVIEW;
}

// A view slot of scalar elements (SK_NVIEW).
Bool view_slot(in lowering.SirSlot[_] slots, I64 k) {
    return nview(slots, k) && layout_ok(slots, elem_of(slots[k].ty));
}

Bool any_view(in lowering.SirSlot[_] slots, I64 k) {
    return k >= 0 && (array_slot(slots, k) || view_slot(slots, k));
}

I64 elem_size(in lowering.SirSlot[_] slots, I64 k) {
    if (nview(slots, k) && slots[k].ty < lowering.T_STRUCT) {
        return size_of(lowering.array_elem(slots[k].ty));
    }
    return ty_size(slots, elem_of(slots[k].ty));
}

// The bytes of local array k's storage: at least 8, a multiple of 8.
I64 array_bytes(in lowering.SirSlot[_] slots, I64 k) {
    I64 n = lowering.array_extent(slots[k].ty) * elem_size(slots, k);
    if (n < 8) { return 8; }
    return (n + 7) / 8 * 8;
}

// `%<c><j>`, a temporary of the view writers.
void vt[b](inout emit.Writer[_] w, inout U8[b] dst, U8 c, I64 j) {
    emit.w_byte(w, dst, '%');
    emit.w_byte(w, dst, c);
    num(w, dst, j);
}

// A descriptor: `%s<p>` for a view slot p, `%da` (p -1) and `%db` (p -2) the function's two
// scratch descriptors, built for a runtime call from an array or a view parameter.
void dptr[b](inout emit.Writer[_] w, inout U8[b] dst, I64 p) {
    if (p == -1) { text(w, dst, "%da"); }
    else if (p == -2) { text(w, dst, "%db"); }
    else { vt(w, dst, 's', p); }
}

void vaddr[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 p, I64 off) {
    ins(w, dst, q);
    text(w, dst, "%vf =l add ");
    dptr(w, dst, p);
    text(w, dst, ", ");
    num(w, dst, off);
    emit.w_nl(w, dst);
}

// `%<c><j> =l loadl` the field at off of descriptor p.
void vget[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 p, I64 off, U8 c, I64 j) {
    vaddr(w, dst, q, p, off);
    text(w, dst, "    ");
    vt(w, dst, c, j);
    line(w, dst, " =l loadl %vf");
}

// `storel %vv` into the field at off of descriptor p.
void vput[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 p, I64 off) {
    vaddr(w, dst, q, p, off);
    line(w, dst, "    storel %vv, %vf");
}

void vv_num[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 v) {
    ins(w, dst, q);
    text(w, dst, "%vv =l copy ");
    num(w, dst, v);
    emit.w_nl(w, dst);
}

void vv_tmp[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, U8 c, I64 j) {
    ins(w, dst, q);
    text(w, dst, "%vv =l copy ");
    vt(w, dst, c, j);
    emit.w_nl(w, dst);
}

// The origin, rank, extents and strides of descriptor p, as constants; its base is written
// before it.
void desc_rest[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, I64 p, I64 rank, in I64[4] ext,
        in I64[4] str) {
    vv_num(w, dst, q, 0);
    vput(w, dst, q, p, VD_ORIGIN);
    vv_num(w, dst, q, rank);
    vput(w, dst, q, p, VD_RANK);
    for g in 0..4 {
        vv_num(w, dst, q, ext[g]);
        vput(w, dst, q, p, VD_SHAPE + 8 * g);
        vv_num(w, dst, q, str[g]);
        vput(w, dst, q, p, VD_STRIDE + 8 * g);
    }
}

// `%<c><j>` to `%<c><j + 3>`: the elements, origin, extent of dimension d and stride of
// dimension d of array or view slot k.
void view_parts[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, in lowering.SirSlot[_] slots,
        I64 k, I64 d, U8 c, I64 j) {
    if (nview(slots, k)) {
        vget(w, dst, q, k, 0, c, j);
        vget(w, dst, q, k, VD_ORIGIN, c, j + 1);
        vget(w, dst, q, k, VD_SHAPE + 8 * d, c, j + 2);
        vget(w, dst, q, k, VD_STRIDE + 8 * d, c, j + 3);
        return;
    }
    for g in 0..4 {
        ins(w, dst, q);
        vt(w, dst, c, j + g);
        text(w, dst, " =l copy ");
        if (g == 0) {
            vt(w, dst, 's', k);
        } else if (slots[k].kind == lowering.SK_VIEW) {
            if (g == 1) { vt(w, dst, 'o', k); }
            else if (g == 2) { vt(w, dst, 'n', k); }
            else { vt(w, dst, 'd', k); }
        } else if (g == 2) {
            num(w, dst, lowering.array_extent(slots[k].ty));
        } else {
            num(w, dst, g / 3);
        }
        emit.w_nl(w, dst);
    }
}

// `%<c><j>`: the extent of dimension d of array or view slot k (back_c.c_dext).
void ext_get[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, in lowering.SirSlot[_] slots, I64 k,
        I64 d, U8 c, I64 j) {
    if (nview(slots, k)) {
        vget(w, dst, q, k, VD_SHAPE + 8 * d, c, j);
        return;
    }
    ins(w, dst, q);
    vt(w, dst, c, j);
    text(w, dst, " =l copy ");
    if (slots[k].kind == lowering.SK_VIEW) {
        vt(w, dst, 'n', k);
    } else {
        num(w, dst, lowering.array_extent(slots[k].ty));
    }
    emit.w_nl(w, dst);
}

// The descriptor of the view of slot k into descriptor p (back_c.c_desc): a view slot's copy,
// else rank 1 over a local array or a view parameter.
void desc_into[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, in lowering.SirSlot[_] slots,
        I64 p, I64 k) {
    if (nview(slots, k)) {
        ins(w, dst, q);
        text(w, dst, "blit ");
        dptr(w, dst, k);
        text(w, dst, ", ");
        dptr(w, dst, p);
        line(w, dst, ", 88");
        return;
    }
    view_parts(w, dst, q, slots, k, 0, 'e', 0);
    vv_tmp(w, dst, q, 'e', 0);
    vput(w, dst, q, p, 0);
    vv_tmp(w, dst, q, 'e', 1);
    vput(w, dst, q, p, VD_ORIGIN);
    vv_num(w, dst, q, 1);
    vput(w, dst, q, p, VD_RANK);
    for g in 0..4 {
        if (g == 0) { vv_tmp(w, dst, q, 'e', 2); } else { vv_num(w, dst, q, 0); }
        vput(w, dst, q, p, VD_SHAPE + 8 * g);
        if (g == 0) { vv_tmp(w, dst, q, 'e', 3); } else { vv_num(w, dst, q, 0); }
        vput(w, dst, q, p, VD_STRIDE + 8 * g);
    }
}

// The descriptor a runtime call takes for slot k: its own, or scratch p built from it.
I64 desc_of[b](inout emit.Writer[_] w, inout U8[b] dst, inout QState[_] q, in lowering.SirSlot[_] slots, I64 k,
        I64 p) {
    if (nview(slots, k)) {
        return k;
    }
    desc_into(w, dst, q, slots, p, k);
    return p;
}

// `%ea`: the address of element <v> of array or view slot k, an index checked before it, or
// (a view slot) the element offset of SO_EOFF.
void elem_addr[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, inout QState[_] q, I64 k, I64 v) {
    ins(w, dst, q);
    if (slots[k].kind == lowering.SK_VIEW) {
        text(w, dst, "%ea =l mul ");
        opnd(w, dst, sir, funcs, q, v);
        text(w, dst, ", %d");
        num(w, dst, k);
        emit.w_nl(w, dst);
        text(w, dst, "    %ea =l add %ea, %o");
        num(w, dst, k);
        emit.w_nl(w, dst);
        text(w, dst, "    %ea =l mul %ea, ");
    } else {
        text(w, dst, "%ea =l mul ");
        opnd(w, dst, sir, funcs, q, v);
        text(w, dst, ", ");
    }
    num(w, dst, elem_size(slots, k));
    emit.w_nl(w, dst);
    if (nview(slots, k)) {
        vget(w, dst, q, k, 0, 'b', 0);
        line(w, dst, "    %ea =l add %b0, %ea");
        return;
    }
    text(w, dst, "    %ea =l add %s");
    num(w, dst, k);
    line(w, dst, ", %ea");
}

// `$cg<P>_q<c><i>`: node i's operation name (c 'i') or string bytes (c 'd').
void node_data[b](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] pbytes, in QState[_] q, U8 c, I64 i) {
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_q");
    emit.w_byte(w, dst, c);
    num(w, dst, i);
}

// index.checked (back_c's SO_ICHECK): an index outside the extent records E_BOUNDS through
// cint_index_check, or cint_index_check_dim for a view of rank 2 to 4 (ruling R1), with the
// operation's name, and leaves at @fault.
void w_icheck[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I64 a = sir[i].a as I64;
    I64 d = 0;
    if (nview(slots, a)) { d = sir[i].f as I64; }
    Bool dim = nview(slots, a) && lowering.slot_rank(slots, a) > 1;
    if (sir[i].c > 0) {
        // The array field c - 1 of record slot a (back_c.c_icheck_extent).
        ins(w, dst, q);
        text(w, dst, "%e0 =l copy ");
        num(w, dst, lowering.array_extent(lowering.field_type(slots, slots[a].ty, (sir[i].c - 1) as I64)));
        emit.w_nl(w, dst);
    } else {
        ext_get(w, dst, q, slots, a, d, 'e', 0);
    }
    ins(w, dst, q);
    text(w, dst, "%in =l cultl ");
    opnd(w, dst, sir, funcs, q, sir[i].b as I64);
    line(w, dst, ", %e0");
    I64 bad = q[0].nlab;
    q[0].nlab += 2;
    text(w, dst, "    jnz %in, @u");
    num(w, dst, bad + 1);
    text(w, dst, ", @u");
    num(w, dst, bad);
    emit.w_nl(w, dst);
    text(w, dst, "@u");
    num(w, dst, bad);
    emit.w_nl(w, dst);
    if (dim) {
        text(w, dst, "    call $cint_qbe_index_dim(l %ctx, ");
    } else {
        text(w, dst, "    call $cint_qbe_index(l %ctx, ");
    }
    site(w, dst, pbytes, q, sir[i].site as I64);
    text(w, dst, ", l ");
    node_data(w, dst, pbytes, q, 'i', i);
    if (dim) {
        text(w, dst, ", l ");
        num(w, dst, d);
    }
    text(w, dst, ", l ");
    opnd(w, dst, sir, funcs, q, sir[i].b as I64);
    line(w, dst, ", l %e0)");
    line(w, dst, "    jmp @fault");
    text(w, dst, "@u");
    num(w, dst, bad + 1);
    emit.w_nl(w, dst);
}

// The shape checks before a call and a copy: `bind.shape` (SO_SHAPE, per dimension when e > 0)
// and `copy.shape` (SO_COPY_SHAPE).
void w_shape[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirSlot[_] slots,
        in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I64 a = sir[i].a as I64;
    I64 c = sir[i].c as I64;
    I64 dm = 0;
    I64 dc = 0;
    if (k == lowering.SO_SHAPE && sir[i].e > 0) {
        dm = (sir[i].f as I64) % 16;
        dc = (sir[i].e - 1) as I64;
    }
    if (c >= 0) {
        ext_get(w, dst, q, slots, c, dc, 'e', 0);
    } else {
        ins(w, dst, q);
        text(w, dst, "%e0 =l copy ");
        num(w, dst, sir[i].val);
        emit.w_nl(w, dst);
    }
    ext_get(w, dst, q, slots, a, dm, 'e', 1);
    if (k == lowering.SO_COPY_SHAPE) {
        call_ctx(w, dst, q, "cint_qbe_copy_shape");
        text(w, dst, ", ");
        site(w, dst, pbytes, q, sir[i].site as I64);
    } else if (sir[i].e > 0 && sir[i].f >= 16) {
        call_ctx(w, dst, q, "cint_qbe_shape_dim");
        text(w, dst, ", ");
        site(w, dst, pbytes, q, sir[i].site as I64);
        text(w, dst, ", w ");
        num(w, dst, sir[i].b as I64);
        text(w, dst, ", w ");
        num(w, dst, dm);
    } else {
        call_ctx(w, dst, q, "cint_qbe_shape");
        text(w, dst, ", ");
        site(w, dst, pbytes, q, sir[i].site as I64);
        text(w, dst, ", w ");
        num(w, dst, sir[i].b as I64);
    }
    line(w, dst, ", l %e0, l %e1)");
    checked(w, dst, q);
}

// Whole-array assignment (back_c's SO_ACOPY): every element in index order, through each side's
// origin and stride, bounded by both extents.
void w_acopy[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirSlot[_] slots,
        inout QState[_] q, I64 i) {
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    view_parts(w, dst, q, slots, a, 0, 'e', 0);
    view_parts(w, dst, q, slots, bb, 0, 'e', 4);
    ins(w, dst, q);
    text(w, dst, "call $cint_qbe_copy_elems(l %e0, l %e1, l %e3, l %e4, l %e5, l %e7, l %e2, l %e6, l ");
    num(w, dst, elem_size(slots, a));
    line(w, dst, ")");
}

// A view node (back_c.c_view_node): descriptors written field by field, the checked ones
// through the runtime.
void w_view[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 i) {
    I32 k = sir[i].op & lowering.OP_MASK;
    I32 ty = sir[i].ty;
    I64 a = sir[i].a as I64;
    I64 bb = sir[i].b as I64;
    I64 d = sir[i].f as I64;
    I64[4] ext;
    I64[4] str;
    switch (k) {
        case lowering.SO_VBEGIN:
            I64 rk = lowering.slot_rank(slots, a);
            if (sir[i].e == 3) {
                // A byte string (ruling OQ-307 A): rank 1 over its SO_SDATA node's bytes.
                ins(w, dst, q);
                text(w, dst, "%vv =l copy ");
                node_data(w, dst, pbytes, q, 'd', sir[i].val);
                emit.w_nl(w, dst);
                vput(w, dst, q, a, 0);
                for g in 0..4 {
                    ext[g] = 0;
                    str[g] = 0;
                }
                ext[0] = sir[sir[i].val].c as I64;
                str[0] = 1;
                desc_rest(w, dst, q, a, 1, ext, str);
            } else if ((slots[bb].kind == lowering.SK_ARRAY || slots[bb].kind == lowering.SK_APLACE) && rk > 1) {
                // A local array of rank 2 to 4, or (BX22-06) an array field of that rank, over
                // its flat elements, row-major.
                for g in 0..4 {
                    ext[g] = 0;
                    str[g] = 0;
                    if (g < rk) {
                        ext[g] = (sir[i].val >> (12 * g)) & 4095;
                    }
                }
                I64 m = 1;
                I64 g = rk - 1;
                while (g >= 0) {
                    str[g] = m;
                    m = m * ext[g];
                    g -= 1;
                }
                vv_tmp(w, dst, q, 's', bb);
                vput(w, dst, q, a, 0);
                desc_rest(w, dst, q, a, rk, ext, str);
            } else {
                desc_into(w, dst, q, slots, a, bb);
            }
        case lowering.SO_VPICK:
            vget(w, dst, q, a, VD_ORIGIN, 'e', 0);
            vget(w, dst, q, a, VD_STRIDE + 8 * d, 'e', 1);
            ins(w, dst, q);
            text(w, dst, "%e1 =l mul ");
            opnd(w, dst, sir, funcs, q, bb);
            line(w, dst, ", %e1");
            line(w, dst, "    %vv =l add %e0, %e1");
            vput(w, dst, q, a, VD_ORIGIN);
        case lowering.SO_VSLICE:
            I64 dim = d % 8;
            vget(w, dst, q, a, VD_SHAPE + 8 * dim, 'e', 0);
            vget(w, dst, q, a, VD_STRIDE + 8 * dim, 'e', 1);
            ins(w, dst, q);
            text(w, dst, "%e2 =l add %s");
            num(w, dst, a);
            text(w, dst, ", ");
            num(w, dst, VD_ORIGIN);
            emit.w_nl(w, dst);
            text(w, dst, "    %e3 =l add %s");
            num(w, dst, a);
            text(w, dst, ", ");
            num(w, dst, VD_SHAPE + 8 * dim);
            emit.w_nl(w, dst);
            text(w, dst, "    %e4 =l add %s");
            num(w, dst, a);
            text(w, dst, ", ");
            num(w, dst, VD_STRIDE + 8 * dim);
            emit.w_nl(w, dst);
            call_ctx(w, dst, q, "cint_qbe_slice");
            text(w, dst, ", ");
            site(w, dst, pbytes, q, sir[i].site as I64);
            text(w, dst, ", l ");
            node_data(w, dst, pbytes, q, 'i', i);
            text(w, dst, ", l ");
            if (lowering.slot_rank(slots, sir[i].e as I64) > 1) { num(w, dst, dim); } else { num(w, dst, -1); }
            text(w, dst, ", l %e0, l %e1");
            for g in 0..2 {
                I64 v = bb;
                if (g == 1) { v = sir[i].c as I64; }
                text(w, dst, ", l ");
                if (v == lowering.NO_OPERAND) { num(w, dst, 0); } else { opnd(w, dst, sir, funcs, q, v); }
            }
            text(w, dst, ", l ");
            num(w, dst, sir[i].val);
            text(w, dst, ", w ");
            num(w, dst, d / 64);
            line(w, dst, ", l %e2, l %e3, l %e4)");
            checked(w, dst, q);
        case lowering.SO_VEND:
            // The picked dimensions leave the view; the rest move down in order.
            I64 rs = lowering.slot_rank(slots, bb);
            I64 n = 0;
            for g in 0..rs {
                if (((sir[i].val >> g) & 1) == 0) {
                    if (n != g) {
                        vget(w, dst, q, a, VD_SHAPE + 8 * g, 'v', 0);
                        vv_tmp(w, dst, q, 'v', 0);
                        vput(w, dst, q, a, VD_SHAPE + 8 * n);
                        vget(w, dst, q, a, VD_STRIDE + 8 * g, 'v', 0);
                        vv_tmp(w, dst, q, 'v', 0);
                        vput(w, dst, q, a, VD_STRIDE + 8 * n);
                    }
                    n += 1;
                }
            }
            if (n != rs) {
                for g in n..rs {
                    vv_num(w, dst, q, 0);
                    vput(w, dst, q, a, VD_SHAPE + 8 * g);
                    vput(w, dst, q, a, VD_STRIDE + 8 * g);
                }
                vv_num(w, dst, q, n);
                vput(w, dst, q, a, VD_RANK);
            }
        case lowering.SO_VTRANS:
            desc_into(w, dst, q, slots, a, bb);
            for g in 0..2 {
                vget(w, dst, q, bb, VD_SHAPE + 8 * (1 - g), 'v', 0);
                vv_tmp(w, dst, q, 'v', 0);
                vput(w, dst, q, a, VD_SHAPE + 8 * g);
                vget(w, dst, q, bb, VD_STRIDE + 8 * (1 - g), 'v', 0);
                vv_tmp(w, dst, q, 'v', 0);
                vput(w, dst, q, a, VD_STRIDE + 8 * g);
            }
        case lowering.SO_VREV:
            desc_into(w, dst, q, slots, a, bb);
            vget(w, dst, q, a, VD_SHAPE + 8 * d, 'e', 0);
            vget(w, dst, q, a, VD_STRIDE + 8 * d, 'e', 1);
            I64 u = q[0].nlab;
            q[0].nlab += 4;
            ins(w, dst, q);
            line(w, dst, "%in =l csgtl %e0, 0");
            text(w, dst, "    jnz %in, @u");
            num(w, dst, u);
            text(w, dst, ", @u");
            num(w, dst, u + 1);
            emit.w_nl(w, dst);
            text(w, dst, "@u");
            num(w, dst, u);
            emit.w_nl(w, dst);
            line(w, dst, "    %e0 =l sub %e0, 1");
            line(w, dst, "    %e0 =l mul %e1, %e0");
            vget(w, dst, q, a, VD_ORIGIN, 'e', 2);
            line(w, dst, "    %vv =l add %e2, %e0");
            vput(w, dst, q, a, VD_ORIGIN);
            text(w, dst, "@u");
            num(w, dst, u + 1);
            emit.w_nl(w, dst);
            // -stride, but I64 MAX for I64 MIN, the one stride whose negation is negative too.
            line(w, dst, "    %vv =l sub 0, %e1");
            line(w, dst, "    %in =l csltl %vv, 0");
            line(w, dst, "    %e3 =l csltl %e1, 0");
            line(w, dst, "    %in =l and %in, %e3");
            text(w, dst, "    jnz %in, @u");
            num(w, dst, u + 2);
            text(w, dst, ", @u");
            num(w, dst, u + 3);
            emit.w_nl(w, dst);
            text(w, dst, "@u");
            num(w, dst, u + 2);
            emit.w_nl(w, dst);
            line(w, dst, "    %vv =l copy 9223372036854775807");
            text(w, dst, "@u");
            num(w, dst, u + 3);
            emit.w_nl(w, dst);
            vput(w, dst, q, a, VD_STRIDE + 8 * d);
        case lowering.SO_VRESHAPE:
            desc_into(w, dst, q, slots, a, bb);
            for g in 0..4 {
                ext[g] = 0;
                str[g] = 0;
                if (g < d) {
                    ext[g] = (sir[i].val >> (16 * g)) & 65535;
                }
            }
            I64 rm = 1;
            I64 rg = d - 1;
            while (rg >= 0) {
                str[rg] = rm;
                rm = rm * ext[rg];
                rg -= 1;
            }
            vv_num(w, dst, q, d);
            vput(w, dst, q, a, VD_RANK);
            for g in 0..4 {
                vv_num(w, dst, q, ext[g]);
                vput(w, dst, q, a, VD_SHAPE + 8 * g);
                vv_num(w, dst, q, str[g]);
                vput(w, dst, q, a, VD_STRIDE + 8 * g);
            }
        case lowering.SO_EOFF:
            if (sir[i].c == -1) {
                vget(w, dst, q, a, VD_ORIGIN, 'e', 0);
            } else {
                ins(w, dst, q);
                text(w, dst, "%e0 =l copy ");
                opnd(w, dst, sir, funcs, q, sir[i].c as I64);
                emit.w_nl(w, dst);
            }
            vget(w, dst, q, a, VD_STRIDE + 8 * d, 'e', 1);
            ins(w, dst, q);
            text(w, dst, "%e1 =l mul ");
            opnd(w, dst, sir, funcs, q, bb);
            line(w, dst, ", %e1");
            text(w, dst, "    ");
            tmp(w, dst, sir, i);
            line(w, dst, " =l add %e0, %e1");
        case lowering.SO_VEXT:
            if (d >= 0) {
                ext_get(w, dst, q, slots, a, d, 'e', 0);
            } else {
                for g in 0..lowering.slot_rank(slots, a) {
                    ext_get(w, dst, q, slots, a, g, 'e', g + 1);
                    ins(w, dst, q);
                    if (g == 0) {
                        line(w, dst, "%e0 =l copy %e1");
                    } else {
                        text(w, dst, "%e0 =l mul %e0, ");
                        vt(w, dst, 'e', g + 1);
                        emit.w_nl(w, dst);
                    }
                }
            }
            ins(w, dst, q);
            tmp(w, dst, sir, i);
            line(w, dst, " =l copy %e0");
        case lowering.SO_VCOPY:
            I64 pa = desc_of(w, dst, q, slots, a, -1);
            I64 pb = desc_of(w, dst, q, slots, bb, -2);
            call_ctx(w, dst, q, "cint_qbe_copy_view");
            text(w, dst, ", ");
            site(w, dst, pbytes, q, sir[i].site as I64);
            text(w, dst, ", l ");
            dptr(w, dst, pa);
            text(w, dst, ", l ");
            dptr(w, dst, pb);
            text(w, dst, ", l ");
            num(w, dst, size_of(ty));
            line(w, dst, ")");
            checked(w, dst, q);
        case lowering.SO_REDUCE:
            I64 ra = desc_of(w, dst, q, slots, a, -1);
            I64 rb = 0;
            if (bb >= 0) { rb = desc_of(w, dst, q, slots, bb, -2); }
            if ((d & 15) != 10 && lowering.is_q(ty) && (lowering.is_limbs(ty) || lowering.is_limbs(sir[i].val as I32))) {
                // Fixed point with a side of 128 bits (back_c.c_reduce_q_limbs): the operation and
                // the mode of d, an initial value by address (a narrow one's pattern in %qa).
                I64 iv = sir[i].c as I64;
                if (iv != lowering.NO_OPERAND && !lowering.is_limbs(lowering.value_type(sir, funcs, slots, q[0].fn, iv))) {
                    ins(w, dst, q);
                    text(w, dst, "storel ");
                    opnd(w, dst, sir, funcs, q, iv);
                    line(w, dst, ", %qa");
                }
                ins(w, dst, q);
                text(w, dst, "%ok =w call $cint_rt_reduce_q_limbs(l %ctx, ");
                site(w, dst, pbytes, q, sir[i].site as I64);
                arg_w(w, dst, d & 15);
                arg_w(w, dst, rt_tag(sir[i].val as I32));
                arg_w(w, dst, rt_tag(ty));
                arg_w(w, dst, d >> 4);
                text(w, dst, ", l ");
                dptr(w, dst, ra);
                text(w, dst, ", l ");
                if (bb >= 0) { dptr(w, dst, rb); } else { num(w, dst, 0); }
                if (iv == lowering.NO_OPERAND) {
                    text(w, dst, ", l 0");
                } else if (lowering.is_limbs(lowering.value_type(sir, funcs, slots, q[0].fn, iv))) {
                    arg_l(w, dst, sir, funcs, q, iv);
                } else {
                    text(w, dst, ", l %qa");
                }
                if (lowering.is_limbs(ty)) {
                    text(w, dst, ", l ");
                    tmp(w, dst, sir, i);
                    bool_checked(w, dst, q);
                } else {
                    text(w, dst, ", l %out");
                    bool_checked(w, dst, q);
                    ins(w, dst, q);
                    tmp(w, dst, sir, i);
                    text(w, dst, " =l ");
                    load_op(w, dst, ty);
                    line(w, dst, " %out");
                }
                return;
            }
            if ((d & 15) != 10 && (lowering.is_wide(sir[i].val as I32) || lowering.is_wide(ty))) {
                // A wide element or result (back_c.c_reduce_wide): an initial value by its
                // limbs, the result written to its temporary.
                ins(w, dst, q);
                text(w, dst, "%ok =w call $cint_rt_reduce_wide(l %ctx, ");
                site(w, dst, pbytes, q, sir[i].site as I64);
                text(w, dst, ", w ");
                num(w, dst, d);
                text(w, dst, ", w ");
                num(w, dst, sir[i].val);
                text(w, dst, ", w ");
                num(w, dst, ty as I64);
                text(w, dst, ", l ");
                dptr(w, dst, ra);
                text(w, dst, ", l ");
                if (bb >= 0) { dptr(w, dst, rb); } else { num(w, dst, 0); }
                if ((sir[i].c as I64) != lowering.NO_OPERAND) { arg_l(w, dst, sir, funcs, q, sir[i].c as I64); }
                else { text(w, dst, ", l 0"); }
                text(w, dst, ", l ");
                tmp(w, dst, sir, i);
                bool_checked(w, dst, q);
                return;
            }
            if ((d & 15) == 9 && lowering.is_q(ty)) {
                // A fixed-point dot (back_c: cint_dot_q_<s>): the element's and the result's
                // type words and the mode, rounded once (IM-87); the result's bits cut back.
                call_ctx(w, dst, q, "cint_rt_dot_fixed");
                text(w, dst, ", ");
                site(w, dst, pbytes, q, sir[i].site as I64);
                arg_w(w, dst, rt_tag(sir[i].val as I32));
                arg_w(w, dst, rt_tag(ty));
                arg_w(w, dst, d >> 4);
                text(w, dst, ", l ");
                dptr(w, dst, ra);
                text(w, dst, ", l ");
                dptr(w, dst, rb);
                text(w, dst, ", l %out");
                bool_checked(w, dst, q);
                ins(w, dst, q);
                line(w, dst, "%x =l loadl %out");
                norm_x(w, dst, sir, q, i, ty);
                return;
            }
            if ((d & 15) == 10) {
                // equal (ruling OQ-307 A): two views of element type val, a Bool result.
                call_ctx(w, dst, q, "cint_qbe_equal");
                text(w, dst, ", ");
                site(w, dst, pbytes, q, sir[i].site as I64);
                arg_w(w, dst, rt_tag(sir[i].val as I32));
                text(w, dst, ", l ");
                dptr(w, dst, ra);
                text(w, dst, ", l ");
                dptr(w, dst, rb);
            } else {
                call_ctx(w, dst, q, "cint_qbe_reduce");
                text(w, dst, ", ");
                site(w, dst, pbytes, q, sir[i].site as I64);
                text(w, dst, ", w ");
                num(w, dst, d);
                arg_w(w, dst, rt_tag(sir[i].val as I32));
                arg_w(w, dst, rt_tag(ty));
                text(w, dst, ", l ");
                dptr(w, dst, ra);
                text(w, dst, ", l ");
                if (bb >= 0) { dptr(w, dst, rb); } else { num(w, dst, 0); }
                if ((sir[i].c as I64) != lowering.NO_OPERAND) {
                    text(w, dst, ", w 1, l ");
                    opnd(w, dst, sir, funcs, q, sir[i].c as I64);
                } else {
                    text(w, dst, ", w 0, l 0");
                }
            }
            line(w, dst, ", l %out)");
            checked(w, dst, q);
            load_out(w, dst, sir, q, i);
        case lowering.SO_CALIAS:
            I64 ca = desc_of(w, dst, q, slots, a, -1);
            I64 cb = desc_of(w, dst, q, slots, bb, -2);
            call_ctx(w, dst, q, "cint_qbe_call_alias");
            text(w, dst, ", ");
            site(w, dst, pbytes, q, sir[i].site as I64);
            text(w, dst, ", w ");
            num(w, dst, sir[i].c as I64);
            text(w, dst, ", w ");
            num(w, dst, d);
            text(w, dst, ", l ");
            dptr(w, dst, ca);
            text(w, dst, ", l ");
            dptr(w, dst, cb);
            line(w, dst, ")");
            checked(w, dst, q);
        case lowering.SO_VFILL:
            // `fill` (box 15): a copy from the value through a view of it with every stride 0.
            I64 fa = desc_of(w, dst, q, slots, a, -1);
            if (boxed(ty)) {
                // A wide value is already in memory: the view reads its own bytes.
                ins(w, dst, q);
                text(w, dst, "%vv =l copy ");
                opnd(w, dst, sir, funcs, q, bb);
                emit.w_nl(w, dst);
            } else {
                ins(w, dst, q);
                store_op(w, dst, ty);
                emit.w_byte(w, dst, ' ');
                opnd(w, dst, sir, funcs, q, bb);
                line(w, dst, ", %fv");
                line(w, dst, "    %vv =l copy %fv");
            }
            text(w, dst, "    blit ");
            dptr(w, dst, fa);
            line(w, dst, ", %db, 88");
            vput(w, dst, q, -2, 0);
            vv_num(w, dst, q, 0);
            vput(w, dst, q, -2, VD_ORIGIN);
            for g in 0..4 {
                vput(w, dst, q, -2, VD_STRIDE + 8 * g);
            }
            call_ctx(w, dst, q, "cint_qbe_copy_view");
            text(w, dst, ", ");
            site(w, dst, pbytes, q, sir[i].site as I64);
            text(w, dst, ", l ");
            dptr(w, dst, fa);
            text(w, dst, ", l %db, l ");
            num(w, dst, size_of(ty));
            line(w, dst, ")");
            checked(w, dst, q);
        case lowering.SO_AINIT:
            ins(w, dst, q);
            text(w, dst, "%ea =l add %s");
            num(w, dst, a);
            text(w, dst, ", ");
            num(w, dst, sir[i].val * elem_size(slots, a));
            emit.w_nl(w, dst);
            field_move(w, dst, sir, funcs, q, i, false, bb);
        default:
            return;
    }
}

// Whether function fn builds a scratch descriptor (desc_of) or a fill value.
Bool uses_desc(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, I64 fn) {
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        I32 k = sir[i].op & lowering.OP_MASK;
        if (k == lowering.SO_VCOPY || k == lowering.SO_REDUCE || k == lowering.SO_CALIAS || k == lowering.SO_VFILL) {
            return true;
        }
    }
    return false;
}

// The bytes of SO_SDATA node i (back_c.c_string_bytes), as QBE data items.
void sdata_bytes[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, I64 i) {
    I64[5] got;
    I64[2] body;
    I64 tk = sir[i].tok as I64;
    for g in tk..tk + (sir[i].f as I64) {
        resolve.string_body(src, toks, g, body);
        I64 c = body[0];
        while (c < body[1]) {
            if (toks[g].kind == scan.TK_BYTES) {
                c = resolve.bytes_next(src, c, body[1], got);
            } else {
                c = resolve.string_next(src, c, body[1], got);
            }
            for u in 0..got[4] {
                emit.w_byte(w, dst, ' ');
                num(w, dst, got[u]);
            }
        }
    }
}

// The frame arena (back_c.frame_node): a kept charge, a list's mark `%fc<j>` (j the mark's
// node from the function's first), or a give-back to one.
void w_frame[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs,
        in U8[_] pbytes, inout QState[_] q, I64 i) {
    I64 fn = q[0].fn;
    I32 parts = back_c.frame_parts(sir, funcs, fn, i);
    if (parts == 0) {
        return;
    }
    if (sir[i].f == 0 || sir[i].f == 3) {
        call_ctx(w, dst, q, "cint_qbe_frame_charge");
        text(w, dst, ", ");
        site(w, dst, pbytes, q, sir[i].site as I64);
        text(w, dst, ", l ");
        num(w, dst, sir[i].val);
        line(w, dst, ")");
        checked(w, dst, q);
        return;
    }
    I64 m = i;
    if (sir[i].f == 2) {
        m = sir[i].a as I64;
    }
    // Part 1 the frame arena's mark (%fc), part 2 the scratch arena's (%fs), back_c.frame_node.
    for part in 1..3 {
        if ((parts & (part as I32)) == 0) { continue; }
        ins(w, dst, q);
        if (sir[i].f == 1) {
            if (part == 1) { text(w, dst, "%fc"); } else { text(w, dst, "%fs"); }
            num(w, dst, m - (funcs[fn].first as I64));
            if (part == 1) { line(w, dst, " =l call $cint_qbe_frame_mark(l %ctx)"); }
            else { line(w, dst, " =l call $cint_rt_scratch_mark(l %ctx)"); }
        } else {
            if (part == 1) { text(w, dst, "call $cint_qbe_frame_release(l %ctx, l %fc"); }
            else { text(w, dst, "call $cint_rt_scratch_release(l %ctx, l %fs"); }
            num(w, dst, m - (funcs[fn].first as I64));
            line(w, dst, ")");
        }
    }
}

// Before function fn returns: its charges are given back (back_c.frame_return).
void frame_return[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.SirFunc[_] funcs, inout QState[_] q) {
    if ((funcs[q[0].fn].flags & lowering.FN_SCRATCH) != 0) {
        ins(w, dst, q);
        line(w, dst, "call $cint_rt_scratch_release(l %ctx, l %af)");
    }
    if ((funcs[q[0].fn].flags & lowering.FN_FRAME) != 0) {
        ins(w, dst, q);
        line(w, dst, "call $cint_qbe_frame_release(l %ctx, l %ac)");
    }
}

// One scalar of sz bytes in a data definition.
void data_item[b](inout emit.Writer[_] w, inout U8[b] dst, I64 sz, I64 v) {
    if (sz == 1) { text(w, dst, "b "); }
    else if (sz == 2) { text(w, dst, "h "); }
    else if (sz == 4) { text(w, dst, "w "); }
    else { text(w, dst, "l "); }
    num(w, dst, v);
}

// The rank of the module-level array of global node i, and its extent d (back_c.global_extents).
I64 global_rank(in lowering.Sir[_] sir, I64 i) {
    if (sir[i].f > 1) { return sir[i].f as I64; }
    return 1;
}

I64 global_extent(in lowering.Sir[_] sir, in lowering.SirSlot[_] slots, I64 i, I64 d) {
    if (sir[i].f < 2) { return lowering.array_extent(slots[sir[i].a as I64].ty); }
    return (sir[i].val >> (12 * d)) & 4095;
}

// The module's host import table (back_c.c_host_table): per extern row, local rows then
// import rows in funcs order, its name, its canonical type signature (back_c.qbe_extern_signature)
// and its cint_host_import row of 40 bytes; then the cint_host_table `<module>_host`, 16 bytes.
// Effects: CINT_PURE 1, CINT_OBSERVE 2, CINT_UNRESTRICTED 3.
void w_host[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in parse.Node[_] nodes, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots,
        inout limits.Decl[_] decls, in lowering.LState[_] ls, in U8[_] pbytes, in back_c.PMod[_] pm,
        in QState[_] q) {
    I64 bk = decl.block_of(decls, q[0].module);
    I64 row = bk + 1;
    I64 ne = 0;
    for fn in 0..ls[0].nfunc {
        if ((funcs[fn].flags & lowering.FN_EXTERN) == 0) { continue; }
        I64 fr = funcs[fn].entry as I64;
        if ((funcs[fn].flags & lowering.FN_IMPORT) == 0) {
            row = back_c.table_row(src, toks, funcs, decls, bk, fn, row);
            fr = row;
        }
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_hn");
        num(w, dst, ne);
        text(w, dst, " = {{ b \"");
        _ = back_c.host_name(w, dst, src, toks, nodes, funcs, decls, fn);
        line(w, dst, "\", b 0 }}");
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_hs");
        num(w, dst, ne);
        text(w, dst, " = {{ b");
        _ = back_c.qbe_extern_signature(w, dst, decls, pm, pbytes, src, toks, nodes, funcs, slots, q[0].module, fn, fr);
        line(w, dst, " }}");
        ne += 1;
    }
    if (ne > 0) {
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_himports = align 8 {{ ");
        I64 j = 0;
        row = bk + 1;
        for fn in 0..ls[0].nfunc {
            if ((funcs[fn].flags & lowering.FN_EXTERN) == 0) { continue; }
            I64 fr = funcs[fn].entry as I64;
            if ((funcs[fn].flags & lowering.FN_IMPORT) == 0) {
                row = back_c.table_row(src, toks, funcs, decls, bk, fn, row);
                fr = row;
            }
            emit.Writer[1] m;
            U8[1] unused;
            emit.w_measure(m);
            I64 nlen = back_c.host_name(m, unused, src, toks, nodes, funcs, decls, fn);
            emit.Writer[1] m2;
            emit.w_measure(m2);
            I64 slen = back_c.qbe_extern_signature(m2, unused, decls, pm, pbytes, src, toks, nodes, funcs, slots,
                q[0].module, fn, fr);
            I64 effect = 1;
            if ((funcs[fn].flags & lowering.FN_UNRESTRICTED) != 0) { effect = 3; }
            else if ((funcs[fn].flags & lowering.FN_OBSERVES) != 0) { effect = 2; }
            if (j > 0) { text(w, dst, ", "); }
            text(w, dst, "l ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_hn");
            num(w, dst, j);
            text(w, dst, ", w ");
            num(w, dst, nlen);
            text(w, dst, ", w 0, w ");
            num(w, dst, effect);
            text(w, dst, ", w ");
            num(w, dst, funcs[fn].nparam as I64);
            text(w, dst, ", l ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_hs");
            num(w, dst, j);
            text(w, dst, ", l ");
            num(w, dst, slen);
            j += 1;
        }
        line(w, dst, " }}");
    }
    text(w, dst, "export data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_host = align 8 {{ w ");
    num(w, dst, ne);
    if (ne > 0) {
        text(w, dst, ", w 0, l ");
        mod_sym(w, dst, pbytes, q);
        line(w, dst, "_himports }}");
    } else {
        line(w, dst, ", w 0, l 0 }}");
    }
}

// Each set that an error result names (SK_ESET slot k; back_c.c_error_sets), a cint_error_set
// of 24 bytes `<module>_es<k>`: its name, its underlying type's tag, its value count and the
// names in tag order (`_es<k>n`, `_es<k>v<j>`, the table `_es<k>_v`).
void w_esets[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.SirSlot[_] slots, in limits.Decl[_] decls, in U8[_] pbytes, in back_c.PMod[_] pm,
        in QState[_] q) {
    for k in 0..q[0].nslot {
        if (slots[k].kind != lowering.SK_ESET) { continue; }
        I64 nv = 0;
        while (k + 1 + nv < q[0].nslot && slots[k + 1 + nv].kind == lowering.SK_EVAL) {
            nv += 1;
        }
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_es");
        num(w, dst, k);
        text(w, dst, "n = {{ b \"");
        if (slots[k].live > 0) {
            back_c.module_dotted(w, dst, pm, pbytes, decls[(slots[k].live as I64) - 1].module as I64);
            emit.w_byte(w, dst, '.');
            back_c.tok_text(w, dst, src, toks, slots[k].name as I64);
        } else if (slots[k].name == -2) {
            text(w, dst, "AllocError");
        } else if (slots[k].name < 0) {
            text(w, dst, "ArithError");
        } else {
            back_c.module_dotted(w, dst, pm, pbytes, q[0].module);
            emit.w_byte(w, dst, '.');
            back_c.tok_text(w, dst, src, toks, slots[k].name as I64);
        }
        line(w, dst, "\", b 0 }}");
        for j in 0..nv {
            text(w, dst, "data ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_es");
            num(w, dst, k);
            text(w, dst, "v");
            num(w, dst, j);
            text(w, dst, " = {{ b \"");
            back_c.eset_value(w, dst, src, toks, slots, k + 1 + j);
            line(w, dst, "\", b 0 }}");
        }
        if (nv > 0) {
            text(w, dst, "data ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_es");
            num(w, dst, k);
            text(w, dst, "_v = align 8 {{ ");
            for j in 0..nv {
                if (j > 0) { text(w, dst, ", "); }
                text(w, dst, "l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_es");
                num(w, dst, k);
                text(w, dst, "v");
                num(w, dst, j);
            }
            line(w, dst, " }}");
        }
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_es");
        num(w, dst, k);
        text(w, dst, " = align 8 {{ l ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_es");
        num(w, dst, k);
        text(w, dst, "n, w ");
        num(w, dst, slots[k].ty as I64);
        text(w, dst, ", w ");
        num(w, dst, nv);
        text(w, dst, ", l ");
        if (nv > 0) {
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_es");
            num(w, dst, k);
            line(w, dst, "_v }}");
        } else {
            line(w, dst, "0 }}");
        }
    }
}

// The module's state (back_c.c_state; scalars and module-level arrays of scalars): the initial image with its
// padding, the variable table (cint_state_var, 40 bytes) and the descriptor cg<P>_state_desc
// (cint_state, 32 bytes).
void w_state[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, in lowering.SirSlot[_] slots, in U8[_] pbytes, in QState[_] q, in U8[_] lits,
        in limits.Decl[_] decls) {
    I64 nsir = q[0].nsir;
    I64 total = state_layout(sir, slots, nsir, -1);
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_state_init = align 8 {{ ");
    I64 off = 0;
    I64 nv = 0;
    for i in 0..nsir {
        if (global_init(sir, i)) {
            I64 g = sir[i].a as I64;
            I64 at = state_layout(sir, slots, nsir, g);
            if (nv > 0) { text(w, dst, ", "); }
            if (at > off) {
                text(w, dst, "z ");
                num(w, dst, at - off);
                text(w, dst, ", ");
            }
            I64 sz = size_of(lowering.array_elem(slots[g].ty));
            if (lowering.module_struct(slots, g)) {
                off = at + record_data(w, dst, src, toks, sir, slots, i, lits, decls);
            } else if (slots[g].ty == lowering.T_HANDLE) {
                text(w, dst, "z 32");   // the null handle (OQ-242)
                off = at + sz;
            } else if (lowering.is_limbs(lowering.array_elem(slots[g].ty))) {
                // Wide values: each item's limbs, or zeros.
                I64 nit = 1;
                if (lowering.module_array(slots, g)) { nit = sir[i].b as I64; }
                for j in 0..nit {
                    if (j > 0) { text(w, dst, ", "); }
                    I64 ci = i;
                    if (lowering.module_array(slots, g)) { ci = i + 1 + j; }
                    limbs_data(w, dst, src, toks, sir, ci, lowering.array_elem(slots[g].ty), lits, decls);
                }
                I64 ext = 1;
                if (lowering.module_array(slots, g)) { ext = lowering.array_extent(slots[g].ty); }
                if (ext < 1) { ext = 1; }
                if (ext > nit) {
                    if (nit > 0) { text(w, dst, ", "); }
                    text(w, dst, "z ");
                    num(w, dst, (ext - nit) * sz);
                }
                off = at + ext * sz;
            } else if (!lowering.module_array(slots, g)) {
                data_item(w, dst, sz, sir[i].val);
                off = at + sz;
            } else if (sir[i].b == 0) {
                // A module-level array of zeros, with at least one element.
                I64 ext = lowering.array_extent(slots[g].ty);
                if (ext < 1) { ext = 1; }
                text(w, dst, "z ");
                num(w, dst, ext * sz);
                off = at + ext * sz;
            } else {
                // A module-level array's items, in row-major order.
                for j in 0..sir[i].b as I64 {
                    if (j > 0) { text(w, dst, ", "); }
                    data_item(w, dst, sz, sir[i + 1 + j].val);
                }
                off = at + (sir[i].b as I64) * sz;
            }
            nv += 1;
        }
    }
    if (total > off) {
        text(w, dst, ", z ");
        num(w, dst, total - off);
    }
    line(w, dst, " }}");
    I64 j = 0;
    for i in 0..nsir {
        if (global_init(sir, i)) {
            text(w, dst, "data ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_qv");
            num(w, dst, j);
            text(w, dst, " = {{ ");
            I64 tk = slots[sir[i].a as I64].name as I64;
            bytes(w, dst, src, toks[tk].start as I64, toks[tk].len as I64);
            line(w, dst, " }}");
            j += 1;
        }
    }
    // The extents of the module-level arrays, in declaration order and from dimension 0.
    I64 na = 0;
    for i in 0..nsir {
        if (global_init(sir, i) && lowering.module_array(slots, sir[i].a as I64)) {
            if (na == 0) {
                text(w, dst, "data ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_state_ext = align 8 {{ l ");
            } else {
                text(w, dst, ", l ");
            }
            I64 rk = global_rank(sir, i);
            for d in 0..rk {
                if (d > 0) { text(w, dst, ", l "); }
                num(w, dst, global_extent(sir, slots, i, d));
            }
            na += rk;
        }
    }
    if (na > 0) { line(w, dst, " }}"); }
    na = 0;
    I64 ng = 0;
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_state_vars = align 8 {{ ");
    j = 0;
    for i in 0..nsir {
        if (global_init(sir, i)) {
            I64 g = sir[i].a as I64;
            if (j > 0) { text(w, dst, ", "); }
            text(w, dst, "l ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_qv");
            num(w, dst, j);
            text(w, dst, ", w ");
            num(w, dst, toks[slots[g].name as I64].len as I64);
            text(w, dst, ", w ");
            // A handle's runtime tag, CINT_TAG_HANDLE (rt/OPEN.md RT-OQ-50), and a fixed-point type
            // word, not cintc's codes (back_c's table).
            I32 et = lowering.array_elem(slots[g].ty);
            if (lowering.module_struct(slots, g)) { num(w, dst, 0x71); }
            else if (slots[g].ty == lowering.T_HANDLE || lowering.is_q(et)) { num(w, dst, rt_tag(et)); }
            else { num(w, dst, et as I64); }
            text(w, dst, ", w ");
            num(w, dst, state_layout(sir, slots, nsir, g));
            if (lowering.module_struct(slots, g)) {
                // Its type tables (w_state_types).
                text(w, dst, ", w 0, l 0, l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_gs");
                num(w, dst, ng);
                ng += 1;
            } else if (lowering.module_array(slots, g)) {
                // Its rank, and its first extent in the table above.
                text(w, dst, ", w ");
                num(w, dst, global_rank(sir, i));
                text(w, dst, ", l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_state_ext + ");
                num(w, dst, 8 * na);
                text(w, dst, ", l 0");
                na += global_rank(sir, i);
            } else {
                text(w, dst, ", w 0, l 0, l 0");
            }
            j += 1;
        }
    }
    line(w, dst, " }}");
    text(w, dst, "export data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_state_desc = align 8 {{ w ");
    num(w, dst, q[0].module);
    text(w, dst, ", w ");
    num(w, dst, nv);
    text(w, dst, ", w ");
    num(w, dst, total);
    text(w, dst, ", w 0, l ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_state_init, l ");
    mod_sym(w, dst, pbytes, q);
    line(w, dst, "_state_vars }}");
}

// The layout table of the record definitions defs[1 .. defs[0]] (back_c.mem_layout): each one's
// size, then each field's offset, 0 for a field of extent 0 or of a record of size 0. Returns
// the number of `w` items.
I64 layout_rows[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.SirSlot[_] slots, in I64[_] defs) {
    I64 nl = 0;
    for j in 0..defs[0] {
        I64 sd = defs[1 + j];
        I32 st = lowering.T_STRUCT + (sd as I32);
        if (j > 0) { text(w, dst, ", "); }
        text(w, dst, "w ");
        num(w, dst, ty_size(slots, st));
        nl += 1;
        for f in 0..slots[sd].ty as I64 {
            I32 fty = slots[sd + 1 + f].ty;
            Bool zero = lowering.field_array(fty) && lowering.array_extent(fty) == 0;
            text(w, dst, ", w ");
            if (zero || back_c.zero_record(slots, elem_of(fty))) { num(w, dst, 0); }
            else { num(w, dst, field_off(slots, st, f)); }
            nl += 1;
        }
    }
    return nl;
}

// The type tables of each module-level record g, in declaration order (back_c.c_state):
// `_gt<g>`, its type bytes (back_c.qbe_type_bytes); `_gl<g>`, its layout rows; `_gs<g>`, the
// 32-byte cint_state_type that its variable row points at. False when a table outgrows what
// this writer holds (256 definitions).
Bool w_state_types[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, inout lowering.SirSlot[_] slots,
        in lowering.LState[_] ls, in limits.Decl[_] decls, in U8[_] pbytes, in back_c.PMod[_] pm, in QState[_] q) {
    I64[257] defs;
    I64 ng = 0;
    for i in 0..ls[0].nsir {
        if (!global_init(sir, i) || !lowering.module_struct(slots, sir[i].a as I64)) { continue; }
        I32 ety = slots[sir[i].a as I64].ty;
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_gt");
        num(w, dst, ng);
        text(w, dst, " = {{ b");
        I64 tl = back_c.qbe_type_bytes(w, dst, src, toks, funcs, slots, ls, pbytes, pm, q[0].module, decls, ety, defs);
        if (tl < 0) { return false; }
        line(w, dst, " }}");
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_gl");
        num(w, dst, ng);
        text(w, dst, " = align 4 {{ ");
        I64 nl = layout_rows(w, dst, slots, defs);
        line(w, dst, " }}");
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_gs");
        num(w, dst, ng);
        text(w, dst, " = align 8 {{ l ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_gt");
        num(w, dst, ng);
        text(w, dst, ", l ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_gl");
        num(w, dst, ng);
        text(w, dst, ", w ");
        num(w, dst, tl);
        text(w, dst, ", w ");
        num(w, dst, nl);
        line(w, dst, ", w 0, w 0 }}");
        ng += 1;
    }
    return true;
}

// The initial bytes of module-level record node i as data items (back_c.c_struct_init): zeros,
// or each field's value at its offset, nested records and arrays of records in order, from the
// value nodes after i. Returns the record's size.
I64 record_data[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, in lowering.SirSlot[_] slots, I64 i, in U8[_] lits, in limits.Decl[_] decls) {
    I32 rty = slots[sir[i].a as I64].ty;
    I64 rsize = ty_size(slots, rty);
    if (sir[i].b == 0) {
        text(w, dst, "z ");
        num(w, dst, rsize);
        return rsize;
    }
    // Per frame: a record (fe -1) with its struct slot fs, next field fj and offset fb, or an
    // array of records with fe elements, next element fj, the first at fb.
    I64[256] fs;
    I64[256] fj;
    I64[256] fe;
    I64[256] fb;
    fs[0] = (rty - lowering.T_STRUCT) as I64;
    fj[0] = 0;
    fe[0] = -1;
    fb[0] = 0;
    I64 d = 1;
    I64 pos = 0;
    I64 v = i + 1;
    Bool first = true;
    while (d > 0) {
        I64 top = d - 1;
        I64 s = fs[top];
        if (fe[top] >= 0) {
            if (fj[top] == fe[top]) { d -= 1; continue; }
            fs[d] = s;
            fj[d] = 0;
            fe[d] = -1;
            fb[d] = fb[top] + fj[top] * ty_size(slots, lowering.T_STRUCT + (s as I32));
            fj[top] += 1;
            d += 1;
            continue;
        }
        I64 j = fj[top];
        if (j == slots[s].ty as I64) { d -= 1; continue; }
        fj[top] = j + 1;
        I32 fty = slots[s + 1 + j].ty;
        I32 elem = elem_of(fty);
        I64 fo = fb[top] + field_off(slots, lowering.T_STRUCT + (s as I32), j);
        if (elem >= lowering.T_STRUCT) {
            fs[d] = (elem - lowering.T_STRUCT) as I64;
            fj[d] = 0;
            fe[d] = -1;
            if (lowering.field_array(fty)) { fe[d] = lowering.array_extent(fty); }
            fb[d] = fo;
            d += 1;
            continue;
        }
        I64 cnt = 1;
        if (lowering.field_array(fty)) { cnt = lowering.array_extent(fty); }
        I64 sz = size_of(elem);
        for e in 0..cnt {
            I64 at = fo + e * sz;
            if (!first) { text(w, dst, ", "); }
            first = false;
            if (at > pos) {
                text(w, dst, "z ");
                num(w, dst, at - pos);
                text(w, dst, ", ");
            }
            if (lowering.is_limbs(elem)) {
                limbs_data(w, dst, src, toks, sir, v, elem, lits, decls);
            } else if (boxed(elem)) {
                text(w, dst, "z ");
                num(w, dst, sz);   // the null handle (OQ-242)
            } else {
                data_item(w, dst, sz, sir[v].val);
            }
            pos = at + sz;
            v += 1;
        }
    }
    if (rsize > pos) {
        if (!first) { text(w, dst, ", "); }
        text(w, dst, "z ");
        num(w, dst, rsize - pos);
    }
    return rsize;
}

// The most arguments of an extern call of function fn, or -1 when it calls no extern.
I64 host_args(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, I64 fn) {
    I64 n = -1;
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        if ((sir[i].op & lowering.OP_MASK) == lowering.SO_CALL && (sir[i].op & lowering.FL_LIVE) != 0 &&
                sir[i].b == 1 && (sir[i].c as I64) > n) {
            n = sir[i].c as I64;
        }
    }
    return n;
}

// Whether function fn calls a function whose result is an error union.
Bool calls_erru(in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, I64 fn) {
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        if ((sir[i].op & lowering.OP_MASK) == lowering.SO_CALL && (sir[i].op & lowering.FL_LIVE) != 0 &&
                (funcs[sir[i].a as I64].flags & lowering.FN_ERRU) != 0) {
            return true;
        }
    }
    return false;
}

void w_func[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, in U8[_] pbytes,
        inout QState[_] q, I64 fn) {
    q[0].fn = fn;
    q[0].term = 0;
    q[0].nlab = 0;
    text(w, dst, "export function w ");
    fn_sym(w, dst, src, toks, funcs, pbytes, q, fn);
    text(w, dst, "(l %ctx");
    I64 p0 = funcs[fn].pslot0 as I64;
    for p in p0..p0 + (funcs[fn].nparam as I64) {
        text(w, dst, ", l %s");
        num(w, dst, p);
        if (nview(slots, p) || slots[p].kind == lowering.SK_SPARAM || boxed(slots[p].ty)) {
            text(w, dst, "q");
        }
        if (slots[p].kind == lowering.SK_VIEW) {
            text(w, dst, ", l %o");
            num(w, dst, p);
            text(w, dst, ", l %n");
            num(w, dst, p);
            text(w, dst, ", l %d");
            num(w, dst, p);
        }
    }
    if (funcs[fn].result != lowering.T_NONE) {
        text(w, dst, ", l %result");
    }
    if ((funcs[fn].flags & lowering.FN_ERRU) != 0) {
        // An error union result (box 12): the tag's address, 0 when the result holds the value.
        text(w, dst, ", l %etag");
    }
    line(w, dst, ") {{");
    line(w, dst, "@start");
    line(w, dst, "    %out =l alloc8 8");
    if (uses_q_limbs(sir, funcs, fn)) {
        line(w, dst, "    %qa =l alloc8 8");
        line(w, dst, "    %qb =l alloc8 8");
    }
    if (calls_erru(sir, funcs, fn) || host_args(sir, funcs, fn) >= 0) {
        line(w, dst, "    %et =l alloc8 8");
    }
    if (host_args(sir, funcs, fn) >= 0) {
        // The cint_value arguments of the function's extern calls (200 bytes each).
        text(w, dst, "    %hv =l alloc8 ");
        I64 nh = host_args(sir, funcs, fn);
        if (nh < 1) { nh = 1; }
        num(w, dst, 200 * nh);
        emit.w_nl(w, dst);
    }
    for s in funcs[fn].lslot0 as I64..funcs[fn].lslot_end as I64 {
        text(w, dst, "    %s");
        num(w, dst, s);
        if (slots[s].kind == lowering.SK_ARRAY) {
            text(w, dst, " =l alloc8 ");
            num(w, dst, array_bytes(slots, s));
            emit.w_nl(w, dst);
        } else if (nview(slots, s)) {
            line(w, dst, " =l alloc8 88");
        } else if (slots[s].kind == lowering.SK_STRUCT) {
            text(w, dst, " =l alloc8 ");
            num(w, dst, frame_bytes(ty_size(slots, slots[s].ty)));
            emit.w_nl(w, dst);
        } else if (slots[s].kind == lowering.SK_LEASE || boxed(slots[s].ty)) {
            // A lease (cint_lease, 40 bytes), a handle or limbs, zeroed as C's `= {0}`.
            I64 nb = size_of(slots[s].ty);
            if (slots[s].kind == lowering.SK_LEASE) { nb = 40; }
            text(w, dst, " =l alloc8 ");
            num(w, dst, nb);
            emit.w_nl(w, dst);
            text(w, dst, "    call $cint_qbe_zero(l %s");
            num(w, dst, s);
            text(w, dst, ", l ");
            num(w, dst, nb);
            line(w, dst, ")");
        } else {
            line(w, dst, " =l copy 0");
        }
    }
    // A handle temporary's own bytes, and the cells of the box 12 calls.
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        if (sir[i].dst >= 0 && (sir[i].op & lowering.FL_LIVE) != 0 && boxed(sir[i].ty)) {
            text(w, dst, "    ");
            tmp(w, dst, sir, i);
            text(w, dst, " =l alloc8 ");
            num(w, dst, frame_bytes(size_of(sir[i].ty)));
            emit.w_nl(w, dst);
            text(w, dst, "    call $cint_qbe_zero(l ");
            tmp(w, dst, sir, i);
            text(w, dst, ", l ");
            num(w, dst, size_of(sir[i].ty));
            line(w, dst, ")");
        }
    }
    if (uses_mem(sir, funcs, fn)) {
        line(w, dst, "    %mt =l alloc8 8");
        line(w, dst, "    %mv =l alloc8 8");
        line(w, dst, "    %mc =l alloc8 8");
        line(w, dst, "    %mh =l alloc8 128");   // a discarded handle or wide result
    }
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        if ((sir[i].op & lowering.OP_MASK) == lowering.SO_FRAME && sir[i].f == 1) {
            text(w, dst, "    %fc");
            num(w, dst, i - (funcs[fn].first as I64));
            line(w, dst, " =l copy 0");
            text(w, dst, "    %fs");
            num(w, dst, i - (funcs[fn].first as I64));
            line(w, dst, " =l copy 0");
        }
        if ((sir[i].op & lowering.OP_MASK) == lowering.SO_VALLOC) {
            // A run-time-sized array's descriptor starts zero, as C's `= {NULL, 0, ...}`.
            text(w, dst, "    call $cint_qbe_zero(l %s");
            num(w, dst, sir[i].a as I64);
            line(w, dst, ", l 88)");
        }
    }
    if ((funcs[fn].flags & lowering.FN_SCRATCH) != 0) {
        line(w, dst, "    %af =l call $cint_rt_scratch_mark(l %ctx)");
    }
    for p in p0..p0 + (funcs[fn].nparam as I64) {
        if (nview(slots, p) || slots[p].kind == lowering.SK_SPARAM || boxed(slots[p].ty)) {
            // A view parameter of rank 2 to 4, a record or a handle by value is the callee's own
            // copy, as C passes it by value.
            I64 nb = 88;
            if (slots[p].kind == lowering.SK_SPARAM) { nb = ty_size(slots, slots[p].ty); }
            if (boxed(slots[p].ty)) { nb = size_of(slots[p].ty); }
            text(w, dst, "    %s");
            num(w, dst, p);
            text(w, dst, " =l alloc8 ");
            num(w, dst, frame_bytes(nb));
            emit.w_nl(w, dst);
            if (nb > 0) {
                text(w, dst, "    blit %s");
                num(w, dst, p);
                text(w, dst, "q, %s");
                num(w, dst, p);
                text(w, dst, ", ");
                num(w, dst, nb);
                emit.w_nl(w, dst);
            }
        }
    }
    if (uses_desc(sir, funcs, fn)) {
        line(w, dst, "    %da =l alloc8 88");
        line(w, dst, "    %db =l alloc8 88");
        line(w, dst, "    %fv =l alloc8 8");
    }
    if ((funcs[fn].flags & lowering.FN_FRAME) != 0) {
        line(w, dst, "    %ac =l call $cint_qbe_frame_mark(l %ctx)");
    }
    if (uses_state(sir, funcs, slots, q[0].nslot, fn)) {
        // The module's block (cint_rt_state), or a fault return as the C function's false.
        text(w, dst, "    %gst =l call $cint_qbe_state(l %ctx, l ");
        mod_sym(w, dst, pbytes, q);
        line(w, dst, "_state_desc)");
        line(w, dst, "    jnz %gst, @state, @fault");
        line(w, dst, "@state");
        // A module-level array or record is `%s<k>`, as a local one is: its bytes in the block.
        for i in 0..q[0].nsir {
            if (global_init(sir, i) && (lowering.module_array(slots, sir[i].a as I64) ||
                    lowering.module_struct(slots, sir[i].a as I64))) {
                text(w, dst, "    %s");
                num(w, dst, sir[i].a as I64);
                text(w, dst, " =l add %gst, ");
                num(w, dst, state_layout(sir, slots, q[0].nsir, sir[i].a as I64));
                emit.w_nl(w, dst);
            }
        }
    }
    import_state(w, dst, sir, funcs, slots, pbytes, q[0].nfunc, fn);
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        w_step(w, dst, src, toks, sir, funcs, slots, pbytes, q, i);
    }
    if ((funcs[fn].flags & lowering.FN_FALLS) != 0) {
        if ((funcs[fn].flags & lowering.FN_ERRU) != 0) {
            ins(w, dst, q);
            line(w, dst, "storel 0, %etag");
        }
        frame_return(w, dst, funcs, q);
        ins(w, dst, q);
        line(w, dst, "ret 1");
    }
    line(w, dst, "@fault");
    line(w, dst, "    ret 0");
    line(w, dst, "}}");
    // The operation names of the function's checks (back_c.op_name) and its string bytes.
    for i in funcs[fn].first as I64..funcs[fn].last as I64 {
        I32 k = sir[i].op & lowering.OP_MASK;
        if ((sir[i].op & lowering.FL_LIVE) != 0 && (k == lowering.SO_ICHECK || k == lowering.SO_VSLICE)) {
            text(w, dst, "data ");
            node_data(w, dst, pbytes, q, 'i', i);
            text(w, dst, " = {{ b \"");
            back_c.op_name(w, dst, sir, i);
            line(w, dst, "\", b 0 }}");
        }
        if (k == lowering.SO_SDATA) {
            text(w, dst, "data ");
            node_data(w, dst, pbytes, q, 'd', i);
            text(w, dst, " = {{ b");
            if (sir[i].c == 0) {
                text(w, dst, " 0");
            } else {
                sdata_bytes(w, dst, src, toks, sir, i);
            }
            line(w, dst, " }}");
        }
    }
}

// ---------------------------------------------------------------- module data and entries

void bytes[b](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] src, I64 at, I64 n) {
    for i in 0..n {
        if (i > 0) { text(w, dst, ", "); }
        text(w, dst, "b ");
        num(w, dst, src[at + i] as I64);
    }
}

// The bytes of string `s` and a NUL, as a data body.
void cstr[b, n](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] s) {
    text(w, dst, "b \"");
    text(w, dst, s);
    text(w, dst, "\", b 0");
}

// The observer entry cg<P>_o<nth> of function fn (back_c.c_observer): the entry's charge at
// its site, the call with the arguments cut back to their types, the result when it returned.
void w_observer[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q,
        I64 fn, I64 nth) {
    I64 np = funcs[fn].nparam as I64;
    I64 p0 = funcs[fn].pslot0 as I64;
    I32 r = funcs[fn].result;
    // A `Grants` parameter is no observer argument: the entry passes handle 0 for it.
    I64 na = 0;
    for p in p0..p0 + np {
        if (!lowering.is_grants(slots, p)) { na += 1; }
    }
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_t");
    num(w, dst, nth);
    text(w, dst, " = {{ w ");
    num(w, dst, rt_tag(r));
    text(w, dst, ", w ");
    num(w, dst, na);
    for p in p0..p0 + np {
        if (lowering.is_grants(slots, p)) { continue; }
        text(w, dst, ", w ");
        num(w, dst, rt_tag(slots[p].ty));
    }
    line(w, dst, " }}");
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_n");
    num(w, dst, nth);
    text(w, dst, " = {{ ");
    I64 tk = funcs[fn].name as I64;
    bytes(w, dst, src, toks[tk].start as I64, toks[tk].len as I64);
    line(w, dst, " }}");
    text(w, dst, "function w ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_o");
    num(w, dst, nth);
    line(w, dst, "(l %ctx, l %fuel, l %depth, l %args, l %result) {{");
    line(w, dst, "@start");
    line(w, dst, "    %r =l alloc8 8");
    Bool eu = (funcs[fn].flags & lowering.FN_ERRU) != 0;
    if (eu) {
        line(w, dst, "    %e =l alloc8 8");
        line(w, dst, "    storel 0, %e");
    }
    text(w, dst, "    %st =w call $cint_rt_entry_begin(l %ctx, ");
    site(w, dst, pbytes, q, funcs[fn].entry as I64);
    line(w, dst, ", l %fuel, l %depth)");
    line(w, dst, "    jnz %st, @out, @go");
    line(w, dst, "@go");
    I64 ai = 0;
    for p in 0..np {
        if (lowering.is_grants(slots, p0 + p)) {
            text(w, dst, "    %v");
            num(w, dst, p);
            line(w, dst, " =l copy 0");
            continue;
        }
        text(w, dst, "    %ap");
        num(w, dst, p);
        text(w, dst, " =l add %args, ");
        num(w, dst, 8 * ai);
        ai += 1;
        emit.w_nl(w, dst);
        text(w, dst, "    %a");
        num(w, dst, p);
        text(w, dst, " =l loadl %ap");
        num(w, dst, p);
        emit.w_nl(w, dst);
        text(w, dst, "    %v");
        num(w, dst, p);
        if (slots[p0 + p].ty == lowering.T_BOOL) {
            text(w, dst, " =l cnel %a");
            num(w, dst, p);
            line(w, dst, ", 0");
        } else {
            norm_op(w, dst, slots[p0 + p].ty);
            text(w, dst, "%a");
            num(w, dst, p);
            emit.w_nl(w, dst);
        }
    }
    text(w, dst, "    %ok =w call ");
    fn_sym(w, dst, src, toks, funcs, pbytes, q, fn);
    text(w, dst, "(l %ctx");
    for p in 0..np {
        text(w, dst, ", l %v");
        num(w, dst, p);
    }
    if (r != lowering.T_NONE) {
        text(w, dst, ", l %r");
    }
    if (eu) {
        text(w, dst, ", l %e");
    }
    line(w, dst, ")");
    if (eu) {
        // An error result stays in the context for the observer (cint_ctx_error).
        entry_error(w, dst, funcs, slots, pbytes, q, fn, false);
    }
    line(w, dst, "    %st =w call $cint_rt_entry_end(l %ctx)");
    if (r != lowering.T_NONE) {
        line(w, dst, "    %bad =w ceqw %st, 0");
        line(w, dst, "    %keep =w and %ok, %bad");
        if (eu) {
            line(w, dst, "    %ez =w ceql %ev, 0");
            line(w, dst, "    %keep =w and %keep, %ez");
        }
        line(w, dst, "    jnz %keep, @put, @out");
        line(w, dst, "@put");
        line(w, dst, "    %rv =l loadl %r");
        line(w, dst, "    storel %rv, %result");
    }
    line(w, dst, "@out");
    line(w, dst, "    ret %st");
    line(w, dst, "}}");
}

// Whether function fn has a row of the reflection table and a cx wrapper (back_c.c_table): an
// export of this module. check_qbe refuses kernels and `Grants` parameters.
// Only the root module's exports have rows (SPEC-03 A-12, interim rule; back_c o[0].root).
Bool has_row(in lowering.SirFunc[_] funcs, in QState[_] q, I64 fn) {
    // An export with a `Grants` parameter has neither (SPEC-04 LS-326).
    return q[0].root != 0 && (funcs[fn].flags & lowering.FN_EXPORT) != 0 &&
        (funcs[fn].flags & (lowering.FN_IMPORT | lowering.FN_GRANTS)) == 0;
}

// The data $cg<P>_xb<j>[_<p>] of the name of token tk: its bytes.
void name_data[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in U8[_] pbytes, in QState[_] q, I64 tk, I64 j, I64 p) {
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_xb");
    num(w, dst, j);
    if (p >= 0) {
        emit.w_byte(w, dst, '_');
        num(w, dst, p);
    }
    text(w, dst, " = {{ ");
    bytes(w, dst, src, lowering.name_at(toks, tk), lowering.name_len(toks, tk));
    line(w, dst, " }}");
}

// The reflection table of the module (SPEC-03 A-19; back_c.c_table): per export its name, its
// parameter names (cint_name), its type signature (back_c.qbe_signature, the C rows' writer)
// and its cint_export row, 72 bytes; then cint_module_table. Effects: CINT_PURE 1,
// CINT_OBSERVE 2, CINT_UNRESTRICTED 3 (back_c.effect_name).
void w_table[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in parse.Node[_] nodes, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots,
        inout limits.Decl[_] decls, in lowering.LState[_] ls, in U8[_] pbytes, in back_c.PMod[_] pm,
        inout QState[_] q) {
    I64 nx = 0;
    for fn in 0..ls[0].nfunc {
        if (!has_row(funcs, q, fn)) { continue; }
        I64 np = funcs[fn].nparam as I64;
        I64 p0 = funcs[fn].pslot0 as I64;
        name_data(w, dst, src, toks, pbytes, q, funcs[fn].name as I64, nx, -1);
        for k in 0..np {
            name_data(w, dst, src, toks, pbytes, q, slots[p0 + k].name as I64, nx, k);
        }
        if (np > 0) {
            text(w, dst, "data ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_xn");
            num(w, dst, nx);
            text(w, dst, " = align 8 {{ ");
            for k in 0..np {
                if (k > 0) { text(w, dst, ", "); }
                text(w, dst, "l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_xb");
                num(w, dst, nx);
                emit.w_byte(w, dst, '_');
                num(w, dst, k);
                text(w, dst, ", w ");
                num(w, dst, lowering.name_len(toks, slots[p0 + k].name as I64));
                text(w, dst, ", w 0");
            }
            line(w, dst, " }}");
        }
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_xs");
        num(w, dst, nx);
        text(w, dst, " = {{ b");
        _ = back_c.qbe_signature(w, dst, decls, pm, pbytes, src, toks, nodes, funcs, slots, q[0].module, fn);
        line(w, dst, " }}");
        nx += 1;
    }
    if (nx > 0) {
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_exports = align 8 {{ ");
        I64 j = 0;
        for fn in 0..ls[0].nfunc {
            if (!has_row(funcs, q, fn)) { continue; }
            I64 np = funcs[fn].nparam as I64;
            I64 tk = funcs[fn].name as I64;
            emit.Writer[1] m;
            U8[1] unused;
            emit.w_measure(m);
            I64 siglen = back_c.qbe_signature(m, unused, decls, pm, pbytes, src, toks, nodes, funcs, slots,
                q[0].module, fn);
            I64 effect = 1;
            if ((funcs[fn].flags & lowering.FN_UNRESTRICTED) != 0) { effect = 3; }
            else if ((funcs[fn].flags & lowering.FN_OBSERVES) != 0) { effect = 2; }
            if (j > 0) { text(w, dst, ", "); }
            text(w, dst, "l ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_xb");
            num(w, dst, j);
            text(w, dst, ", w ");
            num(w, dst, lowering.name_len(toks, tk));
            text(w, dst, ", w 0, w 1, w ");
            num(w, dst, effect);
            text(w, dst, ", w 0, w ");
            num(w, dst, np);
            text(w, dst, ", l 0, l ");
            if (np > 0) {
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_xn");
                num(w, dst, j);
            } else {
                text(w, dst, "0");
            }
            text(w, dst, ", l ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_xs");
            num(w, dst, j);
            text(w, dst, ", l ");
            num(w, dst, siglen);
            text(w, dst, ", l ");
            cx_sym(w, dst, src, toks, funcs, pbytes, q, fn);
            j += 1;
        }
        line(w, dst, " }}");
    }
    text(w, dst, "export data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_table = align 8 {{ l $cm");
    back_c.comp(w, dst, pbytes, q[0].at, back_c.stem_bytes(pbytes, q[0].at, q[0].len));
    text(w, dst, ", w ");
    num(w, dst, q[0].module);
    text(w, dst, ", w ");
    num(w, dst, nx);
    text(w, dst, ", l ");
    if (nx > 0) {
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_exports");
    } else {
        text(w, dst, "0");
    }
    line(w, dst, ", l 0 }}");
}

// $cx<P><name> of export fn (EMIT-22).
void cx_sym[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.SirFunc[_] funcs, in U8[_] pbytes, in QState[_] q, I64 fn) {
    text(w, dst, "$cx");
    back_c.comp(w, dst, pbytes, q[0].at, back_c.stem_bytes(pbytes, q[0].at, q[0].len));
    back_c.comp(w, dst, src, toks[funcs[fn].name as I64].start as I64, toks[funcs[fn].name as I64].len as I64);
}

// The QBE class of a C parameter or result of type ty: `w` through 32 bits, else `l`.
void cls[b](inout emit.Writer[_] w, inout U8[b] dst, I32 ty) {
    if (width(ty) <= 32) { emit.w_byte(w, dst, 'w'); } else { emit.w_byte(w, dst, 'l'); }
}

// The declaration row of record type ty for its catalog id (back_c.public_record).
I64 record_row(in U8[_] src, in scan.Token[_] toks, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots,
        in QState[_] q, in limits.Decl[_] d, I32 ty) {
    I64 s = (ty - lowering.T_STRUCT) as I64;
    if (slots[s].live != 1) {
        for k in 0..q[0].nfunc {
            if ((funcs[k].flags & lowering.FN_ISTRUCT) != 0 && (funcs[k].pslot0 as I64) == s) {
                return funcs[k].entry as I64;
            }
        }
    }
    I64 tk = slots[s].name as I64;
    return decl.find(d, decl.block_of(d, q[0].module), src, toks[tk].start as I64, toks[tk].len as I64);
}

// The element type of public view parameter p (back_c.public_elem).
I32 public_elem(in lowering.SirSlot[_] slots, I64 p) {
    if (slots[p].kind == lowering.SK_VIEW || slots[p].kind == lowering.SK_NVIEW) {
        return lowering.array_elem(slots[p].ty);
    }
    return slots[p].ty;
}

// `$cg<P>_v<c><fn>_<j>`: bind data c of view j of export fn (t its cint_type, b its Bool offsets).
void bind_sym[b](inout emit.Writer[_] w, inout U8[b] dst, in U8[_] pbytes, in QState[_] q, U8 c, I64 fn, I64 j) {
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_v");
    emit.w_byte(w, dst, c);
    num(w, dst, fn);
    emit.w_byte(w, dst, '_');
    num(w, dst, j);
}

// The extent of dimension dm of the cint_view argument of parameter p, into %<v>.
void view_extent[b, n](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] v, I64 k, I64 dm) {
    text(w, dst, "    %xa =l add %p");
    num(w, dst, k);
    text(w, dst, ", ");
    num(w, dst, 48 + 8 * dm);
    emit.w_nl(w, dst);
    text(w, dst, "    %");
    text(w, dst, v);
    line(w, dst, " =l loadl %xa");
}

// The data of export fn's view binds (back_c.public_decls): per view its declared element type
// (cint_type: code, storage, frac bits, record id) and the byte offsets of an element's Bools.
void w_bind_data[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, inout limits.Decl[_] decls,
        in U8[_] pbytes, in back_c.PMod[_] pm, in QState[_] q, I64 fn, I64 first, I64 end) {
    I64 j = 0;
    for p in first..end {
        if (!back_c.public_view(slots, p)) { continue; }
        I32 ty = public_elem(slots, p);
        I64 row = 0;
        I64 tag = ty as I64;
        if (ty >= lowering.T_STRUCT) {
            tag = 0x71;
            row = record_row(src, toks, funcs, slots, q, decls, ty);
        }
        text(w, dst, "data ");
        bind_sym(w, dst, pbytes, q, 't', fn, j);
        text(w, dst, " = align 8 {{ ");
        I64 rid = 0;
        if (tag == 0x71) { rid = back_c.catalog_id(pm, decls, row); }
        ctype_data(w, dst, tag as I32, rid);
        line(w, dst, " }}");
        emit.Writer[1] m;
        U8[1] unused;
        emit.w_measure(m);
        if (back_c.public_offsets(m, unused, decls, ty, row, 0) > 0) {
            text(w, dst, "data ");
            bind_sym(w, dst, pbytes, q, 'b', fn, j);
            text(w, dst, " = align 4 {{ ");
            _ = back_c.public_offsets(w, dst, decls, ty, row, 2);
            line(w, dst, " }}");
        }
        j += 1;
    }
}

// The cx wrapper of export fn (SPEC-03 A-12; back_c.c_public): the C prototype of the export's
// type signature, entry_open, the Bool and NULL-result refusals, the binds of its views and
// records (each argument a 144-byte cint_view by value, `:view`, which QBE passes in memory as
// C does: cint_rt_bind_views, the shape checks of check 5, cint_rt_bind_finish), the entry's
// fuel, the call, and the result stored when the call returned. A size parameter is the first
// extent that names it. A C caller's parameter of fewer than 64 bits may leave upper bits
// unspecified, so each scalar is extended from its own width.
void w_cx[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in parse.Node[_] nodes, in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots,
        inout limits.Decl[_] decls, in U8[_] pbytes, in back_c.PMod[_] pm, inout QState[_] q, I64 fn) {
    I64[2] fq;
    I64 np = funcs[fn].nparam as I64;
    I64 p0 = funcs[fn].pslot0 as I64;
    I64 ns = lowering.size_count(nodes, funcs, fn);
    I64 first = p0 + ns;
    I64 end = p0 + np;
    I32 r = funcs[fn].result;
    Bool eu = (funcs[fn].flags & lowering.FN_ERRU) != 0;
    Bool res = r != lowering.T_NONE || eu;
    Bool rec = r >= lowering.T_STRUCT;
    I64 nv = 0;
    for p in first..end {
        if (back_c.public_view(slots, p)) { nv += 1; }
    }
    w_bind_data(w, dst, src, toks, funcs, slots, decls, pbytes, pm, q, fn, first, end);
    text(w, dst, "export function w ");
    cx_sym(w, dst, src, toks, funcs, pbytes, q, fn);
    text(w, dst, "(l %ctx, l %fuel");
    for p in first..end {
        text(w, dst, ", ");
        if (back_c.public_view(slots, p)) {
            text(w, dst, ":view");
        } else {
            cls(w, dst, slots[p].ty);
        }
        text(w, dst, " %p");
        num(w, dst, p - first);
    }
    if (res) {
        text(w, dst, ", l %result");
    }
    line(w, dst, ") {{");
    line(w, dst, "@start");
    I64 rbytes = 8;
    if (rec) { rbytes = frame_bytes(ty_size(slots, r)); }
    text(w, dst, "    %r =l alloc8 ");
    num(w, dst, rbytes);
    emit.w_nl(w, dst);
    text(w, dst, "    call $cint_qbe_zero(l %r, l ");
    num(w, dst, rbytes);
    line(w, dst, ")");
    line(w, dst, "    %e =l alloc8 8");
    line(w, dst, "    storel 0, %e");
    if (nv > 0) {
        text(w, dst, "    %g =l alloc8 ");
        num(w, dst, 56 * nv);
        emit.w_nl(w, dst);
    }
    for p in first..end {
        if (slots[p].kind == lowering.SK_NVIEW) {
            text(w, dst, "    %vd");
            num(w, dst, p - first);
            line(w, dst, " =l alloc8 88");
        }
    }
    text(w, dst, "    %st =w call $cint_rt_entry_open(l %ctx, ");
    site(w, dst, pbytes, q, funcs[fn].entry as I64);
    line(w, dst, ", l %fuel, l 0)");
    line(w, dst, "    jnz %st, @out, @k0");
    line(w, dst, "@k0");
    for p in first..end {
        I64 k = p - first;
        if (back_c.public_view(slots, p)) {
            text(w, dst, "@k");
            num(w, dst, k + 1);
            emit.w_nl(w, dst);
            continue;
        }
        text(w, dst, "    %v");
        num(w, dst, k);
        if (slots[p].ty == lowering.T_BOOL) {
            text(w, dst, " =l extub %p");
            num(w, dst, k);
            emit.w_nl(w, dst);
            text(w, dst, "    %bad =w cugtl %v");
            num(w, dst, k);
            line(w, dst, ", 1");
            text(w, dst, "    jnz %bad, @rbool, @k");
            num(w, dst, k + 1);
            emit.w_nl(w, dst);
        } else {
            norm_op(w, dst, slots[p].ty);
            text(w, dst, "%p");
            num(w, dst, k);
            emit.w_nl(w, dst);
        }
        text(w, dst, "@k");
        num(w, dst, k + 1);
        emit.w_nl(w, dst);
    }
    if (res) {
        line(w, dst, "    %null =w ceql %result, 0");
        line(w, dst, "    jnz %null, @rresult, @bind");
        line(w, dst, "@bind");
    }
    if (nv > 0) {
        // One cint_bind per view, 56 bytes (back_c.public_binds): the view, its type, the element
        // size, the Bool offsets and their count, the parameter's index, its mode and rank, ptr.
        I64 j = 0;
        for p in first..end {
            if (!back_c.public_view(slots, p)) { continue; }
            I32 ty = public_elem(slots, p);
            I64 row = 0;
            if (ty >= lowering.T_STRUCT) { row = record_row(src, toks, funcs, slots, q, decls, ty); }
            emit.Writer[1] m;
            U8[1] unused;
            emit.w_measure(m);
            I64 nb = back_c.public_offsets(m, unused, decls, ty, row, 0);
            I64 at = 56 * j;
            text(w, dst, "    %xa =l add %g, ");
            num(w, dst, at);
            emit.w_nl(w, dst);
            text(w, dst, "    storel %p");
            num(w, dst, p - first);
            line(w, dst, ", %xa");
            text(w, dst, "    %xa =l add %g, ");
            num(w, dst, at + 8);
            emit.w_nl(w, dst);
            text(w, dst, "    storel ");
            bind_sym(w, dst, pbytes, q, 't', fn, j);
            line(w, dst, ", %xa");
            text(w, dst, "    %xa =l add %g, ");
            num(w, dst, at + 16);
            emit.w_nl(w, dst);
            text(w, dst, "    storel ");
            num(w, dst, ty_size(slots, ty));
            line(w, dst, ", %xa");
            text(w, dst, "    %xa =l add %g, ");
            num(w, dst, at + 24);
            emit.w_nl(w, dst);
            text(w, dst, "    storel ");
            if (nb > 0) { bind_sym(w, dst, pbytes, q, 'b', fn, j); } else { num(w, dst, 0); }
            line(w, dst, ", %xa");
            I64 mode = 0;
            I32 op = nodes[back_c.public_node(nodes, funcs, fn, p)].op;
            if (op == scan.KW_OUT) { mode = 1; } else if (op == scan.KW_INOUT) { mode = 2; }
            I64[4] wv;
            wv[0] = nb;
            wv[1] = p - first;
            wv[2] = mode;
            wv[3] = lowering.slot_rank(slots, p);
            for f in 0..4 {
                text(w, dst, "    %xa =l add %g, ");
                num(w, dst, at + 32 + 4 * f);
                emit.w_nl(w, dst);
                text(w, dst, "    storew ");
                num(w, dst, wv[f]);
                line(w, dst, ", %xa");
            }
            text(w, dst, "    %xa =l add %g, ");
            num(w, dst, at + 48);
            emit.w_nl(w, dst);
            line(w, dst, "    storel 0, %xa");
            j += 1;
        }
        text(w, dst, "    %ok =w call $cint_rt_bind_views(l %ctx, ");
        site(w, dst, pbytes, q, funcs[fn].entry as I64);
        text(w, dst, ", l %g, w ");
        num(w, dst, nv);
        line(w, dst, ")");
        line(w, dst, "    %ok =w extub %ok");
        line(w, dst, "    jnz %ok, @shape, @end");
        line(w, dst, "@shape");
        // Check 5: each extent with a literal or an earlier size parameter's extent.
        I64 nsc = 0;
        for ix in first..end {
            if (!back_c.public_view(slots, ix)) { continue; }
            for dm in 0..lowering.slot_rank(slots, ix) {
                I64 code = back_c.public_dim(src, toks, nodes, funcs, slots, fn, ix, dm);
                if (code == lowering.VIEW_ANY as I64) { continue; }
                if (code >= lowering.VIEW_SIZE as I64) {
                    back_c.public_first(src, toks, nodes, funcs, slots, fn, first, end, code, fq);
                    if (fq[0] == ix && fq[1] == dm) { continue; }
                    view_extent(w, dst, "xe", fq[0] - first, fq[1]);
                } else {
                    text(w, dst, "    %xe =l copy ");
                    num(w, dst, code - 1);
                    emit.w_nl(w, dst);
                }
                view_extent(w, dst, "xx", ix - first, dm);
                line(w, dst, "    %bad =w cnel %xx, %xe");
                text(w, dst, "    jnz %bad, @sf");
                num(w, dst, nsc);
                text(w, dst, ", @sk");
                num(w, dst, nsc);
                emit.w_nl(w, dst);
                text(w, dst, "@sf");
                num(w, dst, nsc);
                emit.w_nl(w, dst);
                text(w, dst, "    call $cint_fault_shape(l %ctx, ");
                site(w, dst, pbytes, q, funcs[fn].entry as I64);
                text(w, dst, ", w ");
                num(w, dst, ix - first);
                text(w, dst, ", w ");
                num(w, dst, dm);
                line(w, dst, ", l %xe, l %xx)");
                line(w, dst, "    jmp @end");
                text(w, dst, "@sk");
                num(w, dst, nsc);
                emit.w_nl(w, dst);
                nsc += 1;
            }
        }
        text(w, dst, "    %ok =w call $cint_rt_bind_finish(l %ctx, ");
        site(w, dst, pbytes, q, funcs[fn].entry as I64);
        text(w, dst, ", l %g, w ");
        num(w, dst, nv);
        line(w, dst, ")");
        line(w, dst, "    %ok =w extub %ok");
        line(w, dst, "    jnz %ok, @charge, @end");
        line(w, dst, "@charge");
    }
    text(w, dst, "    %ok =w call $cint_qbe_fuel(l %ctx, ");
    site(w, dst, pbytes, q, funcs[fn].entry as I64);
    line(w, dst, ", l 1)");
    line(w, dst, "    jnz %ok, @call, @end");
    line(w, dst, "@call");
    // The arguments: size parameters, then each parameter in the internal ABI (w_func).
    for z in 0..ns {
        back_c.public_first(src, toks, nodes, funcs, slots, fn, first, end, (lowering.VIEW_SIZE as I64) + z, fq);
        if (fq[0] >= 0) {
            text(w, dst, "    %xa =l add %p");
            num(w, dst, fq[0] - first);
            text(w, dst, ", ");
            num(w, dst, 48 + 8 * fq[1]);
            emit.w_nl(w, dst);
        }
        text(w, dst, "    %z");
        num(w, dst, z);
        if (fq[0] < 0) { line(w, dst, " =l copy 0"); } else { line(w, dst, " =l loadl %xa"); }
    }
    I64 j = 0;
    for p in first..end {
        if (!back_c.public_view(slots, p)) { continue; }
        I64 k = p - first;
        text(w, dst, "    %xa =l add %g, ");
        num(w, dst, 56 * j + 48);
        emit.w_nl(w, dst);
        text(w, dst, "    %a");
        num(w, dst, k);
        line(w, dst, " =l loadl %xa");
        if (slots[p].kind == lowering.SK_VIEW) {
            text(w, dst, "    %xa =l add %p");
            num(w, dst, k);
            line(w, dst, ", 48");
            text(w, dst, "    %n");
            num(w, dst, k);
            line(w, dst, " =l loadl %xa");
            text(w, dst, "    %xa =l add %p");
            num(w, dst, k);
            line(w, dst, ", 80");
            text(w, dst, "    %d");
            num(w, dst, k);
            line(w, dst, " =l loadl %xa");
        } else if (slots[p].kind == lowering.SK_NVIEW) {
            // The body's cint_vdesc: the bound origin element, origin 0, the rank, and the
            // argument's extents and strides (back_c.public_vdesc).
            I64 rk = lowering.slot_rank(slots, p);
            text(w, dst, "    storel %a");
            num(w, dst, k);
            text(w, dst, ", %vd");
            num(w, dst, k);
            emit.w_nl(w, dst);
            for f in 1..11 {
                text(w, dst, "    %xa =l add %vd");
                num(w, dst, k);
                text(w, dst, ", ");
                num(w, dst, 8 * f);
                emit.w_nl(w, dst);
                I64 dm = (f - 3) % 4;
                if (f == 1) {
                    line(w, dst, "    storel 0, %xa");
                } else if (f == 2) {
                    text(w, dst, "    storel ");
                    num(w, dst, rk);
                    line(w, dst, ", %xa");
                } else if (dm >= rk) {
                    line(w, dst, "    storel 0, %xa");
                } else {
                    text(w, dst, "    %xb =l add %p");
                    num(w, dst, k);
                    text(w, dst, ", ");
                    if (f < 7) { num(w, dst, 48 + 8 * dm); } else { num(w, dst, 80 + 8 * dm); }
                    emit.w_nl(w, dst);
                    line(w, dst, "    %xc =l loadl %xb");
                    line(w, dst, "    storel %xc, %xa");
                }
            }
        }
        j += 1;
    }
    text(w, dst, "    %ok =w call ");
    fn_sym(w, dst, src, toks, funcs, pbytes, q, fn);
    text(w, dst, "(l %ctx");
    for z in 0..ns {
        text(w, dst, ", l %z");
        num(w, dst, z);
    }
    for p in first..end {
        I64 k = p - first;
        if (slots[p].kind == lowering.SK_VIEW) {
            text(w, dst, ", l %a");
            num(w, dst, k);
            text(w, dst, ", l 0, l %n");
            num(w, dst, k);
            text(w, dst, ", l %d");
            num(w, dst, k);
        } else if (slots[p].kind == lowering.SK_NVIEW) {
            text(w, dst, ", l %vd");
            num(w, dst, k);
        } else if (back_c.public_view(slots, p)) {
            text(w, dst, ", l %a");
            num(w, dst, k);
        } else {
            text(w, dst, ", l %v");
            num(w, dst, k);
        }
    }
    if (r != lowering.T_NONE) {
        text(w, dst, ", l %r");
    }
    if (eu) {
        text(w, dst, ", l %e");
    }
    line(w, dst, ")");
    if (eu) {
        entry_error(w, dst, funcs, slots, pbytes, q, fn, false);
    }
    line(w, dst, "    %st =w call $cint_rt_entry_end(l %ctx)");
    if (eu) {
        line(w, dst, "    %good =w ceqw %st, 0");
        line(w, dst, "    %keep =w and %ok, %good");
        line(w, dst, "    jnz %keep, @put, @out");
        line(w, dst, "@put");
        public_union(w, dst, r, lowering.func_etag(funcs, fn));
    } else if (r != lowering.T_NONE) {
        line(w, dst, "    %good =w ceqw %st, 0");
        line(w, dst, "    %keep =w and %ok, %good");
        line(w, dst, "    jnz %keep, @put, @out");
        line(w, dst, "@put");
        if (rec) {
            I64 rs = ty_size(slots, r);
            if (rs > 0) {
                text(w, dst, "    blit %r, %result, ");
                num(w, dst, rs);
                emit.w_nl(w, dst);
            }
        } else {
            line(w, dst, "    %rv =l loadl %r");
            I64 bits = width(r);
            if (bits <= 8) { line(w, dst, "    storeb %rv, %result"); }
            else if (bits == 16) { line(w, dst, "    storeh %rv, %result"); }
            else if (bits == 32) { line(w, dst, "    storew %rv, %result"); }
            else { line(w, dst, "    storel %rv, %result"); }
        }
    }
    line(w, dst, "@out");
    line(w, dst, "    ret %st");
    line(w, dst, "@rbool");
    line(w, dst, "    call $cint_rt_refuse(l %ctx, w 11)");
    line(w, dst, "    jmp @end");
    line(w, dst, "@rresult");
    line(w, dst, "    call $cint_rt_refuse(l %ctx, w 12)");
    line(w, dst, "@end");
    line(w, dst, "    %st =w call $cint_rt_entry_end(l %ctx)");
    line(w, dst, "    ret %st");
    line(w, dst, "}}");
}

// The SK_ESET slot of entry fn's error set, right before its parameters (back_c.entry_set).
I64 entry_set(in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, I64 fn) {
    I64 k = (funcs[fn].pslot0 as I64) - 1;
    while (k > 0 && slots[k].kind == lowering.SK_EVAL) {
        k -= 1;
    }
    return k;
}

// In an entry wrapper, after the call of FN_ERRU function fn with its tag at %e: the error the
// entry leaves with (back_c.entry_error), when the call returned (%ok, unless `faulted_zero`:
// a call that faults leaves the tag at 0) and the tag is not 0. The tag is left in %ev.
void entry_error[b](inout emit.Writer[_] w, inout U8[b] dst, in lowering.SirFunc[_] funcs,
        in lowering.SirSlot[_] slots, in U8[_] pbytes, in QState[_] q, I64 fn, Bool faulted_zero) {
    line(w, dst, "    %ev =l loadl %e");
    line(w, dst, "    %en =w cnel %ev, 0");
    if (!faulted_zero) {
        line(w, dst, "    %en =w and %en, %ok");
    }
    line(w, dst, "    jnz %en, @eset, @eend");
    line(w, dst, "@eset");
    text(w, dst, "    call $cint_rt_error_result(l %ctx, l ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_es");
    num(w, dst, entry_set(funcs, slots, fn));
    line(w, dst, ", l %ev)");
    line(w, dst, "@eend");
}

// The store of %<v> to %<at> by the bytes of type ty: Bool and 8 bits storeb.
void store_to[b, n, m](inout emit.Writer[_] w, inout U8[b] dst, I32 ty, in U8[n] v, in U8[m] at) {
    text(w, dst, "    ");
    store_op(w, dst, ty);
    text(w, dst, " ");
    text(w, dst, v);
    text(w, dst, ", ");
    line(w, dst, at);
}

// The public error union of an export with error type et and value type r (back_c.public_union):
// a zeroed struct of the tag and then the value, the value only when the tag is 0.
void public_union[b](inout emit.Writer[_] w, inout U8[b] dst, I32 r, I32 et) {
    I64 ts = size_of(et);
    I64 total = ts;
    I64 voff = 0;
    if (r != lowering.T_NONE) {
        I64 vs = size_of(r);
        voff = (ts + vs - 1) / vs * vs;
        I64 al = ts;
        if (vs > al) { al = vs; }
        total = (voff + vs + al - 1) / al * al;
    }
    text(w, dst, "    call $cint_qbe_zero(l %result, l ");
    num(w, dst, total);
    line(w, dst, ")");
    store_to(w, dst, et, "%ev", "%result");
    if (r != lowering.T_NONE) {
        line(w, dst, "    jnz %ev, @out, @value");
        line(w, dst, "@value");
        line(w, dst, "    %rv =l loadl %r");
        text(w, dst, "    %ra =l add %result, ");
        num(w, dst, voff);
        emit.w_nl(w, dst);
        store_to(w, dst, r, "%rv", "%ra");
    }
}

// An entry that runs function fn under fuel (cg<P>_run, cg<P>_test<j>): back_c's `_run`.
void w_entry[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in lowering.SirFunc[_] funcs, in lowering.SirSlot[_] slots, in U8[_] pbytes, inout QState[_] q, I64 fn) {
    Bool eu = (funcs[fn].flags & lowering.FN_ERRU) != 0;
    line(w, dst, "(l %ctx, l %fuel) {{");
    line(w, dst, "@start");
    if (eu) {
        // `E!void main()` (SPEC-04 LS-221): its error is the program's (SPEC-06 3.4a).
        line(w, dst, "    %e =l alloc8 8");
        line(w, dst, "    storel 0, %e");
    }
    text(w, dst, "    %st =w call $cint_rt_entry_begin(l %ctx, ");
    site(w, dst, pbytes, q, funcs[fn].entry as I64);
    line(w, dst, ", l %fuel, l 0)");
    line(w, dst, "    jnz %st, @out, @go");
    line(w, dst, "@go");
    if ((funcs[fn].flags & lowering.FN_ARGS) != 0) {
        // `main(in U8[_] args)`: the context's program arguments (cint_ctx_args), origin 0,
        // stride 1 (back_c.run_args).
        line(w, dst, "    %an =l alloc8 8");
        line(w, dst, "    %ap =l call $cint_ctx_args(l %ctx, l %an)");
        line(w, dst, "    %anv =l loadl %an");
    }
    text(w, dst, "    call ");
    fn_sym(w, dst, src, toks, funcs, pbytes, q, fn);
    text(w, dst, "(l %ctx");
    if ((funcs[fn].flags & lowering.FN_GRANTS) != 0) {
        // `main(Grants g)` takes the context's grant set, handle 0.
        text(w, dst, ", l 0");
    }
    if ((funcs[fn].flags & lowering.FN_ARGS) != 0) {
        text(w, dst, ", l %ap, l 0, l %anv, l 1");
    }
    if (eu) {
        line(w, dst, ", l %e)");
        entry_error(w, dst, funcs, slots, pbytes, q, fn, true);
    } else {
        line(w, dst, ")");
    }
    line(w, dst, "    %st =w call $cint_rt_entry_end(l %ctx)");
    line(w, dst, "@out");
    line(w, dst, "    ret %st");
    line(w, dst, "}}");
}

// Module module_index: its sites, descriptors, functions and entries.
export void write_module[b, n, t](inout emit.Writer[_] w, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in parse.Node[_] nodes, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, inout lowering.SirSlot[_] slots,
        inout limits.Decl[_] decls, in lowering.LState[_] ls, in U8[_] pbytes, in back_c.PMod[_] pm, I64 module_index,
        in U8[_] lits) {
    QState[1] q;
    q[0].fn = 0;
    q[0].module = module_index;
    q[0].root = 0;
    if (module_index == pm[0].path_at - 1) { q[0].root = 1; }
    q[0].at = pm[module_index + 1].path_at;
    q[0].len = pm[module_index + 1].path_len;
    q[0].term = 0;
    q[0].nlab = 0;
    q[0].nsir = ls[0].nsir;
    q[0].nslot = ls[0].nslot;
    q[0].nfunc = ls[0].nfunc;
    line(w, dst, "# cint-core-1, cint-rt-3, cpu-qbe, emitted by cintc");
    line(w, dst, "type :site = {{ w, w }}");
    line(w, dst, "type :view = align 8 {{ l 18 }}");
    line(w, dst, "type :handle = align 8 {{ l 4 }}");
    // The sites as cint_site values and as the cint_site_info table (EMIT-23).
    // The SIR text's sites, then the frame arena's kept charges (back_c.frame_sites).
    I64 nsite = ls[0].sites + 1 + back_c.frame_sites(sir, ls);
    for k in 0..nsite {
        text(w, dst, "data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_qs");
        num(w, dst, k);
        text(w, dst, " = align 4 {{ w ");
        num(w, dst, module_index);
        text(w, dst, ", w ");
        num(w, dst, k);
        line(w, dst, " }}");
    }
    for i in 0..ls[0].nsir {
        if (sir[i].site > 0) {
            text(w, dst, "data ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_qo");
            num(w, dst, sir[i].site as I64);
            text(w, dst, " = {{ b \"");
            back_c.op_name(w, dst, sir, i);
            line(w, dst, "\", b 0 }}");
        }
        if ((sir[i].op & lowering.OP_MASK) == lowering.SO_PRINT_BYTES) {
            I64 at = sir[i].val;
            I64 left = sir[i].c as I64;
            I64 piece = 0;
            while (left > 0) {
                I64 m = left;
                if (m > 1024) { m = 1024; }
                text(w, dst, "data ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_qp");
                num(w, dst, i);
                emit.w_byte(w, dst, '_');
                num(w, dst, piece);
                text(w, dst, " = {{ ");
                bytes(w, dst, src, at, m);
                line(w, dst, " }}");
                at += m;
                left -= m;
                piece += 1;
            }
        }
    }
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    line(w, dst, "_qe = {{ b 0 }}");
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_sites = align 8 {{ w 0, w 0, l ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_qe");
    for pass in 0..2 {
        for i in 0..ls[0].nsir {
            Bool charge = (sir[i].op & lowering.OP_MASK) == lowering.SO_FRAME;
            if (sir[i].site > 0 && charge == (pass == 1)) {
                I64 tk = sir[i].tok as I64;
                text(w, dst, ", w ");
                num(w, dst, toks[tk].line as I64);
                text(w, dst, ", w ");
                num(w, dst, toks[tk].col as I64);
                text(w, dst, ", l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_qo");
                num(w, dst, sir[i].site as I64);
            }
        }
    }
    line(w, dst, " }}");
    text(w, dst, "data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_qpath = {{ ");
    bytes(w, dst, pbytes, q[0].at, q[0].len);
    line(w, dst, ", b 0 }}");
    // cint_module, cint_module_info (cm<P>), cint_module_table and cint_host_table.
    text(w, dst, "export data ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_module = align 8 {{ l ");
    mod_sym(w, dst, pbytes, q);
    text(w, dst, "_qpath, w ");
    num(w, dst, q[0].len);
    text(w, dst, ", w ");
    num(w, dst, nsite);
    text(w, dst, ", l ");
    mod_sym(w, dst, pbytes, q);
    line(w, dst, "_sites }}");
    text(w, dst, "export data $cm");
    back_c.comp(w, dst, pbytes, q[0].at, back_c.stem_bytes(pbytes, q[0].at, q[0].len));
    text(w, dst, " = align 8 {{ w ");
    num(w, dst, ABI_VERSION);
    I64 nrec = 0;
    if (q[0].root != 0) { nrec = back_c.catalog_count(decls); }
    text(w, dst, ", w ");
    num(w, dst, nrec);
    if (nrec > 0) {
        text(w, dst, ", l $cg_program, l ");
        mod_sym(w, dst, pbytes, q);
        line(w, dst, "_records }}");
        w_catalog(w, dst, decls, pm, pbytes, q);
    } else {
        line(w, dst, ", l $cg_program, l 0 }}");
    }
    w_table(w, dst, src, toks, nodes, funcs, slots, decls, ls, pbytes, pm, q);
    if (state_layout(sir, slots, ls[0].nsir, -1) > 0) {
        w_state(w, dst, src, toks, sir, slots, pbytes, q, lits, decls);
    }
    _ = w_state_types(w, dst, src, toks, sir, funcs, slots, ls, decls, pbytes, pm, q);
    w_wide_consts(w, dst, src, toks, sir, funcs, pbytes, q, lits, decls);
    w_esets(w, dst, src, toks, slots, decls, pbytes, pm, q);
    w_host(w, dst, src, toks, nodes, funcs, slots, decls, ls, pbytes, pm, q);
    _ = w_memories(w, dst, src, toks, funcs, slots, ls, decls, pbytes, pm, q);
    for fn in 0..ls[0].nfunc {
        if ((funcs[fn].flags & (lowering.FN_IMPORT | lowering.FN_EXTERN)) == 0) {
            w_func(w, dst, src, toks, sir, funcs, slots, pbytes, q, fn);
        }
    }
    for fn in 0..ls[0].nfunc {
        if (has_row(funcs, q, fn)) {
            w_cx(w, dst, src, toks, nodes, funcs, slots, decls, pbytes, pm, q, fn);
        }
    }
    I64 nth = 0;
    for fn in 0..ls[0].nfunc {
        if ((funcs[fn].flags & lowering.FN_OBSERVE) != 0) {
            w_observer(w, dst, src, toks, funcs, slots, pbytes, q, fn, nth);
            nth += 1;
        }
    }
    if (nth > 0) {
        text(w, dst, "export data ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_obs = align 8 {{ ");
        I64 j = 0;
        for fn in 0..ls[0].nfunc {
            if ((funcs[fn].flags & lowering.FN_OBSERVE) != 0) {
                if (j > 0) { text(w, dst, ", "); }
                text(w, dst, "w ");
                num(w, dst, module_index);
                text(w, dst, ", w ");
                num(w, dst, toks[funcs[fn].name as I64].len as I64);
                text(w, dst, ", l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_n");
                num(w, dst, j);
                text(w, dst, ", l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_t");
                num(w, dst, j);
                text(w, dst, ", l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_o");
                num(w, dst, j);
                j += 1;
            }
        }
        line(w, dst, " }}");
    }
    if (ls[0].entry >= 0) {
        text(w, dst, "export function w ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_run");
        w_entry(w, dst, src, toks, funcs, slots, pbytes, q, ls[0].entry);
    }
    for fn in 0..ls[0].nfunc {
        if ((funcs[fn].flags & lowering.FN_TEST) != 0) {
            text(w, dst, "export function w ");
            mod_sym(w, dst, pbytes, q);
            text(w, dst, "_test");
            num(w, dst, -2 - (funcs[fn].name as I64));
            w_entry(w, dst, src, toks, funcs, slots, pbytes, q, fn);
        }
    }
}

// The program's `requires` lines (back_c.requires_manifest) as `$cg_requires`, NUL-terminated:
// per DK_REQ row its name, `:` and its arguments split by `,`, and a newline; false for none.
Bool requires_data[b](inout emit.Writer[_] w, inout U8[b] dst, in limits.Decl[_] d) {
    if (d[0].kind != limits.DK_HEADER) {
        return false;
    }
    Bool any = false;
    for row in 1..d[0].a {
        if (d[row].kind != limits.DK_REQ) { continue; }
        if (!any) {
            text(w, dst, "data $cg_requires = {{ b");
            any = true;
        }
        for i in 0..(d[row].name_len as I64) {
            text(w, dst, " ");
            num(w, dst, back_c.decl_byte(d, row, i) as I64);
        }
        I64 arg = decl.next_member(d, row);
        for j in 0..(d[row].ref as I64) {
            if (j == 0) { text(w, dst, " 58"); } else { text(w, dst, " 44"); }
            for i in 0..(d[arg].name_len as I64) {
                text(w, dst, " ");
                num(w, dst, back_c.decl_byte(d, arg, i) as I64);
            }
            arg = decl.next_member(d, arg);
        }
        text(w, dst, " 10");
    }
    if (any) {
        line(w, dst, " 0 }}");
    }
    return any;
}

// The program-level SSA (back_c.write_program): the module list, the revision, cg_program, the
// observer, library and import descriptors, and `main` when the root module has an entry.
export void write_program[b](inout emit.Writer[_] w, inout U8[b] dst, in back_c.PMod[_] pm, in U8[_] pbytes,
        in limits.Decl[_] decls, I64 revision) {
    I64 m = pm[0].path_at;
    I64 root = m - 1;
    QState[1] q;
    line(w, dst, "# cint-core-1, cint-rt-3, cpu-qbe program entry, emitted by cintc");
    text(w, dst, "data $cg_modules = align 8 {{ ");
    for k in 0..m {
        if (k > 0) { text(w, dst, ", "); }
        q[0].at = pm[k + 1].path_at;
        q[0].len = pm[k + 1].path_len;
        text(w, dst, "l ");
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_module");
    }
    line(w, dst, " }}");
    text(w, dst, "data $cg_revision = {{ ");
    bytes(w, dst, pbytes, revision, 32);
    line(w, dst, " }}");
    text(w, dst, "export data $cg_program = align 8 {{ w ");
    num(w, dst, m);
    line(w, dst, ", w 0, l $cg_modules, l $cg_revision }}");
    I64 obs = -1;
    for k in 0..m {
        if (pm[k + 1].nobs > 0) { obs = k; }
    }
    text(w, dst, "export data $cint_observer_desc = align 8 {{ w ");
    if (obs >= 0) {
        q[0].at = pm[obs + 1].path_at;
        q[0].len = pm[obs + 1].path_len;
        num(w, dst, pm[obs + 1].nobs);
        text(w, dst, ", w 0, l $cg_program, l ");
        mod_sym(w, dst, pbytes, q);
        line(w, dst, "_obs }}");
    } else {
        line(w, dst, "0, w 0, l $cg_program, l 0 }}");
    }
    text(w, dst, "export data $cint_program_abi = align 4 {{ w ");
    num(w, dst, ABI_VERSION);
    line(w, dst, " }}");
    for g in 0..2 {
        if (g == 0) { text(w, dst, "data $cg_tables = align 8 {{ "); }
        else { text(w, dst, "data $cg_host = align 8 {{ "); }
        for k in 0..m {
            if (k > 0) { text(w, dst, ", "); }
            q[0].at = pm[k + 1].path_at;
            q[0].len = pm[k + 1].path_len;
            text(w, dst, "l ");
            mod_sym(w, dst, pbytes, q);
            if (g == 0) { text(w, dst, "_table"); } else { text(w, dst, "_host"); }
        }
        line(w, dst, " }}");
    }
    text(w, dst, "export data $cint_library_desc = align 8 {{ w ");
    num(w, dst, ABI_VERSION);
    text(w, dst, ", w ");
    num(w, dst, m);
    line(w, dst, ", l $cg_tables }}");
    text(w, dst, "export data $cint_imports_desc = align 8 {{ w ");
    num(w, dst, m);
    line(w, dst, ", w 0, l $cg_host }}");
    // The observer's state tables (back_c.program_state): the root module first, then the
    // others in program-table order; pm[k + 1].flags 1 marks a module with a cint_state.
    I64 nstate = 0;
    for k in 0..m {
        if ((pm[k + 1].flags & 1) != 0) { nstate += 1; }
    }
    if (nstate > 0) {
        text(w, dst, "data $cg_states = align 8 {{ ");
        I64 j = 0;
        for x in 0..m {
            I64 k = x - 1;
            if (x == 0) { k = m - 1; }
            if ((pm[k + 1].flags & 1) != 0) {
                if (j > 0) { text(w, dst, ", "); }
                q[0].at = pm[k + 1].path_at;
                q[0].len = pm[k + 1].path_len;
                text(w, dst, "l ");
                mod_sym(w, dst, pbytes, q);
                text(w, dst, "_state_desc");
                j += 1;
            }
        }
        line(w, dst, " }}");
        text(w, dst, "export data $cint_observer_state = align 8 {{ w ");
        num(w, dst, nstate);
        text(w, dst, ", w 0, l $cg_states, l ");
    } else {
        text(w, dst, "export data $cint_observer_state = align 8 {{ w 0, w 0, l 0, l ");
    }
    // The root module's arenas and pools (back_c.program_state), which a revision carries.
    if (root >= 0 && (pm[root + 1].flags & 2) != 0) {
        q[0].at = pm[root + 1].path_at;
        q[0].len = pm[root + 1].path_len;
        mod_sym(w, dst, pbytes, q);
        line(w, dst, "_mem }}");
    } else {
        line(w, dst, "0 }}");
    }
    if (root >= 0 && pm[root + 1].entry >= 1) {
        q[0].at = pm[root + 1].path_at;
        q[0].len = pm[root + 1].path_len;
        Bool reqs = requires_data(w, dst, decls);
        line(w, dst, "export function w $main(w %argc, l %argv) {{");
        line(w, dst, "@start");
        if (reqs) {
            line(w, dst, "    call $cint_program_requires(l $cg_requires)");
        }
        // A `main` that takes the program arguments (entry 2) runs by cint_program_run_argv
        // with CINT_PROGRAM_ARGS (back_c.write_program).
        if (pm[root + 1].entry == 2) {
            text(w, dst, "    %status =w call $cint_program_run_argv(l $cg_program, l ");
        } else {
            text(w, dst, "    %status =w call $cint_program_run_args(l $cg_program, l ");
        }
        mod_sym(w, dst, pbytes, q);
        text(w, dst, "_run, l -1, w %argc, l %argv, l $cint_imports_desc, l ");
        if (nstate > 0) { text(w, dst, "$cint_observer_state"); } else { text(w, dst, "0"); }
        if (pm[root + 1].entry == 2) { line(w, dst, ", w 1)"); } else { line(w, dst, ")"); }
        line(w, dst, "    ret %status");
        line(w, dst, "}}");
    }
}

export I64 measure_output[n, t](Bool program, in U8[n] src, in scan.Token[t] toks, in parse.Node[_] nodes,
        in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, inout lowering.SirSlot[_] slots, inout limits.Decl[_] decls,
        in lowering.LState[_] ls, in U8[_] pbytes, in back_c.PMod[_] pm, I64 module_index, I64 revision, in U8[_] lits) {
    emit.Writer[1] w;
    U8[1] unused;
    emit.w_measure(w);
    if (program) { write_program(w, unused, pm, pbytes, decls, revision); }
    else { write_module(w, unused, src, toks, nodes, sir, funcs, slots, decls, ls, pbytes, pm, module_index, lits); }
    if (emit.w_finish(w) != emit.W_OK) { return -1; }
    return w[0].pos;
}

export I64 emit_output[b, n, t](Bool program, inout U8[b] dst, in U8[n] src, in scan.Token[t] toks,
        in parse.Node[_] nodes, in lowering.Sir[_] sir, in lowering.SirFunc[_] funcs, inout lowering.SirSlot[_] slots,
        inout limits.Decl[_] decls, in lowering.LState[_] ls, in U8[_] pbytes, in back_c.PMod[_] pm, I64 module_index,
        I64 revision, in U8[_] lits) {
    emit.Writer[1] w;
    emit.w_emit(w, b);
    if (program) { write_program(w, dst, pm, pbytes, decls, revision); }
    else { write_module(w, dst, src, toks, nodes, sir, funcs, slots, decls, ls, pbytes, pm, module_index, lits); }
    if (emit.w_finish(w) != emit.W_OK) { return w[0].pos; }
    return -1;
}
