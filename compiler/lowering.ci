// compiler/lowering.ci: the syntax tree of one module to SIR in tables (SPEC-09 6.1 to 6.3,
// SIR-01 to SIR-07, SIR-15, CINTC-01 to CINTC-03, CINTC-13; slice 2 task 2.11).
//
// Input. The tables of scan.ci and parse.ci for a module that the front end accepted, and
// `text`, the module's bytes copied to offset 0 (main.ci does that, so the later bridge
// calls, which get no source view, can still read names). This module binds names and
// types itself, from the declarations in the tree, and takes checked Sem rows for switch
// scrutinee types and folded label values. A program with a compile error never reaches it (compiler/OPEN.md
// CINTC-OQ-30). It is lowering.ci, not the lower.ci of SPEC-09 10.1, because `lower` is a
// built-in name (SPEC-04 LS-145) and `import lower;` is C3001 (CINTC-OQ-32). A construct
// outside the scalar surface that lowering covers is C9102 (not yet supported by this
// implementation, SPEC-04 17.2) at the construct, with detail[0] one of the U_* identifiers
// below.
//
// SIR. One Sir row per node, in evaluation order (SIR-02). A value-defining node has a
// temporary `dst`, numbered from 0 per function in definition order (SIR-09); an operand
// is the index of the node that defines it, or -(p + 1) for parameter p of the function,
// so the type of every operand is the `ty` of its defining node. Mutable variables are
// slots (SirSlot), read and written by `load.local` and `store.local`. Control flow is
// structured (SIR-05): an `if` node with an ordered list of arms (an `else if` chain is one
// node, CINTC-03), `loop`, `switch`, `break`, `continue`, `return`; `&&` and `||` lower to
// an `if` over a hidden Bool slot. Each structure is a begin node, its parts, and an `end`
// node whose `a` is the begin node. Every node that can fault carries a site (SIR-04),
// numbered per module in node order from 1. The canonical text (SIR-09) is written by
// back_c.ci; the node forms are listed at the SO_* constants.
//
// Types and literals. A literal takes the type its context gives (SPEC-04 LS-54): the
// declared type, the other operand, the parameter, the result type. A literal-only operand
// with no context (an operand of a comparison, a shift count, a hole) is lowered with type
// 0 and settled once its type is known: a comparison gives it the other side's type, or
// I64 when both sides are literal-only; a shift count, a hole, and the source of `as` are
// typed I64. The nodes a value spans are contiguous, so settling rewrites the type of the
// untyped nodes in that range only. A literal source of `as` or `as%` (IM-26) is converted
// here, from its value: its constant node gets the target type. A name of a module
// constant is one constant node of the constant's type, whatever its initializer: the
// literal the initializer names, or else the value the checker folded (Sem.bits), so no
// reference lowers the initializer again (SPEC-09 CINTC-16 row 6).
//
// Walks. cint-boot-1 has no recursion (SPEC-09 5.3), so statements and expressions are
// walked with the explicit stack `st` (parse.Frame rows of the frame region, KR-03): one
// frame per open statement list, `if`, loop, or `switch`, and one per expression node
// waiting for an operand. A call keeps its finished arguments in value frames below its
// own frame. The stack holds at most one frame per node (a left operand chain
// `1 + 1 + ... + 1` is one level of source nesting and a tree of its length), so its limit
// in the region, LState.cap, is the node table's extent (task 2.13: a chain of 600 terms
// was C9004 with the parser's limit), or the region's extent when that is smaller. Running
// out of it is C9004 at the construct that needed the frame (SPEC-04 LS-311).
//
// Bound (CINTC-13): O(n) frames and nodes for n tokens, except name lookup, which scans
// the visible slots of the function and the module's constant declarations (O(n) each,
// so O(n^2) in the worst case; compiler/OPEN.md CINTC-OQ-31 until resolve.ci binds names).

import limits;
import scan;
import parse;
import fold;
import resolve;
import decl;

// ---------------------------------------------------------------- tables

// One SIR node; the field use of each opcode is listed at its constant.
export struct Sir {
    I32 op;
    I32 ty;
    I32 dst;
    I32 a;
    I32 b;
    I32 c;
    I32 site;
    I32 tok;
    I32 e;
    I32 f;
    I64 val;
}

// One function of the module. A script's implicit entry is a function with name -1.
// Parameters are slots pslot0 to pslot0 + nparam - 1; locals are lslot0 to lslot_end - 1.
export struct SirFunc {
    I32 name;
    I32 node;
    I32 result;
    I32 nparam;
    I32 pslot0;
    I32 lslot0;
    I32 lslot_end;
    I32 first;
    I32 last;
    I32 ntemp;
    I32 entry;
    I32 flags;
}

// One slot: a parameter, a local, or a hidden Bool of `&&` or `||` (name -1).
export struct SirSlot {
    I32 name;
    I32 ty;
    I32 kind;
    I32 live;
}

// The state of one lowering, a one-element view.
export struct LState {
    I64 module;
    I64 nsir;
    I64 nfunc;
    I64 nslot;
    I64 sp;
    I64 err;
    I64 func;
    I64 temps;
    I64 sites;
    I64 srcn;
    I64 textn;
    I64 rv;
    I64 rty;
    I64 rfirst;
    I64 rend;
    I64 script;
    I64 root;
    I64 entry;
    I64 max_sp;
    I64 cap;
}

export const I64 SIR_BYTES = 48;
export const I64 FUNC_BYTES = 48;
export const I64 SLOT_BYTES = 16;
export const I64 LSTATE_BYTES = 160;

// Type tags (SPEC-01 IM-146); 0 is "not yet typed" (a literal-only value).
export const I32 T_NONE = 0;
export const I32 T_BOOL = 0x01;
export const I32 T_I8 = 0x11;
export const I32 T_I16 = 0x12;
export const I32 T_I32 = 0x13;
export const I32 T_I64 = 0x14;
export const I32 T_U8 = 0x21;
export const I32 T_U16 = 0x22;
export const I32 T_U32 = 0x23;
export const I32 T_U64 = 0x24;
// Box 12: a handle (SPEC-03 M-12), a cint_handle in C (rt/cint_mem.h); decl.ci's tag of a
// memory type.
export const I32 T_HANDLE = 0x74;

// Opcodes (Sir.op & OP_MASK). Fields not listed are 0, or -1 for a node reference.
//   SO_CONST      dst = const T val
//   SO_LOAD       dst = load.local slot a
//   SO_STORE      store.local slot a, value b (ty: the slot's type)
//   SO_LOCAL      local slot a (its declaration, where it comes into scope)
//   SO_BIN        dst = <c>.<form f>.<ty> a, b; c a B_* operation, f 0 checked, 1 wrapping,
//                 2 saturating (B_ADD, B_SUB, B_MUL only; never faults, SPEC-01 4.1), 3
//                 result (B_ADD to B_SHL; box 12, an SO_ETAG follows)
//   SO_UN         dst = <c>.<form f>.<ty> a; c U_NEG, U_NOT (bitwise), U_LNOT (Bool)
//   SO_CMP        dst = cmp.<c>.<f> a, b; c a CMP_*, f the operand type; ty Bool
//   SO_AS         dst = as.<form c>.<f>.<ty> a; f the source type, c 0 checked, 1 wrapping
//   SO_ARG        argument a of the next SO_CALL (one per argument, right before it); with
//                 e 1, a is the array or view slot passed to a view parameter; with e 2,
//                 the argument of a size parameter, the extent of slot a
//   SO_CALL       [dst =] call function a with the c SO_ARG nodes before it
//   SO_FUEL       fuel.charge val: an entry's charge (first node of the function) or a
//                 loop iteration's (after the loop's `while`)
//   SO_RETURN     return a (b 1) or return (b 0)
//   SO_DISCARD    a value a expression statement does not use
//   SO_PRINT_BEGIN, SO_PRINT_BYTES (text[val .. val + c)), SO_PRINT_VALUE (value a of
//                 type ty; e the form of its format specification or 0 for none, f the
//                 fill, val the width, c the scale's zeros: format_form), SO_PRINT_END:
//                 one print statement (SPEC-04 LS-193)
//   SO_IF         begin of an if chain; then per arm SO_ARM, the condition's nodes,
//                 SO_THEN (condition a), the body, SO_ARM_END (a its SO_THEN, b the
//                 SO_IF); then SO_ELSE and the else body when there is one; SO_END
//   SO_LOOP       begin of a loop; the condition's nodes and SO_TEST (a the condition,
//                 b the loop: leave when false), SO_FUEL, the body, SO_NEXT (a the loop:
//                 the target of `continue`), the update's nodes, SO_END
//   SO_SWITCH     begin of a switch on value a (b the first case); per case SO_CASE or
//                 SO_DEFAULT (a the switch, b the next case), its items as pairs SO_ITEM
//                 (val the low end) and SO_HI (val the high end), SO_BODY, the body,
//                 SO_CASE_END (a the case, b the switch, c 1 when it ends in
//                 `fallthrough`); the default case is last; SO_END
//   SO_BREAK      leave structure a (a loop or a switch); SO_CONTINUE: go to loop a's SO_NEXT
//   SO_END        end of structure a; c 1 when it also ends the else part of an if
//   SO_ICHECK     index.checked.<ty>: index b (I64) of array slot a, whose element type is
//                 ty, is in bounds (E_BOUNDS)
//   SO_ELOAD      dst = index.load slot a, index b (ty: the element type)
//   SO_ESTORE     index.store slot a, index b, value c (ty: the element type)
//   SO_FLOAD      dst = field.load slot a, field c (ty: the field's type)
//   SO_FSTORE     field.store slot a, field c, value b (ty: the field's type)
//   SO_SCOPY      struct.copy slot a from slot b
//   SO_EFLOAD     dst = element.load slot a, index b, field c: field c of element b of an
//                 array or view of structs (task 2.14; ty: the field's type)
//   SO_EFSTORE    element.store slot a, index b, field c, value f (ty: the field's type)
//   SO_FELOAD     dst = field.index.load slot a, field c, index b: element b of the array
//                 field c of struct slot a (task 2.14; ty: the element type); the SO_ICHECK
//                 before it has c = field + 1
//   SO_FESTORE    field.index.store slot a, field c, index b, value f
//   SO_FSCOPY     field.copy slot a, field c, from struct slot b: a struct field (task 2.14)
//   SO_FSLOAD     field.copy.out struct slot a from slot b, field c (task 2.14)
//   SO_SHAPE      bind.shape: the extent of view argument slot a, the argument at position b
//                 of the call that follows, equals that of slot c, or val when c is -1
//                 (E_SHAPE, the entry check of SPEC-04 LS-123; task 2.14)
//   SO_SDATA      the bytes of a string literal passed to a view: tok its first token, f
//                 its token count, c its byte count (SO_ARG e 4 passes it, e 5 its length)
//   SO_ASSERT     assert.checked.bool a (SPEC-04 LS-191; E_ASSERT at the condition's first
//                 token, tok): a the Bool condition; b 1 when a is the SO_CMP of a
//                 comparison, whose two operands the fault record carries (`cint_ref` _assert)
//   SO_BUILTIN    dst = <name>.checked.<S>[.<T>][.<mode>] a[, b[, c]]: integer built-in f
//                 (fold.BI_*) on its fold.builtin_values(f) values a, b, c (a rotation's
//                 count b has its own type); ty the result type; val the rounding mode
//                 (1 to 9, 0 for none) plus 256 times the operand type S when S differs
//                 from ty (uabs, mul_full, muldiv), else 0 (box 07)
export const I32 SO_CONST = 1;
export const I32 SO_LOAD = 2;
export const I32 SO_STORE = 3;
export const I32 SO_LOCAL = 4;
export const I32 SO_BIN = 5;
export const I32 SO_UN = 6;
export const I32 SO_CMP = 7;
export const I32 SO_AS = 8;
export const I32 SO_ARG = 9;
export const I32 SO_CALL = 10;
export const I32 SO_FUEL = 11;
export const I32 SO_RETURN = 12;
export const I32 SO_DISCARD = 13;
export const I32 SO_PRINT_BEGIN = 14;
export const I32 SO_PRINT_BYTES = 15;
export const I32 SO_PRINT_VALUE = 16;
export const I32 SO_PRINT_END = 17;
export const I32 SO_IF = 20;
export const I32 SO_ARM = 21;
export const I32 SO_THEN = 22;
export const I32 SO_ARM_END = 23;
export const I32 SO_ELSE = 24;
export const I32 SO_LOOP = 25;
export const I32 SO_TEST = 26;
export const I32 SO_NEXT = 27;
export const I32 SO_SWITCH = 28;
export const I32 SO_CASE = 29;
export const I32 SO_DEFAULT = 30;
export const I32 SO_ITEM = 31;
export const I32 SO_HI = 32;
export const I32 SO_BODY = 33;
export const I32 SO_CASE_END = 34;
export const I32 SO_BREAK = 35;
export const I32 SO_CONTINUE = 36;
export const I32 SO_END = 37;
export const I32 SO_ICHECK = 38;
export const I32 SO_ELOAD = 39;
export const I32 SO_ESTORE = 40;
export const I32 SO_FLOAD = 41;
export const I32 SO_FSTORE = 42;
export const I32 SO_SCOPY = 43;
export const I32 SO_SDATA = 44;
export const I32 SO_EFLOAD = 45;
export const I32 SO_EFSTORE = 46;
export const I32 SO_FELOAD = 47;
export const I32 SO_FESTORE = 48;
export const I32 SO_FSCOPY = 49;
export const I32 SO_FSLOAD = 50;
export const I32 SO_SHAPE = 51;
export const I32 SO_ASSERT = 52;
// SO_FREF: address of field c of slot b into place slot a.
// SO_EREF: addresses checked element c of slot b, or its field e-1, into place a.
export const I32 SO_FREF = 53;
export const I32 SO_EREF = 54;
// Borrows array field c of record slot b into array-place slot a.
export const I32 SO_AFREF = 55;
// Copies a fixed array slot b into fresh record slot a's array field c.
export const I32 SO_FACOPY = 56;
// Checks slot a's logical extent against val, dimension b, before a copy. With c a slot,
// the destination extent is that slot's (whole-array assignment).
export const I32 SO_COPY_SHAPE = 57;
// Copies every element of array place b into array place a (SPEC-04 LS-70); f is the
// SO_COPY_SHAPE that proves a run-time extent, or -1 when both extents are static.
export const I32 SO_ACOPY = 58;
export const I32 SO_BUILTIN = 59;
// Box 09 (SPEC-02, SPEC-04 LS-62 to LS-70, LS-161 to LS-165; rulings R1 to R10). A view
// node's slot operands are SK_ARRAY, SK_VIEW, SK_APLACE or SK_NVIEW slots.
//   SO_VBEGIN     view a := the view of slot b; with b a flat SK_ARRAY and a of rank 2 to 4,
//                 b's elements in row-major order with the extents in val's 12-bit fields
//                 from dimension 0
//   SO_VPICK      index b (I64, checked before) into dimension f of view a: its origin moves
//                 b strides of that dimension (ruling R1)
//   SO_VSLICE     slice.checked.<E>: dimension f % 8 of view a, low bound b and high bound c
//                 (-1 when not written; f / 64: 1 low, 2 high, 4 `..=`), step val; e is the
//                 sliced slot, whose rank decides the record's dimension operand (rulings R2, R3)
//   SO_VEND       view a after the f items of a subscript of slot b: the dimensions in the mask
//                 val leave it, and its rank becomes its slot's
//   SO_VTRANS     view a := the transpose of the view of slot b (rank 2)
//   SO_VREV       view a := the view of slot b reversed along dimension f (ruling R4)
//   SO_EOFF       dst = the element offset in view a: c (an earlier SO_EOFF, -1 for the
//                 origin) plus index b (checked before) times the stride of dimension f
//   SO_VCOPY      copy.shape, copy.alias: the view of slot b copied into the view of slot a
//                 (SPEC-01 IM-187; ty the element type)
//   SO_REDUCE     dst = reduction f (CINT_REDUCE_* of rt/cint_rt.h) over the view of slot a, b
//                 the second view of dot (-1 otherwise), c the initial value (-1 for none);
//                 val the element type, ty the result's (rulings R5, R6)
//   SO_VEXT       dst = the extent of dimension f of the view of slot a; f -1 for its size
//   SO_CALIAS     bind.alias: the views of slot a, the `inout` argument c, and slot b,
//                 argument f, of the call that follows (SPEC-04 LS-121)
//   SO_VDIM       extent b (I64) of dimension f of run-time-sized local array a
//   SO_VALLOC     decl.shape, arena.alloc: storage for run-time-sized local array a of rank f
//                 from the frame arena (SPEC-04 LS-110; ruling R10)
//   SO_AINIT      element val of local array a := b (an item of an array literal)
export const I32 SO_VBEGIN = 60;
export const I32 SO_VPICK = 61;
export const I32 SO_VSLICE = 62;
export const I32 SO_VEND = 63;
export const I32 SO_VTRANS = 64;
export const I32 SO_VREV = 65;
export const I32 SO_EOFF = 66;
export const I32 SO_VCOPY = 67;
export const I32 SO_REDUCE = 68;
export const I32 SO_VEXT = 69;
export const I32 SO_CALIAS = 70;
export const I32 SO_VDIM = 71;
export const I32 SO_VALLOC = 72;
export const I32 SO_AINIT = 73;
// Kernels (SPEC-02 K-1 to K-12, F-1 to F-8, R-1 to R-7; rulings R7 to R9, OQ-203). A kernel
// is a function of its own (FN_KERNEL) whose C parameters after the context are the
// dispatch site and the writable bits of its array arguments, then its parameters in
// order: an array as a view (SK_NVIEW, live 1 for `in`, 3 plus its staging view's slot for
// `out` and `inout`), a scalar `in` as a value, a scalar `out` as the address its
// publication writes (SK_KOUT, live 2 plus its `reduce` statement). Its nodes are the
// dispatch from entry to publication; a node whose site is KSITE faults at the dispatch site.
//   SO_KCALL      dispatch: call kernel a with the c SO_ARG nodes before it (an array as a
//                 view, e 7; a scalar `in` as its value; a scalar `out` as the address of
//                 slot a, e 8); val the writable bit of each argument's view by position
//   SO_KENTRY     the dispatch number; phase entry
//   SO_KSHAPE     bind.shape: dimension f of array parameter a (position c) has extent b
//   SO_KWHERE     bind.where: constraint c, comparison f (CMP_*) of values a and b
//   SO_KALIAS     bind.alias: the views of written array parameter a (position c) and array
//                 parameter b (position f); ty the element type
//   SO_KFUEL      fuel.charge: the dispatch's N units, value a
//   SO_KSTAGE     staging view a of written array parameter b; f 2 copies its elements in
//   SO_KACC       the initial value b of the accumulator of scalar `out` a (fold_checked)
//   SO_KPUSH      the dispatch site onto the stack; phase work-item
//   SO_KITEM      work-item a: the step counter to 0, and the f `over` variables from slot b
//                 at its indices over the extents from slot c (row-major, last fastest)
//   SO_KSTEP      one counted operation of a work-item (SPEC-01 IM-113)
//   SO_KRED       contribution a to the accumulator of scalar `out` b, reduction f
//                 (CINT_REDUCE_*), val the contribution's type, ty the target's
//   SO_KPHASE     phase f (the epilogue)
//   SO_KEPI       the epilogue of the accumulator of scalar `out` a, reduction f, val the
//                 contributions' type (sum), ty the target's
//   SO_KPOP       the dispatch site off the stack
//   SO_KPUB       publication: staging view b into array parameter a, or the accumulator
//                 of scalar `out` a (b -1)
export const I32 SO_KCALL = 74;
export const I32 SO_KENTRY = 75;
export const I32 SO_KSHAPE = 76;
export const I32 SO_KWHERE = 77;
export const I32 SO_KALIAS = 78;
export const I32 SO_KFUEL = 79;
export const I32 SO_KSTAGE = 80;
export const I32 SO_KACC = 81;
export const I32 SO_KPUSH = 82;
export const I32 SO_KITEM = 83;
export const I32 SO_KSTEP = 84;
export const I32 SO_KRED = 85;
export const I32 SO_KPHASE = 86;
export const I32 SO_KEPI = 87;
export const I32 SO_KPOP = 88;
export const I32 SO_KPUB = 89;
// The site of a node that faults at the dispatch site, a parameter of the kernel's C function.
export const I32 KSITE = -1;
// Box 12 (SPEC-04 LS-92 to LS-97, LS-129 to LS-131, LS-185 to LS-190, LS-315), opcodes 100
// to 129. A value of an error set is its tag in the set's underlying type, a T_U* value. An
// error union is a pair: the union's node, whose dst holds the value, and the SO_ETAG node
// right after it, whose dst holds the tag, 0 when the union holds the value.
//   SO_ETAG       dst = the error tag of union node a (ty: the set's underlying type): an
//                 SO_CALL of an FN_ERRU function, an SO_AS of form 2 (`as?`: 4, ArithError
//                 .narrow, when the source does not fit), or an SO_BIN of form 3 (`add_result`
//                 and the others: the ArithError tag its checked form's fault mirrors)
//   SO_ERROR      tag a of the set that slot c describes (SK_ESET) leaves a test block: the
//                 test fails with it (LS-315; cint_rt_error_result); an SO_RETURN follows,
//                 or the SO_CONST of the exit code that leaves past deferred statements
//   SO_BLOCK      begin of the region of a `defer` or `errdefer`, which SO_BREAK a leaves; it
//                 runs to the end of the statement list, where its SO_END is followed by the
//                 deferred statement (lemma S; see exit_through)
//   SO_WIDEN      dst = widen.<ty> a by slot b: tag a of a set of type f converted to a set of
//                 type ty that holds it, by the runs of slot b (SK_WIDEN), when the bases of
//                 the source keep more than one run (convert_tag)
// SO_AS form c 2 converts with wrapping, its value valid when its SO_ETAG is 0; SO_BIN form f
// 3 (operations B_ADD to B_SHL) never faults, its value valid when its SO_ETAG is 0. SO_RETURN b 3
// returns error tag a, of the function's set, from an FN_ERRU function.
export const I32 SO_ETAG = 100;
export const I32 SO_ERROR = 101;
export const I32 SO_BLOCK = 102;
export const I32 SO_WIDEN = 103;
// Box 12 memory lifetimes (SPEC-03 M-12 to M-23; ref/OPEN.md REF-OQ-45; compiler/OPEN.md
// CINTC-OQ-64), from rt/cint_mem.h. A container operand is a slot: SK_ARENA_M or SK_POOL_M,
// whose identifier is its order among the module's arenas or pools from 1, or SK_ARENA_R or
// SK_POOL_R, which holds one at run time. None charges a step or fuel.
//   SO_MEMBER     [dst =] member c (resolve.MB_*) of container slot a at the member name: b the
//                 argument (a count, an element value, or a handle), or -1; for MB_CHILD, f the
//                 SK_ARENA_R slot that takes the child; for an element of struct type, f the
//                 struct slot that holds the value (b -1); MB_ALLOC_RESULT and
//                 MB_INSERT_RESULT are unions, an SO_ETAG follows
//   SO_MVIEW      handle.check: view slot a := the allocation of handle c in arena slot b, its
//                 lease in slot a + 1 (SK_LEASE), at the `[`
//   SO_LEASE      handle.check of lease slot a: an element access through its view (M-23)
//   SO_PREF       pool.deref: place slot a (SK_SPLACE) := the element of handle c in pool
//                 slot b, at the `[`
export const I32 SO_MEMBER = 104;
export const I32 SO_MVIEW = 105;
export const I32 SO_LEASE = 106;
export const I32 SO_PREF = 107;
// The frame arena (SPEC-04 LS-110; decision 2026-10-06 on OQ-213). A local array whose
// storage is its own (an SK_ARRAY) is charged its element count when its declaration runs,
// at its name, before its initializer; one of run-time storage is charged by its SO_VALLOC.
// A statement list that declares either kind takes a mark when it starts and gives back to
// it at each exit: its end, after its deferred statements, and each `break` and `continue`
// that leaves it; a return gives back to the function's mark. frame_proof decides which
// functions charge (FN_FRAME). None is in the SIR text, and none is in a kernel.
//   SO_FRAME      f 0: charge val elements (verify.can_fault); f 3: the same charge, which
//                 frame_proof skipped; f 1: the mark of a list, b 1 when its arrays are
//                 charged and 2 when they have run-time storage (both may be set); f 2:
//                 give back to the mark of SO_FRAME a, the parts that b selects
export const I32 SO_FRAME = 108;

// Sir.op = opcode | flags. The flags are verify.ci's flow results (back_c.ci reads them).
export const I32 OP_MASK = 255;
export const I32 FL_LIVE = 256;
export const I32 FL_END = 512;
export const I32 FL_HEAD = 1024;
export const I32 FL_NEXT = 2048;
export const I32 FL_FALSE = 4096;
export const I32 FL_OPEN = 8192;

// Binary operations (SO_BIN c), unary (SO_UN c), comparisons (SO_CMP c).
export const I32 B_ADD = 1;
export const I32 B_SUB = 2;
export const I32 B_MUL = 3;
export const I32 B_DIV = 4;
export const I32 B_REM = 5;
export const I32 B_SHL = 6;
export const I32 B_SHR = 7;
export const I32 B_AND = 8;
export const I32 B_OR = 9;
export const I32 B_XOR = 10;
export const I32 U_NEG = 1;
export const I32 U_NOT = 2;
export const I32 U_LNOT = 3;
export const I32 CMP_EQ = 1;
export const I32 CMP_NE = 2;
export const I32 CMP_LT = 3;
export const I32 CMP_LE = 4;
export const I32 CMP_GT = 5;
export const I32 CMP_GE = 6;

// Slot kinds and function flags.
export const I32 SK_PARAM = 1;
export const I32 SK_LOCAL = 2;
export const I32 SK_HIDDEN = 3;
export const I32 SK_ARRAY = 4;
export const I32 SK_VIEW = 5;
export const I32 SK_SDECL = 6;
export const I32 SK_FIELD = 7;
export const I32 SK_STRUCT = 8;
export const I32 SK_SPARAM = 9;
// Task 2.14: an `inout` struct parameter (SPEC-04 LS-119), passed by address; its fields
// are read and written in place, and the argument is the address of a struct slot (SO_ARG
// e 6).
export const I32 SK_SREF = 10;
// Module state (task 2.14; SPEC-04 LS-113, SPEC-03 A-7): a scalar module-level variable of
// an importable module is a slot of kind SK_GLOBAL, before the slots of any function,
// read by SO_LOAD and written by SO_STORE like a local. Its initial value is an SO_CONST
// node outside every function (dst -1, a the slot), which back_c.ci writes into the
// module's state image; the checker has folded the initializer (LS-113, C6004).
export const I32 SK_GLOBAL = 20;
// A hidden address of an aggregate place, established by SO_FREF or SO_EREF.
export const I32 SK_SPLACE = 21;
// Retains an array field's pointer and its statically encoded logical extent.
export const I32 SK_APLACE = 22;
// A module-level variable of an imported module, `alias.name` (G-C2 review COR-2): read by
// SO_LOAD and written by SO_STORE like module state; name the name token of its first
// reference, live the index of its import row (FN_IVAR). It is not found by its bare name.
export const I32 SK_IGLOBAL = 23;
// Box 12: an error set that an error result names (SPEC-06 3.4a, 3.5; SPEC-09 CONF-11 rule
// 12), for the runtime's report: an SK_ESET slot (name the set's name token, -1 for
// ArithError, or -2 for AllocError; ty its underlying type) followed by one SK_EVAL slot per
// value in tag order (name the value's name token, or -2 - j for ArithError's value j from 0
// and -6 for AllocError's `full`; ty the name token of its declaring set plus 1 when another
// member set declares the same name, -1 or -2 for ArithError or AllocError then, else 0).
// Both have live 0, so no name finds them. back_c.ci writes each as a cint_error_set.
export const I32 SK_ESET = 24;
export const I32 SK_EVAL = 25;
// A view of rank 1 to 4 (box 09), a cint_vdesc in C, whose ty is its element type plus 256
// times its rank: a local, hidden for a subscript's or a built-in's view, named for a local
// array of rank 2 to 4 or of a run-time extent and for a view variable; or a view parameter
// of rank 2 to 4. A hidden view of an arena allocation of structs (box 12) has rank 1 and
// ty its struct type. A view parameter (SK_VIEW or SK_NVIEW) declared `inout` has live 2.
export const I32 SK_NVIEW = 26;
// A scalar `out` parameter of a kernel (SO_KCALL), whose value the dispatch publishes.
export const I32 SK_KOUT = 27;
// Box 12: the conversion of SO_WIDEN from one set to another, made once per pair of sets (lemma
// S): an SK_WIDEN slot (name the source's set index, ty the target's) followed by one SK_WRUN
// slot per run of the source's tags in tag order (name the run's last tag, ty what the run
// adds to a tag). All have live 0, so no name finds them. back_c.ci writes each pair as one C
// function.
export const I32 SK_WIDEN = 28;
export const I32 SK_WRUN = 29;
// Box 12: a module-level arena or pool of the root module (SO_MEMBER): name its name, ty the
// slot type of its element, live its capacity (at most 2^31 - 1). An arena or a pool held
// at run time: a local arena that `child` makes, or a parameter; its identifier, a uint32_t
// in C. The lease of a view of an arena allocation (SO_MVIEW), a cint_lease in C, is the slot
// right after the view's.
export const I32 SK_ARENA_M = 30;
export const I32 SK_POOL_M = 31;
export const I32 SK_ARENA_R = 32;
export const I32 SK_POOL_R = 33;
export const I32 SK_LEASE = 34;

// Structs (task 2.13 part (ii); SPEC-04 section 6). Each struct of the module is a slot of
// kind SK_SDECL (name its name, ty its field count) followed by one SK_FIELD slot per field
// (name the field's name, ty its scalar type), before the slots of any function. A struct
// variable is a slot of kind SK_STRUCT, a struct parameter one of kind SK_SPARAM (passed by
// value, SPEC-04 LS-107), whose ty is T_STRUCT plus the struct's SK_SDECL slot. Field j of
// struct slot a is read by SO_FLOAD and written by SO_FSTORE; SO_SCOPY copies a struct.
export const I32 T_STRUCT = 536870912;
export const I32 FN_EXPORT = 1;
export const I32 FN_SCRIPT = 2;
export const I32 FN_MAIN = 4;
export const I32 FN_OBSERVE = 8;
export const I32 FN_USED = 16;
export const I32 FN_FAULT = 32;
export const I32 FN_FALLS = 64;
// An import row (task 2.13 part (iii)): a function or constant of another module that this
// module names as `alias.name`. name is the name token of its first reference, first and
// last the alias token, node the module index, entry its row in the declaration table.
// A function's parameters are slots pslot0 to pslot0 + nparam - 1 with name -1, and
// compiler/main.ci puts its module's path in lslot0 (offset in the path table) and
// lslot_end (bytes). A constant (FN_ICONST) has its type in result and its value's low and
// high 32 bits in lslot0 and lslot_end. No import row has SIR, and verify.ci, back_c.ci's
// SIR text and its C definitions skip them.
export const I32 FN_IMPORT = 128;
export const I32 FN_ICONST = 256;
// An imported struct (task 2.13 part (iii)): an import row with pslot0 its SK_SDECL slot,
// which main.ci gives its module's path as any import row, for the C name of the struct
// (back_c.c_struct). An imported struct's SK_SDECL slot has live 2 plus the alias token of
// its first reference; its SK_FIELD slots are named as name_at and name_len read them.
export const I32 FN_ISTRUCT = 512;
// A test block (SPEC-04 LS-232; task 2.14 part (c)): a void function with no parameters,
// named -2 - j for the module's test j in source order, charged as an entry.
export const I32 FN_TEST = 1024;
// An imported module-level variable (G-C2 review COR-2): an import row with result its type,
// pslot0 its SK_IGLOBAL slot and ntemp its index in its module's state table (the `a` of
// its declaration-table row, limits.DK_VAR).
export const I32 FN_IVAR = 2048;
// A function with a run-time-sized local array (SO_VALLOC), whose storage back_c.ci gives
// back to the frame arena when it returns.
export const I32 FN_SCRATCH = 4096;
// A kernel (box 09; SO_KCALL dispatches it).
export const I32 FN_KERNEL = 8192;
// Box 12: a function whose result is an error union `E!T` (SPEC-04 LS-95): result is T's
// type (T_NONE for `E!void`) and bits 16 to 23 of flags the underlying type of E
// (func_etag). The C function takes the error tag's address after the result's.
export const I32 FN_ERRU = 16384;
// The function's effect class is `observe` (SPEC-03 H-2, H-7): its body prints, or calls a
// function that does. back_c.mark_effects sets it after lowering; every other function is
// `pure`, since cintc has no `extern` (H-1).
export const I32 FN_OBSERVES = 32768;
// A function that charges its local arrays to the frame arena (SO_FRAME; frame_proof).
export const I32 FN_FRAME = 16777216;

export I32 func_etag(in SirFunc[_] funcs, I64 k) {
    return (funcs[k].flags >> 16) & 255;
}

// The name of a field slot of an imported struct: its bytes text[at, at + nb), copied from
// its declaration-table row, as -2 - (at * 256 + nb); nb is at most 255 (CINTC-16).
export const I64 NAME_TEXT_MAX = 8388607;

export I64 name_at(in scan.Token[_] toks, I64 name) {
    if (name < -1) {
        return (-2 - name) / 256;
    }
    return toks[name].start as I64;
}

export I64 name_len(in scan.Token[_] toks, I64 name) {
    if (name < -1) {
        return (-2 - name) % 256;
    }
    return toks[name].len as I64;
}

// The C9102 identifiers (detail[0]): what lowering does not cover yet, and the task that
// adds it (plan section 3).
export const I64 C_UNSUPPORTED = 9102;
export const I64 U_STRUCT = 1;
export const I64 U_IMPORT = 2;
export const I64 U_VIEW = 3;
export const I64 U_MODULE_STATE = 4;
export const I64 U_TYPE = 5;
export const I64 U_STATEMENT = 6;
export const I64 U_EXPRESSION = 7;
export const I64 U_OPERATOR = 8;
export const I64 U_LITERAL = 9;
export const I64 U_CALL = 10;
export const I64 U_HOLE = 11;
export const I64 U_ITEM = 12;
export const I64 U_CASE_ITEM = 13;
export const I64 U_STEP = 14;
export const I64 U_NAME = 15;
export const I64 U_DECLARATION = 16;
export const I64 U_OBSERVERS = 17;
// 18, U_MODULE_ORDER, is retired (decision 27, item 3; compiler/OPEN.md CINTC-OQ-40).
// Box 12: an arena, a pool or a handle where B1 does not lower one (compiler/OPEN.md CINTC-OQ-64).
export const I64 U_MEMORY = 19;

// Frame kinds.
const I32 K_LIST = 1;
const I32 K_IF = 2;
const I32 K_WHILE = 3;
const I32 K_FOR = 4;
const I32 K_RANGE = 5;
const I32 K_SWITCH = 6;
const I32 K_EXPR = 7;
const I32 K_VALUE = 8;
// Box 12. K_WIDEN: a value of a set converted to the set its context gives (SEM_WIDEN). K_DEFER:
// a `defer` or `errdefer` (want 1) of the statement list whose frame is above it, a its
// SO_BLOCK; a list's frame moves up one each time it meets one, and b counts them. The K_DEFER
// frames of one list are a group, whose first frame holds b the exit code slot, c the returned
// value's slot, d the error tag's slot (each -1 until an exit needs it) and e the DX_* marks.
// K_UNWIND: the end of a group's list (defer_end_step). K_TRY and K_CATCH: a statement whose
// expression is `try` or a `catch` with a block. Kind 12 is retired with lemma S.
const I32 K_WIDEN = 9;
const I32 K_DEFER = 10;
const I32 K_UNWIND = 11;
const I32 K_TRY = 13;
const I32 K_CATCH = 14;
// The marks of a group (frame e of its first K_DEFER frame): it ends a `return` (DX_RETURN)
// or an error's return (DX_ERROR) that passes it, it passes an exit on to the next group out
// (DX_PASS), and an error passes it (DX_ERRED: its errdefers are lowered). A loop or switch
// frame that an exit leaves holds in d (`break`) or c (`continue`) the SO_BLOCK of the first
// frame of the group that ends that exit.
const I32 DX_RETURN = 1;
const I32 DX_ERROR = 2;
const I32 DX_PASS = 4;
const I32 DX_ERRED = 8;

// The context of an element place on the view path (index_step): its offset, not its load.
const I32 W_ELEMENT = -2;

// The manifest rows (CINTC-14) of lowering's per-module tables for a module of n source
// bytes: rows k to k + 2 are the SIR nodes, the functions, and the slots, sized by
// limits.capacity, with the record ids the caller's program gives them. Row k + 3, which
// held the lowering stack, keeps the caller's capacity 0: the stack is in the frame region
// (KR-03).
export void plan_lower[t](inout limits.TablePlan[t] rows, I64 k, I64 n, U32 sir_record, U32 func_record,
        U32 slot_record) {
    limits.plan_row(rows, k, SIR_BYTES, limits.TAG_RECORD, sir_record, limits.capacity(limits.LIM_SIR, n),
        limits.SCOPE_MODULE);
    limits.plan_row(rows, k + 1, FUNC_BYTES, limits.TAG_RECORD, func_record,
        limits.capacity(limits.LIM_FUNCTIONS, n) + 1, limits.SCOPE_MODULE);
    limits.plan_row(rows, k + 2, SLOT_BYTES, limits.TAG_RECORD, slot_record, limits.capacity(limits.LIM_SYMBOLS, n),
        limits.SCOPE_MODULE);
}

// ---------------------------------------------------------------- types

export Bool is_int(I32 ty) {
    return (ty >= T_I8 && ty <= T_I64) || (ty >= T_U8 && ty <= T_U64);
}

export Bool is_signed(I32 ty) {
    return ty >= T_I8 && ty <= T_I64;
}

// The type of identifier class `cls` (scan.IDC_*), or 0 when lowering has no such type.
I32 class_type(I32 cls) {
    switch (cls) {
        case scan.IDC_I8: return T_I8;
        case scan.IDC_I16: return T_I16;
        case scan.IDC_I32: return T_I32;
        case scan.IDC_I64: return T_I64;
        case scan.IDC_U8: return T_U8;
        case scan.IDC_U16: return T_U16;
        case scan.IDC_U32: return T_U32;
        case scan.IDC_U64: return T_U64;
        case scan.IDC_BOOL: return T_BOOL;
        default: return T_NONE;
    }
}

// The type that N_TYPE node `tn` names: a scalar type with no shape; 0 otherwise.
export I32 type_of[t, m](in scan.Token[t] toks, in parse.Node[m] nodes, I64 tn) {
    if (tn < 0 || nodes[tn].kind != parse.N_TYPE || nodes[tn].a >= 0 || nodes[tn].b >= 0 || nodes[tn].op != 1) {
        return T_NONE;
    }
    I64 tk = nodes[tn].tok as I64;
    if (toks[tk].kind != scan.TK_IDENT) {
        return T_NONE;
    }
    return class_type(toks[tk].aux & 255);
}

// Box 12: the lowering type of checked type ty when it is an error set, its underlying type;
// ty itself when it is any other scalar type (fold.ci tags equal the T_* tags); T_NONE
// otherwise.
export I32 set_type(I64 ty) {
    if (resolve.is_errset(ty)) {
        return resolve.errset_under(ty) as I32;
    }
    return T_NONE;
}

// The element type of array type ty as its slots hold it: a scalar's tag, an error set's
// underlying type (box 12), or a struct type.
I64 slot_elem(I64 ty) {
    I64 e = resolve.array_elem(ty);
    if (resolve.is_errset(e)) {
        return resolve.errset_under(e);
    }
    return e;
}

I32 scalar_type(I64 ty) {
    if (resolve.is_errset(ty)) {
        return resolve.errset_under(ty) as I32;
    }
    if (ty == fold.TY_BOOL || (ty >= fold.TY_I8 && ty <= fold.TY_I64) || (ty >= fold.TY_U8 && ty <= fold.TY_U64)) {
        return ty as I32;
    }
    return T_NONE;
}

// The type that N_TYPE node tn of declaration node x names: type_of's, or the underlying type
// of the error set that the checker gave x (box 12).
I32 decl_type[t, m](in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, I64 tn, I64 x) {
    I32 ty = type_of(toks, nodes, tn);
    if (ty == T_NONE && x >= 0) {
        ty = set_type(sem[x].ty);
        if (resolve.is_handle(sem[x].ty)) {
            ty = T_HANDLE;
        }
    }
    return ty;
}

// ---------------------------------------------------------------- box 12 memory

// Whether slot k is an arena or a pool (SO_MEMBER's container).
export Bool is_container(in SirSlot[_] slots, I64 k) {
    return slots[k].kind >= SK_ARENA_M && slots[k].kind <= SK_POOL_R;
}

export Bool is_arena(in SirSlot[_] slots, I64 k) {
    return slots[k].kind == SK_ARENA_M || slots[k].kind == SK_ARENA_R;
}

// Whether view slot k of a table of nslot slots carries a lease (SO_MVIEW).
export Bool leased(in SirSlot[_] slots, I64 nslot, I64 k) {
    return k >= 0 && k + 1 < nslot && slots[k + 1].kind == SK_LEASE;
}

// The identifier of module-level container slot k: its order among the module's arenas, or
// among its pools, from 1 (SPEC-03 M-13).
export I64 container_id(in SirSlot[_] slots, I64 k) {
    I64 id = 0;
    for j in 0..k + 1 {
        if (slots[j].kind == slots[k].kind) {
            id += 1;
        }
    }
    return id;
}

// The slot type of the element of memory type ty: a scalar's tag or a struct type; T_NONE
// otherwise.
I32 mem_slot_elem[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirSlot[_] slots,
        in LState[_] ls, I64 tn, I64 ty) {
    I64 e = resolve.mem_elem(ty);
    if (resolve.is_errset(e)) {
        return resolve.errset_under(e) as I32;
    }
    if (resolve.is_struct(e)) {
        return struct_type_of(text, toks, nodes, slots, ls, nodes[tn].b as I64);
    }
    return scalar_type(e);
}

// ---------------------------------------------------------------- arrays

// Task 2.13 part (b): a local array of a scalar element type (SPEC-04 LS-62 to LS-67) is
// a slot of kind SK_ARRAY whose ty is the element type plus 256 times the extent; it is
// zero-filled where it is declared, and indexed by SO_ICHECK then SO_ELOAD or SO_ESTORE.
export I32 array_elem(I32 ty) {
    if (ty >= T_STRUCT) {
        return T_STRUCT + ((ty & 1073741823) - T_STRUCT) % SARRAY_STEP;
    }
    return ty & 255;
}

export I64 array_extent(I32 ty) {
    if (ty >= T_STRUCT) {
        I64 e = (((ty & 1073741823) - T_STRUCT) / SARRAY_STEP) as I64;
        if (e >= SVIEW_SIZE && e < VIEW_ANY as I64) {
            return (VIEW_SIZE as I64) + e - SVIEW_SIZE;
        }
        return e;
    }
    return ((ty & 268435455) >> 8) as I64;
}

// Distinguishes fixed array fields from scalar fields and unshaped records.
export Bool field_array(I32 ty) {
    return ty > 255 && (ty < T_STRUCT || ty >= FIELD_RECORD_ARRAY);
}

// Marks record-array fields separately so a plain record slot above 8191 stays plain.
export const I32 FIELD_RECORD_ARRAY = 1073741824;
// Retains scalar field-array identity even when its extent is zero.
export const I32 FIELD_SCALAR_ARRAY = 268435456;

// Task 2.14: an array or a view of struct elements (SPEC-04 4.3, LS-119) is an SK_ARRAY or
// SK_VIEW slot whose ty is T_STRUCT plus the struct's SK_SDECL slot s plus SARRAY_STEP
// times its extent field e, the field a scalar element's slot type holds above its 8 bits,
// with VIEW_SIZE + j held as SVIEW_SIZE + j; array_elem and array_extent decode it. A
// struct whose SK_SDECL slot is SARRAY_STEP or later, or a size parameter past the 5,535th,
// is C9102 (U_VIEW).
export const I32 SARRAY_STEP = 8192;
const I64 SVIEW_SIZE = 60000;

// The slot type of an array or view of struct type sty whose extent field is code, or T_NONE.
I32 struct_shaped(I32 sty, I64 code) {
    I64 s = (sty - T_STRUCT) as I64;
    I64 e = code;
    if (code >= VIEW_SIZE as I64) {
        e = SVIEW_SIZE + code - (VIEW_SIZE as I64);
        if (e >= VIEW_ANY as I64) {
            return T_NONE;
        }
    } else if (code != VIEW_ANY as I64 && code >= SVIEW_SIZE) {
        return T_NONE;
    }
    if (s < 0 || s >= SARRAY_STEP as I64) {
        return T_NONE;
    }
    return T_STRUCT + (s as I32) + SARRAY_STEP * (e as I32);
}

// The checked size, saturated above the local-array bound (EMIT-30), is retained
// in the first field's otherwise unused live value. Records here are nonempty.
I64 struct_bytes(in SirSlot[_] slots, I32 sty) {
    return slots[(sty - T_STRUCT) as I64 + 1].live as I64;
}

// The slot type of type node tn, `S[k]` with S a local or imported struct: a local array's when
// f < 0 (k a decimal literal, at most 4,096 bytes of elements, EMIT-30), else a view
// parameter's of function node f (k a literal, `_`, or a size parameter); T_NONE otherwise.
I32 struct_shape_of[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirSlot[_] slots,
        in LState[_] ls, I64 tn, I64 f, I64 checked_extent) {
    if (tn < 0 || nodes[tn].kind != parse.N_TYPE || nodes[tn].a < 0 || nodes[tn].b >= 0 ||
            (nodes[tn].op != 1 && nodes[tn].op != 2)) {
        return T_NONE;
    }
    I64 tk = nodes[tn].tok as I64;
    if (toks[tk].kind != scan.TK_IDENT || !scan.ordinary_name_class(toks[tk].aux & 255)) {
        return T_NONE;
    }
    I32 sty = T_NONE;
    if (nodes[tn].op == 2) {
        sty = import_struct(text, toks, slots, ls, canon_alias(text, toks, nodes, ls, nodes[tn].start as I64), tk);
    } else {
        I64 k = 0;
        while (k < ls[0].nslot && (slots[k].kind == SK_SDECL || slots[k].kind == SK_FIELD)) {
            if (slots[k].kind == SK_SDECL && slots[k].live == 1 && same_name(text, toks, slots[k].name as I64, tk)) {
                sty = T_STRUCT + (k as I32);
            }
            k += 1;
        }
    }
    I64 e = nodes[nodes[tn].a as I64].a as I64;
    if (sty == T_NONE || e < 0 || nodes[e].next >= 0) {
        return T_NONE;
    }
    if (checked_extent >= 0) {
        if (f >= 0) { return struct_shaped(sty, checked_extent + 1); }
        if (checked_extent * struct_bytes(slots, sty) > 4096) { return T_NONE; }
        return struct_shaped(sty, checked_extent);
    }
    if (f >= 0 && nodes[e].kind == parse.N_WILD) {
        return struct_shaped(sty, VIEW_ANY as I64);
    }
    I64 et = nodes[e].tok as I64;
    if (f >= 0 && nodes[e].kind == parse.N_NAME) {
        I64 j = 0;
        I64 z = nodes[f].d as I64;
        while (z >= 0) {
            if (same_name(text, toks, nodes[z].tok as I64, et)) {
                return struct_shaped(sty, (VIEW_SIZE as I64) + j);
            }
            j += 1;
            z = nodes[z].next as I64;
        }
        return T_NONE;
    }
    I64 nd = toks[et].len as I64;
    if (nodes[e].kind != parse.N_LIT || toks[et].kind != scan.TK_INT || toks[et].sub != 10 || nd > 4) {
        return T_NONE;
    }
    I64 v = 0;
    I64 s = toks[et].start as I64;
    for i in s..s + nd {
        v = v * 10 + digit_value(text[i]);
    }
    if (f >= 0) {
        return struct_shaped(sty, v + 1);
    }
    if (v * struct_bytes(slots, sty) > 4096) {
        return T_NONE;
    }
    return struct_shaped(sty, v);
}

// The slot type of a view parameter of function node f whose type node is tn, `T[k]`
// with T scalar (SPEC-03 5.2, SPEC-04 LS-117): the element type plus 256 times the extent
// code, k + 1 for a decimal literal k, VIEW_ANY for `_`, VIEW_SIZE + j for size
// parameter j of f; 0 otherwise. Every view type is above 255, so it is also the context
// that marks a view argument.
export const I32 VIEW_SIZE = 65536;
export const I32 VIEW_ANY = 65535;

I32 view_type_of[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, I64 tn, I64 f) {
    if (tn < 0 || nodes[tn].kind != parse.N_TYPE || nodes[tn].a < 0 || nodes[tn].b >= 0 || nodes[tn].op != 1) {
        return T_NONE;
    }
    I64 tk = nodes[tn].tok as I64;
    if (toks[tk].kind != scan.TK_IDENT) {
        return T_NONE;
    }
    I32 elem = class_type(toks[tk].aux & 255);
    I64 e = nodes[nodes[tn].a as I64].a as I64;
    if (elem == T_NONE || e < 0 || nodes[e].next >= 0) {
        return T_NONE;
    }
    if (nodes[e].kind == parse.N_WILD) {
        return elem | (VIEW_ANY << 8);
    }
    I64 et = nodes[e].tok as I64;
    if (nodes[e].kind == parse.N_NAME) {
        I64 j = 0;
        I64 z = nodes[f].d as I64;
        while (z >= 0) {
            if (same_name(text, toks, nodes[z].tok as I64, et)) {
                return elem | ((VIEW_SIZE + (j as I32)) << 8);
            }
            j += 1;
            z = nodes[z].next as I64;
        }
        return T_NONE;
    }
    I64 nd = toks[et].len as I64;
    if (nodes[e].kind != parse.N_LIT || toks[et].kind != scan.TK_INT || toks[et].sub != 10 || nd > 4) {
        return T_NONE;
    }
    I64 v = 0;
    I64 s = toks[et].start as I64;
    for i in s..s + nd {
        v = v * 10 + digit_value(text[i]);
    }
    return elem | (((v + 1) as I32) << 8);
}

// The static extent of array or view slot k, or -1 when it is known at run time.
export I64 slot_extent(in SirSlot[_] slots, I64 k) {
    if (slots[k].kind == SK_NVIEW) {
        return -1;
    }
    if (slots[k].kind == SK_ARRAY || slots[k].kind == SK_APLACE) {
        return array_extent(slots[k].ty);
    }
    I64 c = array_extent(slots[k].ty);
    if (c >= VIEW_ANY as I64) {
        return -1;
    }
    return c - 1;
}

// The number of size parameters of function fn.
export I64 size_count(in parse.Node[_] nodes, in SirFunc[_] funcs, I64 fn) {
    if ((funcs[fn].flags & FN_IMPORT) != 0) {
        // An import row: its declaration-table record's size-parameter count, kept in ntemp.
        return funcs[fn].ntemp as I64;
    }
    I64 c = 0;
    I64 z = nodes[funcs[fn].node as I64].d as I64;
    while (z >= 0) {
        c += 1;
        z = nodes[z].next as I64;
    }
    return c;
}

// The number of the k view parameters from slot p0 whose extent code is c.
I64 code_count(in SirSlot[_] slots, I64 p0, I64 k, I64 c) {
    I64 m = 0;
    for j in 0..k {
        if (slots[p0 + j].kind == SK_VIEW && array_extent(slots[p0 + j].ty) == c) {
            m += 1;
        }
    }
    return m;
}

// Whether slot k holds a struct (a variable or a parameter).
export Bool is_struct_slot(in SirSlot[_] slots, I64 k) {
    return slots[k].kind == SK_STRUCT || slots[k].kind == SK_SPARAM || slots[k].kind == SK_SREF || slots[k].kind == SK_SPLACE;
}

// The struct type that the type node tn names, or T_NONE.
I32 struct_type_of[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirSlot[_] slots,
        in LState[_] ls, I64 tn) {
    if (tn >= 0 && nodes[tn].kind == parse.N_TYPE && nodes[tn].a < 0 && nodes[tn].b < 0 && nodes[tn].op == 2) {
        return import_struct(text, toks, slots, ls, canon_alias(text, toks, nodes, ls, nodes[tn].start as I64),
            nodes[tn].tok as I64);
    }
    if (tn < 0 || nodes[tn].kind != parse.N_TYPE || nodes[tn].a >= 0 || nodes[tn].b >= 0 || nodes[tn].op != 1) {
        return T_NONE;
    }
    I64 tk = nodes[tn].tok as I64;
    if (toks[tk].kind != scan.TK_IDENT || !scan.ordinary_name_class(toks[tk].aux & 255)) {
        return T_NONE;
    }
    I64 k = 0;
    while (k < ls[0].nslot && (slots[k].kind == SK_SDECL || slots[k].kind == SK_FIELD)) {
        if (slots[k].kind == SK_SDECL && slots[k].live == 1 && same_name(text, toks, slots[k].name as I64, tk)) {
            return T_STRUCT + (k as I32);
        }
        k += 1;
    }
    return T_NONE;
}

// Task 2.14: the alias token of the first import of the module that alias token al names,
// so that two aliases of one module (`as`, SPEC-04 LS-225) name one imported struct, which
// the importer's C defines once; al when no import binds it.
I64 canon_alias[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in LState[_] ls, I64 al) {
    I64 mod = -1;
    I64 x = nodes[ls[0].root].a as I64;
    while (x >= 0 && mod < 0) {
        if (nodes[x].kind == parse.N_IMPORT && nodes[x].b >= 0 && same_name(text, toks, nodes[x].b as I64, al)) {
            mod = nodes[x].e as I64;
        }
        x = nodes[x].next as I64;
    }
    x = nodes[ls[0].root].a as I64;
    while (x >= 0 && mod >= 0) {
        if (nodes[x].kind == parse.N_IMPORT && nodes[x].b >= 0 && (nodes[x].e as I64) == mod) {
            return nodes[x].b as I64;
        }
        x = nodes[x].next as I64;
    }
    return al;
}

// The imported struct `al.tk` (alias token al, name token tk), or T_NONE.
I32 import_struct[n, t](in U8[n] text, in scan.Token[t] toks, in SirSlot[_] slots, in LState[_] ls, I64 al, I64 tk) {
    I64 k = 0;
    while (k < ls[0].nslot && (slots[k].kind == SK_SDECL || slots[k].kind == SK_FIELD)) {
        if (slots[k].kind == SK_SDECL && slots[k].live >= 2 && same_name(text, toks, slots[k].name as I64, tk) &&
                same_name(text, toks, (slots[k].live - 2) as I64, al)) {
            return T_STRUCT + (k as I32);
        }
        k += 1;
    }
    return T_NONE;
}

// The number of the field of struct type ty that token tk names, or -1.
I64 field_index[n, t](in U8[n] text, in scan.Token[t] toks, in SirSlot[_] slots, I32 ty, I64 tk) {
    I64 s = (ty - T_STRUCT) as I64;
    I64 nb = toks[tk].len as I64;
    I64 sb = toks[tk].start as I64;
    for j in 0..slots[s].ty as I64 {
        I64 nm = slots[s + 1 + j].name as I64;
        if (name_len(toks, nm) == nb) {
            I64 sa = name_at(toks, nm);
            Bool same = true;
            for i in 0..nb {
                if (text[sa + i] != text[sb + i]) {
                    same = false;
                }
            }
            if (same) {
                return j;
            }
        }
    }
    return -1;
}

// Declares the imported structs that module-level node set 0..nn names (an `alias.S` type
// or constructor the checker resolved, resolve.SEM_IMPORT): an SK_SDECL slot per distinct
// `alias.S` and an SK_FIELD slot per field row, each field's name copied into `text`.
// The copied name encoding is shared by imported records and their fields.
I64 copy_decl_name[n](inout U8[n] text, in limits.Decl[_] d, I64 row,
        in scan.Token[_] toks, inout limits.CompilerDiag[_] diag, inout LState[_] ls, I64 tk) {
    I64 nb = d[row].name_len as I64;
    I64 at = ls[0].textn;
    if (at + nb > NAME_TEXT_MAX || at + nb > n) {
        stop_at(toks, diag, ls, limits.C_LIMIT, tk, limits.LIM_SOURCE, n);
        return -1;
    }
    for i in 0..nb { text[at + i] = d[row + i / 32].name[i % 32]; }
    ls[0].textn = at + nb;
    return -2 - (at * 256 + nb);
}

I64 import_record(inout U8[_] text, in scan.Token[_] toks, inout limits.Decl[_] d,
        inout SirSlot[_] slots, inout limits.CompilerDiag[_] diag, inout LState[_] ls,
        I64 row, I64 nm, I64 alias, I64 tk) {
    I64 sk = add_slot(toks, slots, diag, ls, nm, 0, SK_SDECL, tk);
    if (sk < 0) { return -1; }
    slots[sk].live = alias as I32;
    d[row].mode = 1;
    d[row].ref = (sk + 1) as U32;
    I64 r = decl.next_member(d, row);
    for j in 0..d[row].a {
        I32 fty = d[r].tag as I32;
        if (d[r].tag == 0x71) {
            fty = (-1 - (d[r].ref as I64)) as I32;
        } else if (d[r].rank == 1 && d[r].ext_kind == limits.DX_LITERAL && d[r].b >= 0) {
            fty = fty | ((d[r].b as I32) << 8);
            if (d[r].b == 0) { fty = fty | FIELD_SCALAR_ARRAY; }
        } else if (d[r].rank != 0) {
            unsupported(toks, diag, ls, tk, U_STRUCT);
            return -1;
        }
        I64 name = copy_decl_name(text, d, r, toks, diag, ls, tk);
        if (name == -1) { return -1; }
        I64 fs = add_slot(toks, slots, diag, ls, name, fty, SK_FIELD, tk);
        if (fs < 0) { return -1; }
        if (d[r].tag == 0x71 && d[r].rank == 1) {
            slots[fs].kind = (-1 - d[r].b) as I32;
        }
        slots[sk].ty += 1;
        r = decl.next_member(d, r);
    }
    if (slots[sk].ty == 0) {
        unsupported(toks, diag, ls, tk, U_STRUCT);
        return -1;
    }
    // Retains enough of the checked layout to enforce the local-array byte bound.
    I64 nbyte = d[row].b;
    if (nbyte > 4096) { nbyte = 4097; }
    slots[sk + 1].live = nbyte as I32;
    return sk;
}

void declare_import_structs[tn, t, m, dr](inout U8[tn] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, I64 nn, inout limits.Decl[_] decls, inout SirSlot[_] slots,
        inout limits.CompilerDiag[dr] diag, inout LState[_] ls) {
    for x in 0..nn {
        if (ls[0].err != 0) { break; }
        I64 al = -1;
        if ((sem[x].flags & resolve.SEM_IMPORT) != 0 && nodes[x].kind == parse.N_TYPE) {
            al = nodes[x].start as I64;
        } else if ((sem[x].flags & resolve.SEM_IMPORT) != 0 && nodes[x].kind == parse.N_FIELD &&
                decls[sem[x].lit_at].kind == limits.DK_STRUCT) {
            al = nodes[nodes[x].a as I64].tok as I64;
        }
        if (al >= 0) { al = canon_alias(text, toks, nodes, ls, al); }
        I64 tk = nodes[x].tok as I64;
        if (al >= 0 && import_struct(text, toks, slots, ls, al, tk) == T_NONE) {
            _ = import_record(text, toks, decls, slots, diag, ls, sem[x].lit_at, tk, 2 + al, tk);
        }
    }
    // Materializes records used only by imported signatures, including private
    // result types passed directly to another imported call. Their identity is the row.
    for x in 0..nn {
        if (ls[0].err != 0) { break; }
        if (nodes[x].kind != parse.N_FIELD || (sem[x].flags & resolve.SEM_IMPORT) == 0) { continue; }
        I64 fn = sem[x].lit_at;
        if (decls[fn].kind != limits.DK_FUNC) { continue; }
        I64 p = fn;
        I64 tk = nodes[x].tok as I64;
        for j in 0..decls[fn].a + 1 {
            if (decls[p].tag == 0x71) {
                I64 row = decls[p].ref as I64;
                if (decls[row].mode == 0) {
                    I64 name = copy_decl_name(text, decls, row, toks, diag, ls, tk);
                    if (name == -1) { break; }
                    if (import_record(text, toks, decls, slots, diag, ls, row, name, -2 - row, tk) < 0) { break; }
                }
            }
            p = decl.next_member(decls, p);
        }
    }
    I64 sk = 0;
    while (sk < ls[0].nslot && ls[0].err == 0) {
        for j in 0..slots[sk].ty as I64 {
            I64 fs = sk + 1 + j;
            if (slots[fs].ty < 0) {
                I64 row = -1 - (slots[fs].ty as I64);
                if (decls[row].mode == 0) {
                    I64 name = copy_decl_name(text, decls, row, toks, diag, ls, 0);
                    if (name == -1) { break; }
                    if (import_record(text, toks, decls, slots, diag, ls, row, name, -2 - row, 0) < 0) { break; }
                }
                I32 ty = T_STRUCT + ((decls[row].ref as I64) - 1) as I32;
                if (slots[fs].kind < 0) {
                    ty = struct_shaped(ty, -1 - (slots[fs].kind as I64));
                    slots[fs].kind = SK_FIELD;
                    if (ty == T_NONE) { unsupported(toks, diag, ls, 0, U_STRUCT); break; }
                    ty = ty | FIELD_RECORD_ARRAY;
                }
                slots[fs].ty = ty;
            }
        }
        sk += 1 + (slots[sk].ty as I64);
    }
    // Record refs and modes remain canonical outside this materialization pass.
    for r in 1..decls[0].a {
        if (decls[r].kind == limits.DK_STRUCT && decls[r].mode == 1) {
            decls[r].ref = r as U32;
            decls[r].mode = 0;
        }
    }
}

// The type of field j of struct type ty.
export I32 field_type(in SirSlot[_] slots, I32 ty, I64 j) {
    return slots[((ty - T_STRUCT) as I64) + 1 + j].ty;
}

// The struct slot that the base of field node x names, or -1 with C9102.
I64 struct_base[n, t, m, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirFunc[_] funcs,
        in SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 base = nodes[x].a as I64;
    if (nodes[base].kind == parse.N_NAME) {
        I64 k = find_slot(text, toks, funcs, slots, ls, nodes[base].tok as I64);
        if (k >= 0 && is_struct_slot(slots, k)) {
            return k;
        }
    }
    unsupported(toks, diag, ls, nodes[x].tok as I64, U_STRUCT);
    return -1;
}

// Declares the struct of node x: its SK_SDECL slot and one SK_FIELD slot per field.
void declare_struct[n, t, m, nl, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout SirSlot[nl] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 s = add_slot(toks, slots, diag, ls, nodes[x].tok as I64, 0, SK_SDECL, nodes[x].tok as I64);
    if (s < 0) {
        return;
    }
    I64 fd = nodes[x].a as I64;
    while (fd >= 0 && ls[0].err == 0) {
        I32 ty = decl_type(toks, nodes, sem, nodes[fd].a as I64, fd);
        if (ty == T_NONE) {
            // A field of a scalar array type (task 2.14; SPEC-04 LS-67, LS-73), or of an
            // array of an error set (box 12).
            I64 aty = sem[fd].ty;
            if (resolve.is_array(aty) && !resolve.is_struct(resolve.array_elem(aty)) &&
                    !resolve.is_mem(resolve.array_elem(aty))) {
                I64 nitems = resolve.array_extent(aty);
                I64 elem = resolve.array_elem(aty);
                if (resolve.is_errset(elem)) {
                    elem = resolve.errset_under(elem);
                }
                I64 bytes = 1;
                if (elem != fold.TY_BOOL) { bytes = fold.ty_width(elem) / 8; }
                if (nitems >= 0 && nitems * bytes <= 4096) {
                    ty = (elem as I32) | ((nitems as I32) << 8);
                    if (nitems == 0) { ty = ty | FIELD_SCALAR_ARRAY; }
                }
            }
        }
        if (ty == T_NONE) {
            // A field of an imported struct type (task 2.14; declare_import_structs ran first).
            I64 ftn = nodes[fd].a as I64;
            if (nodes[ftn].kind == parse.N_TYPE) {
                ty = struct_type_of(text, toks, nodes, slots, ls, ftn);
            }
        }
        _ = add_slot(toks, slots, diag, ls, nodes[fd].tok as I64, ty, SK_FIELD, nodes[fd].tok as I64);
        slots[s].ty += 1;
        fd = nodes[fd].next as I64;
    }
    if (slots[s].ty == 0) {
        // C17 has no struct without members (SEED-OQ-03's refusal, kept here).
        unsupported(toks, diag, ls, nodes[x].tok as I64, U_STRUCT);
    }
}

// The slot type of the array type node tn, `T[k]` with T scalar and k a decimal literal
// of at most 4,096 bytes of elements (EMIT-30); 0 otherwise.
I32 array_type_of[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, I64 tn) {
    if (tn < 0 || nodes[tn].kind != parse.N_TYPE || nodes[tn].a < 0 || nodes[tn].b >= 0 || nodes[tn].op != 1) {
        return T_NONE;
    }
    I64 tk = nodes[tn].tok as I64;
    if (toks[tk].kind != scan.TK_IDENT) {
        return T_NONE;
    }
    I32 elem = class_type(toks[tk].aux & 255);
    I64 e = nodes[nodes[tn].a as I64].a as I64;
    if (elem == T_NONE || e < 0 || nodes[e].next >= 0 || nodes[e].kind != parse.N_LIT) {
        return T_NONE;
    }
    I64 et = nodes[e].tok as I64;
    I64 nd = toks[et].len as I64;
    if (toks[et].kind != scan.TK_INT || toks[et].sub != 10 || nd > 4) {
        return T_NONE;
    }
    I64 v = 0;
    I64 s = toks[et].start as I64;
    for i in s..s + nd {
        v = v * 10 + digit_value(text[i]);
    }
    I64 bytes = 1;
    if (elem != T_BOOL) {
        bytes = fold.ty_width(elem as I64) / 8;
    }
    if (v * bytes > 4096) {
        return T_NONE;
    }
    return elem | ((v as I32) << 8);
}

// ---------------------------------------------------------------- names and literals

// Whether tokens a and b spell the same name.
export Bool same_name[n, t](in U8[n] text, in scan.Token[t] toks, I64 a, I64 b) {
    I64 nbytes = toks[a].len as I64;
    if (nbytes != toks[b].len as I64) {
        return false;
    }
    I64 sa = toks[a].start as I64;
    I64 sb = toks[b].start as I64;
    for i in 0..nbytes {
        if (text[sa + i] != text[sb + i]) {
            return false;
        }
    }
    return true;
}

// Whether token tk spells `word`.
export Bool spells[n, t, w](in U8[n] text, in scan.Token[t] toks, I64 tk, in U8[w] word) {
    if (toks[tk].len as I64 != w) {
        return false;
    }
    I64 s = toks[tk].start as I64;
    for i in 0..w {
        if (text[s + i] != word[i]) {
            return false;
        }
    }
    return true;
}

// The value of a digit, or 99.
I64 digit_value(U8 c) {
    switch (c) {
        case '0'..='9': return (c - '0') as I64;
        case 'a'..='f': return (c - 'a') as I64 + 10;
        case 'A'..='F': return (c - 'A') as I64 + 10;
        default: return 99;
    }
}

// The value of integer or character literal token tk modulo 2^64 (the checker has checked
// its range; `as%` of a wider literal keeps the low bits, SPEC-01 IM-26). res[0] is the
// value; the result is false for a literal lowering does not read (a fraction).
export Bool literal_value[n, t](in U8[n] text, in scan.Token[t] toks, I64 tk, inout I64[_] res) {
    if (toks[tk].kind == scan.TK_CHAR) {
        res[0] = toks[tk].aux as I64;
        return true;
    }
    I64 radix = toks[tk].sub as I64;
    if (toks[tk].kind != scan.TK_INT || (radix != 10 && radix != 16 && radix != 8 && radix != 2 && radix != 3)) {
        return false;
    }
    I64 s = toks[tk].start as I64;
    I64 e = s + (toks[tk].len as I64);
    if (radix != 10) {
        s += 2;
    }
    U64 v = 0;
    U64 r = radix as U64;
    for i in s..e {
        if (radix == 3) {
            // Balanced ternary (SPEC-04 LS-30): N is -1, so the low 64 bits wrap.
            if (text[i] == 'P') {
                v = v *% 3 +% 1;
            } else if (text[i] == 'N') {
                v = v *% 3 -% 1;
            } else if (text[i] == '0') {
                v = v *% 3;
            }
        } else {
            I64 d = digit_value(text[i]);
            if (d < radix) {
                v = v *% r +% (d as U64);
            }
        }
    }
    res[0] = v as% I64;
    return true;
}

// v as a value of type ty: its low w bits, sign-extended for a signed type.
I64 wrap_to(I32 ty, I64 v) {
    if (ty == T_BOOL) {
        return v & 1;
    }
    return fold.ty_wrap(ty as I64, v as% U64) as% I64;
}

// The value of type property x, `T.min` or `T.max` of an integer type T (SPEC-04 LS-21):
// res[0] its bits, res[1] its type; res[1] 0 for another property.
void type_property[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, I64 x, inout I64[_] res) {
    res[1] = 0;
    I64 tk = nodes[x].tok as I64;
    I32 ty = T_NONE;
    if (toks[tk].kind == scan.TK_IDENT) {
        ty = class_type(toks[tk].aux & 255);
    }
    if (!is_int(ty)) {
        return;
    }
    I64 w = (fold.ty_width(ty as I64));
    U64 mask = 18446744073709551615;
    if (w < 64) {
        mask = ((1 as U64) << w) - 1;
    }
    I64 pt = nodes[x].c as I64;
    if (spells(text, toks, pt, "max")) {
        if (is_signed(ty)) {
            res[0] = (mask >> 1) as I64;
        } else {
            res[0] = mask as% I64;
        }
    } else if (spells(text, toks, pt, "min")) {
        if (is_signed(ty)) {
            res[0] = (~(mask >> 1)) as% I64;
        } else {
            res[0] = 0;
        }
    } else {
        return;
    }
    res[1] = ty as I64;
}

// ---------------------------------------------------------------- diagnostics and rows

void stop_at[t, r](in scan.Token[t] toks, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 code,
        I64 tk, I64 d0, I64 d1) {
    if (ls[0].err == 0) {
        ls[0].err = code;
        I64 line = 1;
        I64 col = 1;
        if (tk >= 0) {
            line = toks[tk].line as I64;
            col = toks[tk].col as I64;
        }
        _ = limits.diag_add(diag, code, ls[0].module, line, col, d0, d1);
    }
}

// C9102 at token tk: lowering does not cover `what` yet.
void unsupported[t, r](in scan.Token[t] toks, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 tk,
        I64 what) {
    stop_at(toks, diag, ls, C_UNSUPPORTED, tk, what, 0);
}

// A new node at token tk; -1 with C9001 when the table is full.
I64 add_sir[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I32 op, I32 ty, I64 tk) {
    I64 i = ls[0].nsir;
    if (ls[0].err != 0) {
        return -1;
    }
    if (i == ns) {
        stop_at(toks, diag, ls, limits.C_LIMIT, tk, limits.LIM_SIR, ns);
        return -1;
    }
    ls[0].nsir = i + 1;
    sir[i].op = op;
    sir[i].ty = ty;
    sir[i].dst = -1;
    sir[i].a = -1;
    sir[i].b = -1;
    sir[i].c = 0;
    sir[i].site = 0;
    sir[i].tok = tk as I32;
    sir[i].e = 0;
    sir[i].f = 0;
    sir[i].val = 0;
    return i;
}

// A new node that defines the next temporary.
I64 def_sir[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I32 op, I32 ty, I64 tk) {
    I64 i = add_sir(toks, sir, diag, ls, op, ty, tk);
    if (i >= 0) {
        sir[i].dst = ls[0].temps as I32;
        ls[0].temps += 1;
    }
    return i;
}

// Gives node i the next site ordinal of the module.
void site(inout Sir[_] sir, inout LState[_] ls, I64 i) {
    if (i >= 0) {
        ls[0].sites += 1;
        sir[i].site = ls[0].sites as I32;
    }
}

I64 add_slot[t, nl, r](in scan.Token[t] toks, inout SirSlot[nl] slots, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 name, I32 ty, I32 kind, I64 tk) {
    I64 k = ls[0].nslot;
    if (ls[0].err != 0) {
        return -1;
    }
    if (k == nl) {
        stop_at(toks, diag, ls, limits.C_LIMIT, tk, limits.LIM_SYMBOLS, nl);
        return -1;
    }
    ls[0].nslot = k + 1;
    slots[k].name = name as I32;
    slots[k].ty = ty;
    slots[k].kind = kind;
    slots[k].live = 1;
    return k;
}

// The visible slot that token tk names in the current function, or -1.
I64 find_slot[n, t](in U8[n] text, in scan.Token[t] toks, in SirFunc[_] funcs, in SirSlot[_] slots,
        in LState[_] ls, I64 tk) {
    I64 fn = ls[0].func;
    I64 k = ls[0].nslot - 1;
    while (k >= funcs[fn].lslot0 as I64) {
        if (slots[k].live == 1 && slots[k].name >= 0 && same_name(text, toks, slots[k].name as I64, tk)) {
            return k;
        }
        k -= 1;
    }
    I64 p0 = funcs[fn].pslot0 as I64;
    for p in p0..p0 + (funcs[fn].nparam as I64) {
        if (same_name(text, toks, slots[p].name as I64, tk)) {
            return p;
        }
    }
    for g in 0..ls[0].nslot {
        if ((slots[g].kind == SK_GLOBAL || slots[g].kind == SK_ARENA_M || slots[g].kind == SK_POOL_M) &&
                same_name(text, toks, slots[g].name as I64, tk)) {
            return g;
        }
    }
    return -1;
}

// The import row of `alias.name` (alias token al, name token tk), or -1.
I64 find_import[n, t](in U8[n] text, in scan.Token[t] toks, in SirFunc[_] funcs, in LState[_] ls, I64 al, I64 tk) {
    for k in 0..ls[0].nfunc {
        if ((funcs[k].flags & FN_IMPORT) != 0 && funcs[k].name >= 0 && same_name(text, toks, funcs[k].name as I64, tk) &&
                same_name(text, toks, funcs[k].first as I64, al)) {
            return k;
        }
    }
    return -1;
}

// The function that token tk names, or -1.
I64 find_func[n, t](in U8[n] text, in scan.Token[t] toks, in SirFunc[_] funcs, in LState[_] ls, I64 tk) {
    for k in 0..ls[0].nfunc {
        if (funcs[k].name >= 0 && (funcs[k].flags & FN_IMPORT) == 0 && same_name(text, toks, funcs[k].name as I64, tk)) {
            return k;
        }
    }
    return -1;
}

// The module-level `const` declaration that token tk names, or -1.
I64 find_const[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in LState[_] ls, I64 tk) {
    I64 x = nodes[ls[0].root].a as I64;
    while (x >= 0) {
        if (nodes[x].kind == parse.N_VAR && (nodes[x].flags & parse.F_CONST) != 0 &&
                same_name(text, toks, nodes[x].tok as I64, tk)) {
            return x;
        }
        x = nodes[x].next as I64;
    }
    return -1;
}

// The value of constant expression x when it is a literal, a negative literal, `true` or
// `false`, or a name of a module constant whose initializer is one of these (followed
// through at most 64 names): res[0] the bits, res[1] 1. res[1] 0 otherwise.
void const_value[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in LState[_] ls, I64 x,
        inout I64[_] res) {
    res[1] = 0;
    I64 y = x;
    I64 hops = 0;
    while (y >= 0 && hops < 64) {
        I32 k = nodes[y].kind;
        if (k == parse.N_LIT) {
            if (literal_value(text, toks, nodes[y].tok as I64, res)) {
                res[1] = 1;
            }
            return;
        }
        if (k == parse.N_NEGLIT) {
            if (literal_value(text, toks, nodes[y].c as I64, res)) {
                res[0] = 0 -% res[0];
                res[1] = 1;
            }
            return;
        }
        if (k == parse.N_BOOL) {
            res[0] = nodes[y].op as I64;
            res[1] = 1;
            return;
        }
        if (k == parse.N_TYPEPROP) {
            type_property(text, toks, nodes, y, res);
            if (res[1] != 0) {
                res[1] = 1;
            }
            return;
        }
        if (k != parse.N_NAME) {
            return;
        }
        I64 c = find_const(text, toks, nodes, ls, nodes[y].tok as I64);
        if (c < 0) {
            return;
        }
        y = nodes[c].b as I64;
        hops += 1;
    }
}

// ---------------------------------------------------------------- the stack

I64 push[t, s, r](in scan.Token[t] toks, inout parse.Frame[s] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls,
        I32 kind, I64 node, I32 want, I64 tk) {
    I64 sp = ls[0].sp;
    if (ls[0].err != 0) {
        return -1;
    }
    if (sp == ls[0].cap) {
        stop_at(toks, diag, ls, limits.C_NESTING, tk, limits.LIM_STACK, sp);
        return -1;
    }
    st[sp].kind = kind;
    st[sp].node = node as I32;
    st[sp].state = 0;
    st[sp].want = want;
    st[sp].a = -1;
    st[sp].b = -1;
    st[sp].c = -1;
    st[sp].d = -1;
    st[sp].e = -1;
    st[sp].f = -1;
    st[sp].g = -1;
    st[sp].h = -1;
    ls[0].sp = sp + 1;
    if (sp + 1 > ls[0].max_sp) {
        ls[0].max_sp = sp + 1;
    }
    return sp;
}

void copy_frame(inout parse.Frame[_] st, I64 to, I64 from) {
    st[to].kind = st[from].kind;
    st[to].node = st[from].node;
    st[to].state = st[from].state;
    st[to].want = st[from].want;
    st[to].a = st[from].a;
    st[to].b = st[from].b;
    st[to].c = st[from].c;
    st[to].d = st[from].d;
    st[to].e = st[from].e;
    st[to].f = st[from].f;
    st[to].g = st[from].g;
    st[to].h = st[from].h;
}

// ---------------------------------------------------------------- values

// Sets the value of the expression lowered last and pops its frame.
void give(inout LState[_] ls, I64 v, I32 ty, I64 first, I64 end) {
    ls[0].rv = v;
    ls[0].rty = ty as I64;
    ls[0].rfirst = first;
    ls[0].rend = end;
    ls[0].sp -= 1;
}

// Gives every untyped value of sir[first..end) type ty (a node without a temporary, such
// as a call of a void function, has no type and keeps none).
void settle(inout Sir[_] sir, I64 first, I64 end, I32 ty) {
    for i in first..end {
        if (sir[i].ty == T_NONE && sir[i].dst >= 0) {
            sir[i].ty = ty;
            if ((sir[i].op & OP_MASK) == SO_CONST) {
                sir[i].val = wrap_to(ty, sir[i].val);
            }
        }
    }
}

// The type of operand v of the current function.
export I32 value_type(in Sir[_] sir, in SirFunc[_] funcs, in SirSlot[_] slots, I64 fn, I64 v) {
    if (v >= 0) {
        return sir[v].ty;
    }
    return slots[(funcs[fn].pslot0 as I64) - v - 1].ty;
}

// Saves the last value in frame f (a: value, b: type, c: first node, d: end).
void keep(inout parse.Frame[_] st, in LState[_] ls, I64 f) {
    st[f].a = ls[0].rv as I32;
    st[f].b = ls[0].rty as I32;
    st[f].c = ls[0].rfirst as I32;
    st[f].d = ls[0].rend as I32;
}

// The SO_BIN operation and form of operator `op` (OP_* of a binary or compound
// assignment): res[0] the operation (0 when lowering has none), res[1] the form.
void binary_op(I32 op, inout I64[_] res) {
    res[1] = 0;
    switch (op) {
        case scan.OP_ADD, scan.OP_ADD_ASSIGN: res[0] = B_ADD as I64;
        case scan.OP_SUB, scan.OP_SUB_ASSIGN: res[0] = B_SUB as I64;
        case scan.OP_MUL, scan.OP_MUL_ASSIGN: res[0] = B_MUL as I64;
        case scan.OP_DIV, scan.OP_DIV_ASSIGN: res[0] = B_DIV as I64;
        case scan.OP_REM, scan.OP_REM_ASSIGN: res[0] = B_REM as I64;
        case scan.OP_SHL, scan.OP_SHL_ASSIGN: res[0] = B_SHL as I64;
        case scan.OP_SHR, scan.OP_SHR_ASSIGN: res[0] = B_SHR as I64;
        case scan.OP_BAND, scan.OP_BAND_ASSIGN: res[0] = B_AND as I64;
        case scan.OP_BOR, scan.OP_BOR_ASSIGN: res[0] = B_OR as I64;
        case scan.OP_BXOR, scan.OP_BXOR_ASSIGN: res[0] = B_XOR as I64;
        case scan.OP_ADD_WRAP, scan.OP_ADD_WRAP_ASSIGN: res[0] = B_ADD as I64; res[1] = 1;
        case scan.OP_SUB_WRAP, scan.OP_SUB_WRAP_ASSIGN: res[0] = B_SUB as I64; res[1] = 1;
        case scan.OP_MUL_WRAP, scan.OP_MUL_WRAP_ASSIGN: res[0] = B_MUL as I64; res[1] = 1;
        case scan.OP_SHL_WRAP, scan.OP_SHL_WRAP_ASSIGN: res[0] = B_SHL as I64; res[1] = 1;
        case scan.OP_ADD_SAT, scan.OP_ADD_SAT_ASSIGN: res[0] = B_ADD as I64; res[1] = 2;
        case scan.OP_SUB_SAT, scan.OP_SUB_SAT_ASSIGN: res[0] = B_SUB as I64; res[1] = 2;
        case scan.OP_MUL_SAT, scan.OP_MUL_SAT_ASSIGN: res[0] = B_MUL as I64; res[1] = 2;
        default: res[0] = 0;
    }
}

// Whether SO_BIN operation b in form `form` can fault, so carries a site: every checked
// arithmetic form, division and remainder, and both shift forms (E_SHIFT); a wrapping or
// saturating add, sub or mul never faults.
// The operand type of SO_BUILTIN node i.
export I32 builtin_opty(in Sir[_] sir, I64 i) {
    I32 s = (sir[i].val >> 8) as I32;
    if (s == T_NONE) {
        return sir[i].ty;
    }
    return s;
}

// Whether SO_BUILTIN node i can fault (SPEC-01 9.2).
export Bool builtin_faults(in Sir[_] sir, I64 i) {
    return fold.builtin_faults(sir[i].f as I64);
}

// The number of values of SO_BUILTIN node i, and whether its second is a rotation's count.
export I64 builtin_arity(in Sir[_] sir, I64 i) {
    return fold.builtin_values(sir[i].f as I64);
}

export Bool builtin_rotates(in Sir[_] sir, I64 i) {
    return sir[i].f as I64 == fold.BI_ROTL || sir[i].f as I64 == fold.BI_ROTR;
}

export Bool bin_faults(I32 b, I32 form) {
    if (b == B_AND || b == B_OR || b == B_XOR || form == 3) {
        return false;
    }
    return form == 0 || b == B_SHL || b == B_SHR || b == B_DIV || b == B_REM;
}

I32 compare_op(I32 op) {
    switch (op) {
        case scan.OP_EQ: return CMP_EQ;
        case scan.OP_NE: return CMP_NE;
        case scan.OP_LT: return CMP_LT;
        case scan.OP_LE: return CMP_LE;
        case scan.OP_GT: return CMP_GT;
        default: return CMP_GE;
    }
}

// ---------------------------------------------------------------- array elements

// The array slot that the base of index node x names, or -1 with C9102.
I64 array_slot[n, t, m, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirFunc[_] funcs,
        in SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 base = nodes[x].a as I64;
    I64 b = nodes[x].b as I64;
    if (nodes[base].kind == parse.N_NAME && b >= 0 && nodes[b].next < 0) {
        I64 k = find_slot(text, toks, funcs, slots, ls, nodes[base].tok as I64);
        if (k >= 0 && (slots[k].kind == SK_ARRAY || slots[k].kind == SK_VIEW)) {
            return k;
        }
    }
    unsupported(toks, diag, ls, nodes[x].tok as I64, U_VIEW);
    return -1;
}

// Task 2.14: the base of index node x, an array or view slot (fj[0] -1), or a struct slot
// whose field fj[0] is an array (SPEC-04 LS-67, `s.f[i]`); -1 with C9102.
I64 elem_base[n, t, m, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirFunc[_] funcs,
        in SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x, inout I64[_] fj) {
    fj[0] = -1;
    I64 fb = nodes[x].a as I64;
    I64 b = nodes[x].b as I64;
    if (nodes[fb].kind != parse.N_FIELD || b < 0 || nodes[b].next >= 0) {
        return array_slot(text, toks, nodes, funcs, slots, diag, ls, x);
    }
    I64 k = struct_base(text, toks, nodes, funcs, slots, diag, ls, fb);
    if (k < 0) {
        return -1;
    }
    I64 j = field_index(text, toks, slots, slots[k].ty, nodes[fb].tok as I64);
    I32 aty = T_NONE;
    if (j >= 0) {
        aty = field_type(slots, slots[k].ty, j);
    }
    if (!field_array(aty)) {
        unsupported(toks, diag, ls, nodes[x].tok as I64, U_STRUCT);
        return -1;
    }
    fj[0] = j;
    return k;
}

// The element type of the base elem_base gave: slot k, or its array field fj.
I32 base_elem(in SirSlot[_] slots, I64 k, I64 fj) {
    if (fj < 0) {
        return array_elem(slots[k].ty);
    }
    return array_elem(field_type(slots, slots[k].ty, fj));
}

// index_check of index v into the base of elem_base (an array field fj: c = fj + 1).
I64 field_check[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I32 ety, I64 k, I64 v, I64 tk, I64 fj) {
    I64 c = index_check(toks, sir, diag, ls, ety, k, v, tk);
    if (c >= 0 && fj >= 0) {
        sir[c].c = (fj + 1) as I32;
    }
    return c;
}

// element, of the base of elem_base: an array field's element is SO_FELOAD.
I64 element_of[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 k, I64 v, I64 tk, I64 fj) {
    if (fj < 0) {
        return element(toks, sir, slots, diag, ls, k, v, tk);
    }
    I32 ety = base_elem(slots, k, fj);
    if (field_check(toks, sir, diag, ls, ety, k, v, tk, fj) < 0) {
        return -1;
    }
    I64 i = def_sir(toks, sir, diag, ls, SO_FELOAD, ety, tk);
    if (i >= 0) {
        sir[i].a = k as I32;
        sir[i].b = v as I32;
        sir[i].c = fj as I32;
    }
    return i;
}

// The bounds check of index v into array slot k at token tk (the `[`, SPEC-04 LS-278).
I64 index_check[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I32 ety, I64 k, I64 v, I64 tk) {
    I64 c = add_sir(toks, sir, diag, ls, SO_ICHECK, ety, tk);
    if (c >= 0) {
        sir[c].a = k as I32;
        sir[c].b = v as I32;
        site(sir, ls, c);
    }
    return c;
}

// The bounds check of index v into array slot k, then the element's load; -1 on error.
I64 element[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 k, I64 v, I64 tk) {
    if (index_check(toks, sir, diag, ls, array_elem(slots[k].ty), k, v, tk) < 0) {
        return -1;
    }
    I64 i = def_sir(toks, sir, diag, ls, SO_ELOAD, array_elem(slots[k].ty), tk);
    if (i >= 0) {
        sir[i].a = k as I32;
        sir[i].b = v as I32;
    }
    return i;
}

I64 field_ref(in scan.Token[_] toks, inout Sir[_] sir, inout SirSlot[_] slots,
        inout limits.CompilerDiag[_] diag, inout LState[_] ls, I64 base, I64 j, I64 tk) {
    I32 ty = field_type(slots, slots[base].ty, j);
    I32 kind = SK_SPLACE;
    I32 op = SO_FREF;
    if (field_array(ty)) { kind = SK_APLACE; op = SO_AFREF; }
    I64 h = add_slot(toks, slots, diag, ls, -1, ty, kind, tk);
    I64 i = add_sir(toks, sir, diag, ls, op, ty, tk);
    if (h < 0 || i < 0) { return -1; }
    sir[i].a = h as I32;
    sir[i].b = base as I32;
    sir[i].c = j as I32;
    return h;
}

// Retains the checked element's address for nested fields and whole-record copies.
I64 element_ref(in scan.Token[_] toks, inout Sir[_] sir, inout SirSlot[_] slots,
        inout limits.CompilerDiag[_] diag, inout LState[_] ls, I32 ty, I64 base, I64 index, I64 tk, I64 field) {
    if (field_check(toks, sir, diag, ls, ty, base, index, tk, field) < 0) { return -1; }
    I64 h = add_slot(toks, slots, diag, ls, -1, ty, SK_SPLACE, tk);
    I64 i = add_sir(toks, sir, diag, ls, SO_EREF, ty, tk);
    if (h < 0 || i < 0) { return -1; }
    sir[i].a = h as I32;
    sir[i].b = base as I32;
    sir[i].c = index as I32;
    sir[i].e = (field + 1) as I32;
    return h;
}

// ---------------------------------------------------------------- box 09 views

// The rank of array or view slot k: an SK_NVIEW's, else 1.
export I64 slot_rank(in SirSlot[_] slots, I64 k) {
    if (slots[k].kind == SK_NVIEW && slots[k].ty < T_STRUCT) {
        return ((slots[k].ty >> 8) & 7) as I64;
    }
    return 1;
}

// A hidden SK_NVIEW slot of element type ety and rank r at token tk, or -1.
I64 new_view[t, r](in scan.Token[t] toks, inout SirSlot[_] slots, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I32 ety, I64 rank, I64 tk) {
    if (ety >= T_STRUCT) {
        // A view of struct elements, rank 1: the allocation of an arena of structs (box 12).
        return add_slot(toks, slots, diag, ls, -1, ety, SK_NVIEW, tk);
    }
    return add_slot(toks, slots, diag, ls, -1, ety | ((rank as I32) << 8), SK_NVIEW, tk);
}

// A new box 09 node op at token tk with slot or value operands a, b and c, payload f and val,
// and type ty; -1 with C9001.
I64 view_node[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I32 op, I32 ty, I64 a, I64 b, I64 c, I64 f, I64 val, I64 tk) {
    I64 i = add_sir(toks, sir, diag, ls, op, ty, tk);
    if (i >= 0) {
        sir[i].a = a as I32;
        sir[i].b = b as I32;
        sir[i].c = c as I32;
        sir[i].f = f as I32;
        sir[i].val = val;
    }
    return i;
}

// Whether index node x takes the view path: a slice, more than one index, fewer indexes
// than the base's rank, a base that is not a name or a field, or a name of an SK_NVIEW.
Bool general_index[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        in SirFunc[_] funcs, in SirSlot[_] slots, in LState[_] ls, I64 x) {
    I64 base = nodes[x].a as I64;
    I64 b = nodes[x].b as I64;
    if ((sem[x].flags & resolve.SEM_VIEW) != 0 || b < 0 || nodes[b].next >= 0 || nodes[b].kind == parse.N_SLICE) {
        return true;
    }
    if (nodes[base].kind == parse.N_NAME) {
        I64 k = find_slot(text, toks, funcs, slots, ls, nodes[base].tok as I64);
        return k >= 0 && slots[k].kind == SK_NVIEW;
    }
    return nodes[base].kind != parse.N_FIELD;
}

// Part j of index node x on the view path: 0 its base, then in written order each index,
// and each slice's written low and high bounds; -1 after the last.
I64 index_part(in parse.Node[_] nodes, I64 x, I64 j) {
    if (j == 0) {
        return nodes[x].a as I64;
    }
    I64 q = 1;
    I64 g = nodes[x].b as I64;
    while (g >= 0) {
        if (nodes[g].kind == parse.N_SLICE) {
            if (nodes[g].a >= 0) {
                if (q == j) {
                    return nodes[g].a as I64;
                }
                q += 1;
            }
            if (nodes[g].b >= 0) {
                if (q == j) {
                    return nodes[g].b as I64;
                }
                q += 1;
            }
        } else {
            if (q == j) {
                return g;
            }
            q += 1;
        }
        g = nodes[g].next as I64;
    }
    return -1;
}

// Keeps the value lowered last in a value frame where frame f was, and moves frame f up
// one (as call_step keeps its arguments); its new index, or -1 with C9004.
I64 keep_value[t, s, r](in scan.Token[t] toks, inout parse.Frame[s] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 f, I64 tk) {
    I64 sp = ls[0].sp;
    if (sp == ls[0].cap) {
        stop_at(toks, diag, ls, limits.C_NESTING, tk, limits.LIM_STACK, sp);
        return -1;
    }
    copy_frame(st, sp, f);
    st[f].kind = K_VALUE;
    st[f].a = ls[0].rv as I32;
    st[f].b = ls[0].rfirst as I32;
    ls[0].sp = sp + 1;
    return sp;
}

// The array or view slot that value v names (VIEW_ARG - slot), or -1 with C9102 at tk.
I64 view_value[t, r](in scan.Token[t] toks, in SirSlot[_] slots, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 v, I64 tk) {
    if (v > VIEW_ARG || v <= STR_ARG) {
        unsupported(toks, diag, ls, tk, U_VIEW);
        return -1;
    }
    I64 k = VIEW_ARG - v;
    I32 kind = slots[k].kind;
    if ((kind != SK_ARRAY && kind != SK_VIEW && kind != SK_APLACE && kind != SK_NVIEW) ||
            array_elem(slots[k].ty) >= T_STRUCT) {
        unsupported(toks, diag, ls, tk, U_VIEW);
        return -1;
    }
    return k;
}

// The index checks of an element of slot k (SPEC-04 LS-278, ruling R1), after every index
// was evaluated: index q at value frame v0 + q, in dimension order; then the element's
// offset (SO_EOFF) when k is an SK_NVIEW, else its index. The operand of its SO_ELOAD or
// SO_ESTORE, or -2 on error.
I64 element_offset[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, in parse.Frame[_] st, I64 k, I64 v0, I64 tk) {
    I64 rk = slot_rank(slots, k);
    I32 ety = array_elem(slots[k].ty);
    for d in 0..rk {
        I64 c = view_node(toks, sir, diag, ls, SO_ICHECK, ety, k, st[v0 + d].a as I64, 0, d, 0, tk);
        if (c < 0) {
            return -2;
        }
        site(sir, ls, c);
    }
    if (slots[k].kind != SK_NVIEW) {
        return st[v0].a as I64;
    }
    I64 off = -1;
    for d in 0..rk {
        I64 e = def_sir(toks, sir, diag, ls, SO_EOFF, T_I64, tk);
        if (e < 0) {
            return -2;
        }
        sir[e].a = k as I32;
        sir[e].b = st[v0 + d].a;
        sir[e].c = off as I32;
        sir[e].f = d as I32;
        off = e;
    }
    return off;
}

// Index node x on the view path, frame f (state 1 after the first part, g the parts kept
// in value frames below, c the first node): its base, as an array or a view, then its
// indexes and slice bounds in written order (SPEC-04 LS-278); then an element's checks and
// load, or a view: the hidden SK_NVIEW that SO_VBEGIN, SO_ICHECK and SO_VPICK for each
// index, SO_VSLICE for each slice and SO_VEND make, items in dimension order (ruling R1).
// With want W_ELEMENT, an element place: rv its offset (or index), rend its slot.
void index_step[n, t, m, ns, s, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[s] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[x].tok as I64;
    I64 at = f;
    if (st[f].state == 0) {
        st[f].state = 1;
        st[f].g = 0;
        st[f].c = ls[0].nsir as I32;
    } else {
        at = keep_value(toks, st, diag, ls, f, tk);
        if (at < 0) {
            return;
        }
        st[at].g += 1;
    }
    I64 j = st[at].g as I64;
    I64 part = index_part(nodes, x, j);
    if (part >= 0) {
        I32 w = T_I64;
        if (j == 0) {
            w = VIEW_ANY << 8;
        }
        _ = push(toks, st, diag, ls, K_EXPR, part, w, tk);
        return;
    }
    I64 v0 = at - j;
    I64 first = st[at].c as I64;
    Bool place = st[at].want == W_ELEMENT;
    I64 vv = st[v0].a as I64;
    I64 k = -1;
    if (vv <= VIEW_ARG && vv > STR_ARG && leased(slots, ls[0].nslot, VIEW_ARG - vv) &&
            slots[VIEW_ARG - vv].ty >= T_STRUCT) {
        // The allocation of an arena of structs (box 12): only its elements are reached.
        k = VIEW_ARG - vv;
    } else {
        k = view_value(toks, slots, diag, ls, vv, tk);
    }
    if (k < 0) {
        return;
    }
    if (place) {
        k = kernel_stage(funcs, slots, ls, k);
    }
    I64 rk = slot_rank(slots, k);
    I32 ety = array_elem(slots[k].ty);
    I64 items = 0;
    I64 picks = 0;
    Bool sliced = false;
    I64 g = nodes[x].b as I64;
    while (g >= 0) {
        items += 1;
        if (nodes[g].kind == parse.N_SLICE) {
            sliced = true;
        } else {
            picks += 1;
        }
        g = nodes[g].next as I64;
    }
    if (items > rk) {
        unsupported(toks, diag, ls, tk, U_VIEW);
        return;
    }
    if (leased(slots, ls[0].nslot, k) && (sliced || items != rk)) {
        // A view of a view of an arena allocation would need its lease (box 12).
        unsupported(toks, diag, ls, tk, U_MEMORY);
        return;
    }
    if (!lease_check(toks, sir, slots, diag, ls, k, tk)) {
        return;
    }
    if (!sliced && items == rk) {
        I64 off = element_offset(toks, sir, slots, diag, ls, st, k, v0 + 1, tk);
        if (off == -2) {
            return;
        }
        kernel_step(toks, sir, funcs, diag, ls, tk);
        ls[0].sp = v0 + 1;
        if (ety >= T_STRUCT) {
            // An element of an arena allocation of structs: its place (SO_EREF).
            I64 h = add_slot(toks, slots, diag, ls, -1, ety, SK_SPLACE, tk);
            I64 er = add_sir(toks, sir, diag, ls, SO_EREF, ety, tk);
            if (h < 0 || er < 0) {
                return;
            }
            sir[er].a = h as I32;
            sir[er].b = k as I32;
            sir[er].c = off as I32;
            give(ls, VIEW_ARG - h, ety, first, ls[0].nsir);
            return;
        }
        if (place) {
            give(ls, off, ety, first, ls[0].nsir);
            ls[0].rend = k;
            return;
        }
        I64 i = def_sir(toks, sir, diag, ls, SO_ELOAD, ety, tk);
        if (i < 0) {
            return;
        }
        sir[i].a = k as I32;
        sir[i].b = off as I32;
        give(ls, i, ety, first, i + 1);
        return;
    }
    I64 h = new_view(toks, slots, diag, ls, ety, rk - picks, tk);
    if (view_node(toks, sir, diag, ls, SO_VBEGIN, ety, h, k, -1, 0, 0, tk) < 0) {
        return;
    }
    I64 q = v0 + 1;
    I64 pos = 0;
    I64 mask = 0;
    I64 d = 0;
    g = nodes[x].b as I64;
    while (g >= 0) {
        if (nodes[g].kind == parse.N_SLICE) {
            I64 lo = -1;
            I64 hi = -1;
            I64 flags = 0;
            if (nodes[g].a >= 0) {
                lo = st[q].a as I64;
                q += 1;
                flags += 1;
            }
            if (nodes[g].b >= 0) {
                hi = st[q].a as I64;
                q += 1;
                flags += 2;
            }
            if (nodes[g].op == scan.OP_RANGE_INCL) {
                flags += 4;
            }
            I64 step = 1;
            if (nodes[g].c >= 0) {
                step = sem[nodes[g].c as I64].bits as% I64;
            }
            I64 sl = view_node(toks, sir, diag, ls, SO_VSLICE, ety, h, lo, hi, d + 8 * pos + 64 * flags, step, tk);
            if (sl < 0) {
                return;
            }
            sir[sl].e = k as I32;
            site(sir, ls, sl);
            pos += 1;
        } else {
            I64 iv = st[q].a as I64;
            q += 1;
            I64 c = view_node(toks, sir, diag, ls, SO_ICHECK, ety, k, iv, 0, d, 0, tk);
            if (c < 0) {
                return;
            }
            site(sir, ls, c);
            if (view_node(toks, sir, diag, ls, SO_VPICK, ety, h, iv, k, d, 0, tk) < 0) {
                return;
            }
            mask += 1 << d;
        }
        d += 1;
        g = nodes[g].next as I64;
    }
    if (view_node(toks, sir, diag, ls, SO_VEND, ety, h, k, 0, items, mask, tk) < 0) {
        return;
    }
    kernel_step(toks, sir, funcs, diag, ls, tk);
    ls[0].sp = v0 + 1;
    give(ls, VIEW_ARG - h, slots[h].ty, first, ls[0].nsir);
}

// Whether part j of array built-in call x (after af_skip) is an array: both of `copy` and
// `dot`, else the last value.
Bool arrayfn_array(I64 id, I64 j, I64 nv) {
    return id == resolve.AF_COPY || id == resolve.AF_DOT || j == nv - 1;
}

// The arguments of array built-in call x before its values: a written result type of
// `sum` or `dot`, the operation of `fold_checked`.
I64 arrayfn_skip(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    I64 id = sem[x].lit_at;
    I64 a0 = nodes[x].b as I64;
    if (id == resolve.AF_FOLD) {
        return 1;
    }
    if ((id == resolve.AF_SUM || id == resolve.AF_DOT) && a0 >= 0 && nodes[a0].kind == parse.N_TYPENAME) {
        return 1;
    }
    return 0;
}

// The values of array built-in call x that are evaluated: its arrays and initial values; a
// dimension argument of `extent` or `reverse` is a folded constant.
I64 arrayfn_values(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    I64 id = sem[x].lit_at;
    if (id == resolve.AF_EXTENT || id == resolve.AF_REVERSE) {
        return 1;
    }
    I64 nv = 0;
    I64 g = nodes[x].b as I64;
    while (g >= 0) {
        nv += 1;
        g = nodes[g].next as I64;
    }
    return nv - arrayfn_skip(nodes, sem, x);
}

// The CINT_REDUCE_* operation of reduction call x (rt/cint_rt.h section 14), or 0.
I64 reduce_op(in resolve.Sem[_] sem, I64 x) {
    switch (sem[x].lit_at) {
        case resolve.AF_SUM: return 1;
        case resolve.AF_SUM_WRAP: return 2;
        case resolve.AF_SUM_SAT: return 3;
        case resolve.AF_FOLD:
            if (sem[x].lit_len == 2) {
                return 5;
            }
            return 4;
        case resolve.AF_MIN: return 6;
        case resolve.AF_MAX: return 7;
        case resolve.AF_COUNT: return 8;
        case resolve.AF_DOT: return 9;
        default: return 0;
    }
}

// A call of an array built-in (SEM_ARRAYFN; SPEC-04 LS-70, LS-145; rulings R4 to R6), frame
// f as index_step's: its values in written order, arrays as views and initial values of
// the element type; then `len`, `extent` and `size` as SO_VEXT, `transpose` and `reverse`
// as a hidden view (SO_VTRANS, SO_VREV), `copy` as SO_VCOPY at the callee, a reduction as
// SO_REDUCE at the callee (its fault position, the operation's identifier).
void arrayfn_step[n, t, m, ns, s, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[s] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[nodes[x].a as I64].tok as I64;
    I64 id = sem[x].lit_at;
    I64 at = f;
    if (st[f].state == 0) {
        st[f].state = 1;
        st[f].g = 0;
        st[f].c = ls[0].nsir as I32;
    } else {
        at = keep_value(toks, st, diag, ls, f, tk);
        if (at < 0) {
            return;
        }
        st[at].g += 1;
    }
    I64 j = st[at].g as I64;
    I64 nv = arrayfn_values(nodes, sem, x);
    if (j < nv) {
        I32 w = sem[x].opty as I32;
        if (arrayfn_array(id, j, nv)) {
            w = VIEW_ANY << 8;
        }
        _ = push(toks, st, diag, ls, K_EXPR, call_arg(nodes, x, j + arrayfn_skip(nodes, sem, x)), w, tk);
        return;
    }
    I64 v0 = at - j;
    I64 first = st[at].c as I64;
    I64 k = view_value(toks, slots, diag, ls, st[at - 1].a as I64, tk);
    if (k < 0) {
        return;
    }
    I32 ety = array_elem(slots[k].ty);
    ls[0].sp = v0 + 1;
    I64 d = 0;
    if (id == resolve.AF_EXTENT || id == resolve.AF_REVERSE) {
        d = sem[nodes[nodes[x].b as I64].next as I64].bits as% I64;
    }
    if (id == resolve.AF_LEN || id == resolve.AF_EXTENT || id == resolve.AF_SIZE) {
        if (id == resolve.AF_SIZE) {
            d = -1;
        }
        I64 i = def_sir(toks, sir, diag, ls, SO_VEXT, T_I64, tk);
        if (i < 0) {
            return;
        }
        sir[i].a = k as I32;
        sir[i].f = d as I32;
        give(ls, i, T_I64, first, i + 1);
        return;
    }
    if (id == resolve.AF_TRANSPOSE || id == resolve.AF_REVERSE) {
        if (leased(slots, ls[0].nslot, k)) {
            unsupported(toks, diag, ls, tk, U_MEMORY);
            return;
        }
        I32 op = SO_VREV;
        if (id == resolve.AF_TRANSPOSE) {
            op = SO_VTRANS;
        }
        I64 h = new_view(toks, slots, diag, ls, ety, slot_rank(slots, k), tk);
        if (view_node(toks, sir, diag, ls, op, ety, h, k, -1, d, 0, tk) < 0) {
            return;
        }
        give(ls, VIEW_ARG - h, slots[h].ty, first, ls[0].nsir);
        return;
    }
    if (id == resolve.AF_COPY) {
        I64 dk = view_value(toks, slots, diag, ls, st[v0].a as I64, tk);
        if (dk < 0 || !lease_check(toks, sir, slots, diag, ls, dk, tk) || !lease_check(toks, sir, slots, diag, ls, k, tk)) {
            return;
        }
        I64 i = view_node(toks, sir, diag, ls, SO_VCOPY, ety, dk, k, -1, 0, 0, tk);
        site(sir, ls, i);
        give(ls, i, T_NONE, first, ls[0].nsir);
        return;
    }
    I64 op = reduce_op(sem, x);
    if (op == 0) {
        unsupported(toks, diag, ls, tk, U_CALL);
        return;
    }
    I64 ys = -1;
    I64 init = -1;
    if (id == resolve.AF_DOT) {
        ys = k;
        k = view_value(toks, slots, diag, ls, st[v0].a as I64, tk);
        if (k < 0 || !lease_check(toks, sir, slots, diag, ls, k, tk)) {
            return;
        }
    } else if (j == 2) {
        init = st[v0].a as I64;
    }
    I64 last_view = k;
    if (ys >= 0) {
        last_view = ys;
    }
    if (!lease_check(toks, sir, slots, diag, ls, last_view, tk)) {
        return;
    }
    I32 rty = sem[x].ty as I32;
    I64 i = def_sir(toks, sir, diag, ls, SO_REDUCE, rty, tk);
    if (i < 0) {
        return;
    }
    sir[i].a = k as I32;
    sir[i].b = ys as I32;
    sir[i].c = init as I32;
    sir[i].f = op as I32;
    sir[i].val = sem[x].opty;
    site(sir, ls, i);
    give(ls, i, rty, first, i + 1);
}

// Whether the function being lowered is a kernel.
Bool in_kernel(in SirFunc[_] funcs, in LState[_] ls) {
    return ls[0].func >= 0 && (funcs[ls[0].func].flags & FN_KERNEL) != 0;
}

// The slot that the element stores of a kernel's work-item write for array slot k: its
// staging view when k is a written array parameter of the kernel being lowered, else k.
I64 kernel_stage(in SirFunc[_] funcs, in SirSlot[_] slots, in LState[_] ls, I64 k) {
    if (!in_kernel(funcs, ls) || slots[k].kind != SK_NVIEW || slots[k].live < 3) {
        return k;
    }
    I64 p0 = funcs[ls[0].func].pslot0 as I64;
    if (k < p0 || k >= p0 + (funcs[ls[0].func].nparam as I64)) {
        return k;
    }
    return (slots[k].live - 3) as I64;
}

// The work-item step that a counted operation of a kernel's body takes (SPEC-01 IM-113);
// nothing outside a kernel.
void kernel_step[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirFunc[_] funcs,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 tk) {
    if (in_kernel(funcs, ls)) {
        _ = add_sir(toks, sir, diag, ls, SO_KSTEP, T_NONE, tk);
    }
}

// kernel_step for SO_BIN operation b: the arithmetic operations count, `&`, `|` and `^` do not.
void kernel_bin_step[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirFunc[_] funcs,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 b, I64 tk) {
    if (b < B_AND as I64) {
        kernel_step(toks, sir, funcs, diag, ls, tk);
    }
}

// ---------------------------------------------------------------- box 12 memory steps

// Box 12: the module-level arenas and pools in declaration order (SK_ARENA_M, SK_POOL_M), a
// script's too (SPEC-03 M-13, M-20). B1 gives them to the root module only, of a scalar or
// struct element and a capacity of at most 2^31 - 1 elements; else C9102 (U_MEMORY;
// compiler/OPEN.md CINTC-OQ-64).
void declare_memories[n, t, m, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 root, Bool is_root) {
    I64 x = nodes[root].a as I64;
    while (x >= 0 && ls[0].err == 0) {
        if (resolve.is_memory_decl(nodes, x)) {
            I64 tk = nodes[x].tok as I64;
            I64 tn = nodes[x].a as I64;
            I64 cap = sem[nodes[tn].c as I64].bits as% I64;
            I32 ety = mem_slot_elem(text, toks, nodes, slots, ls, tn, sem[x].ty);
            if (!is_root || ety == T_NONE || cap < 0 || cap > 2147483647) {
                unsupported(toks, diag, ls, tk, U_MEMORY);
                return;
            }
            I32 kind = SK_POOL_M;
            if (resolve.mem_kind(sem[x].ty) == resolve.MK_ARENA) {
                kind = SK_ARENA_M;
            }
            I64 k = add_slot(toks, slots, diag, ls, tk, ety, kind, tk);
            if (k >= 0) {
                slots[k].live = cap as I32;
            }
        }
        x = nodes[x].next as I64;
    }
}

// The container slot that name node x names, or -1 with C9102 at tk.
I64 container_of[n, t, m, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirFunc[_] funcs,
        in SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x, I64 tk) {
    I64 k = -1;
    if (nodes[x].kind == parse.N_NAME) {
        k = find_slot(text, toks, funcs, slots, ls, nodes[x].tok as I64);
    }
    if (k < 0 || !is_container(slots, k) || in_kernel(funcs, ls)) {
        unsupported(toks, diag, ls, tk, U_MEMORY);
        return -1;
    }
    return k;
}

// `Arena(T) name = a.child(n);` (SPEC-03 M-14, M-20): the count, then the local's slot
// (SK_ARENA_R) and SO_MEMBER at the member name, which gives it the child's identifier. A
// local arena or pool of any other initializer is C9102 (U_MEMORY).
void lower_child_var[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 init = nodes[x].b as I64;
    if (init < 0 || nodes[init].kind != parse.N_CALL || (sem[init].flags & resolve.SEM_MEMBER) == 0 ||
            sem[init].lit_at != resolve.MB_CHILD || nodes[init].b < 0) {
        unsupported(toks, diag, ls, tk, U_MEMORY);
        return;
    }
    I64 callee = nodes[init].a as I64;
    I64 mt = nodes[callee].tok as I64;
    I64 pk = container_of(text, toks, nodes, funcs, slots, diag, ls, nodes[callee].a as I64, mt);
    if (pk < 0) {
        return;
    }
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[init].b as I64, T_I64)) {
        return;
    }
    I64 nchild = ls[0].rv;
    I64 k = add_slot(toks, slots, diag, ls, tk, slots[pk].ty, SK_ARENA_R, tk);
    I64 d = add_sir(toks, sir, diag, ls, SO_LOCAL, slots[pk].ty, tk);
    I64 i = add_sir(toks, sir, diag, ls, SO_MEMBER, T_NONE, mt);
    if (k < 0 || d < 0 || i < 0) {
        return;
    }
    sir[d].a = k as I32;
    sir[i].a = pk as I32;
    sir[i].b = nchild as I32;
    sir[i].c = resolve.MB_CHILD as I32;
    sir[i].f = k as I32;
    site(sir, ls, i);
}

// Member call x of an arena or a pool (SEM_MEMBER; SPEC-03 M-14 to M-19), frame f: its
// argument, then SO_MEMBER at the member name (`cint_ref` member: the receiver, then the
// argument; faults at the member name). `alloc_result` and `insert_result` are unions, an
// SO_ETAG after it. A `child` is the initializer of a local arena (lower_child_var).
void member_step[n, t, m, ns, s, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[s] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 callee = nodes[x].a as I64;
    I64 tk = nodes[callee].tok as I64;
    I64 mb = sem[x].lit_at;
    I64 k = container_of(text, toks, nodes, funcs, slots, diag, ls, nodes[callee].a as I64, tk);
    if (k < 0) {
        return;
    }
    if (mb == resolve.MB_CHILD) {
        unsupported(toks, diag, ls, tk, U_MEMORY);
        return;
    }
    I64 arg = nodes[x].b as I64;
    I32 ety = slots[k].ty;
    if (st[f].state == 0 && arg >= 0) {
        st[f].state = 1;
        I32 w = T_I64;
        if (mb == resolve.MB_INSERT || mb == resolve.MB_INSERT_RESULT) {
            w = ety;
        } else if (mb == resolve.MB_REMOVE) {
            w = T_HANDLE;
        }
        _ = push(toks, st, diag, ls, K_EXPR, arg, w, tk);
        return;
    }
    I64 first = ls[0].nsir;
    I64 v = -1;
    I64 e = 0;
    if (arg >= 0) {
        first = ls[0].rfirst;
        v = ls[0].rv;
        if (ety >= T_STRUCT && (mb == resolve.MB_INSERT || mb == resolve.MB_INSERT_RESULT)) {
            // A struct element: the slot that holds the value.
            if (v > VIEW_ARG || v <= STR_ARG || ls[0].rty != ety as I64) {
                unsupported(toks, diag, ls, nodes[arg].tok as I64, U_STRUCT);
                return;
            }
            e = VIEW_ARG - v;
            v = -1;
        }
    }
    Bool unioned = mb == resolve.MB_ALLOC_RESULT || mb == resolve.MB_INSERT_RESULT;
    I32 rty = T_HANDLE;
    if (mb == resolve.MB_RESET || mb == resolve.MB_REMOVE) {
        rty = T_NONE;
    }
    I64 i = -1;
    if (rty == T_NONE) {
        i = add_sir(toks, sir, diag, ls, SO_MEMBER, T_NONE, tk);
    } else {
        i = def_sir(toks, sir, diag, ls, SO_MEMBER, rty, tk);
    }
    if (i < 0) {
        return;
    }
    sir[i].a = k as I32;
    sir[i].b = v as I32;
    sir[i].c = mb as I32;
    sir[i].f = e as I32;
    site(sir, ls, i);
    if (unioned) {
        I64 g = def_sir(toks, sir, diag, ls, SO_ETAG, T_U16, tk);
        if (g < 0) {
            return;
        }
        sir[g].a = i as I32;
        give(ls, g, T_U16, first, g + 1);
        return;
    }
    give(ls, i, rty, first, i + 1);
}

// SO_PREF at tk: the place slot of the element of handle value hv in pool slot k.
I64 pool_place[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 k, I64 hv, I64 tk) {
    I64 h = add_slot(toks, slots, diag, ls, -1, slots[k].ty, SK_SPLACE, tk);
    I64 i = add_sir(toks, sir, diag, ls, SO_PREF, slots[k].ty, tk);
    if (h < 0 || i < 0) {
        return -1;
    }
    sir[i].a = h as I32;
    sir[i].b = k as I32;
    sir[i].c = hv as I32;
    site(sir, ls, i);
    return h;
}

// `p[h]` or `a[h]` (SEM_DEREF; SPEC-03 M-14a, M-15, M-17), frame f: the handle, then at the
// `[` a pool's element as a place (SO_PREF), loaded when it is a scalar and frame f wants no
// place, or the rank-1 view of an arena allocation with its lease (SO_MVIEW); of struct
// elements, only its elements are reached (index_step).
void deref_step[n, t, m, ns, s, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[s] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f, Bool place) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[x].tok as I64;
    I64 k = container_of(text, toks, nodes, funcs, slots, diag, ls, nodes[x].a as I64, tk);
    if (k < 0) {
        return;
    }
    I32 ety = slots[k].ty;
    if (st[f].state == 0) {
        st[f].state = 1;
        _ = push(toks, st, diag, ls, K_EXPR, nodes[x].b as I64, T_HANDLE, tk);
        return;
    }
    I64 first = ls[0].rfirst;
    I64 hv = ls[0].rv;
    if (is_arena(slots, k)) {
        I64 h = new_view(toks, slots, diag, ls, ety, 1, tk);
        I64 lk = add_slot(toks, slots, diag, ls, -1, T_NONE, SK_LEASE, tk);
        I64 i = add_sir(toks, sir, diag, ls, SO_MVIEW, ety, tk);
        if (h < 0 || lk < 0 || i < 0) {
            return;
        }
        sir[i].a = h as I32;
        sir[i].b = k as I32;
        sir[i].c = hv as I32;
        site(sir, ls, i);
        give(ls, VIEW_ARG - h, slots[h].ty, first, i + 1);
        return;
    }
    I64 h = pool_place(toks, sir, slots, diag, ls, k, hv, tk);
    if (h < 0) {
        return;
    }
    if (ety >= T_STRUCT || place) {
        give(ls, VIEW_ARG - h, ety, first, ls[0].nsir);
        return;
    }
    I64 ld = def_sir(toks, sir, diag, ls, SO_LOAD, ety, tk);
    if (ld < 0) {
        return;
    }
    sir[ld].a = h as I32;
    give(ls, ld, ety, first, ld + 1);
}

// handle.check of the lease of view slot k at tk, when it has one (SPEC-03 M-23): an element
// access, a reduction or a copy through a view of an arena allocation. False after an error.
Bool lease_check[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 k, I64 tk) {
    if (!leased(slots, ls[0].nslot, k)) {
        return true;
    }
    I64 i = add_sir(toks, sir, diag, ls, SO_LEASE, T_NONE, tk);
    if (i < 0) {
        return false;
    }
    sir[i].a = (k + 1) as I32;
    site(sir, ls, i);
    return true;
}

// The place of an assignment to `p[h]` (SPEC-03 M-15): the handle, then SO_PREF at the `[`;
// a struct element is assigned here (SO_SCOPY from the value's slot) and -1 returned. An
// arena allocation as a target is C9102 (U_MEMORY).
I64 deref_target[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 target = nodes[x].a as I64;
    I64 ttk = nodes[target].tok as I64;
    I64 k = container_of(text, toks, nodes, funcs, slots, diag, ls, nodes[target].a as I64, ttk);
    if (k < 0) {
        return -1;
    }
    if (is_arena(slots, k)) {
        unsupported(toks, diag, ls, ttk, U_MEMORY);
        return -1;
    }
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[target].b as I64, T_HANDLE)) {
        return -1;
    }
    I64 h = pool_place(toks, sir, slots, diag, ls, k, ls[0].rv, ttk);
    if (h < 0 || slots[h].ty < T_STRUCT) {
        return h;
    }
    if (nodes[x].kind != parse.N_ASSIGN || nodes[x].op != scan.OP_ASSIGN) {
        unsupported(toks, diag, ls, tk, U_STRUCT);
        return -1;
    }
    I64 src = struct_value(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, slots[h].ty);
    if (src >= 0) {
        scopy(toks, sir, diag, ls, h, src, tk);
    }
    return -1;
}

// ---------------------------------------------------------------- expressions

// One step of the expression frame f.
void expr_step[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    if (st[f].kind == K_WIDEN) {
        widen_step(toks, nodes, sem, sir, slots, st, diag, ls, f);
        return;
    }
    I32 want = st[f].want;
    Bool place = want < 0;
    if (place) { want = -want; }
    I32 kind = nodes[x].kind;
    I64 tk = nodes[x].tok as I64;
    I64 fn = ls[0].func;
    I64[2] lit;
    I64[2] bo;
    if ((sem[x].flags & resolve.SEM_ERRVAL) != 0) {
        // An error value (box 12): its tag in the set its context gives.
        I32 ety = set_type(sem[x].ty);
        I64 i = def_sir(toks, sir, diag, ls, SO_CONST, ety, tk);
        if (i < 0) {
            return;
        }
        sir[i].val = sem[x].bits as% I64;
        give(ls, i, ety, i, i + 1);
        return;
    }
    if ((sem[x].flags & resolve.SEM_WIDEN) != 0 && st[f].state == 0 &&
            !(f > 0 && st[f - 1].kind == K_WIDEN && st[f - 1].node as I64 == x)) {
        // A value of a set that converts to the set its context gives (BX12-28): the value,
        // of its own set, then widen_step.
        st[f].kind = K_WIDEN;
        _ = push(toks, st, diag, ls, K_EXPR, x, set_type(sem[x].ty), tk);
        return;
    }
    switch (kind) {
        case parse.N_LIT, parse.N_NEGLIT:
            I64 lt = tk;
            if (kind == parse.N_NEGLIT) {
                lt = nodes[x].c as I64;
            }
            if (!literal_value(text, toks, lt, lit)) {
                unsupported(toks, diag, ls, tk, U_LITERAL);
                return;
            }
            if (kind == parse.N_NEGLIT) {
                lit[0] = 0 -% lit[0];
            }
            I64 i = def_sir(toks, sir, diag, ls, SO_CONST, want, tk);
            if (i < 0) {
                return;
            }
            sir[i].val = lit[0];
            if (want != T_NONE) {
                sir[i].val = wrap_to(want, lit[0]);
            }
            give(ls, i, want, i, i + 1);
        case parse.N_BOOL:
            I64 i = def_sir(toks, sir, diag, ls, SO_CONST, T_BOOL, tk);
            if (i < 0) {
                return;
            }
            sir[i].val = nodes[x].op as I64;
            give(ls, i, T_BOOL, i, i + 1);
        case parse.N_NAME:
            I64 k = find_slot(text, toks, funcs, slots, ls, tk);
            if (k >= 0 && is_container(slots, k)) {
                // An arena or a pool passed to a parameter of its kind (SO_ARG e 9).
                give(ls, VIEW_ARG - k, slots[k].ty, ls[0].nsir, ls[0].nsir);
                return;
            }
            if ((sem[x].flags & resolve.SEM_ELEMENT) != 0 && k >= 0 && slots[k].kind == SK_NVIEW) {
                element_read(toks, sir, funcs, slots, diag, ls, k, tk);
                return;
            }
            if (k >= 0 && slots[k].kind == SK_PARAM) {
                I64 v = -(k - (funcs[fn].pslot0 as I64)) - 1;
                give(ls, v, slots[k].ty, ls[0].nsir, ls[0].nsir);
                return;
            }
            if (k >= 0 && (slots[k].kind == SK_ARRAY || slots[k].kind == SK_VIEW || slots[k].kind == SK_NVIEW ||
                    is_struct_slot(slots, k))) {
                if (want <= 255 && !is_struct_slot(slots, k)) {
                    unsupported(toks, diag, ls, tk, U_VIEW);
                    return;
                }
                // A view argument: VIEW_ARG - k stands for slot k (SO_ARG e 1).
                I32 got = want;
                if (is_struct_slot(slots, k)) { got = slots[k].ty; }
                give(ls, VIEW_ARG - k, got, ls[0].nsir, ls[0].nsir);
                return;
            }
            if (k >= 0) {
                I64 i = def_sir(toks, sir, diag, ls, SO_LOAD, slots[k].ty, tk);
                if (i < 0) {
                    return;
                }
                sir[i].a = k as I32;
                give(ls, i, slots[k].ty, i, i + 1);
                return;
            }
            I64 c = find_const(text, toks, nodes, ls, tk);
            if (c < 0) {
                unsupported(toks, diag, ls, tk, U_NAME);
                return;
            }
            I32 cty = type_of(toks, nodes, nodes[c].a as I64);
            if (cty == T_NONE) {
                unsupported(toks, diag, ls, tk, U_TYPE);
                return;
            }
            const_value(text, toks, nodes, ls, nodes[c].b as I64, lit);
            if (lit[1] == 0 && in_kernel(funcs, ls)) {
                // In a kernel the checker's folded value, so that no step is counted (IM-113).
                if ((sem[x].flags & resolve.SEM_FOLDED) != 0) {
                    lit[0] = sem[x].bits as% I64;
                    lit[1] = 1;
                } else if ((sem[nodes[c].b as I64].flags & resolve.SEM_FOLDED) != 0) {
                    lit[0] = sem[nodes[c].b as I64].bits as% I64;
                    lit[1] = 1;
                }
            }
            if (lit[1] == 0) {
                // A constant initializer of another form: the value the checker folded
                // (SPEC-04 LS-54), one row for each reference, so that a reference never
                // writes the initializer's rows again (SPEC-09 CINTC-16 row 6).
                I64 b = nodes[c].b as I64;
                I64 folded = resolve.SEM_CONST | resolve.SEM_FOLDED;
                if ((sem[b].flags & folded) != folded) {
                    unsupported(toks, diag, ls, tk, U_EXPRESSION);
                    return;
                }
                lit[0] = sem[b].bits as% I64;
            }
            I64 i = def_sir(toks, sir, diag, ls, SO_CONST, cty, tk);
            if (i < 0) {
                return;
            }
            sir[i].val = wrap_to(cty, lit[0]);
            give(ls, i, cty, i, i + 1);
        case parse.N_TYPEPROP:
            type_property(text, toks, nodes, x, lit);
            if (lit[1] == 0) {
                unsupported(toks, diag, ls, tk, U_EXPRESSION);
                return;
            }
            I32 pty = lit[1] as I32;
            I64 i = def_sir(toks, sir, diag, ls, SO_CONST, pty, tk);
            if (i < 0) {
                return;
            }
            sir[i].val = lit[0];
            give(ls, i, pty, i, i + 1);
        case parse.N_STRING:
            if (want <= 255 || array_elem(want) != T_U8) {
                unsupported(toks, diag, ls, tk, U_VIEW);
                return;
            }
            I64 sd = add_sir(toks, sir, diag, ls, SO_SDATA, T_NONE, tk);
            if (sd < 0) {
                return;
            }
            sir[sd].f = nodes[x].op;
            sir[sd].c = resolve.string_length(text, toks, tk, nodes[x].op as I64) as I32;
            give(ls, STR_ARG - sd, want, sd, sd + 1);
        case parse.N_FIELD:
            if (nodes[nodes[x].a as I64].kind == parse.N_INDEX &&
                    nodes[nodes[nodes[x].a as I64].a as I64].kind == parse.N_NAME &&
                    (sem[nodes[x].a as I64].flags & resolve.SEM_DEREF) == 0) {
                // A field of a struct element (task 2.14): the index, its check, the load.
                I64 ix = nodes[x].a as I64;
                I64 ek = array_slot(text, toks, nodes, funcs, slots, diag, ls, ix);
                if (ek < 0) {
                    return;
                }
                I32 ety = array_elem(slots[ek].ty);
                if (ety < T_STRUCT) {
                    unsupported(toks, diag, ls, tk, U_STRUCT);
                    return;
                }
                if (st[f].state == 0) {
                    st[f].state = 1;
                    _ = push(toks, st, diag, ls, K_EXPR, nodes[ix].b as I64, T_I64, nodes[ix].tok as I64);
                    return;
                }
                I64 efirst = ls[0].rfirst;
                I64 ev = ls[0].rv;
                if (index_check(toks, sir, diag, ls, ety, ek, ev, nodes[ix].tok as I64) < 0) {
                    return;
                }
                I64 ej = field_index(text, toks, slots, ety, tk);
                I32 efty = field_type(slots, ety, ej);
                if (field_array(efty) || efty >= T_STRUCT) {
                    I64 base = add_slot(toks, slots, diag, ls, -1, ety, SK_SPLACE, tk);
                    I64 er = add_sir(toks, sir, diag, ls, SO_EREF, ety, tk);
                    if (base < 0 || er < 0) { return; }
                    sir[er].a = base as I32;
                    sir[er].b = ek as I32;
                    sir[er].c = ev as I32;
                    I64 h = field_ref(toks, sir, slots, diag, ls, base, ej, tk);
                    if (h < 0) { return; }
                    give(ls, VIEW_ARG - h, efty, efirst, ls[0].nsir);
                    return;
                }
                I64 ei = def_sir(toks, sir, diag, ls, SO_EFLOAD, efty, tk);
                if (ei < 0) {
                    return;
                }
                sir[ei].a = ek as I32;
                sir[ei].b = ev as I32;
                sir[ei].c = ej as I32;
                give(ls, ei, efty, efirst, ei + 1);
                return;
            }
            I64 ic = -1;
            if (nodes[nodes[x].a as I64].kind == parse.N_NAME) {
                ic = find_import(text, toks, funcs, ls, nodes[nodes[x].a as I64].tok as I64, tk);
            }
            if (ic >= 0 && (funcs[ic].flags & FN_IVAR) != 0) {
                // An imported variable: a load of its slot.
                I64 vk = funcs[ic].pslot0 as I64;
                I64 vi = def_sir(toks, sir, diag, ls, SO_LOAD, slots[vk].ty, tk);
                if (vi < 0) {
                    return;
                }
                sir[vi].a = vk as I32;
                give(ls, vi, slots[vk].ty, vi, vi + 1);
                return;
            }
            if (ic >= 0) {
                // An imported constant, by value (its import row).
                if ((funcs[ic].flags & FN_ICONST) == 0 || (funcs[ic].flags & FN_ISTRUCT) != 0) {
                    unsupported(toks, diag, ls, tk, U_IMPORT);
                    return;
                }
                I32 ity = funcs[ic].result;
                U64 bits = (((funcs[ic].lslot_end as% U32) as U64) << 32) | ((funcs[ic].lslot0 as% U32) as U64);
                I64 ci = def_sir(toks, sir, diag, ls, SO_CONST, ity, tk);
                if (ci < 0) {
                    return;
                }
                sir[ci].val = wrap_to(ity, bits as% I64);
                give(ls, ci, ity, ci, ci + 1);
                return;
            }
            // Evaluates a computed record base once before selecting its field.
            I64 sk = -1;
            I64 bfirst = ls[0].nsir;
            I64 base_node = nodes[x].a as I64;
            if (nodes[base_node].kind == parse.N_FIELD || nodes[base_node].kind == parse.N_INDEX ||
                    nodes[base_node].kind == parse.N_CALL) {
                if (st[f].state == 0) {
                    st[f].state = 1;
                    _ = push(toks, st, diag, ls, K_EXPR, base_node, T_NONE, tk);
                    return;
                }
                if (ls[0].rv <= VIEW_ARG && ls[0].rv > STR_ARG) { sk = VIEW_ARG - ls[0].rv; }
                bfirst = ls[0].rfirst;
            } else {
                sk = struct_base(text, toks, nodes, funcs, slots, diag, ls, x);
            }
            if (sk < 0) {
                return;
            }
            I64 j = field_index(text, toks, slots, slots[sk].ty, tk);
            I32 fty = field_type(slots, slots[sk].ty, j);
            if (field_array(fty)) {
                I64 h = field_ref(toks, sir, slots, diag, ls, sk, j, tk);
                if (h < 0) { return; }
                give(ls, VIEW_ARG - h, fty, bfirst, ls[0].nsir);
                return;
            }
            if (fty >= T_STRUCT && want == fty && !place) {
                // A struct field passed to a struct parameter (task 2.14): its copy in a
                // hidden struct slot, which the argument names.
                I64 hs = add_slot(toks, slots, diag, ls, -1, fty, SK_STRUCT, tk);
                I64 hl = add_sir(toks, sir, diag, ls, SO_FSLOAD, fty, tk);
                if (hs < 0 || hl < 0) {
                    return;
                }
                sir[hl].a = hs as I32;
                sir[hl].b = sk as I32;
                sir[hl].c = j as I32;
                give(ls, VIEW_ARG - hs, want, bfirst, hl + 1);
                return;
            }
            if (fty >= T_STRUCT) {
                I64 hr = field_ref(toks, sir, slots, diag, ls, sk, j, tk);
                if (hr < 0) { return; }
                give(ls, VIEW_ARG - hr, fty, bfirst, ls[0].nsir);
                return;
            }
            if (fty > 255) {
                // A whole array field as a value (task 2.14 indexes it only).
                unsupported(toks, diag, ls, tk, U_STRUCT);
                return;
            }
            I64 i = def_sir(toks, sir, diag, ls, SO_FLOAD, fty, tk);
            if (i < 0) {
                return;
            }
            sir[i].a = sk as I32;
            sir[i].c = j as I32;
            give(ls, i, fty, bfirst, i + 1);
        case parse.N_INDEX:
            if ((sem[x].flags & resolve.SEM_DEREF) != 0) {
                deref_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f, place);
                return;
            }
            if (st[f].h == 1 || (st[f].state == 0 && general_index(text, toks, nodes, sem, funcs, slots, ls, x))) {
                st[f].h = 1;
                index_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
                return;
            }
            I64[1] afj;
            I64 ak = -1;
            I64 fb = nodes[x].a as I64;
            Bool nested = nodes[fb].kind == parse.N_FIELD && nodes[nodes[fb].a as I64].kind != parse.N_NAME;
            if (nested) {
                if (st[f].state == 0) {
                    st[f].state = 1;
                    _ = push(toks, st, diag, ls, K_EXPR, nodes[fb].a as I64, T_NONE, tk);
                    return;
                }
                if (st[f].state == 1) {
                    if (ls[0].rv > VIEW_ARG || ls[0].rv <= STR_ARG) {
                        unsupported(toks, diag, ls, tk, U_STRUCT); return;
                    }
                    st[f].a = (VIEW_ARG - ls[0].rv) as I32;
                    st[f].b = field_index(text, toks, slots, slots[st[f].a as I64].ty, nodes[fb].tok as I64) as I32;
                    st[f].c = ls[0].rfirst as I32;
                    st[f].state = 2;
                    _ = push(toks, st, diag, ls, K_EXPR, nodes[x].b as I64, T_I64, tk);
                    return;
                }
                ak = st[f].a as I64;
                afj[0] = st[f].b as I64;
            } else {
                ak = elem_base(text, toks, nodes, funcs, slots, diag, ls, x, afj);
                if (ak < 0) { return; }
                if (st[f].state == 0) {
                    st[f].state = 1;
                    _ = push(toks, st, diag, ls, K_EXPR, nodes[x].b as I64, T_I64, tk);
                    return;
                }
            }
            I64 first0 = ls[0].rfirst;
            if (nested) { first0 = st[f].c as I64; }
            I32 ety = base_elem(slots, ak, afj[0]);
            if (ety >= T_STRUCT) {
                I64 h = element_ref(toks, sir, slots, diag, ls, ety, ak, ls[0].rv, tk, afj[0]);
                if (h < 0) { return; }
                give(ls, VIEW_ARG - h, ety, first0, ls[0].nsir);
                return;
            }
            I64 i = element_of(toks, sir, slots, diag, ls, ak, ls[0].rv, tk, afj[0]);
            if (i < 0) { return; }
            kernel_step(toks, sir, funcs, diag, ls, tk);
            give(ls, i, sir[i].ty, first0, i + 1);
        case parse.N_UNARY:
            I32 op = nodes[x].op;
            if (op != scan.OP_SUB && op != scan.OP_TILDE && op != scan.OP_BANG) {
                unsupported(toks, diag, ls, tk, U_OPERATOR);
                return;
            }
            if (st[f].state == 0) {
                st[f].state = 1;
                I32 w = want;
                if (op == scan.OP_BANG) {
                    w = T_BOOL;
                }
                _ = push(toks, st, diag, ls, K_EXPR, nodes[x].a as I64, w, tk);
                return;
            }
            I32 ty = ls[0].rty as I32;
            I64 i = def_sir(toks, sir, diag, ls, SO_UN, ty, tk);
            if (i < 0) {
                return;
            }
            sir[i].a = ls[0].rv as I32;
            if (op == scan.OP_SUB) {
                sir[i].c = U_NEG;
                site(sir, ls, i);
            } else if (op == scan.OP_TILDE) {
                sir[i].c = U_NOT;
            } else {
                sir[i].c = U_LNOT;
            }
            if (op == scan.OP_SUB) {
                kernel_step(toks, sir, funcs, diag, ls, tk);
            }
            give(ls, i, ty, ls[0].rfirst, i + 1);
        case parse.N_BINARY:
            binary_op(nodes[x].op, bo);
            if (bo[0] == 0) {
                unsupported(toks, diag, ls, tk, U_OPERATOR);
                return;
            }
            Bool shift = bo[0] == B_SHL as I64 || bo[0] == B_SHR as I64;
            if (st[f].state == 0) {
                st[f].state = 1;
                _ = push(toks, st, diag, ls, K_EXPR, nodes[x].a as I64, want, tk);
                return;
            }
            if (st[f].state == 1) {
                keep(st, ls, f);
                st[f].state = 2;
                I32 w = want;
                if (shift) {
                    w = T_NONE;
                } else if (st[f].b != T_NONE) {
                    w = st[f].b;
                }
                _ = push(toks, st, diag, ls, K_EXPR, nodes[x].b as I64, w, tk);
                return;
            }
            I32 lty = st[f].b;
            I32 rty = ls[0].rty as I32;
            if (shift) {
                if (rty == T_NONE) {
                    settle(sir, ls[0].rfirst, ls[0].rend, T_I64);
                }
            } else if (lty == T_NONE && rty != T_NONE) {
                settle(sir, st[f].c as I64, st[f].d as I64, rty);
                lty = rty;
            }
            I64 i = def_sir(toks, sir, diag, ls, SO_BIN, lty, tk);
            if (i < 0) {
                return;
            }
            sir[i].a = st[f].a;
            sir[i].b = ls[0].rv as I32;
            sir[i].c = bo[0] as I32;
            sir[i].f = bo[1] as I32;
            if (bin_faults(bo[0] as I32, bo[1] as I32)) {
                site(sir, ls, i);
            }
            kernel_bin_step(toks, sir, funcs, diag, ls, bo[0], tk);
            I64 first = st[f].c as I64;
            give(ls, i, lty, first, i + 1);
        case parse.N_COMPARE:
            if (st[f].state == 0) {
                st[f].state = 1;
                _ = push(toks, st, diag, ls, K_EXPR, nodes[x].a as I64, T_NONE, tk);
                return;
            }
            if (st[f].state == 1) {
                keep(st, ls, f);
                st[f].state = 2;
                _ = push(toks, st, diag, ls, K_EXPR, nodes[x].b as I64, st[f].b, tk);
                return;
            }
            I32 lty = st[f].b;
            I32 rty = ls[0].rty as I32;
            if (lty == T_NONE && rty == T_NONE) {
                settle(sir, st[f].c as I64, ls[0].rend, T_I64);
                lty = T_I64;
            } else if (lty == T_NONE) {
                settle(sir, st[f].c as I64, st[f].d as I64, rty);
                lty = rty;
            } else if (rty == T_NONE) {
                settle(sir, ls[0].rfirst, ls[0].rend, lty);
            }
            I64 i = def_sir(toks, sir, diag, ls, SO_CMP, T_BOOL, tk);
            if (i < 0) {
                return;
            }
            sir[i].a = st[f].a;
            sir[i].b = ls[0].rv as I32;
            sir[i].c = compare_op(nodes[x].op);
            sir[i].f = lty;
            I64 first = st[f].c as I64;
            give(ls, i, T_BOOL, first, i + 1);
        case parse.N_LOGICAL:
            if (st[f].state == 0) {
                st[f].state = 1;
                _ = push(toks, st, diag, ls, K_EXPR, nodes[x].a as I64, T_BOOL, tk);
                return;
            }
            if (st[f].state == 1) {
                st[f].h = ls[0].rfirst as I32;
                I64 left = ls[0].rv;
                I64 slot = add_slot(toks, slots, diag, ls, -1, T_BOOL, SK_HIDDEN, tk);
                I64 dl = add_sir(toks, sir, diag, ls, SO_LOCAL, T_BOOL, tk);
                I64 sv = add_sir(toks, sir, diag, ls, SO_STORE, T_BOOL, tk);
                I64 cond = left;
                if (nodes[x].op == scan.OP_OR) {
                    cond = def_sir(toks, sir, diag, ls, SO_UN, T_BOOL, tk);
                    if (cond >= 0) {
                        sir[cond].a = left as I32;
                        sir[cond].c = U_LNOT;
                    }
                }
                I64 ifx = add_sir(toks, sir, diag, ls, SO_IF, T_NONE, tk);
                _ = add_sir(toks, sir, diag, ls, SO_ARM, T_NONE, tk);
                I64 then = add_sir(toks, sir, diag, ls, SO_THEN, T_NONE, tk);
                if (then < 0) {
                    return;
                }
                sir[dl].a = slot as I32;
                sir[sv].a = slot as I32;
                sir[sv].b = left as I32;
                sir[then].a = cond as I32;
                st[f].e = slot as I32;
                st[f].f = ifx as I32;
                st[f].g = then as I32;
                st[f].state = 2;
                _ = push(toks, st, diag, ls, K_EXPR, nodes[x].b as I64, T_BOOL, tk);
                return;
            }
            I64 sv = add_sir(toks, sir, diag, ls, SO_STORE, T_BOOL, tk);
            I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
            I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
            I64 ld = def_sir(toks, sir, diag, ls, SO_LOAD, T_BOOL, tk);
            if (ld < 0) {
                return;
            }
            sir[sv].a = st[f].e;
            sir[sv].b = ls[0].rv as I32;
            sir[ae].a = st[f].g;
            sir[ae].b = st[f].f;
            sir[en].a = st[f].f;
            sir[ld].a = st[f].e;
            I64 first = st[f].h as I64;
            give(ls, ld, T_BOOL, first, ld + 1);
        case parse.N_COND:
            cond_step(toks, nodes, sem, sir, slots, st, diag, ls, f, want);
        case parse.N_CATCH:
            catch_step(toks, nodes, sir, slots, st, diag, ls, f);
        case parse.N_CONVERT:
            I32 op = nodes[x].op;
            I32 to = type_of(toks, nodes, nodes[x].b as I64);
            Bool trial = op == scan.OP_AS_TRY;
            if ((op != parse.CONV_AS && op != scan.OP_AS_WRAP && !trial) || to == T_NONE || nodes[x].c >= 0) {
                unsupported(toks, diag, ls, tk, U_OPERATOR);
                return;
            }
            I32 form = 0;
            if (op == scan.OP_AS_WRAP) {
                form = 1;
            } else if (trial) {
                form = 2;
            }
            I64 a = nodes[x].a as I64;
            if (st[f].state == 0 && !trial && (nodes[a].kind == parse.N_LIT || nodes[a].kind == parse.N_NEGLIT)) {
                // A literal source (SPEC-01 IM-26): converted from its value here; the
                // checker has decided a checked conversion (D-17).
                I64 lt = nodes[a].tok as I64;
                if (nodes[a].kind == parse.N_NEGLIT) {
                    lt = nodes[a].c as I64;
                }
                if (!literal_value(text, toks, lt, lit) || to == T_BOOL) {
                    unsupported(toks, diag, ls, tk, U_LITERAL);
                    return;
                }
                if (nodes[a].kind == parse.N_NEGLIT) {
                    lit[0] = 0 -% lit[0];
                }
                I64 i = def_sir(toks, sir, diag, ls, SO_CONST, to, nodes[a].tok as I64);
                if (i < 0) {
                    return;
                }
                sir[i].val = wrap_to(to, lit[0]);
                // Inside a dispatch the conversion of a literal is a counted step (IM-113).
                kernel_step(toks, sir, funcs, diag, ls, tk);
                give(ls, i, to, i, i + 1);
                return;
            }
            if (st[f].state == 0) {
                st[f].state = 1;
                _ = push(toks, st, diag, ls, K_EXPR, a, T_NONE, tk);
                return;
            }
            I32 from = ls[0].rty as I32;
            if (from == T_NONE) {
                settle(sir, ls[0].rfirst, ls[0].rend, T_I64);
                from = T_I64;
            }
            if (to == T_BOOL) {
                unsupported(toks, diag, ls, tk, U_OPERATOR);
                return;
            }
            I64 i = def_sir(toks, sir, diag, ls, SO_AS, to, tk);
            if (i < 0) {
                return;
            }
            sir[i].a = ls[0].rv as I32;
            sir[i].c = form;
            sir[i].f = from;
            if (form == 0 && from != T_BOOL) {
                site(sir, ls, i);
            }
            if (trial) {
                // `as?` (SPEC-04 LS-96): a union, the converted value and its tag.
                I64 g = def_sir(toks, sir, diag, ls, SO_ETAG, T_U16, tk);
                if (g < 0) {
                    return;
                }
                sir[g].a = i as I32;
                kernel_step(toks, sir, funcs, diag, ls, tk);
                give(ls, g, T_U16, ls[0].rfirst, g + 1);
                return;
            }
            kernel_step(toks, sir, funcs, diag, ls, tk);
            give(ls, i, to, ls[0].rfirst, i + 1);
        case parse.N_CALL:
            I64 cn = nodes[x].a as I64;
            I32 cty = T_NONE;
            if ((sem[x].flags & resolve.SEM_MEMBER) != 0) {
                member_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
                return;
            }
            if ((sem[x].flags & resolve.SEM_ARRAYFN) != 0) {
                arrayfn_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
                return;
            }
            if (nodes[cn].kind == parse.N_NAME && (nodes[cn].flags & parse.F_PAREN) == 0) {
                I64 bt = nodes[cn].tok as I64;
                I64 bid = resolve.builtin_id(text, toks[bt].start as I64, toks[bt].len as I64);
                if (bid != 0) {
                    builtin_step(text, toks, nodes, sem, sir, funcs, st, diag, ls, f, bid, want);
                    return;
                }
            }
            if (nodes[cn].kind == parse.N_NAME) {
                cty = struct_type_name(text, toks, slots, ls, nodes[cn].tok as I64);
            } else if (nodes[cn].kind == parse.N_FIELD) {
                I64 al = canon_alias(text, toks, nodes, ls, nodes[nodes[cn].a as I64].tok as I64);
                cty = import_struct(text, toks, slots, ls, al, nodes[cn].tok as I64);
            }
            if (cty != T_NONE) {
                constructor_step(text, toks, nodes, sem, sir, slots, st, diag, ls, f, cty);
            } else if (nodes[cn].kind == parse.N_NAME && (nodes[cn].flags & parse.F_PAREN) == 0 &&
                    is_kernel(text, toks, funcs, ls, nodes[cn].tok as I64)) {
                dispatch_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
            } else {
                call_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
            }
        default:
            unsupported(toks, diag, ls, tk, U_EXPRESSION);
    }
}

// Argument i of call x, or -1.
I64 call_arg(in parse.Node[_] nodes, I64 x, I64 i) {
    I64 g = nodes[x].b as I64;
    I64 j = 0;
    while (g >= 0 && j < i) {
        g = nodes[g].next as I64;
        j += 1;
    }
    return g;
}

// A call of integer built-in id (box 07), frame f with context type want: its values in
// written order, each with the type of the first typed value before it, else the context
// when the result has the operand type (a rotation's count with none, then I64 when it is
// literal-only); then one SO_BUILTIN node. Frame: state the values lowered, a, e, g the
// values and b, f, h their types, c the first node, d the operand type found so far.
void builtin_step[n, t, ns, s, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout parse.Frame[s] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f, I64 id,
        I32 want) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[x].tok as I64;
    I64 nv = fold.builtin_values(id);
    Bool rot = id == fold.BI_ROTL || id == fold.BI_ROTR || id == fold.BI_SHL_RESULT;
    Bool same = fold.builtin_same(id);
    I64 start = 0;
    if (id == fold.BI_MULDIV) {
        start = 1;
    }
    I64 k = st[f].state as I64;
    if (k == 0) {
        st[f].c = ls[0].nsir as I32;
        st[f].d = T_NONE;
    } else {
        I32 vt = ls[0].rty as I32;
        if (rot && k == 2) {
            if (vt == T_NONE) {
                settle(sir, ls[0].rfirst, ls[0].rend, T_I64);
                vt = T_I64;
            }
        } else if (vt != T_NONE && st[f].d == T_NONE) {
            st[f].d = vt;
        }
        if (k == 1) {
            st[f].a = ls[0].rv as I32;
            st[f].b = vt;
        } else if (k == 2) {
            st[f].e = ls[0].rv as I32;
            st[f].f = vt;
        } else {
            st[f].g = ls[0].rv as I32;
            st[f].h = vt;
        }
    }
    if (k < nv) {
        st[f].state = (k + 1) as I32;
        I32 w = st[f].d;
        if (rot && k == 1) {
            w = T_NONE;
        } else if (w == T_NONE && same) {
            w = want;
        }
        _ = push(toks, st, diag, ls, K_EXPR, call_arg(nodes, x, start + k), w, tk);
        return;
    }
    I32 opty = st[f].d;
    if (opty == T_NONE && same) {
        opty = want;
    }
    if (opty == T_NONE && !same) {
        opty = T_I64;
    }
    if (opty != T_NONE) {
        settle(sir, st[f].c as I64, ls[0].nsir, opty);
    }
    I32 rty = opty;
    I64 mode = 0;
    I64 last = call_arg(nodes, x, start + nv);
    if (fold.builtin_mode(id) && last >= 0) {
        I64 mt = nodes[last].tok as I64;
        mode = resolve.round_mode(text, toks[mt].start as I64, toks[mt].len as I64);
    }
    if (id == fold.BI_UABS) {
        rty = opty + 0x10;
    } else if (id == fold.BI_MUL_FULL) {
        rty = opty + 1;
    } else if (id == fold.BI_MULDIV) {
        rty = resolve.int_class(toks[nodes[call_arg(nodes, x, 0)].tok as I64].aux & 255) as I32;
    }
    if (!is_int(opty) && opty != T_NONE) {
        unsupported(toks, diag, ls, tk, U_EXPRESSION);
        return;
    }
    if (fold.builtin_result(id)) {
        // A result-returning form (SPEC-01 IM-30, IM-188; box 12): SO_BIN of form 3, which
        // never faults, and its tag, a union.
        I64 rn = def_sir(toks, sir, diag, ls, SO_BIN, opty, tk);
        if (rn < 0) {
            return;
        }
        I64 g = def_sir(toks, sir, diag, ls, SO_ETAG, T_U16, tk);
        if (g < 0) {
            return;
        }
        sir[rn].a = st[f].a;
        sir[rn].b = st[f].e;
        sir[rn].c = ((B_ADD as I64) + id - fold.BI_ADD_RESULT) as I32;
        sir[rn].f = 3;
        sir[g].a = rn as I32;
        give(ls, g, T_U16, st[f].c as I64, g + 1);
        return;
    }
    I64 i = def_sir(toks, sir, diag, ls, SO_BUILTIN, rty, tk);
    if (i < 0) {
        return;
    }
    sir[i].a = st[f].a;
    sir[i].b = st[f].e;
    sir[i].c = st[f].g;
    sir[i].f = id as I32;
    sir[i].val = mode;
    if (rty != opty) {
        sir[i].val = mode + 256 * (opty as I64);
    }
    if (fold.builtin_faults(id)) {
        site(sir, ls, i);
    }
    kernel_step(toks, sir, funcs, diag, ls, tk);
    give(ls, i, rty, st[f].c as I64, i + 1);
}

// Evaluates constructor arguments in written order using the expression stack.
// Retains argument values until all arguments and declaration-order shape checks
// complete, then copy every field into the hidden result.
void constructor_step[s](in U8[_] text, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout Sir[_] sir, inout SirSlot[_] slots, inout parse.Frame[s] st,
        inout limits.CompilerDiag[_] diag, inout LState[_] ls, I64 f, I32 ty) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[x].tok as I64;
    I64 at = f;
    if (st[f].state == 0) {
        I64 h = add_slot(toks, slots, diag, ls, -1, ty, SK_STRUCT, tk);
        I64 i = add_sir(toks, sir, diag, ls, SO_LOCAL, ty, tk);
        if (h < 0 || i < 0) { return; }
        sir[i].a = h as I32;
        st[f].a = h as I32;
        st[f].b = nodes[x].b;
        st[f].c = 0;
        st[f].e = i as I32;
        st[f].g = 0;
        st[f].state = 1;
    } else {
        I64 j = st[f].d as I64;
        I32 fty = field_type(slots, ty, j);
        I64 sp = ls[0].sp;
        if (sp == ls[0].cap) {
            stop_at(toks, diag, ls, limits.C_NESTING, tk, limits.LIM_STACK, sp); return;
        }
        copy_frame(st, sp, f);
        st[f].kind = K_VALUE;
        st[f].a = ls[0].rv as I32;
        if (field_array(fty) || fty >= T_STRUCT) {
            // An array field needs a place to copy from, as before the shape checks.
            if (field_array(fty) && ls[0].rv > VIEW_ARG) {
                unsupported(toks, diag, ls, nodes[st[f].b as I64].tok as I64, U_STRUCT); return;
            }
            st[f].a = (VIEW_ARG - ls[0].rv) as I32;
        }
        st[f].b = j as I32;
        st[f].c = fty;
        st[f].d = nodes[st[sp].b as I64].tok;
        st[f].e = -1;
        ls[0].sp = sp + 1;
        at = sp;
        st[at].g += 1;
        st[at].b = nodes[st[at].b as I64].next;
        st[at].c += 1;
    }
    I64 arg = st[at].b as I64;
    if (arg < 0) {
        I64 saved = st[at].g as I64;
        // Permutes completed arguments by their unique field ordinal in linear time.
        // Each swap puts one argument in its final slot; expression values stay captured.
        I64 swaps = 0;
        for v in at - saved..at {
            while (st[v].b as I64 != v - (at - saved)) {
                I64 to = at - saved + st[v].b as I64;
                if (to < at - saved || to >= at || swaps >= saved) {
                    unsupported(toks, diag, ls, tk, U_STRUCT); return;
                }
                I32 tmp = st[v].a; st[v].a = st[to].a; st[to].a = tmp;
                tmp = st[v].b; st[v].b = st[to].b; st[to].b = tmp;
                tmp = st[v].c; st[v].c = st[to].c; st[to].c = tmp;
                tmp = st[v].d; st[v].d = st[to].d; st[to].d = tmp;
                tmp = st[v].e; st[v].e = st[to].e; st[to].e = tmp;
                swaps += 1;
            }
        }
        for v in at - saved..at {
            if (field_array(st[v].c) && slot_extent(slots, st[v].a as I64) < 0) {
                I64 sh = add_sir(toks, sir, diag, ls, SO_COPY_SHAPE, T_NONE, tk);
                if (sh < 0) { return; }
                sir[sh].a = st[v].a;
                sir[sh].b = 0;
                sir[sh].c = -1;
                sir[sh].val = array_extent(st[v].c);
                site(sir, ls, sh);
                st[v].e = sh as I32;
            }
        }
        for v in at - saved..at {
            I32 op = SO_FSTORE;
            if (st[v].c >= T_STRUCT) { op = SO_FSCOPY; }
            if (field_array(st[v].c)) { op = SO_FACOPY; }
            I64 i = add_sir(toks, sir, diag, ls, op, st[v].c, st[v].d as I64);
            if (i < 0) { return; }
            sir[i].a = st[at].a;
            sir[i].b = st[v].a;
            sir[i].c = st[v].b;
            if (op == SO_FACOPY) { sir[i].f = st[v].e; }
        }
        ls[0].sp = at - saved + 1;
        give(ls, VIEW_ARG - (st[at].a as I64), ty, st[at].e as I64, ls[0].nsir);
        return;
    }
    I64 j = st[at].c as I64;
    I64 value = arg;
    if (nodes[arg].kind == parse.N_NAMEDARG) {
        j = field_index(text, toks, slots, ty, nodes[arg].tok as I64);
        value = nodes[arg].a as I64;
    }
    I32 fty = field_type(slots, ty, j);
    st[at].d = j as I32;
    if (fty >= T_STRUCT && !field_array(fty)) { fty = -fty; }
    _ = push(toks, st, diag, ls, K_EXPR, value, fty, nodes[value].tok as I64);
}

// One step of `c ? x : y` (SPEC-04 LS-154, task 2.14): an `if` over a hidden slot of the
// result type, so only the selected operand is evaluated. The condition's nodes, SO_LOCAL,
// SO_IF, SO_ARM, SO_THEN, the first operand, SO_STORE, SO_ARM_END, SO_ELSE, the second
// operand, SO_STORE, SO_END, SO_LOAD. The slot's type is the first operand's, else the
// second's (a literal-only operand is settled to it); a type other than an integer or Bool
// is C9102 U_EXPRESSION. With neither typed (no context), the value is literal-only: its
// context settles it (SPEC-04 LS-56 rules 4 and 8, as the checker does), and lower_expr
// then gives the slot its load's type (hidden_types; G-C2 review COR-5). Frame f: a the
// SO_LOCAL, b the first operand's type, c its SO_STORE, d the first node of the second
// operand, e the slot, f the SO_IF, g the SO_THEN, h the first node of the whole expression.
void cond_step[t, m, ns, r](in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls,
        I64 f, I32 want) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[x].tok as I64;
    if (st[f].state == 0) {
        st[f].state = 1;
        _ = push(toks, st, diag, ls, K_EXPR, nodes[x].a as I64, T_BOOL, tk);
        return;
    }
    if (st[f].state == 1) {
        st[f].h = ls[0].rfirst as I32;
        I64 cond = ls[0].rv;
        I64 slot = add_slot(toks, slots, diag, ls, -1, T_NONE, SK_HIDDEN, tk);
        I64 dl = add_sir(toks, sir, diag, ls, SO_LOCAL, T_NONE, tk);
        I64 ifx = add_sir(toks, sir, diag, ls, SO_IF, T_NONE, tk);
        _ = add_sir(toks, sir, diag, ls, SO_ARM, T_NONE, tk);
        I64 then = add_sir(toks, sir, diag, ls, SO_THEN, T_NONE, tk);
        if (then < 0) {
            return;
        }
        sir[dl].a = slot as I32;
        sir[then].a = cond as I32;
        st[f].a = dl as I32;
        st[f].e = slot as I32;
        st[f].f = ifx as I32;
        st[f].g = then as I32;
        st[f].state = 2;
        _ = push(toks, st, diag, ls, K_EXPR, nodes[x].b as I64, want, tk);
        return;
    }
    if (st[f].state == 2) {
        I64 sv = add_sir(toks, sir, diag, ls, SO_STORE, T_NONE, tk);
        I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
        I64 el = add_sir(toks, sir, diag, ls, SO_ELSE, T_NONE, tk);
        if (el < 0) {
            return;
        }
        sir[sv].a = st[f].e;
        sir[sv].b = ls[0].rv as I32;
        sir[ae].a = st[f].g;
        sir[ae].b = st[f].f;
        st[f].b = ls[0].rty as I32;
        st[f].c = sv as I32;
        st[f].d = (el + 1) as I32;
        st[f].state = 3;
        I32 w = want;
        if (st[f].b != T_NONE) {
            w = st[f].b;
        }
        _ = push(toks, st, diag, ls, K_EXPR, nodes[x].c as I64, w, tk);
        return;
    }
    I32 ty = st[f].b;
    I32 ety = ls[0].rty as I32;
    if (ty == T_NONE && ety != T_NONE) {
        settle(sir, (st[f].g + 1) as I64, st[f].c as I64, ety);
        ty = ety;
    } else if (ety == T_NONE && ty != T_NONE) {
        settle(sir, st[f].d as I64, ls[0].rend, ty);
    }
    if (ty != T_NONE && !is_int(ty) && ty != T_BOOL) {
        unsupported(toks, diag, ls, tk, U_EXPRESSION);
        return;
    }
    I64 sv = add_sir(toks, sir, diag, ls, SO_STORE, ty, tk);
    I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
    I64 ld = def_sir(toks, sir, diag, ls, SO_LOAD, ty, tk);
    if (ld < 0) {
        return;
    }
    I64 slot = st[f].e as I64;
    slots[slot].ty = ty;
    sir[st[f].a as I64].ty = ty;
    sir[st[f].c as I64].ty = ty;
    sir[sv].a = slot as I32;
    sir[sv].b = ls[0].rv as I32;
    sir[en].a = st[f].f;
    sir[en].c = 1;
    sir[ld].a = slot as I32;
    give(ls, ld, ty, st[f].h as I64, ld + 1);
}

// The value of a view argument naming slot k is VIEW_ARG - k; that of a string literal
// whose SO_SDATA node is i is STR_ARG - i.
const I64 VIEW_ARG = -1073741824;
const I64 STR_ARG = -1879048192;

// The static extent of view argument value v, or -1.
I64 arg_extent(in Sir[_] sir, in SirSlot[_] slots, I64 v) {
    if (v <= STR_ARG) {
        return sir[STR_ARG - v].c as I64;
    }
    return slot_extent(slots, VIEW_ARG - v);
}

// The extent of dimension d of view parameter j (after the size parameters) of function fn:
// a literal's value, -1 for `_`, or -2 - z for size parameter z.
I64 param_code(in parse.Node[_] nodes, in resolve.Sem[_] sem, in SirFunc[_] funcs, in SirSlot[_] slots, I64 fn,
        I64 j, I64 d) {
    I64 q = (funcs[fn].pslot0 as I64) + size_count(nodes, funcs, fn) + j;
    if (slots[q].kind == SK_VIEW) {
        I64 c = array_extent(slots[q].ty);
        if (c == VIEW_ANY as I64) {
            return -1;
        }
        if (c >= VIEW_SIZE as I64) {
            return -2 - (c - (VIEW_SIZE as I64));
        }
        return c - 1;
    }
    I64 x = nodes[funcs[fn].node as I64].b as I64;
    I64 g = 0;
    while (g < j) {
        x = nodes[x].next as I64;
        g += 1;
    }
    I64 dc = resolve.dim_code(sem[x].ty, d);
    if (dc == 0) {
        return -1;
    }
    if (dc >= resolve.SIZE_CODE) {
        return -2 - (dc - resolve.SIZE_CODE);
    }
    return dc - 1;
}

// The first dimension, in parameter then dimension order, of the view parameters among the
// first k of function fn whose extent has code c (param_code): res[0] the parameter, res[1]
// the dimension; res[0] -1 for none.
void first_code(in parse.Node[_] nodes, in resolve.Sem[_] sem, in SirFunc[_] funcs, in SirSlot[_] slots, I64 fn,
        I64 k, I64 c, inout I64[_] res) {
    I64 p0 = (funcs[fn].pslot0 as I64) + size_count(nodes, funcs, fn);
    res[0] = -1;
    res[1] = -1;
    for j in 0..k {
        if (res[0] < 0 && (slots[p0 + j].kind == SK_VIEW || slots[p0 + j].kind == SK_NVIEW)) {
            for d in 0..slot_rank(slots, p0 + j) {
                if (res[0] < 0 && param_code(nodes, sem, funcs, slots, fn, j, d) == c) {
                    res[0] = j;
                    res[1] = d;
                }
            }
        }
    }
}

// The entry checks bind.shape of a call of function fn with a view parameter of rank 2 to 4
// (SPEC-04 LS-117, LS-123): for each view parameter j in order and each of its dimensions,
// a literal extent, or a size parameter that an earlier dimension binds, against the extent
// of the argument (SO_SHAPE; f the dimension, plus 16 when the parameter's rank is above 1;
// e 1, plus the dimension of slot c when c is a slot). The k argument values are in frames
// at - k to at - 1. false on error.
Bool view_shapes[t, ns, r](in scan.Token[t] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, in SirSlot[_] slots, in parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 fn, I64 k, I64 at, I64 tk) {
    I64 p0 = (funcs[fn].pslot0 as I64) + size_count(nodes, funcs, fn);
    I64[2] fc;
    for j in 0..k {
        I64 q = p0 + j;
        if (slots[q].kind == SK_VIEW || slots[q].kind == SK_NVIEW) {
            I64 jv = st[at - k + j].a as I64;
            if (jv <= STR_ARG) {
                unsupported(toks, diag, ls, tk, U_VIEW);
                return false;
            }
            I64 js = VIEW_ARG - jv;
            I64 rk = slot_rank(slots, q);
            for d in 0..rk {
                I64 c = param_code(nodes, sem, funcs, slots, fn, j, d);
                I64 rs = -1;
                I64 rd = 0;
                Bool check = c >= 0;
                if (c <= -2) {
                    first_code(nodes, sem, funcs, slots, fn, j + 1, c, fc);
                    if (fc[0] >= 0 && (fc[0] < j || fc[1] < d)) {
                        rs = VIEW_ARG - (st[at - k + fc[0]].a as I64);
                        rd = fc[1];
                        check = slots[js].kind == SK_NVIEW || slots[rs].kind == SK_NVIEW ||
                            slot_extent(slots, js) < 0 || slot_extent(slots, rs) < 0;
                    }
                } else if (check && slots[js].kind != SK_NVIEW && slot_extent(slots, js) == c) {
                    check = false;
                }
                if (check) {
                    I64 sh = add_sir(toks, sir, diag, ls, SO_SHAPE, T_NONE, tk);
                    if (sh < 0) {
                        return false;
                    }
                    sir[sh].a = js as I32;
                    sir[sh].b = j as I32;
                    sir[sh].c = rs as I32;
                    if (rs < 0) {
                        sir[sh].val = c;
                    }
                    sir[sh].f = d as I32;
                    if (rk > 1) {
                        sir[sh].f = (d + 16) as I32;
                    }
                    sir[sh].e = (1 + rd) as I32;
                    site(sir, ls, sh);
                }
            }
        }
    }
    return true;
}

// The entry alias checks bind.alias of a call whose arguments include a view of box 09 (a
// slice, a partial index, a local of rank 2 to 4): for each pair i < x of view parameters
// of which one is `inout`, when an argument is such a view, SO_CALIAS with the `inout` one
// first (i when both are; SPEC-04 LS-121, `cint_ref` _bind_args). A pair of plain arrays
// and view parameters is decided when the module is checked (C5010).
Bool call_aliases[t, ns, r](in scan.Token[t] toks, in parse.Node[_] nodes, inout Sir[ns] sir, in SirFunc[_] funcs,
        in SirSlot[_] slots, in parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 fn, I64 k,
        I64 at, I64 tk) {
    I64 p0 = (funcs[fn].pslot0 as I64) + size_count(nodes, funcs, fn);
    for i in 0..k {
        for x in i + 1..k {
            I64 vi = st[at - k + i].a as I64;
            I64 vx = st[at - k + x].a as I64;
            Bool views = (slots[p0 + i].kind == SK_VIEW || slots[p0 + i].kind == SK_NVIEW) &&
                (slots[p0 + x].kind == SK_VIEW || slots[p0 + x].kind == SK_NVIEW) && vi > STR_ARG && vx > STR_ARG;
            if (views && (slots[p0 + i].live == 2 || slots[p0 + x].live == 2) &&
                    (slots[VIEW_ARG - vi].kind == SK_NVIEW || slots[VIEW_ARG - vx].kind == SK_NVIEW)) {
                I64 pi = i;
                I64 oi = x;
                if (slots[p0 + i].live != 2) {
                    pi = x;
                    oi = i;
                }
                I64 g = add_sir(toks, sir, diag, ls, SO_CALIAS, T_NONE, tk);
                if (g < 0) {
                    return false;
                }
                sir[g].a = (VIEW_ARG - (st[at - k + pi].a as I64)) as I32;
                sir[g].b = (VIEW_ARG - (st[at - k + oi].a as I64)) as I32;
                sir[g].c = pi as I32;
                sir[g].f = oi as I32;
                site(sir, ls, g);
            }
        }
    }
    return true;
}

// One step of a call: frame f holds e the callee, g the argument count so far, h the
// next argument node; the finished arguments are value frames below it.
void call_step[n, t, m, ns, s, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[s] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 callee = nodes[x].a as I64;
    I64 tk = nodes[callee].tok as I64;
    I64 at = f;
    if (st[f].state == 0) {
        I64 fn = -1;
        if (in_kernel(funcs, ls)) {
            // A call from a kernel body: the callee's operations count toward the
            // work-item's steps (SPEC-01 IM-113), which a function of B1 does not keep.
            unsupported(toks, diag, ls, tk, U_CALL);
            return;
        }
        if (nodes[callee].kind == parse.N_FIELD) {
            fn = find_import(text, toks, funcs, ls, nodes[nodes[callee].a as I64].tok as I64, tk);
            if (fn < 0 || (funcs[fn].flags & (FN_ICONST | FN_ISTRUCT)) != 0) {
                unsupported(toks, diag, ls, tk, U_IMPORT);
                return;
            }
        } else if (nodes[callee].kind != parse.N_NAME || (nodes[callee].flags & parse.F_PAREN) != 0) {
            unsupported(toks, diag, ls, nodes[x].tok as I64, U_CALL);
            return;
        } else {
            fn = find_func(text, toks, funcs, ls, tk);
        }
        if (fn < 0 || (funcs[fn].flags & FN_SCRIPT) != 0) {
            unsupported(toks, diag, ls, tk, U_CALL);
            return;
        }
        st[f].e = fn as I32;
        st[f].g = 0;
        st[f].h = nodes[x].b;
        st[f].c = ls[0].nsir as I32;
        st[f].state = 1;
    } else {
        // An argument is finished: move this frame up and leave the argument's value
        // in a value frame where it was.
        I64 sp = ls[0].sp;
        if (sp == ls[0].cap) {
            stop_at(toks, diag, ls, limits.C_NESTING, tk, limits.LIM_STACK, sp);
            return;
        }
        copy_frame(st, sp, f);
        st[f].kind = K_VALUE;
        st[f].a = ls[0].rv as I32;
        st[f].b = ls[0].rfirst as I32;
        ls[0].sp = sp + 1;
        at = sp;
        st[at].g += 1;
        st[at].h = nodes[st[at].h as I64].next;
    }
    I64 fn = st[at].e as I64;
    I64 arg = st[at].h as I64;
    I64 k = st[at].g as I64;
    I64 nsz = size_count(nodes, funcs, fn);
    I64 p0 = (funcs[fn].pslot0 as I64) + nsz;
    if (arg >= 0) {
        if (nodes[arg].kind == parse.N_NAMEDARG || k + nsz >= funcs[fn].nparam as I64) {
            unsupported(toks, diag, ls, nodes[arg].tok as I64, U_CALL);
            return;
        }
        I32 pty = slots[p0 + k].ty;
        Bool box09 = (nodes[arg].kind == parse.N_INDEX || nodes[arg].kind == parse.N_CALL) &&
            (slots[p0 + k].kind == SK_VIEW || slots[p0 + k].kind == SK_NVIEW) && resolve.is_array(sem[arg].ty);
        if ((slots[p0 + k].kind == SK_VIEW || slots[p0 + k].kind == SK_NVIEW || slots[p0 + k].kind == SK_SPARAM ||
                slots[p0 + k].kind == SK_SREF) && !box09 &&
                nodes[arg].kind != parse.N_NAME &&
                !((nodes[arg].kind == parse.N_FIELD || nodes[arg].kind == parse.N_INDEX) &&
                (slots[p0 + k].kind == SK_SPARAM || slots[p0 + k].kind == SK_SREF)) &&
                !(nodes[arg].kind == parse.N_FIELD && slots[p0 + k].kind == SK_VIEW) &&
                !(nodes[arg].kind == parse.N_CALL && slots[p0 + k].kind == SK_SPARAM) &&
                !(nodes[arg].kind == parse.N_STRING && slots[p0 + k].kind == SK_VIEW &&
                array_elem(slots[p0 + k].ty) == T_U8)) {
            unsupported(toks, diag, ls, nodes[arg].tok as I64, U_VIEW);
            return;
        }
        if (slots[p0 + k].kind == SK_SREF || slots[p0 + k].kind == SK_SPARAM) { pty = -pty; }
        _ = push(toks, st, diag, ls, K_EXPR, arg, pty, tk);
        return;
    }
    if (k + nsz != funcs[fn].nparam as I64) {
        unsupported(toks, diag, ls, tk, U_CALL);
        return;
    }
    I64 first = st[at].c as I64;
    if (k > 0) {
        first = st[at - k].b as I64;
    }
    // A view parameter with a static extent, or a size parameter bound by two views, whose
    // arguments' extents are known only at run time: the entry check E_SHAPE (SPEC-04
    // LS-117, LS-123; task 2.14), an SO_SHAPE node per such argument after the arguments
    // and before the call; per dimension when a view parameter has rank 2 to 4 (view_shapes).
    Bool nview = false;
    for j in 0..k {
        nview = nview || slots[p0 + j].kind == SK_NVIEW;
    }
    if (nview && !view_shapes(toks, nodes, sem, sir, funcs, slots, st, diag, ls, fn, k, at, tk)) {
        return;
    }
    for j in 0..k {
        if (slots[p0 + j].kind == SK_VIEW && !nview) {
            I64 c = array_extent(slots[p0 + j].ty);
            I64 jv = st[at - k + j].a as I64;
            // ref: the value of the first view argument bound to the same size parameter,
            // or -1 (a view argument's value is VIEW_ARG - slot, below -1).
            I64 ref = -1;
            Bool dyn = arg_extent(sir, slots, jv) < 0;
            if (c >= VIEW_SIZE as I64 && c != VIEW_ANY as I64) {
                // Against the first view bound to the same size parameter.
                dyn = false;
                I64 q = 0;
                while (q < j && ref == -1) {
                    if (slots[p0 + q].kind == SK_VIEW && array_extent(slots[p0 + q].ty) == c) {
                        ref = st[at - k + q].a as I64;
                    }
                    q += 1;
                }
                dyn = ref != -1 && (arg_extent(sir, slots, jv) < 0 || arg_extent(sir, slots, ref) < 0);
            } else if (c == VIEW_ANY as I64) {
                dyn = false;
            }
            if (dyn && (jv <= STR_ARG || (ref != -1 && ref <= STR_ARG))) {
                unsupported(toks, diag, ls, tk, U_VIEW);
                return;
            }
            if (dyn) {
                I64 sh = add_sir(toks, sir, diag, ls, SO_SHAPE, T_NONE, tk);
                if (sh < 0) {
                    return;
                }
                sir[sh].a = (VIEW_ARG - jv) as I32;
                sir[sh].b = j as I32;
                sir[sh].c = -1;
                if (ref != -1) {
                    sir[sh].c = (VIEW_ARG - ref) as I32;
                } else {
                    sir[sh].val = c - 1;
                }
                site(sir, ls, sh);
            }
        }
    }
    if (!call_aliases(toks, nodes, sir, funcs, slots, st, diag, ls, fn, k, at, tk)) {
        return;
    }
    I64[2] fc;
    for z in 0..nsz {
        // The argument of size parameter z: the extent of the first view dimension bound
        // to it (f the dimension).
        first_code(nodes, sem, funcs, slots, fn, k, -2 - z, fc);
        I64 bj = fc[0];
        if (bj < 0) {
            unsupported(toks, diag, ls, tk, U_VIEW);
            return;
        }
        I64 g = add_sir(toks, sir, diag, ls, SO_ARG, T_NONE, tk);
        if (g < 0) {
            return;
        }
        I64 bv = st[at - k + bj].a as I64;
        if (bv <= STR_ARG) {
            sir[g].a = (STR_ARG - bv) as I32;
            sir[g].e = 5;
        } else {
            sir[g].a = (VIEW_ARG - bv) as I32;
            sir[g].e = 2;
            sir[g].f = fc[1] as I32;
        }
    }
    for j in at - k..at {
        I32 pk = slots[p0 + j - (at - k)].kind;
        I64 av = st[j].a as I64;
        if ((pk == SK_VIEW || pk == SK_NVIEW) && av <= VIEW_ARG && av > STR_ARG && leased(slots, ls[0].nslot, VIEW_ARG - av)) {
            // A callee's view does not keep the lease of an arena allocation (box 12).
            unsupported(toks, diag, ls, tk, U_MEMORY);
            return;
        }
        if ((pk == SK_ARENA_R || pk == SK_POOL_R) && (av > VIEW_ARG || av <= STR_ARG || !is_container(slots, VIEW_ARG - av) ||
                is_arena(slots, VIEW_ARG - av) != (pk == SK_ARENA_R))) {
            unsupported(toks, diag, ls, tk, U_MEMORY);
            return;
        }
        I64 g = add_sir(toks, sir, diag, ls, SO_ARG, T_NONE, tk);
        if (g < 0) {
            return;
        }
        sir[g].a = st[j].a;
        if (pk == SK_ARENA_R || pk == SK_POOL_R) {
            // An arena or a pool: its identifier.
            sir[g].a = (VIEW_ARG - av) as I32;
            sir[g].e = 9;
        } else if (slots[p0 + j - (at - k)].kind == SK_VIEW && (st[j].a as I64) <= STR_ARG) {
            sir[g].a = (STR_ARG - (st[j].a as I64)) as I32;
            sir[g].e = 4;
        } else if (slots[p0 + j - (at - k)].kind == SK_VIEW) {
            sir[g].a = (VIEW_ARG - (st[j].a as I64)) as I32;
            sir[g].e = 1;
        } else if (slots[p0 + j - (at - k)].kind == SK_NVIEW) {
            sir[g].a = (VIEW_ARG - (st[j].a as I64)) as I32;
            sir[g].e = 7;
        } else if (slots[p0 + j - (at - k)].kind == SK_SPARAM) {
            sir[g].a = (VIEW_ARG - (st[j].a as I64)) as I32;
            sir[g].e = 3;
        } else if (slots[p0 + j - (at - k)].kind == SK_SREF) {
            sir[g].a = (VIEW_ARG - (st[j].a as I64)) as I32;
            sir[g].e = 6;
        }
    }
    I32 rty = funcs[fn].result;
    I64 i = -1;
    I64 rh = -1;
    if (rty >= T_STRUCT) {
        // A struct result (task 2.14): a hidden struct slot receives it (f its slot + 1),
        // and the value is that slot, as a struct argument names one.
        rh = add_slot(toks, slots, diag, ls, -1, rty, SK_STRUCT, tk);
        i = add_sir(toks, sir, diag, ls, SO_CALL, rty, tk);
    } else if (rty == T_NONE) {
        i = add_sir(toks, sir, diag, ls, SO_CALL, T_NONE, tk);
    } else {
        i = def_sir(toks, sir, diag, ls, SO_CALL, rty, tk);
    }
    if (i < 0) {
        return;
    }
    sir[i].a = fn as I32;
    sir[i].c = (k + nsz) as I32;
    site(sir, ls, i);
    ls[0].sp = at - k + 1;
    if (rh >= 0) {
        sir[i].f = (rh + 1) as I32;
        give(ls, VIEW_ARG - rh, rty, first, i + 1);
        return;
    }
    if ((funcs[fn].flags & FN_ERRU) != 0) {
        // An error union result (box 12): the call's value, then its tag.
        I32 tty = func_etag(funcs, fn);
        I64 g = def_sir(toks, sir, diag, ls, SO_ETAG, tty, tk);
        if (g < 0) {
            return;
        }
        sir[g].a = i as I32;
        give(ls, g, tty, first, g + 1);
        return;
    }
    give(ls, i, rty, first, i + 1);
}

// The hidden slot of a `?:` whose operands are both literal-only has type 0 until its value
// is settled (cond_step): then the slot, its SO_LOCAL and its SO_STOREs among nodes `first`
// to the last take its SO_LOAD's type (G-C2 review COR-5). A load left untyped is C9102
// U_EXPRESSION at the `?`.
Bool hidden_types[t, r](in scan.Token[t] toks, inout Sir[_] sir, inout SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 first) {
    I64 end = ls[0].nsir;
    for i in first..end {
        I64 k = sir[i].a as I64;
        if ((sir[i].op & OP_MASK) == SO_LOAD && slots[k].kind == SK_HIDDEN && slots[k].ty == T_NONE) {
            if (sir[i].ty == T_NONE) {
                unsupported(toks, diag, ls, sir[i].tok as I64, U_EXPRESSION);
                return false;
            }
            slots[k].ty = sir[i].ty;
        }
    }
    for i in first..end {
        I32 op = sir[i].op & OP_MASK;
        if ((op == SO_LOCAL || op == SO_STORE) && sir[i].ty == T_NONE && slots[sir[i].a as I64].kind == SK_HIDDEN) {
            sir[i].ty = slots[sir[i].a as I64].ty;
        }
    }
    return true;
}

// Lowers expression x with context type `want` (T_NONE for none). Afterwards ls[0].rv is
// its value and ls[0].rty its type (I64 when it was literal-only without a context).
Bool lower_expr[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 x, I32 want) {
    I64 base = ls[0].sp;
    I64 first = ls[0].nsir;
    if (push(toks, st, diag, ls, K_EXPR, x, want, nodes[x].tok as I64) < 0) {
        return false;
    }
    while (ls[0].sp > base && ls[0].err == 0) {
        expr_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, ls[0].sp - 1);
    }
    if (ls[0].err != 0) {
        ls[0].sp = base;
        return false;
    }
    if (ls[0].rty == T_NONE as I64 && (ls[0].rv < 0 || sir[ls[0].rv].dst >= 0)) {
        I32 ty = want;
        if (ty == T_NONE) {
            ty = T_I64;
        }
        settle(sir, ls[0].rfirst, ls[0].rend, ty);
        ls[0].rty = ty as I64;
    }
    return hidden_types(toks, sir, slots, diag, ls, first);
}

// ---------------------------------------------------------------- box 12

// Tag v converted from type sty to type wty and moved by d, with wrapping: the result is a
// tag of the target set, so it is in range (SPEC-04 LS-97).
I64 shift_tag[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 v, I32 sty, I32 wty, I64 d, I64 tk) {
    I64 u = v;
    if (wty != sty) {
        u = def_sir(toks, sir, diag, ls, SO_AS, wty, tk);
        if (u < 0) {
            return -1;
        }
        sir[u].a = v as I32;
        sir[u].c = 1;
        sir[u].f = sty;
    }
    if (d != 0) {
        I64 k = def_sir(toks, sir, diag, ls, SO_CONST, wty, tk);
        I64 s = def_sir(toks, sir, diag, ls, SO_BIN, wty, tk);
        if (s < 0) {
            return -1;
        }
        sir[k].val = wrap_to(wty, d);
        sir[s].a = u as I32;
        sir[s].b = k as I32;
        sir[s].c = B_ADD;
        sir[s].f = 1;
        u = s;
    }
    return u;
}

// The node of the tag in set type w of tag v, a value of set type s that w holds (BX12-28):
// each base of s keeps its run of tags, moved by the difference of the base's offsets in w
// and in s. Adjacent runs that move alike are one; a single run is shift_tag, several one
// SO_WIDEN by the pair's SK_WIDEN slot, which the pair's first conversion in the module makes
// (lemma S: the runs are written once per pair, not at each use). v itself when s is w; -1
// after an error.
I64 convert_tag[t, ns, r](in scan.Token[t] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, inout SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls,
        I64 v, I64 s, I64 w, I64 tk) {
    I64 si = resolve.errset_index(s);
    I64 wi = resolve.errset_index(w);
    if (si == wi) {
        return v;
    }
    I64[256] bases;
    I64 nb = resolve.errset_bases(nodes, sem, s, bases);
    if (nb <= 0) {
        unsupported(toks, diag, ls, tk, U_EXPRESSION);
        return -1;
    }
    I64 runs = 0;
    I64 off = 0;
    I64 last = 0;
    for i in 0..nb {
        I64 d = resolve.errset_offset(nodes, sem, w, bases[i]) - off;
        if (i == 0 || d != last) {
            runs += 1;
        }
        last = d;
        off += resolve.base_size(nodes, bases[i]);
    }
    I32 sty = set_type(s);
    I32 wty = set_type(w);
    if (runs == 1) {
        return shift_tag(toks, sir, diag, ls, v, sty, wty, last, tk);
    }
    I64 k = 0;
    while (k < ls[0].nslot && !(slots[k].kind == SK_WIDEN && (slots[k].name as I64) == si &&
            (slots[k].ty as I64) == wi)) {
        k += 1;
    }
    if (k == ls[0].nslot) {
        // The pair's runs, in tag order: each ends at its last tag and adds its move.
        k = add_slot(toks, slots, diag, ls, si, wi as I32, SK_WIDEN, tk);
        if (k < 0) {
            return -1;
        }
        slots[k].live = 0;
        off = 0;
        I64 i = 0;
        while (i < nb) {
            I64 d = resolve.errset_offset(nodes, sem, w, bases[i]) - off;
            I64 end = off + resolve.base_size(nodes, bases[i]);
            I64 j = i + 1;
            while (j < nb && resolve.errset_offset(nodes, sem, w, bases[j]) - end == d) {
                end += resolve.base_size(nodes, bases[j]);
                j += 1;
            }
            I64 q = add_slot(toks, slots, diag, ls, end, d as I32, SK_WRUN, tk);
            if (q < 0) {
                return -1;
            }
            slots[q].live = 0;
            off = end;
            i = j;
        }
    }
    I64 u = def_sir(toks, sir, diag, ls, SO_WIDEN, wty, tk);
    if (u < 0) {
        return -1;
    }
    sir[u].a = v as I32;
    sir[u].b = k as I32;
    sir[u].f = sty;
    return u;
}

// K_WIDEN on frame f: the value of node x, of its own set, has been lowered; it converts to the
// set that sem[x].bits holds (SEM_WIDEN, BX12-28).
void widen_step[t, ns, r](in scan.Token[t] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 first = ls[0].rfirst;
    I64 w = sem[x].bits as% I64;
    I64 v = convert_tag(toks, nodes, sem, sir, slots, diag, ls, ls[0].rv, sem[x].ty, w, nodes[x].tok as I64);
    if (ls[0].err != 0) {
        return;
    }
    give(ls, v, set_type(w), first, ls[0].nsir);
}

// `e catch v` (SPEC-04 LS-130): the union e, then a hidden slot that takes v when e holds an
// error and e's value otherwise; v is lowered only on that path. Frame f: a the SO_ETAG, b the
// value node, e the slot, f the SO_IF, g the SO_THEN, h the first node. A `catch` with a
// block is its statement's (K_CATCH).
void catch_step[t, ns, r](in scan.Token[t] toks, in parse.Node[_] nodes, inout Sir[ns] sir,
        inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls,
        I64 f) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[x].tok as I64;
    if (nodes[x].c >= 0) {
        unsupported(toks, diag, ls, tk, U_EXPRESSION);
        return;
    }
    if (st[f].state == 0) {
        st[f].state = 1;
        _ = push(toks, st, diag, ls, K_EXPR, nodes[x].a as I64, T_NONE, tk);
        return;
    }
    if (st[f].state == 1) {
        I64 tag = ls[0].rv;
        if (tag < 0 || (sir[tag].op & OP_MASK) != SO_ETAG || sir[sir[tag].a as I64].dst < 0) {
            unsupported(toks, diag, ls, tk, U_EXPRESSION);
            return;
        }
        I64 val = sir[tag].a as I64;
        I32 vty = sir[val].ty;
        st[f].h = ls[0].rfirst as I32;
        I64 slot = add_slot(toks, slots, diag, ls, -1, vty, SK_HIDDEN, tk);
        I64 dl = add_sir(toks, sir, diag, ls, SO_LOCAL, vty, tk);
        I64 then = error_test(toks, sir, diag, ls, tag, tk);
        if (then < 0 || dl < 0) {
            return;
        }
        sir[dl].a = slot as I32;
        st[f].a = tag as I32;
        st[f].b = val as I32;
        st[f].e = slot as I32;
        st[f].f = (then - 2) as I32;
        st[f].g = then as I32;
        st[f].state = 2;
        _ = push(toks, st, diag, ls, K_EXPR, nodes[x].b as I64, vty, tk);
        return;
    }
    I64 val = st[f].b as I64;
    I32 vty = sir[val].ty;
    I64 slot = st[f].e as I64;
    store(toks, sir, diag, ls, slot, vty, ls[0].rv, tk);
    I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
    _ = add_sir(toks, sir, diag, ls, SO_ELSE, T_NONE, tk);
    store(toks, sir, diag, ls, slot, vty, val, tk);
    I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
    I64 ld = def_sir(toks, sir, diag, ls, SO_LOAD, vty, tk);
    if (ld < 0) {
        return;
    }
    sir[ae].a = st[f].g;
    sir[ae].b = st[f].f;
    sir[en].a = st[f].f;
    sir[en].c = 1;
    sir[ld].a = slot as I32;
    give(ls, ld, vty, st[f].h as I64, ld + 1);
}

// `tag != 0`, then the SO_IF, its SO_ARM and the SO_THEN of that condition, whose index it
// returns (the SO_IF is two before it); -1 after an error.
I64 error_test[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 tag, I64 tk) {
    I32 tty = sir[tag].ty;
    I64 z = def_sir(toks, sir, diag, ls, SO_CONST, tty, tk);
    I64 c = def_sir(toks, sir, diag, ls, SO_CMP, T_BOOL, tk);
    _ = add_sir(toks, sir, diag, ls, SO_IF, T_NONE, tk);
    _ = add_sir(toks, sir, diag, ls, SO_ARM, T_NONE, tk);
    I64 th = add_sir(toks, sir, diag, ls, SO_THEN, T_NONE, tk);
    if (th < 0) {
        return -1;
    }
    sir[c].a = tag as I32;
    sir[c].b = z as I32;
    sir[c].c = CMP_NE;
    sir[c].f = tty;
    sir[th].a = c as I32;
    return th;
}

// The name of ArithError's value j from 0 (SPEC-01 IM-188), against token tk.
Bool arith_value[n, t](in U8[n] text, in scan.Token[t] toks, I64 tk, I64 j) {
    if (j == 0) { return spells(text, toks, tk, "overflow"); }
    if (j == 1) { return spells(text, toks, tk, "div_zero"); }
    if (j == 2) { return spells(text, toks, tk, "shift"); }
    if (j == 3) { return spells(text, toks, tk, "narrow"); }
    return spells(text, toks, tk, "full");
}

// Whether base b2 declares the name of value j (from 0) of base b. A built-in base's value
// j is arith_value's: ArithError's from 0 to 3, AllocError's `full` 4.
Bool base_shares[n, t](in U8[n] text, in scan.Token[t] toks, in parse.Node[_] nodes, I64 b2, I64 b, I64 vt,
        I64 j) {
    if (b != resolve.ARITH_BASE && b != resolve.ALLOC_BASE) {
        return resolve.base_value(text, toks, nodes, b2, vt) > 0;
    }
    if (b2 == resolve.ARITH_BASE || b2 == resolve.ALLOC_BASE) {
        return false;
    }
    I64 v = nodes[b2].a as I64;
    while (v >= 0) {
        if (arith_value(text, toks, nodes[v].tok as I64, j)) {
            return true;
        }
        v = nodes[v].next as I64;
    }
    return false;
}

// The SK_ESET slot that describes set type s, with its SK_EVAL slots (box 12): a new one when
// `fresh` or when none exists yet; -1 after an error.
I64 describe_set[n, t](in U8[n] text, in scan.Token[t] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout SirSlot[_] slots, inout limits.CompilerDiag[_] diag, inout LState[_] ls, I64 s, Bool fresh,
        I64 tk) {
    I64 d = resolve.errset_node(nodes, s);
    I64 name = -1;
    if (d >= 0) {
        name = nodes[d].tok as I64;
    } else if (d == resolve.ALLOC_BASE) {
        name = -2;
    }
    if (!fresh) {
        for k in 0..ls[0].nslot {
            if (slots[k].kind == SK_ESET && (slots[k].name as I64) == name) {
                return k;
            }
        }
    }
    I64 es = add_slot(toks, slots, diag, ls, name, set_type(s), SK_ESET, tk);
    if (es < 0) {
        return -1;
    }
    slots[es].live = 0;
    I64[256] bases;
    I64 nb = resolve.errset_bases(nodes, sem, s, bases);
    for i in 0..nb {
        I64 b = bases[i];
        I64 v = -1;
        I64 j0 = 0;
        if (b == resolve.ALLOC_BASE) {
            j0 = 4;
        } else if (b != resolve.ARITH_BASE) {
            v = nodes[b].a as I64;
        }
        for j in 0..resolve.base_size(nodes, b) {
            I64 vt = -2 - j0 - j;
            if (v >= 0) {
                vt = nodes[v].tok as I64;
                v = nodes[v].next as I64;
            }
            I64 q = 0;
            for i2 in 0..nb {
                if (i2 != i && base_shares(text, toks, nodes, bases[i2], b, vt, j0 + j)) {
                    q = -1;
                    if (b == resolve.ALLOC_BASE) {
                        q = -2;
                    } else if (b != resolve.ARITH_BASE) {
                        q = (nodes[b].tok as I64) + 1;
                    }
                }
            }
            I64 ev = add_slot(toks, slots, diag, ls, vt, q as I32, SK_EVAL, tk);
            if (ev < 0) {
                return -1;
            }
            slots[ev].live = 0;
        }
    }
    return es;
}

// The expression of statement x that a `try` or `catch` may be (the gate admits them there
// only): an initializer, a value assigned with `=`, a returned value, or the expression of an
// expression statement or `_ =`; -1 for any other statement.
I64 stmt_expr(in parse.Node[_] nodes, I64 x) {
    I32 k = nodes[x].kind;
    if (k == parse.N_VAR || (k == parse.N_ASSIGN && nodes[x].op == scan.OP_ASSIGN)) {
        return nodes[x].b as I64;
    }
    if (k == parse.N_RETURN || k == parse.N_EXPR_STMT || k == parse.N_DISCARD) {
        return nodes[x].a as I64;
    }
    return -1;
}

// K_TRY when expression e is `try`, K_CATCH when it is a `catch` with a block, else 0.
I32 union_top(in parse.Node[_] nodes, I64 e) {
    if (e < 0) {
        return 0;
    }
    if (nodes[e].kind == parse.N_UNARY && nodes[e].op == parse.UNARY_TRY) {
        return K_TRY;
    }
    if (nodes[e].kind == parse.N_CATCH && nodes[e].c >= 0) {
        return K_CATCH;
    }
    return 0;
}

// Exits past deferred statements (SPEC-04 LS-185 to LS-190; lemma S of SPEC-09 CINTC-16 row
// 6). Each `defer` or `errdefer` of a list opens a region, an SO_BLOCK that runs to the end of
// the list; there each region ends, innermost first, and is followed by its deferred
// statement, lowered once (defer_end_step). An exit (`return`, `break`, `continue`, or the
// error path of `try`) that would run a deferred statement stores its exit code in the slot
// of the innermost group it passes and leaves that group's innermost region with SO_BREAK
// (exit_through); after the group's deferred statements its list end tests the code
// (dispatch): the outermost group the exit passes takes the exit itself, and each other one
// passes the code to the next group out. Codes: 1 a return, -1 an error's return, 2 + 2e a
// `break` and 3 + 2e a `continue` of the loop or switch whose SO_LOOP or SO_SWITCH is node e.

// The groups an exit from the top frame to frame `to` passes (the K_DEFER frames above `to`):
// res[0] the top frame of the innermost group that holds a statement the exit runs
// (errdefers only when `err`), res[1] the first frame of the outermost such group; both -1
// when it runs none.
void exit_groups(in parse.Frame[_] st, in LState[_] ls, I64 to, Bool err, inout I64[_] res) {
    res[0] = -1;
    res[1] = -1;
    I64 j = ls[0].sp - 1;
    while (j > to) {
        if (st[j].kind != K_DEFER) {
            j -= 1;
        } else {
            I64 top = j;
            Bool runs = false;
            while (j > to && st[j].kind == K_DEFER) {
                runs = runs || err || st[j].want == 0;
                j -= 1;
            }
            if (runs) {
                if (res[0] < 0) {
                    res[0] = top;
                }
                res[1] = j + 1;
            }
        }
    }
}

// The first frame of the group of K_DEFER frame j.
I64 group_first(in parse.Frame[_] st, I64 j) {
    I64 g = j;
    while (g > 0 && st[g - 1].kind == K_DEFER) {
        g -= 1;
    }
    return g;
}

// Slot `which` of the group whose first frame is g (0 the exit code, 1 the returned value,
// 2 the error tag), of type ty, made with its SO_LOCAL at its first use; -1 after an error.
I64 group_slot[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 g, I64 which, I32 ty,
        I64 tk) {
    I64 k = st[g].b as I64;
    if (which == 1) {
        k = st[g].c as I64;
    } else if (which == 2) {
        k = st[g].d as I64;
    }
    if (k >= 0) {
        return k;
    }
    if (ty >= T_STRUCT) {
        k = add_slot(toks, slots, diag, ls, -1, ty, SK_STRUCT, tk);
    } else {
        k = add_slot(toks, slots, diag, ls, -1, ty, SK_HIDDEN, tk);
        I64 dl = add_sir(toks, sir, diag, ls, SO_LOCAL, ty, tk);
        if (dl < 0) {
            return -1;
        }
        sir[dl].a = k as I32;
    }
    if (k < 0) {
        return -1;
    }
    if (which == 0) {
        st[g].b = k as I32;
    } else if (which == 1) {
        st[g].c = k as I32;
    } else {
        st[g].d = k as I32;
    }
    return k;
}

// Exit code `code` leaves through the groups of gs (exit_groups): the code into the slot of
// the innermost group, then SO_BREAK of that group's innermost region. Every group from it
// out to the outermost one is marked: DX_ERRED when `err`, DX_PASS but the outermost, and
// the outermost with `mark` (DX_RETURN or DX_ERROR), or, when `mark` is 0, as the group that
// ends the `break` (`continue` when `cont`) of loop or switch frame `to`.
void exit_through[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, in I64[_] gs, I64 code,
        I32 mark, I64 to, Bool cont, Bool err, I64 tk) {
    I64 c = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
    I64 ks = group_slot(toks, sir, slots, st, diag, ls, group_first(st, gs[0]), 0, T_I64, tk);
    if (ks < 0 || c < 0) {
        return;
    }
    sir[c].val = code;
    store(toks, sir, diag, ls, ks, T_I64, c, tk);
    // The lists inside the group's list give back what they took (LS-110).
    frame_release(toks, sir, st, diag, ls, gs[0] + 1, ls[0].sp, tk);
    I64 br = add_sir(toks, sir, diag, ls, SO_BREAK, T_NONE, tk);
    if (br < 0) {
        return;
    }
    sir[br].a = st[gs[0]].a;
    I64 j = gs[0];
    while (j >= gs[1]) {
        if (st[j].kind == K_DEFER) {
            I64 g = group_first(st, j);
            if (err) {
                st[g].e = st[g].e | DX_ERRED;
            }
            if (g > gs[1]) {
                st[g].e = st[g].e | DX_PASS;
            }
            j = g - 1;
        } else {
            j -= 1;
        }
    }
    if (mark != 0) {
        st[gs[1]].e = st[gs[1]].e | mark;
    } else if (cont) {
        st[to].c = st[gs[1]].a;
    } else {
        st[to].d = st[gs[1]].a;
    }
}

// `return` of v in form `form` (return_eval) from the top frame, an error's when `err` (form
// 3, or form 0 from a test, whose error SO_ERROR has recorded): SO_RETURN, or, when the
// return runs deferred statements, v held in a slot of the outermost group it passes, whose
// dispatch returns it, and the exit (exit_through).
void return_exit[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 v, I64 form, Bool err,
        I64 tk) {
    I64 fn = ls[0].func;
    I64[2] gs;
    exit_groups(st, ls, -1, err, gs);
    if (gs[0] < 0) {
        I64 i = add_sir(toks, sir, diag, ls, SO_RETURN, T_NONE, tk);
        if (i >= 0) {
            sir[i].a = v as I32;
            sir[i].b = form as I32;
        }
        return;
    }
    if (form == 3) {
        I32 et = func_etag(funcs, fn);
        I64 es = group_slot(toks, sir, slots, st, diag, ls, gs[1], 2, et, tk);
        if (es < 0) {
            return;
        }
        store(toks, sir, diag, ls, es, et, v, tk);
    } else if (form != 0) {
        I32 ty = funcs[fn].result;
        I64 hs = group_slot(toks, sir, slots, st, diag, ls, gs[1], 1, ty, tk);
        if (hs < 0) {
            return;
        }
        if (form == 2) {
            scopy(toks, sir, diag, ls, hs, v, tk);
        } else {
            store(toks, sir, diag, ls, hs, ty, v, tk);
        }
    }
    if (err) {
        exit_through(toks, sir, slots, st, diag, ls, gs, -1, DX_ERROR, -1, false, true, tk);
    } else {
        exit_through(toks, sir, slots, st, diag, ls, gs, 1, DX_RETURN, -1, false, false, tk);
    }
}

// Whether a statement list whose last statement is x can reach its end (a direct
// `fallthrough` leaves its case there; a declaration among a script's statements completes).
Bool reaches_end(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    I32 k = nodes[x].kind;
    if (k == parse.N_RETURN || k == parse.N_BREAK || k == parse.N_CONTINUE) {
        return false;
    }
    if (k == parse.N_BLOCK || k == parse.N_IF || k == parse.N_WHILE || k == parse.N_FOR || k == parse.N_FOR_RANGE ||
            k == parse.N_SWITCH) {
        return (sem[x].flags & resolve.SEM_COMPLETES) != 0;
    }
    return true;
}

// Whether the end of list frame f can be reached from its last statement.
Bool list_falls(in parse.Node[_] nodes, in resolve.Sem[_] sem, in parse.Frame[_] st, I64 f) {
    return st[f].e < 0 || reaches_end(nodes, sem, st[f].e as I64);
}

// Opens the next arm of dispatch state ds (dispatch: ds[0] the SO_IF or -1 for none, ds[1]
// the arms so far, ds[2] their number, ds[3] 1 when the list can reach its end, ds[4] the
// loaded exit code): nothing without an SO_IF, the else part for the last arm of a list that
// cannot reach its end, else an arm that tests the code against `code` (against 0, for any
// other code, when `pass`). Returns the arm's SO_THEN, 0 when it has none, -1 after an error.
I64 arm_open[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, inout I64[_] ds, I64 code, Bool pass, I64 tk) {
    ds[1] += 1;
    if (ds[0] < 0) {
        return 0;
    }
    if (ds[3] == 0 && ds[1] == ds[2]) {
        if (add_sir(toks, sir, diag, ls, SO_ELSE, T_NONE, tk) < 0) {
            return -1;
        }
        return 0;
    }
    _ = add_sir(toks, sir, diag, ls, SO_ARM, T_NONE, tk);
    I64 c = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
    I64 cmp = def_sir(toks, sir, diag, ls, SO_CMP, T_BOOL, tk);
    I64 th = add_sir(toks, sir, diag, ls, SO_THEN, T_NONE, tk);
    if (th < 0) {
        return -1;
    }
    sir[cmp].a = ds[4] as I32;
    sir[cmp].b = c as I32;
    sir[cmp].c = CMP_EQ;
    sir[cmp].f = T_I64;
    sir[c].val = code;
    if (pass) {
        sir[c].val = 0;
        sir[cmp].c = CMP_NE;
    }
    sir[th].a = cmp as I32;
    return th;
}

// Closes the arm whose SO_THEN is th (arm_open; nothing when th is 0).
void arm_close[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, in I64[_] ds, I64 th, I64 tk) {
    if (th > 0) {
        I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
        if (ae >= 0) {
            sir[ae].a = th as I32;
            sir[ae].b = ds[0] as I32;
        }
    }
}

// Whether frame j is a loop or a switch, which an exit can leave.
Bool exit_target(in parse.Frame[_] st, I64 j) {
    I32 k = st[j].kind;
    return k == K_WHILE || k == K_FOR || k == K_RANGE || k == K_SWITCH;
}

// The end of the group whose first frame is g, after its deferred statements, in the list
// whose frame is f: an arm for each exit the group ends, taken when the exit code is that
// exit's (a return, an error's return, then the `break` and `continue` of each loop or
// switch the group ends, innermost first), then the code passed to the next group out, when
// another exit passes the group. When the list cannot reach its end every path here is an
// exit, so the last arm is the else part, or the only arm without an `if`.
void dispatch[t, m, ns, r](in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 g, I64 f, I64 tk) {
    I64 fn = ls[0].func;
    I32 marks = st[g].e;
    I32 id = st[g].a;
    I64 n = 0;
    if ((marks & DX_RETURN) != 0) {
        n += 1;
    }
    if ((marks & DX_ERROR) != 0) {
        n += 1;
    }
    if ((marks & DX_PASS) != 0) {
        n += 1;
    }
    for q in 0..g {
        if (exit_target(st, q)) {
            if (st[q].d == id) {
                n += 1;
            }
            if (st[q].kind != K_SWITCH && st[q].c == id) {
                n += 1;
            }
        }
    }
    if (n == 0) {
        return;
    }
    I64[5] ds;
    ds[0] = -1;
    ds[1] = 0;
    ds[2] = n;
    ds[3] = 0;
    if (list_falls(nodes, sem, st, f)) {
        ds[3] = 1;
    }
    ds[4] = -1;
    if (ds[3] == 1 || n > 1 || (marks & DX_PASS) != 0) {
        // The code, which the arms test and the code passed on is.
        ds[4] = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
        if (ds[4] < 0) {
            return;
        }
        sir[ds[4]].a = st[g].b;
    }
    if (ds[3] == 1 || n > 1) {
        ds[0] = add_sir(toks, sir, diag, ls, SO_IF, T_NONE, tk);
    }
    if ((marks & DX_RETURN) != 0) {
        I64 th = arm_open(toks, sir, diag, ls, ds, 1, false, tk);
        I32 ty = funcs[fn].result;
        I64 v = -1;
        I64 form = 0;
        if (ty >= T_STRUCT) {
            v = st[g].c as I64;
            form = 2;
        } else if (ty != T_NONE) {
            v = def_sir(toks, sir, diag, ls, SO_LOAD, ty, tk);
            if (v >= 0) {
                sir[v].a = st[g].c;
            }
            form = 1;
        }
        I64 rt = add_sir(toks, sir, diag, ls, SO_RETURN, T_NONE, tk);
        if (rt < 0 || th < 0) {
            return;
        }
        sir[rt].a = v as I32;
        sir[rt].b = form as I32;
        arm_close(toks, sir, diag, ls, ds, th, tk);
    }
    if ((marks & DX_ERROR) != 0) {
        I64 th = arm_open(toks, sir, diag, ls, ds, -1, false, tk);
        I64 v = -1;
        I64 form = 0;
        if ((funcs[fn].flags & FN_TEST) == 0) {
            // A test's error was recorded where it left (SO_ERROR): the test returns.
            v = def_sir(toks, sir, diag, ls, SO_LOAD, func_etag(funcs, fn), tk);
            if (v >= 0) {
                sir[v].a = st[g].d;
            }
            form = 3;
        }
        I64 rt = add_sir(toks, sir, diag, ls, SO_RETURN, T_NONE, tk);
        if (rt < 0 || th < 0) {
            return;
        }
        sir[rt].a = v as I32;
        sir[rt].b = form as I32;
        arm_close(toks, sir, diag, ls, ds, th, tk);
    }
    for q in 0..g {
        I64 j = g - 1 - q;
        for u in 0..2 {
            Bool cont = u == 1;
            if (exit_target(st, j) && ((!cont && st[j].d == id) || (cont && st[j].kind != K_SWITCH && st[j].c == id))) {
                I64 code = 2 + 2 * (st[j].e as I64) + u;
                I64 th = arm_open(toks, sir, diag, ls, ds, code, false, tk);
                I32 op = SO_BREAK;
                if (cont) {
                    op = SO_CONTINUE;
                }
                frame_release(toks, sir, st, diag, ls, j, g, tk);
                I64 br = add_sir(toks, sir, diag, ls, op, T_NONE, tk);
                if (br < 0 || th < 0) {
                    return;
                }
                sir[br].a = st[j].e;
                arm_close(toks, sir, diag, ls, ds, th, tk);
            }
        }
    }
    if ((marks & DX_PASS) != 0) {
        I64 p = g - 1;
        while (p > 0 && st[p].kind != K_DEFER) {
            p -= 1;
        }
        I64 th = arm_open(toks, sir, diag, ls, ds, 0, true, tk);
        I64 kp = group_slot(toks, sir, slots, st, diag, ls, group_first(st, p), 0, T_I64, tk);
        if (th < 0 || kp < 0) {
            return;
        }
        store(toks, sir, diag, ls, kp, T_I64, ds[4], tk);
        frame_release(toks, sir, st, diag, ls, p + 1, g, tk);
        I64 br = add_sir(toks, sir, diag, ls, SO_BREAK, T_NONE, tk);
        if (br < 0) {
            return;
        }
        sir[br].a = st[p].a;
        arm_close(toks, sir, diag, ls, ds, th, tk);
    }
    if (ds[0] >= 0) {
        I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
        if (en >= 0) {
            sir[en].a = ds[0] as I32;
            if (ds[3] == 0) {
                sir[en].c = 1;
            }
        }
    }
}

// K_UNWIND on frame u, the end of the list of frame c, whose group is frames b to c - 1: the
// regions end innermost first (frame a the next), each followed by its deferred statement,
// lowered once; an errdefer's only when an error passes the group, inside `if (code < 0)`
// (d and e that test's SO_IF and SO_THEN, else -1). Then the dispatch, and the frame pops.
// State 1: a statement has been lowered.
void defer_end_step[t, m, ns, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 u) {
    I64 g = st[u].b as I64;
    if (st[u].state == 1) {
        if (st[u].e >= 0) {
            I64 tk = st[u].h as I64;
            I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
            I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
            if (en < 0) {
                return;
            }
            sir[ae].a = st[u].e;
            sir[ae].b = st[u].d;
            sir[en].a = st[u].d;
        }
        st[u].a -= 1;
        st[u].state = 0;
    }
    while ((st[u].a as I64) >= g) {
        I64 j = st[u].a as I64;
        I64 x = st[j].node as I64;
        I64 tk = nodes[x].tok as I64;
        I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
        if (en < 0) {
            return;
        }
        sir[en].a = st[j].a;
        st[u].d = -1;
        st[u].e = -1;
        st[u].h = tk as I32;
        if (st[j].want != 0) {
            if ((st[g].e & DX_ERRED) == 0) {
                // No error leaves past this errdefer: it never runs.
                st[u].a -= 1;
                continue;
            }
            I64 kv = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
            I64 z = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
            I64 cmp = def_sir(toks, sir, diag, ls, SO_CMP, T_BOOL, tk);
            I64 ifx = add_sir(toks, sir, diag, ls, SO_IF, T_NONE, tk);
            _ = add_sir(toks, sir, diag, ls, SO_ARM, T_NONE, tk);
            I64 th = add_sir(toks, sir, diag, ls, SO_THEN, T_NONE, tk);
            if (th < 0) {
                return;
            }
            sir[kv].a = st[g].b;
            sir[cmp].a = kv as I32;
            sir[cmp].b = z as I32;
            sir[cmp].c = CMP_LT;
            sir[cmp].f = T_I64;
            sir[th].a = cmp as I32;
            st[u].d = ifx as I32;
            st[u].e = th as I32;
        }
        st[u].state = 1;
        I64 y = nodes[x].a as I64;
        if (!lower_simple(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, y)) {
            open_stmt(toks, nodes, st, diag, ls, y);
        }
        return;
    }
    // The list gives back what it took after its deferred statements, which may use it (LS-110).
    I64 c = st[u].c as I64;
    frame_release(toks, sir, st, diag, ls, c - 1, c + 1, nodes[st[g].node as I64].tok as I64);
    dispatch(toks, nodes, sem, sir, funcs, slots, st, diag, ls, g, c, nodes[st[g].node as I64].tok as I64);
    ls[0].sp -= 1;
}

// The value that `return` statement x returns: res[0] the operand (a struct slot for a struct
// result; -1 for none) and res[1] its SO_RETURN form (0 none, 1 value, 2 struct slot, 3 the
// error of an FN_ERRU function, whose value is an error-set value). False after an error.
Bool return_eval[t, m, ns, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x,
        inout I64[_] res) {
    I64 fn = ls[0].func;
    I64 e = nodes[x].a as I64;
    I64 tk = nodes[x].tok as I64;
    res[0] = -1;
    res[1] = 0;
    if (e < 0) {
        return true;
    }
    if (funcs[fn].result >= T_STRUCT) {
        // A struct result (task 2.14): the struct slot of its value (SO_RETURN b 2).
        I64 rs = struct_value(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, e, funcs[fn].result);
        if (rs < 0) {
            return false;
        }
        res[0] = rs;
        res[1] = 2;
        return ls[0].err == 0;
    }
    I32 want = funcs[fn].result;
    res[1] = 1;
    if ((funcs[fn].flags & FN_ERRU) != 0 && resolve.is_errset(sem[e].ty)) {
        want = func_etag(funcs, fn);
        res[1] = 3;
    }
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, e, want)) {
        return false;
    }
    res[0] = ls[0].rv;
    return true;
}

// Completes statement x of K_TRY or K_CATCH frame f with v, the value of its union (-1 for
// none): a declaration binds it, an assignment to a variable stores it, `return` returns it
// (return_exit), and an expression statement or `_ =` drops it; the frame pops.
void finish_stmt[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f, I64 v) {
    I64 x = st[f].node as I64;
    I32 k = nodes[x].kind;
    I64 tk = nodes[x].tok as I64;
    if (k == parse.N_RETURN) {
        I64 form = 0;
        if (v >= 0) {
            form = 1;
        }
        return_exit(toks, sir, funcs, slots, st, diag, ls, v, form, false, tk);
        ls[0].sp -= 1;
        return;
    }
    if (k == parse.N_VAR) {
        I32 ty = decl_type(toks, nodes, sem, nodes[x].a as I64, x);
        if (ty == T_NONE || v < 0) {
            unsupported(toks, diag, ls, tk, U_TYPE);
            return;
        }
        I64 ks = add_slot(toks, slots, diag, ls, tk, ty, SK_LOCAL, tk);
        I64 d = add_sir(toks, sir, diag, ls, SO_LOCAL, ty, tk);
        if (d < 0) {
            return;
        }
        sir[d].a = ks as I32;
        store(toks, sir, diag, ls, ks, ty, v, tk);
    } else if (k == parse.N_ASSIGN) {
        I64 ks = target_slot(text, toks, nodes, funcs, slots, diag, ls, nodes[x].a as I64);
        if (ks < 0 || v < 0) {
            return;
        }
        store(toks, sir, diag, ls, ks, slots[ks].ty, v, tk);
    } else if (v >= 0 && sir[v].dst >= 0) {
        I64 i = add_sir(toks, sir, diag, ls, SO_DISCARD, T_NONE, tk);
        if (i >= 0) {
            sir[i].a = v as I32;
        }
    }
    ls[0].sp -= 1;
}

// K_TRY on frame f: statement x whose expression is `try e` (SPEC-04 LS-129): the union e
// and `if (tag != 0)`; in it the tag converted to the function's set (convert_tag) and its
// return (return_exit, which runs the deferred statements with the errdefers first), or, in
// a test block, the tag kept with its own set (LS-315) leaving the test (SO_ERROR) before the
// test returns; then the end of the `if` and the statement with e's value (finish_stmt).
void try_step[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 te = stmt_expr(nodes, x);
    I64 o = nodes[te].a as I64;
    I64 tk = nodes[te].tok as I64;
    I64 fn = ls[0].func;
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, o, T_NONE)) {
        return;
    }
    I64 tag = ls[0].rv;
    if (tag < 0 || (sir[tag].op & OP_MASK) != SO_ETAG) {
        unsupported(toks, diag, ls, tk, U_EXPRESSION);
        return;
    }
    I64 th = error_test(toks, sir, diag, ls, tag, tk);
    if (th < 0) {
        return;
    }
    I64 s = resolve.union_set(sem[o].ty);
    if ((funcs[fn].flags & FN_TEST) != 0) {
        I64 es = describe_set(text, toks, nodes, sem, slots, diag, ls, s, false, tk);
        I64 er = add_sir(toks, sir, diag, ls, SO_ERROR, T_NONE, tk);
        if (er < 0) {
            return;
        }
        sir[er].a = tag as I32;
        sir[er].c = es as I32;
        return_exit(toks, sir, funcs, slots, st, diag, ls, -1, 0, true, tk);
    } else {
        I64 c = convert_tag(toks, nodes, sem, sir, slots, diag, ls, tag, s,
            resolve.union_set(sem[funcs[fn].node as I64].ty), tk);
        if (ls[0].err != 0) {
            return;
        }
        return_exit(toks, sir, funcs, slots, st, diag, ls, c, 3, true, tk);
    }
    I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
    I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
    if (en < 0) {
        return;
    }
    sir[ae].a = th as I32;
    sir[ae].b = (th - 2) as I32;
    sir[en].a = (th - 2) as I32;
    I64 v = sir[tag].a as I64;
    if (v >= 0 && sir[v].dst < 0) {
        v = -1;
    }
    finish_stmt(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f, v);
}

// K_CATCH on frame f: statement x whose expression is `e catch (name) { ... }` (SPEC-04
// LS-131). State 0: the union e and `if (tag != 0)`; in it the binding, a local of e's set
// that only the block sees, and the block, which never completes (C4002). State 1: the end of
// the `if`, then the statement with e's value (finish_stmt). Frame b the value node, e the
// SO_IF, g the SO_THEN.
void catch_stmt_step[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 e = stmt_expr(nodes, x);
    I64 tk = nodes[e].tok as I64;
    if (st[f].state == 0) {
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[e].a as I64, T_NONE)) {
            return;
        }
        I64 tag = ls[0].rv;
        if (tag < 0 || (sir[tag].op & OP_MASK) != SO_ETAG) {
            unsupported(toks, diag, ls, tk, U_EXPRESSION);
            return;
        }
        I64 th = error_test(toks, sir, diag, ls, tag, tk);
        if (th < 0) {
            return;
        }
        I32 tty = sir[tag].ty;
        I64 bt = nodes[e].c as I64;
        I64 bs = add_slot(toks, slots, diag, ls, bt, tty, SK_LOCAL, bt);
        I64 dl = add_sir(toks, sir, diag, ls, SO_LOCAL, tty, bt);
        if (dl < 0) {
            return;
        }
        sir[dl].a = bs as I32;
        store(toks, sir, diag, ls, bs, tty, tag, bt);
        st[f].b = sir[tag].a;
        st[f].e = (th - 2) as I32;
        st[f].g = th as I32;
        st[f].state = 1;
        open_block(toks, nodes, st, diag, ls, nodes[e].b as I64);
        if (ls[0].err == 0) {
            st[ls[0].sp - 1].a = bs as I32;
        }
        return;
    }
    I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
    I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
    if (en < 0) {
        return;
    }
    sir[ae].a = st[f].g;
    sir[ae].b = st[f].e;
    sir[en].a = st[f].e;
    I64 v = st[f].b as I64;
    if (v >= 0 && sir[v].dst < 0) {
        v = -1;
    }
    finish_stmt(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f, v);
}

// `defer` or `errdefer` x (SPEC-04 LS-185, LS-189) in the list of the top frame: that frame
// moves up one and a K_DEFER frame takes its place, whose region (SO_BLOCK) runs to the end
// of the list (defer_end_step).
void defer_mark[t, m, ns, r](in scan.Token[t] toks, in parse.Node[m] nodes, inout Sir[ns] sir,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 f = ls[0].sp - 1;
    I64 tk = nodes[x].tok as I64;
    if (f < 0 || st[f].kind != K_LIST || nodes[nodes[x].a as I64].kind == parse.N_DEFER) {
        unsupported(toks, diag, ls, tk, U_STATEMENT);
        return;
    }
    I64 g = push(toks, st, diag, ls, K_LIST, -1, T_NONE, tk);
    I64 blk = add_sir(toks, sir, diag, ls, SO_BLOCK, T_NONE, tk);
    if (g < 0 || blk < 0) {
        return;
    }
    copy_frame(st, g, f);
    st[f].kind = K_DEFER;
    st[f].node = x as I32;
    st[f].want = nodes[x].op;
    st[f].state = 0;
    st[f].a = blk as I32;
    st[f].b = -1;
    st[f].c = -1;
    st[f].d = -1;
    st[f].e = 0;
    if (st[g].b < 0) {
        st[g].b = 0;
    }
    st[g].b += 1;
}

// ---------------------------------------------------------------- the frame arena

// The least frame-arena capacity in elements (SPEC-04 LS-110; decision 2026-10-05, BX12-23):
// a bound at most this cannot exhaust any context's frame arena.
export const I64 FRAME_CAP = 2097152;

// a + b and a * b of element counts, saturated at FRAME_CAP + 1; -1 (not static) when either is.
I64 sat_add(I64 a, I64 b) {
    if (a < 0 || b < 0) {
        return -1;
    }
    if (a + b > FRAME_CAP) {
        return FRAME_CAP + 1;
    }
    return a + b;
}

I64 sat_mul(I64 a, I64 b) {
    if (a < 0 || b < 0) {
        return -1;
    }
    if (a == 0 || b == 0) {
        return 0;
    }
    if (a > FRAME_CAP / b) {
        return FRAME_CAP + 1;
    }
    return sat_add(a * b, 0);
}

// The local array that statement y declares, as lower_var lowers it: 1 for storage of its own
// (an SK_ARRAY, charged by SO_FRAME), 2 for run-time storage (SO_VALLOC), 0 for none.
I64 array_kind(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 y) {
    I64 ty = sem[y].ty;
    if (nodes[y].kind != parse.N_VAR || nodes[y].op != 0 || (nodes[y].flags & parse.F_CONST) != 0 ||
            !resolve.is_array(ty)) {
        return 0;
    }
    if (!box09_local(nodes, sem, y)) {
        return 1;
    }
    I64 total = 1;
    for d in 0..resolve.array_rank(ty) {
        I64 e = resolve.dim_extent(ty, d);
        if (e < 0 || e > 65534) {
            return 2;
        }
        total = sat_mul(total, e);
    }
    I64 bytes = 1;
    if (slot_elem(ty) != fold.TY_BOOL) {
        bytes = fold.ty_width(slot_elem(ty)) / 8;
    }
    if (sat_mul(total, bytes) > 4096) {
        return 2;
    }
    return 1;
}

// SO_FRAME f 0 at name tk: the charge of a local array of n elements whose storage is its own;
// none in a kernel (LS-110).
void frame_charge[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirFunc[_] funcs,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 n, I64 tk) {
    if ((funcs[ls[0].func].flags & FN_KERNEL) != 0) {
        return;
    }
    I64 i = add_sir(toks, sir, diag, ls, SO_FRAME, T_NONE, tk);
    if (i >= 0) {
        sir[i].val = n;
    }
}

// SO_FRAME f 1 at the start of list frame f, whose first statement is x, when one of its
// statements declares a local array (array_kind); st[f].h the mark, else -1.
void frame_mark[t, m, ns, r](in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, in SirFunc[_] funcs, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 f, I64 x) {
    if ((funcs[ls[0].func].flags & FN_KERNEL) != 0) {
        return;
    }
    I64 parts = 0;
    I64 y = x;
    while (y >= 0) {
        I64 kind = array_kind(nodes, sem, y);
        if (kind == 1) {
            parts = parts | 1;
        } else if (kind == 2) {
            parts = parts | 2;
        }
        y = nodes[y].next as I64;
    }
    if (parts == 0) {
        return;
    }
    I64 i = add_sir(toks, sir, diag, ls, SO_FRAME, T_NONE, nodes[x].tok as I64);
    if (i >= 0) {
        sir[i].f = 1;
        sir[i].b = parts as I32;
        st[f].h = i as I32;
    }
}

// SO_FRAME f 2 at tk: an exit from the list frames above frame lo and below frame hi gives back
// what they took, from the outermost one that charges and the outermost one with run-time
// storage (one node when it is the same list).
void frame_release[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 lo, I64 hi, I64 tk) {
    I64 c = -1;
    I64 v = -1;
    I64 j = lo + 1;
    if (j < 0) {
        j = 0;
    }
    while (j < hi) {
        if (st[j].kind == K_LIST && st[j].h >= 0) {
            I64 m = st[j].h as I64;
            if (c < 0 && (sir[m].b & 1) != 0) {
                c = m;
            }
            if (v < 0 && (sir[m].b & 2) != 0) {
                v = m;
            }
        }
        j += 1;
    }
    if (c >= 0) {
        I64 i = add_sir(toks, sir, diag, ls, SO_FRAME, T_NONE, tk);
        if (i >= 0) {
            sir[i].f = 2;
            sir[i].a = c as I32;
            sir[i].b = 1;
            if (v == c) {
                sir[i].b = 3;
            }
        }
    }
    if (v >= 0 && v != c) {
        I64 i = add_sir(toks, sir, diag, ls, SO_FRAME, T_NONE, tk);
        if (i >= 0) {
            sir[i].f = 2;
            sir[i].a = v as I32;
            sir[i].b = 2;
        }
    }
}

// Whether function k is an entry: an export, `main`, a test, a script or an observer.
Bool frame_entry(in SirFunc[_] funcs, I64 k) {
    return (funcs[k].flags & (FN_EXPORT | FN_MAIN | FN_TEST | FN_SCRIPT | FN_OBSERVE)) != 0;
}

// Which functions charge their local arrays (FN_FRAME; SPEC-04 LS-110, which lets an
// implementation skip a charge where it proves the bound; decision 2026-10-06 on OQ-213).
// A function's own charge is the sum of its SO_FRAME charges and of the static element
// counts of its SO_VALLOC nodes, unbounded when an extent is not static; its bound adds the
// largest bound of a function it calls, unbounded for an import or on a cycle that charges.
// An entry whose bound is at most FRAME_CAP cannot exhaust the frame arena, nor can a function
// it reaches; a function that an entry of a larger bound reaches charges. In a module other
// than the root, which other modules call, every function with a charge charges. A charge
// that is skipped becomes f 3; the others get sites after the module's, in node order
// (back_c.ci's site table). Frame rows 0 to nf - 1 are scratch: a the bound, b the own
// charge, c whether it charges, d the pass that last raised the bound.
export void frame_proof[s](inout Sir[_] sir, inout SirFunc[_] funcs, inout parse.Frame[s] st, in LState[_] ls,
        Bool root) {
    I64 nf = ls[0].nfunc;
    I64 inf = FRAME_CAP + 1;
    Bool all = !root || nf > s;
    if (!all) {
        for k in 0..nf {
            I64 own = 0;
            if ((funcs[k].flags & FN_IMPORT) != 0) {
                own = inf;
            } else {
                for i in funcs[k].first as I64..funcs[k].last as I64 {
                    I32 op = sir[i].op & OP_MASK;
                    if (op == SO_FRAME && sir[i].f == 0) {
                        own = sat_add(own, sir[i].val);
                    } else if (op == SO_VALLOC) {
                        own = sat_add(own, sir[i].val);
                    }
                }
                if (own < 0) {
                    own = inf;
                }
            }
            st[k].a = own as I32;
            st[k].b = own as I32;
            st[k].c = 0;
            st[k].d = 0;
        }
        I64 pass = 0;
        Bool changed = true;
        while (changed && pass <= 2 * nf + 2) {
            changed = false;
            pass += 1;
            for k in 0..nf {
                if ((funcs[k].flags & FN_IMPORT) != 0) {
                    continue;
                }
                I64 w = st[k].a as I64;
                for i in funcs[k].first as I64..funcs[k].last as I64 {
                    I64 g = sir[i].a as I64;
                    if ((sir[i].op & OP_MASK) == SO_CALL && g >= 0 && g < nf) {
                        I64 via = sat_add(st[k].b as I64, st[g].a as I64);
                        if (via > w) {
                            w = via;
                        }
                    }
                }
                if (w > st[k].a as I64) {
                    st[k].a = w as I32;
                    st[k].d = pass as I32;
                    changed = true;
                }
            }
            if (changed && pass == nf + 1) {
                // Past nf passes a bound still rises only on a cycle that charges.
                for k in 0..nf {
                    if (st[k].d as I64 == pass) {
                        st[k].a = inf as I32;
                    }
                }
            }
        }
        all = changed;
    }
    for k in 0..nf {
        st[k].c = 0;
        if (all || (frame_entry(funcs, k) && st[k].a as I64 > FRAME_CAP)) {
            st[k].c = 1;
        }
    }
    Bool more = !all;
    while (more) {
        more = false;
        for k in 0..nf {
            if (st[k].c == 0 || (funcs[k].flags & FN_IMPORT) != 0) {
                continue;
            }
            for i in funcs[k].first as I64..funcs[k].last as I64 {
                I64 g = sir[i].a as I64;
                if ((sir[i].op & OP_MASK) == SO_CALL && g >= 0 && g < nf && st[g].c == 0) {
                    st[g].c = 1;
                    more = true;
                }
            }
        }
    }
    for k in 0..nf {
        if ((funcs[k].flags & FN_IMPORT) != 0) {
            continue;
        }
        for i in funcs[k].first as I64..funcs[k].last as I64 {
            if ((sir[i].op & OP_MASK) == SO_FRAME && sir[i].f == 0) {
                if (st[k].c == 0) {
                    sir[i].f = 3;
                } else {
                    funcs[k].flags = funcs[k].flags | FN_FRAME;
                }
            }
        }
    }
    I64 n = ls[0].sites;
    for i in 0..ls[0].nsir {
        if ((sir[i].op & OP_MASK) == SO_FRAME && sir[i].f == 0) {
            n += 1;
            sir[i].site = n as I32;
        }
    }
}

// ---------------------------------------------------------------- statements

// The decoded bytes of the raw string text text[a..b) (escapes and doubled braces),
// appended to `text` at ls[0].textn; returns their count, or -1 with C9001.
I64 decode_text[tn, t, r](inout U8[tn] text, in scan.Token[t] toks, inout limits.CompilerDiag[r] diag, inout LState[_] ls,
        I64 a, I64 b, I64 tk) {
    I64 at = ls[0].textn;
    I64 cap = tn;
    I64 k = a;
    I64[2] esc;
    U8[4] u;
    while (k < b) {
        I64 c = text[k] as I64;
        I64 nb = 1;
        if (c == 92) {
            I64 v = scan.escape_at(text, k, b, false, esc);
            k = esc[0];
            if (v < 0x80) {
                u[0] = v as U8;
            } else if (v < 0x800) {
                u[0] = (0xC0 | (v >> 6)) as U8;
                u[1] = (0x80 | (v & 0x3F)) as U8;
                nb = 2;
            } else if (v < 0x10000) {
                u[0] = (0xE0 | (v >> 12)) as U8;
                u[1] = (0x80 | ((v >> 6) & 0x3F)) as U8;
                u[2] = (0x80 | (v & 0x3F)) as U8;
                nb = 3;
            } else {
                u[0] = (0xF0 | (v >> 18)) as U8;
                u[1] = (0x80 | ((v >> 12) & 0x3F)) as U8;
                u[2] = (0x80 | ((v >> 6) & 0x3F)) as U8;
                u[3] = (0x80 | (v & 0x3F)) as U8;
                nb = 4;
            }
        } else if ((c == '{' || c == '}') && k + 1 < b && (text[k + 1] as I64) == c) {
            u[0] = c as U8;
            k += 2;
        } else {
            u[0] = c as U8;
            k += 1;
        }
        if (at + nb > cap) {
            stop_at(toks, diag, ls, limits.C_LIMIT, tk, limits.LIM_SOURCE, cap);
            return -1;
        }
        for j in 0..nb {
            text[at + j] = u[j];
        }
        at += nb;
    }
    I64 used = at - ls[0].textn;
    ls[0].textn = at;
    return used;
}

// SO_PRINT_BYTES of the decoded raw text text[a..b), when it is not empty; with `eq`, an
// `=` follows (the name of a `{expr=}` hole).
void print_text[tn, t, ns, r](inout U8[tn] text, in scan.Token[t] toks, inout Sir[ns] sir,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 a, I64 b, Bool eq, I64 tk) {
    I64 at = ls[0].textn;
    I64 used = decode_text(text, toks, diag, ls, a, b, tk);
    if (used < 0) {
        return;
    }
    if (eq) {
        if (ls[0].textn == tn) {
            stop_at(toks, diag, ls, limits.C_LIMIT, tk, limits.LIM_SOURCE, tn);
            return;
        }
        text[ls[0].textn] = '=';
        ls[0].textn += 1;
        used += 1;
    }
    if (used == 0) {
        return;
    }
    I64 i = add_sir(toks, sir, diag, ls, SO_PRINT_BYTES, T_NONE, tk);
    if (i >= 0) {
        sir[i].val = at;
        sir[i].c = used as I32;
    }
}

// The form of format specification sp for cint_rt_print_format (rt/cint_rt.h section 6c):
// the kind (1 `d` or none, 2 `x`, 3 `X`, 4 `o`, 5 `b`, 6 `t`), plus the alignment (16 `<`, 32
// `>`, 48 `^`), the sign (64 `+`, 128 a space; `-` is the default), 256 for `#`, 512 for `0`,
// and the group (1024 `_`, 2048 `,`). It is never 0.
I64 format_form(in I64[_] sp) {
    I64 k = sp[parse.FS_KIND];
    I64 form = 1;
    if (k == 'x') {
        form = 2;
    } else if (k == 'X') {
        form = 3;
    } else if (k == 'o') {
        form = 4;
    } else if (k == 'b') {
        form = 5;
    } else if (k == 't') {
        form = 6;
    }
    if (sp[parse.FS_ALIGN] == '<') {
        form += 16;
    } else if (sp[parse.FS_ALIGN] == '>') {
        form += 32;
    } else if (sp[parse.FS_ALIGN] == '^') {
        form += 48;
    }
    if (sp[parse.FS_SIGN] == '+') {
        form += 64;
    } else if (sp[parse.FS_SIGN] == ' ') {
        form += 128;
    }
    form += 256 * sp[parse.FS_ALT] + 512 * sp[parse.FS_ZERO];
    if (sp[parse.FS_GROUP] == '_') {
        form += 1024;
    } else if (sp[parse.FS_GROUP] == ',') {
        form += 2048;
    }
    return form;
}

// A print statement (SPEC-04 LS-193 to LS-197). Every hole is evaluated first, left to
// right and each once, and its value kept in a value frame (G-C2 review COR-1): a call in a
// hole that prints ends its own statement before this one is staged, as in `cint_ref`, and
// a hole that faults stages nothing. Then begin, the pieces and the kept values in source
// order, end. The checker has checked each hole's format specification (LS-213). A hole with
// a conversion, or with the kind `c` (LS-209, whose E_NARROW needs a fault site per hole),
// is C9102.
void lower_print[t, m, ns, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 base = ls[0].sp;
    I64[11] sp;
    I64 p = nodes[x].a as I64;
    while (p >= 0 && ls[0].err == 0) {
        if (nodes[p].kind == parse.N_HOLE) {
            I64 htk = nodes[nodes[p].a as I64].tok as I64;
            Bool spec = nodes[p].c >= 0 && parse.format_spec(text, nodes[p].c as I64, nodes[p].d as I64, sp);
            if (nodes[p].op != 0 || (spec && sp[parse.FS_KIND] == 'c')) {
                unsupported(toks, diag, ls, htk, U_HOLE);
                return;
            }
            if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[p].a as I64, T_NONE)) {
                return;
            }
            I32 ty = ls[0].rty as I32;
            if (!is_int(ty) && ty != T_BOOL) {
                unsupported(toks, diag, ls, htk, U_HOLE);
                return;
            }
            I64 vf = push(toks, st, diag, ls, K_VALUE, p, ty, htk);
            if (vf < 0) {
                return;
            }
            st[vf].a = ls[0].rv as I32;
        } else if (nodes[p].kind != parse.N_TEXT) {
            unsupported(toks, diag, ls, nodes[p].tok as I64, U_HOLE);
            return;
        }
        p = nodes[p].next as I64;
    }
    I64 b = add_sir(toks, sir, diag, ls, SO_PRINT_BEGIN, T_NONE, tk);
    site(sir, ls, b);
    I64 h = base;
    p = nodes[x].a as I64;
    while (p >= 0 && ls[0].err == 0) {
        if (nodes[p].kind == parse.N_TEXT) {
            print_text(text, toks, sir, diag, ls, nodes[p].c as I64, nodes[p].d as I64, false, nodes[p].tok as I64);
        } else {
            I64 htk = nodes[nodes[p].a as I64].tok as I64;
            Bool spec = nodes[p].c >= 0 && parse.format_spec(text, nodes[p].c as I64, nodes[p].d as I64, sp);
            I64 nm = nodes[p].b as I64;
            if (nm >= 0) {
                print_text(text, toks, sir, diag, ls, nodes[nm].c as I64, nodes[nm].d as I64, true, htk);
            }
            I64 v = add_sir(toks, sir, diag, ls, SO_PRINT_VALUE, st[h].want, htk);
            if (v >= 0) {
                sir[v].a = st[h].a;
                if (spec) {
                    sir[v].e = format_form(sp) as I32;
                    sir[v].f = ' ';
                    if (sp[parse.FS_FILL] >= 0) {
                        sir[v].f = sp[parse.FS_FILL] as I32;
                    }
                    sir[v].val = sp[parse.FS_WIDTH];
                    if (sp[parse.FS_WIDTH] < 0) {
                        sir[v].val = 0;
                    }
                    sir[v].c = 0;
                    if (sp[parse.FS_SCALE] >= 0) {
                        sir[v].c = sp[parse.FS_SCALE] as I32;
                    }
                }
            }
            h += 1;
        }
        p = nodes[p].next as I64;
    }
    ls[0].sp = base;
    _ = add_sir(toks, sir, diag, ls, SO_PRINT_END, T_NONE, tk);
}

// Stores value v in slot k (with the slot's type).
void store[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 k, I32 ty, I64 v, I64 tk) {
    I64 i = add_sir(toks, sir, diag, ls, SO_STORE, ty, tk);
    if (i >= 0) {
        sir[i].a = k as I32;
        sir[i].b = v as I32;
    }
}

// A variable declaration: its initializer (or the type's zero), then its slot, which
// comes into scope after the initializer.
void lower_var[n, t, m, ns, nl, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[nl] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    if (resolve.is_memory_decl(nodes, x)) {
        // A module-level arena or pool, a script's too (declare_memories).
        return;
    }
    if (resolve.is_mem(sem[x].ty) && !resolve.is_handle(sem[x].ty)) {
        lower_child_var(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        return;
    }
    I32 ty = T_NONE;
    I32 sty = struct_type_of(text, toks, nodes, slots, ls, nodes[x].a as I64);
    if (sty != T_NONE && nodes[x].op == 0 && (nodes[x].flags & parse.F_CONST) == 0) {
        I64 src = -1;
        if (nodes[x].b >= 0) {
            src = struct_value(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, sty);
            if (src < 0) {
                return;
            }
        }
        I64 ks = add_slot(toks, slots, diag, ls, tk, sty, SK_STRUCT, tk);
        I64 ds = add_sir(toks, sir, diag, ls, SO_LOCAL, sty, tk);
        if (ds < 0) {
            return;
        }
        sir[ds].a = ks as I32;
        if (src >= 0) {
            scopy(toks, sir, diag, ls, ks, src, tk);
        }
        return;
    }
    if ((nodes[x].op == scan.KW_IN || nodes[x].op == scan.KW_INOUT) && resolve.is_array(sem[x].ty)) {
        lower_view_var(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        return;
    }
    if (nodes[x].op == 0 && (nodes[x].flags & parse.F_CONST) == 0 && box09_local(nodes, sem, x)) {
        lower_array_var(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        return;
    }
    I32 aty = T_NONE;
    if (resolve.is_array(sem[x].ty)) {
        I64 nitems = resolve.array_extent(sem[x].ty);
        I64 elem = resolve.array_elem(sem[x].ty);
        if (resolve.is_errset(elem)) {
            elem = resolve.errset_under(elem);
        }
        if (nitems >= 0 && !resolve.is_struct(elem)) {
            I64 bytes = 1;
            if (elem != fold.TY_BOOL) { bytes = fold.ty_width(elem) / 8; }
            if (nitems * bytes <= 4096) { aty = (elem as I32) | ((nitems as I32) << 8); }
        } else if (nitems >= 0) {
            aty = struct_shape_of(text, toks, nodes, slots, ls, nodes[x].a as I64, -1, nitems);
        }
    }
    if (aty != T_NONE && nodes[x].op == 0 && (nodes[x].flags & parse.F_CONST) == 0) {
        // The charge to the frame arena, then the initializer, which is evaluated before the
        // array is declared and copied at the `=` token, which follows the name.
        frame_charge(toks, sir, funcs, diag, ls, resolve.array_extent(sem[x].ty), tk);
        I64 src = -1;
        if (nodes[x].b >= 0) {
            src = array_source(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, aty, nodes[x].b as I64);
            if (src < 0) {
                return;
            }
        }
        I64 ka = add_slot(toks, slots, diag, ls, tk, aty, SK_ARRAY, tk);
        I64 da = add_sir(toks, sir, diag, ls, SO_LOCAL, aty, tk);
        if (da < 0) {
            return;
        }
        sir[da].a = ka as I32;
        if (src >= 0) {
            array_copy(toks, sir, slots, diag, ls, ka, src, tk + 1);
        }
        return;
    }
    if (nodes[x].a >= 0) {
        ty = decl_type(toks, nodes, sem, nodes[x].a as I64, x);
        if (ty == T_NONE) {
            unsupported(toks, diag, ls, nodes[nodes[x].a as I64].tok as I64, U_TYPE);
            return;
        }
    } else if (nodes[x].op != scan.KW_VAR) {
        unsupported(toks, diag, ls, tk, U_DECLARATION);
        return;
    }
    if (nodes[x].op == scan.KW_IN || nodes[x].op == scan.KW_INOUT) {
        unsupported(toks, diag, ls, tk, U_VIEW);
        return;
    }
    I64 v = -1;
    if (nodes[x].b >= 0) {
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, ty)) {
            return;
        }
        v = ls[0].rv;
        ty = ls[0].rty as I32;
    } else {
        v = def_sir(toks, sir, diag, ls, SO_CONST, ty, tk);
    }
    I64 k = add_slot(toks, slots, diag, ls, tk, ty, SK_LOCAL, tk);
    I64 d = add_sir(toks, sir, diag, ls, SO_LOCAL, ty, tk);
    if (d < 0) {
        return;
    }
    sir[d].a = k as I32;
    store(toks, sir, diag, ls, k, ty, v, tk);
}

// Whether variable declaration x is an array that lower_array_var lowers (box 09): of rank 2
// to 4, of an extent known at run time, of more than 4,096 bytes, or initialized by an array
// literal; scalar elements.
Bool box09_local(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    I64 ty = sem[x].ty;
    if (!resolve.is_array(ty) || resolve.is_struct(resolve.array_elem(ty))) {
        return false;
    }
    I64 init = nodes[x].b as I64;
    return resolve.array_rank(ty) > 1 || resolve.array_extent(ty) < 0 || array_bytes(ty) > 4096 ||
        (init >= 0 && nodes[init].kind == parse.N_ARRAY);
}

// The bytes of the elements of rank-1 array type ty of static extent and scalar element,
// saturated above 4,096.
I64 array_bytes(I64 ty) {
    I64 n = resolve.array_extent(ty);
    if (n > 4096) {
        return 4097;
    }
    I64 elem = slot_elem(ty);
    if (elem == fold.TY_BOOL) {
        return n;
    }
    return n * (fold.ty_width(elem) / 8);
}

// The element stores of array literal e into array slot k (SPEC-04 LS-66): its items
// depth first, left to right, each of type ety, the n-th into element n (SO_AINIT).
void literal_items[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 e, I64 k, I32 ety) {
    I64[5] cur;
    I64 depth = 0;
    I64 at = 0;
    cur[0] = nodes[e].a as I64;
    while (depth >= 0 && ls[0].err == 0) {
        I64 g = cur[depth];
        if (g < 0) {
            depth -= 1;
            if (depth >= 0) {
                cur[depth] = nodes[cur[depth]].next as I64;
            }
        } else if (nodes[g].kind == parse.N_ARRAY && depth < 4) {
            depth += 1;
            cur[depth] = nodes[g].a as I64;
        } else {
            if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, g, ety)) {
                return;
            }
            _ = view_node(toks, sir, diag, ls, SO_AINIT, ety, k, ls[0].rv, -1, 0, at, nodes[g].tok as I64);
            at += 1;
            cur[depth] = nodes[g].next as I64;
        }
    }
}

// A local array of box 09 (box09_local; SPEC-04 LS-62 to LS-67, ruling R10), declaration x
// at its name tk. Static extents of at most 4,096 bytes of elements (EMIT-30): its charge to
// the frame arena (SO_FRAME), then an SK_ARRAY of rank 1, or a hidden flat SK_ARRAY and the
// SK_NVIEW of its name (SO_VBEGIN), zero-filled each time the declaration runs. Run-time
// extents, or more bytes (decision 2026-10-06 on OQ-213): the extents in written order, then
// SO_VDIM per dimension and SO_VALLOC (decl.shape at the name, then storage from the frame
// arena). Then the initializer: an array literal's items (SO_AINIT), or an array copied at
// the `=` token (copy.shape), evaluated before a static array is declared and after a
// run-time-sized one's extents, as `cint_ref` _vardecl does.
void lower_array_var[n, t, m, ns, nl, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[nl] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 ty = sem[x].ty;
    I64 rk = resolve.array_rank(ty);
    I32 ety = slot_elem(ty) as I32;
    I64 init = nodes[x].b as I64;
    Bool lit = init >= 0 && nodes[init].kind == parse.N_ARRAY;
    I64 total = 1;
    I64 packed = 0;
    Bool fixed = true;
    for d in 0..rk {
        I64 e = resolve.dim_extent(ty, d);
        if (e < 0 || e > 65534) {
            fixed = false;
        } else if (fixed) {
            total = total * e;
            packed = packed + (e << (12 * d));
            if (total > 4096) {
                total = 4097;
            }
        }
    }
    I64 bytes = 1;
    if (ety != T_BOOL) {
        bytes = fold.ty_width(ety as I64) / 8;
    }
    if (fixed && total * bytes > 4096) {
        // Run-time storage from the frame arena (decision 2026-10-06 on OQ-213).
        fixed = false;
    }
    if (!fixed && lit) {
        unsupported(toks, diag, ls, tk, U_VIEW);
        return;
    }
    if (fixed) {
        frame_charge(toks, sir, funcs, diag, ls, total, tk);
    }
    I64 src = -1;
    if (fixed && init >= 0 && !lit) {
        src = array_source(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, ety | (VIEW_ANY << 8), init);
        if (src < 0) {
            return;
        }
    }
    I64 k = -1;
    I64 flat = -1;
    if (fixed) {
        I64 name = tk;
        if (rk > 1) {
            name = -1;
        }
        flat = add_slot(toks, slots, diag, ls, name, ety | ((total as I32) << 8), SK_ARRAY, tk);
        I64 da = add_sir(toks, sir, diag, ls, SO_LOCAL, ety | ((total as I32) << 8), tk);
        if (da < 0) {
            return;
        }
        sir[da].a = flat as I32;
        k = flat;
        if (rk > 1) {
            k = add_slot(toks, slots, diag, ls, tk, ety | ((rk as I32) << 8), SK_NVIEW, tk);
            if (view_node(toks, sir, diag, ls, SO_VBEGIN, ety, k, flat, -1, 0, packed, tk) < 0) {
                return;
            }
        }
    } else {
        // The extents, left to right: an expression's value, a static one's constant.
        I64[4] ext;
        I64 g = nodes[nodes[nodes[x].a as I64].a as I64].a as I64;
        I64 known = 1;
        for d in 0..rk {
            I64 e = resolve.dim_extent(ty, d);
            known = sat_mul(known, e);
            if (e >= 0) {
                ext[d] = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
                if (ext[d] < 0) {
                    return;
                }
                sir[ext[d]].val = e;
            } else {
                if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, g, T_I64)) {
                    return;
                }
                ext[d] = ls[0].rv;
            }
            g = nodes[g].next as I64;
        }
        k = add_slot(toks, slots, diag, ls, tk, ety | ((rk as I32) << 8), SK_NVIEW, tk);
        for d in 0..rk {
            _ = view_node(toks, sir, diag, ls, SO_VDIM, ety, k, ext[d], -1, d, 0, tk);
        }
        // val: the element count when every extent is static (frame_proof), else -1.
        I64 al = view_node(toks, sir, diag, ls, SO_VALLOC, ety, k, -1, -1, rk, known, tk);
        site(sir, ls, al);
        if (init >= 0) {
            src = array_source(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, ety | (VIEW_ANY << 8), init);
            if (src < 0) {
                return;
            }
        }
    }
    if (lit) {
        literal_items(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, init, flat, ety);
    } else if (src >= 0) {
        array_copy(toks, sir, slots, diag, ls, k, src, tk + 1);
    }
}

// A view variable `in T[...] v = e;` or `inout` (SPEC-04 LS-69, LS-106): the SK_NVIEW of
// its name bound to the storage of e (SO_VBEGIN), with no extent check at run time, as
// `cint_ref` _vardecl binds it.
void lower_view_var[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 ty = sem[x].ty;
    I32 ety = slot_elem(ty) as I32;
    if (!resolve.is_array(ty) || resolve.is_struct(ety as I64) || nodes[x].b < 0) {
        unsupported(toks, diag, ls, tk, U_VIEW);
        return;
    }
    I64 init = nodes[x].b as I64;
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, init, ety | (VIEW_ANY << 8))) {
        return;
    }
    I64 s = view_value(toks, slots, diag, ls, ls[0].rv, nodes[init].tok as I64);
    if (s < 0) {
        return;
    }
    if (leased(slots, ls[0].nslot, s)) {
        // The view of an arena allocation (box 12): the variable is its hidden view, which
        // keeps the lease; a view of another such variable, or of structs, is C9102.
        if (slots[s].name >= 0 || slots[s].ty >= T_STRUCT) {
            unsupported(toks, diag, ls, tk, U_MEMORY);
            return;
        }
        slots[s].name = tk as I32;
        return;
    }
    I64 k = add_slot(toks, slots, diag, ls, tk, ety | ((resolve.array_rank(ty) as I32) << 8), SK_NVIEW, tk);
    I64 vb = view_node(toks, sir, diag, ls, SO_VBEGIN, ety, k, s, -1, 0, 0, tk);
    if (vb >= 0 && nodes[x].op == scan.KW_IN) {
        // A read-only view (SPEC-02 A-8: a dispatch's alias record says read).
        sir[vb].e = 2;
    }
}

// An assignment whose target is a view (a slice or a partial index; SPEC-04 LS-70): the
// place, its checks, then the source, then SO_VCOPY at the `=` token.
void lower_view_assign[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 target = nodes[x].a as I64;
    if (nodes[x].kind != parse.N_ASSIGN || nodes[x].op != scan.OP_ASSIGN) {
        unsupported(toks, diag, ls, tk, U_VIEW);
        return;
    }
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, target, VIEW_ANY << 8)) {
        return;
    }
    I64 k = view_value(toks, slots, diag, ls, ls[0].rv, nodes[target].tok as I64);
    if (k < 0) {
        return;
    }
    I64 s = array_source(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, slots[k].ty, nodes[x].b as I64);
    if (s >= 0) {
        array_copy(toks, sir, slots, diag, ls, k, s, tk);
    }
}

// An assignment to an element on the view path (general_index): the place with its checks
// (index_step with want W_ELEMENT), then, for a compound assignment, the element's load,
// the value and the operation, else the value; then SO_ESTORE.
void lower_view_element[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 target = nodes[x].a as I64;
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, target, W_ELEMENT)) {
        return;
    }
    I64 iv = ls[0].rv;
    I64 k = ls[0].rend;
    I32 ty = array_elem(slots[k].ty);
    I32 op = nodes[x].op;
    I64 v = -1;
    if (nodes[x].kind == parse.N_ASSIGN && op == scan.OP_ASSIGN) {
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, ty)) {
            return;
        }
        v = ls[0].rv;
    } else {
        I64[2] bo;
        I64 ld = def_sir(toks, sir, diag, ls, SO_ELOAD, ty, nodes[target].tok as I64);
        if (ld < 0) {
            return;
        }
        sir[ld].a = k as I32;
        sir[ld].b = iv as I32;
        I64 rhs = -1;
        if (nodes[x].kind == parse.N_INCDEC) {
            bo[0] = B_ADD as I64;
            bo[1] = 0;
            if (op == scan.OP_DEC) {
                bo[0] = B_SUB as I64;
            }
            rhs = def_sir(toks, sir, diag, ls, SO_CONST, ty, tk);
            if (rhs < 0) {
                return;
            }
            sir[rhs].val = 1;
        } else {
            binary_op(op, bo);
            if (bo[0] == 0) {
                unsupported(toks, diag, ls, tk, U_OPERATOR);
                return;
            }
            I32 w = ty;
            if (bo[0] == B_SHL as I64 || bo[0] == B_SHR as I64) {
                w = T_NONE;
            }
            if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, w)) {
                return;
            }
            rhs = ls[0].rv;
        }
        v = def_sir(toks, sir, diag, ls, SO_BIN, ty, tk);
        if (v < 0) {
            return;
        }
        sir[v].a = ld as I32;
        sir[v].b = rhs as I32;
        sir[v].c = bo[0] as I32;
        sir[v].f = bo[1] as I32;
        if (bin_faults(bo[0] as I32, bo[1] as I32)) {
            site(sir, ls, v);
        }
        kernel_bin_step(toks, sir, funcs, diag, ls, bo[0], tk);
    }
    I64 s = add_sir(toks, sir, diag, ls, SO_ESTORE, ty, tk);
    if (s >= 0) {
        sir[s].a = k as I32;
        sir[s].b = iv as I32;
        sir[s].c = v as I32;
    }
}

// The slot of an imported variable that `alias.name` node x names, or -1.
I64 import_var[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirFunc[_] funcs,
        in LState[_] ls, I64 x) {
    if (nodes[x].kind != parse.N_FIELD || nodes[nodes[x].a as I64].kind != parse.N_NAME) {
        return -1;
    }
    I64 ic = find_import(text, toks, funcs, ls, nodes[nodes[x].a as I64].tok as I64, nodes[x].tok as I64);
    if (ic < 0 || (funcs[ic].flags & FN_IVAR) == 0) {
        return -1;
    }
    return funcs[ic].pslot0 as I64;
}

// The local slot that assignment target x names, or -1 with C9102.
I64 target_slot[n, t, m, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in SirFunc[_] funcs,
        in SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    if (nodes[x].kind == parse.N_NAME) {
        I64 k = find_slot(text, toks, funcs, slots, ls, nodes[x].tok as I64);
        if (k >= 0 && (slots[k].kind == SK_LOCAL || slots[k].kind == SK_GLOBAL)) {
            return k;
        }
    }
    I64 vk = import_var(text, toks, nodes, funcs, ls, x);
    if (vk >= 0) {
        return vk;
    }
    unsupported(toks, diag, ls, nodes[x].tok as I64, U_EXPRESSION);
    return -1;
}

// An assignment, a compound assignment, `++`, or `--` (the fault position is the
// operator token, SPEC-04 LS-278).
void lower_assign[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    Bool deref = nodes[nodes[x].a as I64].kind == parse.N_INDEX && (sem[nodes[x].a as I64].flags & resolve.SEM_DEREF) != 0;
    if (nodes[nodes[x].a as I64].kind == parse.N_INDEX && !deref) {
        lower_element_assign(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        return;
    }
    if (nodes[nodes[x].a as I64].kind == parse.N_FIELD && import_var(text, toks, nodes, funcs, ls, nodes[x].a as I64) < 0) {
        lower_field_assign(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        return;
    }
    if (nodes[nodes[x].a as I64].kind == parse.N_NAME) {
        I64 ks = find_slot(text, toks, funcs, slots, ls, nodes[nodes[x].a as I64].tok as I64);
        if (ks >= 0 && (slots[ks].kind == SK_ARRAY || slots[ks].kind == SK_VIEW || slots[ks].kind == SK_NVIEW) &&
                nodes[x].kind == parse.N_ASSIGN && nodes[x].op == scan.OP_ASSIGN) {
            array_assign(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, ks, nodes[x].b as I64, tk);
            return;
        }
        if (ks >= 0 && (slots[ks].kind == SK_STRUCT || slots[ks].kind == SK_SREF)) {
            if (nodes[x].kind != parse.N_ASSIGN || nodes[x].op != scan.OP_ASSIGN) {
                unsupported(toks, diag, ls, tk, U_STRUCT);
                return;
            }
            I64 src = struct_value(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64,
                slots[ks].ty);
            if (src >= 0) {
                scopy(toks, sir, diag, ls, ks, src, tk);
            }
            return;
        }
    }
    I64 k = -1;
    if (deref) {
        // A pool's element (box 12): its place, or the whole struct assigned there.
        k = deref_target(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
    } else {
        k = target_slot(text, toks, nodes, funcs, slots, diag, ls, nodes[x].a as I64);
    }
    if (k < 0) {
        return;
    }
    I32 ty = slots[k].ty;
    I32 op = nodes[x].op;
    if (nodes[x].kind == parse.N_ASSIGN && op == scan.OP_ASSIGN) {
        if (lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, ty)) {
            store(toks, sir, diag, ls, k, ty, ls[0].rv, tk);
        }
        return;
    }
    I64[2] bo;
    I64 ld = def_sir(toks, sir, diag, ls, SO_LOAD, ty, nodes[nodes[x].a as I64].tok as I64);
    if (ld < 0) {
        return;
    }
    sir[ld].a = k as I32;
    I64 rhs = -1;
    if (nodes[x].kind == parse.N_INCDEC) {
        bo[0] = B_ADD as I64;
        bo[1] = 0;
        if (op == scan.OP_DEC) {
            bo[0] = B_SUB as I64;
        }
        rhs = def_sir(toks, sir, diag, ls, SO_CONST, ty, tk);
        if (rhs < 0) {
            return;
        }
        sir[rhs].val = 1;
    } else {
        binary_op(op, bo);
        if (bo[0] == 0) {
            unsupported(toks, diag, ls, tk, U_OPERATOR);
            return;
        }
        I32 w = ty;
        if (bo[0] == B_SHL as I64 || bo[0] == B_SHR as I64) {
            w = T_NONE;
        }
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, w)) {
            return;
        }
        rhs = ls[0].rv;
    }
    I64 i = def_sir(toks, sir, diag, ls, SO_BIN, ty, tk);
    if (i < 0) {
        return;
    }
    sir[i].a = ld as I32;
    sir[i].b = rhs as I32;
    sir[i].c = bo[0] as I32;
    sir[i].f = bo[1] as I32;
    if (bin_faults(bo[0] as I32, bo[1] as I32)) {
        site(sir, ls, i);
    }
    kernel_bin_step(toks, sir, funcs, diag, ls, bo[0], tk);
    store(toks, sir, diag, ls, k, ty, i, tk);
}

// Whole-array assignment of source expression e into array place k (SPEC-04 LS-70). The
// place is evaluated first, then the source, then the copy.
void array_assign[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 k, I64 e, I64 tk) {
    I64 s = array_source(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, slots[k].ty, e);
    if (s >= 0) {
        array_copy(toks, sir, slots, diag, ls, k, s, tk);
    }
}

// The slot of array source expression e in the context of array type ty, or -1 with C9102.
// A local array of extent 0 has its element type as its type; the context is then a view of
// any extent.
I64 array_source[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I32 ty, I64 e) {
    I32 want = ty;
    if (want <= 255) { want = want | (VIEW_ANY << 8); }
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, e, want)) { return -1; }
    if (ls[0].rv > VIEW_ARG || ls[0].rv <= STR_ARG) {
        unsupported(toks, diag, ls, nodes[e].tok as I64, U_VIEW);
        return -1;
    }
    I64 k = VIEW_ARG - ls[0].rv;
    if (leased(slots, ls[0].nslot, k) && slots[k].name >= 0) {
        // A copy from a view variable of an arena allocation would check its lease (box 12).
        unsupported(toks, diag, ls, nodes[e].tok as I64, U_MEMORY);
        return -1;
    }
    return k;
}

// The copy of array slot s into array place k: when an extent is known only at run time,
// copy.shape at the `=` token tk (SPEC-01 IM-187), then every element.
void array_copy[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 k, I64 s, I64 tk) {
    if (slots[k].kind == SK_NVIEW || slots[s].kind == SK_NVIEW) {
        // A view of box 09: copy.shape per dimension, then copy.alias (SO_VCOPY).
        I64 vc = add_sir(toks, sir, diag, ls, SO_VCOPY, array_elem(slots[k].ty), tk);
        if (vc >= 0) {
            sir[vc].a = k as I32;
            sir[vc].b = s as I32;
            site(sir, ls, vc);
        }
        return;
    }
    I64 limit = slot_extent(slots, k);
    I64 check = -1;
    if (limit < 0 || slot_extent(slots, s) < 0) {
        check = add_sir(toks, sir, diag, ls, SO_COPY_SHAPE, T_NONE, tk);
        if (check < 0) { return; }
        sir[check].a = s as I32;
        sir[check].b = 0;
        sir[check].c = -1;
        sir[check].val = limit;
        if (limit < 0) {
            sir[check].c = k as I32;
            sir[check].val = 0;
        }
        site(sir, ls, check);
    }
    I64 i = add_sir(toks, sir, diag, ls, SO_ACOPY, array_elem(slots[k].ty), tk);
    if (i >= 0) {
        sir[i].a = k as I32;
        sir[i].b = s as I32;
        sir[i].f = check as I32;
    }
}

// SO_SCOPY of struct slot b into struct slot a.
void scopy[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 a, I64 b, I64 tk) {
    I64 i = add_sir(toks, sir, diag, ls, SO_SCOPY, T_NONE, tk);
    if (i >= 0) {
        sir[i].a = a as I32;
        sir[i].b = b as I32;
    }
}

// The struct slot that holds the value of struct expression e of type ty: the slot a name
// names, or a hidden slot that a constructor fills field by field in written order
// (`cint_ref` evaluates every argument before the struct is assigned); -1 on error.
I64 struct_value[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 e, I32 ty) {
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, e, ty)) { return -1; }
    if (ls[0].rv <= VIEW_ARG && ls[0].rv > STR_ARG && ls[0].rty == ty as I64) {
        return VIEW_ARG - ls[0].rv;
    }
    unsupported(toks, diag, ls, nodes[e].tok as I64, U_STRUCT);
    return -1;
}

// The struct type whose name token tk spells, or T_NONE.
I32 struct_type_name[n, t](in U8[n] text, in scan.Token[t] toks, in SirSlot[_] slots, in LState[_] ls, I64 tk) {
    I64 k = 0;
    while (k < ls[0].nslot && (slots[k].kind == SK_SDECL || slots[k].kind == SK_FIELD)) {
        if (slots[k].kind == SK_SDECL && slots[k].live == 1 && same_name(text, toks, slots[k].name as I64, tk)) {
            return T_STRUCT + (k as I32);
        }
        k += 1;
    }
    return T_NONE;
}

// An assignment, compound assignment, `++` or `--` of a field of a struct variable.
void lower_field_assign[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 target = nodes[x].a as I64;
    I64 ix = nodes[target].a as I64;
    I64 k = -1;
    I64 iv = -1;
    Bool element_place = nodes[ix].kind == parse.N_INDEX && nodes[nodes[ix].a as I64].kind == parse.N_NAME &&
        (sem[ix].flags & resolve.SEM_DEREF) == 0;
    I32 sty = T_NONE;
    if (element_place) {
        // A field of a struct element (task 2.14): the index and its check come first, as
        // for an element (lower_element_assign).
        k = array_slot(text, toks, nodes, funcs, slots, diag, ls, ix);
        if (k < 0) {
            return;
        }
        sty = array_elem(slots[k].ty);
        if (sty < T_STRUCT) {
            unsupported(toks, diag, ls, tk, U_STRUCT);
            return;
        }
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[ix].b as I64, T_I64)) {
            return;
        }
        iv = ls[0].rv;
        if (index_check(toks, sir, diag, ls, sty, k, iv, nodes[ix].tok as I64) < 0) {
            return;
        }
    } else {
        if (nodes[ix].kind == parse.N_FIELD || nodes[ix].kind == parse.N_INDEX) {
            if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, ix, T_NONE)) { return; }
            if (ls[0].rv <= VIEW_ARG && ls[0].rv > STR_ARG) { k = VIEW_ARG - ls[0].rv; }
        } else {
            k = struct_base(text, toks, nodes, funcs, slots, diag, ls, target);
        }
        if (k < 0) {
            return;
        }
        if (slots[k].kind != SK_STRUCT && slots[k].kind != SK_SREF && slots[k].kind != SK_SPLACE) {
            unsupported(toks, diag, ls, tk, U_STRUCT);
            return;
        }
        sty = slots[k].ty;
    }
    I64 j = field_index(text, toks, slots, sty, nodes[target].tok as I64);
    I32 ty = field_type(slots, sty, j);
    if (field_array(ty)) {
        if (nodes[x].kind != parse.N_ASSIGN || nodes[x].op != scan.OP_ASSIGN) {
            unsupported(toks, diag, ls, tk, U_STRUCT);
            return;
        }
        // A whole array field: its record place, then the field's address, then the copy.
        I64 base = k;
        if (element_place) {
            base = add_slot(toks, slots, diag, ls, -1, sty, SK_SPLACE, tk);
            I64 er = add_sir(toks, sir, diag, ls, SO_EREF, sty, tk);
            if (base < 0 || er < 0) { return; }
            sir[er].a = base as I32;
            sir[er].b = k as I32;
            sir[er].c = iv as I32;
        }
        I64 h = field_ref(toks, sir, slots, diag, ls, base, j, nodes[target].tok as I64);
        if (h < 0) { return; }
        array_assign(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, h, nodes[x].b as I64, tk);
        return;
    }
    if (ty >= T_STRUCT && !element_place && nodes[x].kind == parse.N_ASSIGN && nodes[x].op == scan.OP_ASSIGN) {
        I64 src = struct_value(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, ty);
        if (src < 0) { return; }
        I64 cp = add_sir(toks, sir, diag, ls, SO_FSCOPY, ty, tk);
        if (cp < 0) { return; }
        sir[cp].a = k as I32;
        sir[cp].b = src as I32;
        sir[cp].c = j as I32;
        return;
    }
    if (ty > 255) {
        unsupported(toks, diag, ls, tk, U_STRUCT);
        return;
    }
    I32 op = nodes[x].op;
    I64 v = -1;
    if (nodes[x].kind == parse.N_ASSIGN && op == scan.OP_ASSIGN) {
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, ty)) {
            return;
        }
        v = ls[0].rv;
    } else {
        I64[2] bo;
        I32 lop = SO_FLOAD;
        if (element_place) {
            lop = SO_EFLOAD;
        }
        I64 ld = def_sir(toks, sir, diag, ls, lop, ty, nodes[target].tok as I64);
        if (ld < 0) {
            return;
        }
        sir[ld].a = k as I32;
        sir[ld].b = iv as I32;
        sir[ld].c = j as I32;
        I64 rhs = -1;
        if (nodes[x].kind == parse.N_INCDEC) {
            bo[0] = B_ADD as I64;
            bo[1] = 0;
            if (op == scan.OP_DEC) {
                bo[0] = B_SUB as I64;
            }
            rhs = def_sir(toks, sir, diag, ls, SO_CONST, ty, tk);
            if (rhs < 0) {
                return;
            }
            sir[rhs].val = 1;
        } else {
            binary_op(op, bo);
            if (bo[0] == 0) {
                unsupported(toks, diag, ls, tk, U_OPERATOR);
                return;
            }
            I32 w = ty;
            if (bo[0] == B_SHL as I64 || bo[0] == B_SHR as I64) {
                w = T_NONE;
            }
            if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, w)) {
                return;
            }
            rhs = ls[0].rv;
        }
        I64 i = def_sir(toks, sir, diag, ls, SO_BIN, ty, tk);
        if (i < 0) {
            return;
        }
        sir[i].a = ld as I32;
        sir[i].b = rhs as I32;
        sir[i].c = bo[0] as I32;
        sir[i].f = bo[1] as I32;
        if (bin_faults(bo[0] as I32, bo[1] as I32)) {
            site(sir, ls, i);
        }
        v = i;
    }
    if (element_place) {
        I64 es = add_sir(toks, sir, diag, ls, SO_EFSTORE, ty, tk);
        if (es >= 0) {
            sir[es].a = k as I32;
            sir[es].b = iv as I32;
            sir[es].c = j as I32;
            sir[es].f = v as I32;
        }
        return;
    }
    I64 s = add_sir(toks, sir, diag, ls, SO_FSTORE, ty, tk);
    if (s >= 0) {
        sir[s].a = k as I32;
        sir[s].b = v as I32;
        sir[s].c = j as I32;
    }
}

// An assignment, compound assignment, `++` or `--` of an array element: the index and its
// bounds check first, then the value (`cint_ref` evaluates the place before the value;
// conformance case view/index_checked_before_value), the operation, and the store.
void lower_element_assign[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I64 target = nodes[x].a as I64;
    I64 ttk = nodes[target].tok as I64;
    if ((sem[target].flags & resolve.SEM_VIEW) != 0) {
        lower_view_assign(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        return;
    }
    if (general_index(text, toks, nodes, sem, funcs, slots, ls, target)) {
        lower_view_element(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        return;
    }
    I64[1] fj;
    fj[0] = -1;
    I64 k = -1;
    I64 fb = nodes[target].a as I64;
    if (nodes[fb].kind == parse.N_FIELD && nodes[nodes[fb].a as I64].kind != parse.N_NAME) {
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[fb].a as I64, T_NONE)) { return; }
        if (ls[0].rv <= VIEW_ARG && ls[0].rv > STR_ARG) { k = VIEW_ARG - ls[0].rv; }
        if (k >= 0) { fj[0] = field_index(text, toks, slots, slots[k].ty, nodes[fb].tok as I64); }
    } else {
        k = elem_base(text, toks, nodes, funcs, slots, diag, ls, target, fj);
    }
    if (k < 0) { return; }
    if (fj[0] >= 0 && slots[k].kind != SK_STRUCT && slots[k].kind != SK_SREF && slots[k].kind != SK_SPLACE) {
        unsupported(toks, diag, ls, tk, U_STRUCT);
        return;
    }
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[target].b as I64, T_I64)) {
        return;
    }
    I64 iv = ls[0].rv;
    I32 ty = base_elem(slots, k, fj[0]);
    I32 op = nodes[x].op;
    I64 v = -1;
    if (ty >= T_STRUCT && nodes[x].kind == parse.N_ASSIGN && op == scan.OP_ASSIGN) {
        I64 target_place = element_ref(toks, sir, slots, diag, ls, ty, k, iv, ttk, fj[0]);
        if (target_place < 0) { return; }
        I64 source_slot = struct_value(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, ty);
        if (source_slot < 0) { return; }
        scopy(toks, sir, diag, ls, target_place, source_slot, tk);
        return;
    }
    if (nodes[x].kind == parse.N_ASSIGN && op == scan.OP_ASSIGN) {
        if (field_check(toks, sir, diag, ls, ty, k, iv, ttk, fj[0]) < 0) {
            return;
        }
        kernel_step(toks, sir, funcs, diag, ls, ttk);
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, ty)) {
            return;
        }
        v = ls[0].rv;
    } else {
        I64[2] bo;
        I64 ld = element_of(toks, sir, slots, diag, ls, k, iv, ttk, fj[0]);
        if (ld < 0) {
            return;
        }
        kernel_step(toks, sir, funcs, diag, ls, ttk);
        I64 rhs = -1;
        if (nodes[x].kind == parse.N_INCDEC) {
            bo[0] = B_ADD as I64;
            bo[1] = 0;
            if (op == scan.OP_DEC) {
                bo[0] = B_SUB as I64;
            }
            rhs = def_sir(toks, sir, diag, ls, SO_CONST, ty, tk);
            if (rhs < 0) {
                return;
            }
            sir[rhs].val = 1;
        } else {
            binary_op(op, bo);
            if (bo[0] == 0) {
                unsupported(toks, diag, ls, tk, U_OPERATOR);
                return;
            }
            I32 w = ty;
            if (bo[0] == B_SHL as I64 || bo[0] == B_SHR as I64) {
                w = T_NONE;
            }
            if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].b as I64, w)) {
                return;
            }
            rhs = ls[0].rv;
        }
        v = def_sir(toks, sir, diag, ls, SO_BIN, ty, tk);
        if (v < 0) {
            return;
        }
        sir[v].a = ld as I32;
        sir[v].b = rhs as I32;
        sir[v].c = bo[0] as I32;
        sir[v].f = bo[1] as I32;
        if (bin_faults(bo[0] as I32, bo[1] as I32)) {
            site(sir, ls, v);
        }
        kernel_bin_step(toks, sir, funcs, diag, ls, bo[0], tk);
    }
    if (fj[0] >= 0) {
        I64 fs = add_sir(toks, sir, diag, ls, SO_FESTORE, ty, tk);
        if (fs >= 0) {
            sir[fs].a = k as I32;
            sir[fs].b = iv as I32;
            sir[fs].c = fj[0] as I32;
            sir[fs].f = v as I32;
        }
        return;
    }
    I64 s = add_sir(toks, sir, diag, ls, SO_ESTORE, ty, tk);
    if (s >= 0) {
        sir[s].a = k as I32;
        sir[s].b = iv as I32;
        sir[s].c = v as I32;
    }
}

// The frame of the structure that `break` (or `continue`, with `cont`) at node x leaves:
// the innermost loop (or switch, for an unlabeled break), or the loop whose label it names;
// the frame's e is its begin node. -1 with C9102.
I64 jump_frame[n, t, m, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x, Bool cont) {
    I64 label = nodes[x].c as I64;
    I64 f = ls[0].sp - 1;
    while (f >= 0) {
        I32 k = st[f].kind;
        I64 node = st[f].node as I64;
        Bool loop = k == K_WHILE || k == K_FOR || k == K_RANGE;
        if (label < 0) {
            if (loop || (k == K_SWITCH && !cont)) {
                return f;
            }
        } else if (loop && nodes[node].start != nodes[node].tok &&
                same_name(text, toks, nodes[node].start as I64, label)) {
            return f;
        }
        f -= 1;
    }
    unsupported(toks, diag, ls, nodes[x].tok as I64, U_STATEMENT);
    return -1;
}

// A statement that opens no frame. False when x opens one (the caller pushes it).
Bool lower_simple[t, m, ns, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    if (union_top(nodes, stmt_expr(nodes, x)) != 0) {
        // A statement whose expression is `try`, or a `catch` with a block (box 12).
        return false;
    }
    switch (nodes[x].kind) {
        case parse.N_VAR:
            lower_var(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        case parse.N_ASSIGN, parse.N_INCDEC:
            lower_assign(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        case parse.N_EXPR_STMT, parse.N_DISCARD:
            if (lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].a as I64, T_NONE)) {
                I64 v = ls[0].rv;
                if (v >= 0 && (sir[v].op & OP_MASK) == SO_ETAG && sir[sir[v].a as I64].dst >= 0) {
                    // `_ =` drops a union (LS-95): its value, then its tag.
                    I64 u = add_sir(toks, sir, diag, ls, SO_DISCARD, T_NONE, tk);
                    if (u >= 0) {
                        sir[u].a = sir[v].a;
                    }
                }
                if (v >= 0 && sir[v].dst >= 0) {
                    I64 i = add_sir(toks, sir, diag, ls, SO_DISCARD, T_NONE, tk);
                    if (i >= 0) {
                        sir[i].a = v as I32;
                    }
                }
            }
        case parse.N_RETURN:
            // Deferred statements may run first (return_exit, box 12).
            I64[2] rv;
            if (return_eval(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x, rv)) {
                return_exit(toks, sir, funcs, slots, st, diag, ls, rv[0], rv[1], rv[1] == 3, tk);
            }
        case parse.N_BREAK, parse.N_CONTINUE:
            Bool cont = nodes[x].kind == parse.N_CONTINUE;
            I64 tf = jump_frame(text, toks, nodes, st, diag, ls, x, cont);
            if (tf < 0) {
                return true;
            }
            I64[2] gs;
            exit_groups(st, ls, tf, false, gs);
            if (gs[0] >= 0) {
                // Deferred statements run first (exit_through, box 12).
                I64 code = 2 + 2 * (st[tf].e as I64);
                if (cont) {
                    code += 1;
                }
                exit_through(toks, sir, slots, st, diag, ls, gs, code, 0, tf, cont, false, tk);
                return true;
            }
            I32 op = SO_BREAK;
            if (cont) {
                op = SO_CONTINUE;
            }
            frame_release(toks, sir, st, diag, ls, tf, ls[0].sp, tk);
            I64 i = add_sir(toks, sir, diag, ls, op, T_NONE, tk);
            if (i >= 0) {
                sir[i].a = st[tf].e;
            }
        case parse.N_DEFER:
            defer_mark(toks, nodes, sir, st, diag, ls, x);
        case parse.N_PRINT:
            lower_print(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        case parse.N_ASSERT:
            // The condition, then the check (SPEC-04 LS-191); the message is not evaluated.
            I64 cond = nodes[x].a as I64;
            if (lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, cond, T_BOOL)) {
                I64 v = ls[0].rv;
                I64 i = add_sir(toks, sir, diag, ls, SO_ASSERT, T_NONE, nodes[cond].start as I64);
                if (i >= 0) {
                    sir[i].a = v as I32;
                    sir[i].b = 0;
                    if (v >= 0 && nodes[cond].kind == parse.N_COMPARE && (sir[v].op & OP_MASK) == SO_CMP) {
                        sir[i].b = 1;
                    }
                    site(sir, ls, i);
                }
            }
        case parse.N_REDUCE:
            lower_reduce(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
        case parse.N_FALLTHROUGH, parse.N_STATIC_ASSERT, parse.N_FUNC, parse.N_TEST, parse.N_PROFILE, parse.N_IMPORT,
                parse.N_KERNEL, parse.N_ERROR_DECL:
            // fallthrough is read by the case that ends with it; static_assert has no
            // run-time part; declarations among a script's statements are lowered apart, and
            // an import is bound by the checker (task 2.13 part (iii)), as an error set is
            // (box 12).
            return true;
        case parse.N_BLOCK, parse.N_IF, parse.N_WHILE, parse.N_FOR, parse.N_FOR_RANGE, parse.N_SWITCH:
            return false;
        default:
            unsupported(toks, diag, ls, tk, U_STATEMENT);
    }
    return true;
}

// Hides the slots declared since mark (the end of their block).
void hide(inout SirSlot[_] slots, in LState[_] ls, I64 mark) {
    for k in mark..ls[0].nslot {
        slots[k].live = 0;
    }
}

// The last statement of list x, or -1.
I64 last_stmt(in parse.Node[_] nodes, I64 x) {
    I64 y = x;
    if (y < 0) {
        return -1;
    }
    while (nodes[y].next >= 0) {
        y = nodes[y].next as I64;
    }
    return y;
}

// Pushes the frame of compound statement x.
void open_stmt[t, m, r](in scan.Token[t] toks, in parse.Node[m] nodes, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 tk = nodes[x].tok as I64;
    I32 k = K_LIST;
    I64 node = x;
    switch (nodes[x].kind) {
        case parse.N_BLOCK: k = K_LIST; node = nodes[x].a as I64;
        case parse.N_IF: k = K_IF;
        case parse.N_WHILE: k = K_WHILE;
        case parse.N_FOR: k = K_FOR;
        case parse.N_FOR_RANGE: k = K_RANGE;
        case parse.N_SWITCH: k = K_SWITCH;
        default:
            // Box 12: a statement whose expression is `try` or a `catch` with a block.
            k = union_top(nodes, stmt_expr(nodes, x));
            if (k == 0) {
                unsupported(toks, diag, ls, tk, U_STATEMENT);
                return;
            }
    }
    I64 f = push(toks, st, diag, ls, k, node, T_NONE, tk);
    if (f >= 0) {
        st[f].a = ls[0].nslot as I32;
    }
}

// The statements of block node `blk` in a new list frame.
void open_block[t, m, r](in scan.Token[t] toks, in parse.Node[m] nodes, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 blk) {
    open_stmt(toks, nodes, st, diag, ls, blk);
}

// A loop's condition (x, or none when x < 0), SO_TEST, and the iteration's fuel charge at
// the loop keyword kw (SPEC-01 10.2; IM-141).
void loop_head[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 loop, I64 x, I64 kw) {
    if (x >= 0) {
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x, T_BOOL)) {
            return;
        }
        I64 te = add_sir(toks, sir, diag, ls, SO_TEST, T_NONE, kw);
        if (te < 0) {
            return;
        }
        sir[te].a = ls[0].rv as I32;
        sir[te].b = loop as I32;
    }
    I64 c = add_sir(toks, sir, diag, ls, SO_FUEL, T_NONE, kw);
    if (c >= 0) {
        sir[c].val = 1;
        site(sir, ls, c);
    }
}

// One step of statement frame f.
void stmt_step[t, m, ns, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I32 k = st[f].kind;
    if (k == K_LIST) {
        if (x < 0) {
            // The end of the list. With deferred statements (the group of K_DEFER frames below
            // it, LS-185): exit code 0 when the list ends normally and an exit passes the
            // group, then the regions' ends and the deferred statements (K_UNWIND). Then its
            // frame and theirs pop.
            I64 nd = st[f].b as I64;
            if (nd < 0) {
                nd = 0;
            }
            if (nd > 0 && st[f].c != 1) {
                st[f].c = 1;
                I64 g = f - nd;
                I64 tk = nodes[st[g].node as I64].tok as I64;
                if (st[g].b >= 0 && list_falls(nodes, sem, st, f)) {
                    I64 z = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
                    if (z < 0) {
                        return;
                    }
                    store(toks, sir, diag, ls, st[g].b as I64, T_I64, z, tk);
                }
                I64 u = push(toks, st, diag, ls, K_UNWIND, -1, T_NONE, tk);
                if (u >= 0) {
                    st[u].a = (f - 1) as I32;
                    st[u].b = g as I32;
                    st[u].c = f as I32;
                }
                return;
            }
            if (nd == 0 && st[f].h >= 0) {
                frame_release(toks, sir, st, diag, ls, f - 1, f + 1, nodes[st[f].e as I64].tok as I64);
            }
            hide(slots, ls, st[f].a as I64);
            ls[0].sp = f - nd;
            return;
        }
        if (st[f].e < 0) {
            frame_mark(toks, nodes, sem, sir, funcs, st, diag, ls, f, x);
        }
        st[f].e = x as I32;
        st[f].node = nodes[x].next;
        if (!lower_simple(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x)) {
            open_stmt(toks, nodes, st, diag, ls, x);
        }
        return;
    }
    if (k == K_UNWIND) {
        defer_end_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
        return;
    }
    if (k == K_TRY) {
        try_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
        return;
    }
    if (k == K_CATCH) {
        catch_stmt_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
        return;
    }
    I64 tk = nodes[x].tok as I64;
    if (k == K_IF) {
        if (st[f].state == 0) {
            st[f].e = add_sir(toks, sir, diag, ls, SO_IF, T_NONE, tk) as I32;
            st[f].b = nodes[x].a;
            st[f].state = 1;
        } else if (st[f].state == 2) {
            I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
            if (ae < 0) {
                return;
            }
            sir[ae].a = st[f].g;
            sir[ae].b = st[f].e;
            st[f].b = nodes[st[f].b as I64].next;
            st[f].state = 1;
        } else if (st[f].state == 3) {
            I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
            if (en >= 0) {
                sir[en].a = st[f].e;
                sir[en].c = 1;
            }
            ls[0].sp -= 1;
            return;
        }
        I64 arm = st[f].b as I64;
        if (arm >= 0) {
            _ = add_sir(toks, sir, diag, ls, SO_ARM, T_NONE, nodes[arm].tok as I64);
            if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[arm].a as I64, T_BOOL)) {
                return;
            }
            I64 th = add_sir(toks, sir, diag, ls, SO_THEN, T_NONE, nodes[arm].tok as I64);
            if (th < 0) {
                return;
            }
            sir[th].a = ls[0].rv as I32;
            st[f].g = th as I32;
            st[f].state = 2;
            open_block(toks, nodes, st, diag, ls, nodes[arm].b as I64);
            return;
        }
        I64 els = nodes[x].b as I64;
        if (els >= 0) {
            _ = add_sir(toks, sir, diag, ls, SO_ELSE, T_NONE, nodes[els].tok as I64);
            st[f].state = 3;
            open_block(toks, nodes, st, diag, ls, els);
            return;
        }
        I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
        if (en >= 0) {
            sir[en].a = st[f].e;
        }
        ls[0].sp -= 1;
        return;
    }
    if (k == K_WHILE || k == K_FOR) {
        if (st[f].state == 0) {
            I64 body = nodes[x].b as I64;
            I64 cond = nodes[x].a as I64;
            if (k == K_FOR) {
                if (nodes[x].a >= 0 && lower_simple(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls,
                        nodes[x].a as I64) == false) {
                    unsupported(toks, diag, ls, tk, U_STATEMENT);
                    return;
                }
                cond = nodes[x].b as I64;
                body = nodes[x].d as I64;
            }
            I64 lp = add_sir(toks, sir, diag, ls, SO_LOOP, T_NONE, tk);
            if (lp < 0) {
                return;
            }
            st[f].e = lp as I32;
            loop_head(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, lp, cond, tk);
            st[f].state = 1;
            open_block(toks, nodes, st, diag, ls, body);
            return;
        }
        I64 nx = add_sir(toks, sir, diag, ls, SO_NEXT, T_NONE, tk);
        if (nx < 0) {
            return;
        }
        sir[nx].a = st[f].e;
        if (k == K_FOR && nodes[x].c >= 0) {
            if (!lower_simple(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].c as I64)) {
                unsupported(toks, diag, ls, tk, U_STATEMENT);
                return;
            }
        }
        I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
        if (en >= 0) {
            sir[en].a = st[f].e;
        }
        hide(slots, ls, st[f].a as I64);
        ls[0].sp -= 1;
        return;
    }
    if (k == K_RANGE) {
        range_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
        return;
    }
    switch_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, f);
}

// `for i in lo..hi` and `for i in lo..=hi` (SPEC-04 LS-171 to LS-175): the bounds once,
// left to right, as I64; the loop variable is a slot that only the loop writes; the next
// value is computed only while it is in range, so no value past the last is formed.
// Frame: e the loop, f the slot, g the high bound, h 1 when inclusive.
void range_step[t, m, ns, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem, inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[x].tok as I64;
    if (st[f].state == 0) {
        I32 op = nodes[x].op;
        if ((op != scan.OP_RANGE && op != scan.OP_RANGE_INCL) || nodes[x].b >= 0) {
            unsupported(toks, diag, ls, tk, U_STATEMENT);
            return;
        }
        if (nodes[x].e >= 0) {
            unsupported(toks, diag, ls, nodes[nodes[x].e as I64].tok as I64, U_STEP);
            return;
        }
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].c as I64, T_I64)) {
            return;
        }
        I64 lo = ls[0].rv;
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].d as I64, T_I64)) {
            return;
        }
        I64 hi = ls[0].rv;
        I64 name = nodes[nodes[x].a as I64].tok as I64;
        I64 k = add_slot(toks, slots, diag, ls, name, T_I64, SK_LOCAL, name);
        I64 d = add_sir(toks, sir, diag, ls, SO_LOCAL, T_I64, name);
        if (d < 0) {
            return;
        }
        sir[d].a = k as I32;
        store(toks, sir, diag, ls, k, T_I64, lo, tk);
        I64 lp = add_sir(toks, sir, diag, ls, SO_LOOP, T_NONE, tk);
        I64 cur = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
        I64 cmp = def_sir(toks, sir, diag, ls, SO_CMP, T_BOOL, tk);
        I64 te = add_sir(toks, sir, diag, ls, SO_TEST, T_NONE, tk);
        I64 fu = add_sir(toks, sir, diag, ls, SO_FUEL, T_NONE, tk);
        if (fu < 0) {
            return;
        }
        sir[cur].a = k as I32;
        sir[cmp].a = cur as I32;
        sir[cmp].b = hi as I32;
        sir[cmp].c = CMP_LT;
        if (op == scan.OP_RANGE_INCL) {
            sir[cmp].c = CMP_LE;
            st[f].h = 1;
        } else {
            st[f].h = 0;
        }
        sir[cmp].f = T_I64;
        sir[te].a = cmp as I32;
        sir[te].b = lp as I32;
        sir[fu].val = 1;
        site(sir, ls, fu);
        st[f].e = lp as I32;
        st[f].f = k as I32;
        st[f].g = hi as I32;
        st[f].state = 1;
        open_block(toks, nodes, st, diag, ls, nodes[x].f as I64);
        return;
    }
    I64 lp = st[f].e as I64;
    I64 k = st[f].f as I64;
    I64 nx = add_sir(toks, sir, diag, ls, SO_NEXT, T_NONE, tk);
    I64 cur = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
    if (cur < 0) {
        return;
    }
    sir[nx].a = lp as I32;
    sir[cur].a = k as I32;
    if (st[f].h == 1) {
        I64 eq = def_sir(toks, sir, diag, ls, SO_CMP, T_BOOL, tk);
        I64 ifx = add_sir(toks, sir, diag, ls, SO_IF, T_NONE, tk);
        _ = add_sir(toks, sir, diag, ls, SO_ARM, T_NONE, tk);
        I64 th = add_sir(toks, sir, diag, ls, SO_THEN, T_NONE, tk);
        I64 br = add_sir(toks, sir, diag, ls, SO_BREAK, T_NONE, tk);
        I64 ae = add_sir(toks, sir, diag, ls, SO_ARM_END, T_NONE, tk);
        I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
        if (en < 0) {
            return;
        }
        sir[eq].a = cur as I32;
        sir[eq].b = st[f].g;
        sir[eq].c = CMP_EQ;
        sir[eq].f = T_I64;
        sir[th].a = eq as I32;
        sir[br].a = lp as I32;
        sir[ae].a = th as I32;
        sir[ae].b = ifx as I32;
        sir[en].a = ifx as I32;
    }
    I64 one = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
    I64 add = def_sir(toks, sir, diag, ls, SO_BIN, T_I64, tk);
    if (add < 0) {
        return;
    }
    sir[one].val = 1;
    sir[add].a = cur as I32;
    sir[add].b = one as I32;
    sir[add].c = B_ADD;
    sir[add].f = 1;
    store(toks, sir, diag, ls, k, T_I64, add, tk);
    I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
    if (en >= 0) {
        sir[en].a = lp as I32;
    }
    hide(slots, ls, st[f].a as I64);
    ls[0].sp -= 1;
}

// Checked constant bits for a label of scrutinee type ty. This explicit interface admits
// arithmetic and module/local constant names without re-evaluating an unchecked label.
Bool case_value[t, m, r](in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 y, I32 ty, inout I64[_] res) {
    I64 flags = resolve.SEM_CONST | resolve.SEM_FOLDED;
    if ((sem[y].flags & resolve.SEM_ERRVAL) != 0 && set_type(sem[y].ty) == ty) {
        // An error value of the scrutinee's set (box 12): its tag.
        res[0] = sem[y].bits as% I64;
        res[1] = 1;
        return true;
    }
    if ((sem[y].flags & flags) != flags || sem[y].ty != (ty as I64)) {
        unsupported(toks, diag, ls, nodes[y].tok as I64, U_CASE_ITEM);
        return false;
    }
    res[0] = sem[y].bits as% I64;
    res[1] = 1;
    return true;
}

// A switch (SPEC-04 LS-177, LS-178): the scrutinee once, then each case in order with its
// constant items, the default case last (as `cint_ref` orders the clauses). Frame: e the
// switch node, b the next case to lower, c the default case (-2 once lowered), g the last
// SO_CASE.
void switch_step[t, m, ns, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[x].tok as I64;
    I64[2] lo;
    I64[2] hi;
    if (st[f].state == 0) {
        I32 sty = set_type(sem[x].ty);
        if (sty == T_NONE) {
            sty = sem[x].ty as I32;
        }
        if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[x].a as I64, sty)) {
            return;
        }
        I32 ty = ls[0].rty as I32;
        I64 sw = add_sir(toks, sir, diag, ls, SO_SWITCH, ty, tk);
        if (sw < 0) {
            return;
        }
        sir[sw].a = ls[0].rv as I32;
        st[f].e = sw as I32;
        st[f].b = nodes[x].b;
        I64 c = nodes[x].b as I64;
        while (c >= 0) {
            if ((nodes[c].flags & parse.F_DEFAULT) != 0) {
                st[f].c = c as I32;
            }
            c = nodes[c].next as I64;
        }
        st[f].state = 1;
    } else if (st[f].state == 2) {
        I64 cs = st[f].g as I64;
        I64 ce = add_sir(toks, sir, diag, ls, SO_CASE_END, T_NONE, tk);
        if (ce < 0) {
            return;
        }
        sir[ce].a = cs as I32;
        sir[ce].b = st[f].e;
        I64 last = last_stmt(nodes, nodes[st[f].h as I64].b as I64);
        if (last >= 0 && nodes[last].kind == parse.N_FALLTHROUGH) {
            sir[ce].c = 1;
        }
        st[f].state = 1;
    }
    I64 sw = st[f].e as I64;
    I32 ty = sir[sw].ty;
    I64 c = st[f].b as I64;
    while (c >= 0 && (nodes[c].flags & parse.F_DEFAULT) != 0) {
        c = nodes[c].next as I64;
    }
    I32 op = SO_CASE;
    if (c >= 0) {
        st[f].b = nodes[c].next;
    } else if (st[f].c >= 0) {
        c = st[f].c as I64;
        st[f].c = -2;
        op = SO_DEFAULT;
    } else {
        I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
        if (en >= 0) {
            sir[en].a = sw as I32;
        }
        ls[0].sp -= 1;
        return;
    }
    I64 cs = add_sir(toks, sir, diag, ls, op, T_NONE, nodes[c].tok as I64);
    if (cs < 0) {
        return;
    }
    sir[cs].a = sw as I32;
    if (st[f].g >= 0) {
        sir[st[f].g as I64].b = cs as I32;
    } else {
        sir[sw].b = cs as I32;
    }
    if (op == SO_CASE) {
        I64 y = nodes[c].a as I64;
        while (y >= 0) {
            I64 ly = y;
            I64 hy = y;
            if (nodes[y].kind == parse.N_RANGE) {
                ly = nodes[y].a as I64;
                hy = nodes[y].b as I64;
            }
            if (!case_value(toks, nodes, sem, diag, ls, ly, ty, lo) ||
                    !case_value(toks, nodes, sem, diag, ls, hy, ty, hi)) {
                return;
            }
            I64 a = add_sir(toks, sir, diag, ls, SO_ITEM, ty, nodes[y].tok as I64);
            I64 b = add_sir(toks, sir, diag, ls, SO_HI, ty, nodes[y].tok as I64);
            if (b < 0) {
                return;
            }
            sir[a].val = lo[0];
            sir[b].val = hi[0];
            y = nodes[y].next as I64;
        }
    }
    _ = add_sir(toks, sir, diag, ls, SO_BODY, T_NONE, nodes[c].tok as I64);
    st[f].g = cs as I32;
    st[f].h = c as I32;
    st[f].state = 2;
    I64 lf = push(toks, st, diag, ls, K_LIST, nodes[c].b as I64, T_NONE, nodes[c].tok as I64);
    if (lf >= 0) {
        st[lf].a = ls[0].nslot as I32;
    }
}

// Lowers the statement list that starts at x.
void lower_stmts[t, m, ns, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir,
        in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 x) {
    I64 base = ls[0].sp;
    I64 f = push(toks, st, diag, ls, K_LIST, x, T_NONE, -1);
    if (f < 0) {
        return;
    }
    st[f].a = ls[0].nslot as I32;
    while (ls[0].sp > base && ls[0].err == 0) {
        stmt_step(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, ls[0].sp - 1);
    }
    ls[0].sp = base;
}

// ---------------------------------------------------------------- box 09 kernels

// Whether token tk names a kernel of the module (FN_KERNEL).
Bool is_kernel[n, t](in U8[n] text, in scan.Token[t] toks, in SirFunc[_] funcs, in LState[_] ls, I64 tk) {
    I64 kf = find_func(text, toks, funcs, ls, tk);
    return kf >= 0 && (funcs[kf].flags & FN_KERNEL) != 0;
}

// The SO_KITEM node of the kernel being lowered, or -1.
I64 item_node(in Sir[_] sir, in SirFunc[_] funcs, in LState[_] ls) {
    I64 i = ls[0].nsir - 1;
    while (i >= funcs[ls[0].func].first as I64) {
        if ((sir[i].op & OP_MASK) == SO_KITEM) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// The element offset in view slot k at the `over` variables, slots ov0 to ov0 + nd - 1, of
// an element-form kernel (SPEC-02 K-12): no check, since the dispatch's shape checks give
// each array it names the extents of the work-item space; -1 on error.
I64 item_offset[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 k, I64 ov0, I64 nd, I64 tk) {
    I64 off = -1;
    for d in 0..nd {
        I64 v = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
        I64 e = def_sir(toks, sir, diag, ls, SO_EOFF, T_I64, tk);
        if (v < 0 || e < 0) {
            return -1;
        }
        sir[v].a = (ov0 + d) as I32;
        sir[e].a = k as I32;
        sir[e].b = v as I32;
        sir[e].c = off as I32;
        sir[e].f = d as I32;
        off = e;
    }
    return off;
}

// An element-form kernel's name of array parameter k (resolve.SEM_ELEMENT): its element at
// the work-item, read as a subscript is, one counted step (`cint_ref` rewrites the name as
// that subscript, check.py _element_form).
void element_read[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, in SirFunc[_] funcs, in SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 k, I64 tk) {
    I64 first = ls[0].nsir;
    I64 it = item_node(sir, funcs, ls);
    if (it < 0) {
        unsupported(toks, diag, ls, tk, U_NAME);
        return;
    }
    I64 off = item_offset(toks, sir, diag, ls, k, sir[it].b as I64, sir[it].f as I64, tk);
    if (off < 0) {
        return;
    }
    kernel_step(toks, sir, funcs, diag, ls, tk);
    I32 ety = array_elem(slots[k].ty);
    I64 i = def_sir(toks, sir, diag, ls, SO_ELOAD, ety, tk);
    if (i < 0) {
        return;
    }
    sir[i].a = k as I32;
    sir[i].b = off as I32;
    give(ls, i, ety, first, i + 1);
}

// Whether the view of slot s, an argument of a dispatch, may be written (SPEC-02 A-8; the
// permission its alias record shows): a local array, a view parameter declared `inout`, or
// a view formed from one; a view of an `in` parameter or of an `in` view variable (SO_VBEGIN
// e 2) is read-only.
Bool view_writable(in Sir[_] sir, in SirFunc[_] funcs, in SirSlot[_] slots, in LState[_] ls, I64 s) {
    I64 fn = ls[0].func;
    I64 p0 = funcs[fn].pslot0 as I64;
    I64 k = s;
    while (k >= 0) {
        if (k >= p0 && k < p0 + (funcs[fn].nparam as I64)) {
            return slots[k].live >= 2;
        }
        if (slots[k].kind != SK_NVIEW) {
            return true;
        }
        I64 src = -1;
        I64 i = ls[0].nsir - 1;
        while (i >= funcs[fn].first as I64 && src < 0) {
            I32 op = sir[i].op & OP_MASK;
            if ((op == SO_VBEGIN || op == SO_VTRANS || op == SO_VREV) && sir[i].a as I64 == k) {
                if (sir[i].e == 2) {
                    return false;
                }
                src = sir[i].b as I64;
            }
            i -= 1;
        }
        if (src >= k) {
            src = -1;
        }
        k = src;
    }
    // A run-time-sized local array (SO_VALLOC).
    return true;
}

// A dispatch (SPEC-02 K-4, F-5; `cint_ref` Machine.dispatch), frame f as call_step's (e the
// kernel, g the arguments so far, h the next argument node). The arguments in written order:
// an array as a view, a scalar `in` as a value of its parameter's type, a scalar `out` as
// its place, a local or module variable of the parameter's type (C9102 U_CALL for any other
// place); then one SO_ARG per argument and SO_KCALL at the kernel's name, whose val has bit
// j set when the view of argument j may be written (view_writable).
void dispatch_step[n, t, m, ns, s, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[s] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 f) {
    I64 x = st[f].node as I64;
    I64 tk = nodes[nodes[x].a as I64].tok as I64;
    I64 at = f;
    if (st[f].state == 0) {
        st[f].e = find_func(text, toks, funcs, ls, tk) as I32;
        st[f].g = 0;
        st[f].h = nodes[x].b;
        st[f].c = ls[0].nsir as I32;
        st[f].state = 1;
    } else {
        at = keep_value(toks, st, diag, ls, f, tk);
        if (at < 0) {
            return;
        }
        st[at].g += 1;
        st[at].h = nodes[st[at].h as I64].next;
    }
    I64 fn = st[at].e as I64;
    I64 p0 = funcs[fn].pslot0 as I64;
    I64 np = funcs[fn].nparam as I64;
    while (st[at].h >= 0) {
        I64 arg = st[at].h as I64;
        I64 j = st[at].g as I64;
        if (nodes[arg].kind == parse.N_NAMEDARG || j >= np) {
            unsupported(toks, diag, ls, nodes[arg].tok as I64, U_CALL);
            return;
        }
        I64 q = p0 + j;
        if (slots[q].kind != SK_KOUT) {
            I32 w = slots[q].ty;
            if (slots[q].kind == SK_NVIEW) {
                w = array_elem(w) | (VIEW_ANY << 8);
            }
            _ = push(toks, st, diag, ls, K_EXPR, arg, w, tk);
            return;
        }
        I64 ks = -1;
        if (nodes[arg].kind == parse.N_NAME && (nodes[arg].flags & parse.F_PAREN) == 0) {
            ks = find_slot(text, toks, funcs, slots, ls, nodes[arg].tok as I64);
        }
        if (ks < 0 || (slots[ks].kind != SK_LOCAL && slots[ks].kind != SK_GLOBAL) || slots[ks].ty != slots[q].ty) {
            unsupported(toks, diag, ls, nodes[arg].tok as I64, U_CALL);
            return;
        }
        ls[0].rv = ks;
        ls[0].rfirst = ls[0].nsir;
        at = keep_value(toks, st, diag, ls, at, tk);
        if (at < 0) {
            return;
        }
        st[at].g += 1;
        st[at].h = nodes[arg].next;
    }
    I64 k = st[at].g as I64;
    if (k != np) {
        unsupported(toks, diag, ls, tk, U_CALL);
        return;
    }
    I64 first = st[at].c as I64;
    if (k > 0) {
        first = st[at - k].b as I64;
    }
    I64 kw = 0;
    for j in 0..k {
        I64 g = add_sir(toks, sir, diag, ls, SO_ARG, T_NONE, tk);
        if (g < 0) {
            return;
        }
        I64 v = st[at - k + j].a as I64;
        sir[g].a = v as I32;
        if (slots[p0 + j].kind == SK_NVIEW) {
            I64 vs = view_value(toks, slots, diag, ls, v, tk);
            if (vs < 0) {
                return;
            }
            if (leased(slots, ls[0].nslot, vs)) {
                unsupported(toks, diag, ls, tk, U_MEMORY);
                return;
            }
            sir[g].a = vs as I32;
            sir[g].e = 7;
            if (view_writable(sir, funcs, slots, ls, vs)) {
                kw = kw | (1 << j);
            }
        } else if (slots[p0 + j].kind == SK_KOUT) {
            sir[g].e = 8;
        }
    }
    I64 i = add_sir(toks, sir, diag, ls, SO_KCALL, T_NONE, tk);
    if (i < 0) {
        return;
    }
    sir[i].a = fn as I32;
    sir[i].c = k as I32;
    sir[i].val = kw;
    site(sir, ls, i);
    ls[0].sp = at - k + 1;
    give(ls, i, T_NONE, first, i + 1);
}

// The CINT_REDUCE_* operation of `reduce` statement x (rt/cint_rt.h section 14), or 0.
I64 kernel_reduce_op(in resolve.Sem[_] sem, I64 x) {
    switch (sem[x].lit_at) {
        case resolve.AF_SUM: return 1;
        case resolve.AF_SUM_WRAP: return 2;
        case resolve.AF_SUM_SAT: return 3;
        case resolve.AF_FOLD: return 4;
        case resolve.AF_MIN: return 6;
        case resolve.AF_MAX: return 7;
        case resolve.AF_COUNT: return 8;
        default: return 0;
    }
}

// `reduce p = op(e);` in a kernel's work-item (SPEC-02 R-1, R-2, R-6; `cint_ref`
// Machine._reduce): the contribution e (Bool for count, the target's type for the others
// but sum, whose contributions keep their own type), then SO_KRED into the accumulator of
// scalar `out` p, then the statement's counted step. fold_checked faults at its callee name.
void lower_reduce[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 x) {
    I64 c = nodes[x].a as I64;
    I64 ctk = nodes[nodes[c].a as I64].tok as I64;
    I64 q = find_slot(text, toks, funcs, slots, ls, nodes[x].c as I64);
    I64 op = kernel_reduce_op(sem, x);
    if (q < 0 || slots[q].kind != SK_KOUT || op == 0) {
        unsupported(toks, diag, ls, nodes[x].tok as I64, U_STATEMENT);
        return;
    }
    I64 v = nodes[c].b as I64;
    if (op == 4) {
        v = nodes[nodes[v].next as I64].next as I64;
    }
    I32 ety = sem[x].opty as I32;
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, v, ety)) {
        return;
    }
    I64 i = add_sir(toks, sir, diag, ls, SO_KRED, slots[q].ty, ctk);
    if (i < 0) {
        return;
    }
    sir[i].a = ls[0].rv as I32;
    sir[i].b = q as I32;
    sir[i].f = op as I32;
    sir[i].val = ety as I64;
    if (op == 4) {
        site(sir, ls, i);
    }
    kernel_step(toks, sir, funcs, diag, ls, ctk);
}

// Registers kernel node x (FN_KERNEL, no result): its parameters in order, an array as a
// view (SK_NVIEW, live 1 for `in`, 2 for `out` and `inout` until lower_kernel gives it its
// staging view), a scalar `in` as a value (SK_PARAM), a scalar `out` as the address its
// publication writes (SK_KOUT). An export of the root module is also FN_EXPORT: it has a
// public wrapper, a host-issued dispatch (SPEC-02 K-15; back_c.c_public_kernel), and its
// dispatch entry has a site at its name (lower_kernel). C9102 U_DECLARATION for more than
// 32 parameters, the bits of SO_KCALL's val, and for a type of an export's parameter or
// element other than Bool and the integers of 8 to 64 bits.
void declare_kernel[n, t, m, nf, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout SirFunc[nf] funcs, inout SirSlot[_] slots, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I64 x, Bool root) {
    I64 tk = nodes[x].tok as I64;
    I64 k = ls[0].nfunc;
    if (k == nf) {
        stop_at(toks, diag, ls, limits.C_LIMIT, tk, limits.LIM_FUNCTIONS, nf);
        return;
    }
    ls[0].nfunc = k + 1;
    funcs[k].name = tk as I32;
    funcs[k].node = x as I32;
    funcs[k].result = T_NONE;
    funcs[k].pslot0 = ls[0].nslot as I32;
    funcs[k].nparam = 0;
    funcs[k].lslot0 = 0;
    funcs[k].lslot_end = 0;
    funcs[k].first = 0;
    funcs[k].last = 0;
    funcs[k].ntemp = 0;
    funcs[k].entry = 0;
    funcs[k].flags = FN_KERNEL;
    if (root && (nodes[x].flags & parse.F_EXPORT) != 0) {
        funcs[k].flags = FN_KERNEL | FN_EXPORT;
    }
    I64 p = nodes[x].b as I64;
    while (p >= 0) {
        I64 pt = sem[p].ty;
        I32 ty = T_NONE;
        I32 kind = SK_PARAM;
        if (resolve.is_array(pt) && !resolve.is_struct(resolve.array_elem(pt)) && resolve.array_rank(pt) <= 4) {
            ty = (slot_elem(pt) as I32) | ((resolve.array_rank(pt) as I32) << 8);
            kind = SK_NVIEW;
        } else if (!resolve.is_array(pt)) {
            ty = type_of(toks, nodes, nodes[p].a as I64);
            if (nodes[p].op == scan.KW_OUT) {
                kind = SK_KOUT;
            }
        }
        I64 et = pt;
        if (resolve.is_array(pt)) {
            et = resolve.array_elem(pt);
        }
        if ((funcs[k].flags & FN_EXPORT) != 0 && (resolve.is_errset(et) || scalar_type(et) == T_NONE)) {
            // A public wrapper and its type signature carry Bool and the integers of 8 to
            // 64 bits (back_c.c_public_kernel; compiler/OPEN.md CINTC-OQ-58 item 8).
            ty = T_NONE;
        }
        if (ty == T_NONE || funcs[k].nparam == 32) {
            unsupported(toks, diag, ls, nodes[p].tok as I64, U_DECLARATION);
            return;
        }
        I64 ps = add_slot(toks, slots, diag, ls, nodes[p].tok as I64, ty, kind, nodes[p].tok as I64);
        if (ps >= 0 && kind == SK_NVIEW && nodes[p].op != scan.KW_IN) {
            slots[ps].live = 2;
        }
        funcs[k].nparam += 1;
        p = nodes[p].next as I64;
    }
}

// Extent node j of the type of kernel parameter node p (an array), or -1.
I64 kparam_extent(in parse.Node[_] nodes, I64 p, I64 j) {
    I64 ty = nodes[p].a as I64;
    if (nodes[ty].a < 0) {
        return -1;
    }
    I64 e = nodes[nodes[ty].a as I64].a as I64;
    I64 i = 0;
    while (e >= 0 && i < j) {
        e = nodes[e].next as I64;
        i += 1;
    }
    return e;
}

// The SO_VEXT node that bound shape symbol slot ks of the kernel being lowered (the value
// of its first SO_STORE), or -1.
I64 bind_node(in Sir[_] sir, in SirFunc[_] funcs, in LState[_] ls, I64 ks) {
    for i in (funcs[ls[0].func].first as I64)..ls[0].nsir {
        if ((sir[i].op & OP_MASK) == SO_STORE && sir[i].a as I64 == ks) {
            return sir[i].b as I64;
        }
    }
    return -1;
}

// The value of shape expression e of SPEC-02 K-1 at a dispatch's entry (`cint_ref`
// shape_expr): a literal, a shape symbol's local, or `name + c` or `name - c` in checked
// I64 arithmetic, which faults at the dispatch site (KSITE); -1 with C9102.
I64 shape_value[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, inout Sir[ns] sir,
        in SirFunc[_] funcs, in SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 e) {
    I64[2] lit;
    I64 tk = nodes[e].tok as I64;
    I32 kind = nodes[e].kind;
    I64 nm = e;
    I64 lt = e;
    if (kind == parse.N_BINARY) {
        nm = nodes[e].a as I64;
        lt = nodes[e].b as I64;
    } else if (kind == parse.N_LIT) {
        nm = -1;
    }
    I64 v = -1;
    if (nm >= 0) {
        I64 ks = -1;
        if (nodes[nm].kind == parse.N_NAME) {
            ks = find_slot(text, toks, funcs, slots, ls, nodes[nm].tok as I64);
        }
        if (ks < (funcs[ls[0].func].lslot0 as I64) || slots[ks].ty != T_I64) {
            unsupported(toks, diag, ls, nodes[nm].tok as I64, U_NAME);
            return -1;
        }
        v = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
        if (v < 0) {
            return -1;
        }
        sir[v].a = ks as I32;
        if (kind == parse.N_NAME) {
            return v;
        }
    }
    if (nodes[lt].kind != parse.N_LIT || !literal_value(text, toks, nodes[lt].tok as I64, lit)) {
        unsupported(toks, diag, ls, nodes[lt].tok as I64, U_LITERAL);
        return -1;
    }
    I64 c = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
    if (c < 0) {
        return -1;
    }
    sir[c].val = lit[0];
    if (v < 0) {
        return c;
    }
    I64 b = def_sir(toks, sir, diag, ls, SO_BIN, T_I64, tk);
    if (b < 0) {
        return -1;
    }
    sir[b].a = v as I32;
    sir[b].b = c as I32;
    sir[b].c = B_ADD;
    if (nodes[e].op == scan.OP_SUB) {
        sir[b].c = B_SUB;
    }
    sir[b].site = KSITE;
    return b;
}

// The `reduce` statement of kernel node x whose target is the name of token ptk, or -1: the
// kernel's nodes are those from x to the next item (nn, the module's node count, after the
// last).
I64 kernel_reduce[n, t, m](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes, I64 x, I64 nn, I64 ptk) {
    I64 end = nodes[x].next as I64;
    if (end < 0) {
        end = nn;
    }
    for g in x..end {
        if (nodes[g].kind == parse.N_REDUCE && same_name(text, toks, nodes[g].c as I64, ptk)) {
            return g;
        }
    }
    return -1;
}

// One statement `p = e;` of an element-form kernel (SPEC-02 K-12), statement g: the element
// of p's staging view at the work-item (its place, one counted step), then the value of e,
// whose array names are elements (element_read), then the store.
void element_assign[n, t, m, ns, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, in SirFunc[_] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 g, I64 ov0, I64 nd) {
    I64 target = nodes[g].a as I64;
    I64 ttk = nodes[target].tok as I64;
    I64 q = find_slot(text, toks, funcs, slots, ls, ttk);
    if (nodes[g].kind != parse.N_ASSIGN || nodes[target].kind != parse.N_NAME || q < 0 || slots[q].kind != SK_NVIEW ||
            slots[q].live < 3) {
        unsupported(toks, diag, ls, nodes[g].tok as I64, U_STATEMENT);
        return;
    }
    I64 sv = (slots[q].live - 3) as I64;
    I64 off = item_offset(toks, sir, diag, ls, sv, ov0, nd, ttk);
    if (off < 0) {
        return;
    }
    kernel_step(toks, sir, funcs, diag, ls, ttk);
    I32 ety = array_elem(slots[q].ty);
    if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, nodes[g].b as I64, ety)) {
        return;
    }
    I64 s = add_sir(toks, sir, diag, ls, SO_ESTORE, ety, nodes[g].tok as I64);
    if (s >= 0) {
        sir[s].a = sv as I32;
        sir[s].b = off as I32;
        sir[s].c = ls[0].rv as I32;
    }
}

// A node at token tk with operands a and b, payload c and f, and type ty, faulting at the
// dispatch site when it can fault; -1 with C9001.
I64 kernel_node[t, ns, r](in scan.Token[t] toks, inout Sir[ns] sir, inout limits.CompilerDiag[r] diag,
        inout LState[_] ls, I32 op, I32 ty, I64 a, I64 b, I64 c, I64 f, I64 tk) {
    I64 i = add_sir(toks, sir, diag, ls, op, ty, tk);
    if (i >= 0) {
        sir[i].a = a as I32;
        sir[i].b = b as I32;
        sir[i].c = c as I32;
        sir[i].f = f as I32;
        sir[i].site = KSITE;
    }
    return i;
}

// Kernel function k, node x (SPEC-02 F-5, F-6, F-8, P-1 to P-4, R-7; `cint_ref`
// Machine._dispatch), its nodes in the order of a dispatch: the dispatch number (SO_KENTRY);
// the shape symbols, each bound to the first extent that is its name alone, in parameter
// order, then every other extent checked (SO_KSHAPE, K-6); the `where` constraints in
// written order (SO_KWHERE); the `over` extents (an element-form kernel's: those of its first
// written parameter); the alias checks of each written array against every other array
// (SO_KALIAS); the charge of N, their saturating product (SO_KFUEL; N at most 0 charges
// nothing and runs no work-item); a staging view for each written array (SO_KSTAGE) and the
// initial value of each fold_checked accumulator (SO_KACC). Then SO_KPUSH, the loop over
// work-items 0 to N - 1 in order, each setting the `over` variables (SO_KITEM) and running
// the body; SO_KPHASE, each reduction's epilogue in parameter order (SO_KEPI), SO_KPOP, and
// the publication of each written parameter in order (SO_KPUB). Nodes that fault at the
// dispatch site have site KSITE.
void lower_kernel[t, m, ns, nf, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, inout SirFunc[nf] funcs, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 k, I64 nn) {
    I64 x = funcs[k].node as I64;
    I64 tk = nodes[x].tok as I64;
    I64 p0 = funcs[k].pslot0 as I64;
    I64 np = funcs[k].nparam as I64;
    I64 pe = sem[x].lit_at;
    ls[0].func = k;
    ls[0].temps = 0;
    funcs[k].first = ls[0].nsir as I32;
    funcs[k].lslot0 = ls[0].nslot as I32;
    I64 ke = add_sir(toks, sir, diag, ls, SO_KENTRY, T_NONE, tk);
    if ((funcs[k].flags & FN_EXPORT) != 0) {
        // A host-issued dispatch's entry faults are at the kernel's name (SPEC-02 F-8).
        site(sir, ls, ke);
        if (ke >= 0) {
            funcs[k].entry = sir[ke].site;
        }
    }
    I64 z = nodes[x].d as I64;
    while (z >= 0) {
        I64 zt = nodes[z].tok as I64;
        I64 ks = add_slot(toks, slots, diag, ls, zt, T_I64, SK_LOCAL, zt);
        I64 d = add_sir(toks, sir, diag, ls, SO_LOCAL, T_I64, zt);
        if (ks < 0 || d < 0) {
            return;
        }
        sir[d].a = ks as I32;
        z = nodes[z].next as I64;
    }
    // K-6: each shape symbol binds to its first extent that is its name alone.
    I64 p = nodes[x].b as I64;
    I64 j = 0;
    while (p >= 0) {
        if (slots[p0 + j].kind == SK_NVIEW) {
            for d in 0..slot_rank(slots, p0 + j) {
                I64 e = kparam_extent(nodes, p, d);
                if (e >= 0 && nodes[e].kind == parse.N_NAME) {
                    I64 ks = find_slot(text, toks, funcs, slots, ls, nodes[e].tok as I64);
                    if (ks >= funcs[k].lslot0 as I64 && bind_node(sir, funcs, ls, ks) < 0) {
                        I64 v = def_sir(toks, sir, diag, ls, SO_VEXT, T_I64, tk);
                        if (v < 0) {
                            return;
                        }
                        sir[v].a = (p0 + j) as I32;
                        sir[v].f = d as I32;
                        store(toks, sir, diag, ls, ks, T_I64, v, tk);
                    }
                }
            }
        }
        j += 1;
        p = nodes[p].next as I64;
    }
    z = nodes[x].d as I64;
    while (z >= 0) {
        I64 ks = find_slot(text, toks, funcs, slots, ls, nodes[z].tok as I64);
        if (ks < 0 || bind_node(sir, funcs, ls, ks) < 0) {
            unsupported(toks, diag, ls, nodes[z].tok as I64, U_DECLARATION);
            return;
        }
        z = nodes[z].next as I64;
    }
    // Every other extent equals the value of its shape expression.
    p = nodes[x].b as I64;
    j = 0;
    while (p >= 0) {
        if (slots[p0 + j].kind == SK_NVIEW) {
            for d in 0..slot_rank(slots, p0 + j) {
                I64 e = kparam_extent(nodes, p, d);
                Bool binds = false;
                if (nodes[e].kind == parse.N_NAME) {
                    I64 b = bind_node(sir, funcs, ls, find_slot(text, toks, funcs, slots, ls, nodes[e].tok as I64));
                    binds = b >= 0 && sir[b].a as I64 == p0 + j && sir[b].f as I64 == d;
                }
                if (!binds) {
                    I64 want = shape_value(text, toks, nodes, sir, funcs, slots, diag, ls, e);
                    if (want < 0 || kernel_node(toks, sir, diag, ls, SO_KSHAPE, T_NONE, p0 + j, want, j, d, tk) < 0) {
                        return;
                    }
                }
            }
        }
        j += 1;
        p = nodes[p].next as I64;
    }
    // F-5 check 5: the `where` constraints (decision OQ-203).
    I64 c = nodes[x].e as I64;
    I64 ci = 0;
    while (c >= 0) {
        I64 lv = shape_value(text, toks, nodes, sir, funcs, slots, diag, ls, nodes[c].a as I64);
        if (lv < 0) {
            return;
        }
        I64 rv = shape_value(text, toks, nodes, sir, funcs, slots, diag, ls, nodes[c].b as I64);
        if (rv < 0 || kernel_node(toks, sir, diag, ls, SO_KWHERE, T_NONE, lv, rv, ci, compare_op(nodes[c].op) as I64,
                tk) < 0) {
            return;
        }
        ci += 1;
        c = nodes[c].next as I64;
    }
    // The work-item space: the `over` extents, in hidden locals from ext0.
    I64 nd = 0;
    I64 pq = -1;
    if (pe >= 0) {
        p = nodes[x].b as I64;
        j = 0;
        while (p >= 0 && p != pe) {
            j += 1;
            p = nodes[p].next as I64;
        }
        pq = p0 + j;
        nd = slot_rank(slots, pq);
    } else {
        I64 ov = nodes[x].a as I64;
        while (ov >= 0) {
            nd += 1;
            ov = nodes[ov].next as I64;
        }
    }
    I64 ext0 = ls[0].nslot;
    for d in 0..nd {
        if (add_slot(toks, slots, diag, ls, -1, T_I64, SK_LOCAL, tk) < 0) {
            return;
        }
    }
    I64 ov = nodes[x].a as I64;
    for d in 0..nd {
        I64 e = -1;
        if (pe >= 0) {
            e = kparam_extent(nodes, pe, d);
        } else {
            e = nodes[ov].a as I64;
            ov = nodes[ov].next as I64;
        }
        I64 v = shape_value(text, toks, nodes, sir, funcs, slots, diag, ls, e);
        if (v < 0) {
            return;
        }
        store(toks, sir, diag, ls, ext0 + d, T_I64, v, tk);
    }
    // F-5 check 7: each written array against every other array argument.
    for i in 0..np {
        if (slots[p0 + i].kind == SK_NVIEW && slots[p0 + i].live == 2) {
            for q in 0..np {
                if (q != i && slots[p0 + q].kind == SK_NVIEW &&
                        kernel_node(toks, sir, diag, ls, SO_KALIAS, array_elem(slots[p0 + i].ty), p0 + i, p0 + q, i, q,
                        tk) < 0) {
                    return;
                }
            }
        }
    }
    // F-5 check 9: the dispatch charge (ruling R7).
    I64 nk = add_slot(toks, slots, diag, ls, -1, T_I64, SK_LOCAL, tk);
    if (nk < 0 || kernel_node(toks, sir, diag, ls, SO_KFUEL, T_NONE, nk, ext0, 0, nd, tk) < 0) {
        return;
    }
    // P-4: the staging views; then the accumulators of the scalar `out` parameters.
    p = nodes[x].b as I64;
    j = 0;
    while (p >= 0) {
        I64 q = p0 + j;
        if (slots[q].kind == SK_NVIEW && slots[q].live == 2) {
            I64 sv = new_view(toks, slots, diag, ls, array_elem(slots[q].ty), slot_rank(slots, q), tk);
            I64 cin = 1;
            if (nodes[p].op == scan.KW_INOUT) {
                cin = 2;
            }
            if (sv < 0 || kernel_node(toks, sir, diag, ls, SO_KSTAGE, array_elem(slots[q].ty), sv, q, 0, cin, tk) < 0) {
                return;
            }
            slots[q].live = (3 + sv) as I32;
        } else if (slots[q].kind == SK_KOUT) {
            I64 rd = kernel_reduce(text, toks, nodes, x, nn, nodes[p].tok as I64);
            if (rd < 0) {
                unsupported(toks, diag, ls, nodes[p].tok as I64, U_DECLARATION);
                return;
            }
            slots[q].live = (2 + rd) as I32;
            if (kernel_reduce_op(sem, rd) == 4) {
                I64 init = nodes[nodes[nodes[rd].a as I64].b as I64].next as I64;
                if (!lower_expr(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, init, slots[q].ty)) {
                    return;
                }
                I64 ac = add_sir(toks, sir, diag, ls, SO_KACC, slots[q].ty, nodes[init].tok as I64);
                if (ac < 0) {
                    return;
                }
                sir[ac].a = q as I32;
                sir[ac].b = ls[0].rv as I32;
            }
        }
        j += 1;
        p = nodes[p].next as I64;
    }
    // The work-items, in order (SPEC-02 F-6).
    if (kernel_node(toks, sir, diag, ls, SO_KPUSH, T_NONE, -1, -1, 0, 0, tk) < 0) {
        return;
    }
    I64 wk = add_slot(toks, slots, diag, ls, -1, T_I64, SK_LOCAL, tk);
    I64 ov0 = ls[0].nslot;
    ov = nodes[x].a as I64;
    for d in 0..nd {
        I64 name = -1;
        if (pe < 0) {
            name = nodes[ov].tok as I64;
            ov = nodes[ov].next as I64;
        }
        if (add_slot(toks, slots, diag, ls, name, T_I64, SK_LOCAL, tk) < 0) {
            return;
        }
    }
    I64 zero = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
    if (wk < 0 || zero < 0) {
        return;
    }
    store(toks, sir, diag, ls, wk, T_I64, zero, tk);
    I64 lp = add_sir(toks, sir, diag, ls, SO_LOOP, T_NONE, tk);
    I64 cur = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
    I64 lim = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
    I64 cmp = def_sir(toks, sir, diag, ls, SO_CMP, T_BOOL, tk);
    I64 te = add_sir(toks, sir, diag, ls, SO_TEST, T_NONE, tk);
    I64 wv = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
    I64 it = add_sir(toks, sir, diag, ls, SO_KITEM, T_NONE, tk);
    if (it < 0) {
        return;
    }
    sir[cur].a = wk as I32;
    sir[lim].a = nk as I32;
    sir[cmp].a = cur as I32;
    sir[cmp].b = lim as I32;
    sir[cmp].c = CMP_LT;
    sir[cmp].f = T_I64;
    sir[te].a = cmp as I32;
    sir[te].b = lp as I32;
    sir[wv].a = wk as I32;
    sir[it].a = wv as I32;
    sir[it].b = ov0 as I32;
    sir[it].c = ext0 as I32;
    sir[it].f = nd as I32;
    I64 body = nodes[x].c as I64;
    if (pe >= 0) {
        I64 g = nodes[body].a as I64;
        while (g >= 0 && ls[0].err == 0) {
            element_assign(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, g, ov0, nd);
            g = nodes[g].next as I64;
        }
    } else {
        lower_stmts(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, body);
    }
    I64 nx = add_sir(toks, sir, diag, ls, SO_NEXT, T_NONE, tk);
    I64 c2 = def_sir(toks, sir, diag, ls, SO_LOAD, T_I64, tk);
    I64 one = def_sir(toks, sir, diag, ls, SO_CONST, T_I64, tk);
    I64 add = def_sir(toks, sir, diag, ls, SO_BIN, T_I64, tk);
    if (add < 0) {
        return;
    }
    sir[nx].a = lp as I32;
    sir[c2].a = wk as I32;
    sir[one].val = 1;
    sir[add].a = c2 as I32;
    sir[add].b = one as I32;
    sir[add].c = B_ADD;
    sir[add].f = 1;
    store(toks, sir, diag, ls, wk, T_I64, add, tk);
    I64 en = add_sir(toks, sir, diag, ls, SO_END, T_NONE, tk);
    I64 ph = add_sir(toks, sir, diag, ls, SO_KPHASE, T_NONE, tk);
    if (en < 0 || ph < 0) {
        return;
    }
    sir[en].a = lp as I32;
    sir[ph].f = 2;
    // R-7: the epilogue of each reduction, in parameter order, at its callee name.
    for i in 0..np {
        I64 q = p0 + i;
        if (slots[q].kind == SK_KOUT) {
            I64 rd = (slots[q].live - 2) as I64;
            I64 op = kernel_reduce_op(sem, rd);
            I64 ep = add_sir(toks, sir, diag, ls, SO_KEPI, slots[q].ty, nodes[nodes[nodes[rd].a as I64].a as I64].tok as I64);
            if (ep < 0) {
                return;
            }
            sir[ep].a = q as I32;
            sir[ep].f = op as I32;
            sir[ep].val = sem[rd].opty;
            if (op == 1 || op == 6 || op == 7) {
                site(sir, ls, ep);
            }
        }
    }
    if (add_sir(toks, sir, diag, ls, SO_KPOP, T_NONE, tk) < 0) {
        return;
    }
    // P-1: the publication, in parameter order.
    for i in 0..np {
        I64 q = p0 + i;
        if (slots[q].kind == SK_NVIEW && slots[q].live >= 3) {
            if (kernel_node(toks, sir, diag, ls, SO_KPUB, array_elem(slots[q].ty), q, (slots[q].live - 3) as I64, 0, 0,
                    tk) < 0) {
                return;
            }
            funcs[k].flags = funcs[k].flags | FN_SCRATCH;
        } else if (slots[q].kind == SK_KOUT) {
            I64 pb = add_sir(toks, sir, diag, ls, SO_KPUB, slots[q].ty, tk);
            if (pb < 0) {
                return;
            }
            sir[pb].a = q as I32;
        }
    }
    funcs[k].last = ls[0].nsir as I32;
    funcs[k].lslot_end = ls[0].nslot as I32;
    funcs[k].ntemp = ls[0].temps as I32;
}

// ---------------------------------------------------------------- the module

// Whether item x of a module is a statement (it makes the module a script, LS-218).
Bool is_statement(in parse.Node[_] nodes, I64 x) {
    switch (nodes[x].kind) {
        case parse.N_FUNC, parse.N_STRUCT, parse.N_ENUM, parse.N_ERROR_DECL, parse.N_TYPE_DECL, parse.N_KERNEL,
                parse.N_SCHEDULE, parse.N_TEST, parse.N_STATIC_ASSERT, parse.N_IMPORT, parse.N_PROFILE,
                parse.N_VAR, parse.N_ATTR:
            return false;
        default:
            return true;
    }
}

// Whether every extent of view parameter node p of function node x is one a cx wrapper
// reads from the declaration alone: a literal, `_`, or a size parameter's name.
Bool public_dims(in U8[_] text, in scan.Token[_] toks, in parse.Node[_] nodes, I64 x, I64 p) {
    I64[2] lit;
    I64 e = nodes[nodes[nodes[p].a as I64].a as I64].a as I64;
    while (e >= 0) {
        I32 kind = nodes[e].kind;
        if (kind == parse.N_LIT) {
            if (!literal_value(text, toks, nodes[e].tok as I64, lit)) {
                return false;
            }
        } else if (kind == parse.N_NAME) {
            if (size_index(text, toks, nodes, x, nodes[e].tok as I64) < 0) {
                return false;
            }
        } else if (kind != parse.N_WILD) {
            return false;
        }
        e = nodes[e].next as I64;
    }
    return true;
}

// The index of the size parameter or shape symbol of function or kernel node x that token
// tk names, or -1.
export I64 size_index(in U8[_] text, in scan.Token[_] toks, in parse.Node[_] nodes, I64 x, I64 tk) {
    I64 z = nodes[x].d as I64;
    I64 j = 0;
    while (z >= 0) {
        if (same_name(text, toks, nodes[z].tok as I64, tk)) {
            return j;
        }
        j += 1;
        z = nodes[z].next as I64;
    }
    return -1;
}

// Registers function node x: its result type, its parameters as slots, its flags.
void declare_func[n, t, m, nf, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout SirFunc[nf] funcs, inout SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls,
        I64 x, Bool root) {
    I64 tk = nodes[x].tok as I64;
    I64 k = ls[0].nfunc;
    if (k == nf) {
        stop_at(toks, diag, ls, limits.C_LIMIT, tk, limits.LIM_FUNCTIONS, nf);
        return;
    }
    if (nodes[x].e >= 0 || nodes[x].f >= 0) {
        unsupported(toks, diag, ls, tk, U_DECLARATION);
        return;
    }
    I32 result = T_NONE;
    I32 etag = T_NONE;
    if (nodes[x].a >= 0 && resolve.is_errunion(sem[x].ty)) {
        // An error union result (box 12): the value's type and the set's underlying type.
        etag = set_type(resolve.union_set(sem[x].ty));
        if (resolve.union_value(sem[x].ty) != resolve.TY_VOID) {
            result = scalar_type(resolve.union_value(sem[x].ty));
            if (resolve.is_handle(resolve.union_value(sem[x].ty))) {
                result = T_HANDLE;
            }
            if (result == T_NONE) {
                unsupported(toks, diag, ls, nodes[nodes[x].a as I64].tok as I64, U_TYPE);
                return;
            }
        }
    } else if (nodes[x].a >= 0) {
        result = decl_type(toks, nodes, sem, nodes[x].a as I64, x);
        if (result == T_NONE && nodes[x].op == 0) {
            // A struct result is written through the internal result pointer.
            result = struct_type_of(text, toks, nodes, slots, ls, nodes[x].a as I64);
        }
        if (result == T_NONE || nodes[x].op != 0) {
            unsupported(toks, diag, ls, nodes[nodes[x].a as I64].tok as I64, U_TYPE);
            return;
        }
    }
    if (etag != T_NONE && ((nodes[x].flags & parse.F_EXPORT) != 0 || spells(text, toks, tk, "main"))) {
        // An entry's error set (SPEC-06 3.4a, box 12): its description, whose last SK_EVAL
        // slot is right before the parameters (back_c.ci, the observer and the program).
        if (describe_set(text, toks, nodes, sem, slots, diag, ls, resolve.union_set(sem[x].ty), true, tk) < 0) {
            return;
        }
    }
    Bool exported = (nodes[x].flags & parse.F_EXPORT) != 0;
    if ((exported || !root) && result == T_HANDLE) {
        // An entry's handle has no observer or wrapper form, and B1 gives memory to the root
        // module only (box 12; CINTC-OQ-64).
        unsupported(toks, diag, ls, nodes[nodes[x].a as I64].tok as I64, U_MEMORY);
        return;
    }
    ls[0].nfunc = k + 1;
    funcs[k].name = tk as I32;
    funcs[k].node = x as I32;
    funcs[k].result = result;
    funcs[k].pslot0 = ls[0].nslot as I32;
    funcs[k].nparam = 0;
    funcs[k].lslot0 = 0;
    funcs[k].lslot_end = 0;
    funcs[k].first = 0;
    funcs[k].last = 0;
    funcs[k].ntemp = 0;
    funcs[k].entry = 0;
    funcs[k].flags = 0;
    I64 z = nodes[x].d as I64;
    while (z >= 0) {
        // Size parameters come first (SPEC-04 LS-117): I64 values bound at the call.
        _ = add_slot(toks, slots, diag, ls, nodes[z].tok as I64, T_I64, SK_PARAM, nodes[z].tok as I64);
        funcs[k].nparam += 1;
        z = nodes[z].next as I64;
    }
    // Aggregate exports have public wrappers only in the root module. Observer
    // entries remain scalar-only in every module (CONF-13 X-2).
    Bool aggregate = false;
    I64 p = nodes[x].b as I64;
    while (p >= 0) {
        if (resolve.is_mem(sem[p].ty)) {
            aggregate = true;
            if (exported || !root) {
                unsupported(toks, diag, ls, nodes[p].tok as I64, U_MEMORY);
                return;
            }
        }
        if (resolve.is_mem(sem[p].ty) && !resolve.is_handle(sem[p].ty)) {
            // An arena or a pool (box 12): its identifier.
            I32 ety = mem_slot_elem(text, toks, nodes, slots, ls, nodes[p].a as I64, sem[p].ty);
            I32 ck = SK_POOL_R;
            if (resolve.mem_kind(sem[p].ty) == resolve.MK_ARENA) {
                ck = SK_ARENA_R;
            }
            if (ety == T_NONE || nodes[p].b >= 0) {
                unsupported(toks, diag, ls, nodes[p].tok as I64, U_MEMORY);
                return;
            }
            _ = add_slot(toks, slots, diag, ls, nodes[p].tok as I64, ety, ck, nodes[p].tok as I64);
            funcs[k].nparam += 1;
            p = nodes[p].next as I64;
            continue;
        }
        I32 ty = decl_type(toks, nodes, sem, nodes[p].a as I64, p);
        I32 kind = SK_PARAM;
        // An error-set parameter has no observer argument form yet (box 12).
        aggregate = aggregate || resolve.is_errset(sem[p].ty);
        if (ty == T_NONE && nodes[p].b < 0 && (nodes[p].op == 0 || nodes[p].op == scan.KW_IN)) {
            ty = struct_type_of(text, toks, nodes, slots, ls, nodes[p].a as I64);
            kind = SK_SPARAM;
        }
        if (ty == T_NONE && nodes[p].b < 0 && nodes[p].op == scan.KW_INOUT) {
            ty = struct_type_of(text, toks, nodes, slots, ls, nodes[p].a as I64);
            kind = SK_SREF;
            if (ty == T_NONE) {
                kind = SK_VIEW;
            }
        }
        if (ty == T_NONE && nodes[p].b < 0 && resolve.is_array(sem[p].ty)) {
            I64 elem = resolve.array_elem(sem[p].ty);
            if (resolve.is_errset(elem)) {
                elem = resolve.errset_under(elem);
            }
            I64 nitems = resolve.array_extent(sem[p].ty);
            if (resolve.array_rank(sem[p].ty) > 1) {
                // A view of rank 2 to 4 (box 09), passed as a descriptor.
                if (!resolve.is_struct(elem)) {
                    ty = (elem as I32) | ((resolve.array_rank(sem[p].ty) as I32) << 8);
                }
            } else if (resolve.is_struct(elem)) {
                I64 checked_extent = -2;
                if (nitems >= 0) { checked_extent = nitems; }
                ty = struct_shape_of(text, toks, nodes, slots, ls, nodes[p].a as I64, x, checked_extent);
            } else {
                I64 code = VIEW_ANY as I64;
                I64 size_id = resolve.array_size(sem[p].ty);
                if (nitems >= 0) { code = nitems + 1; }
                else if (size_id >= 0) { code = (VIEW_SIZE as I64) + size_id; }
                if (nitems < 0 || code < VIEW_ANY as I64) {
                    ty = (elem as I32) | ((code as I32) << 8);
                }
            }
            kind = SK_VIEW;
            if (resolve.array_rank(sem[p].ty) > 1) {
                kind = SK_NVIEW;
            }
        }
        if (ty == T_NONE || nodes[p].b >= 0 || (kind == SK_PARAM && nodes[p].op != 0 && nodes[p].op != scan.KW_IN)) {
            unsupported(toks, diag, ls, nodes[p].tok as I64, U_VIEW);
            return;
        }
        if (root && kind == SK_NVIEW && (nodes[x].flags & parse.F_EXPORT) != 0 &&
                !public_dims(text, toks, nodes, x, p)) {
            // A cx wrapper reads each extent of a view of rank 2 to 4 from its declaration
            // (back_c.public_dim; compiler/OPEN.md CINTC-OQ-58 item 8).
            unsupported(toks, diag, ls, nodes[p].tok as I64, U_VIEW);
            return;
        }
        I64 ps = add_slot(toks, slots, diag, ls, nodes[p].tok as I64, ty, kind, nodes[p].tok as I64);
        if (ps >= 0 && (kind == SK_VIEW || kind == SK_NVIEW) && nodes[p].op == scan.KW_INOUT) {
            slots[ps].live = 2;
        }
        funcs[k].nparam += 1;
        aggregate = aggregate || kind != SK_PARAM;
        p = nodes[p].next as I64;
    }
    if ((nodes[x].flags & parse.F_EXPORT) != 0) {
        funcs[k].flags = FN_EXPORT | FN_OBSERVE;
        if (funcs[k].nparam > 16 || aggregate || result >= T_STRUCT || resolve.is_errset(sem[x].ty)) {
            funcs[k].flags = FN_EXPORT;
        }
    }
    if (spells(text, toks, tk, "main") && result == T_NONE && funcs[k].nparam == 0) {
        funcs[k].flags = funcs[k].flags | FN_MAIN;
    }
    if (etag != T_NONE) {
        funcs[k].flags = funcs[k].flags | FN_ERRU | (etag << 16);
    }
}

// The import rows of module-level node set 0..nn: one per distinct `alias.name` that the
// checker resolved (resolve.SEM_IMPORT), with the types of its declaration-table rows; pass
// 0 makes those of structs, pass 1 the others. A function whose parameters or result
// lowering does not cover yet is C9102 U_IMPORT at the reference.
void declare_imports[n, t, m, nf, r](in U8[n] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, I64 nn, in limits.Decl[_] decls, inout SirFunc[nf] funcs, inout SirSlot[_] slots,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 pass) {
    for x in 0..nn {
        if (ls[0].err != 0) {
            return;
        }
        Bool ty_ref = nodes[x].kind == parse.N_TYPE && (sem[x].flags & resolve.SEM_IMPORT) != 0;
        if ((nodes[x].kind == parse.N_FIELD || ty_ref) && (sem[x].flags & resolve.SEM_IMPORT) != 0) {
            I64 tk = nodes[x].tok as I64;
            I64 al = -1;
            if (ty_ref) {
                al = nodes[x].start as I64;
            } else {
                al = nodes[nodes[x].a as I64].tok as I64;
            }
            I64 row = sem[x].lit_at;
            if (find_import(text, toks, funcs, ls, al, tk) < 0 && (decls[row].kind == limits.DK_STRUCT) == (pass == 0)) {
                I64 k = ls[0].nfunc;
                if (k == nf) {
                    stop_at(toks, diag, ls, limits.C_LIMIT, tk, limits.LIM_FUNCTIONS, nf);
                    return;
                }
                ls[0].nfunc = k + 1;
                funcs[k].name = tk as I32;
                funcs[k].node = sem[x].opty as I32;
                funcs[k].entry = row as I32;
                funcs[k].first = al as I32;
                funcs[k].last = al as I32;
                funcs[k].nparam = 0;
                funcs[k].pslot0 = ls[0].nslot as I32;
                funcs[k].lslot0 = 0;
                funcs[k].lslot_end = 0;
                funcs[k].ntemp = 0;
                funcs[k].flags = FN_IMPORT;
                funcs[k].result = T_NONE;
                if (decls[row].kind == limits.DK_STRUCT) {
                    // An imported struct: its SK_SDECL slot (declare_import_structs).
                    funcs[k].flags = FN_IMPORT | FN_ISTRUCT;
                    funcs[k].pslot0 = (import_struct(text, toks, slots, ls, canon_alias(text, toks, nodes, ls, al), tk) -
                        T_STRUCT) as I32;
                    continue;
                }
                I64 rty = decl.type_of_row(decls, row);
                if (rty == resolve.TY_VOID) {
                    rty = T_NONE as I64;
                }
                if (rty == 0 && decls[row].kind == limits.DK_FUNC && decls[row].tag == 0x71 && decls[row].rank == 0) {
                    // Uses the canonical record materialized from the signature.
                    rty = import_param_type(text, toks, funcs, slots, ls, decls, row) as I64;
                }
                if (resolve.is_array(rty) || (rty == 0 && decls[row].tag != 0x02)) {
                    unsupported(toks, diag, ls, tk, U_IMPORT);
                    return;
                }
                funcs[k].result = rty as I32;
                if (decls[row].kind == limits.DK_VAR) {
                    // An imported variable: its slot, read and written in place.
                    I64 vk = add_slot(toks, slots, diag, ls, tk, rty as I32, SK_IGLOBAL, tk);
                    if (vk < 0) {
                        return;
                    }
                    slots[vk].live = k as I32;
                    funcs[k].flags = FN_IMPORT | FN_IVAR;
                    funcs[k].pslot0 = vk as I32;
                    funcs[k].ntemp = decls[row].a as I32;
                } else if (decls[row].kind == limits.DK_CONST) {
                    U64 v = decls[row].a as% U64;
                    funcs[k].flags = FN_IMPORT | FN_ICONST;
                    funcs[k].lslot0 = (v & 0xFFFFFFFF) as% I32;
                    funcs[k].lslot_end = (v >> 32) as% I32;
                } else {
                    // Size parameters first, I64 values bound at the call (SPEC-04 LS-117);
                    // size_count reads their count in ntemp.
                    for z in 0..decls[row].b {
                        _ = add_slot(toks, slots, diag, ls, -1, T_I64, SK_PARAM, tk);
                        funcs[k].nparam += 1;
                    }
                    funcs[k].ntemp = decls[row].b as I32;
                    I64 p = decl.next_member(decls, row);
                    for j in 0..decls[row].a {
                        I32 pty = import_param_type(text, toks, funcs, slots, ls, decls, p);
                        I32 kind = SK_PARAM;
                        if (pty != T_NONE && decls[p].rank == 1) {
                            kind = SK_VIEW;
                        } else if (pty != T_NONE && (pty as I64) >= (T_STRUCT as I64)) {
                            kind = SK_SPARAM;
                            if (decls[p].mode == 2) {
                                kind = SK_SREF;
                            }
                        }
                        if (pty == T_NONE || (kind == SK_PARAM && decls[p].mode == 2)) {
                            unsupported(toks, diag, ls, tk, U_IMPORT);
                            return;
                        }
                        _ = add_slot(toks, slots, diag, ls, -1, pty, kind, tk);
                        funcs[k].nparam += 1;
                        p = decl.next_member(decls, p);
                    }
                }
            }
        }
    }
}

// The slot type of parameter row p of an imported function: a scalar's; a struct's, the
// imported struct whose import row has the struct's record as entry; a view's,
// as view_type_of gives it (VIEW_SIZE + j for size parameter j);
// T_NONE otherwise.
I32 import_param_type[n, t](in U8[n] text, in scan.Token[t] toks, in SirFunc[_] funcs, in SirSlot[_] slots,
        in LState[_] ls, in limits.Decl[_] decls, I64 p) {
    I64 tag = decls[p].tag as I64;
    I32 elem = T_NONE;
    if (tag == 0x71) {
        for k in 0..ls[0].nfunc {
            if ((funcs[k].flags & FN_ISTRUCT) != 0 && (funcs[k].entry as I64) == (decls[p].ref as I64)) {
                elem = T_STRUCT + funcs[k].pslot0;
            }
        }
    } else if (tag == fold.TY_BOOL || resolve.is_int(tag)) {
        elem = tag as I32;
    }
    if (elem == T_NONE || decls[p].rank > 1) {
        return T_NONE;
    }
    if (decls[p].rank == 0) {
        return elem;
    }
    I64 b = decls[p].b;
    I64 code = -1;
    if (decls[p].ext_kind == limits.DX_WILD) {
        code = VIEW_ANY as I64;
    }
    if (decls[p].ext_kind == limits.DX_SIZE && b >= 0 && b < 65536) {
        code = (VIEW_SIZE as I64) + b;
    }
    if (decls[p].ext_kind == limits.DX_LITERAL && b >= 0 && b <= 9999) {
        code = b + 1;
    }
    if (code < 0) { return T_NONE; }
    if (elem >= T_STRUCT) { return struct_shaped(elem, code); }
    return elem | ((code as I32) << 8);
}

// Lowers the body of function k (statement list x); the entry's fuel charge first when
// the function is an entry (an export, `main`, or the script), at token `at`.
void lower_func[t, m, ns, nf, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, inout SirFunc[nf] funcs, inout SirSlot[_] slots, inout parse.Frame[_] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 k, I64 x, I64 at) {
    ls[0].func = k;
    ls[0].temps = 0;
    funcs[k].first = ls[0].nsir as I32;
    funcs[k].lslot0 = ls[0].nslot as I32;
    if ((funcs[k].flags & (FN_EXPORT | FN_MAIN | FN_SCRIPT | FN_TEST)) != 0) {
        I64 c = add_sir(toks, sir, diag, ls, SO_FUEL, T_NONE, at);
        if (c < 0) {
            return;
        }
        sir[c].val = 1;
        site(sir, ls, c);
        funcs[k].entry = sir[c].site;
    }
    lower_stmts(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, x);
    for i in (funcs[k].first as I64)..ls[0].nsir {
        if ((sir[i].op & OP_MASK) == SO_VALLOC) {
            funcs[k].flags = funcs[k].flags | FN_SCRATCH;
        }
    }
    funcs[k].last = ls[0].nsir as I32;
    funcs[k].lslot_end = ls[0].nslot as I32;
    funcs[k].ntemp = ls[0].temps as I32;
}

// The module state of an importable module (SK_GLOBAL): one slot per module-level
// variable, in declaration order, and its initial value, the checker's folded initializer
// or the type's zero (LS-113). A variable of a type other than a scalar is C9102
// U_MODULE_STATE.
void declare_globals[t, m, ns, r](in scan.Token[t] toks, in parse.Node[m] nodes, in resolve.Sem[_] sem,
        inout Sir[ns] sir, inout SirSlot[_] slots, inout limits.CompilerDiag[r] diag, inout LState[_] ls,
        I64 root) {
    I64 x = nodes[root].a as I64;
    while (x >= 0 && ls[0].err == 0) {
        if (nodes[x].kind == parse.N_VAR && (nodes[x].flags & parse.F_CONST) == 0 && !resolve.is_memory_decl(nodes, x)) {
            I64 tk = nodes[x].tok as I64;
            I32 ty = decl_type(toks, nodes, sem, nodes[x].a as I64, x);
            if (ty == T_NONE || ty > T_U64) {
                unsupported(toks, diag, ls, tk, U_MODULE_STATE);
                return;
            }
            I64 k = add_slot(toks, slots, diag, ls, tk, ty, SK_GLOBAL, tk);
            I64 c = add_sir(toks, sir, diag, ls, SO_CONST, ty, tk);
            if (k < 0 || c < 0) {
                return;
            }
            sir[c].a = k as I32;
            if (nodes[x].b >= 0) {
                sir[c].val = wrap_to(ty, sem[nodes[x].b as I64].bits as% I64);
            }
        }
        x = nodes[x].next as I64;
    }
}

// The test blocks of the module (SPEC-04 LS-232), one FN_TEST function each in source order
// after the other functions, each charged as an entry at its `test` token (decision OQ-17).
// A module with no script, no `main` and no export whose only entry is one test takes that
// test as its program entry, as `cint_ref run` selects it (ref/cint_ref/exec.py
// _select_entry; compiler/OPEN.md CINTC-OQ-56).
void lower_tests[t, m, ns, nf, r](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, inout Sir[ns] sir, inout SirFunc[nf] funcs, inout SirSlot[_] slots,
        inout parse.Frame[_] st, inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 root, I64 nf_user) {
    I64 j = 0;
    I64 only = -1;
    I64 x = nodes[root].a as I64;
    while (x >= 0 && ls[0].err == 0) {
        if (nodes[x].kind == parse.N_TEST) {
            I64 k = ls[0].nfunc;
            if (k == nf) {
                stop_at(toks, diag, ls, limits.C_LIMIT, nodes[x].tok as I64, limits.LIM_FUNCTIONS, nf);
                return;
            }
            ls[0].nfunc = k + 1;
            funcs[k].name = (-2 - j) as I32;
            funcs[k].node = x as I32;
            funcs[k].result = T_NONE;
            funcs[k].nparam = 0;
            funcs[k].pslot0 = ls[0].nslot as I32;
            funcs[k].entry = 0;
            funcs[k].flags = FN_TEST;
            lower_func(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, k, nodes[x].b as I64,
                nodes[x].tok as I64);
            only = k;
            j += 1;
        }
        x = nodes[x].next as I64;
    }
    Bool exports = false;
    for k in 0..nf_user {
        exports = exports || (funcs[k].flags & (FN_EXPORT | FN_KERNEL)) == FN_EXPORT;
    }
    if (j == 1 && ls[0].entry < 0 && !exports) {
        ls[0].entry = only;
    }
}

// Lowers module `module` from its tree (root, the N_MODULE node of parse.parse) into
// `sir`, `funcs` and `slots`; `text` holds the source in its first srcn bytes. Returns 0,
// or 1 when a diagnostic was added. Afterwards ls[0] holds the counts, ls[0].script is 1
// for a script, and ls[0].entry is the program entry (the script or `main`), or -1.
export I64 lower_module[t, m, ns, nf, r, s](inout U8[_] text, in scan.Token[t] toks, in parse.Node[m] nodes,
        in resolve.Sem[_] sem, I64 root,
        I64 srcn, inout Sir[ns] sir, inout SirFunc[nf] funcs, inout SirSlot[_] slots, inout parse.Frame[s] st,
        inout limits.CompilerDiag[r] diag, inout LState[_] ls, I64 module, I64 nn, inout limits.Decl[_] decls,
        Bool is_root) {
    ls[0].module = module;
    ls[0].nsir = 0;
    ls[0].nfunc = 0;
    ls[0].nslot = 0;
    ls[0].sp = 0;
    ls[0].err = 0;
    ls[0].func = 0;
    ls[0].temps = 0;
    ls[0].sites = 0;
    ls[0].srcn = srcn;
    ls[0].textn = srcn;
    ls[0].rv = 0;
    ls[0].rty = 0;
    ls[0].rfirst = 0;
    ls[0].rend = 0;
    ls[0].script = 0;
    ls[0].root = root;
    ls[0].entry = -1;
    ls[0].max_sp = 0;
    // The lowering stack's own limit in the frame region (KR-03): the node table's extent.
    ls[0].cap = m;
    if (s < m) {
        ls[0].cap = s;
    }
    // Structs first, so that every function can name them, imported ones before the
    // module's own, whose fields may name them (task 2.14); then the items: a script, if
    // any statement; the declarations lowering covers.
    declare_import_structs(text, toks, nodes, sem, nn, decls, slots, diag, ls);
    I64 x = nodes[root].a as I64;
    while (x >= 0 && ls[0].err == 0) {
        if (nodes[x].kind == parse.N_STRUCT) {
            declare_struct(text, toks, nodes, sem, slots, diag, ls, x);
        }
        x = nodes[x].next as I64;
    }
    // Reserves every declaration slot before resolving field types, preserving ids.
    x = nodes[root].a as I64;
    while (x >= 0 && ls[0].err == 0) {
        if (nodes[x].kind == parse.N_STRUCT) {
            I32 sty = struct_type_name(text, toks, slots, ls, nodes[x].tok as I64);
            I64 sk = (sty - T_STRUCT) as I64;
            I64 nbyte = sem[x].lit_len;
            if (nbyte > 4096) { nbyte = 4097; }
            slots[sk + 1].live = nbyte as I32;
            I64 fd = nodes[x].a as I64;
            I64 j = 0;
            while (fd >= 0) {
                if (slots[sk + 1 + j].ty == T_NONE) {
                    I64 tn = nodes[fd].a as I64;
                    I32 fty = struct_type_of(text, toks, nodes, slots, ls, tn);
                    if (resolve.is_array(sem[fd].ty) && resolve.is_struct(resolve.array_elem(sem[fd].ty))) {
                        if (nodes[tn].op == 1) {
                            fty = struct_type_name(text, toks, slots, ls, nodes[tn].tok as I64);
                        } else {
                            I64 alias = canon_alias(text, toks, nodes, ls, nodes[tn].start as I64);
                            fty = import_struct(text, toks, slots, ls, alias, nodes[tn].tok as I64);
                        }
                        if (fty != T_NONE) {
                            fty = struct_shaped(fty, resolve.array_extent(sem[fd].ty));
                            if (fty != T_NONE) { fty = fty | FIELD_RECORD_ARRAY; }
                        }
                    }
                    if (fty == T_NONE) {
                        unsupported(toks, diag, ls, nodes[fd].tok as I64, U_STRUCT);
                        return 1;
                    }
                    slots[sk + 1 + j].ty = fty;
                }
                j += 1;
                fd = nodes[fd].next as I64;
            }
        }
        x = nodes[x].next as I64;
    }
    declare_memories(text, toks, nodes, sem, slots, diag, ls, root, is_root);
    if (ls[0].err != 0) {
        return 1;
    }
    I64 first_stmt = -1;
    x = nodes[root].a as I64;
    while (x >= 0 && ls[0].err == 0) {
        I32 kind = nodes[x].kind;
        I64 tk = nodes[x].tok as I64;
        if (is_statement(nodes, x)) {
            ls[0].script = 1;
        }
        if (kind == parse.N_IMPORT || kind == parse.N_ERROR_DECL) {
            // Bound by the checker; its names are the import rows below. An error set's
            // values are tags, which the checker gives each error value (box 12).
        } else if (kind == parse.N_ENUM || kind == parse.N_TYPE_DECL || kind == parse.N_SCHEDULE ||
                kind == parse.N_ATTR) {
            unsupported(toks, diag, ls, tk, U_DECLARATION);
        } else if (kind == parse.N_KERNEL) {
            declare_kernel(text, toks, nodes, sem, funcs, slots, diag, ls, x, is_root);
        } else if (kind == parse.N_FUNC) {
            declare_func(text, toks, nodes, sem, funcs, slots, diag, ls, x, is_root);
        }
        if (first_stmt < 0 && (is_statement(nodes, x) || kind == parse.N_VAR)) {
            first_stmt = x;
        }
        x = nodes[x].next as I64;
    }
    if (ls[0].err != 0) {
        return 1;
    }
    if (ls[0].script == 0 && first_stmt >= 0) {
        // Module-level variables of an importable module (SPEC-04 LS-113): constants are
        // folded where they are named; each scalar variable is module state (SK_GLOBAL).
        declare_globals(toks, nodes, sem, sir, slots, diag, ls, root);
        if (ls[0].err != 0) {
            return 1;
        }
    }
    I64 nf_user = ls[0].nfunc;
    // Imported structs first (pass 0), so that a struct parameter finds its struct's row.
    declare_imports(text, toks, nodes, sem, nn, decls, funcs, slots, diag, ls, 0);
    I64 sk = 0;
    while (sk < ls[0].nslot && (slots[sk].kind == SK_SDECL || slots[sk].kind == SK_FIELD)) {
        if (slots[sk].kind == SK_SDECL && slots[sk].live < 0) {
            I64 row = -2 - (slots[sk].live as I64);
            I64 k = ls[0].nfunc;
            if (k == nf) {
                stop_at(toks, diag, ls, limits.C_LIMIT, 0, limits.LIM_FUNCTIONS, nf);
                return 1;
            }
            ls[0].nfunc += 1;
            funcs[k].name = -1;
            funcs[k].node = decls[row].module as I32;
            funcs[k].entry = row as I32;
            funcs[k].flags = FN_IMPORT | FN_ISTRUCT;
            funcs[k].pslot0 = sk as I32;
            funcs[k].result = T_NONE;
            funcs[k].nparam = 0;
            funcs[k].first = -1;
            funcs[k].last = -1;
            funcs[k].lslot0 = 0;
            funcs[k].lslot_end = 0;
            funcs[k].ntemp = 0;
        }
        sk += 1;
    }
    declare_imports(text, toks, nodes, sem, nn, decls, funcs, slots, diag, ls, 1);
    if (ls[0].err != 0) {
        return 1;
    }
    for k in 0..nf_user {
        if ((funcs[k].flags & FN_KERNEL) != 0) {
            lower_kernel(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, k, nn);
        } else {
            lower_func(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, k, nodes[funcs[k].node as I64].c as I64,
                funcs[k].name as I64);
        }
        if (ls[0].err != 0) {
            return 1;
        }
    }
    if (ls[0].script == 1) {
        I64 k = ls[0].nfunc;
        if (k == nf) {
            stop_at(toks, diag, ls, limits.C_LIMIT, -1, limits.LIM_FUNCTIONS, nf);
            return 1;
        }
        ls[0].nfunc = k + 1;
        funcs[k].name = -1;
        funcs[k].node = -1;
        funcs[k].result = T_NONE;
        funcs[k].nparam = 0;
        funcs[k].pslot0 = ls[0].nslot as I32;
        funcs[k].entry = 0;
        funcs[k].flags = FN_SCRIPT;
        lower_func(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, k, nodes[root].a as I64,
            nodes[first_stmt].start as I64);
        ls[0].entry = k;
    } else {
        for k in 0..nf_user {
            if ((funcs[k].flags & FN_MAIN) != 0) {
                ls[0].entry = k;
            }
        }
    }
    if (ls[0].err != 0) {
        return 1;
    }
    lower_tests(text, toks, nodes, sem, sir, funcs, slots, st, diag, ls, root, nf_user);
    if (ls[0].err != 0) {
        return 1;
    }
    return 0;
}

// Exercises the real writers with one physical row, then retains the first refusal.
export I64 writer_capacity_test(I64 mode, I64 calls, I64 field) {
    scan.Token[3] toks;
    Sir[1] sir;
    SirSlot[1] slots;
    LState[1] ls;
    limits.CompilerDiag[3] diag;
    I64[27] result;
    limits.diag_clear(diag);
    ls[0].module = 7;
    for i in 0..3 {
        toks[i].line = (7 + i) as I32;
        toks[i].col = (11 + 2 * i) as I32;
    }
    I64 r = -9;
    for i in 0..calls {
        if (mode == 0) {
            r = def_sir(toks, sir, diag, ls, SO_CONST + (i as I32), T_I64, i);
            site(sir, ls, r);
        } else {
            r = add_slot(toks, slots, diag, ls, 17 + i, T_I64, SK_HIDDEN, i);
        }
    }
    result[0] = r;
    result[1] = ls[0].nsir;
    result[2] = ls[0].nslot;
    result[3] = ls[0].temps;
    result[4] = ls[0].sites;
    result[5] = ls[0].err;
    result[6] = diag[0].detail[0];
    result[7] = diag[0].detail[1];
    result[8] = diag[1].code;
    result[9] = diag[1].module;
    result[10] = diag[1].line;
    result[11] = diag[1].column;
    for j in 0..4 { result[12 + j] = diag[1].detail[j]; }
    if (mode == 0) {
        result[16] = sir[0].op as I64;
        result[17] = sir[0].ty as I64;
        result[18] = sir[0].dst as I64;
        result[19] = sir[0].a as I64;
        result[20] = sir[0].b as I64;
        result[21] = sir[0].c as I64;
        result[22] = sir[0].site as I64;
        result[23] = sir[0].tok as I64;
        result[24] = sir[0].e as I64;
        result[25] = sir[0].f as I64;
        result[26] = sir[0].val;
    } else {
        result[16] = slots[0].name as I64;
        result[17] = slots[0].ty as I64;
        result[18] = slots[0].kind as I64;
        result[19] = slots[0].live as I64;
    }
    return result[field];
}

I64 function_capacity[inlen](in U8[inlen] text, I64 calls, I64 field) {
    scan.Token[32] toks;
    parse.Node[32] nodes;
    resolve.Sem[32] sem;
    parse.Frame[16] frames;
    parse.PState[1] ps;
    SirFunc[1] funcs;
    SirSlot[1] slots;
    LState[1] ls;
    limits.CompilerDiag[3] diag;
    I64[24] result;
    limits.diag_clear(diag);
    I64 ntok = scan.scan(text, toks, diag, 7);
    I64 root = parse.parse(text, toks, ntok, nodes, frames, diag, ps, 7);
    if (root < 0) { return -99; }
    ls[0].module = 7;
    I64 x = nodes[root].a as I64;
    for i in 0..calls {
        declare_func(text, toks, nodes, sem, funcs, slots, diag, ls, x, true);
        x = nodes[x].next as I64;
    }
    result[0] = ls[0].nfunc;
    result[1] = ls[0].nslot;
    result[2] = ls[0].err;
    result[3] = diag[0].detail[0];
    result[4] = diag[0].detail[1];
    result[5] = diag[1].code;
    result[6] = diag[1].module;
    result[7] = diag[1].line;
    result[8] = diag[1].column;
    for j in 0..4 { result[9 + j] = diag[1].detail[j]; }
    result[13] = funcs[0].name as I64;
    result[14] = funcs[0].result as I64;
    result[15] = funcs[0].nparam as I64;
    result[16] = funcs[0].pslot0 as I64;
    result[17] = funcs[0].lslot0 as I64;
    result[18] = funcs[0].lslot_end as I64;
    result[19] = funcs[0].first as I64;
    result[20] = funcs[0].last as I64;
    result[21] = funcs[0].ntemp as I64;
    result[22] = funcs[0].entry as I64;
    result[23] = funcs[0].flags as I64;
    return result[field];
}

export I64 function_capacity_test(I64 calls, I64 field) {
    return function_capacity("void f() {{}}\nvoid g() {{}}\nvoid h() {{}}\n", calls, field);
}
