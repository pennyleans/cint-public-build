// compiler/check.ci: static checks of one module for the hello subset (SPEC-01 3.2, 8.4;
// SPEC-04 4.2, 5, 7, 8, 10, 17; SPEC-09 CINTC-01 to CINTC-03, CINTC-13; decision patch
// D-4, D-9, D-11, D-12, D-17, D-22; slice 2 task 2.10c).
//
// The subset. Types Bool and the eight integer types I8 to I64 and U8 to U64; functions
// with `in` scalar parameters and a scalar or void result, `void main()`; module-level
// constants and variables; scripts (top-level statements, LS-218); local variables and
// constants; blocks, assignments (every assignment operator), `++` and `--`, calls of user
// functions with positional arguments, `_ = e`, `if` and `else if` chains, `while`, both
// forms of `for` (a range with an optional `by`), integer and Bool switches with inclusive
// constant labels and explicit fallthrough, `break` and `continue` with or without a
// label, `return`, `static_assert`, and print statements whose holes are `{e}` or `{e=}`,
// each with an optional format specification (`{e:spec}`, SPEC-04 LS-202) but no conversion;
// literals (integer and character), `true`, `false`, `T.min` and `T.max` of the eight
// integer types, and the operators of SPEC-04 18.6 except `try` and `catch`, with the
// conversions `as` and `as%`. A module that uses anything else is refused before any
// other check with C9102 ("not yet supported by this implementation", SPEC-04 17.2) at the
// first such construct in source order, detail[0] its node kind, and compiler/main.ci
// stops there, before lowering (D-11; compiler/OPEN.md CINTC-OQ-45); the
// slice 2 tasks that follow widen the subset (compiler/OPEN.md CINTC-OQ-15).
//
// Checks. Inside the subset, the diagnostics are `cint_ref`'s (ref/cint_ref/check.py):
// the same code at the same position, found in the same order, and the checker stops at
// the first, as `cint_ref` does (compiler/OPEN.md CINTC-OQ-13). The order is that of
// Checker.check: the module-level pass of compiler/resolve.ci, then each constant,
// function, static_assert and module-level variable in source order, then the script.
// Inside an expression, types are inferred bottom-up with the literal context rules of
// SPEC-01 IM-21 (settle: an untyped integer expression takes the integer type its context
// gives, I64 where there is none, or is C2001 or C2103 where the context is Bool or void),
// and a module-level constant is evaluated when a name first needs it (C6005 for a
// constant that depends on itself).
//
// Constant expressions (D-9, D-17). After an expression is typed, fold walks it: a
// maximal constant subexpression is evaluated with the run-time rules unless it sits below
// the right operand of `&&` or `||` or an arm of `?:` of a non-constant expression; the
// evaluation itself follows `&&`, `||` and `?:` and range-checks each literal when it is
// evaluated (C2003); a fault is C6001 at the operation with the fault record. Then every
// literal and every checked conversion of a literal of that subexpression is checked, in
// source order, skipped operands included (C2003; C6001 E_NARROW at the `as`). A C6001
// row's canonical record (fold.fault_record, SPEC-01 IM-149 v2, compile-time kind) is
// written to its slot in `faults` (CINTC-14), and the fault itself stays in `fres`.
//
// No recursion (SPEC-09 5.3). Statements and expressions are walked by one loop over an
// explicit stack of parse.Frame rows (`wk`, the frame region, KR-03), each a task (kind) on
// one node and the step (state) at which it resumes; an `else if` chain or switch is one
// frame whatever its arm count (CINTC-03). The first nn rows hold interval AVL nodes,
// indexed by each item's low expression node, disjoint from the traversal rows above
// them. The checker's own limit in the region, CState.cap, is nodes + 16 rows, the node
// table's extent plus 16 (KR-02): the module has at most one node per source byte besides
// the module node, so nn <= tokens (lemma N of SPEC-09 CINTC-16), and the frames and scratch
// rows above them map one to one into the source bytes and the module node, a walk's root
// row aside (lemma W), so no row above index nn + tokens is written: at most 2 * tokens + 1
// rows, 31 inside it.
//
// The checked output: the Sem rows of compiler/resolve.ci. ty is the static type (an
// integer type, Bool, fold.TY_Z for a literal converted by `as`, resolve.TY_VOID for a void call; a
// statement's ty is its declared type), sym the symbol a name, declaration or call
// resolves to, opty the operand type of a comparison or conversion, lit_at and lit_len a
// literal's bytes in `lits` (SPEC-01 IM-145 minimal bytes, CINTC-02), bits the value of a
// folded constant expression (SEM_FOLDED), SEM_CONST for a constant expression, and
// SEM_COMPLETES for a statement that can complete normally (C4001).
//
// Switch interval bound: O(n log n) for n nodes, using iterative AVL insertion
// and an O(n) inorder coverage walk. Other traversal is O(n), plus O(digits * limbs) per
// literal (fold.ci), and O(depth) per comparison with a Bool or void context. Jump target
// searches visit enclosing statement frames, bounded by the 256-level source limit.
// This is not a whole-checker bound: ordinary-name probing, imported struct symbol
// lookup and field lookup retain their separate scans. Imported-name lookup is O(length).

import decl;
import emit;
import fold;
import limits;
import parse;
import resolve;
import scan;

export struct CState {
    I64 sp;
    I64 max_sp;
    I64 result;
    I64 lit_used;
    I64 steps;
    I64 base;
    I64 quiet;
    I64 cap;
    I64 in_test;
}

// The manifest rows (CINTC-14, decision patch D-3) of the checker's per-module tables for
// a module of n source bytes: rows k to k + 4 are the Sem table (one row per node, the
// node table's capacity), the symbol table (CINTC-02 symbols), the name table (twice the
// symbols plus the imported directory/index from limits.name_capacity), the frame region
// (KR-03: the checker's interval rows and work stack, and the parser's and lowering's
// stacks), and the literal-value table (U8, CINTC-02), with the record ids the caller's
// program gives Sem, Sym, Name and parse.Frame (compiler/OPEN.md CINTC-OQ-16). The region
// has the larger of the parser's limit, LIM_STACK, and the checker's, nodes + 16, which is
// 2 * tokens + 32 (KR-02; lowering's limit, the node count, is below it).
export void plan_check[t](inout limits.TablePlan[t] rows, I64 k, I64 n, U32 sem_record, U32 sym_record,
        U32 name_record, U32 frame_record, I64 declarations) {
    I64 nodes = limits.capacity(limits.LIM_NODES, n);
    I64 symbols = limits.capacity(limits.LIM_SYMBOLS, n);
    I64 region = nodes + 16;
    if (limits.capacity(limits.LIM_STACK, n) > region) {
        region = limits.capacity(limits.LIM_STACK, n);
    }
    limits.plan_row(rows, k, resolve.SEM_BYTES, limits.TAG_RECORD, sem_record, nodes, limits.SCOPE_MODULE);
    limits.plan_row(rows, k + 1, resolve.SYM_BYTES, limits.TAG_RECORD, sym_record, symbols, limits.SCOPE_MODULE);
    limits.plan_row(rows, k + 2, resolve.NAME_BYTES, limits.TAG_RECORD, name_record, limits.name_capacity(symbols, declarations),
        limits.SCOPE_MODULE);
    limits.plan_row(rows, k + 3, parse.FRAME_BYTES, limits.TAG_RECORD, frame_record, region, limits.SCOPE_MODULE);
    limits.plan_row(rows, k + 4, 1, limits.TAG_U8, 0, limits.capacity(limits.LIM_LITERALS, n), limits.SCOPE_MODULE);
}

// Tasks.
const I32 K_STMT = 1;
const I32 K_BLOCK = 2;
const I32 K_INFER = 3;
const I32 K_EXPECT = 4;
const I32 K_FOLD = 5;
const I32 K_EVAL = 6;
const I32 K_WALK = 7;
const I32 K_GCONST = 8;
const I32 K_FUNC = 9;
const I32 K_MODVAR = 10;
const I32 K_SWITCH = 11;
const I32 K_CLAUSE = 12;
const I32 K_TEST = 13;
const I32 K_TYPE = 14;
const I32 K_SIGNATURE = 15;
const I32 K_CLAMP = 16;
const I32 K_LITERAL = 17;
const I32 K_PLACE = 18;
const I32 K_KERNEL = 19;
const I32 K_DISPATCH = 20;
// Box 12 memory lifetimes: a member call of an arena or a pool, and a module-level arena or
// pool declaration.
const I32 K_MEMBER = 21;
const I32 K_MEMORY = 22;

// The I64 limits (cint-boot-1 has no type properties).
const I64 I64_MAX = 9223372036854775807;
const I64 I64_MIN = -9223372036854775807 - 1;

// C3020: two tests of a module with the same name (SPEC-04 LS-233).
const I64 C_TEST_NAME = 3020;

// Internal statement flags; the checked constant/type fields keep their usual meaning.
const I64 SEM_SWITCH_BREAK = 32;
const I64 SEM_SWITCH_DEFAULT = 64;
// The gate's marks (box 09): an item of the module's top level, and a parameter of a kernel.
const I64 SEM_ITEM = 65536;
const I64 SEM_KERNEL_PART = 131072;

// ---------------------------------------------------------------- small helpers

// The type of node x once checked: an untyped integer expression is I64.
I64 ety(in resolve.Sem[_] sem, I64 x) {
    if (sem[x].ty == resolve.TY_NONE) {
        return fold.TY_I64;
    }
    return sem[x].ty;
}

Bool is_const(in resolve.Sem[_] sem, I64 x) {
    return (sem[x].flags & resolve.SEM_CONST) != 0;
}

Bool completes(in resolve.Sem[_] sem, I64 x) {
    return (sem[x].flags & resolve.SEM_COMPLETES) != 0;
}

void set_completes(inout resolve.Sem[_] sem, I64 x, Bool yes) {
    if (yes) {
        sem[x].flags = sem[x].flags | resolve.SEM_COMPLETES;
    } else {
        sem[x].flags = sem[x].flags & ~resolve.SEM_COMPLETES;
    }
}

// The first token of node x (a compile-error position, SPEC-04 17.1).
I64 first(in parse.Node[_] nodes, I64 x) {
    return nodes[x].start as I64;
}

I64 tok_of(in parse.Node[_] nodes, I64 x) {
    return nodes[x].tok as I64;
}

I64 kid(in parse.Node[_] nodes, I64 x, I64 which) {
    switch (which) {
        case 0: return nodes[x].a as I64;
        case 1: return nodes[x].b as I64;
        case 2: return nodes[x].c as I64;
        case 3: return nodes[x].d as I64;
        case 4: return nodes[x].e as I64;
        default: return nodes[x].f as I64;
    }
}

Bool is_shift(I32 op) {
    return op == scan.OP_SHL || op == scan.OP_SHL_WRAP || op == scan.OP_SHR;
}

Bool is_literal(in parse.Node[_] nodes, I64 x) {
    return nodes[x].kind == parse.N_LIT || nodes[x].kind == parse.N_NEGLIT;
}

// Whether node x is a call of an integer built-in (mark_builtin).
Bool is_builtin(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    return nodes[x].kind == parse.N_CALL && (sem[x].flags & resolve.SEM_BUILTIN) != 0;
}

// Argument i of call x, or -1.
I64 arg_at(in parse.Node[_] nodes, I64 x, I64 i) {
    I64 g = nodes[x].b as I64;
    I64 j = 0;
    while (g >= 0 && j < i) {
        g = nodes[g].next as I64;
        j += 1;
    }
    return g;
}

// Value i of built-in call x (after the type argument of `muldiv`); a rotation's count is
// value 1.
I64 builtin_value(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x, I64 i) {
    if (sem[x].lit_at == fold.BI_MULDIV) {
        return arg_at(nodes, x, i + 1);
    }
    return arg_at(nodes, x, i);
}

I64 first_value(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    return builtin_value(nodes, sem, x, 0);
}

// The number of values of built-in call x that take its operand type (a rotation's count
// has its own).
I64 typed_values(in resolve.Sem[_] sem, I64 x) {
    I64 id = sem[x].lit_at;
    I64 n = fold.builtin_values(id);
    if (id == fold.BI_ROTL || id == fold.BI_ROTR || id == fold.BI_SHL_RESULT) {
        n -= 1;
    }
    return n;
}

// fold.ci's operation and form of a binary operator.
I64 op_name(I32 op) {
    switch (op) {
        case scan.OP_ADD, scan.OP_ADD_WRAP, scan.OP_ADD_SAT: return fold.OP_ADD;
        case scan.OP_SUB, scan.OP_SUB_WRAP, scan.OP_SUB_SAT: return fold.OP_SUB;
        case scan.OP_MUL, scan.OP_MUL_WRAP, scan.OP_MUL_SAT: return fold.OP_MUL;
        case scan.OP_DIV: return fold.OP_DIV;
        case scan.OP_REM: return fold.OP_REM;
        case scan.OP_SHL, scan.OP_SHL_WRAP: return fold.OP_SHL;
        case scan.OP_SHR: return fold.OP_SHR;
        case scan.OP_BAND: return fold.OP_AND;
        case scan.OP_BOR: return fold.OP_OR;
        case scan.OP_BXOR: return fold.OP_XOR;
        default: return -1;
    }
}

I64 op_form(I32 op) {
    switch (op) {
        case scan.OP_ADD_WRAP, scan.OP_SUB_WRAP, scan.OP_MUL_WRAP, scan.OP_SHL_WRAP: return fold.FORM_WRAP;
        case scan.OP_ADD_SAT, scan.OP_SUB_SAT, scan.OP_MUL_SAT: return fold.FORM_SAT;
        default: return fold.FORM_CHECKED;
    }
}

I64 cmp_of(I32 op) {
    switch (op) {
        case scan.OP_EQ: return fold.CMP_EQ;
        case scan.OP_NE: return fold.CMP_NE;
        case scan.OP_LT: return fold.CMP_LT;
        case scan.OP_LE: return fold.CMP_LE;
        case scan.OP_GT: return fold.CMP_GT;
        default: return fold.CMP_GE;
    }
}

// ---------------------------------------------------------------- the subset gate

// Whether the identifier at token tok spells `word`.
Bool spells[n, t, k](in U8[n] src, in scan.Token[t] toks, I64 tok, in U8[k] word) {
    if ((toks[tok].len as I64) != k) {
        return false;
    }
    I64 s = toks[tok].start as I64;
    for j in 0..k {
        if (src[s + j] != word[j]) {
            return false;
        }
    }
    return true;
}

// Whether a literal token is outside the subset: a fraction.
Bool odd_literal(in scan.Token[_] toks, I64 tok) {
    return toks[tok].kind == scan.TK_FRAC;
}

// Whether N_NAME node x spells the alias of an import among nodes 0..nn (the last name of
// its path); a field of anything else is part (ii)'s, outside the subset until it lands.
Bool names_alias[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 nn, I64 x) {
    if (nodes[x].kind != parse.N_NAME || (nodes[x].flags & parse.F_PAREN) != 0) {
        return false;
    }
    return alias_token(src, toks, nodes, nn, nodes[x].tok as I64);
}

// Whether token t spells the alias of an import among nodes 0..nn.
Bool alias_token[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 nn, I64 t) {
    I64 s = toks[t].start as I64;
    I64 l = toks[t].len as I64;
    for k in 0..nn {
        if (nodes[k].kind == parse.N_IMPORT && nodes[k].b >= 0) {
            I64 at = nodes[k].b as I64;
            if ((toks[at].len as I64) == l) {
                Bool same = true;
                I64 j = 0;
                while (same && j < l) {
                    same = src[s + j] == src[(toks[at].start as I64) + j];
                    j += 1;
                }
                if (same) {
                    return true;
                }
            }
        }
    }
    return false;
}

// Whether a function, parameter, size parameter, variable, constant, loop variable or struct
// among nodes 0..nn has the name that token t spells.
Bool declared[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 nn, I64 t) {
    for k in 0..nn {
        I32 kind = nodes[k].kind;
        if (kind == parse.N_FUNC || kind == parse.N_PARAM || kind == parse.N_SIZE || kind == parse.N_VAR ||
                kind == parse.N_BIND || kind == parse.N_STRUCT) {
            I64 d = nodes[k].tok as I64;
            if (toks[d].len == toks[t].len &&
                    resolve.same_text(src, toks[d].start as I64, toks[t].start as I64, toks[t].len as I64)) {
                return true;
            }
        }
    }
    return false;
}

// Whether node x is outside the subset (see the header).
Bool unsupported[n, q, r](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout resolve.Name[q] names, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs, I64 nn, I64 x) {
    I32 k = nodes[x].kind;
    I64 tok = tok_of(nodes, x);
    switch (k) {
        case parse.N_MODULE, parse.N_PROFILE, parse.N_BLOCK, parse.N_ASSIGN, parse.N_INCDEC, parse.N_EXPR_STMT,
                parse.N_DISCARD, parse.N_IF, parse.N_ARM, parse.N_WHILE, parse.N_FOR, parse.N_BREAK,
                parse.N_CONTINUE, parse.N_RETURN, parse.N_PRINT, parse.N_TEXT, parse.N_STATIC_ASSERT,
                parse.N_BOOL, parse.N_TYPENAME, parse.N_BINARY, parse.N_COMPARE, parse.N_LOGICAL, parse.N_COND,
                parse.N_SWITCH, parse.N_CASE, parse.N_RANGE, parse.N_FALLTHROUGH:
            return false;
        case parse.N_TEST, parse.N_ASSERT, parse.N_MESSAGE:
            // Test blocks, assert and its message (task 2.14 part (c), D-15 row 10).
            return false;
        case parse.N_ERROR_DECL, parse.N_DOTNAME, parse.N_DEFER:
            // Error sets, `.name` and `defer` / `errdefer` (box 12).
            return false;
        case parse.N_CATCH, parse.N_ERRUNION:
            // A `catch` that is a statement's whole expression, and an error union that is a
            // function's result (box 12; the gate marks them).
            return (sem[x].flags & resolve.SEM_TOP) == 0;
        case parse.N_INDEX, parse.N_WILD, parse.N_SIZE:
            return false;
        case parse.N_FIELD_DECL, parse.N_FIELD:
            // A struct field (task 2.13 part (ii)) or `alias.name` (part (iii)): the checker
            // tells them apart (qualified).
            return false;
        case parse.N_NAMEDARG: return (sem[x].flags & (resolve.SEM_NAMED_OK | resolve.SEM_BUILTIN)) == 0;
        case parse.N_STRUCT: return nodes[x].f >= 0;
        case parse.N_FUNC: return nodes[x].op != 0 || nodes[x].e >= 0;
        case parse.N_PARAM:
            // `out` is a kernel's parameter mode (box 09; SPEC-02 K-2).
            return nodes[x].b >= 0 || (nodes[x].op == scan.KW_OUT && (sem[x].flags & SEM_KERNEL_PART) == 0);
        case parse.N_VAR:
            // A local view variable (box 09; SPEC-04 LS-69), not at module level.
            if ((nodes[x].op == scan.KW_IN || nodes[x].op == scan.KW_INOUT) && (sem[x].flags & SEM_ITEM) == 0) {
                return nodes[x].a < 0;
            }
            if ((sem[x].flags & SEM_ITEM) != 0 && (nodes[x].flags & parse.F_EXPORT) != 0 &&
                    resolve.is_memory_decl(nodes, x)) {
                // An exported arena or pool: no declaration table row gives it (box 12).
                return true;
            }
            return nodes[x].op != 0 || nodes[x].a < 0;
        case parse.N_SHAPE:
            // Ranks 2 to 4 where the gate marked the type (gate; box 09).
            I64 rank = 0;
            I64 z = nodes[x].a as I64;
            while (z >= 0) {
                rank += 1;
                z = nodes[z].next as I64;
            }
            return rank > 4 || (rank > 1 && (sem[x].flags & resolve.SEM_SHAPE_OK) == 0);
        case parse.N_SLICE: return false;
        case parse.N_ARRAY: return (sem[x].flags & resolve.SEM_LITERAL_OK) == 0;
        case parse.N_KERNEL:
            // A kernel without attributes (box 09; its `where` record is decision OQ-203).
            return nodes[x].f >= 0;
        case parse.N_OVER: return nodes[nodes[x].a as I64].kind == parse.N_RANGE;
        case parse.N_REDUCE: return false;
        case parse.N_FOR_RANGE: return nodes[x].op == 0 || nodes[x].b >= 0;
        case parse.N_BIND: return nodes[x].a >= 0;
        case parse.N_HOLE:
            // A format specification is checked at the hole; a conversion stays outside.
            return nodes[x].op != 0;
        case parse.N_LIT: return odd_literal(toks, tok);
        case parse.N_NEGLIT: return odd_literal(toks, nodes[x].c as I64);
        case parse.N_STRING: return (sem[x].flags & resolve.SEM_STRING_OK) == 0;
        case parse.N_UNARY: return nodes[x].op == parse.UNARY_TRY && (sem[x].flags & resolve.SEM_TOP) == 0;
        case parse.N_CONVERT: return nodes[x].op == scan.OP_AS_SAT;
        case parse.N_CALL:
            I64 callee = nodes[x].a as I64;
            if (nodes[callee].kind == parse.N_FIELD) {
                // `alias.f(...)` of an import, or `name.m(...)`, a member call of an arena or a
                // pool (box 12), which the checker tells apart (h_call, h_member).
                I64 obj = nodes[callee].a as I64;
                return nodes[obj].kind != parse.N_NAME || (nodes[obj].flags & parse.F_PAREN) != 0;
            }
            return nodes[callee].kind != parse.N_NAME || (nodes[callee].flags & parse.F_PAREN) != 0;
        case parse.N_IMPORT:
            // `import p.q.r;` binds the alias r, `import p.q.r as a;` the alias a (task 2.14;
            // SPEC-04 LS-225); selected names stay outside the subset.
            return (nodes[x].flags & parse.F_SELECTED) != 0;
        case parse.N_NAME:
            // A prelude name that is not a built-in's call stays outside, unless the module
            // declares it: that declaration is C3001 (SPEC-04 LS-112), which the checker
            // reports where `cint_ref` does (G-C2 review COR-4). Looks for a declaration
            // once per name.
            if ((sem[x].flags & resolve.SEM_NAMED_OK) != 0) {
                // A value of an error set (box 12), whatever its name.
                return false;
            }
            I64 id = resolve.intern(src, toks, names, diag, rs, tok);
            if (id < 0 || (names[id].cls & resolve.NC_PRELUDE) == 0 || (sem[x].flags & resolve.SEM_BUILTIN) != 0) {
                return false;
            }
            if ((names[id].cls & resolve.NC_LOOKED) == 0) {
                names[id].cls = names[id].cls | resolve.NC_LOOKED;
                if (declared(src, toks, nodes, nn, tok)) {
                    names[id].cls = names[id].cls | resolve.NC_DECLARED;
                }
            }
            return (names[id].cls & resolve.NC_DECLARED) == 0;
        case parse.N_TYPEPROP:
            I64 p = nodes[x].c as I64;
            return resolve.int_class(toks[tok].aux & 255) == 0 ||
                !(spells(src, toks, p, "min") || spells(src, toks, p, "max"));
        case parse.N_TYPE:
            if (resolve.mem_node(toks, nodes, x)) {
                // An arena, pool or handle type where mem_admit marked it (box 12).
                return (sem[x].flags & resolve.SEM_MEM_OK) == 0;
            }
            if (nodes[x].op == 2 && nodes[x].b < 0 && toks[tok].kind == scan.TK_IDENT) {
                // Resolves qualified record names, including view elements, after this gate.
                return false;
            }
            I32 cls = toks[tok].aux & 255;
            return toks[tok].kind != scan.TK_IDENT || nodes[x].op != 1 || nodes[x].b >= 0 ||
                !(resolve.int_class(cls) != 0 || cls == scan.IDC_BOOL || scan.ordinary_name_class(cls));
        default: return true;
    }
}

// The first parameter of the module-level function that call x names, or -1.
I64 string_params[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 root, I64 x) {
    I64 callee = nodes[x].a as I64;
    if (root < 0 || nodes[callee].kind != parse.N_NAME) {
        return -1;
    }
    I64 ct = nodes[callee].tok as I64;
    I64 f = nodes[root].a as I64;
    while (f >= 0) {
        if (nodes[f].kind == parse.N_FUNC) {
            I64 ft = nodes[f].tok as I64;
            if (toks[ft].len == toks[ct].len && resolve.same_text(src, toks[ft].start as I64, toks[ct].start as I64,
                    toks[ct].len as I64)) {
                return nodes[f].b as I64;
            }
        }
        f = nodes[f].next as I64;
    }
    return -1;
}

// Whether call x names a struct of the module (a constructor).
Bool names_struct[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 root, I64 x) {
    I64 callee = nodes[x].a as I64;
    if (root < 0 || nodes[callee].kind != parse.N_NAME) {
        return false;
    }
    I64 ct = nodes[callee].tok as I64;
    I64 s = nodes[root].a as I64;
    while (s >= 0) {
        if (nodes[s].kind == parse.N_STRUCT) {
            I64 st = nodes[s].tok as I64;
            if (toks[st].len == toks[ct].len && resolve.same_text(src, toks[st].start as I64, toks[ct].start as I64,
                    toks[ct].len as I64)) {
                return true;
            }
        }
        s = nodes[s].next as I64;
    }
    return false;
}

// Whether parameter node p is an `in` view of U8 elements.
Bool u8_view_in(in scan.Token[_] toks, in parse.Node[_] nodes, I64 p) {
    if (nodes[p].kind != parse.N_PARAM || (nodes[p].op != 0 && nodes[p].op != scan.KW_IN) || nodes[p].b >= 0) {
        return false;
    }
    I64 ty = nodes[p].a as I64;
    return nodes[ty].kind == parse.N_TYPE && nodes[ty].a >= 0 && nodes[ty].op == 1 &&
        (toks[nodes[ty].tok as I64].aux & 255) == scan.IDC_U8;
}

// Marks call x when it names an integer built-in (box 07): the call (with the built-in's
// id in lit_at), its callee, its named arguments (C2063 in the checker), a type argument
// of `muldiv` and a trailing mode argument written as a name, all SEM_BUILTIN.
void mark_builtin[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, I64 x) {
    I64 callee = nodes[x].a as I64;
    if (nodes[callee].kind != parse.N_NAME || (nodes[callee].flags & parse.F_PAREN) != 0) {
        return;
    }
    I64 ct = tok_of(nodes, callee);
    I64 id = resolve.builtin_id(src, toks[ct].start as I64, toks[ct].len as I64);
    if (id == 0) {
        return;
    }
    sem[x].flags = sem[x].flags | resolve.SEM_BUILTIN;
    sem[x].lit_at = id;
    sem[callee].flags = sem[callee].flags | resolve.SEM_BUILTIN;
    I64 g = nodes[x].b as I64;
    I64 last = -1;
    while (g >= 0) {
        if (nodes[g].kind == parse.N_NAMEDARG) {
            sem[g].flags = sem[g].flags | resolve.SEM_BUILTIN;
        }
        last = g;
        g = nodes[g].next as I64;
    }
    I64 ta = nodes[x].b as I64;
    if (id == fold.BI_MULDIV && ta >= 0 && (nodes[ta].kind == parse.N_NAME || nodes[ta].kind == parse.N_TYPENAME)) {
        sem[ta].flags = sem[ta].flags | resolve.SEM_BUILTIN;
    }
    if (fold.builtin_mode(id) && last >= 0 && nodes[last].kind == parse.N_NAME) {
        sem[last].flags = sem[last].flags | resolve.SEM_BUILTIN;
    }
}

// Marks the shape of N_TYPE node ty (or -1) SEM_SHAPE_OK when its element is an integer
// type or Bool: the gate then admits ranks 2 to 4 (box 09).
void shape_ok(in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, I64 ty) {
    if (ty < 0 || nodes[ty].kind != parse.N_TYPE || nodes[ty].a < 0 || nodes[ty].op != 1 || nodes[ty].b >= 0) {
        return;
    }
    I64 tk = tok_of(nodes, ty);
    I32 cls = toks[tk].aux & 255;
    if (toks[tk].kind == scan.TK_IDENT && (resolve.int_class(cls) != 0 || cls == scan.IDC_BOOL)) {
        I64 sh = nodes[ty].a as I64;
        sem[sh].flags = sem[sh].flags | resolve.SEM_SHAPE_OK;
    }
}

// Marks call x when it names an array built-in of box 09 (resolve.array_builtin): the call
// SEM_ARRAYFN with the id in lit_at, its callee, its named arguments (C2063 in the
// checker) and the operation name of `fold_checked`, SEM_BUILTIN. `fill` and `reshape`
// stay outside (compiler/OPEN.md CINTC-OQ-15); `min` and `max` are mark_builtin's.
void mark_arrayfn[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, I64 x) {
    I64 callee = nodes[x].a as I64;
    if (nodes[callee].kind != parse.N_NAME || (nodes[callee].flags & parse.F_PAREN) != 0) {
        return;
    }
    I64 ct = tok_of(nodes, callee);
    I64 id = resolve.array_builtin(src, toks[ct].start as I64, toks[ct].len as I64);
    if (id == 0 || id == resolve.AF_MIN || id == resolve.AF_MAX || id == resolve.AF_FILL || id == resolve.AF_RESHAPE) {
        return;
    }
    sem[x].flags = sem[x].flags | resolve.SEM_ARRAYFN;
    sem[x].lit_at = id;
    sem[callee].flags = sem[callee].flags | resolve.SEM_BUILTIN;
    I64 g = nodes[x].b as I64;
    while (g >= 0) {
        if (nodes[g].kind == parse.N_NAMEDARG) {
            sem[g].flags = sem[g].flags | resolve.SEM_BUILTIN;
        }
        g = nodes[g].next as I64;
    }
    I64 op = nodes[x].b as I64;
    if (id == resolve.AF_FOLD && op >= 0 && nodes[op].kind == parse.N_NAME) {
        sem[op].flags = sem[op].flags | resolve.SEM_BUILTIN;
    }
}

// Box 12: marks the nodes of node x that the gate admits in one position only. The
// values of an error set may have any name (SEM_NAMED_OK); an error union is admitted as a
// function's result, and `try` and `catch` as the whole expression of a declaration, an
// assignment with `=`, a `return`, an expression statement or `_ =` (SEM_TOP).
void top_union(in parse.Node[_] nodes, inout resolve.Sem[_] sem, I64 x) {
    I32 k = nodes[x].kind;
    I64 e = -1;
    if (k == parse.N_ERROR_DECL && nodes[x].op != 1) {
        I64 v = nodes[x].a as I64;
        while (v >= 0) {
            sem[v].flags = sem[v].flags | resolve.SEM_NAMED_OK;
            v = nodes[v].next as I64;
        }
    } else if (k == parse.N_FUNC && nodes[x].a >= 0 && nodes[nodes[x].a as I64].kind == parse.N_ERRUNION) {
        I64 u = nodes[x].a as I64;
        sem[u].flags = sem[u].flags | resolve.SEM_TOP;
    } else if (k == parse.N_VAR || (k == parse.N_ASSIGN && nodes[x].op == scan.OP_ASSIGN)) {
        e = nodes[x].b as I64;
    } else if (k == parse.N_RETURN || k == parse.N_EXPR_STMT || k == parse.N_DISCARD) {
        e = nodes[x].a as I64;
    }
    if (e >= 0 && (nodes[e].kind == parse.N_CATCH ||
            (nodes[e].kind == parse.N_UNARY && nodes[e].op == parse.UNARY_TRY))) {
        sem[e].flags = sem[e].flags | resolve.SEM_TOP;
    }
}

// Box 12 memory lifetimes: marks N_TYPE node t (or -1) and the memory types inside it
// SEM_MEM_OK when t is `Arena(T)`, `Pool(T)` or `Handle(T)` of a form the checker types
// (resolve.mem_type_ref): no handle in an array, and an innermost T that is one name, with
// no shape but the `[]` or `[_]` of `Handle(E[])`. The callers pass the positions the gate
// admits: a function's parameter or result, the value of an `AllocError!` result, a local
// variable that is not a view, a struct field, a module-level arena or pool that is not
// exported, and a top-level variable of a script.
void mem_admit(in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, I64 t) {
    if (t < 0 || !resolve.mem_node(toks, nodes, t)) {
        return;
    }
    I64 y = t;
    I64 parent = -1;
    while (resolve.mem_node(toks, nodes, y)) {
        if ((toks[nodes[y].tok as I64].aux & 255) == scan.IDC_HANDLE && nodes[y].a >= 0) {
            return;
        }
        parent = y;
        y = nodes[y].b as I64;
    }
    if (nodes[y].kind != parse.N_TYPE || nodes[y].op != 1) {
        return;
    }
    if (nodes[y].a >= 0) {
        I64 e = nodes[nodes[y].a as I64].a as I64;
        if ((toks[nodes[parent].tok as I64].aux & 255) != scan.IDC_HANDLE ||
                (e >= 0 && (nodes[e].kind != parse.N_WILD || nodes[e].next >= 0))) {
            return;
        }
    }
    y = t;
    while (resolve.mem_node(toks, nodes, y)) {
        sem[y].flags = sem[y].flags | resolve.SEM_MEM_OK;
        y = nodes[y].b as I64;
    }
}

// Whether the error set of N_ERRUNION node u is written `AllocError`.
Bool alloc_union[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 u) {
    I64 e = nodes[u].a as I64;
    return nodes[e].kind == parse.N_TYPE && nodes[e].op == 1 && nodes[e].a < 0 && nodes[e].b < 0 &&
        spells(src, toks, nodes[e].tok as I64, "AllocError");
}

// C9102 at the first node outside the subset, in source order. Returns whether there is one.
Bool gate[n, q, r](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 nn, inout resolve.Sem[_] sem,
        inout resolve.Name[q] names, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs) {
    I64 root = -1;
    for x in 0..nn {
        if (nodes[x].kind == parse.N_MODULE) {
            root = x;
        }
    }
    // Box 09: the top-level items, kernel parameters, the shapes of rank 2 to 4 the subset
    // admits (scalar elements, in a parameter or a local variable), and the array literals
    // that initialize a local variable, nested literals included (an item's node follows
    // its literal's).
    Bool script = false;
    if (root >= 0) {
        I64 t = nodes[root].a as I64;
        while (t >= 0) {
            sem[t].flags = sem[t].flags | SEM_ITEM;
            script = script || (resolve.is_statement(nodes, t) && nodes[t].kind != parse.N_VAR);
            t = nodes[t].next as I64;
        }
    }
    for x in 0..nn {
        I32 kx = nodes[x].kind;
        if (kx == parse.N_FUNC || kx == parse.N_KERNEL) {
            I64 p = nodes[x].b as I64;
            while (p >= 0) {
                if (kx == parse.N_KERNEL) {
                    sem[p].flags = sem[p].flags | SEM_KERNEL_PART;
                } else {
                    mem_admit(toks, nodes, sem, nodes[p].a as I64);
                }
                shape_ok(toks, nodes, sem, nodes[p].a as I64);
                p = nodes[p].next as I64;
            }
            I64 res = nodes[x].a as I64;
            if (kx == parse.N_FUNC && res >= 0 && nodes[res].kind == parse.N_ERRUNION) {
                if (alloc_union(src, toks, nodes, res)) {
                    mem_admit(toks, nodes, sem, nodes[res].b as I64);
                }
            } else if (kx == parse.N_FUNC) {
                mem_admit(toks, nodes, sem, res);
            }
        } else if (kx == parse.N_VAR && (sem[x].flags & SEM_ITEM) == 0 && nodes[x].a >= 0) {
            shape_ok(toks, nodes, sem, nodes[x].a as I64);
            I64 init = nodes[x].b as I64;
            if (init >= 0 && nodes[init].kind == parse.N_ARRAY && nodes[x].op == 0) {
                sem[init].flags = sem[init].flags | resolve.SEM_LITERAL_OK;
            }
            if (nodes[x].op == 0 && (nodes[x].flags & parse.F_CONST) == 0) {
                mem_admit(toks, nodes, sem, nodes[x].a as I64);
            }
        } else if (kx == parse.N_VAR && nodes[x].a >= 0 && nodes[x].op == 0 &&
                (nodes[x].flags & (parse.F_CONST | parse.F_EXPORT)) == 0 && (resolve.is_memory_decl(nodes, x) || script)) {
            // A module-level arena or pool, or a variable of a script, which is a local of
            // the script (box 12).
            mem_admit(toks, nodes, sem, nodes[x].a as I64);
        } else if (kx == parse.N_FIELD_DECL) {
            mem_admit(toks, nodes, sem, nodes[x].a as I64);
        }
    }
    for x in 0..nn {
        if (nodes[x].kind == parse.N_ARRAY && (sem[x].flags & resolve.SEM_LITERAL_OK) != 0) {
            I64 g = nodes[x].a as I64;
            while (g >= 0) {
                if (nodes[g].kind == parse.N_ARRAY) {
                    sem[g].flags = sem[g].flags | resolve.SEM_LITERAL_OK;
                }
                g = nodes[g].next as I64;
            }
        }
    }
    for x in 0..nn {
        top_union(nodes, sem, x);
        if (nodes[x].kind == parse.N_STATIC_ASSERT && nodes[x].b >= 0) {
            I64 m = nodes[x].b as I64;
            sem[m].flags = sem[m].flags | resolve.SEM_STRING_OK;
        } else if (nodes[x].kind == parse.N_PROFILE || nodes[x].kind == parse.N_TEST) {
            I64 m = nodes[x].a as I64;
            sem[m].flags = sem[m].flags | resolve.SEM_STRING_OK;
        } else if (nodes[x].kind == parse.N_CALL) {
            // Recognizes local view parameters here. Imported calls defer the literal's
            // element type and mode check until qualified lookup has checked the callee.
            I64 p = string_params(src, toks, nodes, root, x);
            I64 callee = nodes[x].a as I64;
            Bool imported = nodes[callee].kind == parse.N_FIELD &&
                names_alias(src, toks, nodes, nn, nodes[callee].a as I64);
            // A member call of an arena or a pool (box 12): its named arguments are C2063.
            Bool member = nodes[callee].kind == parse.N_FIELD && !imported;
            Bool ctor = names_struct(src, toks, nodes, root, x);
            mark_builtin(src, toks, nodes, sem, x);
            mark_arrayfn(src, toks, nodes, sem, x);
            I64 g = nodes[x].b as I64;
            while (g >= 0) {
                if (nodes[g].kind == parse.N_NAMEDARG && (ctor || imported || member)) {
                    // Defers an imported call's constructor check to qualified lookup.
                    sem[g].flags = sem[g].flags | resolve.SEM_NAMED_OK;
                }
                if (nodes[g].kind == parse.N_STRING && (imported || (p >= 0 && u8_view_in(toks, nodes, p)))) {
                    sem[g].flags = sem[g].flags | resolve.SEM_STRING_OK;
                }
                if (p >= 0) {
                    p = nodes[p].next as I64;
                }
                g = nodes[g].next as I64;
            }
        }
    }
    I64 best = -1;
    I64 line = 0;
    I64 col = 0;
    for x in 0..nn {
        if (rs[0].err != 0) {
            return true;
        }
        if (unsupported(src, toks, nodes, sem, names, diag, rs, nn, x)) {

            I64 tok = tok_of(nodes, x);
            I64 l = toks[tok].line as I64;
            I64 c = toks[tok].col as I64;
            if (best < 0 || l < line || (l == line && c < col)) {
                best = x;
                line = l;
                col = c;
            }
        }
    }
    if (best < 0) {
        return false;
    }
    resolve.fail_at(diag, rs, resolve.C_UNSUPPORTED, line, col, nodes[best].kind as I64, 0);
    return true;
}

// ---------------------------------------------------------------- the stack

// A frame's payload is a 64-bit value: a node, a symbol, a flag, -1, or a type, and a type
// can exceed I32 (resolve.TY_STRUCT, resolve.TY_ARRAY, and box 09's array types, which
// reach 2^62). It is held in two I32 fields of the region's record (KR-03): its low 32
// bits in a, wrapped, and the rest, signed, in e. A payload that fits I32 has e 0 or -1
// and a equal to it, so a reads it alone.
const I64 WIDE = 4294967296;

void keep_payload[s](inout parse.Frame[s] wk, I64 f, I64 v) {
    I64 hi = v / WIDE;
    I64 lo = v % WIDE;
    if (lo < 0) {
        lo = lo + WIDE;
        hi = hi - 1;
    }
    wk[f].a = lo as% I32;
    wk[f].e = hi as I32;
}

// The payload of frame f.
I64 payload[s](in parse.Frame[s] wk, I64 f) {
    return (wk[f].e as I64) * WIDE + ((wk[f].a as I64) & (WIDE - 1));
}

// Pushes a task; false with C9004 at the node when the stack is full.
Bool push[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs, inout CState[_] cs, I32 task, I64 x, I64 a) {
    I64 sp = cs[0].sp;
    if (sp == cs[0].cap) {
        I64 tok = tok_of(nodes, x);
        resolve.fail_at(diag, rs, limits.C_NESTING, toks[tok].line as I64, toks[tok].col as I64, limits.LIM_STACK, cs[0].cap);
        return false;
    }
    wk[sp].kind = task;
    wk[sp].node = x as I32;
    wk[sp].state = 0;
    keep_payload(wk, sp, a);
    wk[sp].b = -1;
    wk[sp].c = 0;
    wk[sp].d = -1;
    cs[0].sp = sp + 1;
    if (sp + 1 - cs[0].base > cs[0].max_sp) {
        cs[0].max_sp = sp + 1 - cs[0].base;
    }
    return true;
}

void pop(inout CState[_] cs) {
    cs[0].sp -= 1;
}

// ---------------------------------------------------------------- literals and faults

// Converts literal node x (N_LIT or N_NEGLIT) to its bytes in the literal-value table, once.
// False after C9001 when the table is full.
Bool literal[l, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout U8[l] lits, inout limits.CompilerDiag[r] diag, inout fold.Work[_] z, inout resolve.RState[_] rs,
        inout CState[_] cs, I64 x) {
    if ((sem[x].flags & resolve.SEM_LIT) != 0) {
        return true;
    }
    Bool neg = nodes[x].kind == parse.N_NEGLIT;
    I64 tok = tok_of(nodes, x);
    if (neg) {
        tok = nodes[x].c as I64;
    }
    if (toks[tok].kind == scan.TK_CHAR) {
        fold.z_load128(z, neg, 0, toks[tok].aux as U64);
    } else {
        I64 radix = toks[tok].sub as I64;
        I64 s = toks[tok].start as I64;
        I64 nd = toks[tok].len as I64;
        if (radix != 10) {
            s += 2;
            nd -= 2;
        }
        fold.lit_start(z, neg);
        if (radix == 3) {
            _ = fold.lit_trits(z, src, s, nd, neg);
        } else {
            _ = fold.lit_digits(z, src, s, nd, radix);
        }
    }
    I64 nb = fold.z_len(z);
    if (cs[0].lit_used + nb > l) {
        resolve.fail_at(diag, rs, limits.C_LIMIT, toks[tok].line as I64, toks[tok].col as I64, limits.LIM_LITERALS, l);
        return false;
    }
    sem[x].lit_at = cs[0].lit_used;
    sem[x].lit_len = fold.lit_put(z, lits, cs[0].lit_used);
    cs[0].lit_used += sem[x].lit_len;
    sem[x].flags = sem[x].flags | resolve.SEM_LIT;
    return true;
}

// C6001 at token tok for the fault in fres; its canonical record goes to the row's slot.
void const_fault[r](in scan.Token[_] toks, inout limits.CompilerDiag[r] diag, inout U8[_] faults,
        inout fold.Folded[_] fres, in U8[_] lits, inout fold.Work[_] z, in U8[_] path, inout resolve.RState[_] rs,
        I64 tok) {
    if (rs[0].err != 0) {
        return;
    }
    I64 line = toks[tok].line as I64;
    I64 col = toks[tok].col as I64;
    resolve.fail_at(diag, rs, limits.C_CONST_FAULT, line, col, 0, 0);
    I64 row = rs[0].row;
    if (row <= 0) {
        return;
    }
    emit.Writer[1] w;
    emit.w_measure(w);
    fold.fault_record(w, faults, fres, lits, z, path, line, col);
    I64 nbytes = w[0].pos;
    I64 at = diag[row].detail[2];
    emit.w_emit(w, at + nbytes);
    w[0].pos = at;
    fold.fault_record(w, faults, fres, lits, z, path, line, col);
    diag[row].detail[3] = nbytes;
}

// ---------------------------------------------------------------- settling

// The diagnostic of settling the untyped expression x to type t when t is Bool or void
// (SPEC-01 IM-21; `cint_ref` Checker.settle): C2001 at a literal, C2103 at an operator,
// down the first arm of each `?:` and the first value of each built-in call.
void settle_error[r](in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, I64 x) {
    I64 e = x;
    while (nodes[e].kind == parse.N_COND || is_builtin(nodes, sem, e)) {
        if (nodes[e].kind == parse.N_COND) {
            e = nodes[e].b as I64;
        } else {
            e = first_value(nodes, sem, e);
        }
    }
    if (is_literal(nodes, e)) {
        resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, e));
    } else {
        resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, e));
    }
}

// Whether the untyped expression x passes its context to a literal-only shift (`cint_ref`
// _untyped_shift), with the stack rows above the top as scratch.
Bool untyped_shift[s](in parse.Node[_] nodes, in resolve.Sem[_] sem, inout parse.Frame[s] wk, in CState[_] cs, I64 x) {
    I64 base = cs[0].sp;
    I64 sp = base;
    if (sp == cs[0].cap) {
        return false;
    }
    wk[sp].node = x as I32;
    sp += 1;
    while (sp > base) {
        sp -= 1;
        I64 e = wk[sp].node as I64;
        I32 k = nodes[e].kind;
        I64 more0 = -1;
        I64 more1 = -1;
        if (k == parse.N_BINARY) {
            if (is_shift(nodes[e].op)) {
                return true;
            }
            more0 = nodes[e].a as I64;
            more1 = nodes[e].b as I64;
        } else if (k == parse.N_UNARY) {
            more0 = nodes[e].a as I64;
        } else if (k == parse.N_COND) {
            more0 = nodes[e].b as I64;
            more1 = nodes[e].c as I64;
        } else if (is_builtin(nodes, sem, e)) {
            sp = push_values(nodes, sem, wk, cs[0].cap, sp, e);
        }
        if (more1 >= 0 && sp < cs[0].cap) {
            wk[sp].node = more1 as I32;
            sp += 1;
        }
        if (more0 >= 0 && sp < cs[0].cap) {
            wk[sp].node = more0 as I32;
            sp += 1;
        }
    }
    return false;
}

// Pushes the values of built-in call x that take its operand type onto the scratch rows
// from sp, the last first, so the first is on top; returns the new top.
I64 push_values(in parse.Node[_] nodes, in resolve.Sem[_] sem, inout parse.Frame[_] wk, I64 lim, I64 sp, I64 x) {
    I64 n = typed_values(sem, x);
    I64 top = sp;
    I64 i = n - 1;
    while (i >= 0) {
        if (top < lim) {
            wk[top].node = builtin_value(nodes, sem, x, i) as I32;
            top += 1;
        }
        i -= 1;
    }
    return top;
}

// The first rotation (rotl, rotr) in the untyped expression x, parents before children and
// left to right, or -1.
I64 first_rotation[s](in parse.Node[_] nodes, in resolve.Sem[_] sem, inout parse.Frame[s] wk, in CState[_] cs, I64 x) {
    I64 base = cs[0].sp;
    I64 sp = base;
    if (sp == cs[0].cap) {
        return -1;
    }
    wk[sp].node = x as I32;
    sp += 1;
    while (sp > base) {
        sp -= 1;
        I64 e = wk[sp].node as I64;
        I32 k = nodes[e].kind;
        I64 more0 = -1;
        I64 more1 = -1;
        if (k == parse.N_BINARY) {
            more0 = nodes[e].a as I64;
            if (!is_shift(nodes[e].op)) {
                more1 = nodes[e].b as I64;
            }
        } else if (k == parse.N_UNARY) {
            more0 = nodes[e].a as I64;
        } else if (k == parse.N_COND) {
            more0 = nodes[e].b as I64;
            more1 = nodes[e].c as I64;
        } else if (is_builtin(nodes, sem, e)) {
            I64 id = sem[e].lit_at;
            if (id == fold.BI_ROTL || id == fold.BI_ROTR) {
                return e;
            }
            sp = push_values(nodes, sem, wk, cs[0].cap, sp, e);
        }
        if (more1 >= 0 && sem[more1].ty == resolve.TY_NONE && sp < cs[0].cap) {
            wk[sp].node = more1 as I32;
            sp += 1;
        }
        if (more0 >= 0 && sem[more0].ty == resolve.TY_NONE && sp < cs[0].cap) {
            wk[sp].node = more0 as I32;
            sp += 1;
        }
    }
    return -1;
}

// The rotation at which settling the untyped expression x to a signed type is C2103
// (`cint_ref` _builtin_result, called by Checker.settle after a call's values): the first
// rotation to complete in settling order, or -1.
I64 signed_rotation[s](in parse.Node[_] nodes, in resolve.Sem[_] sem, inout parse.Frame[s] wk, in CState[_] cs, I64 x) {
    I64 r = first_rotation(nodes, sem, wk, cs, x);
    while (r >= 0) {
        I64 inner = first_rotation(nodes, sem, wk, cs, builtin_value(nodes, sem, r, 0));
        if (inner < 0) {
            return r;
        }
        r = inner;
    }
    return -1;
}

// Settles the untyped expression x to type t (`cint_ref` Checker.settle): a diagnostic when
// t is not an integer type, else t becomes the type of every untyped node of x except the
// right operand of a shift, whose own context is I64, with the stack rows above the top as
// scratch. An untyped node left over is I64 (ety).
void settle[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, in CState[_] cs, I64 x, I64 t) {
    if (!resolve.is_int(t)) {
        settle_error(toks, nodes, sem, diag, rs, x);
        return;
    }
    if (fold.ty_signed(t)) {
        I64 rot = signed_rotation(nodes, sem, wk, cs, x);
        if (rot >= 0) {
            resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, rot));
            return;
        }
    }
    if (t == fold.TY_I64) {
        return;
    }
    I64 base = cs[0].sp;
    I64 sp = base;
    if (sem[x].ty == resolve.TY_NONE && sp < cs[0].cap) {
        wk[sp].node = x as I32;
        sp += 1;
    }
    while (sp > base) {
        sp -= 1;
        I64 e = wk[sp].node as I64;
        sem[e].ty = t;
        I32 k = nodes[e].kind;
        if (is_builtin(nodes, sem, e)) {
            sem[e].opty = t;
            I64 top = push_values(nodes, sem, wk, cs[0].cap, sp, e);
            I64 j = sp;
            while (j < top) {
                if (sem[wk[j].node as I64].ty != resolve.TY_NONE) {
                    wk[j].node = wk[top - 1].node;
                    top -= 1;
                } else {
                    j += 1;
                }
            }
            sp = top;
        }
        for j in 0..3 {
            I64 child = -1;
            if (k == parse.N_UNARY && j == 0) {
                child = nodes[e].a as I64;
            } else if (k == parse.N_BINARY && (j == 0 || (j == 1 && !is_shift(nodes[e].op)))) {
                child = kid(nodes, e, j);
            } else if (k == parse.N_COND && j > 0) {
                child = kid(nodes, e, j);
            }
            if (child >= 0 && sem[child].ty == resolve.TY_NONE && sp < cs[0].cap) {
                wk[sp].node = child as I32;
                sp += 1;
            }
        }
    }
}

// Settles the untyped operand x of a binary operator or comparison to the other operand's
// type t (SPEC-01 IM-21 rule 4; `cint_ref` Checker.settle_rule4): the left operand of a
// literal-only shift is typed I64, never by rule 4 (D-9), so it is C2001 when t is not I64.
void settle_rule4[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, in CState[_] cs, I64 x,
        I64 t) {
    if (untyped_shift(nodes, sem, wk, cs, x)) {
        settle(toks, nodes, sem, wk, diag, rs, cs, x, fold.TY_I64);
        if (t != fold.TY_I64) {
            resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, x));
        }
        return;
    }
    settle(toks, nodes, sem, wk, diag, rs, cs, x, t);
}

// ---------------------------------------------------------------- error values (box 12)
//
// Box 12 (SPEC-04 LS-92 to LS-97, LS-129 to LS-131, LS-185 to LS-189, LS-314 to LS-322).
// An error value is `Set.name`, or `.name`, whose set its context gives: an initializer, an
// assignment, an argument, a field, a returned value, a case label, or the other operand of
// `==` or `!=` (TY_DOTNAME until then). A resolved error value is SEM_ERRVAL with its tag in
// bits; it is not a constant expression, so fold.ci never sees it. A value of one set
// converts to a set that holds all its values (BX12-28; widen). An error union is the
// result of a call, `as?`, or a result-returning built-in, and only `try`, `catch` and `_ =`
// consume it (C2040 at the expression otherwise).

// The error set that N_NAME node x names as the base of `Set.name`: a set of the module,
// ArithError or AllocError; 0 for any other node.
I64 set_named[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sym[_] syms,
        inout resolve.Name[_] names, inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 x) {
    if (nodes[x].kind != parse.N_NAME || (nodes[x].flags & parse.F_PAREN) != 0) {
        return 0;
    }
    I64 tok = tok_of(nodes, x);
    I64 id = resolve.intern(src, toks, names, diag, rs, tok);
    if (id < 0) {
        return 0;
    }
    I64 b = resolve.binding(syms, names, rs, id);
    if (b >= 0 && syms[b].kind == resolve.SK_ERRSET) {
        return syms[b].ty;
    }
    if (b < 0 && spells(src, toks, tok, "ArithError")) {
        return resolve.TY_ARITH;
    }
    if (b < 0 && spells(src, toks, tok, "AllocError")) {
        return resolve.TY_ALLOC;
    }
    return 0;
}

// The error value named by token tok in set type w, for node x (`.name` or `Set.name`):
// C3005 when no member set of w declares it, at the `.` of `.name` and at the name of
// `Set.name`, C2044 at the first token of x when several do (LS-97). False after an error.
Bool set_value[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 x, I64 w) {
    I64 tag = resolve.errset_find(src, toks, nodes, sem, w, tok_of(nodes, x));
    if (tag == 0) {
        I64 at = tok_of(nodes, x);
        if (nodes[x].kind == parse.N_DOTNAME) {
            at = first(nodes, x);
        }
        resolve.fail(toks, diag, rs, resolve.C_UNDEFINED, at);
        return false;
    }
    if (tag < 0) {
        resolve.fail(toks, diag, rs, resolve.C_SHARED_NAME, first(nodes, x));
        return false;
    }
    sem[x].ty = w;
    sem[x].bits = tag as U64;
    sem[x].flags = sem[x].flags | resolve.SEM_ERRVAL;
    return true;
}

// The code for operand x where its use does not admit it: C2007 when x is `.name`, which
// only an error-set context types (SPEC-04 LS-60), `code` otherwise.
I64 use_code(in resolve.Sem[_] sem, I64 x, I64 code) {
    if (sem[x].ty == resolve.TY_DOTNAME) {
        return resolve.C_NO_CONTEXT;
    }
    return code;
}

Bool is_errval(in resolve.Sem[_] sem, I64 x) {
    return (sem[x].flags & resolve.SEM_ERRVAL) != 0;
}

// Converts the value of node x, of a set that set type w holds, to w (BX12-28): a resolved
// error value takes its tag in w; any other value keeps its type and is marked SEM_WIDEN,
// with w in bits, for compiler/lowering.ci.
void widen(in parse.Node[_] nodes, inout resolve.Sem[_] sem, I64 x, I64 w) {
    I64 s = sem[x].ty;
    if (s == w) {
        return;
    }
    if (is_errval(sem, x)) {
        sem[x].bits = resolve.errset_convert(nodes, sem, s, sem[x].bits as I64, w) as U64;
        sem[x].ty = w;
        return;
    }
    sem[x].flags = sem[x].flags | resolve.SEM_WIDEN;
    sem[x].bits = w as U64;
}

// Expects the inferred value of node x to be of set type w: `.name` resolves in w, a value of
// a set that w holds widens to it, and any other value is `code` at its first token (C2001;
// C2042 for a returned value, LS-97). False after an error.
Bool expect_set[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 x, I64 w, I64 code) {
    I64 got = sem[x].ty;
    if (got == resolve.TY_DOTNAME) {
        return set_value(src, toks, nodes, sem, diag, rs, x, w);
    }
    if (!resolve.is_errset(got) || !resolve.errset_holds(nodes, sem, w, got)) {
        resolve.fail(toks, diag, rs, code, first(nodes, x));
        return false;
    }
    widen(nodes, sem, x, w);
    return true;
}

// The set type in which the operands a and b of `==` or `!=` meet when either is a set
// value or `.name` (BX12-28): `.name` resolves in the other operand's set, and a value of a
// set that the other operand's set holds widens to it. C2001 at the first token of b (of a
// when a is a `.name` with no set beside it) when they do not meet. 0 after an error.
I64 compare_sets[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 a, I64 b) {
    I64 tl = sem[a].ty;
    I64 tr = sem[b].ty;
    if (tl == resolve.TY_DOTNAME && resolve.is_errset(tr)) {
        if (set_value(src, toks, nodes, sem, diag, rs, a, tr)) {
            return tr;
        }
        return 0;
    }
    if (tr == resolve.TY_DOTNAME && resolve.is_errset(tl)) {
        if (set_value(src, toks, nodes, sem, diag, rs, b, tl)) {
            return tl;
        }
        return 0;
    }
    if (tl == resolve.TY_DOTNAME) {
        resolve.fail(toks, diag, rs, resolve.C_NO_CONTEXT, first(nodes, a));
        return 0;
    }
    if (resolve.is_errset(tl) && resolve.is_errset(tr)) {
        if (resolve.errset_holds(nodes, sem, tl, tr)) {
            widen(nodes, sem, b, tl);
            return tl;
        }
        if (resolve.errset_holds(nodes, sem, tr, tl)) {
            widen(nodes, sem, a, tr);
            return tr;
        }
    }
    resolve.fail(toks, diag, rs, use_code(sem, b, resolve.C_TYPE_MISMATCH), first(nodes, b));
    return 0;
}

// Whether a value of type ty holds an error-set value: itself, its elements, or a field of
// a struct of this module at any depth (LS-314). A declaration that would zero-fill one is
// C2054. Each struct is visited once; the stack rows above the top hold the structs to
// visit (node) and those seen (c).
Bool holds_set(in parse.Node[_] nodes, in resolve.Sem[_] sem, in resolve.Sym[_] syms, inout parse.Frame[_] wk,
        in CState[_] cs, I64 ty) {
    I64 t = ty;
    if (resolve.is_array(t)) {
        t = resolve.array_elem(t);
    }
    if (resolve.is_errset(t)) {
        return true;
    }
    if (!resolve.is_struct(t) || resolve.struct_node(syms, t) < 0 || cs[0].sp >= cs[0].cap) {
        return false;
    }
    I64 base = cs[0].sp;
    I64 sp = base + 1;
    I64 seen = base + 1;
    wk[base].node = resolve.struct_node(syms, t) as I32;
    wk[base].c = wk[base].node;
    while (sp > base) {
        sp -= 1;
        I64 fd = nodes[wk[sp].node as I64].a as I64;
        while (fd >= 0) {
            I64 ft = sem[fd].ty;
            if (resolve.is_array(ft)) {
                ft = resolve.array_elem(ft);
            }
            if (resolve.is_errset(ft)) {
                return true;
            }
            I64 child = -1;
            if (resolve.is_struct(ft)) {
                child = resolve.struct_node(syms, ft);
            }
            for i in base..seen {
                if (wk[i].c as I64 == child) {
                    child = -1;
                }
            }
            if (child >= 0 && seen < cs[0].cap) {
                wk[seen].c = child as I32;
                seen += 1;
                wk[sp].node = child as I32;
                sp += 1;
            }
            fd = nodes[fd].next as I64;
        }
    }
    return false;
}

// The innermost frame below f of a deferred statement (an N_DEFER statement), or -1.
I64 defer_frame(in parse.Node[_] nodes, in parse.Frame[_] wk, in CState[_] cs, I64 f) {
    I64 i = f - 1;
    while (i >= cs[0].base) {
        if (wk[i].kind == K_STMT && nodes[wk[i].node as I64].kind == parse.N_DEFER) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// The frame below f of the loop labeled with the name at token tok, or -1.
I64 label_frame[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in parse.Frame[_] wk,
        in CState[_] cs, I64 f, I64 tok) {
    I64 i = f - 1;
    while (i >= cs[0].base) {
        I64 y = wk[i].node as I64;
        I32 kind = nodes[y].kind;
        I64 l = label_of(nodes, y);
        if (wk[i].kind == K_STMT && (kind == parse.N_WHILE || kind == parse.N_FOR || kind == parse.N_FOR_RANGE) &&
                l >= 0 && toks[l].len == toks[tok].len &&
                resolve.same_text(src, toks[l].start as I64, toks[tok].start as I64, toks[tok].len as I64)) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// K_INFER on `try e`, node x of frame f at step `step` (SPEC-04 LS-129): C4030 at the `try`
// inside a deferred statement (LS-187); the operand, whose error union the `try` consumes,
// C2043 at the `try` when it is no error union; then, outside a test block (LS-315), C2042
// at the `try` unless the function's result is an error union whose set holds every value of
// the operand's set. The type is the union's value type.
void h_try[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f, I64 step) {
    I64 x = wk[f].node as I64;
    I64 a = nodes[x].a as I64;
    if (step == 0) {
        if (defer_frame(nodes, wk, cs, f) >= 0) {
            resolve.fail(toks, diag, rs, resolve.C_DEFER_LEAVES, tok_of(nodes, x));
            return;
        }
        sem[a].flags = sem[a].flags | resolve.SEM_UNION_OK;
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
        return;
    }
    I64 u = sem[a].ty;
    if (!resolve.is_errunion(u)) {
        resolve.fail(toks, diag, rs, resolve.C_NOT_UNION, tok_of(nodes, x));
        return;
    }
    I64 want = cs[0].result;
    if (cs[0].in_test == 0 && (rs[0].ctx != resolve.CTX_FUNCTION || !resolve.is_errunion(want) ||
            !resolve.errset_holds(nodes, sem, resolve.union_set(want), resolve.union_set(u)))) {
        resolve.fail(toks, diag, rs, resolve.C_SET_NARROW, tok_of(nodes, x));
        return;
    }
    sem[x].ty = resolve.union_value(u);
    pop(cs);
}

// K_INFER on `e catch v` or `e catch (name) { ... }`, node x of frame f at step `step`
// (SPEC-04 LS-95, LS-130, LS-131). Frame b: the binding's scope. The operand, whose error
// union the `catch` consumes (C2043 at the `catch` when it is no error union); then the
// value, of the union's value type, or the binding, a variable of the union's set in a scope
// of its own, and the block, which must not complete (C4002 at its `{`). The type is the
// union's value type.
void h_catch[n, s, r](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f, I64 step) {
    I64 x = wk[f].node as I64;
    I64 a = nodes[x].a as I64;
    I64 b = nodes[x].b as I64;
    I64 c = nodes[x].c as I64;
    if (step == 0) {
        sem[a].flags = sem[a].flags | resolve.SEM_UNION_OK;
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
        return;
    }
    I64 u = sem[a].ty;
    if (step == 1) {
        if (!resolve.is_errunion(u)) {
            resolve.fail(toks, diag, rs, resolve.C_NOT_UNION, tok_of(nodes, x));
            return;
        }
        if (c < 0) {
            if (resolve.union_value(u) == resolve.TY_VOID) {
                resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, b));
                return;
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, b, resolve.union_value(u));
            return;
        }
        wk[f].b = resolve.scope_open(rs) as I32;
        I64 sy = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_VAR, resolve.union_set(u), x, c);
        if (sy < 0) {
            return;
        }
        sem[x].sym = sy;
        _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, b, 0);
        return;
    }
    if (c >= 0) {
        resolve.scope_close(syms, names, rs, wk[f].b as I64);
        if (completes(sem, b)) {
            resolve.fail(toks, diag, rs, resolve.C_CATCH_COMPLETES, tok_of(nodes, b));
            return;
        }
    }
    sem[x].ty = resolve.union_value(u);
    pop(cs);
}

// ---------------------------------------------------------------- inference

// K_INFER on a field of a struct value, node x of frame f (`cint_ref` _infer_Field): C2103
// on a value that is not a struct, C3005 for a name that is not a field of it, both at the
// field's name.
void h_field[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, in limits.Decl[_] decls, inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs, inout CState[_] cs, I64 f, I64 step) {
    I64 x = wk[f].node as I64;
    I64 a = nodes[x].a as I64;
    if (step == 0) {
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
        return;
    }
    if (!resolve.is_struct(sem[a].ty)) {
        resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, tok_of(nodes, x));
        return;
    }
    I64 tk = tok_of(nodes, x);
    if (resolve.struct_node(syms, sem[a].ty) < 0) {
        // A field of an imported struct: its field row (task 2.13 part (iii)).
        I64 fr = import_field(src, toks, decls, syms[sem[a].ty - resolve.TY_STRUCT].value as% I64, tk);
        if (fr < 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNDEFINED, tk);
            return;
        }
        sem[x].sym = -2 - fr;
        sem[x].ty = row_type(toks, decls, syms, diag, rs, fr, tk);
        pop(cs);
        return;
    }
    I64 fd = resolve.field_of(src, toks, nodes, syms, sem[a].ty, tk);
    if (fd < 0) {
        resolve.fail(toks, diag, rs, resolve.C_UNDEFINED, tk);
        return;
    }
    sem[x].sym = fd;
    sem[x].ty = sem[fd].ty;
    if (resolve.is_array(sem[x].ty) && through_pool(nodes, sem, a)) {
        // `cint_ref` refuses an array field of a pool element: no clause says how a view of
        // it is checked (box 12; ref/OPEN.md REF-OQ-45).
        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tk);
        return;
    }
    pop(cs);
}

// Whether place x passes through a pool dereference `p[h]` (`cint_ref` _through_pool).
Bool through_pool(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    I64 e = x;
    while (nodes[e].kind == parse.N_FIELD || nodes[e].kind == parse.N_INDEX) {
        if (nodes[e].kind == parse.N_INDEX && (sem[e].flags & resolve.SEM_DEREF) != 0 &&
                (sem[e].flags & resolve.SEM_VIEW) == 0) {
            return true;
        }
        e = nodes[e].a as I64;
    }
    return false;
}

// The task K_INFER on frame f: the type of expression node x (`cint_ref` Checker.infer).
void h_infer[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 step = wk[f].state as I64;
    I32 k = nodes[x].kind;
    I64 a = nodes[x].a as I64;
    I64 b = nodes[x].b as I64;
    I64 c = nodes[x].c as I64;
    wk[f].state = (step + 1) as I32;
    switch (k) {
        case parse.N_LIT, parse.N_NEGLIT:
            sem[x].ty = resolve.TY_NONE;
            sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            pop(cs);
        case parse.N_BOOL:
            sem[x].ty = fold.TY_BOOL;
            sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            pop(cs);
        case parse.N_TYPEPROP:
            sem[x].ty = resolve.int_class(toks[tok_of(nodes, x)].aux & 255);
            sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            pop(cs);
        case parse.N_TYPENAME:
            resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, x));
        case parse.N_NAME:
            if (step == 0) {
                if (spells(src, toks, tok_of(nodes, x), "ArithError") ||
                        spells(src, toks, tok_of(nodes, x), "AllocError")) {
                    // A built-in error set's name, which no declaration takes, is no value
                    // (`cint_ref` _infer_Name; box 12).
                    resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, x));
                    return;
                }
                I64 sy = resolve.lookup(src, toks, nodes, syms, names, diag, rs, tok_of(nodes, x), first(nodes, x));
                if (sy < 0) {
                    return;
                }
                sem[x].sym = sy;
                if (syms[sy].kind == resolve.SK_CONST && syms[sy].state != resolve.CS_DONE) {
                    if (syms[sy].state == resolve.CS_BUSY) {
                        resolve.fail(toks, diag, rs, resolve.C_SELF_DEPENDENT, first(nodes, x));
                    } else {
                        _ = push(toks, nodes, wk, diag, rs, cs, K_GCONST, syms[sy].node, sy);
                    }
                    return;
                }
            }
            I64 found = sem[x].sym;
            if (syms[found].kind == resolve.SK_FUNC) {
                resolve.fail(toks, diag, rs, resolve.C_FUNCTION_VALUE, first(nodes, x));
                return;
            }
            if (syms[found].kind == resolve.SK_STRUCT || syms[found].kind == resolve.SK_ERRSET) {
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, x));
                return;
            }
            if (syms[found].kind == resolve.SK_ALIAS) {
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, x));
                return;
            }
            if (syms[found].kind == resolve.SK_KERNEL) {
                resolve.fail(toks, diag, rs, resolve.C_FUNCTION_VALUE, first(nodes, x));
                return;
            }
            if (rs[0].ctx == resolve.CTX_KERNEL && syms[found].kind == resolve.SK_MODVAR) {
                resolve.fail(toks, diag, rs, C_KERNEL_MODVAR, first(nodes, x));
                return;
            }
            if ((syms[found].flags & resolve.SF_OUT) != 0 && (sem[x].flags & SEM_WRITE) == 0) {
                // `cint_ref` refuses a read of a kernel's `out` parameter (SPEC-02 K-2).
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, x));
                return;
            }
            if (syms[found].kind == resolve.SK_MODVAR && syms[found].ty == 0) {
                I64 vn = syms[found].node;
                I64 vt = resolve.type_ref(src, toks, nodes, sem, syms, names, decls, diag, rs,
                    nodes[vn].a as I64, -1, -2);
                if (rs[0].err != 0) { return; }
                if (resolve.is_array(vt) || resolve.is_struct(vt) || resolve.is_handle(vt)) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, nodes[nodes[vn].a as I64].tok as I64);
                    return;
                }
                syms[found].ty = vt;
                sem[vn].ty = vt;
            }
            sem[x].ty = syms[found].ty;
            if (rs[0].ctx == resolve.CTX_KERNEL && syms[found].kind == resolve.SK_PARAM &&
                    resolve.is_array(sem[x].ty) && sem[wk[cs[0].base].node as I64].lit_at >= 0) {
                // An element-form kernel's name of an array parameter denotes its element (K-12).
                sem[x].ty = resolve.array_elem(sem[x].ty);
                sem[x].flags = sem[x].flags | resolve.SEM_ELEMENT;
            }
            if (syms[found].kind == resolve.SK_CONST) {
                sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            }
            pop(cs);
        case parse.N_STRING:
            // A string literal argument: `U8[L]` for its L decoded bytes.
            I64 nb = resolve.string_length(src, toks, tok_of(nodes, x), nodes[x].op as I64);
            if (nb > resolve.ARRAY_EXTENT_MAX) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, x));
                return;
            }
            sem[x].ty = resolve.TY_ARRAY + (nb + 1) * 65536 + fold.TY_U8;
            pop(cs);
        case parse.N_DOTNAME:
            // `.name`: its context gives its set (h_expect, compare_sets).
            sem[x].ty = resolve.TY_DOTNAME;
            pop(cs);
        case parse.N_CATCH:
            h_catch(src, toks, nodes, sem, syms, names, wk, diag, rs, cs, f, step);
        case parse.N_UNARY:
            if (nodes[x].op == parse.UNARY_TRY) {
                h_try(toks, nodes, sem, wk, diag, rs, cs, f, step);
                return;
            }
            if (step == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
                return;
            }
            I64 t = sem[a].ty;
            if (nodes[x].op == scan.OP_BANG) {
                if (t != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, a));
                    return;
                }
            } else if (t != resolve.TY_NONE && !resolve.is_int(t)) {
                resolve.fail(toks, diag, rs, use_code(sem, a, resolve.C_NO_OPERATOR), first(nodes, a));
                return;
            }
            sem[x].ty = t;
            if (is_const(sem, a)) {
                sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            }
            pop(cs);
        case parse.N_BINARY, parse.N_COMPARE:
            if (step < 2) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, kid(nodes, x, step), 0);
                return;
            }
            I64 tl = sem[a].ty;
            I64 tr = sem[b].ty;
            I64 t = resolve.TY_NONE;
            if (k == parse.N_BINARY && is_shift(nodes[x].op)) {
                if (tr == resolve.TY_NONE) {
                    settle(toks, nodes, sem, wk, diag, rs, cs, b, fold.TY_I64);
                    if (rs[0].err != 0) {
                        return;
                    }
                }
                if (tr != resolve.TY_NONE && !resolve.is_int(tr)) {
                    resolve.fail(toks, diag, rs, use_code(sem, b, resolve.C_NO_OPERATOR), first(nodes, b));
                    return;
                }
                if (tl != resolve.TY_NONE && !resolve.is_int(tl)) {
                    resolve.fail(toks, diag, rs, use_code(sem, a, resolve.C_NO_OPERATOR), first(nodes, a));
                    return;
                }
                t = tl;
            } else if (k == parse.N_BINARY) {
                if (tl == resolve.TY_NONE && tr != resolve.TY_NONE) {
                    if (!resolve.is_int(tr)) {
                        resolve.fail(toks, diag, rs, use_code(sem, b, resolve.C_NO_OPERATOR), first(nodes, b));
                        return;
                    }
                    settle_rule4(toks, nodes, sem, wk, diag, rs, cs, a, tr);
                    t = tr;
                } else if (tr == resolve.TY_NONE && tl != resolve.TY_NONE) {
                    if (!resolve.is_int(tl)) {
                        resolve.fail(toks, diag, rs, use_code(sem, a, resolve.C_NO_OPERATOR), first(nodes, a));
                        return;
                    }
                    settle_rule4(toks, nodes, sem, wk, diag, rs, cs, b, tl);
                    t = tl;
                } else if (tl != resolve.TY_NONE) {
                    if (tl != tr) {
                        resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, b));
                        return;
                    }
                    if (!resolve.is_int(tl)) {
                        resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, x));
                        return;
                    }
                    t = tl;
                }
            } else {
                I64 ot = fold.TY_I64;
                if (resolve.is_errset(tl) || resolve.is_errset(tr) || tl == resolve.TY_DOTNAME ||
                        tr == resolve.TY_DOTNAME) {
                    ot = compare_sets(src, toks, nodes, sem, diag, rs, a, b);
                } else if (tl == resolve.TY_NONE && tr == resolve.TY_NONE) {
                    settle(toks, nodes, sem, wk, diag, rs, cs, a, fold.TY_I64);
                    if (rs[0].err == 0) {
                        settle(toks, nodes, sem, wk, diag, rs, cs, b, fold.TY_I64);
                    }
                } else if (tl == resolve.TY_NONE && tr != resolve.TY_NONE) {
                    settle_rule4(toks, nodes, sem, wk, diag, rs, cs, a, tr);
                    ot = tr;
                } else if (tr == resolve.TY_NONE && tl != resolve.TY_NONE) {
                    settle_rule4(toks, nodes, sem, wk, diag, rs, cs, b, tl);
                    ot = tl;
                } else if (tl != resolve.TY_NONE) {
                    if (tl != tr) {
                        resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, b));
                        return;
                    }
                    ot = tl;
                }
                if (rs[0].err != 0) {
                    return;
                }
                I32 op = nodes[x].op;
                if (ot == resolve.TY_VOID || resolve.is_mem(ot) || ((ot == fold.TY_BOOL || resolve.is_errset(ot)) &&
                        op != scan.OP_EQ && op != scan.OP_NE)) {
                    // Handles, arenas and pools are not compared, as structs are not (box 12).
                    resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, x));
                    return;
                }
                sem[x].opty = ot;
                t = fold.TY_BOOL;
            }
            sem[x].ty = t;
            if (is_const(sem, a) && is_const(sem, b)) {
                sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            }
            pop(cs);
        case parse.N_LOGICAL:
            if (step == 1 || step == 2) {
                I64 prev = kid(nodes, x, step - 1);
                if (sem[prev].ty != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, prev));
                    return;
                }
            }
            if (step < 2) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, kid(nodes, x, step), 0);
                return;
            }
            sem[x].ty = fold.TY_BOOL;
            if (is_const(sem, a) && is_const(sem, b)) {
                sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            }
            pop(cs);
        case parse.N_COND:
            if (step == 1 && sem[a].ty != fold.TY_BOOL) {
                resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, a));
                return;
            }
            if (step < 3) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, kid(nodes, x, step), 0);
                return;
            }
            I64 ta = sem[b].ty;
            I64 tb = sem[c].ty;
            I64 t = ta;
            if (ta == resolve.TY_NONE && tb != resolve.TY_NONE) {
                settle(toks, nodes, sem, wk, diag, rs, cs, b, tb);
                if (rs[0].err != 0) {
                    return;
                }
                t = tb;
            } else if (tb == resolve.TY_NONE && ta != resolve.TY_NONE) {
                settle(toks, nodes, sem, wk, diag, rs, cs, c, ta);
                if (rs[0].err != 0) {
                    return;
                }
            } else if (ta != tb) {
                resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, c));
                return;
            }
            sem[x].ty = t;
            if (is_const(sem, a) && is_const(sem, b) && is_const(sem, c)) {
                sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            }
            pop(cs);
        case parse.N_CONVERT:
            if (step == 0) {
                I64 target = resolve.type_of(toks, nodes, diag, rs, b);
                if (rs[0].err != 0) {
                    return;
                }
                keep_payload(wk, f, target);
                if (is_literal(nodes, a) && nodes[x].op != scan.OP_AS_TRY) {
                    sem[a].ty = fold.TY_Z;
                    sem[a].flags = sem[a].flags | resolve.SEM_CONST;
                    wk[f].state = 2;
                } else {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
                }
                return;
            }
            if (sem[a].ty == resolve.TY_NONE) {
                settle(toks, nodes, sem, wk, diag, rs, cs, a, fold.TY_I64);
                if (rs[0].err != 0) {
                    return;
                }
            }
            I64 src_ty = ety(sem, a);
            I64 to = payload(wk, f);
            I64 at = first(nodes, x);
            if (c >= 0) {
                resolve.fail(toks, diag, rs, resolve.C_ROUND_CLAUSE, tok_of(nodes, x));
            } else if (to == fold.TY_BOOL && (resolve.is_int(src_ty) || src_ty == fold.TY_Z)) {
                resolve.fail(toks, diag, rs, resolve.C_INT_AS_BOOL, at);
            } else if (to == fold.TY_BOOL || src_ty == resolve.TY_VOID) {
                resolve.fail(toks, diag, rs, resolve.C_NO_CONVERSION, at);
            } else if (src_ty == fold.TY_BOOL && nodes[x].op != parse.CONV_AS) {
                resolve.fail(toks, diag, rs, resolve.C_NO_CONVERSION, at);
            } else if (resolve.is_errset(src_ty) || src_ty == resolve.TY_DOTNAME) {
                resolve.fail(toks, diag, rs, use_code(sem, a, resolve.C_NO_CONVERSION), at);
            } else if (resolve.is_mem(src_ty)) {
                // A handle, arena or pool converts to nothing: no clause gives the diagnostic
                // (box 12; compiler/OPEN.md CINTC-OQ-15).
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
            }
            if (rs[0].err != 0) {
                return;
            }
            sem[x].opty = src_ty;
            sem[x].ty = to;
            if (nodes[x].op == scan.OP_AS_TRY) {
                // `as?`: ArithError!T, holding `.narrow` where `as` faults (SPEC-01 IM-188).
                sem[x].ty = resolve.union_type(resolve.TY_ARITH, to);
                if ((sem[x].flags & resolve.SEM_UNION_OK) == 0) {
                    resolve.fail(toks, diag, rs, resolve.C_UNCONSUMED, at);
                    return;
                }
            } else if (is_const(sem, a)) {
                sem[x].flags = sem[x].flags | resolve.SEM_CONST;
            }
            pop(cs);
        case parse.N_CALL:
            h_call(src, toks, nodes, sem, syms, names, decls, wk, diag, rs, cs, f);
        case parse.N_FIELD:
            if (step == 0) {
                I64 set = set_named(src, toks, nodes, syms, names, diag, rs, a);
                if (rs[0].err != 0) {
                    return;
                }
                if (set != 0) {
                    // An error value `Set.name` (LS-92, LS-97).
                    if (set_value(src, toks, nodes, sem, diag, rs, x, set)) {
                        pop(cs);
                    }
                    return;
                }
            }
            if (step != 0 || alias_of(src, toks, nodes, syms, names, diag, rs, a) < 0) {
                // A field of a struct value (task 2.13 part (ii)).
                if (rs[0].err == 0) {
                    h_field(src, toks, nodes, sem, syms, decls, wk, diag, rs, cs, f, step);
                }
                return;
            }
            // `alias.x`, a constant of an imported module (task 2.13 part (iii)).
            I64 row = qualified(src, toks, nodes, sem, syms, names, decls, diag, rs, x);
            if (row < 0) {
                return;
            }
            if (decls[row].kind == limits.DK_FUNC) {
                resolve.fail(toks, diag, rs, resolve.C_FUNCTION_VALUE, tok_of(nodes, x));
                return;
            }
            if (decls[row].kind == limits.DK_VAR) {
                // A module-level variable of an imported module, a place of its row's type
                // in that module's state (G-C2 review COR-2): not a constant expression.
                if (rs[0].ctx == resolve.CTX_KERNEL) {
                    resolve.fail(toks, diag, rs, C_KERNEL_MODVAR, first(nodes, x));
                    return;
                }
                sem[x].ty = decl.type_of_row(decls, row);
                pop(cs);
                return;
            }
            if (decls[row].kind != limits.DK_CONST) {
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, tok_of(nodes, x));
                return;
            }
            sem[x].ty = decl.type_of_row(decls, row);
            sem[x].bits = decls[row].a as% U64;
            sem[x].flags = sem[x].flags | resolve.SEM_CONST | resolve.SEM_IMPORT;
            pop(cs);
        case parse.N_INDEX:
            h_index(toks, nodes, sem, wk, diag, rs, cs, f);
        default:
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, x));
    }
}

// ---------------------------------------------------------------- imports (task 2.13 part (iii))
//
// An import binds its alias as a module-level name (resolve.bind_alias) to the block of the
// module it names in the declaration table (compiler/decl.ci, SPEC-09 CINTC-16). A
// qualified name `alias.x` is the top-level record x of that block: C3005 at x when there
// is none, C3008 at x when it is not exported (SPEC-04 LS-227), as `cint_ref`'s
// Checker.qualified. An imported constant is a constant expression of the row's type and
// value; an imported function is called with the parameter rows of its record. The node of
// `alias.x` keeps the row in Sem.lit_at (and Sem.bits until a constant's value replaces
// it), the module in Sem.opty and SEM_IMPORT in its flags,
// for compiler/lowering.ci.

const I64 C_PRIVATE = 3008;

// The alias symbol that N_NAME node x names, or -1 when it names no import.
I64 alias_of[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sym[_] syms,
        inout resolve.Name[_] names, inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 x) {
    if (nodes[x].kind != parse.N_NAME || (nodes[x].flags & parse.F_PAREN) != 0) {
        return -1;
    }
    I64 id = resolve.intern(src, toks, names, diag, rs, tok_of(nodes, x));
    if (id < 0) {
        return -1;
    }
    I64 b = resolve.binding(syms, names, rs, id);
    if (b >= 0 && syms[b].kind == resolve.SK_ALIAS) {
        return b;
    }
    return -1;
}

// The row of `alias.x` (node x, an N_FIELD or the callee of an N_CALL), or -1 after C3005,
// C3008, or C9102 for a base that is not an alias (a struct field: part (ii)).
I64 qualified[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        in resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 x) {
    I64 tk = tok_of(nodes, x);
    I64 al = alias_of(src, toks, nodes, syms, names, diag, rs, nodes[x].a as I64);
    if (al < 0) {
        if (rs[0].err == 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tk);
        }
        return -1;
    }
    I64 row = resolve.import_find(names, decls, rs, syms[al].ty, src, toks[tk].start as I64, toks[tk].len as I64);
    if (row == -2) {
        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tk);
    }
    if (row < 0) {
        resolve.fail(toks, diag, rs, resolve.C_UNDEFINED, tk);
        return -1;
    }
    if (decls[row].vis == 0) {
        resolve.fail(toks, diag, rs, C_PRIVATE, tk);
        return -1;
    }
    sem[x].bits = row as U64;
    sem[x].lit_at = row;
    sem[x].opty = syms[al].ty;
    sem[x].flags = sem[x].flags | resolve.SEM_IMPORT;
    return row;
}

// The checker type of the type fields of row r of an imported block (import_type), a struct
// through resolve.import_struct_ty; 0 for a row this checker cannot type.
I64 row_type[y](in scan.Token[_] toks, in limits.Decl[_] decls, inout resolve.Sym[y] syms,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 r, I64 tok) {
    I64 st = 0;
    if ((decls[r].tag as I64) == DECL_STRUCT_TAG) {
        st = resolve.import_struct_ty(toks, syms, diag, rs, decls[r].ref as I64, tok);
    }
    I64 ext = 0;
    if (decls[r].kind == limits.DK_PARAM || decls[r].kind == limits.DK_FIELD) {
        ext = decls[r].b;
    }
    return import_type(decls[r].tag as I64, decls[r].rank as I64, decls[r].ext_kind as I64, ext, st);
}

// The field row named by token tk of the imported struct whose record is row `row`, or -1.
I64 import_field[n](in U8[n] src, in scan.Token[_] toks, in limits.Decl[_] decls, I64 row, I64 tk) {
    I64 r = decl.next_member(decls, row);
    for j in 0..decls[row].a {
        if (decl.name_equals(decls, r, src, toks[tk].start as I64, toks[tk].len as I64)) {
            return r;
        }
        r = decl.next_member(decls, r);
    }
    return -1;
}

// Uses the same qualified type lookup for local declarations and signatures.
I64 var_type[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 a, I64 checked_extent) {
    return resolve.type_ref(src, toks, nodes, sem, syms, names, decls, diag, rs, a, -1, checked_extent);
}

// static_shapes and static_alias for a call of the imported function whose record is row
// `row`, its parameter rows in place of the parameter nodes: C2012 where two views bound to
// one size parameter have static extents that differ, then C5010 for an `inout` view or
// struct argument that names the same variable as another (SPEC-04 LS-117, LS-121).
void import_shapes[r](in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        in limits.Decl[_] decls, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, I64 row, I64 g0) {
    I64 p = decl.next_member(decls, row);
    I64 g = g0;
    for i in 0..decls[row].a {
        if (g < 0) {
            break;
        }
        I64 n = -1;
        if (decls[p].rank == 1 && decls[p].ext_kind == limits.DX_SIZE) {
            n = resolve.array_extent(sem[g].ty);
        }
        if (n >= 0) {
            // The extent bound first to the same size parameter.
            I64 q = decl.next_member(decls, row);
            I64 h = g0;
            I64 bound = -2;
            while (q != p && bound == -2) {
                if (decls[q].rank == 1 && decls[q].ext_kind == limits.DX_SIZE && decls[q].b == decls[p].b) {
                    bound = resolve.array_extent(sem[h].ty);
                }
                q = decl.next_member(decls, q);
                h = nodes[h].next as I64;
            }
            if (bound >= 0 && bound != n) {
                resolve.fail(toks, diag, rs, C_SHAPE, first(nodes, g));
                return;
            }
        }
        p = decl.next_member(decls, p);
        g = nodes[g].next as I64;
    }
    p = decl.next_member(decls, row);
    g = g0;
    for i in 0..decls[row].a {
        if (g < 0) {
            break;
        }
        if (row_aggregate(decls, p)) {
            I64 q = decl.next_member(decls, p);
            I64 h = nodes[g].next as I64;
            while (h >= 0) {
                if (row_aggregate(decls, q) && (decls[p].mode == 2 || decls[q].mode == 2)) {
                    I64 relation = field_overlap(nodes, sem, g, h);
                    if (relation != 0) {
                        I64 code = C_OVERLAP;
                        if (relation < 0) { code = resolve.C_UNSUPPORTED; }
                        resolve.fail(toks, diag, rs, code, first(nodes, h));
                        return;
                    }
                }
                q = decl.next_member(decls, q);
                h = nodes[h].next as I64;
            }
        }
        p = decl.next_member(decls, p);
        g = nodes[g].next as I64;
    }
}

// Whether parameter row p is a view or a struct.
Bool row_aggregate(in limits.Decl[_] decls, I64 p) {
    return decls[p].rank != 0 || (decls[p].tag as I64) == DECL_STRUCT_TAG;
}

// K_INFER on a call of an integer built-in, node x of frame f (`cint_ref` _builtin and
// _builtin_result): C2063 at a named argument, C2022 for the wrong number of arguments,
// C3007 at a type argument that is no integer type or a mode that is no rounding-mode name;
// a rotation's count inferred and settled to I64 first; then each value in order, C2001 at
// one whose type differs from the first typed one. The untyped values take that type; a
// call with no typed value has no type when its result is of the operand type (it is
// settled by its context), else its values are I64. C2103 for an operand type that is not
// an integer type, for `uabs` of an unsigned type and for a rotation of a signed one;
// `mul_full` of a 64-bit type (a 128-bit result) is C9102. The call keeps its operand type
// in opty and the rounding mode in lit_len. Frame: a the target type of `muldiv`, b the
// next value, d the phase.
void h_builtin[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs,
        I64 f) {
    I64 x = wk[f].node as I64;
    I64 id = sem[x].lit_at;
    Bool rot = id == fold.BI_ROTL || id == fold.BI_ROTR;
    I64 nv = typed_values(sem, x);
    if (wk[f].d < 0) {
        I64 argc = 0;
        I64 g = nodes[x].b as I64;
        while (g >= 0) {
            if (nodes[g].kind == parse.N_NAMEDARG) {
                resolve.fail(toks, diag, rs, C_NO_PARAM, tok_of(nodes, g));
                return;
            }
            argc += 1;
            g = nodes[g].next as I64;
        }
        I64 need = fold.builtin_values(id);
        if (id == fold.BI_MULDIV) {
            need += 1;
        }
        if (fold.builtin_mode(id)) {
            need += 1;
        }
        if (argc != need) {
            resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, first(nodes, x));
            return;
        }
        wk[f].a = 0;
        if (id == fold.BI_MULDIV) {
            I64 ta = arg_at(nodes, x, 0);
            if (nodes[ta].kind == parse.N_TYPENAME) {
                wk[f].a = resolve.int_class(toks[tok_of(nodes, ta)].aux & 255) as I32;
            }
            if (wk[f].a == 0) {
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, ta));
                return;
            }
        }
        sem[x].lit_len = 0;
        if (fold.builtin_mode(id)) {
            I64 ma = arg_at(nodes, x, need - 1);
            if (nodes[ma].kind == parse.N_NAME) {
                I64 mt = tok_of(nodes, ma);
                sem[x].lit_len = resolve.round_mode(src, toks[mt].start as I64, toks[mt].len as I64);
            }
            if (sem[x].lit_len == 0) {
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, ma));
                return;
            }
        }
        wk[f].b = 0;
        wk[f].d = 1;
        if (rot) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, builtin_value(nodes, sem, x, 1), 0);
            return;
        }
    }
    if (wk[f].d == 1) {
        wk[f].d = 2;
        if (rot) {
            I64 k = builtin_value(nodes, sem, x, 1);
            if (sem[k].ty == resolve.TY_NONE) {
                settle(toks, nodes, sem, wk, diag, rs, cs, k, fold.TY_I64);
            } else if (!resolve.is_int(sem[k].ty)) {
                resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, k));
            }
            if (rs[0].err != 0) {
                return;
            }
        }
    }
    if (wk[f].b as I64 < nv) {
        I64 v = builtin_value(nodes, sem, x, wk[f].b as I64);
        wk[f].b += 1;
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, v, 0);
        return;
    }
    I64 typed = resolve.TY_NONE;
    for i in 0..nv {
        I64 v = builtin_value(nodes, sem, x, i);
        I64 t = sem[v].ty;
        if (t != resolve.TY_NONE) {
            if (typed == resolve.TY_NONE) {
                typed = t;
            } else if (t != typed) {
                resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, v));
                return;
            }
        }
    }
    // A result-returning form (box 12) is never a constant: its result is an error union.
    Bool constant = !fold.builtin_result(id);
    for i in 0..fold.builtin_values(id) {
        constant = constant && is_const(sem, builtin_value(nodes, sem, x, i));
    }
    if (constant) {
        sem[x].flags = sem[x].flags | resolve.SEM_CONST;
    }
    if (typed == resolve.TY_NONE) {
        if (fold.builtin_same(id)) {
            sem[x].ty = resolve.TY_NONE;
            sem[x].opty = resolve.TY_NONE;
            pop(cs);
            return;
        }
        typed = fold.TY_I64;
    }
    for i in 0..nv {
        I64 v = builtin_value(nodes, sem, x, i);
        if (sem[v].ty == resolve.TY_NONE) {
            settle(toks, nodes, sem, wk, diag, rs, cs, v, typed);
            if (rs[0].err != 0) {
                return;
            }
        }
    }
    if (id == fold.BI_SHL_RESULT) {
        // `shl_result`'s count, typed as a shift count (`cint_ref` _result_builtin; LS-57).
        I64 k = builtin_value(nodes, sem, x, 1);
        if (wk[f].d == 2) {
            wk[f].d = 3;
            _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, k, 0);
            return;
        }
        if (sem[k].ty == resolve.TY_NONE) {
            settle(toks, nodes, sem, wk, diag, rs, cs, k, fold.TY_I64);
        } else if (!resolve.is_int(sem[k].ty)) {
            resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, k));
        }
        if (rs[0].err != 0) {
            return;
        }
    }
    builtin_result(toks, nodes, sem, diag, rs, x, typed, wk[f].a as I64);
    if (rs[0].err == 0) {
        pop(cs);
    }
}

// The result type of built-in call x on operand type t (`cint_ref` _builtin_result), and
// its diagnostics; target the result type of `muldiv`.
void builtin_result[r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, I64 x, I64 t, I64 target) {
    I64 id = sem[x].lit_at;
    I64 at = first(nodes, x);
    if (!resolve.is_int(t) || (id == fold.BI_UABS && !fold.ty_signed(t)) ||
            ((id == fold.BI_ROTL || id == fold.BI_ROTR) && fold.ty_signed(t))) {
        resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, at);
        return;
    }
    if (id == fold.BI_MUL_FULL && fold.ty_width(t) == 64) {
        // I128 and the Proposed U128 are outside this implementation.
        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
        return;
    }
    sem[x].opty = t;
    if (fold.builtin_result(id)) {
        // `add_result` and the others (SPEC-01 IM-30, IM-188): ArithError!T, consumed by
        // `try`, `catch` or `_ =` (C2040 otherwise, LS-95).
        sem[x].ty = resolve.union_type(resolve.TY_ARITH, t);
        if ((sem[x].flags & resolve.SEM_UNION_OK) == 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNCONSUMED, at);
        }
        return;
    }
    if (id == fold.BI_UABS) {
        sem[x].ty = t + 0x10;
    } else if (id == fold.BI_MUL_FULL) {
        sem[x].ty = t + 1;
    } else if (id == fold.BI_MULDIV) {
        sem[x].ty = target;
    } else {
        sem[x].ty = t;
    }
}

// Notes the first completed check of call x of a function, own or imported (`cint_ref`'s
// call sites, `_sited`): its place in check order in Sem.lit_len and the top-level item that
// holds it in Sem.opty, for state_args (G-C2 review COR-6).
void note_call(inout resolve.Sem[_] sem, in parse.Frame[_] wk, in CState[_] cs, I64 x) {
    if (sem[x].lit_len == 0) {
        sem[x].lit_len = cs[0].steps;
        sem[x].opty = wk[cs[0].base].node as I64;
    }
}

// ---------------------------------------------------------------- array built-ins (box 09)

// Whether array built-in id is a reduction (SPEC-04 LS-145): `sum`, `fold_checked`,
// `sum_wrap`, `sum_sat`, `count`, `dot`, and `min` and `max` of an array.
Bool af_reduction(I64 id) {
    return id >= resolve.AF_SUM;
}

// The number of arguments of array built-in call x before its values: the result type of
// `sum` and `dot` when written, the operation of `fold_checked`.
I64 af_skip(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    I64 id = sem[x].lit_at;
    I64 a0 = nodes[x].b as I64;
    if (id == resolve.AF_FOLD) {
        return 1;
    }
    if ((id == resolve.AF_SUM || id == resolve.AF_DOT) && a0 >= 0 && nodes[a0].kind == parse.N_TYPENAME) {
        return 1;
    }
    return 0;
}

// Value i of array built-in call x, or -1.
I64 af_value(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x, I64 i) {
    return arg_at(nodes, x, i + af_skip(nodes, sem, x));
}

// The number of values of array built-in call x.
I64 af_values(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    return list_length(nodes, nodes[x].b as I64) - af_skip(nodes, sem, x);
}

// Array i of reduction x: both values of `dot`, else the last value.
I64 af_array(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x, I64 i) {
    if (sem[x].lit_at == resolve.AF_DOT) {
        return af_value(nodes, sem, x, i);
    }
    return af_value(nodes, sem, x, af_values(nodes, sem, x) - 1);
}

// The arrays of reduction x: two for `dot`, else one.
I64 af_arrays(in resolve.Sem[_] sem, I64 x) {
    if (sem[x].lit_at == resolve.AF_DOT) {
        return 2;
    }
    return 1;
}

// The last argument of `min` or `max` call x when its arguments can make the array form
// (`cint_ref` _array_form; SPEC-04 LS-145): one or two, none named, the last an array
// literal or an expression that may have an array type; else -1.
I64 array_form_last(in parse.Node[_] nodes, I64 x) {
    I64 g = nodes[x].b as I64;
    I64 n = 0;
    I64 last = -1;
    while (g >= 0) {
        if (nodes[g].kind == parse.N_NAMEDARG) {
            return -1;
        }
        n += 1;
        last = g;
        g = nodes[g].next as I64;
    }
    if (n < 1 || n > 2) {
        return -1;
    }
    I32 k = nodes[last].kind;
    if (k == parse.N_ARRAY || k == parse.N_NAME || k == parse.N_INDEX || k == parse.N_FIELD || k == parse.N_CALL) {
        return last;
    }
    return -1;
}

// K_INFER on a call of an array built-in, SEM_ARRAYFN with its AF_* id in lit_at (`cint_ref`
// _len, _reduction, _array_builtin, _constant_dim, _copy_fill; SPEC-04 LS-70, LS-145;
// rulings R4, R6), in `cint_ref`'s order:
//   - `len(a)`: one argument (C2022), an array (C2103) of rank 1 (C2014 at the call); I64.
//   - a reduction, outside a kernel (C9102 there, where a `reduce` statement reduces): no
//     named argument (C2063), the result type of `sum` an integer type and that of `dot`
//     written (C3007), the operation of `fold_checked` `add` or `mul` (C3007; lit_len 1 or
//     2), its argument count (C2022), each array an array (C2103) of integer elements
//     (C2103) or, for `count`, Bool ones (C2001), the arrays of `dot` of one element type
//     (C2001) and rank 1 (C9102, as `cint_ref` refuses), then the initial value of the
//     element type. The result type is the written one, I64 for `count`, else the element
//     type; opty is the element type.
//   - `extent(a, d)`, `size(a)`, `transpose(a)`, `reverse(a, d)`: no named argument
//     (C2063), the argument count (C2022), outside a kernel unless `extent` or `size`
//     (C9102), an array (C2103); a dimension argument an I64 constant below the rank
//     (C2001; C9102 otherwise, as `cint_ref` refuses it) that is folded; `transpose` of
//     rank 2 (C9102). `extent` and `size` give I64, the view functions a view of the
//     argument's storage with its dimensions swapped or kept.
//   - `copy(dst, src)`: `dst` an array (C2103) and a writable place (C2067), `src` expected
//     to have its element type, rank and static extents (C2001, C2012), both places
//     folded, then C5010 at `src` when the two are known to overlap and differ; void.
// Frame: c the stage, b the next array.
void h_arrayfn[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        in resolve.Sym[_] syms, in limits.Decl[_] decls, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 id = sem[x].lit_at;
    I64 at = first(nodes, x);
    I64 stage = wk[f].c as I64;
    wk[f].c = (stage + 1) as I32;
    I64 a0 = nodes[x].b as I64;
    if (stage == 0) {
        I64 argc = list_length(nodes, a0);
        if (id == resolve.AF_LEN) {
            if (argc != 1 || nodes[a0].kind == parse.N_NAMEDARG) {
                resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, at);
                return;
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a0, 0);
            return;
        }
        if (af_reduction(id) && rs[0].ctx == resolve.CTX_KERNEL) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
            return;
        }
        I64 g = a0;
        while (g >= 0) {
            if (nodes[g].kind == parse.N_NAMEDARG) {
                resolve.fail(toks, diag, rs, C_NO_PARAM, tok_of(nodes, g));
                return;
            }
            g = nodes[g].next as I64;
        }
        if (af_reduction(id)) {
            Bool typed = af_skip(nodes, sem, x) == 1 && id != resolve.AF_FOLD;
            if (typed && resolve.int_class(toks[tok_of(nodes, a0)].aux & 255) == 0) {
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, a0));
                return;
            }
            if (id == resolve.AF_DOT && !typed) {
                I64 wh = at;
                if (a0 >= 0) {
                    wh = first(nodes, a0);
                }
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, wh);
                return;
            }
            sem[x].lit_len = 0;
            if (id == resolve.AF_FOLD) {
                if (a0 >= 0 && nodes[a0].kind == parse.N_NAME) {
                    I64 ot = tok_of(nodes, a0);
                    if (spells(src, toks, ot, "add")) {
                        sem[x].lit_len = 1;
                    } else if (spells(src, toks, ot, "mul")) {
                        sem[x].lit_len = 2;
                    }
                }
                if (sem[x].lit_len == 0) {
                    I64 wh = at;
                    if (a0 >= 0) {
                        wh = first(nodes, a0);
                    }
                    resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, wh);
                    return;
                }
            }
            I64 nv = af_values(nodes, sem, x);
            Bool count_ok = nv == 1;
            if (id == resolve.AF_DOT || id == resolve.AF_FOLD) {
                count_ok = nv == 2;
            } else if (id == resolve.AF_MIN || id == resolve.AF_MAX) {
                count_ok = nv == 1 || nv == 2;
            }
            if (!count_ok) {
                resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, at);
                return;
            }
            wk[f].b = 0;
            return;
        }
        I64 want = 2;
        if (id == resolve.AF_TRANSPOSE || id == resolve.AF_SIZE) {
            want = 1;
        }
        if (argc != want) {
            resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, at);
            return;
        }
        if (rs[0].ctx == resolve.CTX_KERNEL && id != resolve.AF_EXTENT && id != resolve.AF_SIZE) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a0, 0);
        return;
    }
    if (id == resolve.AF_LEN) {
        if (!resolve.is_array(sem[a0].ty)) {
            resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, a0));
            return;
        }
        if (resolve.array_rank(sem[a0].ty) != 1) {
            resolve.fail(toks, diag, rs, C_LEN_RANK, at);
            return;
        }
        sem[x].ty = fold.TY_I64;
        pop(cs);
        return;
    }
    if (af_reduction(id)) {
        // Stage 1 infers array b, stage 2 checks it; stage 3 checks the elements and
        // expects the initial value; stage 4 settles the result.
        I64 i = wk[f].b as I64;
        if (stage == 1) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, af_array(nodes, sem, x, i), 0);
            return;
        }
        if (stage == 2) {
            I64 y = af_array(nodes, sem, x, i);
            if (!resolve.is_array(sem[y].ty)) {
                resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, y));
                return;
            }
            if (i + 1 < af_arrays(sem, x)) {
                // The next array: inferred, then checked at stage 2 again.
                wk[f].b = (i + 1) as I32;
                wk[f].c = 2;
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, af_array(nodes, sem, x, i + 1), 0);
            }
            return;
        }
        I64 y0 = af_array(nodes, sem, x, 0);
        I64 elem = resolve.array_elem(sem[y0].ty);
        if (stage == 3) {
            if (id == resolve.AF_COUNT) {
                if (elem != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, y0));
                    return;
                }
            } else if (!resolve.is_int(elem)) {
                resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, y0));
                return;
            }
            if (id == resolve.AF_DOT) {
                I64 y1 = af_array(nodes, sem, x, 1);
                if (resolve.array_elem(sem[y1].ty) != elem) {
                    resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, y1));
                    return;
                }
                if (resolve.array_rank(sem[y0].ty) != 1) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, y0));
                    return;
                }
                if (resolve.array_rank(sem[y1].ty) != 1) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, y1));
                    return;
                }
            }
            if (id != resolve.AF_DOT && af_values(nodes, sem, x) == 2) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, af_value(nodes, sem, x, 0), elem);
            }
            return;
        }
        I64 result = elem;
        if (id == resolve.AF_COUNT) {
            result = fold.TY_I64;
        } else if (af_skip(nodes, sem, x) == 1 && id != resolve.AF_FOLD) {
            result = resolve.int_class(toks[tok_of(nodes, a0)].aux & 255);
        }
        sem[x].ty = result;
        sem[x].opty = elem;
        pop(cs);
        return;
    }
    I64 t = sem[a0].ty;
    I64 d = nodes[a0].next as I64;
    if (stage == 1) {
        if (!resolve.is_array(t)) {
            resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, a0));
            return;
        }
        if (id == resolve.AF_COPY) {
            if (!writable_view(nodes, sem, syms, decls, a0)) {
                resolve.fail(toks, diag, rs, C_NOT_WRITABLE, first(nodes, a0));
                return;
            }
            I64[4] code;
            for k in 0..4 {
                code[k] = 0;
                if (k < resolve.array_rank(t) && resolve.dim_extent(t, k) >= 0) {
                    code[k] = resolve.dim_extent(t, k) + 1;
                }
            }
            I64 want = resolve.shaped(resolve.elem_code(t), resolve.array_rank(t), code[0], code[1], code[2], code[3]);
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, d, want);
            return;
        }
        if (id == resolve.AF_EXTENT || id == resolve.AF_REVERSE) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, d, 0);
            return;
        }
        stage = 4;
    }
    if (id == resolve.AF_COPY) {
        if (stage == 2) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_PLACE, a0, 0);
        } else if (stage == 3) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_PLACE, d, 0);
        } else {
            static_copy_alias(toks, nodes, sem, syms, wk, diag, rs, cs, a0, d);
            if (rs[0].err != 0) {
                return;
            }
            sem[x].ty = resolve.TY_VOID;
            pop(cs);
        }
        return;
    }
    if (stage == 2) {
        if (!settle_i64(toks, nodes, sem, wk, diag, rs, cs, d)) {
            return;
        }
        if (!is_const(sem, d)) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, d));
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, d, 0);
        return;
    }
    if (stage == 3) {
        I64 dv = sem[d].bits as% I64;
        if (dv < 0 || dv >= resolve.array_rank(t)) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, d));
            return;
        }
    }
    if (id == resolve.AF_EXTENT || id == resolve.AF_SIZE) {
        sem[x].ty = fold.TY_I64;
    } else if (id == resolve.AF_TRANSPOSE) {
        if (resolve.array_rank(t) != 2) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, a0));
            return;
        }
        sem[x].ty = resolve.shaped(resolve.elem_code(t), 2, resolve.dim_code(t, 1), resolve.dim_code(t, 0), 0, 0);
    } else {
        sem[x].ty = t;
    }
    pop(cs);
}

// K_INFER on a call (`cint_ref` _infer_Call, _bind_args, _user_call). Frame: a the callee's
// symbol, b the next argument, c its parameter.
void h_call[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 step = wk[f].state as I64 - 1;
    I64 at = first(nodes, x);
    if (is_builtin(nodes, sem, x) && (sem[x].lit_at == fold.BI_MIN || sem[x].lit_at == fold.BI_MAX) &&
            wk[f].d < 0 && step < 2) {
        // `min` and `max` reduce when their last argument is an array (`cint_ref` _array_form,
        // which infers that argument first; the scalar form infers it again).
        I64 last = array_form_last(nodes, x);
        if (last >= 0 && step == 0 && nodes[last].kind != parse.N_ARRAY) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, last, 0);
            return;
        }
        if (last >= 0 && (nodes[last].kind == parse.N_ARRAY || resolve.is_array(sem[last].ty))) {
            I64 af = resolve.AF_MAX;
            if (sem[x].lit_at == fold.BI_MIN) {
                af = resolve.AF_MIN;
            }
            sem[x].flags = sem[x].flags - resolve.SEM_BUILTIN + resolve.SEM_ARRAYFN;
            sem[x].lit_at = af;
            wk[f].c = 0;
        }
    }
    if ((sem[x].flags & resolve.SEM_ARRAYFN) != 0) {
        h_arrayfn(src, toks, nodes, sem, syms, decls, wk, diag, rs, cs, f);
        return;
    }
    if (is_builtin(nodes, sem, x)) {
        h_builtin(src, toks, nodes, sem, wk, diag, rs, cs, f);
        return;
    }
    if (step == 0 && nodes[nodes[x].a as I64].kind == parse.N_FIELD &&
            alias_of(src, toks, nodes, syms, names, diag, rs, nodes[nodes[x].a as I64].a as I64) < 0) {
        // `name.m(...)` with name no import alias: a member of an arena or a pool (box 12).
        if (rs[0].err == 0) {
            wk[f].kind = K_MEMBER;
            wk[f].state = 0;
        }
        return;
    }
    if (step == 0 && nodes[nodes[x].a as I64].kind == parse.N_FIELD) {
        // A call of an imported function: its parameter rows give the types (frame: a is
        // -2 - the function's row, c the next parameter row).
        I64 q = nodes[x].a as I64;
        I64 row = qualified(src, toks, nodes, sem, syms, names, decls, diag, rs, q);
        if (row < 0) {
            return;
        }
        if (decls[row].kind == limits.DK_STRUCT) {
            // Binds all fields before checking their values in written order.
            // Frame: d 3, c the next positional field row.
            I64 st = resolve.import_struct_ty(toks, syms, diag, rs, row, tok_of(nodes, q));
            if (st == 0) {
                return;
            }
            bind_import_fields(src, toks, nodes, decls, diag, rs, x, row);
            if (rs[0].err != 0) {
                return;
            }
            wk[f].a = (-2 - row) as I32;
            wk[f].b = nodes[x].b;
            wk[f].c = decl.next_member(decls, row) as I32;
            wk[f].d = 3;
            step = 1;
        } else if (decls[row].kind != limits.DK_FUNC) {
            resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, tok_of(nodes, q));
            return;
        } else if (rs[0].ctx == resolve.CTX_KERNEL) {
            // `cint_ref` refuses a call in a kernel body (SPEC-02 K-11).
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
            return;
        }
    }
    if (step == 0 && nodes[nodes[x].a as I64].kind == parse.N_FIELD) {
        I64 q = nodes[x].a as I64;
        I64 row = sem[q].lit_at;
        I64 nargs = 0;
        I64 g = nodes[x].b as I64;
        while (g >= 0) {
            if (nargs >= decls[row].a) {
                resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, at);
                return;
            }
            if (nodes[g].kind == parse.N_TYPENAME) {
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, g));
                return;
            }
            if (nodes[g].kind == parse.N_NAMEDARG) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, nodes[g].tok as I64);
                return;
            }
            nargs += 1;
            g = nodes[g].next as I64;
        }
        if (nargs != decls[row].a) {
            resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, at);
            return;
        }
        wk[f].a = (-2 - row) as I32;
        wk[f].b = nodes[x].b;
        wk[f].c = decl.next_member(decls, row) as I32;
        wk[f].d = 0;
        step = 1;
    }
    if (wk[f].a <= -2) {
        I64 row = -2 - wk[f].a as I64;
        I64 arg = wk[f].b as I64;
        if (wk[f].d > 3) {
            // The argument just checked, for parameter row d - 4 (`cint_ref` _user_call: C2067).
            I64 dp = wk[f].d as I64 - 4;
            I64 done = nodes[x].b as I64;
            while (nodes[done].next as I64 != arg) {
                done = nodes[done].next as I64;
            }
            if (decls[dp].mode == 2 && !writable_view(nodes, sem, syms, decls, done)) {
                resolve.fail(toks, diag, rs, C_NOT_WRITABLE, first(nodes, done));
                return;
            }
        }
        if (arg >= 0) {
            I64 p = wk[f].c as I64;
            I64 value = arg;
            if (wk[f].d == 3 && nodes[arg].kind == parse.N_NAMEDARG) {
                p = import_field(src, toks, decls, row, nodes[arg].tok as I64);
                value = nodes[arg].a as I64;
            }
            I64 pty = row_type(toks, decls, syms, diag, rs, p, tok_of(nodes, nodes[x].a as I64));
            if (pty == 0) {
                if (rs[0].err == 0) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, nodes[x].a as I64));
                }
                return;
            }
            if (nodes[arg].kind == parse.N_STRING && !(decls[p].kind == limits.DK_PARAM &&
                    decls[p].mode != 2 && resolve.is_array(pty) && resolve.array_elem(pty) == fold.TY_U8)) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, arg));
                return;
            }
            wk[f].b = nodes[arg].next;
            wk[f].c = decl.next_member(decls, p) as I32;
            if (wk[f].d != 3) {
                wk[f].d = (4 + p) as I32;
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, value, pty);
            return;
        }
        if (wk[f].d == 3) {
            sem[x].ty = resolve.import_struct_ty(toks, syms, diag, rs, row, tok_of(nodes, nodes[x].a as I64));
        } else {
            import_shapes(toks, nodes, sem, decls, diag, rs, row, nodes[x].b as I64);
            if (rs[0].err != 0) {
                return;
            }
            sem[x].ty = row_type(toks, decls, syms, diag, rs, row, tok_of(nodes, nodes[x].a as I64));
            if (sem[x].ty == 0) {
                if (rs[0].err == 0) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, nodes[x].a as I64));
                }
                return;
            }
            note_call(sem, wk, cs, x);
        }
        pop(cs);
        return;
    }
    if (step == 0) {
        I64 callee = nodes[x].a as I64;

        I64 tok = tok_of(nodes, callee);
        I64 id = resolve.intern(src, toks, names, diag, rs, tok);
        if (id < 0) {
            return;
        }
        I64 bound = resolve.binding(syms, names, rs, id);
        if (bound >= 0 && syms[bound].kind == resolve.SK_KERNEL) {
            // A dispatch (`cint_ref` _dispatch), once the kernel's signature is typed.
            if (syms[bound].state != resolve.CS_DONE) {
                if (syms[bound].state == resolve.CS_BUSY) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
                } else {
                    wk[f].state = 0;
                    _ = push(toks, nodes, wk, diag, rs, cs, K_SIGNATURE, syms[bound].node, 0);
                }
                return;
            }
            wk[f].kind = K_DISPATCH;
            wk[f].state = 0;
            wk[f].a = bound as I32;
            return;
        }
        if (bound >= 0 && syms[bound].kind == resolve.SK_STRUCT) {
            sem[x].sym = bound;
            bind_fields(src, toks, nodes, syms, diag, rs, x, bound);
            if (rs[0].err != 0) {
                return;
            }
            wk[f].a = bound as I32;
            wk[f].b = nodes[x].b;
            wk[f].d = 2;
        } else if (bound < 0 || syms[bound].kind != resolve.SK_FUNC) {
            I64 sy = resolve.lookup(src, toks, nodes, syms, names, diag, rs, tok, at);
            if (sy < 0) {
                return;
            }
            if (syms[sy].kind == resolve.SK_CONST && syms[sy].state != resolve.CS_DONE) {
                if (syms[sy].state == resolve.CS_BUSY) {
                    resolve.fail(toks, diag, rs, resolve.C_SELF_DEPENDENT, at);
                } else {
                    wk[f].d = 1;
                    _ = push(toks, nodes, wk, diag, rs, cs, K_GCONST, syms[sy].node, sy);
                }
                return;
            }
            resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, at);
            return;
        }
        if (wk[f].d == 2) {
            // A constructor: its arguments are checked below, in written order.
            wk[f].c = -1;
        } else {
            if (rs[0].ctx == resolve.CTX_KERNEL) {
                // `cint_ref` refuses a call in a kernel body (SPEC-02 K-11).
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
                return;
            }
            sem[x].sym = bound;
            I64 fn = syms[bound].node;
            I64 nparams = 0;
            I64 p = nodes[fn].b as I64;
            while (p >= 0) {
                nparams += 1;
                p = nodes[p].next as I64;
            }
            I64 nargs = 0;
            I64 g = nodes[x].b as I64;
            while (g >= 0) {
                if (nargs >= nparams) {
                    resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, at);
                    return;
                }
                if (nodes[g].kind == parse.N_TYPENAME) {
                    resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, g));
                    return;
                }
                if (nodes[g].kind == parse.N_NAMEDARG) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, nodes[g].tok as I64);
                    return;
                }
                nargs += 1;
                g = nodes[g].next as I64;
            }
            if (nargs != nparams) {
                resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, at);
                return;
            }
            if (syms[bound].state != resolve.CS_DONE) {
                if (syms[bound].state == resolve.CS_BUSY) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
                } else {
                    wk[f].state = 0;
                    _ = push(toks, nodes, wk, diag, rs, cs, K_SIGNATURE, fn, 0);
                }
                return;
            }
            wk[f].a = bound as I32;
            wk[f].b = nodes[x].b;
            wk[f].c = nodes[fn].b;
        }
    }
    if (wk[f].d == 2) {
        I64 g = wk[f].b as I64;
        if (g >= 0) {
            wk[f].b = nodes[g].next;
            I64 st = syms[wk[f].a as I64].ty;
            I64 fd = -1;
            I64 v = g;
            if (nodes[g].kind == parse.N_NAMEDARG) {
                fd = resolve.field_of(src, toks, nodes, syms, st, nodes[g].tok as I64);
                v = nodes[g].a as I64;
            } else {
                // Positional arguments come first, so g's position is its field's.
                fd = nodes[resolve.struct_node(syms, st)].a as I64;
                I64 h = nodes[x].b as I64;
                while (h != g) {
                    fd = nodes[fd].next as I64;
                    h = nodes[h].next as I64;
                }
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, v, sem[fd].ty);
            return;
        }
        sem[x].ty = syms[wk[f].a as I64].ty;
        pop(cs);
        return;
    }
    if (wk[f].d == 1) {
        resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, at);
        return;
    }
    if (wk[f].d <= -2) {
        // The argument just checked, for parameter c (`cint_ref` _user_call: C2067).
        I64 done = -(wk[f].d as I64) - 2;
        I64 dp = wk[f].c as I64;
        wk[f].d = 0;
        wk[f].c = nodes[dp].next;
        if (nodes[dp].op == scan.KW_INOUT && !writable_view(nodes, sem, syms, decls, done)) {
            resolve.fail(toks, diag, rs, C_NOT_WRITABLE, first(nodes, done));
            return;
        }
    }
    I64 arg = wk[f].b as I64;
    if (arg >= 0) {
        I64 p = wk[f].c as I64;
        wk[f].b = nodes[arg].next;
        wk[f].d = (-arg - 2) as I32;
        _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, arg, sem[p].ty);
        return;
    }
    I64 fn = syms[wk[f].a as I64].node;
    static_shapes(toks, nodes, sem, diag, rs, fn, nodes[x].b as I64);
    if (rs[0].err == 0) {
        static_alias(toks, nodes, sem, syms, wk, diag, rs, cs, fn, nodes[x].b as I64);
    }
    if (rs[0].err != 0) {
        return;
    }
    sem[x].ty = syms[wk[f].a as I64].ty;
    if (resolve.is_errunion(sem[x].ty) && (sem[x].flags & resolve.SEM_UNION_OK) == 0) {
        // An error union that no `try`, `catch` or `_ =` consumes (LS-95).
        resolve.fail(toks, diag, rs, resolve.C_UNCONSUMED, at);
        return;
    }
    note_call(sem, wk, cs, x);
    pop(cs);
}

// K_MEMBER on frame f: call node x whose callee is `name.m` with name no import alias, a
// member of an arena or a pool (`cint_ref` _infer_Call, _member; SPEC-04 LS-145, LS-306;
// SPEC-03 M-14 to M-20; ref/OPEN.md REF-OQ-45): C9102 at m when name is unbound or names no
// arena or pool, in a kernel body, or for another member; C2063 at a named argument; C2022
// at the call for another argument count; C2067 at name when the arena or pool is not
// writable (an `in` parameter). `alloc`, `alloc_result` and `child` take an I64, `insert` and
// `insert_result` an element, `remove` a pool's handle. The call keeps SEM_MEMBER and its
// member in Sem.lit_at; an `_result` member's error union is C2040 unless consumed (LS-95).
void h_member[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 step = wk[f].state as I64;
    wk[f].state = (step + 1) as I32;
    I64 q = nodes[x].a as I64;
    I64 recv = nodes[q].a as I64;
    I64 mt = tok_of(nodes, q);
    I64 arg = nodes[x].b as I64;
    if (step == 0) {
        I64 id = resolve.intern(src, toks, names, diag, rs, tok_of(nodes, recv));
        if (id < 0) {
            return;
        }
        if (resolve.binding(syms, names, rs, id) < 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, mt);
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, recv, 0);
        return;
    }
    I64 t = sem[recv].ty;
    if (step == 1) {
        if (!resolve.is_mem(t) || resolve.is_handle(t) || rs[0].ctx == resolve.CTX_KERNEL) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, mt);
            return;
        }
        I64 mb = resolve.member_id(src, toks[mt].start as I64, toks[mt].len as I64, t);
        if (mb == 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, mt);
            return;
        }
        I64 n = 0;
        I64 g = arg;
        while (g >= 0) {
            if (nodes[g].kind == parse.N_NAMEDARG) {
                resolve.fail(toks, diag, rs, C_NO_PARAM, nodes[g].tok as I64);
                return;
            }
            n += 1;
            g = nodes[g].next as I64;
        }
        if (n != resolve.member_arity(mb)) {
            resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, first(nodes, x));
            return;
        }
        if (!writable_view(nodes, sem, syms, decls, recv)) {
            resolve.fail(toks, diag, rs, C_NOT_WRITABLE, first(nodes, recv));
            return;
        }
        sem[x].lit_at = mb;
        if (arg >= 0) {
            I64 want = fold.TY_I64;
            if (mb == resolve.MB_INSERT || mb == resolve.MB_INSERT_RESULT) {
                want = resolve.mem_elem(t);
            } else if (mb == resolve.MB_REMOVE) {
                want = resolve.handle_of(t);
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, arg, want);
            return;
        }
        step = 2;
    }
    I64 m = sem[x].lit_at;
    if (step == 2 && m != resolve.MB_REMOVE && arg >= 0) {
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, arg, 0);
        return;
    }
    I64 ty = resolve.TY_VOID;
    if (m == resolve.MB_ALLOC || m == resolve.MB_INSERT) {
        ty = resolve.handle_of(t);
    } else if (m == resolve.MB_ALLOC_RESULT || m == resolve.MB_INSERT_RESULT) {
        ty = resolve.union_type(resolve.TY_ALLOC, resolve.handle_of(t));
    } else if (m == resolve.MB_CHILD) {
        ty = resolve.mem_type(resolve.MK_ARENA, resolve.mem_code(t));
    }
    sem[x].ty = ty;
    sem[x].flags = sem[x].flags | resolve.SEM_MEMBER;
    if (resolve.is_errunion(ty) && (sem[x].flags & resolve.SEM_UNION_OK) == 0) {
        resolve.fail(toks, diag, rs, resolve.C_UNCONSUMED, first(nodes, x));
        return;
    }
    pop(cs);
}

// K_MEMORY on frame f: module-level arena or pool declaration x (`cint_ref`
// check_memory_decl; SPEC-03 M-20; ref/OPEN.md REF-OQ-45): its type (resolve.mem_type_ref),
// then its capacity, an I64 constant expression (C6004 at it otherwise) of at least 0 (C6006
// at it otherwise), which its symbol keeps in value, then no initializer (C1050 at its `=`).
void h_memory[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 step = wk[f].state as I64;
    wk[f].state = (step + 1) as I32;
    I64 ty = nodes[x].a as I64;
    I64 cap = nodes[ty].c as I64;
    I64 sy = sem[x].sym;
    if (step == 0) {
        sem[ty].ty = resolve.mem_type_ref(src, toks, nodes, syms, names, diag, rs, ty, resolve.MW_MEMORY);
        if (rs[0].err != 0) {
            return;
        }
        sem[x].ty = sem[ty].ty;
        if (sy >= 0) {
            syms[sy].ty = sem[ty].ty;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, cap, fold.TY_I64);
        return;
    }
    if (step == 1) {
        if (!is_const(sem, cap)) {
            resolve.fail(toks, diag, rs, resolve.C_CONST_REQUIRED, first(nodes, cap));
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, cap, 0);
        return;
    }
    if ((sem[cap].bits as% I64) < 0) {
        resolve.fail(toks, diag, rs, C_NEGATIVE_CAPACITY, first(nodes, cap));
        return;
    }
    if (nodes[x].b >= 0) {
        resolve.fail(toks, diag, rs, scan.C_SYNTAX, first(nodes, nodes[x].b as I64) - 1);
        return;
    }
    if (sy >= 0) {
        syms[sy].value = sem[cap].bits;
    }
    pop(cs);
}

// C6006: the capacity of an arena or a pool below 0 (box 12; ref/OPEN.md REF-OQ-45).
const I64 C_NEGATIVE_CAPACITY = 6006;

const I64 C_NOT_WRITABLE = 2067;
const I64 C_POSITIONAL = 2069;
const I64 C_NO_PARAM = 2063;
// C6006: `clamp` with constant bounds lo > hi (SPEC-01 4.8).
const I64 C_CLAMP_BOUNDS = 6006;
const I64 C_TWICE = 2062;
const I64 C_MISSING_FIELD = 2020;

// Binds imported constructor fields in the same order as bind_fields and cint_ref.
void bind_import_fields[r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes,
        in limits.Decl[_] decls, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs,
        I64 x, I64 row) {
    I64 filled = 0;
    I64 npos = 0;
    Bool named = false;
    I64 g = nodes[x].b as I64;
    while (g >= 0) {
        I64 v = g;
        if (nodes[g].kind == parse.N_NAMEDARG) {
            named = true;
            v = nodes[g].a as I64;
            I64 nt = nodes[g].tok as I64;
            I64 hit = import_field(src, toks, decls, row, nt);
            if (hit < 0) {
                resolve.fail(toks, diag, rs, C_NO_PARAM, nt);
                return;
            }
            I64 pos = 0;
            I64 q = decl.next_member(decls, row);
            while (q != hit) { pos += 1; q = decl.next_member(decls, q); }
            Bool twice = pos < npos;
            I64 h = nodes[x].b as I64;
            while (h != g) {
                if (nodes[h].kind == parse.N_NAMEDARG) {
                    I64 ht = nodes[h].tok as I64;
                    if (toks[ht].len == toks[nt].len && resolve.same_text(src, toks[ht].start as I64,
                            toks[nt].start as I64, toks[nt].len as I64)) { twice = true; }
                }
                h = nodes[h].next as I64;
            }
            if (twice) { resolve.fail(toks, diag, rs, C_TWICE, nt); return; }
        } else {
            if (named) { resolve.fail(toks, diag, rs, C_POSITIONAL, first(nodes, g)); return; }
            if (filled >= decls[row].a) {
                resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, first(nodes, x)); return;
            }
            npos += 1;
        }
        if (nodes[v].kind == parse.N_TYPENAME) {
            resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, g)); return;
        }
        filled += 1;
        g = nodes[g].next as I64;
    }
    if (filled != decls[row].a) {
        resolve.fail(toks, diag, rs, C_MISSING_FIELD, first(nodes, x));
    }
}

// The arguments of constructor call x of struct symbol s mapped onto its fields
// (`cint_ref` _bind_args, _constructor): C2069 for a positional argument after a named
// one, C2022 for one too many, C2063 for a name that is no field, C2062 for a field given
// twice, C3007 for a type name, each in written order, then C2020 when a field is missing.
void bind_fields[r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sym[_] syms,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, I64 x, I64 s) {
    I64 st = syms[s].ty;
    I64 nf = 0;
    I64 fd = nodes[syms[s].node].a as I64;
    while (fd >= 0) {
        nf += 1;
        fd = nodes[fd].next as I64;
    }
    I64 filled = 0;
    I64 npos = 0;
    Bool named = false;
    I64 g = nodes[x].b as I64;
    while (g >= 0) {
        I64 v = g;
        if (nodes[g].kind == parse.N_NAMEDARG) {
            named = true;
            v = nodes[g].a as I64;
            I64 nt = nodes[g].tok as I64;
            I64 hit = resolve.field_of(src, toks, nodes, syms, st, nt);
            if (hit < 0) {
                resolve.fail(toks, diag, rs, C_NO_PARAM, nt);
                return;
            }
            // The field's position, and whether an earlier argument filled it.
            I64 pos = 0;
            I64 q = nodes[syms[s].node].a as I64;
            while (q != hit) {
                pos += 1;
                q = nodes[q].next as I64;
            }
            Bool twice = pos < npos;
            I64 h = nodes[x].b as I64;
            while (h != g) {
                if (nodes[h].kind == parse.N_NAMEDARG &&
                        resolve.field_of(src, toks, nodes, syms, st, nodes[h].tok as I64) == hit) {
                    twice = true;
                }
                h = nodes[h].next as I64;
            }
            if (twice) {
                resolve.fail(toks, diag, rs, C_TWICE, nt);
                return;
            }
        } else {
            if (named) {
                resolve.fail(toks, diag, rs, C_POSITIONAL, first(nodes, g));
                return;
            }
            if (filled >= nf) {
                resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, first(nodes, x));
                return;
            }
            npos += 1;
        }
        if (nodes[v].kind == parse.N_TYPENAME) {
            resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, g));
            return;
        }
        filled += 1;
        g = nodes[g].next as I64;
    }
    if (filled != nf) {
        resolve.fail(toks, diag, rs, C_MISSING_FIELD, first(nodes, x));
    }
}
const I64 C_OVERLAP = 5010;

// Compares field paths from their common root. An indexed path still needs the
// runtime overlap check and remains C9102 when this pair could alias (LS-121).
I64 field_overlap(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 a, I64 b) {
    I64 ar = a; I64 br = b; I64 ad = 0; I64 bd = 0;
    Bool indexed = false;
    while (nodes[ar].kind == parse.N_FIELD || nodes[ar].kind == parse.N_INDEX) {
        indexed = indexed || nodes[ar].kind == parse.N_INDEX;
        ar = nodes[ar].a as I64; ad += 1;
    }
    while (nodes[br].kind == parse.N_FIELD || nodes[br].kind == parse.N_INDEX) {
        indexed = indexed || nodes[br].kind == parse.N_INDEX;
        br = nodes[br].a as I64; bd += 1;
    }
    if (nodes[ar].kind != parse.N_NAME || nodes[br].kind != parse.N_NAME || sem[ar].sym != sem[br].sym) {
        return 0;
    }
    if (indexed) { return -1; }
    I64 ax = a; I64 bx = b;
    while (ad > bd) { ax = nodes[ax].a as I64; ad -= 1; }
    while (bd > ad) { bx = nodes[bx].a as I64; bd -= 1; }
    while (ad > 0) {
        if (sem[ax].sym != sem[bx].sym) { return 0; }
        ax = nodes[ax].a as I64; bx = nodes[bx].a as I64; ad -= 1;
    }
    return 1;
}

// C2012 where two views bound to one size parameter have static extents that differ, at
// the later argument (`cint_ref` _static_shapes; SPEC-04 LS-117): each dimension of each
// view parameter that a size parameter gives, against the first that binds it. Arguments
// g0, parameters of function node fn, in order.
void static_shapes[r](in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, I64 fn, I64 g0) {
    I64 p = nodes[fn].b as I64;
    I64 g = g0;
    while (p >= 0 && g >= 0) {
        if (resolve.is_array(sem[p].ty)) {
            for k in 0..resolve.array_rank(sem[p].ty) {
                I64 j = resolve.dim_size(sem[p].ty, k);
                I64 n = -1;
                if (j >= 0) {
                    n = resolve.dim_extent(sem[g].ty, k);
                }
                if (n >= 0) {
                    I64 bound = first_bound(nodes, sem, fn, g0, j, p, k);
                    if (bound >= 0 && bound != n) {
                        resolve.fail(toks, diag, rs, C_SHAPE, first(nodes, g));
                        return;
                    }
                }
            }
        }
        p = nodes[p].next as I64;
        g = nodes[g].next as I64;
    }
}

// The static extent of the argument dimension that binds size parameter j first, before
// dimension k of parameter p: -1 when it is known at run time, -2 when p's is the first.
I64 first_bound(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 fn, I64 g0, I64 j, I64 p, I64 k) {
    I64 q = nodes[fn].b as I64;
    I64 h = g0;
    while (q >= 0 && h >= 0) {
        if (resolve.is_array(sem[q].ty)) {
            for d in 0..resolve.array_rank(sem[q].ty) {
                if (q == p && d == k) {
                    return -2;
                }
                if (resolve.dim_size(sem[q].ty, d) == j) {
                    return resolve.dim_extent(sem[h].ty, d);
                }
            }
        }
        q = nodes[q].next as I64;
        h = nodes[h].next as I64;
    }
    return -2;
}

// Whether ty is an array, a view, or a struct (`cint_ref` is_aggregate).
Bool aggregate(I64 ty) {
    return resolve.is_array(ty) || resolve.is_struct(ty);
}

// C5010 for an `inout` argument that provably overlaps another argument, at the later of
// the two, pairs in `cint_ref`'s order (_static_alias; SPEC-04 LS-121): the places' paths
// overlap, or, where index values or views decide, their views are known at compile time
// and identical or overlapping (SPEC-02 A-5). Other overlaps are checked at entry.
void static_alias[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        in resolve.Sym[_] syms, inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs,
        in CState[_] cs, I64 fn, I64 g0) {
    I64 p = nodes[fn].b as I64;
    I64 g = g0;
    while (p >= 0 && g >= 0) {
        if (aggregate(sem[p].ty)) {
            I64 q = nodes[p].next as I64;
            I64 h = nodes[g].next as I64;
            while (q >= 0 && h >= 0) {
                if (aggregate(sem[q].ty) && (nodes[p].op == scan.KW_INOUT || nodes[q].op == scan.KW_INOUT)) {
                    I64 o = places_overlap(nodes, sem, syms, wk, cs, g, h);
                    if (o == 2) {
                        I64[11] va;
                        I64[11] vb;
                        if (static_view(nodes, sem, syms, wk, cs, g, va) && static_view(nodes, sem, syms, wk, cs, h, vb)) {
                            I64 c = classify(va, vb);
                            if (c == 1 || c == 2) {
                                o = 1;
                            }
                        }
                    }
                    if (o == 1) {
                        resolve.fail(toks, diag, rs, C_OVERLAP, first(nodes, h));
                        return;
                    }
                }
                q = nodes[q].next as I64;
                h = nodes[h].next as I64;
            }
        }
        p = nodes[p].next as I64;
        g = nodes[g].next as I64;
    }
}

// K_EXPECT on frame f: expression node x has type a (`cint_ref` Checker.expect). Box 12: a
// set type takes `.name` and widens a value of a set it holds (expect_set); an error union
// is the result type of the function whose `return` gives x, which is an error of the
// union's set (C2042 when the set does not hold it) or a value of its value type.
void h_expect[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs,
        I64 f) {
    I64 x = wk[f].node as I64;
    if (wk[f].state == 0) {
        wk[f].state = 1;
        if (nodes[x].kind == parse.N_ARRAY) {
            // An array literal takes its type from the array expected (box 09; LS-67).
            if (!resolve.is_array(payload(wk, f))) {
                resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, x));
                return;
            }
            if (push(toks, nodes, wk, diag, rs, cs, K_LITERAL, x, payload(wk, f))) {
                wk[cs[0].sp - 1].c = 0;
                wk[cs[0].sp - 1].d = x as I32;
            }
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, x, 0);
        return;
    }
    I64 t = payload(wk, f);
    I64 got = sem[x].ty;
    if (resolve.is_errunion(t)) {
        if (got == resolve.TY_DOTNAME || resolve.is_errset(got)) {
            if (expect_set(src, toks, nodes, sem, diag, rs, x, resolve.union_set(t), resolve.C_SET_NARROW)) {
                pop(cs);
            }
            return;
        }
        t = resolve.union_value(t);
        if (t == resolve.TY_VOID) {
            resolve.fail(toks, diag, rs, resolve.C_RETURN_VALUE, first(nodes, x));
            return;
        }
    }
    if (resolve.is_errset(t) || resolve.is_errset(got) || got == resolve.TY_DOTNAME) {
        if (!resolve.is_errset(t)) {
            resolve.fail(toks, diag, rs, use_code(sem, x, resolve.C_TYPE_MISMATCH), first(nodes, x));
        } else if (expect_set(src, toks, nodes, sem, diag, rs, x, t, resolve.C_TYPE_MISMATCH)) {
            pop(cs);
        }
        return;
    }
    if (resolve.is_struct(t) || resolve.is_struct(got) || resolve.is_mem(t) || resolve.is_mem(got)) {
        // A struct, or (box 12) an arena, pool or handle: the same type, a literal none.
        if (got != t) {
            resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, x));
            return;
        }
        pop(cs);
        return;
    }
    if (resolve.is_array(t) || resolve.is_array(got)) {
        expect_array(toks, nodes, sem, diag, rs, x, t);
        if (rs[0].err == 0) {
            pop(cs);
        }
        return;
    }
    if (got == resolve.TY_NONE) {
        settle(toks, nodes, sem, wk, diag, rs, cs, x, t);
        if (rs[0].err != 0) {
            return;
        }
    } else if (got != t) {
        resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, x));
        return;
    }
    pop(cs);
}

// ---------------------------------------------------------------- structs

// Task 2.13 part (ii): the module's structs after a successful check, for the declaration
// table (SPEC-09 CINTC-16; the interface of the handoff note
// docs/design/notes/2026-10-03-declaration-table-handoff.md). Layout is SPEC-04 LS-73's: each field at the next multiple of its
// alignment, a scalar's alignment its size, the struct's alignment the largest field
// alignment, and its size rounded up to that alignment. The fields of cint-boot-1 structs
// are laid out after their dependencies, preserving declaration identities.

// The size in bytes of scalar checker type ty, which is also its alignment (LS-73).
export I64 scalar_bytes(I64 ty) {
    if (ty == fold.TY_BOOL) {
        return 1;
    }
    if (resolve.is_errset(ty)) {
        // An error value is its tag, of the set's underlying type (LS-93).
        return fold.ty_width(resolve.errset_under(ty)) / 8;
    }
    return fold.ty_width(ty) / 8;
}

// Records the LS-73 layout of every struct of the module in the Sem rows of its nodes, for
// decl.write_block (compiler/decl.ci, which this module imports): an N_STRUCT node's opty
// is struct_align, its lit_len struct_bytes, and each N_FIELD_DECL node's lit_at its
// field_offset. Threads the dependency walk through existing Sem rows: lit_at is
// the parent, bits the next field plus two (zero new, 0xFFFFFFFFFFFFFFFF done). Each field is
// visited at most twice, so forward declarations and diamonds remain linear.
Bool layout_limit(in scan.Token[_] toks, in parse.Node[_] nodes,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 x) {
    I64 tk = nodes[x].tok as I64;
    resolve.fail_at(diag, rs, limits.C_LIMIT, toks[tk].line as I64, toks[tk].col as I64,
        limits.LIM_RECORD_BYTES, limits.RECORD_BYTES_MAX);
    return false;
}

export Bool record_layout(in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        in resolve.Sym[_] syms, inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 root) {
    I64 item = nodes[root].a as I64;
    while (item >= 0) {
        if (nodes[item].kind == parse.N_STRUCT) { sem[item].bits = 0; }
        item = nodes[item].next as I64;
    }
    item = nodes[root].a as I64;
    while (item >= 0) {
        if (nodes[item].kind == parse.N_STRUCT && sem[item].bits == 0) {
            I64 x = item;
            sem[x].lit_at = -1;
            sem[x].opty = 1;
            sem[x].lit_len = 0;
            sem[x].bits = (nodes[x].a as I64 + 2) as U64;
            while (x >= 0) {
                I64 fd = (sem[x].bits as I64) - 2;
                if (fd < 0) {
                    I64 al = sem[x].opty;
                    I64 pad = (al - sem[x].lit_len % al) % al;
                    if (sem[x].lit_len > limits.RECORD_BYTES_MAX - pad) { return layout_limit(toks, nodes, diag, rs, x); }
                    sem[x].lit_len += pad;
                    sem[x].bits = 0xFFFFFFFFFFFFFFFF;
                    x = sem[x].lit_at;
                    continue;
                }
                I64 ty = sem[fd].ty;
                I64 nelem = 1;
                if (resolve.is_array(ty)) {
                    nelem = resolve.array_extent(ty);
                    ty = resolve.array_elem(ty);
                }
                I64 nbyte = scalar_bytes(ty);
                I64 falign = nbyte;
                if (resolve.is_handle(ty)) {
                    // A handle (box 12; SPEC-03 M-12): its U64 slot, I64 length, U64
                    // generation, U32 container and U8 kind, as cint_handle lays them out.
                    nbyte = HANDLE_BYTES;
                    falign = 8;
                }
                if (resolve.is_struct(ty)) {
                    I64 child = resolve.struct_node(syms, ty);
                    if (child >= 0 && sem[child].bits == 0) {
                        sem[child].lit_at = x;
                        sem[child].opty = 1;
                        sem[child].lit_len = 0;
                        sem[child].bits = (nodes[child].a as I64 + 2) as U64;
                        x = child;
                        continue;
                    }
                    if (child >= 0) {
                        falign = sem[child].opty;
                        nbyte = sem[child].lit_len;
                    } else {
                        falign = sem[fd].opty;
                        nbyte = sem[fd].lit_len;
                    }
                }
                I64 pad = (falign - sem[x].lit_len % falign) % falign;
                if (sem[x].lit_len > limits.RECORD_BYTES_MAX - pad ||
                        (nelem > 0 && nbyte > limits.RECORD_BYTES_MAX / nelem)) {
                    return layout_limit(toks, nodes, diag, rs, x);
                }
                I64 at = sem[x].lit_len + pad;
                I64 field_bytes = nbyte * nelem;
                if (at > limits.RECORD_BYTES_MAX - field_bytes) { return layout_limit(toks, nodes, diag, rs, x); }
                sem[fd].lit_at = at;
                sem[x].lit_len = at + field_bytes;
                if (falign > sem[x].opty) { sem[x].opty = falign; }
                sem[x].bits = (nodes[fd].next as I64 + 2) as U64;
            }
        }
        item = nodes[item].next as I64;
    }
    return true;
}

// The tag of a struct type in a Decl row.
export const I64 DECL_STRUCT_TAG = 0x71;

// The bytes of a handle in a struct (record_layout; rt/cint_rt.h cint_handle).
export const I64 HANDLE_BYTES = 32;

// The reverse of decl.persist for a row of an imported block: the checker type of tag,
// rank, ext_kind and extent ext, where a struct (tag 0x71) is struct_ty, the checker type the
// importer bound to the struct's row `ref`; 0 for a row this checker cannot type (C9102 to
// the caller).
export I64 import_type(I64 tag, I64 rank, I64 ext_kind, I64 ext, I64 struct_ty) {
    if (rank == 0) {
        if (tag == DECL_STRUCT_TAG) {
            return struct_ty;
        }
        if (tag == 0x02) {
            return resolve.TY_VOID;
        }
        if (tag == fold.TY_BOOL || resolve.is_int(tag)) {
            return tag;
        }
        return 0;
    }
    I64 elem = tag;
    if (tag == DECL_STRUCT_TAG && resolve.is_struct(struct_ty)) {
        I64 sym = struct_ty - resolve.TY_STRUCT;
        if (sym >= resolve.ELEM_STRUCT_MAX) { return 0; }
        elem = resolve.ELEM_STRUCT + sym;
    } else if (!(tag == fold.TY_BOOL || resolve.is_int(tag))) {
        return 0;
    }
    if (rank != 1) {
        return 0;
    }
    if (ext_kind == limits.DX_LITERAL as I64 && ext >= 0 && ext <= resolve.ARRAY_EXTENT_MAX) {
        return resolve.TY_ARRAY + (ext + 1) * 65536 + elem;
    }
    if (ext_kind == limits.DX_SIZE as I64 && ext >= 0) {
        return resolve.TY_ARRAY + (resolve.SIZE_CODE + ext) * 65536 + elem;
    }
    if (ext_kind == limits.DX_WILD as I64) {
        return resolve.TY_ARRAY + elem;
    }
    return 0;
}

// ---------------------------------------------------------------- arrays and views

// Task 2.13 part (b): the typing of local arrays, view parameters, and indexing
// (`cint_ref` _infer_Index, expect_array; SPEC-04 LS-62 to LS-67, LS-117, LS-119). The
// array types are resolve.ci's (TY_ARRAY).

const I64 C_SHAPE = 2012;
// Box 09: C2010, a partial index indexed directly (SPEC-04 LS-65); C2011, an array literal
// whose item count differs from its extent (LS-67); C2014, `len` of an array of rank above
// 1 (LS-145); C2053, a `by` step that is not a nonzero constant (LS-161).
const I64 C_PARTIAL_INDEXED = 2010;
const I64 C_LITERAL_COUNT = 2011;
const I64 C_LEN_RANK = 2014;
const I64 C_STEP = 2053;

// The number of nodes in the list from node g.
I64 list_length(in parse.Node[_] nodes, I64 g) {
    I64 n = 0;
    I64 x = g;
    while (x >= 0) {
        n += 1;
        x = nodes[x].next as I64;
    }
    return n;
}

// Settles untyped expression x to I64, or C2001 at x when its type is another (`cint_ref`'s
// pattern for extents, indices, slice bounds and steps). False after an error.
Bool settle_i64[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 x) {
    if (sem[x].ty == resolve.TY_NONE) {
        settle(toks, nodes, sem, wk, diag, rs, cs, x, fold.TY_I64);
    } else if (sem[x].ty != fold.TY_I64) {
        resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, x));
    }
    return rs[0].err == 0;
}

// K_INFER on index node x (`cint_ref` _infer_Index and _slice; SPEC-04 LS-64, LS-65,
// LS-161): the base is an array or a view (C2103 at the `[`, C2010 there when the base is a
// partial index), with at most one item per dimension (more is C9102), each an I64 index
// or a slice: I64 bounds and a nonzero constant `by` step (C2053), whose constant bounds
// are folded, low then high, up to the first that is not constant. An index of every
// dimension gives the element; fewer, or a slice, give a view (SEM_VIEW; SEM_PARTIAL
// without a slice) of the base's storage, of the slices' dimensions then the remaining
// ones, outside a kernel (C9102 there). A slice's Sem row holds its step in bits and the
// extent code of its dimension in lit_at. Frame: b the item, c its dimension, d the stage
// of a slice item.
void h_index[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 step = wk[f].state as I64 - 1;
    I64 a = nodes[x].a as I64;
    I64 at = tok_of(nodes, x);
    if (step == 0) {
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
        return;
    }
    I64 t = sem[a].ty;
    if ((sem[x].flags & resolve.SEM_DEREF) != 0) {
        // The handle checked: a pool's slot, or an arena allocation's rank-1 view.
        if (resolve.mem_kind(t) == resolve.MK_ARENA) {
            sem[x].ty = resolve.TY_ARRAY + resolve.mem_code(t);
            sem[x].flags = sem[x].flags | resolve.SEM_VIEW;
        } else {
            sem[x].ty = resolve.mem_elem(t);
        }
        pop(cs);
        return;
    }
    if (step == 1 && resolve.is_mem(t) && !resolve.is_handle(t)) {
        // `p[h]` or `a[h]` (box 12; `cint_ref` _deref): one handle of the arena's or pool's
        // kind, checked at the `[` when it runs (SPEC-03 M-17). Not in a kernel body, and not
        // with other than one handle, which `cint_ref` refuses.
        I64 item = nodes[x].b as I64;
        if (rs[0].ctx == resolve.CTX_KERNEL || item < 0 || nodes[item].next >= 0 ||
                nodes[item].kind == parse.N_SLICE) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
            return;
        }
        sem[x].flags = sem[x].flags | resolve.SEM_DEREF;
        _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, item, resolve.handle_of(t));
        return;
    }
    if (step == 1) {
        if (nodes[a].kind == parse.N_INDEX && (sem[a].flags & resolve.SEM_PARTIAL) != 0) {
            resolve.fail(toks, diag, rs, C_PARTIAL_INDEXED, at);
            return;
        }
        if (!resolve.is_array(t)) {
            resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, at);
            return;
        }
        if (list_length(nodes, nodes[x].b as I64) > resolve.array_rank(t)) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
            return;
        }
        wk[f].b = nodes[x].b;
        wk[f].c = 0;
        wk[f].d = 0;
    }
    I64 g = wk[f].b as I64;
    while (g >= 0) {
        I64 stage = wk[f].d as I64;
        if (nodes[g].kind != parse.N_SLICE) {
            if (stage == 0) {
                wk[f].d = 1;
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, g, 0);
                return;
            }
            if (!settle_i64(toks, nodes, sem, wk, diag, rs, cs, g)) {
                return;
            }
        } else {
            I64 lo = nodes[g].a as I64;
            I64 hi = nodes[g].b as I64;
            I64 stp = nodes[g].c as I64;
            // Stages: 1 and 3 the bounds inferred, 5 the step inferred, 6 the step folded,
            // 7 and 8 the bounds folded.
            if (stage == 0) {
                sem[g].bits = 1;
                sem[g].lit_at = 0;
                wk[f].d = 1;
                if (lo >= 0) {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, lo, 0);
                    return;
                }
                stage = 1;
            }
            if (stage == 1) {
                if (lo >= 0 && !settle_i64(toks, nodes, sem, wk, diag, rs, cs, lo)) {
                    return;
                }
                wk[f].d = 3;
                if (hi >= 0) {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, hi, 0);
                    return;
                }
                stage = 3;
            }
            if (stage == 3) {
                if (hi >= 0 && !settle_i64(toks, nodes, sem, wk, diag, rs, cs, hi)) {
                    return;
                }
                wk[f].d = 5;
                if (stp >= 0) {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, stp, 0);
                    return;
                }
                stage = 7;
                wk[f].d = 7;
            }
            if (stage == 5) {
                if (!settle_i64(toks, nodes, sem, wk, diag, rs, cs, stp)) {
                    return;
                }
                if (!is_const(sem, stp)) {
                    resolve.fail(toks, diag, rs, C_STEP, first(nodes, stp));
                    return;
                }
                wk[f].d = 6;
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, stp, 0);
                return;
            }
            if (stage == 6) {
                if (sem[stp].bits == 0) {
                    resolve.fail(toks, diag, rs, C_STEP, first(nodes, stp));
                    return;
                }
                sem[g].bits = sem[stp].bits;
                stage = 7;
                wk[f].d = 7;
            }
            if (stage == 7) {
                wk[f].d = 8;
                if (lo >= 0 && is_const(sem, lo)) {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, lo, 0);
                    return;
                }
                stage = 8;
            }
            if (stage == 8) {
                Bool known = lo < 0 || is_const(sem, lo);
                if (known && hi >= 0 && is_const(sem, hi) && (sem[hi].flags & resolve.SEM_FOLDED) == 0) {
                    wk[f].d = 9;
                    _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, hi, 0);
                    return;
                }
            }
            sem[g].lit_at = slice_code(nodes, sem, g, resolve.dim_extent(t, wk[f].c as I64));
        }
        g = nodes[g].next as I64;
        wk[f].b = g as I32;
        wk[f].c += 1;
        wk[f].d = 0;
    }
    I64 n = list_length(nodes, nodes[x].b as I64);
    I64 rank = resolve.array_rank(t);
    I64 slices = 0;
    I64[4] code;
    for k in 0..4 {
        code[k] = 0;
    }
    I64 item = nodes[x].b as I64;
    while (item >= 0) {
        if (nodes[item].kind == parse.N_SLICE) {
            code[slices] = sem[item].lit_at;
            slices += 1;
        }
        item = nodes[item].next as I64;
    }
    if (n == rank && slices == 0) {
        sem[x].ty = resolve.array_elem(t);
        pop(cs);
        return;
    }
    if (rs[0].ctx == resolve.CTX_KERNEL) {
        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
        return;
    }
    I64 vr = slices;
    for k in n..rank {
        code[vr] = resolve.dim_code(t, k);
        vr += 1;
    }
    sem[x].ty = resolve.shaped(resolve.elem_code(t), vr, code[0], code[1], code[2], code[3]);
    if (sem[x].ty == 0) {
        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, at);
        return;
    }
    sem[x].flags = sem[x].flags | resolve.SEM_VIEW;
    if (slices == 0) {
        sem[x].flags = sem[x].flags | resolve.SEM_PARTIAL;
    }
    pop(cs);
}

// The extent code (resolve.dim_code's form) of the dimension that slice g gives over a
// dimension of static extent `extent` (-1 when known at run time): its length when the
// extent and every written bound are constant and the slice is valid (`views.slice_dim`),
// else 0 (known at run time). The step is sem[g].bits.
I64 slice_code(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 g, I64 ext) {
    I64 lo = nodes[g].a as I64;
    I64 hi = nodes[g].b as I64;
    if (ext < 0 || (lo >= 0 && !is_const(sem, lo)) || (hi >= 0 && !is_const(sem, hi))) {
        return 0;
    }
    I64 lv = 0;
    if (lo >= 0) {
        lv = sem[lo].bits as% I64;
    }
    I64 hv = 0;
    if (hi >= 0) {
        hv = sem[hi].bits as% I64;
    }
    I64[2] got;
    if (!slice_dim(ext, lo >= 0, lv, hi >= 0, hv, nodes[g].op == scan.OP_RANGE_INCL, sem[g].bits as% I64, got)) {
        return 0;
    }
    return got[1] + 1;
}

// ceil(m / k) for m >= 0 and k >= 1, without overflow.
I64 ceil_div(I64 m, I64 k) {
    if (m == 0) {
        return 0;
    }
    return (m - 1) / k + 1;
}

// One slice item over a dimension of `extent` elements, 0 <= extent < 2^62 (`views.slice_dim`;
// box 09 rulings R2, R3): bounds lo and hi where written (has_lo, has_hi), `..=` when
// inclusive, a nonzero step. Whether it is valid; got[0] the first index and got[1] the
// length. Exact for any I64 bounds and step: no comparison forms a sum that can overflow.
Bool slice_dim(I64 ext, Bool has_lo, I64 lo_in, Bool has_hi, I64 hi_in, Bool inclusive, I64 step,
        inout I64[_] got) {
    got[1] = 0;
    if (step > 0) {
        I64 lo = 0;
        if (has_lo) { lo = lo_in; }
        I64 hi = ext;
        if (has_hi) { hi = hi_in; }
        got[0] = lo;
        // 0 <= lo <= end <= extent, where end is hi + 1 for `..=`.
        Bool valid = lo >= 0 && hi <= ext && (lo <= hi || (inclusive && lo - 1 == hi));
        if (inclusive && hi == ext) {
            valid = false;
        }
        if (!valid) {
            return false;
        }
        I64 end = hi;
        if (inclusive) {
            end = hi + 1;
        }
        got[1] = ceil_div(end - lo, step);
        return true;
    }
    // k = -step; for I64.min any k above every length gives the same quotients.
    I64 k = I64_MAX;
    if (step != I64_MIN) {
        k = 0 - step;
    }
    I64 head = ext - 1;
    if (has_lo) { head = lo_in; }
    got[0] = head;
    if (inclusive) {
        I64 last = 0;
        if (has_hi) { last = hi_in; }
        // 0 <= last <= first + 1 <= extent.
        if (!(last >= 0 && head < ext && (last <= head || last - 1 == head))) {
            return false;
        }
        if (head >= last) {
            got[1] = ceil_div(head - last + 1, k);
        }
        return true;
    }
    I64 last = -1;
    if (has_hi) { last = hi_in; }
    // -1 <= last <= first <= extent - 1.
    if (!(last >= -1 && last <= head && head < ext)) {
        return false;
    }
    got[1] = ceil_div(head - last, k);
    return true;
}

// Whether x is an index node whose chain of bases holds only index nodes down to a name
// (`m[1][2]`, `a[1..3][0]`): a place of the named variable (`cint_ref` _place).
Bool index_chain(in parse.Node[_] nodes, I64 x) {
    I64 r = x;
    while (nodes[r].kind == parse.N_INDEX) {
        r = nodes[r].a as I64;
    }
    return r != x && nodes[r].kind == parse.N_NAME;
}

// The N_NAME node at the root of the chain of index and field nodes from x when the chain
// holds a field, or -1.
I64 chain_root(in parse.Node[_] nodes, I64 x) {
    I64 r = x;
    Bool field = false;
    while (nodes[r].kind == parse.N_INDEX || nodes[r].kind == parse.N_FIELD) {
        field = field || nodes[r].kind == parse.N_FIELD;
        r = nodes[r].a as I64;
    }
    if (field && nodes[r].kind == parse.N_NAME) {
        return r;
    }
    return -1;
}

// Accepts field/index chains rooted in a variable; inference checks each edge.
Bool record_place(in parse.Node[_] nodes, I64 x) {
    if (nodes[x].kind != parse.N_FIELD) { return false; }
    I64 base = x;
    while (nodes[base].kind == parse.N_FIELD || nodes[base].kind == parse.N_INDEX) {
        base = nodes[base].a as I64;
    }
    return nodes[base].kind == parse.N_NAME;
}

// Whether index node x is `v.f[i]` with v a name: an element of an array field (task 2.14).
Bool field_element(in parse.Node[_] nodes, I64 x) {
    I64 b = nodes[x].a as I64;
    return nodes[b].kind == parse.N_FIELD && record_place(nodes, b);
}

// Whether field node x is `v[i].f` with v a name: a field of a struct element (task 2.14).
Bool element_field(in parse.Node[_] nodes, I64 x) {
    I64 b = nodes[x].a as I64;
    return nodes[b].kind == parse.N_INDEX && nodes[nodes[b].a as I64].kind == parse.N_NAME;
}

// Expression x, already inferred, where an array of type t is expected, or an array where
// the scalar t is expected (`cint_ref` expect_array): C2001 for a scalar, another element
// type or another rank, C2012 at the first dimension whose two static extents differ.
void expect_array[r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, I64 x, I64 t) {
    I64 got = sem[x].ty;
    if (!resolve.is_array(t) || !resolve.is_array(got) || resolve.array_elem(t) != resolve.array_elem(got) ||
            resolve.array_rank(t) != resolve.array_rank(got)) {
        resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, x));
        return;
    }
    for d in 0..resolve.array_rank(t) {
        I64 n = resolve.dim_extent(got, d);
        I64 m = resolve.dim_extent(t, d);
        if (n >= 0 && m >= 0 && n != m) {
            resolve.fail(toks, diag, rs, C_SHAPE, first(nodes, x));
            return;
        }
    }
}

// The item count of the first array literal at depth k of literal root (-1 before one),
// kept in the root's Sem row while K_LITERAL runs.
I64 literal_count(in resolve.Sem[_] sem, I64 root, I64 k) {
    switch (k) {
        case 0: return sem[root].lit_at;
        case 1: return sem[root].lit_len;
        case 2: return sem[root].opty;
        default: return sem[root].sym;
    }
}

void set_literal_count(inout resolve.Sem[_] sem, I64 root, I64 k, I64 n) {
    switch (k) {
        case 0: sem[root].lit_at = n;
        case 1: sem[root].lit_len = n;
        case 2: sem[root].opty = n;
        default: sem[root].sym = n;
    }
}

// K_LITERAL on frame f: array literal x at depth c of the literal d where an array of type a
// is expected (`cint_ref` _array_lit; SPEC-04 LS-67): one item per index of its dimension,
// a nested literal for each further dimension (C2001 at another item), the elements
// expected to have the element type. An item count that differs from the dimension's
// static extent, or from the count of the first literal at the same depth, is C2011 at
// the literal, checked depth first. The root gets the type of static extents, the counts
// where the expected type has none (C9102 for an inner extent no item gives, as `cint_ref`
// refuses it). Frame b: the next item.
void h_literal[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 t = payload(wk, f);
    I64 k = wk[f].c as I64;
    I64 root = wk[f].d as I64;
    I64 rank = resolve.array_rank(t);
    if (wk[f].state == 0) {
        wk[f].state = 1;
        if (x == root) {
            for j in 0..4 {
                set_literal_count(sem, root, j, -1);
            }
        }
        I64 n = list_length(nodes, nodes[x].a as I64);
        I64 want = resolve.dim_extent(t, k);
        if (want < 0) {
            want = literal_count(sem, root, k);
        }
        if (want >= 0 && n != want) {
            resolve.fail(toks, diag, rs, C_LITERAL_COUNT, first(nodes, x));
            return;
        }
        set_literal_count(sem, root, k, n);
        wk[f].b = nodes[x].a;
    }
    I64 g = wk[f].b as I64;
    if (g >= 0) {
        wk[f].b = nodes[g].next;
        if (k + 1 < rank) {
            if (nodes[g].kind != parse.N_ARRAY) {
                resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, g));
                return;
            }
            if (push(toks, nodes, wk, diag, rs, cs, K_LITERAL, g, t)) {
                wk[cs[0].sp - 1].c = (k + 1) as I32;
                wk[cs[0].sp - 1].d = root as I32;
            }
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, g, resolve.array_elem(t));
        return;
    }
    if (x == root) {
        I64[4] code;
        for j in 0..4 {
            code[j] = 0;
            if (j < rank) {
                I64 n = literal_count(sem, root, j);
                if (n < 0) {
                    n = resolve.dim_extent(t, j);
                }
                if (n < 0 || (rank > 1 && n > resolve.NARRAY_EXTENT_MAX) || n > resolve.ARRAY_EXTENT_MAX) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, x));
                    return;
                }
                code[j] = n + 1;
            }
        }
        sem[root].lit_at = -1;
        sem[root].lit_len = 0;
        sem[root].opty = 0;
        sem[root].sym = -1;
        sem[root].ty = resolve.shaped(resolve.elem_code(t), rank, code[0], code[1], code[2], code[3]);
    }
    pop(cs);
}

// ---------------------------------------------------------------- places (box 09)
//
// The storage an array expression designates, for the permission (C2067) and aliasing
// (C5010) rules of SPEC-04 LS-70, LS-119, LS-121 and LS-162: `cint_ref` place_root,
// _writable_place, place_path, overlap, static_view and views.classify (SPEC-02 A-5).

// Whether call x is a view function (`transpose`, `reverse`) whose first argument it views.
Bool view_call(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 x) {
    return nodes[x].kind == parse.N_CALL && (sem[x].flags & resolve.SEM_ARRAYFN) != 0 &&
        (sem[x].lit_at == resolve.AF_TRANSPOSE || sem[x].lit_at == resolve.AF_REVERSE);
}

// The root of place x (`cint_ref` place_root): the N_NAME of a variable, parameter, size
// parameter, loop variable, view variable or (box 12) module-level arena or pool below its
// fields, indexes and view functions, the node `alias.x` of an imported module variable, or
// -1.
I64 place_root(in parse.Node[_] nodes, in resolve.Sem[_] sem, in resolve.Sym[_] syms, in limits.Decl[_] decls,
        I64 x) {
    I64 e = x;
    while (true) {
        I32 k = nodes[e].kind;
        if (k == parse.N_FIELD && (sem[e].flags & resolve.SEM_IMPORT) != 0) {
            if (decls[sem[e].lit_at].kind == limits.DK_VAR) {
                return e;
            }
            return -1;
        }
        if (k == parse.N_FIELD || k == parse.N_INDEX) {
            e = nodes[e].a as I64;
        } else if (view_call(nodes, sem, e)) {
            e = nodes[e].b as I64;
        } else {
            break;
        }
    }
    if (nodes[e].kind != parse.N_NAME || sem[e].sym < 0) {
        return -1;
    }
    I64 k = syms[sem[e].sym].kind;
    if (k == resolve.SK_VAR || k == resolve.SK_PARAM || k == resolve.SK_MODVAR || k == resolve.SK_LOOPVAR ||
            k == resolve.SK_VIEW || k == resolve.SK_MEMORY) {
        return e;
    }
    return -1;
}

// Whether place x may be written (`cint_ref` _writable_place; SPEC-04 LS-119, LS-162): it is
// rooted at a variable, a module variable, an `inout` parameter (a kernel's `out` too), an
// `inout` view variable or (box 12) a module-level arena or pool.
Bool writable_view(in parse.Node[_] nodes, in resolve.Sem[_] sem, in resolve.Sym[_] syms, in limits.Decl[_] decls,
        I64 x) {
    I64 root = place_root(nodes, sem, syms, decls, x);
    if (root < 0) {
        return false;
    }
    if (nodes[root].kind == parse.N_FIELD) {
        return true;
    }
    I64 sy = sem[root].sym;
    I64 k = syms[sy].kind;
    if (k == resolve.SK_PARAM) {
        return syms[sy].node >= 0 && nodes[syms[sy].node].kind == parse.N_PARAM &&
            (syms[sy].flags & (resolve.SF_INOUT | resolve.SF_OUT)) != 0;
    }
    if (k == resolve.SK_VIEW) {
        return (syms[sy].flags & resolve.SF_INOUT) != 0;
    }
    return k == resolve.SK_VAR || k == resolve.SK_MODVAR || k == resolve.SK_MEMORY;
}

// Path segment kinds (`cint_ref` place_path): a field, an element, a view.
const I64 SEG_FIELD = 1;
const I64 SEG_INDEX = 2;
const I64 SEG_VIEW = 3;

// The path of place x (`cint_ref` place_path), its segments from the root outward in work
// rows at..at + n (task the kind, node the field or index node): n, or -1 when x is no
// place of a variable, parameter or module variable. root[0] gets the root's symbol, or
// -2 - row for an imported module variable. A segment after a view is unknown, so a view
// drops what follows it, and a view variable is its base's path then a view.
I64 place_path[s](in parse.Node[_] nodes, in resolve.Sem[_] sem, in resolve.Sym[_] syms, inout parse.Frame[s] wk,
        I64 at, I64 x, inout I64[_] root) {
    I64 n = 0;
    I64 e = x;
    while (true) {
        I32 k = nodes[e].kind;
        I64 seg = 0;
        if (k == parse.N_FIELD && (sem[e].flags & resolve.SEM_IMPORT) == 0) {
            seg = SEG_FIELD;
        } else if (k == parse.N_INDEX && (sem[e].flags & resolve.SEM_VIEW) == 0) {
            seg = SEG_INDEX;
        } else if (k == parse.N_INDEX || view_call(nodes, sem, e)) {
            n = 0;
            seg = SEG_VIEW;
        } else if (k == parse.N_NAME && sem[e].sym >= 0 && syms[sem[e].sym].kind == resolve.SK_VIEW) {
            n = 0;
            seg = SEG_VIEW;
        } else {
            break;
        }
        if (at + n >= s) {
            return -1;
        }
        wk[at + n].kind = seg as I32;
        wk[at + n].node = e as I32;
        n += 1;
        if (k == parse.N_CALL) {
            e = nodes[e].b as I64;
        } else if (k == parse.N_NAME) {
            e = nodes[syms[sem[e].sym].node].b as I64;
        } else {
            e = nodes[e].a as I64;
        }
    }
    if (nodes[e].kind == parse.N_FIELD && (sem[e].flags & resolve.SEM_IMPORT) != 0) {
        root[0] = -2 - sem[e].lit_at;
    } else if (nodes[e].kind == parse.N_NAME && sem[e].sym >= 0 && (syms[sem[e].sym].kind == resolve.SK_VAR ||
            syms[sem[e].sym].kind == resolve.SK_MODVAR || (syms[sem[e].sym].kind == resolve.SK_PARAM &&
            syms[sem[e].sym].node >= 0 && nodes[syms[sem[e].sym].node].kind == parse.N_PARAM))) {
        root[0] = sem[e].sym;
    } else {
        return -1;
    }
    I64 i = at;
    I64 j = at + n - 1;
    while (i < j) {
        I64 tk = wk[i].kind as I64;
        I64 tn = wk[i].node as I64;
        wk[i].kind = wk[j].kind;
        wk[i].node = wk[j].node;
        wk[j].kind = tk as I32;
        wk[j].node = tn as I32;
        i += 1;
        j -= 1;
    }
    return n;
}

// Whether the folded value of index item x is known: SEM_FOLDED.
Bool folded(in resolve.Sem[_] sem, I64 x) {
    return (sem[x].flags & resolve.SEM_FOLDED) != 0;
}

// Whether places a and b overlap (`cint_ref` overlap): 0 disjoint, 1 provably, 2 unknown
// (index values or a view decide at run time). The work rows above the stack are scratch.
I64 places_overlap[s](in parse.Node[_] nodes, in resolve.Sem[_] sem, in resolve.Sym[_] syms, inout parse.Frame[s] wk,
        in CState[_] cs, I64 a, I64 b) {
    I64[1] ra;
    I64[1] rb;
    I64 pa = cs[0].sp;
    I64 na = place_path(nodes, sem, syms, wk, pa, a, ra);
    if (na < 0) {
        return 0;
    }
    I64 pb = pa + na;
    I64 nb = place_path(nodes, sem, syms, wk, pb, b, rb);
    if (nb < 0 || ra[0] != rb[0]) {
        return 0;
    }
    Bool unknown = false;
    I64 n = na;
    if (nb < n) {
        n = nb;
    }
    for j in 0..n {
        I64 ka = wk[pa + j].kind as I64;
        I64 kb = wk[pb + j].kind as I64;
        I64 xa = wk[pa + j].node as I64;
        I64 xb = wk[pb + j].node as I64;
        if (ka == SEG_VIEW || kb == SEG_VIEW) {
            return 2;
        }
        if (ka != kb) {
            return 0;
        }
        if (ka == SEG_FIELD && sem[xa].sym != sem[xb].sym) {
            return 0;
        }
        if (ka == SEG_INDEX) {
            I64 ia = nodes[xa].b as I64;
            I64 ib = nodes[xb].b as I64;
            while (ia >= 0 && ib >= 0) {
                if (folded(sem, ia) && folded(sem, ib) && sem[ia].bits != sem[ib].bits) {
                    return 0;
                }
                ia = nodes[ia].next as I64;
                ib = nodes[ib].next as I64;
            }
            ia = nodes[xa].b as I64;
            while (ia >= 0) {
                unknown = unknown || !folded(sem, ia);
                ia = nodes[ia].next as I64;
            }
            ib = nodes[xb].b as I64;
            while (ib >= 0) {
                unknown = unknown || !folded(sem, ib);
                ib = nodes[ib].next as I64;
            }
        }
    }
    for j in n..na {
        if (wk[pa + j].kind as I64 == SEG_VIEW) {
            return 2;
        }
    }
    for j in n..nb {
        if (wk[pb + j].kind as I64 == SEG_VIEW) {
            return 2;
        }
    }
    if (unknown) {
        return 2;
    }
    return 1;
}

// a * b and a + b, saturated to I64.
I64 sat_mul(I64 a, I64 b) {
    if (a == 0 || b == 0) {
        return 0;
    }
    Bool negative = (a < 0) != (b < 0);
    if (a == I64_MIN || b == I64_MIN) {
        if (negative) { return I64_MIN; }
        return I64_MAX;
    }
    I64 ma = a;
    if (ma < 0) { ma = 0 - ma; }
    I64 mb = b;
    if (mb < 0) { mb = 0 - mb; }
    if (ma > I64_MAX / mb) {
        if (negative) { return I64_MIN; }
        return I64_MAX;
    }
    return a * b;
}

I64 sat_add(I64 a, I64 b) {
    if (b > 0 && a > I64_MAX - b) {
        return I64_MAX;
    }
    if (b < 0 && a < I64_MIN - b) {
        return I64_MIN;
    }
    return a + b;
}

// The view descriptor of array expression x when it is known at compile time (`cint_ref`
// static_view; SPEC-02 A-5, A-8): an owned variable of static shape, then constant indices,
// slices with constant bounds and the view functions. v[0] the buffer (the variable's
// symbol), v[1] the origin, v[2] the rank, v[3..7) the extents, v[7..11) the strides, in
// elements. Whether it is known; the work rows above the stack are scratch.
Bool static_view[s](in parse.Node[_] nodes, in resolve.Sem[_] sem, in resolve.Sym[_] syms, inout parse.Frame[s] wk,
        in CState[_] cs, I64 x, inout I64[_] v) {
    I64 at = cs[0].sp;
    I64 n = 0;
    I64 e = x;
    while (nodes[e].kind != parse.N_NAME) {
        if (at + n >= s) {
            return false;
        }
        if (nodes[e].kind == parse.N_INDEX && (sem[e].flags & resolve.SEM_VIEW) != 0) {
            wk[at + n].node = e as I32;
            e = nodes[e].a as I64;
        } else if (view_call(nodes, sem, e)) {
            wk[at + n].node = e as I32;
            e = nodes[e].b as I64;
        } else {
            return false;
        }
        n += 1;
    }
    I64 sy = sem[e].sym;
    if (sy < 0 || (syms[sy].kind != resolve.SK_VAR && syms[sy].kind != resolve.SK_MODVAR) ||
            !resolve.is_array(syms[sy].ty)) {
        return false;
    }
    I64 ty = syms[sy].ty;
    I64 rank = resolve.array_rank(ty);
    v[0] = sy;
    v[1] = 0;
    v[2] = rank;
    for k in 0..4 {
        v[3 + k] = 0;
        v[7 + k] = 0;
    }
    I64 stride = 1;
    I64 d = rank - 1;
    while (d >= 0) {
        I64 ext = resolve.dim_extent(ty, d);
        if (ext < 0) {
            return false;
        }
        v[3 + d] = ext;
        v[7 + d] = stride;
        stride = stride * ext;
        d -= 1;
    }
    I64 j = n - 1;
    while (j >= 0) {
        I64 y = wk[at + j].node as I64;
        j -= 1;
        if (nodes[y].kind == parse.N_CALL) {
            if (sem[y].lit_at == resolve.AF_TRANSPOSE) {
                I64 t = v[3];
                v[3] = v[4];
                v[4] = t;
                t = v[7];
                v[7] = v[8];
                v[8] = t;
            } else {
                I64 dn = nodes[nodes[y].b as I64].next as I64;
                if (dn < 0 || !folded(sem, dn)) {
                    return false;
                }
                I64 dd = sem[dn].bits as% I64;
                if (dd < 0 || dd >= v[2]) {
                    return false;
                }
                if (v[3 + dd] > 0) {
                    v[1] = sat_add(v[1], sat_mul(v[7 + dd], v[3 + dd] - 1));
                }
                v[7 + dd] = 0 - v[7 + dd];
            }
            continue;
        }
        I64[4] ns;
        I64[4] nt;
        I64 r = 0;
        I64 k = 0;
        I64 item = nodes[y].b as I64;
        while (item >= 0) {
            if (nodes[item].kind == parse.N_SLICE) {
                I64 lo = nodes[item].a as I64;
                I64 hi = nodes[item].b as I64;
                if ((lo >= 0 && !folded(sem, lo)) || (hi >= 0 && !folded(sem, hi))) {
                    return false;
                }
                I64 lv = 0;
                if (lo >= 0) {
                    lv = sem[lo].bits as% I64;
                }
                I64 hv = 0;
                if (hi >= 0) {
                    hv = sem[hi].bits as% I64;
                }
                I64[2] got;
                I64 step = sem[item].bits as% I64;
                if (!slice_dim(v[3 + k], lo >= 0, lv, hi >= 0, hv, nodes[item].op == scan.OP_RANGE_INCL, step, got)) {
                    return false;
                }
                v[1] = sat_add(v[1], sat_mul(got[0], v[7 + k]));
                ns[r] = got[1];
                nt[r] = sat_mul(v[7 + k], step);
                r += 1;
            } else {
                if (!folded(sem, item)) {
                    return false;
                }
                I64 c = sem[item].bits as% I64;
                if (c < 0 || c >= v[3 + k]) {
                    return false;
                }
                v[1] = sat_add(v[1], sat_mul(c, v[7 + k]));
            }
            k += 1;
            item = nodes[item].next as I64;
        }
        for q in k..v[2] {
            ns[r] = v[3 + q];
            nt[r] = v[7 + q];
            r += 1;
        }
        for q in 0..4 {
            v[3 + q] = 0;
            v[7 + q] = 0;
            if (q < r) {
                v[3 + q] = ns[q];
                v[7 + q] = nt[q];
            }
        }
        v[2] = r;
    }
    return true;
}

// The decision of SPEC-02 A-5 for two views known at compile time (`views.classify`): 0
// disjoint (T0 to T2), 1 identical (T3), 2 overlap (T4), 3 uncertain.
I64 classify(in I64[_] p, in I64[_] q) {
    I64 np = 1;
    I64 nq = 1;
    for k in 0..4 {
        if (k < p[2]) { np = np * p[3 + k]; }
        if (k < q[2]) { nq = nq * q[3 + k]; }
    }
    if (np == 0 || nq == 0 || p[0] != q[0]) {
        return 0;
    }
    I64 plo = p[1];
    I64 phi = p[1];
    I64 qlo = q[1];
    I64 qhi = q[1];
    I64 g = 0;
    for k in 0..4 {
        if (k < p[2] && p[3 + k] > 1) {
            I64 span = sat_mul(p[7 + k], p[3 + k] - 1);
            if (span < 0) { plo = sat_add(plo, span); } else { phi = sat_add(phi, span); }
            g = gcd(g, p[7 + k]);
        }
        if (k < q[2] && q[3 + k] > 1) {
            I64 span = sat_mul(q[7 + k], q[3 + k] - 1);
            if (span < 0) { qlo = sat_add(qlo, span); } else { qhi = sat_add(qhi, span); }
            g = gcd(g, q[7 + k]);
        }
    }
    if (phi < qlo || qhi < plo) {
        return 0;
    }
    if (g >= 2 && residue(p[1], g) != residue(q[1], g)) {
        return 0;
    }
    Bool same = p[1] == q[1] && p[2] == q[2];
    for k in 0..4 {
        same = same && p[3 + k] == q[3 + k] && p[7 + k] == q[7 + k];
    }
    if (same) {
        return 1;
    }
    if (np == 1 && nq == 1 && p[1] == q[1]) {
        return 2;
    }
    return 3;
}

// gcd(g, |s|), saturated at I64.max for |I64.min|.
I64 gcd(I64 g, I64 s) {
    I64 a = g;
    I64 b = s;
    if (b == I64_MIN) {
        b = I64_MAX;
    }
    if (b < 0) {
        b = 0 - b;
    }
    while (b != 0) {
        I64 t = a % b;
        a = b;
        b = t;
    }
    return a;
}

// x mod g in 0..g - 1, for g >= 1.
I64 residue(I64 x, I64 g) {
    I64 m = x % g;
    if (m < 0) {
        m += g;
    }
    return m;
}

// C5010 at src when the source and the destination of a copy, both known at compile time,
// share storage and are not the same view (`cint_ref` _static_copy_alias; SPEC-04 LS-70).
void static_copy_alias[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        in resolve.Sym[_] syms, inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs,
        in CState[_] cs, I64 dst, I64 src) {
    I64[11] p;
    I64[11] q;
    if (static_view(nodes, sem, syms, wk, cs, dst, p) && static_view(nodes, sem, syms, wk, cs, src, q)) {
        I64 c = classify(p, q);
        if (c == 2 || c == 3) {
            resolve.fail(toks, diag, rs, C_OVERLAP, first(nodes, src));
        }
    }
}

// K_PLACE on frame f: the constant index items and slice bounds along place x are folded,
// outermost first (`cint_ref` _fold_place), so that place_path and static_view decide
// C5010. Frame: b the chain node, c its item (-2 before the first), d the slice bound.
void h_place[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    if (wk[f].state == 0) {
        wk[f].state = 1;
        wk[f].b = wk[f].node;
        wk[f].c = -2;
        wk[f].d = 0;
    }
    while (true) {
        I64 e = wk[f].b as I64;
        I32 k = nodes[e].kind;
        if (k == parse.N_INDEX) {
            if (wk[f].c == -2) {
                wk[f].c = nodes[e].b;
                wk[f].d = 0;
            }
            while (wk[f].c >= 0) {
                I64 item = wk[f].c as I64;
                I64 next = -1;
                if (nodes[item].kind == parse.N_SLICE) {
                    if (wk[f].d == 0) {
                        next = nodes[item].a as I64;
                    } else if (wk[f].d == 1) {
                        next = nodes[item].b as I64;
                    }
                    if (wk[f].d < 2) {
                        wk[f].d += 1;
                        if (next >= 0) {
                            _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, next, 0);
                            return;
                        }
                        continue;
                    }
                } else if (wk[f].d == 0) {
                    wk[f].d = 2;
                    _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, item, 0);
                    return;
                }
                wk[f].c = nodes[item].next;
                wk[f].d = 0;
            }
            wk[f].b = nodes[e].a;
            wk[f].c = -2;
        } else if (k == parse.N_FIELD && (sem[e].flags & resolve.SEM_IMPORT) == 0) {
            wk[f].b = nodes[e].a;
        } else if (view_call(nodes, sem, e)) {
            I64 dn = nodes[nodes[e].b as I64].next as I64;
            if (wk[f].c == -2 && dn >= 0) {
                wk[f].c = -3;
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, dn, 0);
                return;
            }
            wk[f].b = nodes[e].b;
            wk[f].c = -2;
        } else {
            pop(cs);
            return;
        }
    }
}

// ---------------------------------------------------------------- constant evaluation

// K_FOLD on frame f: fold expression node x; a is 1 below a skipped operand (D-9).
void h_fold[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 skipped = wk[f].a as I64;
    I64 step = wk[f].state as I64;
    if (wk[f].d < 0) {
        // A fold that no other fold started checks the bounds of its `clamp` calls first.
        wk[f].d = 0;
        if (f == cs[0].base || wk[f - 1].kind != K_FOLD) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_CLAMP, x, 0);
            return;
        }
    }
    wk[f].state = (step + 1) as I32;
    if (step == 0 && sem[x].ty == resolve.TY_NONE) {
        sem[x].ty = fold.TY_I64;
    }
    if (is_const(sem, x)) {
        if (step == 0) {
            if (skipped == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, x, 0);
                return;
            }
            wk[f].state = 2;
            step = 1;
        }
        if (step == 1) {
            if (skipped == 0) {
                sem[x].flags = sem[x].flags | resolve.SEM_FOLDED;
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_WALK, x, 0);
            return;
        }
        pop(cs);
        return;
    }
    I32 k = nodes[x].kind;
    I64 next = -1;
    I64 skip = skipped;
    if (k == parse.N_LOGICAL || k == parse.N_BINARY || k == parse.N_COMPARE) {
        if (step < 2) {
            next = kid(nodes, x, step);
            if (k == parse.N_LOGICAL && step == 1) {
                skip = 1;
            }
        }
    } else if (k == parse.N_COND) {
        if (step < 3) {
            next = kid(nodes, x, step);
            if (step > 0) {
                skip = 1;
            }
        }
    } else if (k == parse.N_UNARY || k == parse.N_CONVERT) {
        if (step == 0) {
            next = nodes[x].a as I64;
        }
    } else if (k == parse.N_INDEX) {
        // The base, then each item in order (box 09: several items, and slices).
        if (step == 0) {
            next = nodes[x].a as I64;
            wk[f].b = nodes[x].b;
        } else {
            next = wk[f].b as I64;
            if (next >= 0) {
                wk[f].b = nodes[next].next;
            }
        }
    } else if (k == parse.N_SLICE) {
        // The bounds and the step that are written.
        I64 j = step;
        while (j < 3 && kid(nodes, x, j) < 0) {
            j += 1;
        }
        if (j < 3) {
            next = kid(nodes, x, j);
            wk[f].state = (j + 1) as I32;
        }
    } else if (k == parse.N_ARRAY) {
        if (step == 0) {
            wk[f].b = nodes[x].a;
        }
        next = wk[f].b as I64;
        if (next >= 0) {
            wk[f].b = nodes[next].next;
        }
    } else if (k == parse.N_FIELD || k == parse.N_NAMEDARG) {
        if (step == 0) {
            next = nodes[x].a as I64;
        }
    } else if (k == parse.N_CALL && (sem[x].flags & resolve.SEM_ARRAYFN) != 0) {
        // An array built-in's values: not the result type of `sum` or `dot`, nor the
        // operation of `fold_checked`.
        if (step < af_values(nodes, sem, x)) {
            next = af_value(nodes, sem, x, step);
        }
    } else if (is_builtin(nodes, sem, x)) {
        if (step < fold.builtin_values(sem[x].lit_at)) {
            next = builtin_value(nodes, sem, x, step);
        }
    } else if (k == parse.N_CALL) {
        if (step == 0) {
            wk[f].b = nodes[x].b;
        }
        next = wk[f].b as I64;
        if (next >= 0) {
            wk[f].b = nodes[next].next;
        }
    }
    if (next < 0) {
        pop(cs);
        return;
    }
    _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, next, skip);
}

// Records the outcome of a fold.ci call for node x: its value, or C6001 at token tok.
Bool settled[r](in scan.Token[_] toks, inout resolve.Sem[_] sem, inout limits.CompilerDiag[r] diag,
        inout U8[_] faults, inout fold.Folded[_] fres, in U8[_] lits, inout fold.Work[_] z, in U8[_] path,
        inout resolve.RState[_] rs, inout CState[_] cs, I64 x, I64 tok) {
    if (fres[0].fault != fold.F_NONE) {
        if (cs[0].quiet > 0) {
            cs[0].quiet = -cs[0].quiet;
        } else if (fres[0].fault < 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok);
        } else {
            const_fault(toks, diag, faults, fres, lits, z, path, rs, tok);
        }
        return false;
    }
    sem[x].bits = fres[0].bits;
    return true;
}

// K_EVAL on frame f: the value of constant expression node x with the run-time rules
// (`cint_ref` const_eval): operands left to right, `&&`, `||` and `?:` evaluating only what
// the result needs, and a literal range-checked when it is evaluated (C2003).
void h_eval[s, l, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout parse.Frame[s] wk, inout U8[l] lits, inout limits.CompilerDiag[r] diag,
        inout U8[_] faults, inout fold.Folded[_] fres, inout fold.Work[_] z, in U8[_] path,
        inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 step = wk[f].state as I64;
    wk[f].state = (step + 1) as I32;
    I32 k = nodes[x].kind;
    I64 a = nodes[x].a as I64;
    I64 b = nodes[x].b as I64;
    I64 tok = tok_of(nodes, x);
    I64 ty = ety(sem, x);
    switch (k) {
        case parse.N_LIT, parse.N_NEGLIT:
            if (!literal(src, toks, nodes, sem, lits, diag, z, rs, cs, x)) {
                return;
            }
            if (!fold.lit_fits(lits, sem[x].lit_at, sem[x].lit_len, ty)) {
                eval_fail(toks, diag, rs, cs, resolve.C_LITERAL_RANGE, tok);
                return;
            }
            sem[x].bits = fold.lit_bits(lits, sem[x].lit_at, sem[x].lit_len);
        case parse.N_BOOL:
            sem[x].bits = nodes[x].op as U64;
        case parse.N_TYPEPROP:
            if (spells(src, toks, nodes[x].c as I64, "min")) {
                sem[x].bits = fold.ty_min(ty);
            } else {
                sem[x].bits = fold.ty_max(ty);
            }
        case parse.N_NAME:
            sem[x].bits = syms[sem[x].sym].value;
        case parse.N_UNARY:
            if (step == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, a, 0);
                return;
            }
            U64 v = sem[a].bits;
            I32 op = nodes[x].op;
            if (op == scan.OP_BANG) {
                sem[x].bits = 1 - v;
            } else {
                if (op == scan.OP_SUB) {
                    fold.fold_unary(fres, fold.OP_NEG, ty, v);
                } else if (op == scan.OP_TILDE) {
                    fold.fold_unary(fres, fold.OP_NOT, ty, v);
                } else {
                    fold.fold_binary(fres, fold.OP_SUB, fold.FORM_WRAP, ty, 0, ty, v);
                }
                if (!settled(toks, sem, diag, faults, fres, lits, z, path, rs, cs, x, tok)) {
                    return;
                }
            }
        case parse.N_BINARY, parse.N_COMPARE:
            if (step < 2) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, kid(nodes, x, step), 0);
                return;
            }
            if (k == parse.N_COMPARE) {
                sem[x].bits = 0;
                if (fold.fold_compare(cmp_of(nodes[x].op), sem[x].opty, sem[a].bits, sem[b].bits)) {
                    sem[x].bits = 1;
                }
            } else {
                I32 op = nodes[x].op;
                fold.fold_binary(fres, op_name(op), op_form(op), ty, sem[a].bits, ety(sem, b), sem[b].bits);
                if (!settled(toks, sem, diag, faults, fres, lits, z, path, rs, cs, x, tok)) {
                    return;
                }
            }
        case parse.N_LOGICAL:
            if (step == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, a, 0);
                return;
            }
            if (step == 1) {
                Bool decided = sem[a].bits == 1;
                if (nodes[x].op == scan.OP_AND) {
                    decided = sem[a].bits == 0;
                }
                if (!decided) {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, b, 0);
                    return;
                }
                sem[x].bits = sem[a].bits;
            } else {
                sem[x].bits = sem[b].bits;
            }
        case parse.N_COND:
            if (step == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, a, 0);
                return;
            }
            I64 arm = nodes[x].c as I64;
            if (sem[a].bits == 1) {
                arm = b;
            }
            if (step == 1) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, arm, 0);
                return;
            }
            sem[x].bits = sem[arm].bits;
        case parse.N_CONVERT:
            I64 form = fold.FORM_CHECKED;
            if (nodes[x].op == scan.OP_AS_WRAP) {
                form = fold.FORM_WRAP;
            }
            if (sem[x].opty == fold.TY_Z) {
                if (!literal(src, toks, nodes, sem, lits, diag, z, rs, cs, a)) {
                    return;
                }
                fold.fold_lit_convert(fres, form, lits, sem[a].lit_at, sem[a].lit_len, ty);
            } else {
                if (step == 0) {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, a, 0);
                    return;
                }
                fold.fold_convert(fres, form, sem[x].opty, sem[a].bits, ty);
            }
            if (!settled(toks, sem, diag, faults, fres, lits, z, path, rs, cs, x, tok)) {
                return;
            }
        case parse.N_FIELD:
            // An imported constant: its value is in bits since inference (qualified).
            sem[x].flags = sem[x].flags | resolve.SEM_CONST;
        case parse.N_CALL:
            if (!is_builtin(nodes, sem, x)) {
                eval_fail(toks, diag, rs, cs, resolve.C_UNSUPPORTED, tok);
                return;
            }
            I64 id = sem[x].lit_at;
            I64 nb = fold.builtin_values(id);
            if (step < nb) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, builtin_value(nodes, sem, x, step), 0);
                return;
            }
            U64 v1 = 0;
            U64 v2 = 0;
            if (nb > 1) {
                v1 = sem[builtin_value(nodes, sem, x, 1)].bits;
            }
            if (nb > 2) {
                v2 = sem[builtin_value(nodes, sem, x, 2)].bits;
            }
            I64 kty = fold.TY_I64;
            if (id == fold.BI_ROTL || id == fold.BI_ROTR) {
                kty = ety(sem, builtin_value(nodes, sem, x, 1));
            }
            fold.fold_builtin(fres, id, sem[x].lit_len, builtin_opty(sem, x), ty,
                sem[builtin_value(nodes, sem, x, 0)].bits, v1, v2, kty);
            if (!settled(toks, sem, diag, faults, fres, lits, z, path, rs, cs, x, tok)) {
                return;
            }
        default:
            eval_fail(toks, diag, rs, cs, resolve.C_UNSUPPORTED, tok);
            return;
    }
    pop(cs);
}

// A diagnostic of constant evaluation at token tok, unless the evaluation is quiet (h_clamp),
// which then fails without one.
void eval_fail[r](in scan.Token[_] toks, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs,
        inout CState[_] cs, I64 code, I64 tok) {
    if (cs[0].quiet > 0) {
        cs[0].quiet = -cs[0].quiet;
        return;
    }
    resolve.fail(toks, diag, rs, code, tok);
}

// The operand type of built-in call x: I64 for an untyped call.
I64 builtin_opty(in resolve.Sem[_] sem, I64 x) {
    if (sem[x].opty == resolve.TY_NONE) {
        return fold.TY_I64;
    }
    return sem[x].opty;
}

// The k-th call of `clamp` (from 0) with constant bounds in expression x, parents before
// children and left to right (`cint_ref` walk), or -1; the stack rows above the top are
// scratch.
I64 clamp_at[s](in parse.Node[_] nodes, in resolve.Sem[_] sem, inout parse.Frame[s] wk, in CState[_] cs, I64 x, I64 k) {
    I64 base = cs[0].sp;
    I64 sp = base;
    I64 seen = 0;
    if (sp == cs[0].cap) {
        return -1;
    }
    wk[sp].node = x as I32;
    sp += 1;
    while (sp > base) {
        sp -= 1;
        I64 e = wk[sp].node as I64;
        I32 kind = nodes[e].kind;
        I64 top = sp;
        if (kind == parse.N_UNARY || kind == parse.N_CONVERT || kind == parse.N_NAMEDARG) {
            top = scratch(wk, cs[0].cap, top, nodes[e].a as I64);
        } else if (kind == parse.N_BINARY || kind == parse.N_COMPARE || kind == parse.N_LOGICAL) {
            top = scratch(wk, cs[0].cap, top, nodes[e].b as I64);
            top = scratch(wk, cs[0].cap, top, nodes[e].a as I64);
        } else if (kind == parse.N_INDEX) {
            // The base, then each item (box 09: several, and slices).
            top = scratch_list(nodes, wk, cs[0].cap, top, nodes[e].b as I64);
            top = scratch(wk, cs[0].cap, top, nodes[e].a as I64);
        } else if (kind == parse.N_SLICE) {
            top = scratch(wk, cs[0].cap, top, nodes[e].c as I64);
            top = scratch(wk, cs[0].cap, top, nodes[e].b as I64);
            top = scratch(wk, cs[0].cap, top, nodes[e].a as I64);
        } else if (kind == parse.N_ARRAY) {
            top = scratch_list(nodes, wk, cs[0].cap, top, nodes[e].a as I64);
        } else if (kind == parse.N_COND) {
            top = scratch(wk, cs[0].cap, top, nodes[e].c as I64);
            top = scratch(wk, cs[0].cap, top, nodes[e].b as I64);
            top = scratch(wk, cs[0].cap, top, nodes[e].a as I64);
        } else if (kind == parse.N_FIELD && (sem[e].flags & resolve.SEM_IMPORT) == 0) {
            top = scratch(wk, cs[0].cap, top, nodes[e].a as I64);
        } else if (is_builtin(nodes, sem, e)) {
            I64 id = sem[e].lit_at;
            if (id == fold.BI_CLAMP && is_const(sem, builtin_value(nodes, sem, e, 1)) &&
                    is_const(sem, builtin_value(nodes, sem, e, 2))) {
                if (seen == k) {
                    return e;
                }
                seen += 1;
            }
            I64 i = fold.builtin_values(id) - 1;
            while (i >= 0) {
                top = scratch(wk, cs[0].cap, top, builtin_value(nodes, sem, e, i));
                i -= 1;
            }
        } else if (kind == parse.N_CALL) {
            I64 n = 0;
            I64 g = nodes[e].b as I64;
            while (g >= 0) {
                n += 1;
                g = nodes[g].next as I64;
            }
            I64 i = n - 1;
            while (i >= 0) {
                top = scratch(wk, cs[0].cap, top, arg_at(nodes, e, i));
                i -= 1;
            }
        }
        sp = top;
    }
    return -1;
}

// Pushes node x on the scratch rows at top (dropped when they are full); the new top.
I64 scratch(inout parse.Frame[_] wk, I64 lim, I64 top, I64 x) {
    if (x < 0 || top >= lim) {
        return top;
    }
    wk[top].node = x as I32;
    return top + 1;
}

// Pushes the list from node g on the scratch rows at top, its first node on top; the new top.
I64 scratch_list(in parse.Node[_] nodes, inout parse.Frame[_] wk, I64 lim, I64 top, I64 g) {
    I64 at = top;
    I64 x = g;
    while (x >= 0 && at < lim) {
        wk[at].node = x as I32;
        at += 1;
        x = nodes[x].next as I64;
    }
    I64 i = top;
    I64 j = at - 1;
    while (i < j) {
        I32 t = wk[i].node;
        wk[i].node = wk[j].node;
        wk[j].node = t as I32;
        i += 1;
        j -= 1;
    }
    return at;
}

// K_CLAMP on frame f, for the expression x a K_FOLD is about to fold (`cint_ref`
// _check_clamp_bounds): each call of `clamp` in x whose bounds lo and hi are constant has
// them evaluated quietly, and lo > hi is C6006 at the call (SPEC-01 4.8). A call whose
// bounds fault or break a literal's range is skipped: the fold reports that. Frame: b the
// calls done, c the current call, d the phase.
void h_clamp[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    if (wk[f].d < 0) {
        wk[f].b = 0;
        wk[f].d = 0;
    }
    I64 c = wk[f].c as I64;
    if (wk[f].d == 0) {
        c = clamp_at(nodes, sem, wk, cs, wk[f].node as I64, wk[f].b as I64);
        if (c < 0) {
            pop(cs);
            return;
        }
        wk[f].b += 1;
        wk[f].c = c as I32;
        wk[f].d = 1;
        cs[0].quiet = f + 1;
        _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, builtin_value(nodes, sem, c, 1), 0);
        return;
    }
    if (wk[f].d == 1) {
        wk[f].d = 2;
        _ = push(toks, nodes, wk, diag, rs, cs, K_EVAL, builtin_value(nodes, sem, c, 2), 0);
        return;
    }
    cs[0].quiet = 0;
    wk[f].d = 0;
    if (fold.fold_compare(fold.CMP_GT, builtin_opty(sem, c), sem[builtin_value(nodes, sem, c, 1)].bits,
            sem[builtin_value(nodes, sem, c, 2)].bits)) {
        resolve.fail(toks, diag, rs, C_CLAMP_BOUNDS, first(nodes, c));
    }
}

// K_WALK on frame f: node x of a constant expression and, in source order, every node
// below it (`cint_ref` walk): a literal is range-checked (C2003 at the literal) and a
// checked conversion of a literal is decided (C6001 E_NARROW at the `as`, D-17). The frame
// is replaced by frames for x's operands, the first on top.
void h_walk[s, l, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout parse.Frame[s] wk, inout U8[l] lits, inout limits.CompilerDiag[r] diag, inout U8[_] faults,
        inout fold.Folded[_] fres, inout fold.Work[_] z, in U8[_] path, inout resolve.RState[_] rs,
        inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I32 k = nodes[x].kind;
    pop(cs);
    if (sem[x].ty == resolve.TY_NONE) {
        sem[x].ty = fold.TY_I64;
    }
    if (is_literal(nodes, x) && sem[x].ty != fold.TY_Z) {
        if (!literal(src, toks, nodes, sem, lits, diag, z, rs, cs, x)) {
            return;
        }
        if (!fold.lit_fits(lits, sem[x].lit_at, sem[x].lit_len, sem[x].ty)) {
            resolve.fail(toks, diag, rs, resolve.C_LITERAL_RANGE, tok_of(nodes, x));
            return;
        }
    } else if (k == parse.N_CONVERT && sem[x].opty == fold.TY_Z) {
        I64 a = nodes[x].a as I64;
        if (!literal(src, toks, nodes, sem, lits, diag, z, rs, cs, a)) {
            return;
        }
        I64 form = fold.FORM_CHECKED;
        if (nodes[x].op == scan.OP_AS_WRAP) {
            form = fold.FORM_WRAP;
        }
        fold.fold_lit_convert(fres, form, lits, sem[a].lit_at, sem[a].lit_len, sem[x].ty);
        if (fres[0].fault != fold.F_NONE) {
            const_fault(toks, diag, faults, fres, lits, z, path, rs, tok_of(nodes, x));
            return;
        }
    }
    I64 n = 0;
    if (k == parse.N_UNARY || k == parse.N_CONVERT) {
        n = 1;
    } else if (k == parse.N_BINARY || k == parse.N_COMPARE || k == parse.N_LOGICAL) {
        n = 2;
    } else if (k == parse.N_COND) {
        n = 3;
    } else if (is_builtin(nodes, sem, x)) {
        n = fold.builtin_values(sem[x].lit_at);
    }
    I64 i = n - 1;
    while (i >= 0) {
        I64 child = kid(nodes, x, i);
        if (is_builtin(nodes, sem, x)) {
            child = builtin_value(nodes, sem, x, i);
        }
        if (!push(toks, nodes, wk, diag, rs, cs, K_WALK, child, 0)) {
            return;
        }
        i -= 1;
    }
}

// ---------------------------------------------------------------- statements

// Enters the body of a loop labeled by token label (-1 for none).
void loop_enter[q, r](in U8[_] src, in scan.Token[_] toks, inout resolve.Name[q] names,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, I64 label, I64 delta) {
    rs[0].loops += delta;
    if (label >= 0) {
        I64 id = resolve.intern(src, toks, names, diag, rs, label);
        if (id >= 0) {
            names[id].loops += delta;
        }
    }
}

// The label token of loop node x, or -1.
I64 label_of(in parse.Node[_] nodes, I64 x) {
    if (nodes[x].start != nodes[x].tok) {
        return nodes[x].start as I64;
    }
    return -1;
}

// The nearest switch/loop frame for an unlabeled jump. Fallthrough searches past loops.
I64 jump_frame(in parse.Node[_] nodes, in parse.Frame[_] wk, in CState[_] cs, I64 f,
        Bool loop_only, Bool switch_only) {
    I64 i = f - 1;
    while (i >= cs[0].base) {
        I32 kind = nodes[wk[i].node as I64].kind;
        if (wk[i].kind == K_SWITCH && !loop_only) {
            return i;
        }
        if (wk[i].kind == K_STMT && !switch_only &&
                (kind == parse.N_WHILE || kind == parse.N_FOR || kind == parse.N_FOR_RANGE)) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// Signed values are sign-extended by folding. This maps all supported widths to U64 order.
U64 interval_key(I64 ty, U64 bits) {
    if (fold.ty_signed(ty)) {
        return bits ^ 0x8000000000000000;
    }
    return bits;
}

// An interval row in wk[0..base): kind left, node right, state parent, a AVL height,
// b low expression, c high expression. No traversal task uses these rows.
I64 interval_height(in parse.Frame[_] wk, I64 x) {
    if (x < 0) {
        return 0;
    }
    return wk[x].a as I64;
}

void interval_height_set(inout parse.Frame[_] wk, I64 x) {
    I64 lh = interval_height(wk, wk[x].kind as I64);
    I64 rh = interval_height(wk, wk[x].node as I64);
    if (rh > lh) {
        lh = rh;
    }
    wk[x].a = (lh + 1) as I32;
}

// Rotates an AVL subtree and repairs its parent link, returning the new subtree root.
I64 interval_rotate(inout parse.Frame[_] wk, I64 x, Bool left) {
    I64 y = wk[x].kind as I64;
    if (left) {
        y = wk[x].node as I64;
    }
    I64 middle = wk[y].node as I64;
    if (left) {
        middle = wk[y].kind as I64;
        wk[x].node = middle as I32;
        wk[y].kind = x as I32;
    } else {
        wk[x].kind = middle as I32;
        wk[y].node = x as I32;
    }
    if (middle >= 0) {
        wk[middle].state = x as I32;
    }
    I64 parent = wk[x].state as I64;
    wk[y].state = parent as I32;
    wk[x].state = y as I32;
    if (parent >= 0) {
        if (wk[parent].kind as I64 == x) {
            wk[parent].kind = y as I32;
        } else {
            wk[parent].node = y as I32;
        }
    }
    interval_height_set(wk, x);
    interval_height_set(wk, y);
    return y;
}

// Insert one checked interval, or C4021 at its low expression. Earlier intervals are
// disjoint, so the BST search detects inclusive overlap in O(log items) worst case.
I64 interval_insert[r](in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout parse.Frame[_] wk, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs,
        I64 root, I64 ty, I64 lo, I64 hi) {
    U64 low = interval_key(ty, sem[lo].bits);
    U64 high = interval_key(ty, sem[hi].bits);
    I64 tree = root;
    I64 parent = -1;
    I64 at = root;
    Bool left = false;
    while (at >= 0) {
        parent = at;
        if (high < interval_key(ty, sem[wk[at].b as I64].bits)) {
            left = true;
            at = wk[at].kind as I64;
        } else if (low > interval_key(ty, sem[wk[at].c as I64].bits)) {
            left = false;
            at = wk[at].node as I64;
        } else {
            resolve.fail(toks, diag, rs, resolve.C_SWITCH_OVERLAP, first(nodes, lo));
            return root;
        }
    }
    wk[lo].kind = -1;
    wk[lo].node = -1;
    wk[lo].state = parent as I32;
    wk[lo].a = 1;
    wk[lo].b = lo as I32;
    wk[lo].c = hi as I32;
    if (parent < 0) {
        return lo;
    }
    if (left) {
        wk[parent].kind = lo as I32;
    } else {
        wk[parent].node = lo as I32;
    }
    at = parent;
    while (at >= 0) {
        interval_height_set(wk, at);
        I64 balance = interval_height(wk, wk[at].kind as I64) - interval_height(wk, wk[at].node as I64);
        if (balance > 1) {
            I64 child = wk[at].kind as I64;
            if (interval_height(wk, wk[child].kind as I64) < interval_height(wk, wk[child].node as I64)) {
                _ = interval_rotate(wk, child, true);
            }
            at = interval_rotate(wk, at, false);
        } else if (balance < -1) {
            I64 child = wk[at].node as I64;
            if (interval_height(wk, wk[child].node as I64) < interval_height(wk, wk[child].kind as I64)) {
                _ = interval_rotate(wk, child, false);
            }
            at = interval_rotate(wk, at, true);
        }
        if (wk[at].state < 0) {
            tree = at;
        }
        at = wk[at].state as I64;
    }
    return tree;
}

// Inorder interval traversal is O(items), using parent links rather than recursion. The
// values of a set type are its tags, 1 to its size (LS-314).
Bool interval_covers(in parse.Node[_] nodes, in resolve.Sem[_] sem, in parse.Frame[_] wk, I64 root, I64 ty) {
    U64 cursor = interval_key(ty, fold.ty_min(ty));
    U64 last = interval_key(ty, fold.ty_max(ty));
    if (ty == fold.TY_BOOL) {
        cursor = 0;
        last = 1;
    } else if (resolve.is_errset(ty)) {
        cursor = 1;
        last = resolve.errset_size(nodes, sem, ty) as U64;
    }
    I64 at = root;
    if (at >= 0) {
        while (wk[at].kind >= 0) {
            at = wk[at].kind as I64;
        }
    }
    while (at >= 0) {
        U64 low = interval_key(ty, sem[wk[at].b as I64].bits);
        U64 high = interval_key(ty, sem[wk[at].c as I64].bits);
        if (low > cursor) {
            return false;
        }
        if (high == last) {
            return true;
        }
        // high is below the domain maximum here, including for 0xFFFFFFFFFFFFFFFF.
        cursor = high + 1;
        if (wk[at].node >= 0) {
            at = wk[at].node as I64;
            while (wk[at].kind >= 0) {
                at = wk[at].kind as I64;
            }
        } else {
            I64 parent = wk[at].state as I64;
            while (parent >= 0 && wk[parent].node as I64 == at) {
                at = parent;
                parent = wk[at].state as I64;
            }
            at = parent;
        }
    }
    return false;
}

// K_SWITCH: a interval root, b clause cursor, c current item. All labels precede bodies.
void h_switch[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs,
        inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 scr = nodes[x].a as I64;
    I64 phase = wk[f].state as I64;
    wk[f].state = (phase + 1) as I32;
    if (phase == 0) {
        wk[f].a = -1;
        wk[f].b = nodes[x].b;
        wk[f].c = -1;
        set_completes(sem, x, false);
        _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, scr, 0);
        return;
    }
    if (phase == 1) {
        I64 ty = ety(sem, scr);
        if (ty == resolve.TY_VOID) {
            resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, scr));
            return;
        }
        if (!resolve.is_int(ty) && ty != fold.TY_BOOL && !resolve.is_errset(ty)) {
            resolve.fail(toks, diag, rs, use_code(sem, scr, resolve.C_SWITCH_TYPE), first(nodes, scr));
            return;
        }
        sem[x].ty = ty;
        if (sem[scr].ty == resolve.TY_NONE) {
            settle(toks, nodes, sem, wk, diag, rs, cs, scr, ty);
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, scr, 0);
        return;
    }
    I64 ty = sem[x].ty;
    if (phase == 2) {
        I64 clause = wk[f].b as I64;
        I64 item = wk[f].c as I64;
        while (clause >= 0 && item < 0) {
            if ((nodes[clause].flags & parse.F_DEFAULT) != 0) {
                sem[x].flags = sem[x].flags | SEM_SWITCH_DEFAULT;
            }
            item = nodes[clause].a as I64;
            if (item < 0) {
                clause = nodes[clause].next as I64;
            }
        }
        wk[f].b = clause as I32;
        wk[f].c = item as I32;
        if (clause < 0) {
            if ((sem[x].flags & SEM_SWITCH_DEFAULT) == 0 && !interval_covers(nodes, sem, wk, wk[f].a as I64, ty)) {
                resolve.fail(toks, diag, rs, resolve.C_SWITCH_COVERAGE, tok_of(nodes, x));
                return;
            }
            wk[f].b = nodes[x].b;
            wk[f].state = 20;
            return;
        }
        I64 lo = item;
        if (nodes[item].kind == parse.N_RANGE) {
            lo = nodes[item].a as I64;
            if (ty == fold.TY_BOOL || resolve.is_errset(ty)) {
                resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, lo));
                return;
            }
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, lo, ty);
        return;
    }
    if (phase < 20) {
        I64 item = wk[f].c as I64;
        I64 lo = item;
        I64 hi = item;
        if (nodes[item].kind == parse.N_RANGE) {
            lo = nodes[item].a as I64;
            hi = nodes[item].b as I64;
        }
        if (phase == 3 || phase == 5) {
            I64 bound = lo;
            if (phase == 5) {
                bound = hi;
            }
            if (!is_const(sem, bound) && !is_errval(sem, bound)) {
                resolve.fail(toks, diag, rs, resolve.C_CONST_REQUIRED, first(nodes, bound));
                return;
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, bound, 0);
            return;
        }
        if (phase == 4 && hi != lo) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, hi, ty);
            return;
        }
        if (interval_key(ty, sem[lo].bits) > interval_key(ty, sem[hi].bits)) {
            resolve.fail(toks, diag, rs, resolve.C_SWITCH_RANGE, first(nodes, lo));
            return;
        }
        wk[f].a = interval_insert(toks, nodes, sem, wk, diag, rs, wk[f].a as I64, ty, lo, hi) as I32;
        wk[f].c = nodes[item].next;
        if (wk[f].c < 0) {
            wk[f].b = nodes[wk[f].b as I64].next;
        }
        wk[f].state = 2;
        return;
    }
    I64 clause = wk[f].b as I64;
    if (phase == 21) {
        if (completes(sem, clause)) {
            set_completes(sem, x, true);
        }
        clause = nodes[clause].next as I64;
        wk[f].b = clause as I32;
        wk[f].state = 20;
    }
    if (clause < 0) {
        if ((sem[x].flags & SEM_SWITCH_BREAK) != 0) {
            set_completes(sem, x, true);
        }
        pop(cs);
        return;
    }
    I64 st = nodes[clause].b as I64;
    while (st >= 0) {
        if (nodes[st].kind == parse.N_FALLTHROUGH &&
                (nodes[st].next >= 0 || nodes[clause].next < 0)) {
            resolve.fail(toks, diag, rs, resolve.C_FALLTHROUGH, tok_of(nodes, st));
            return;
        }
        st = nodes[st].next as I64;
    }
    wk[f].state = 21;
    _ = push(toks, nodes, wk, diag, rs, cs, K_CLAUSE, clause, 0);
}

// Distinguishes the specified dynamic size expressions from nonconstant extents.
// Dynamic local storage remains outside this implementation (LS-62, BOOT-01).
Bool size_expression[s](in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        in resolve.Sym[_] syms, inout parse.Frame[s] wk, inout limits.CompilerDiag[_] diag,
        inout resolve.RState[_] rs, in CState[_] cs, I64 x) {
    I64 base = cs[0].sp;
    I64 sp = base;
    if (sp >= cs[0].cap) { resolve.fail(toks, diag, rs, limits.C_NESTING, first(nodes, x)); return false; }
    wk[sp].node = x as I32; sp += 1;
    while (sp > base) {
        sp -= 1;
        I64 e = wk[sp].node as I64;
        I32 k = nodes[e].kind;
        if (k == parse.N_CALL || k == parse.N_FIELD || k == parse.N_INDEX || k == parse.N_STRING) { return false; }
        if (is_const(sem, e)) { continue; }
        if (k == parse.N_NAME) {
            I64 sy = sem[e].sym;
            if (sy < 0 || syms[sy].kind != resolve.SK_PARAM || syms[sy].node < 0 ||
                    nodes[syms[sy].node].kind != parse.N_SIZE) { return false; }
            continue;
        }
        I64 nk = 0;
        if (k == parse.N_UNARY || k == parse.N_CONVERT) { nk = 1; }
        else if (k == parse.N_BINARY || k == parse.N_COMPARE || k == parse.N_LOGICAL) { nk = 2; }
        else if (k == parse.N_COND) { nk = 3; }
        else { return false; }
        if (sp + nk > cs[0].cap) { resolve.fail(toks, diag, rs, limits.C_NESTING, first(nodes, e)); return false; }
        for j in 0..nk { wk[sp].node = kid(nodes, e, j) as I32; sp += 1; }
    }
    return true;
}

// The places a type can occur, for K_TYPE's frame a (`cint_ref` _dim's `where`): a local
// variable 0, a field -1, a view variable -2, else the function or kernel node of a
// parameter plus one.
const I64 WHERE_LOCAL = 0;
const I64 WHERE_FIELD = -1;
const I64 WHERE_VIEW = -2;

// C2015: a negative extent (SPEC-04 LS-62; box 09 ruling R10).
const I64 C_NEGATIVE_EXTENT = 2015;

// K_TYPE resolves the element, then each extent in order using ordinary inference and
// folding (`cint_ref` resolve_type and _dim). Frame a: where the type is (WHERE_*); b the
// extent being checked, c its dimension. An extent is `_` (a view: code 0), a size
// parameter or shape symbol of a parameter, a constant (C2015 when negative), or an I64
// expression of size parameters known at run time (code 0): a kernel parameter's shape
// expression, or a local array's in a function. A constant extent above the encoding's
// limit (65534 at rank 1, resolve.NARRAY_EXTENT_MAX above) is C9102, but a function's local
// array of rank 1 has resolve.BIG_CODE's form up to resolve.BIG_EXTENT_MAX.
void h_type[s](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes,
        inout resolve.Sem[_] sem, inout resolve.Sym[_] syms, inout resolve.Name[_] names,
        in limits.Decl[_] decls, inout parse.Frame[s] wk, inout limits.CompilerDiag[_] diag,
        inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 shape = nodes[x].a as I64;
    I64 wh = wk[f].a as I64;
    I64 fn = wh - 1;
    I64 step = wk[f].state as I64;
    wk[f].state = (step + 1) as I32;
    if (resolve.mem_node(toks, nodes, x)) {
        // An arena, pool or handle (box 12): a parameter's, a local variable's, or elsewhere
        // (a field). Not in a kernel, where `cint_ref` refuses every use of one
        // (compiler/OPEN.md CINTC-OQ-15).
        if (rs[0].ctx == resolve.CTX_KERNEL || (fn >= 0 && nodes[fn].kind == parse.N_KERNEL)) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, x));
            return;
        }
        I64 w = resolve.MW_OTHER;
        if (wh == WHERE_LOCAL) {
            w = resolve.MW_LOCAL;
        } else if (fn >= 0) {
            w = resolve.MW_PARAM;
        }
        sem[x].ty = resolve.mem_type_ref(src, toks, nodes, syms, names, diag, rs, x, w);
        pop(cs);
        return;
    }
    if (shape < 0) {
        sem[x].ty = resolve.type_ref(src, toks, nodes, sem, syms, names, decls, diag, rs, x, fn, -2);
        pop(cs);
        return;
    }
    if (step == 0) {
        sem[x].ty = resolve.type_ref(src, toks, nodes, sem, syms, names, decls, diag, rs, x, fn, -1);
        if (rs[0].err != 0) { return; }
        if (!resolve.is_array(sem[x].ty) || (wh == WHERE_LOCAL && rs[0].ctx != resolve.CTX_FUNCTION &&
                rs[0].ctx != resolve.CTX_KERNEL)) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, x));
            return;
        }
        I64 rank = 0;
        I64 z = nodes[shape].a as I64;
        while (z >= 0) {
            rank += 1;
            z = nodes[z].next as I64;
        }
        sem[x].ty = resolve.shaped(resolve.elem_code(sem[x].ty), rank, 0, 0, 0, 0);
        if (sem[x].ty == 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, x));
            return;
        }
        wk[f].b = nodes[shape].a;
        wk[f].c = 0;
        wk[f].state = 1;
        return;
    }
    I64 e = wk[f].b as I64;
    if (e < 0) {
        pop(cs);
        return;
    }
    I64 d = wk[f].c as I64;
    I64 code = -1;
    if (step == 1) {
        if (nodes[e].kind == parse.N_WILD) {
            if ((fn < 0 && wh != WHERE_VIEW) || (fn >= 0 && nodes[fn].kind == parse.N_KERNEL)) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, x));
                return;
            }
            code = 0;
        } else if (fn >= 0 && nodes[e].kind == parse.N_NAME && (nodes[e].flags & parse.F_PAREN) == 0 &&
                resolve.size_index(src, toks, nodes, fn, nodes[e].tok as I64) >= 0) {
            code = resolve.SIZE_CODE + resolve.size_index(src, toks, nodes, fn, nodes[e].tok as I64);
        } else {
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, e, fold.TY_I64);
            return;
        }
    } else if (step == 2) {
        if (is_const(sem, e)) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, e, 0);
            return;
        }
        Bool sized = size_expression(toks, nodes, sem, syms, wk, diag, rs, cs, e);
        if (rs[0].err != 0) { return; }
        Bool kparam = fn >= 0 && nodes[fn].kind == parse.N_KERNEL;
        if ((kparam && sized) || (wh == WHERE_LOCAL && rs[0].ctx == resolve.CTX_FUNCTION && sized)) {
            code = 0;
        } else if ((wh == WHERE_LOCAL && rs[0].ctx == resolve.CTX_KERNEL) || wh == WHERE_VIEW) {
            // `cint_ref` refuses these: no clause gives the diagnostic (box 09 note 8.3).
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, e));
            return;
        } else {
            resolve.fail(toks, diag, rs, resolve.C_CONST_REQUIRED, first(nodes, e));
            return;
        }
    } else {
        I64 v = sem[e].bits as% I64;
        if (v < 0) {
            resolve.fail(toks, diag, rs, C_NEGATIVE_EXTENT, first(nodes, e));
            return;
        }
        I64 most = resolve.ARRAY_EXTENT_MAX;
        if (resolve.array_rank(sem[x].ty) > 1) {
            most = resolve.NARRAY_EXTENT_MAX;
        }
        code = v + 1;
        if (v > most && most == resolve.ARRAY_EXTENT_MAX && v <= resolve.BIG_EXTENT_MAX && wh == WHERE_LOCAL &&
                rs[0].ctx == resolve.CTX_FUNCTION) {
            // A local array's storage from the frame arena (decision 2026-10-06 on OQ-213).
            code = resolve.BIG_CODE + v;
        } else if (v > most) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, e));
            return;
        }
    }
    I64 ty = resolve.with_dim(sem[x].ty, d, code);
    if (ty == 0) {
        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, e));
        return;
    }
    sem[x].ty = ty;
    wk[f].b = nodes[e].next;
    wk[f].c = (d + 1) as I32;
    wk[f].state = 1;
    if (step == 2 && fn >= 0 && nodes[fn].kind == parse.N_KERNEL &&
            (shape_form(nodes, e) == 3 || shape_form(nodes, e) == 4)) {
        // The literal of `n + c` folds, so that shape expressions compare by value (K-8).
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, nodes[e].b as I64, 0);
    }
}

// Format specifications (SPEC-04 LS-202 to LS-213), checked as `cint_ref`'s check_holes and
// fmt.check do, after the hole's type and before its fold. The gate admits no conversion.
const I64 C_FORMAT_PRECISION = 1036;
const I64 C_FORMAT = 1037;

// The layout rules every type shares: `0` with an alignment, and a width with neither an
// alignment nor `0` (decision 2026-10-03 on OQ-131).
I64 format_layout(in I64[_] sp) {
    Bool aligned = sp[parse.FS_ALIGN] != 0;
    Bool zero = sp[parse.FS_ZERO] != 0;
    if ((zero && aligned) || (sp[parse.FS_WIDTH] >= 0 && !aligned && !zero)) {
        return C_FORMAT;
    }
    return 0;
}

// The first rule of LS-213 that specification sp (none when has is false) breaks for a value
// of type ty, in fmt.check's order: C1036 for a precision with a scale on an integer, C1037
// for any other, or 0. Only fill, alignment and width apply to Bool, and a type that is not
// an integer or Bool is C1037 with or without a specification.
I64 format_rule(in I64[_] sp, Bool has, I64 ty) {
    if (ty != fold.TY_BOOL && !resolve.is_int(ty)) {
        return C_FORMAT;
    }
    if (!has) {
        return 0;
    }
    Bool sign_flag = sp[parse.FS_SIGN] != 0;
    Bool alt = sp[parse.FS_ALT] != 0;
    Bool zero = sp[parse.FS_ZERO] != 0;
    Bool group = sp[parse.FS_GROUP] != 0;
    Bool precision = sp[parse.FS_PRECISION] >= 0;
    Bool scale = sp[parse.FS_SCALE] >= 0;
    I64 k = sp[parse.FS_KIND];
    if (ty == fold.TY_BOOL) {
        if (sign_flag || alt || zero || group || precision || k != 0 || scale) {
            return C_FORMAT;
        }
        return format_layout(sp);
    }
    if (k == 0) {
        k = 'd';
    }
    Bool radix = k == 'x' || k == 'X' || k == 'o' || k == 'b';
    if (precision && scale) {
        return C_FORMAT_PRECISION;
    }
    if (precision || k == 's' || (k == 't' && (alt || sign_flag || group || zero)) ||
            (radix && sp[parse.FS_GROUP] == ',') || (k == 'c' && (alt || zero || group || sign_flag)) ||
            (alt && k == 'd') || (scale && (k != 'd' || alt || group)) || (zero && group)) {
        return C_FORMAT;
    }
    return format_layout(sp);
}

// Checks hole h of type ty: C1037 or C1036 at the hole for a specification that is malformed
// or does not apply to the value's type (the element type for an array), and C9102 there for
// a width that does not fit I64. An array of structs is left to lowering, which refuses it,
// as `cint_ref` refuses it before reading the specification. False after an error.
Bool format_ok[r](in U8[_] src, in parse.Node[_] nodes, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs, I64 h, I64 ty) {
    I64 et = ty;
    if (resolve.is_array(ty)) {
        et = resolve.array_elem(ty);
        if (resolve.is_struct(et)) {
            return true;
        }
    }
    I64[11] sp;
    Bool has = nodes[h].c >= 0;
    I64 code = 0;
    if (has && !parse.format_spec(src, nodes[h].c as I64, nodes[h].d as I64, sp)) {
        code = C_FORMAT;
    } else {
        code = format_rule(sp, has, et);
    }
    if (code == 0 && has && sp[parse.FS_WIDE] != 0) {
        code = resolve.C_UNSUPPORTED;
    }
    if (code != 0) {
        resolve.fail_at(diag, rs, code, nodes[h].e as I64, nodes[h].f as I64, 0, 0);
        return false;
    }
    return true;
}

// Whether a kernel's private array of type t is admitted (`cint_ref` _stmt_VarDecl): scalar
// elements, static extents, at most 4,096 bytes (SPEC-04 LS-110).
Bool private_array_ok(I64 t) {
    I64 e = resolve.array_elem(t);
    if (resolve.is_struct(e)) {
        return false;
    }
    I64 bytes = scalar_bytes(e);
    if (e == fold.TY_BOOL) {
        bytes = 1;
    }
    for d in 0..resolve.array_rank(t) {
        I64 n = resolve.dim_extent(t, d);
        if (n < 0) {
            return false;
        }
        if (n > 0 && bytes > 4096 / n) {
            return false;
        }
        bytes = bytes * n;
    }
    return bytes <= 4096;
}

// A local view variable `in T[...] v = x;` or `inout T[...] v = x;` (`cint_ref` _view_decl;
// SPEC-04 LS-69, LS-106, LS-162), statement x at step `step` of frame f: outside a kernel
// (C9102 there, as `cint_ref` refuses it), an array type whose extents are constants or
// `_`, an initializer that is an array of that element type and rank (C2001, C2012)
// rooted at a variable (C9102 otherwise), writable for `inout` (C2067 at the
// initializer), its place folded then the whole. The view's type has the declared static
// extents and the initializer's elsewhere; its symbol is SK_VIEW, SF_INOUT for `inout`.
void h_view_var[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f, I64 step) {
    I64 x = wk[f].node as I64;
    I64 a = nodes[x].a as I64;
    I64 b = nodes[x].b as I64;
    if (step == 0) {
        if (rs[0].ctx == resolve.CTX_KERNEL) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, x));
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_TYPE, a, WHERE_VIEW);
    } else if (step == 1) {
        if (!resolve.is_array(sem[a].ty)) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, a));
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, b, sem[a].ty);
    } else if (step == 2) {
        if (place_root(nodes, sem, syms, decls, b) < 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, b));
            return;
        }
        if (nodes[x].op == scan.KW_INOUT && !writable_view(nodes, sem, syms, decls, b)) {
            resolve.fail(toks, diag, rs, C_NOT_WRITABLE, first(nodes, b));
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_PLACE, b, 0);
    } else if (step == 3) {
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, b, 0);
    } else {
        I64 t = sem[a].ty;
        I64 got = sem[b].ty;
        I64[4] code;
        for d in 0..4 {
            code[d] = 0;
            if (d < resolve.array_rank(t)) {
                code[d] = resolve.dim_code(got, d);
                if (resolve.dim_extent(t, d) >= 0) {
                    code[d] = resolve.dim_code(t, d);
                }
            }
        }
        sem[x].ty = resolve.shaped(resolve.elem_code(t), resolve.array_rank(t), code[0], code[1], code[2], code[3]);
        I64 sy = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_VIEW, sem[x].ty, x, tok_of(nodes, x));
        if (sy < 0) {
            return;
        }
        if (nodes[x].op == scan.KW_INOUT) {
            syms[sy].flags = syms[sy].flags | resolve.SF_INOUT;
        }
        sem[x].sym = sy;
        pop(cs);
    }
}

// K_STMT on frame f: statement node x (`cint_ref` Checker._stmt_*).
void h_stmt[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 step = wk[f].state as I64;
    wk[f].state = (step + 1) as I32;
    I32 k = nodes[x].kind;
    I64 a = nodes[x].a as I64;
    I64 b = nodes[x].b as I64;
    I64 c = nodes[x].c as I64;
    I64 d = nodes[x].d as I64;
    I64 tok = tok_of(nodes, x);
    if (step == 0) {
        set_completes(sem, x, true);
    }
    switch (k) {
        case parse.N_BLOCK:
            wk[f].kind = K_BLOCK;
            wk[f].state = 0;
        case parse.N_SWITCH:
            wk[f].kind = K_SWITCH;
            wk[f].state = 0;
        case parse.N_VAR:
            Bool constant = (nodes[x].flags & parse.F_CONST) != 0;
            if (nodes[x].op == scan.KW_IN || nodes[x].op == scan.KW_INOUT) {
                h_view_var(src, toks, nodes, sem, syms, names, decls, wk, diag, rs, cs, f, step);
                return;
            }
            if (step == 0) {
                if (nodes[a].kind == parse.N_TYPE && nodes[a].c >= 0) {
                    // An arena or pool declaration is module-level (box 12; SPEC-03 M-20).
                    resolve.fail(toks, diag, rs, parse.C_STATEMENT_FORM, first(nodes, x));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_TYPE, a, WHERE_LOCAL);
            } else if (step == 1) {
                I64 t = sem[a].ty;
                if (rs[0].err != 0) {
                    return;
                }
                if (resolve.is_mem(t) && b < 0) {
                    if (!resolve.is_handle(t)) {
                        // An arena or pool local names one, so `cint_ref` refuses it without an
                        // initializer: no clause gives the diagnostic (ref/OPEN.md REF-OQ-45).
                        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok);
                        return;
                    }
                    // A handle without an initializer is the null handle (SPEC-03 M-12).
                    sem[x].ty = t;
                    sem[x].sym = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_VAR, t, x, tok);
                    pop(cs);
                    return;
                }
                if (resolve.is_struct(t) && rs[0].ctx == resolve.CTX_KERNEL) {
                    // `cint_ref` refuses a private struct in a kernel body, at its name.
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok);
                    return;
                }
                if (resolve.is_struct(t) && rs[0].ctx != resolve.CTX_FUNCTION) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, a));
                    return;
                }
                sem[x].ty = t;
                if (resolve.is_array(t) && (constant || (rs[0].ctx != resolve.CTX_FUNCTION &&
                        rs[0].ctx != resolve.CTX_KERNEL))) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, a));
                    return;
                }
                if (resolve.is_array(t) && rs[0].ctx == resolve.CTX_KERNEL && !private_array_ok(t)) {
                    // `cint_ref` refuses these: no clause gives the position (LS-110, C5029).
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok);
                    return;
                }
                if (b < 0 && (resolve.is_array(t) || resolve.is_struct(t))) {
                    if (holds_set(nodes, sem, syms, wk, cs, t)) {
                        // Zero fill would make an error value 0, which none is (LS-314).
                        resolve.fail(toks, diag, rs, resolve.C_ZERO_FILL, first(nodes, x));
                        return;
                    }
                    sem[x].sym = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_VAR, t, x, tok);
                    pop(cs);
                    return;
                }
                if (b < 0) {
                    resolve.fail(toks, diag, rs, resolve.C_UNINITIALIZED, tok);
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, b, t);
            } else if (step == 2) {
                if (constant && !is_const(sem, b)) {
                    resolve.fail(toks, diag, rs, resolve.C_CONST_REQUIRED, first(nodes, b));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, b, 0);
            } else {
                I64 kind = resolve.SK_VAR;
                if (constant) {
                    kind = resolve.SK_CONST;
                }
                I64 sy = resolve.declare(src, toks, syms, names, diag, rs, kind, sem[x].ty, x, tok);
                if (sy < 0) {
                    return;
                }
                sem[x].sym = sy;
                syms[sy].value = sem[b].bits;
                pop(cs);
            }
        case parse.N_ASSIGN, parse.N_INCDEC:
            if (step == 0) {
                I32 tk = nodes[a].kind;
                if (tk == parse.N_TYPENAME) {
                    resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, a));
                    return;
                }
                if ((tk == parse.N_INDEX || tk == parse.N_FIELD) && nodes[nodes[a].a as I64].kind != parse.N_NAME &&
                        !field_element(nodes, a) && !record_place(nodes, a) && chain_root(nodes, a) >= 0) {
                    // A longer place rooted at a variable (`s[0].h[0]`, `a.b.c`; task 2.14).
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, a));
                    return;
                }
                if (tk == parse.N_INDEX && nodes[nodes[a].a as I64].kind != parse.N_NAME && !field_element(nodes, a) &&
                        !index_chain(nodes, a)) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_PLACE, first(nodes, a));
                    return;
                }
                if (tk == parse.N_FIELD && !record_place(nodes, a)) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, a));
                    return;
                }
                if (tk != parse.N_NAME && tk != parse.N_INDEX && tk != parse.N_FIELD) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_PLACE, first(nodes, a));
                    return;
                }
                // The target's root name is written, not read (`cint_ref` _place: `_write`).
                I64 wr = a;
                while (nodes[wr].kind == parse.N_INDEX || nodes[wr].kind == parse.N_FIELD) {
                    wr = nodes[wr].a as I64;
                }
                if (nodes[wr].kind == parse.N_NAME) {
                    sem[wr].flags = sem[wr].flags | SEM_WRITE;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
                return;
            }
            if (step == 1) {
                I64 root = a;
                while (nodes[root].kind == parse.N_INDEX || nodes[root].kind == parse.N_FIELD) {
                    root = nodes[root].a as I64;
                }
                I64 kind = resolve.SK_MODVAR;
                if (nodes[a].kind == parse.N_FIELD && (sem[a].flags & resolve.SEM_IMPORT) != 0) {
                    // `alias.x`: an imported variable is a place, an imported constant is not.
                    if (decls[sem[a].lit_at].kind != limits.DK_VAR) {
                        kind = resolve.SK_CONST;
                    }
                } else {
                    kind = syms[sem[root].sym].kind;
                }
                if (rs[0].ctx == resolve.CTX_KERNEL && kind == resolve.SK_PARAM &&
                        (syms[sem[root].sym].flags & (resolve.SF_OUT | resolve.SF_INOUT)) != 0) {
                    // A write of a kernel's `out` or `inout` array (`cint_ref` _place): an
                    // element by plain assignment (C9102 otherwise; a scalar `out` is written
                    // by its `reduce` statement), at the work-item's indices (K-10, C5031),
                    // the target folded.
                    if (!resolve.is_array(syms[sem[root].sym].ty) || k == parse.N_INCDEC ||
                            nodes[x].op != scan.OP_ASSIGN) {
                        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, a));
                        return;
                    }
                    if ((sem[root].flags & resolve.SEM_ELEMENT) == 0 &&
                            !write_rule_ok(src, toks, nodes, sem, syms, wk[cs[0].base].node as I64, a, root)) {
                        resolve.fail(toks, diag, rs, C_WRITE_RULE, first(nodes, a));
                        return;
                    }
                    wk[f].state = 5;
                    _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, a, 0);
                    return;
                }
                I64 code = 0;
                if (kind == resolve.SK_PARAM && (syms[sem[root].sym].flags & resolve.SF_INOUT) != 0) {
                    code = 0;
                } else if (kind == resolve.SK_PARAM) {
                    code = resolve.C_PARAM_ASSIGNED;
                } else if (kind == resolve.SK_LOOPVAR) {
                    code = resolve.C_LOOP_VAR;
                } else if (kind == resolve.SK_CONST) {
                    code = resolve.C_NOT_PLACE;
                }
                if (kind == resolve.SK_VIEW && (syms[sem[root].sym].flags & resolve.SF_INOUT) == 0) {
                    // `cint_ref` refuses a write through an `in` view: no clause gives it.
                    code = resolve.C_UNSUPPORTED;
                }
                if (code == 0 && root == a && resolve.is_mem(sem[a].ty) && !resolve.is_handle(sem[a].ty)) {
                    // An arena or pool name is not rebound, as a view variable is not (box 12;
                    // SPEC-04 LS-107).
                    code = resolve.C_NOT_PLACE;
                }
                if (code != 0) {
                    resolve.fail(toks, diag, rs, code, first(nodes, a));
                    return;
                }
                if (kind == resolve.SK_MODVAR) {
                    // A write of a module-level variable by name: its item, for state_args.
                    sem[x].lit_at = wk[cs[0].base].node as I64;
                }
                // The target's constant index items and slice bounds fold before the value is
                // checked (`cint_ref` _place).
                wk[f].state = 5;
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, a, 0);
                return;
            }
            if (step == 5) {
                I64 t = sem[a].ty;
                sem[x].ty = t;
                I32 op = nodes[x].op;
                if (k == parse.N_INCDEC || op != scan.OP_ASSIGN) {
                    if (!resolve.is_int(t)) {
                        resolve.fail(toks, diag, rs, use_code(sem, a, resolve.C_NO_OPERATOR), first(nodes, a));
                        return;
                    }
                }
                if (k == parse.N_INCDEC) {
                    pop(cs);
                } else if (op == scan.OP_SHL_ASSIGN || op == scan.OP_SHR_ASSIGN || op == scan.OP_SHL_WRAP_ASSIGN) {
                    wk[f].state = 2;
                    _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, b, 0);
                } else {
                    wk[f].state = 3;
                    _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, b, t);
                }
                return;
            }
            if (step == 2) {
                if (sem[b].ty == resolve.TY_NONE) {
                    settle(toks, nodes, sem, wk, diag, rs, cs, b, fold.TY_I64);
                    if (rs[0].err != 0) {
                        return;
                    }
                }
                if (sem[b].ty != resolve.TY_NONE && !resolve.is_int(sem[b].ty)) {
                    resolve.fail(toks, diag, rs, use_code(sem, b, resolve.C_NO_OPERATOR), first(nodes, b));
                    return;
                }
                wk[f].state = 4;
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, b, 0);
                return;
            }
            if (step == 3 && resolve.is_array(sem[x].ty)) {
                // An array assignment copies (SPEC-04 LS-70): its source's place folds, then
                // C5010 when the two may overlap and differ (`cint_ref` _static_copy_alias).
                wk[f].state = 6;
                _ = push(toks, nodes, wk, diag, rs, cs, K_PLACE, b, 0);
                return;
            }
            if (step == 3 || step == 6) {
                if (step == 6) {
                    static_copy_alias(toks, nodes, sem, syms, wk, diag, rs, cs, a, b);
                    if (rs[0].err != 0) {
                        return;
                    }
                }
                wk[f].state = 4;
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, b, 0);
                return;
            }
            pop(cs);
        case parse.N_EXPR_STMT, parse.N_DISCARD:
            if (step == 0) {
                if (k == parse.N_DISCARD) {
                    // `_ = e` consumes an error union (LS-95).
                    sem[a].flags = sem[a].flags | resolve.SEM_UNION_OK;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
            } else if (step == 1) {
                I64 t = sem[a].ty;
                if (t == resolve.TY_DOTNAME) {
                    resolve.fail(toks, diag, rs, resolve.C_NO_CONTEXT, first(nodes, a));
                    return;
                }
                if (t == resolve.TY_NONE) {
                    settle(toks, nodes, sem, wk, diag, rs, cs, a, fold.TY_I64);
                    if (rs[0].err != 0) {
                        return;
                    }
                }
                if (k == parse.N_EXPR_STMT && t != resolve.TY_VOID) {
                    resolve.fail(toks, diag, rs, resolve.C_RESULT_UNUSED, first(nodes, a));
                    return;
                }
                if (k == parse.N_DISCARD && t == resolve.TY_VOID) {
                    resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, a));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, a, 0);
            } else {
                pop(cs);
            }
        case parse.N_PRINT, parse.N_MESSAGE:
            // Frame: b the next part, c the hole being checked. An assert's message is
            // checked as a print statement's text (`cint_ref` check_holes), but it is never
            // evaluated (LS-191), so its holes fold as skipped operands.
            if (step == 0) {
                if (k == parse.N_PRINT && rs[0].ctx == resolve.CTX_KERNEL) {
                    resolve.fail(toks, diag, rs, C_KERNEL_PRINT, tok);
                    return;
                }
                wk[f].b = a as I32;
            }
            if (wk[f].c > 0) {
                I64 h = wk[f].c as I64 - 1;
                I64 e = nodes[h].a as I64;
                if (wk[f].d == 0) {
                    if (sem[e].ty == resolve.TY_NONE) {
                        settle(toks, nodes, sem, wk, diag, rs, cs, e, fold.TY_I64);
                        if (rs[0].err != 0) {
                            return;
                        }
                    }
                    if (sem[e].ty == resolve.TY_VOID) {
                        resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, e));
                        return;
                    }
                    I64 et = sem[e].ty;
                    if (resolve.is_array(et)) {
                        et = resolve.array_elem(et);
                    }
                    if (resolve.is_errset(et) || et == resolve.TY_DOTNAME) {
                        // How a print statement shows an error value is not specified yet
                        // (compiler/OPEN.md CINTC-OQ-15).
                        resolve.fail_at(diag, rs, resolve.C_UNSUPPORTED, nodes[h].e as I64, nodes[h].f as I64, 0, 0);
                        return;
                    }
                    sem[h].ty = ety(sem, e);
                    if (!format_ok(src, nodes, diag, rs, h, sem[h].ty)) {
                        return;
                    }
                    wk[f].d = 1;
                    I64 skipped = 0;
                    if (k == parse.N_MESSAGE) {
                        skipped = 1;
                    }
                    _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, e, skipped);
                    return;
                }
                wk[f].c = 0;
            }
            I64 part = wk[f].b as I64;
            while (part >= 0 && nodes[part].kind != parse.N_HOLE) {
                part = nodes[part].next as I64;
            }
            if (part < 0) {
                pop(cs);
                return;
            }
            wk[f].b = nodes[part].next;
            wk[f].c = (part + 1) as I32;
            wk[f].d = 0;
            _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, nodes[part].a as I64, 0);
        case parse.N_IF:
            // Frame: b the current arm, c 1 once a block can complete, d the phase: 0 the
            // arm's condition, 1 its fold, 2 its block, 3 after it, 4 the else block, 5
            // after it, 6 done.
            if (step == 0) {
                wk[f].b = a as I32;
                wk[f].d = 0;
            }
            I64 arm = wk[f].b as I64;
            I64 phase = wk[f].d as I64;
            wk[f].d = (phase + 1) as I32;
            if (phase == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, nodes[arm].a as I64, 0);
            } else if (phase == 1) {
                I64 cond = nodes[arm].a as I64;
                if (sem[cond].ty != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, cond));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, cond, 0);
            } else if (phase == 2) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, nodes[arm].b as I64, 0);
            } else if (phase == 3) {
                if (completes(sem, nodes[arm].b as I64)) {
                    wk[f].c = 1;
                }
                wk[f].b = nodes[arm].next;
                if (wk[f].b >= 0) {
                    wk[f].d = 0;
                } else if (b < 0) {
                    wk[f].d = 6;
                }
            } else if (phase == 4) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, b, 0);
            } else if (phase == 5) {
                if (completes(sem, b)) {
                    wk[f].c = 1;
                }
            } else {
                set_completes(sem, x, b < 0 || wk[f].c == 1);
                pop(cs);
            }
        case parse.N_WHILE:
            if (step == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
            } else if (step == 1) {
                if (sem[a].ty != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, a));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, a, 0);
            } else if (step == 2) {
                loop_enter(src, toks, names, diag, rs, label_of(nodes, x), 1);
                _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, b, 0);
            } else {
                loop_enter(src, toks, names, diag, rs, label_of(nodes, x), -1);
                pop(cs);
            }
        case parse.N_FOR:
            if (step == 0) {
                wk[f].a = resolve.scope_open(rs) as I32;
                if (a >= 0) {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_STMT, a, 0);
                }
            } else if (step == 1) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, b, 0);
            } else if (step == 2) {
                if (sem[b].ty != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, b));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, b, 0);
            } else if (step == 3) {
                if (c >= 0) {
                    _ = push(toks, nodes, wk, diag, rs, cs, K_STMT, c, 0);
                }
            } else if (step == 4) {
                loop_enter(src, toks, names, diag, rs, label_of(nodes, x), 1);
                _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, d, 0);
            } else {
                loop_enter(src, toks, names, diag, rs, label_of(nodes, x), -1);
                resolve.scope_close(syms, names, rs, wk[f].a as I64);
                pop(cs);
            }
        case parse.N_FOR_RANGE:
            h_for_range(src, toks, nodes, sem, syms, names, wk, diag, rs, cs, f);
        case parse.N_BREAK, parse.N_CONTINUE:
            set_completes(sem, x, false);
            I64 target = jump_frame(nodes, wk, cs, f, k == parse.N_CONTINUE, false);
            Bool inside = target >= 0;
            if (c >= 0) {
                I64 id = resolve.intern(src, toks, names, diag, rs, c);
                inside = id >= 0 && names[id].loops > 0;
            }
            if (!inside) {
                resolve.fail(toks, diag, rs, resolve.C_JUMP, tok);
                return;
            }
            I64 df = defer_frame(nodes, wk, cs, f);
            if (df >= 0) {
                // A jump out of a deferred statement (LS-187).
                I64 tf = target;
                if (c >= 0) {
                    tf = label_frame(src, toks, nodes, wk, cs, f, c);
                }
                if (tf < df) {
                    resolve.fail(toks, diag, rs, resolve.C_DEFER_LEAVES, tok);
                    return;
                }
            }
            if (c < 0 && k == parse.N_BREAK && wk[target].kind == K_SWITCH) {
                I64 sw = wk[target].node as I64;
                sem[sw].flags = sem[sw].flags | SEM_SWITCH_BREAK;
            }
            pop(cs);
        case parse.N_FALLTHROUGH:
            // A direct statement of a clause continues into the next clause; a nested one
            // runs as a no-op, so it completes (CINTC-OQ-47).
            set_completes(sem, x, f > cs[0].base && wk[f - 1].kind != K_CLAUSE);
            if (jump_frame(nodes, wk, cs, f, false, true) < 0) {
                resolve.fail(toks, diag, rs, resolve.C_FALLTHROUGH, tok);
                return;
            }
            pop(cs);
        case parse.N_RETURN:
            set_completes(sem, x, false);
            I64 want = cs[0].result;
            if (step == 0 && rs[0].ctx == resolve.CTX_KERNEL) {
                // `cint_ref` refuses a `return` in a kernel body (SPEC-02 K-11).
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok);
                return;
            }
            if (step == 0) {
                if (defer_frame(nodes, wk, cs, f) >= 0) {
                    resolve.fail(toks, diag, rs, resolve.C_DEFER_LEAVES, tok);
                    return;
                }
                if (a < 0 && resolve.is_errunion(want) && resolve.union_value(want) == resolve.TY_VOID) {
                    // `return;` in an `E!void` function: success (LS-190).
                    pop(cs);
                    return;
                }
                if (want == resolve.TY_VOID) {
                    if (a >= 0) {
                        resolve.fail(toks, diag, rs, resolve.C_RETURN_VALUE, first(nodes, a));
                        return;
                    }
                    pop(cs);
                    return;
                }
                if (a < 0) {
                    resolve.fail(toks, diag, rs, resolve.C_RETURN_VALUE, tok);
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, a, want);
            } else if (step == 1) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, a, 0);
            } else {
                pop(cs);
            }
        case parse.N_DEFER:
            // `defer` and `errdefer` (LS-185 to LS-189, LS-322). An `errdefer` is C4031 inside
            // a deferred statement, at a script's top level, and in a function whose result is
            // no error union; a test block admits it. The deferred statement is checked where
            // it is written. A declaration as the deferred statement is outside this
            // implementation (C9102).
            if (step == 0) {
                if (nodes[x].op == 1 && (defer_frame(nodes, wk, cs, f) >= 0 || rs[0].ctx != resolve.CTX_FUNCTION ||
                        (cs[0].in_test == 0 && !resolve.is_errunion(cs[0].result)))) {
                    resolve.fail(toks, diag, rs, resolve.C_ERRDEFER, tok);
                    return;
                }
                if (nodes[a].kind == parse.N_VAR) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, a));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_STMT, a, 0);
            } else {
                pop(cs);
            }
        case parse.N_ASSERT:
            // `cint_ref` _stmt_Assert: the condition inferred, Bool (C2002 at its first
            // token) and folded, then the message's holes (SPEC-04 LS-191); refused in a
            // kernel body (SPEC-02 K-11).
            if (step == 0 && rs[0].ctx == resolve.CTX_KERNEL) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok);
                return;
            }
            if (step == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
            } else if (step == 1) {
                if (sem[a].ty != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, a));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, a, 0);
            } else if (step == 2 && b >= 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_STMT, b, 0);
            } else {
                pop(cs);
            }
        case parse.N_REDUCE:
            h_reduce(src, toks, nodes, sem, syms, names, wk, diag, rs, cs, f, step);
        case parse.N_STATIC_ASSERT:
            if (step == 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, a, 0);
            } else if (step == 1) {
                if (sem[a].ty != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, a));
                    return;
                }
                if (!is_const(sem, a)) {
                    resolve.fail(toks, diag, rs, resolve.C_CONST_REQUIRED, first(nodes, a));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, a, 0);
            } else {
                if (sem[a].bits == 0) {
                    resolve.fail(toks, diag, rs, resolve.C_STATIC_ASSERT, tok);
                    return;
                }
                pop(cs);
            }
        default:
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok);
    }
}

// K_STMT on a range `for` (`cint_ref` _stmt_ForRange): both bounds inferred, then each
// checked to be I64 and folded; the step I64, constant and nonzero (C2053); then the loop
// variable in a new scope and the body. Frame a: the scope.
void h_for_range[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 step = wk[f].state as I64 - 1;
    I64 lo = nodes[x].c as I64;
    I64 hi = nodes[x].d as I64;
    I64 stp = nodes[x].e as I64;
    switch (step) {
        case 0: _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, lo, 0);
        case 1: _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, hi, 0);
        case 2:
            for i in 0..2 {
                I64 e = lo;
                if (i == 1) {
                    e = hi;
                }
                if (sem[e].ty == resolve.TY_NONE) {
                    settle(toks, nodes, sem, wk, diag, rs, cs, e, fold.TY_I64);
                    if (rs[0].err != 0) {
                        return;
                    }
                }
                if (sem[e].ty != resolve.TY_NONE && sem[e].ty != fold.TY_I64) {
                    resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, e));
                    return;
                }
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, lo, 0);
        case 3: _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, hi, 0);
        case 4:
            if (stp >= 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, stp, 0);
            } else {
                wk[f].state = 7;
            }
        case 5:
            if (sem[stp].ty == resolve.TY_NONE) {
                settle(toks, nodes, sem, wk, diag, rs, cs, stp, fold.TY_I64);
                if (rs[0].err != 0) {
                    return;
                }
            }
            if (sem[stp].ty != resolve.TY_NONE && sem[stp].ty != fold.TY_I64) {
                resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, stp));
                return;
            }
            if (!is_const(sem, stp)) {
                resolve.fail(toks, diag, rs, resolve.C_STEP, first(nodes, stp));
                return;
            }
            _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, stp, 0);
        case 6:
            if (sem[stp].bits == 0) {
                resolve.fail(toks, diag, rs, resolve.C_STEP, first(nodes, stp));
                return;
            }
        case 7:
            wk[f].a = resolve.scope_open(rs) as I32;
            I64 bind = nodes[x].a as I64;
            I64 sy = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_LOOPVAR, fold.TY_I64, bind,
                tok_of(nodes, bind));
            if (sy < 0) {
                return;
            }
            sem[bind].sym = sy;
            sem[bind].ty = fold.TY_I64;
            loop_enter(src, toks, names, diag, rs, label_of(nodes, x), 1);
            _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, nodes[x].f as I64, 0);
        default:
            loop_enter(src, toks, names, diag, rs, label_of(nodes, x), -1);
            resolve.scope_close(syms, names, rs, wk[f].a as I64);
            pop(cs);
    }
}

// K_BLOCK on frame f: the statements of block x in a new scope. Frame: a the scope, b the
// next statement, c 1 while every statement so far can complete, d the last statement.
void h_block[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    if (wk[f].state == 0) {
        wk[f].state = 1;
        wk[f].a = resolve.scope_open(rs) as I32;
        wk[f].b = nodes[x].a;
        if (wk[f].kind == K_CLAUSE) {
            wk[f].b = nodes[x].b;
        }
        wk[f].c = 1;
    } else if (wk[f].d >= 0 && !completes(sem, wk[f].d as I64)) {
        wk[f].c = 0;
    }
    I64 st = wk[f].b as I64;
    if (st < 0) {
        resolve.scope_close(syms, names, rs, wk[f].a as I64);
        set_completes(sem, x, wk[f].c == 1);
        pop(cs);
        return;
    }
    wk[f].d = st as I32;
    wk[f].b = nodes[st].next;
    _ = push(toks, nodes, wk, diag, rs, cs, K_STMT, st, 0);
}

// ---------------------------------------------------------------- kernels (box 09)
//
// SPEC-02 K-1 to K-12, R-1 to R-3 and A-8; SPEC-04 LS-244 to LS-251; box 09 rulings R7 to R9
// and OQ-203: `cint_ref` kernel_signature, check_kernel, _element_form, _write_rule,
// _coverage, _stmt_Reduce, _dispatch, _kernel_static_shapes and _kernel_static_alias. A
// rule that `cint_ref` refuses without a diagnostic is C9102 here.

const I64 C_KERNEL_PRINT = 5020;
const I64 C_KERNEL_DISPATCH = 5023;
const I64 C_KERNEL_MODVAR = 5025;
const I64 C_KERNEL_TYPE = 5028;
const I64 C_WRITE_RULE = 5031;
// A scalar `out` that a `reduce` statement targets (symbol flag).
const I64 SF_REDUCED = 8;
// The root name of an assignment's target (`cint_ref` _write): a write, not a read of `out`.
const I64 SEM_WRITE = 262144;

// Whether tokens p and q spell the same text.
Bool same_word[n](in U8[n] src, in scan.Token[_] toks, I64 p, I64 q) {
    return toks[p].len == toks[q].len && resolve.same_text(src, toks[p].start as I64, toks[q].start as I64,
        toks[q].len as I64);
}

// The form of shape expression e of SPEC-02 K-1 (`cint_ref` shape_key): 1 a name, 2 an
// integer literal, 3 `name + c`, 4 `name - c`, the names and sums not in parentheses; 0 for
// any other expression.
I64 shape_form(in parse.Node[_] nodes, I64 e) {
    I32 k = nodes[e].kind;
    if (k == parse.N_LIT) {
        if (nodes[e].op == scan.TK_INT) {
            return 2;
        }
        return 0;
    }
    if ((nodes[e].flags & parse.F_PAREN) != 0) {
        return 0;
    }
    if (k == parse.N_NAME) {
        return 1;
    }
    if (k == parse.N_BINARY && (nodes[e].op == scan.OP_ADD || nodes[e].op == scan.OP_SUB)) {
        I64 l = nodes[e].a as I64;
        I64 r = nodes[e].b as I64;
        if (nodes[l].kind == parse.N_NAME && (nodes[l].flags & parse.F_PAREN) == 0 && nodes[r].kind == parse.N_LIT &&
                nodes[r].op == scan.TK_INT) {
            if (nodes[e].op == scan.OP_ADD) {
                return 3;
            }
            return 4;
        }
    }
    return 0;
}

// The literal node of shape expression e that shape_same compares by value, or -1.
I64 shape_literal(in parse.Node[_] nodes, I64 e) {
    I64 fe = shape_form(nodes, e);
    if (fe == 2) {
        return e;
    }
    if (fe == 3 || fe == 4) {
        return nodes[e].b as I64;
    }
    return -1;
}

// Whether shape expressions e and g are the same symbol for symbol (`cint_ref` compares
// shape_key values; K-8): their literals are folded.
Bool shape_same[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 e,
        I64 g) {
    I64 fe = shape_form(nodes, e);
    if (fe == 0 || fe != shape_form(nodes, g)) {
        return false;
    }
    if (fe == 1) {
        return same_word(src, toks, tok_of(nodes, e), tok_of(nodes, g));
    }
    if (fe == 2) {
        return sem[e].bits == sem[g].bits;
    }
    return same_word(src, toks, tok_of(nodes, nodes[e].a as I64), tok_of(nodes, nodes[g].a as I64)) &&
        sem[nodes[e].b as I64].bits == sem[nodes[g].b as I64].bits;
}

// Extent node j of the type of parameter p (an array), or -1.
I64 param_extent(in parse.Node[_] nodes, I64 p, I64 j) {
    I64 ty = nodes[p].a as I64;
    if (nodes[ty].a < 0) {
        return -1;
    }
    I64 e = nodes[nodes[ty].a as I64].a as I64;
    I64 i = 0;
    while (e >= 0 && i < j) {
        e = nodes[e].next as I64;
        i += 1;
    }
    return e;
}

// Whether parameter p of a kernel is written: `out` or `inout`.
Bool written_mode(in parse.Node[_] nodes, I64 p) {
    return nodes[p].op == scan.KW_OUT || nodes[p].op == scan.KW_INOUT;
}

// The parameter of kernel kn that token tok names, or -1.
I64 kernel_param[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 kn, I64 tok) {
    I64 p = nodes[kn].b as I64;
    while (p >= 0) {
        if (same_word(src, toks, tok_of(nodes, p), tok)) {
            return p;
        }
        p = nodes[p].next as I64;
    }
    return -1;
}

// The number of work-item dimensions of kernel kn: its `over` items, or for the element
// form (first written parameter p0, else -1) the rank of p0.
I64 over_count(in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 kn, I64 p0) {
    if (p0 >= 0) {
        return resolve.array_rank(sem[p0].ty);
    }
    return list_length(nodes, nodes[kn].a as I64);
}

// The extent node of work-item dimension j of kernel kn (see over_count).
I64 over_extent(in parse.Node[_] nodes, I64 kn, I64 p0, I64 j) {
    if (p0 >= 0) {
        return param_extent(nodes, p0, j);
    }
    I64 ov = nodes[kn].a as I64;
    I64 i = 0;
    while (ov >= 0 && i < j) {
        ov = nodes[ov].next as I64;
        i += 1;
    }
    return nodes[ov].a as I64;
}

// Whether array parameters p and q of a kernel have the same extents, symbol for symbol.
Bool same_extents[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 p,
        I64 q) {
    I64 r = resolve.array_rank(sem[p].ty);
    if (r != resolve.array_rank(sem[q].ty)) {
        return false;
    }
    for j in 0..r {
        if (!shape_same(src, toks, nodes, sem, param_extent(nodes, p, j), param_extent(nodes, q, j))) {
            return false;
        }
    }
    return true;
}

// The array `out` or `inout` parameter of kernel kn that statement g assigns as a whole,
// `p = e;` (an element-form statement), or -1.
I64 element_target[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem, I64 kn,
        I64 g) {
    if (nodes[g].kind != parse.N_ASSIGN || nodes[g].op != scan.OP_ASSIGN) {
        return -1;
    }
    I64 t = nodes[g].a as I64;
    if (nodes[t].kind != parse.N_NAME) {
        return -1;
    }
    I64 p = kernel_param(src, toks, nodes, kn, tok_of(nodes, t));
    if (p < 0 || !resolve.is_array(sem[p].ty) || !written_mode(nodes, p)) {
        return -1;
    }
    return p;
}

// The element form of kernel kn, which has no `over` clause (`cint_ref` _element_form;
// SPEC-02 K-12): its body is whole-array assignments to `out` or `inout` parameters (C9102
// at the name otherwise), each array parameter it names has the extents of the first one
// written (C9102 at the name), and its values are elementwise: names, literals, operators,
// conversions and calls without a qualifier (C9102 at the first other expression, in
// source order). Returns the first parameter written, or -1 after an error.
I64 element_form[s, n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout parse.Frame[s] wk, inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, in CState[_] cs,
        I64 kn) {
    I64 st = nodes[nodes[kn].c as I64].a as I64;
    I64 g = st;
    if (g < 0) {
        resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, kn));
        return -1;
    }
    while (g >= 0) {
        if (element_target(src, toks, nodes, sem, kn, g) < 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, kn));
            return -1;
        }
        g = nodes[g].next as I64;
    }
    I64 p0 = element_target(src, toks, nodes, sem, kn, st);
    g = st;
    while (g >= 0) {
        I64 t = nodes[g].a as I64;
        if (!same_extents(src, toks, nodes, sem, element_target(src, toks, nodes, sem, kn, g), p0)) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, t));
            return -1;
        }
        // The value, depth first and left to right, in work rows from cs[0].sp.
        I64 base = cs[0].sp;
        I64 sp = base;
        if (sp >= s) {
            resolve.fail(toks, diag, rs, limits.C_NESTING, first(nodes, t));
            return -1;
        }
        wk[sp].node = nodes[g].b;
        sp += 1;
        while (sp > base) {
            sp -= 1;
            I64 e = wk[sp].node as I64;
            I32 k = nodes[e].kind;
            I64 nk = 0;
            I64[3] kids;
            if (k == parse.N_NAME) {
                I64 p = kernel_param(src, toks, nodes, kn, tok_of(nodes, e));
                if (p >= 0 && resolve.is_array(sem[p].ty) && !same_extents(src, toks, nodes, sem, p, p0)) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, e));
                    return -1;
                }
            } else if (k == parse.N_UNARY || k == parse.N_CONVERT) {
                kids[0] = nodes[e].a as I64;
                nk = 1;
            } else if (k == parse.N_BINARY || k == parse.N_COMPARE || k == parse.N_LOGICAL) {
                kids[0] = nodes[e].a as I64;
                kids[1] = nodes[e].b as I64;
                nk = 2;
            } else if (k == parse.N_COND) {
                kids[0] = nodes[e].a as I64;
                kids[1] = nodes[e].b as I64;
                kids[2] = nodes[e].c as I64;
                nk = 3;
            } else if (k == parse.N_CALL && nodes[nodes[e].a as I64].kind == parse.N_NAME) {
                I64 na = list_length(nodes, nodes[e].b as I64);
                if (sp + na > s) {
                    resolve.fail(toks, diag, rs, limits.C_NESTING, first(nodes, e));
                    return -1;
                }
                // The arguments, the first on top.
                I64 h = nodes[e].b as I64;
                I64 i = sp + na - 1;
                while (h >= 0) {
                    I64 v = h;
                    if (nodes[h].kind == parse.N_NAMEDARG) {
                        v = nodes[h].a as I64;
                    }
                    wk[i].node = v as I32;
                    i -= 1;
                    h = nodes[h].next as I64;
                }
                sp += na;
            } else if (k != parse.N_LIT && k != parse.N_NEGLIT && k != parse.N_BOOL && k != parse.N_TYPEPROP &&
                    k != parse.N_TYPENAME) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, e));
                return -1;
            }
            if (sp + nk > s) {
                resolve.fail(toks, diag, rs, limits.C_NESTING, first(nodes, e));
                return -1;
            }
            I64 j = nk - 1;
            while (j >= 0) {
                wk[sp].node = kids[j] as I32;
                sp += 1;
                j -= 1;
            }
        }
        g = nodes[g].next as I64;
    }
    return p0;
}

// The checks of kernel parameter p after its type (`cint_ref` kernel_signature; SPEC-04
// LS-246, SPEC-02 K-1, K-2): an array of integer elements (C5028 at the parameter) whose
// extents are shape expressions (C9102), or a scalar of an integer type (C5028) that is not
// `inout` (C2064). False after an error.
Bool kernel_param_ok(in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 p) {
    I64 t = sem[p].ty;
    I64 at = nodes[p].start as I64;
    if (resolve.is_array(t)) {
        if (!resolve.is_int(resolve.array_elem(t))) {
            resolve.fail(toks, diag, rs, C_KERNEL_TYPE, at);
            return false;
        }
        for j in 0..resolve.array_rank(t) {
            I64 e = param_extent(nodes, p, j);
            if (shape_form(nodes, e) == 0) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, e));
                return false;
            }
        }
        return true;
    }
    if (!resolve.is_int(t)) {
        resolve.fail(toks, diag, rs, C_KERNEL_TYPE, at);
        return false;
    }
    if (nodes[p].op == scan.KW_INOUT) {
        resolve.fail(toks, diag, rs, resolve.C_INOUT_SCALAR, at);
        return false;
    }
    return true;
}

// Whether a `where` constraint c is a comparison of two shape expressions (`cint_ref`
// check_kernel; SPEC-02 K-1): `<=`, `<`, `>=`, `>` or `==`.
Bool where_form(in parse.Node[_] nodes, I64 c) {
    if (nodes[c].kind != parse.N_COMPARE) {
        return false;
    }
    I32 op = nodes[c].op;
    if (op != scan.OP_LE && op != scan.OP_LT && op != scan.OP_GE && op != scan.OP_GT && op != scan.OP_EQ) {
        return false;
    }
    return shape_form(nodes, nodes[c].a as I64) != 0 && shape_form(nodes, nodes[c].b as I64) != 0;
}

// K-10 (`cint_ref` _write_rule; SPEC-04 LS-248): target x of an assignment to array `out`
// or `inout` parameter root, in kernel kn, is `p[v1, ..., vd, j...]` with the `over`
// variables in order as its leading indices and an index for every dimension.
Bool write_rule_ok[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        in resolve.Sym[_] syms, I64 kn, I64 x, I64 root) {
    if (nodes[x].kind != parse.N_INDEX || nodes[x].a as I64 != root) {
        return false;
    }
    I64 items = nodes[x].b as I64;
    if (list_length(nodes, items) != resolve.array_rank(syms[sem[root].sym].ty)) {
        return false;
    }
    I64 g = items;
    while (g >= 0) {
        if (nodes[g].kind == parse.N_SLICE) {
            return false;
        }
        g = nodes[g].next as I64;
    }
    I64 ov = nodes[kn].a as I64;
    g = items;
    while (ov >= 0) {
        if (g < 0 || nodes[g].kind != parse.N_NAME || !same_word(src, toks, tok_of(nodes, g), tok_of(nodes, ov))) {
            return false;
        }
        ov = nodes[ov].next as I64;
        g = nodes[g].next as I64;
    }
    return true;
}

// Whether statement s may leave the loop body it is in (`cint_ref` _may_exit): a `break`
// or `continue` outside any loop nested in s, or a labeled one anywhere in s. Work rows from
// sp: node the statement, a 1 inside a nested loop.
Bool may_exit[s](in parse.Node[_] nodes, inout parse.Frame[s] wk, I64 base, I64 s0) {
    I64 sp = base;
    if (sp >= s) {
        return true;
    }
    wk[sp].node = s0 as I32;
    wk[sp].a = 0;
    sp += 1;
    while (sp > base) {
        sp -= 1;
        I64 x = wk[sp].node as I64;
        I64 inner = wk[sp].a as I64;
        I32 k = nodes[x].kind;
        if (k == parse.N_BREAK || k == parse.N_CONTINUE) {
            if (inner == 0 || nodes[x].c >= 0) {
                return true;
            }
        }
        I64 mode = inner;
        if (k == parse.N_WHILE || k == parse.N_FOR || k == parse.N_FOR_RANGE) {
            mode = 1;
        }
        // The statements x holds.
        I64[4] lists;
        I64 nl = 0;
        I64[3] singles;
        I64 ns = 0;
        if (k == parse.N_BLOCK) {
            lists[0] = nodes[x].a as I64;
            nl = 1;
        } else if (k == parse.N_IF) {
            I64 arm = nodes[x].a as I64;
            while (arm >= 0) {
                if (sp + 1 > s) { return true; }
                wk[sp].node = nodes[arm].b;
                wk[sp].a = mode as I32;
                sp += 1;
                arm = nodes[arm].next as I64;
            }
            if (nodes[x].b >= 0) {
                singles[0] = nodes[x].b as I64;
                ns = 1;
            }
        } else if (k == parse.N_WHILE) {
            singles[0] = nodes[x].b as I64;
            ns = 1;
        } else if (k == parse.N_FOR_RANGE) {
            singles[0] = nodes[x].f as I64;
            ns = 1;
        } else if (k == parse.N_FOR) {
            singles[0] = nodes[x].d as I64;
            ns = 1;
        } else if (k == parse.N_SWITCH) {
            I64 cl = nodes[x].b as I64;
            while (cl >= 0) {
                I64 h = nodes[cl].b as I64;
                while (h >= 0) {
                    if (sp + 1 > s) { return true; }
                    wk[sp].node = h as I32;
                    wk[sp].a = mode as I32;
                    sp += 1;
                    h = nodes[h].next as I64;
                }
                cl = nodes[cl].next as I64;
            }
        }
        for i in 0..nl {
            I64 h = lists[i];
            while (h >= 0) {
                if (sp + 1 > s) { return true; }
                wk[sp].node = h as I32;
                wk[sp].a = mode as I32;
                sp += 1;
                h = nodes[h].next as I64;
            }
        }
        for i in 0..ns {
            if (singles[i] >= 0) {
                if (sp + 1 > s) { return true; }
                wk[sp].node = singles[i] as I32;
                wk[sp].a = mode as I32;
                sp += 1;
            }
        }
    }
    return false;
}

// Whether assignment g writes the owned block of array `out` parameter p (pattern 1 when
// depth is 0, else pattern 2 of SPEC-02 K-10a): `p[..., v1, ..., vk] = e;` whose indices
// after the first d are the loop variables lv[0..depth) in order, one per block dimension
// (blen of them).
Bool assign_covers[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 g, I64 p, I64 d,
        I64 blen, in I64[_] lv, I64 depth) {
    if (nodes[g].kind != parse.N_ASSIGN || nodes[g].op != scan.OP_ASSIGN) {
        return false;
    }
    I64 t = nodes[g].a as I64;
    if (nodes[t].kind != parse.N_INDEX) {
        return false;
    }
    I64 base = nodes[t].a as I64;
    if (nodes[base].kind != parse.N_NAME || !same_word(src, toks, tok_of(nodes, base), tok_of(nodes, p))) {
        return false;
    }
    I64 item = nodes[t].b as I64;
    I64 i = 0;
    while (item >= 0 && i < d) {
        item = nodes[item].next as I64;
        i += 1;
    }
    if (depth != blen || list_length(nodes, item) != blen) {
        return false;
    }
    I64 j = 0;
    while (item >= 0) {
        if (nodes[item].kind != parse.N_NAME || !same_word(src, toks, tok_of(nodes, item), lv[j])) {
            return false;
        }
        j += 1;
        item = nodes[item].next as I64;
    }
    return true;
}

// Coverage frames (work rows): COV_LIST a statement list (b the statement, step 0 to cover
// it, 1 after), COV_STMT a statement (step its phase, b the arm or clause).
const I64 COV_LIST = 1;
const I64 COV_STMT = 2;

// Whether the statements from g0 write every element of the owned block of array `out`
// parameter p of kernel kn, whose first d dimensions are the work-item's (`cint_ref`
// _covers and _covers_list; SPEC-02 K-10a): a covering write, unconditionally, in every
// arm of an `if` with an `else`, in every clause of a `switch` with a `default`, or in a
// nest of `for j in 0..E` loops, one per block dimension over its extent, with no
// statement before it that may leave such a loop. Work rows from cs[0].sp.
Bool covers[s, n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        inout parse.Frame[s] wk, in CState[_] cs, I64 kn, I64 p, I64 d, I64 g0) {
    I64 blen = resolve.array_rank(sem[p].ty) - d;
    I64[4] lv;
    for i in 0..4 {
        lv[i] = -1;
    }
    I64 base = cs[0].sp;
    I64 sp = base;
    if (sp >= s) {
        return false;
    }
    wk[sp].kind = COV_LIST as I32;
    wk[sp].node = -1;
    wk[sp].state = 0;
    wk[sp].a = 0;
    wk[sp].b = g0 as I32;
    sp += 1;
    Bool ret = false;
    while (sp > base) {
        I64 f = sp - 1;
        I64 depth = wk[f].a as I64;
        if (wk[f].kind as I64 == COV_LIST) {
            I64 st = wk[f].b as I64;
            if (wk[f].state == 0) {
                if (st < 0) {
                    ret = false;
                    sp -= 1;
                    continue;
                }
                if (sp >= s) {
                    return false;
                }
                wk[f].state = 1;
                wk[sp].kind = COV_STMT as I32;
                wk[sp].node = st as I32;
                wk[sp].state = 0;
                wk[sp].a = depth as I32;
                wk[sp].b = -1;
                sp += 1;
                continue;
            }
            if (ret) {
                sp -= 1;
                continue;
            }
            if (depth > 0 && may_exit(nodes, wk, sp, st)) {
                ret = false;
                sp -= 1;
                continue;
            }
            wk[f].b = nodes[st].next;
            wk[f].state = 0;
            continue;
        }
        I64 x = wk[f].node as I64;
        I32 k = nodes[x].kind;
        I64 phase = wk[f].state as I64;
        wk[f].state = (phase + 1) as I32;
        I64 list = -2;
        if (k == parse.N_ASSIGN) {
            ret = assign_covers(src, toks, nodes, x, p, d, blen, lv, depth);
            sp -= 1;
            continue;
        } else if (k == parse.N_BLOCK) {
            if (phase == 0) {
                list = nodes[x].a as I64;
            }
        } else if (k == parse.N_IF) {
            // Every arm's block, then the else block; false without an else.
            if (phase == 0) {
                if (nodes[x].b < 0) {
                    ret = false;
                    sp -= 1;
                    continue;
                }
                wk[f].b = nodes[x].a;
            } else if (!ret) {
                sp -= 1;
                continue;
            }
            I64 arm = wk[f].b as I64;
            if (arm >= 0) {
                wk[f].b = nodes[arm].next;
                list = nodes[nodes[arm].b as I64].a as I64;
            } else if (arm == -1) {
                wk[f].b = -2;
                list = nodes[nodes[x].b as I64].a as I64;
            }
        } else if (k == parse.N_SWITCH) {
            // Every clause, with a `default` among them.
            if (phase == 0) {
                Bool deflt = false;
                I64 cl = nodes[x].b as I64;
                while (cl >= 0) {
                    if ((nodes[cl].flags & parse.F_DEFAULT) != 0) {
                        deflt = true;
                    }
                    cl = nodes[cl].next as I64;
                }
                if (!deflt) {
                    ret = false;
                    sp -= 1;
                    continue;
                }
                wk[f].b = nodes[x].b;
            } else if (!ret) {
                sp -= 1;
                continue;
            }
            I64 cl = wk[f].b as I64;
            if (cl >= 0) {
                wk[f].b = nodes[cl].next;
                list = nodes[cl].b as I64;
            }
        } else if (k == parse.N_FOR_RANGE) {
            if (phase == 0) {
                I64 lo = nodes[x].c as I64;
                I64 hi = nodes[x].d as I64;
                Bool ok = depth < blen && nodes[x].e < 0 && nodes[x].op == scan.OP_RANGE && nodes[x].b < 0 &&
                    lo >= 0 && nodes[lo].kind == parse.N_LIT && sem[lo].bits == 0 && hi >= 0 &&
                    shape_same(src, toks, nodes, sem, hi, param_extent(nodes, p, d + depth));
                if (!ok) {
                    ret = false;
                    sp -= 1;
                    continue;
                }
                lv[depth] = tok_of(nodes, nodes[x].a as I64);
                wk[f].kind = COV_LIST as I32;
                wk[f].state = 0;
                wk[f].a = (depth + 1) as I32;
                wk[f].b = nodes[nodes[x].f as I64].a;
                continue;
            }
        } else {
            ret = false;
            sp -= 1;
            continue;
        }
        if (list == -2) {
            sp -= 1;
            continue;
        }
        if (sp >= s) {
            return false;
        }
        wk[sp].kind = COV_LIST as I32;
        wk[sp].node = -1;
        wk[sp].state = 0;
        wk[sp].a = depth as I32;
        wk[sp].b = list as I32;
        sp += 1;
    }
    return ret;
}

// The target of the first assignment in source order, nested statements included, whose
// place is rooted at a name spelled as token tok (`cint_ref` _first_write), or -1. Work
// rows from cs[0].sp.
I64 first_write[s, n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout parse.Frame[s] wk,
        in CState[_] cs, I64 g0, I64 tok) {
    I64 base = cs[0].sp;
    I64 sp = base;
    // Each row is a statement list, node its next statement.
    if (sp >= s) {
        return -1;
    }
    wk[sp].node = g0 as I32;
    sp += 1;
    while (sp > base) {
        I64 f = sp - 1;
        I64 x = wk[f].node as I64;
        if (x < 0) {
            sp -= 1;
            continue;
        }
        wk[f].node = nodes[x].next;
        I32 k = nodes[x].kind;
        if (k == parse.N_ASSIGN) {
            I64 r = nodes[x].a as I64;
            while (nodes[r].kind == parse.N_INDEX || nodes[r].kind == parse.N_FIELD) {
                r = nodes[r].a as I64;
            }
            if (nodes[r].kind == parse.N_NAME && same_word(src, toks, tok_of(nodes, r), tok)) {
                return nodes[x].a as I64;
            }
            continue;
        }
        // Inner statements, pushed so that the first comes out first: an `if`'s arms then
        // its else block, a switch's clauses, a loop's body. A row whose node is a block
        // stands for the block, whose next is -1.
        if (k == parse.N_BLOCK) {
            if (sp >= s) { return -1; }
            wk[sp].node = nodes[x].a;
            sp += 1;
        } else if (k == parse.N_IF) {
            I64 nk = list_length(nodes, nodes[x].a as I64) + 1;
            if (sp + nk > s) { return -1; }
            I64 i = sp + nk - 1;
            I64 arm = nodes[x].a as I64;
            while (arm >= 0) {
                wk[i].node = nodes[arm].b;
                i -= 1;
                arm = nodes[arm].next as I64;
            }
            wk[i].node = nodes[x].b;
            sp += nk;
        } else if (k == parse.N_SWITCH) {
            I64 nk = list_length(nodes, nodes[x].b as I64);
            if (sp + nk > s) { return -1; }
            I64 i = sp + nk - 1;
            I64 cl = nodes[x].b as I64;
            while (cl >= 0) {
                wk[i].node = nodes[cl].b;
                i -= 1;
                cl = nodes[cl].next as I64;
            }
            sp += nk;
        } else if (k == parse.N_WHILE || k == parse.N_FOR_RANGE) {
            if (sp >= s) { return -1; }
            I64 bd = nodes[x].b as I64;
            if (k == parse.N_FOR_RANGE) {
                bd = nodes[x].f as I64;
            }
            wk[sp].node = bd as I32;
            sp += 1;
        } else if (k == parse.N_FOR) {
            // Its initializer, body and update, in that order.
            if (sp + 3 > s) { return -1; }
            wk[sp].node = nodes[x].c;
            wk[sp + 1].node = nodes[x].d;
            wk[sp + 2].node = nodes[x].a;
            sp += 3;
        }
    }
    return -1;
}

// K_KERNEL on frame f: kernel node x (`cint_ref` check_kernel; SPEC-02 K-1 to K-12): its
// shape symbols in a scope of their own, the element form's checks when it has no `over`
// clause, C9102 for a kernel with no `out` or `inout` parameter, each `over` extent a shape
// expression (C9102) of type I64 (C2001), the leading extents of each written array
// parameter the `over` extents (K-8; C9102 at the parameter), each `where` constraint a
// comparison of shape expressions (C9102) checked as a condition and folded, then the
// `over` variables and the parameters, the body, a `reduce` statement for each scalar `out`
// (C9102 at the parameter), and the coverage of each array `out` (K-10a; C5031 at its
// first write, or at the parameter). The kernel's Sem row: lit_at the element form's first
// written parameter, or -1. Frame: a the scope, b the `over` item or `where` constraint,
// c the phase.
void h_kernel[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 body = nodes[x].c as I64;
    I64 phase = wk[f].c as I64;
    wk[f].c = (phase + 1) as I32;
    I64 p0 = sem[x].lit_at;
    if (phase == 0) {
        rs[0].ctx = resolve.CTX_KERNEL;
        rs[0].loops = 0;
        cs[0].result = resolve.TY_VOID;
        wk[f].a = (resolve.scope_open(rs)) as I32;
        I64 z = nodes[x].d as I64;
        while (z >= 0) {
            I64 sy = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_PARAM, fold.TY_I64, z,
                tok_of(nodes, z));
            if (sy < 0) {
                return;
            }
            sem[z].sym = sy;
            sem[z].ty = fold.TY_I64;
            z = nodes[z].next as I64;
        }
        sem[x].lit_at = -1;
        if (nodes[x].a < 0) {
            sem[x].lit_at = element_form(src, toks, nodes, sem, wk, diag, rs, cs, x);
            if (rs[0].err != 0) {
                return;
            }
        }
        Bool writes = false;
        I64 p = nodes[x].b as I64;
        while (p >= 0) {
            writes = writes || written_mode(nodes, p);
            p = nodes[p].next as I64;
        }
        if (!writes) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, x));
            return;
        }
        wk[f].b = nodes[x].a;
        return;
    }
    if (phase == 1 || phase == 2) {
        // The `over` items: phase 1 infers extent b, phase 2 settles it and folds its literal.
        I64 ov = wk[f].b as I64;
        if (ov >= 0) {
            I64 e = nodes[ov].a as I64;
            if (phase == 1) {
                if (shape_form(nodes, e) == 0) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, e));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, e, 0);
                return;
            }
            if (!settle_i64(toks, nodes, sem, wk, diag, rs, cs, e)) {
                return;
            }
            wk[f].b = nodes[ov].next;
            wk[f].c = 1;
            I64 lit = shape_literal(nodes, e);
            if (lit >= 0) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, lit, 0);
            }
            return;
        }
        // K-8: the leading extents of each written array parameter are the `over` extents.
        I64 d = over_count(nodes, sem, x, p0);
        I64 p = nodes[x].b as I64;
        while (p >= 0) {
            if (resolve.is_array(sem[p].ty) && written_mode(nodes, p)) {
                Bool ok = resolve.array_rank(sem[p].ty) >= d;
                for j in 0..d {
                    ok = ok && shape_same(src, toks, nodes, sem, over_extent(nodes, x, p0, j), param_extent(nodes, p, j));
                }
                if (!ok) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, p));
                    return;
                }
            }
            p = nodes[p].next as I64;
        }
        wk[f].b = nodes[x].e;
        wk[f].c = 3;
        return;
    }
    if (phase == 3 || phase == 4 || phase == 5) {
        // The `where` constraints: phase 3 infers constraint b, 4 folds it, 5 moves on.
        I64 c = wk[f].b as I64;
        if (c >= 0) {
            if (phase == 3) {
                if (!where_form(nodes, c)) {
                    resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, c));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, c, 0);
            } else if (phase == 4) {
                if (sem[c].ty != fold.TY_BOOL) {
                    resolve.fail(toks, diag, rs, resolve.C_NOT_BOOL, first(nodes, c));
                    return;
                }
                _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, c, 0);
            } else {
                wk[f].b = nodes[c].next;
                wk[f].c = 3;
            }
            return;
        }
        // The `over` variables, then the parameters, as `cint_ref` check_body declares them.
        if (p0 < 0) {
            I64 ov = nodes[x].a as I64;
            while (ov >= 0) {
                I64 sy = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_LOOPVAR, fold.TY_I64, ov,
                    tok_of(nodes, ov));
                if (sy < 0) {
                    return;
                }
                sem[ov].sym = sy;
                sem[ov].ty = fold.TY_I64;
                ov = nodes[ov].next as I64;
            }
        }
        I64 p = nodes[x].b as I64;
        while (p >= 0) {
            I64 sy = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_PARAM, sem[p].ty, p, tok_of(nodes, p));
            if (sy < 0) {
                return;
            }
            if (nodes[p].op == scan.KW_INOUT) {
                syms[sy].flags = syms[sy].flags | resolve.SF_INOUT;
            } else if (nodes[p].op == scan.KW_OUT) {
                syms[sy].flags = syms[sy].flags | resolve.SF_OUT;
            }
            sem[p].sym = sy;
            p = nodes[p].next as I64;
        }
        wk[f].c = 6;
        _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, body, 0);
        return;
    }
    resolve.scope_close(syms, names, rs, wk[f].a as I64);
    I64 p = nodes[x].b as I64;
    while (p >= 0) {
        if (nodes[p].op == scan.KW_OUT && !resolve.is_array(sem[p].ty) &&
                (syms[sem[p].sym].flags & SF_REDUCED) == 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, p));
            return;
        }
        p = nodes[p].next as I64;
    }
    I64 d = over_count(nodes, sem, x, p0);
    p = nodes[x].b as I64;
    while (p >= 0) {
        if (nodes[p].op == scan.KW_OUT && resolve.is_array(sem[p].ty)) {
            // The element form covers the parameters its statements assign, and only those.
            Bool ok = false;
            if (p0 >= 0) {
                I64 g = nodes[body].a as I64;
                while (g >= 0 && !ok) {
                    ok = element_target(src, toks, nodes, sem, x, g) == p;
                    g = nodes[g].next as I64;
                }
            } else {
                ok = covers(src, toks, nodes, sem, wk, cs, x, p, d, nodes[body].a as I64);
            }
            if (!ok) {
                I64 w = first_write(src, toks, nodes, wk, cs, nodes[body].a as I64, tok_of(nodes, p));
                I64 at = tok_of(nodes, p);
                if (w >= 0) {
                    at = first(nodes, w);
                }
                resolve.fail(toks, diag, rs, C_WRITE_RULE, at);
                return;
            }
        }
        p = nodes[p].next as I64;
    }
    pop(cs);
}

// The values of the shape symbols of kernel kn that the static extents of the array
// arguments from g0 bind, first binding first, in work rows from base (a the value, b 1 when
// bound). False when an array argument has an extent known at run time.
Bool kernel_sizes[s](in parse.Node[_] nodes, in resolve.Sem[_] sem, inout parse.Frame[s] wk, I64 base, I64 kn, I64 g0) {
    I64 nz = list_length(nodes, nodes[kn].d as I64);
    if (base + nz > s) {
        return false;
    }
    for j in 0..nz {
        wk[base + j].a = 0;
        wk[base + j].b = 0;
    }
    I64 p = nodes[kn].b as I64;
    I64 g = g0;
    while (p >= 0 && g >= 0) {
        I64 t = sem[p].ty;
        if (resolve.is_array(t)) {
            for d in 0..resolve.array_rank(t) {
                if (resolve.dim_extent(sem[g].ty, d) < 0) {
                    return false;
                }
            }
        }
        p = nodes[p].next as I64;
        g = nodes[g].next as I64;
    }
    p = nodes[kn].b as I64;
    g = g0;
    while (p >= 0 && g >= 0) {
        I64 t = sem[p].ty;
        if (resolve.is_array(t)) {
            for d in 0..resolve.array_rank(t) {
                I64 j = resolve.dim_size(t, d);
                if (j >= 0 && wk[base + j].b == 0) {
                    wk[base + j].a = (resolve.dim_extent(sem[g].ty, d)) as I32;
                    wk[base + j].b = 1;
                }
            }
        }
        p = nodes[p].next as I64;
        g = nodes[g].next as I64;
    }
    return true;
}

// The value of extent d of array parameter p of kernel kn under the shape symbol values in
// work rows from base (`cint_ref` shape_value), into v[0]; false when it names a symbol
// with no value or leaves I64.
Bool shape_value[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, in resolve.Sem[_] sem,
        in parse.Frame[_] wk, I64 base, I64 kn, I64 p, I64 d, inout I64[_] v) {
    I64 t = sem[p].ty;
    if (resolve.dim_extent(t, d) >= 0) {
        v[0] = resolve.dim_extent(t, d);
        return true;
    }
    I64 j = resolve.dim_size(t, d);
    if (j < 0) {
        I64 e = param_extent(nodes, p, d);
        I64 fe = shape_form(nodes, e);
        if (fe != 3 && fe != 4) {
            return false;
        }
        j = resolve.size_index(src, toks, nodes, kn, tok_of(nodes, nodes[e].a as I64));
        if (j < 0 || wk[base + j].b == 0) {
            return false;
        }
        I64 a = wk[base + j].a as I64;
        I64 c = sem[nodes[e].b as I64].bits as% I64;
        if (fe == 4) {
            // a - c for a >= 0 and c >= 0 stays in I64.
            v[0] = a - c;
            return true;
        }
        if (c > I64_MAX - a) {
            return false;
        }
        v[0] = a + c;
        return true;
    }
    if (wk[base + j].b == 0) {
        return false;
    }
    v[0] = wk[base + j].a as I64;
    return true;
}

// K_DISPATCH on frame f: call x of kernel symbol a (`cint_ref` _dispatch; SPEC-04 LS-251;
// SPEC-02 K-4, K-6, K-7, A-8): not in a kernel body (C5023), no named argument (C9102), one
// argument per parameter (C2022); an array argument of the parameter's element type and
// rank, an `in` scalar of its type, an `out` scalar typed as it is (C2001); a writable
// place for `out` and `inout` (C2067); each argument folded; when every array argument's
// extents are static, the K-6 binding at compile time (C2012 at the argument); then C5010
// at the later of two arguments of array parameters, one written, that are the same
// variable or provably the same view. The call's Sem row: sym the kernel. Frame: b the
// argument, c its parameter, d the stage (0 typed, 1 checked, 2 folded).
void h_dispatch[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        in resolve.Sym[_] syms, in limits.Decl[_] decls, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 kn = syms[wk[f].a as I64].node;
    I64 at = first(nodes, x);
    if (wk[f].state == 0) {
        wk[f].state = 1;
        if (rs[0].ctx == resolve.CTX_KERNEL) {
            resolve.fail(toks, diag, rs, C_KERNEL_DISPATCH, at);
            return;
        }
        I64 g = nodes[x].b as I64;
        while (g >= 0) {
            if (nodes[g].kind == parse.N_NAMEDARG) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, g));
                return;
            }
            g = nodes[g].next as I64;
        }
        if (list_length(nodes, nodes[x].b as I64) != list_length(nodes, nodes[kn].b as I64)) {
            resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, at);
            return;
        }
        sem[x].sym = wk[f].a as I64;
        wk[f].b = nodes[x].b;
        wk[f].c = nodes[kn].b;
        wk[f].d = 0;
        return;
    }
    I64 g = wk[f].b as I64;
    I64 p = wk[f].c as I64;
    if (wk[f].d < 2 && g >= 0) {
        I64 t = sem[p].ty;
        if (wk[f].d == 0) {
            wk[f].d = 1;
            if (resolve.is_array(t)) {
                I64 want = resolve.shaped(resolve.elem_code(t), resolve.array_rank(t), 0, 0, 0, 0);
                _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, g, want);
            } else if (written_mode(nodes, p)) {
                _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, g, 0);
            } else {
                _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, g, t);
            }
            return;
        }
        if (!resolve.is_array(t) && written_mode(nodes, p) && sem[g].ty != resolve.TY_NONE && sem[g].ty != t) {
            resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, first(nodes, g));
            return;
        }
        if (written_mode(nodes, p) && !writable_view(nodes, sem, syms, decls, g)) {
            resolve.fail(toks, diag, rs, C_NOT_WRITABLE, first(nodes, g));
            return;
        }
        wk[f].b = nodes[g].next;
        wk[f].c = nodes[p].next;
        wk[f].d = 0;
        if (wk[f].b < 0) {
            wk[f].d = 2;
            wk[f].b = nodes[x].b;
        }
        return;
    }
    if (wk[f].d < 2) {
        // A kernel without parameters: nothing to type.
        wk[f].d = 2;
        wk[f].b = nodes[x].b;
        return;
    }
    if (g >= 0) {
        wk[f].b = nodes[g].next;
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, g, 0);
        return;
    }
    // K-7: the binding at compile time.
    I64 g0 = nodes[x].b as I64;
    I64 base = cs[0].sp;
    if (kernel_sizes(nodes, sem, wk, base, kn, g0)) {
        I64[1] v;
        Bool known = true;
        p = nodes[kn].b as I64;
        g = g0;
        while (p >= 0 && g >= 0 && known) {
            I64 t = sem[p].ty;
            if (resolve.is_array(t)) {
                for d in 0..resolve.array_rank(t) {
                    if (known) {
                        if (!shape_value(src, toks, nodes, sem, wk, base, kn, p, d, v)) {
                            known = false;
                        } else if (v[0] != resolve.dim_extent(sem[g].ty, d)) {
                            resolve.fail(toks, diag, rs, C_SHAPE, first(nodes, g));
                            return;
                        }
                    }
                }
            }
            p = nodes[p].next as I64;
            g = nodes[g].next as I64;
        }
    }
    // A-8: pairs in `cint_ref`'s order.
    p = nodes[kn].b as I64;
    g = g0;
    while (p >= 0 && g >= 0) {
        I64 q = nodes[p].next as I64;
        I64 h = nodes[g].next as I64;
        while (q >= 0 && h >= 0) {
            if (resolve.is_array(sem[p].ty) && resolve.is_array(sem[q].ty) &&
                    (written_mode(nodes, p) || written_mode(nodes, q))) {
                Bool same = places_overlap(nodes, sem, syms, wk, cs, g, h) == 1;
                if (!same) {
                    I64[11] va;
                    I64[11] vb;
                    same = static_view(nodes, sem, syms, wk, cs, g, va) && static_view(nodes, sem, syms, wk, cs, h, vb) &&
                        classify(va, vb) == 1;
                }
                if (same) {
                    resolve.fail(toks, diag, rs, C_OVERLAP, first(nodes, h));
                    return;
                }
            }
            q = nodes[q].next as I64;
            h = nodes[h].next as I64;
        }
        p = nodes[p].next as I64;
        g = nodes[g].next as I64;
    }
    sem[x].ty = resolve.TY_VOID;
    pop(cs);
}

// The `reduce` statement x on frame f at step `step` (`cint_ref` _stmt_Reduce; SPEC-02 R-1
// to R-3, 8.2; SPEC-04 LS-249): in a kernel body (C9102), not in a loop (C9102), its target
// a scalar `out` parameter (C3005 when undefined, C9102 otherwise) that no other `reduce`
// statement targets (C9102), its operation a call of `sum`, `fold_checked`, `sum_wrap`,
// `sum_sat`, `min`, `max` or `count` (C9102) with no named argument (C2063), its arguments
// counted (C2022); for `fold_checked` the operation `add` (C3007 for another name, C9102 for
// `mul`) and an initial value of the target's type that is a constant or a scalar `in`
// parameter (C9102), folded; the contribution Bool for `count`, whose target is I64
// (C2001 at the target), an integer of any type for `sum` (C2103), else of the target's
// type; then folded. Sem row: sym the target, lit_at the operation (AF_*), opty the
// contribution's type, ty the target's.
void h_reduce[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f, I64 step) {
    I64 st = step;
    I64 x = wk[f].node as I64;
    I64 c = nodes[x].a as I64;
    I64 tt = nodes[x].c as I64;
    I64 id = sem[x].lit_at;
    I64 a0 = nodes[c].b as I64;
    I64 v = a0;
    if (id == resolve.AF_FOLD && st > 0) {
        v = nodes[nodes[a0].next as I64].next as I64;
    }
    if (st == 0) {
        if (rs[0].ctx != resolve.CTX_KERNEL || rs[0].loops > 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, x));
            return;
        }
        I64 sy = resolve.lookup(src, toks, nodes, syms, names, diag, rs, tt, tt);
        if (sy < 0) {
            return;
        }
        I64 pn = syms[sy].node;
        if (syms[sy].kind != resolve.SK_PARAM || (syms[sy].flags & resolve.SF_OUT) == 0 ||
                resolve.is_array(syms[sy].ty) || pn < 0 || nodes[pn].kind != parse.N_PARAM) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tt);
            return;
        }
        if ((syms[sy].flags & SF_REDUCED) != 0) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, tok_of(nodes, x));
            return;
        }
        id = 0;
        I64 callee = nodes[c].a as I64;
        if (nodes[c].kind == parse.N_CALL && nodes[callee].kind == parse.N_NAME &&
                (nodes[callee].flags & parse.F_PAREN) == 0) {
            I64 ct = tok_of(nodes, callee);
            id = resolve.array_builtin(src, toks[ct].start as I64, toks[ct].len as I64);
        }
        if (id != resolve.AF_SUM && id != resolve.AF_FOLD && id != resolve.AF_SUM_WRAP && id != resolve.AF_SUM_SAT &&
                id != resolve.AF_MIN && id != resolve.AF_MAX && id != resolve.AF_COUNT) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, c));
            return;
        }
        I64 g = a0;
        while (g >= 0) {
            if (nodes[g].kind == parse.N_NAMEDARG) {
                resolve.fail(toks, diag, rs, C_NO_PARAM, tok_of(nodes, g));
                return;
            }
            g = nodes[g].next as I64;
        }
        I64 argc = list_length(nodes, a0);
        sem[x].sym = sy;
        sem[x].lit_at = id;
        sem[x].ty = syms[sy].ty;
        syms[sy].flags = syms[sy].flags | SF_REDUCED;
        if (id == resolve.AF_FOLD) {
            if (argc != 3) {
                resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, first(nodes, c));
                return;
            }
            Bool op_add = nodes[a0].kind == parse.N_NAME && spells(src, toks, tok_of(nodes, a0), "add");
            Bool op_mul = nodes[a0].kind == parse.N_NAME && spells(src, toks, tok_of(nodes, a0), "mul");
            if (!op_add && !op_mul) {
                resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, first(nodes, a0));
                return;
            }
            if (op_mul) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, a0));
                return;
            }
            sem[c].lit_len = 1;
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, nodes[a0].next as I64, sem[x].ty);
            return;
        }
        if (argc != 1) {
            resolve.fail(toks, diag, rs, resolve.C_ARG_COUNT, first(nodes, c));
            return;
        }
        wk[f].state = 3;
        st = 2;
    }
    if (st == 1) {
        // The initial value of `fold_checked`: uniform across work-items, then folded.
        I64 init = nodes[a0].next as I64;
        Bool uniform = is_const(sem, init);
        if (!uniform && nodes[init].kind == parse.N_NAME && sem[init].sym >= 0) {
            I64 sy = sem[init].sym;
            uniform = syms[sy].kind == resolve.SK_PARAM && syms[sy].node >= 0 &&
                nodes[syms[sy].node].kind == parse.N_PARAM && !resolve.is_array(syms[sy].ty) &&
                (syms[sy].flags & (resolve.SF_INOUT | resolve.SF_OUT)) == 0;
        }
        if (!uniform) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, first(nodes, init));
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, init, 0);
        return;
    }
    if (st == 2) {
        if (id == resolve.AF_COUNT) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, v, fold.TY_BOOL);
        } else if (id == resolve.AF_SUM) {
            _ = push(toks, nodes, wk, diag, rs, cs, K_INFER, v, 0);
        } else {
            _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, v, sem[x].ty);
        }
        return;
    }
    if (st == 3) {
        I64 elem = sem[x].ty;
        if (id == resolve.AF_COUNT) {
            if (sem[x].ty != fold.TY_I64) {
                resolve.fail(toks, diag, rs, resolve.C_TYPE_MISMATCH, tt);
                return;
            }
            elem = fold.TY_BOOL;
        } else if (id == resolve.AF_SUM) {
            if (sem[v].ty == resolve.TY_NONE) {
                settle(toks, nodes, sem, wk, diag, rs, cs, v, sem[x].ty);
                if (rs[0].err != 0) {
                    return;
                }
            }
            elem = sem[v].ty;
            if (!resolve.is_int(elem)) {
                resolve.fail(toks, diag, rs, resolve.C_NO_OPERATOR, first(nodes, v));
                return;
            }
        }
        sem[x].opty = elem;
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, v, 0);
        return;
    }
    pop(cs);
}

// ---------------------------------------------------------------- declarations

// K_GCONST on frame f: module-level constant symbol a, declared by node x, evaluated at
// module level (`cint_ref` eval_global_const). Frame b: the context it interrupted.
void h_gconst[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 sy = wk[f].a as I64;
    I64 init = nodes[x].b as I64;
    I64 step = wk[f].state as I64;
    wk[f].state = (step + 1) as I32;
    if (step == 0) {
        syms[sy].state = resolve.CS_BUSY;
        wk[f].b = rs[0].ctx as I32;
        rs[0].ctx = resolve.CTX_MODULE;
        I64 t = resolve.type_of(toks, nodes, diag, rs, nodes[x].a as I64);
        if (rs[0].err != 0) {
            return;
        }
        syms[sy].ty = t;
        sem[x].ty = t;
        _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, init, t);
    } else if (step == 1) {
        if (!is_const(sem, init)) {
            resolve.fail(toks, diag, rs, resolve.C_CONST_REQUIRED, first(nodes, init));
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, init, 0);
    } else {
        syms[sy].value = sem[init].bits;
        syms[sy].state = resolve.CS_DONE;
        rs[0].ctx = wk[f].b as I64;
        pop(cs);
    }
}

// Resolves signatures on demand for early annotation calls, then in source order.
// Frame b is the next parameter, c the parameter being checked, d the saved context.
void h_signature[s](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes,
        inout resolve.Sem[_] sem, inout resolve.Sym[_] syms, inout resolve.Name[_] names,
        in limits.Decl[_] decls, inout parse.Frame[s] wk, inout limits.CompilerDiag[_] diag,
        inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 sy = sem[x].sym;
    if (wk[f].state == 0) {
        if (syms[sy].state == resolve.CS_DONE) { pop(cs); return; }
        syms[sy].state = resolve.CS_BUSY;
        wk[f].d = rs[0].ctx as I32;
        rs[0].ctx = resolve.CTX_MODULE;
        resolve.signature_sizes(src, toks, nodes, sem, syms, names, diag, rs, x, false);
        if (rs[0].err != 0) { return; }
        if (nodes[x].kind == parse.N_KERNEL) {
            // A kernel's shape expressions name its shape symbols (`cint_ref` kernel_signature):
            // they are visible here, at module level, until the parameters are typed.
            keep_payload(wk, f, resolve.scope_open(rs));
            I64 z = nodes[x].d as I64;
            while (z >= 0) {
                I64 zs = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_PARAM, fold.TY_I64, z,
                    tok_of(nodes, z));
                if (zs < 0) { return; }
                syms[zs].flags = 0;
                sem[z].sym = zs;
                sem[z].ty = fold.TY_I64;
                z = nodes[z].next as I64;
            }
        }
        wk[f].b = nodes[x].b;
        wk[f].c = -1;
        wk[f].state = 1;
    }
    if (wk[f].state == 1) {
        I64 done = wk[f].c as I64;
        if (done >= 0) {
            sem[done].ty = sem[nodes[done].a as I64].ty;
            if (nodes[x].kind == parse.N_KERNEL) {
                if (!kernel_param_ok(toks, nodes, sem, diag, rs, done)) {
                    return;
                }
            } else if (nodes[done].op == scan.KW_INOUT && !resolve.is_array(sem[done].ty) &&
                    !resolve.is_struct(sem[done].ty) &&
                    !(resolve.is_mem(sem[done].ty) && !resolve.is_handle(sem[done].ty))) {
                resolve.fail(toks, diag, rs, resolve.C_INOUT_SCALAR, nodes[done].start as I64);
                return;
            }
        }
        I64 p = wk[f].b as I64;
        if (p >= 0) {
            wk[f].c = p as I32;
            wk[f].b = nodes[p].next;
            _ = push(toks, nodes, wk, diag, rs, cs, K_TYPE, nodes[p].a as I64, x + 1);
            return;
        }
        resolve.signature_sizes(src, toks, nodes, sem, syms, names, diag, rs, x, true);
        if (rs[0].err != 0) { return; }
        sem[x].ty = resolve.TY_VOID;
        I64 res = nodes[x].a as I64;
        if (nodes[x].kind == parse.N_KERNEL) {
            resolve.scope_close(syms, names, rs, wk[f].a as I64);
        } else if (res >= 0 && nodes[res].kind == parse.N_ERRUNION) {
            sem[x].ty = union_result(src, toks, nodes, sem, syms, names, decls, diag, rs, res);
            if (rs[0].err != 0) { return; }
        } else if (res >= 0) {
            sem[x].ty = resolve.type_ref(src, toks, nodes, sem, syms, names, decls, diag, rs, res, -1, -2);
            if (resolve.is_array(sem[x].ty)) {
                resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, nodes[res].tok as I64);
                return;
            }
        }
        syms[sy].ty = sem[x].ty;
        syms[sy].state = resolve.CS_DONE;
        rs[0].ctx = wk[f].d as I64;
        pop(cs);
    }
}

// The type of the error union `E!T` of N_ERRUNION node x, a function's result (LS-94,
// LS-95): E names an error set (C3007 at its name otherwise), and T is an integer type,
// Bool, void, or (box 12) a handle when E is AllocError; another T is C9102 at its first
// token (compiler/OPEN.md CINTC-OQ-15).
// Its Sem.ty is the union, and the set's and value's N_TYPE nodes keep their types. 0 after
// an error.
I64 union_result[n](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls,
        inout limits.CompilerDiag[_] diag, inout resolve.RState[_] rs, I64 x) {
    I64 e = nodes[x].a as I64;
    I64 v = nodes[x].b as I64;
    I64 set = resolve.type_ref(src, toks, nodes, sem, syms, names, decls, diag, rs, e, -1, -2);
    if (rs[0].err != 0) {
        return 0;
    }
    if (!resolve.is_errset(set)) {
        resolve.fail(toks, diag, rs, resolve.C_WRONG_KIND, nodes[e].tok as I64);
        return 0;
    }
    sem[e].ty = set;
    I64 vt = resolve.TY_VOID;
    if (v >= 0) {
        vt = resolve.type_ref(src, toks, nodes, sem, syms, names, decls, diag, rs, v, -1, -2);
        if (rs[0].err != 0) {
            return 0;
        }
        if (!resolve.is_int(vt) && vt != fold.TY_BOOL && !(resolve.is_handle(vt) && set == resolve.TY_ALLOC)) {
            resolve.fail(toks, diag, rs, resolve.C_UNSUPPORTED, nodes[v].start as I64);
            return 0;
        }
        sem[v].ty = vt;
    }
    sem[x].ty = resolve.union_type(set, vt);
    return sem[x].ty;
}

// K_FUNC on frame f: the body of function node x (`cint_ref` check_function): parameters
// in their own scope, the body's statements in another, then C4001 at the name when a
// function with a result can reach its closing brace.
void h_func[s, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, inout parse.Frame[s] wk,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 body = nodes[x].c as I64;
    if (wk[f].state == 0) {
        wk[f].state = 1;
        rs[0].ctx = resolve.CTX_FUNCTION;
        rs[0].loops = 0;
        cs[0].result = sem[x].ty;
        cs[0].in_test = 0;
        wk[f].a = resolve.scope_open(rs) as I32;
        I64 z = nodes[x].d as I64;
        while (z >= 0) {
            I64 sy = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_PARAM, fold.TY_I64, z,
                tok_of(nodes, z));
            if (sy < 0) {
                return;
            }
            sem[z].sym = sy;
            sem[z].ty = fold.TY_I64;
            z = nodes[z].next as I64;
        }
        I64 p = nodes[x].b as I64;
        while (p >= 0) {
            I64 sy = resolve.declare(src, toks, syms, names, diag, rs, resolve.SK_PARAM, sem[p].ty, p, tok_of(nodes, p));
            if (sy < 0) {
                return;
            }
            if (nodes[p].op == scan.KW_INOUT) {
                syms[sy].flags = syms[sy].flags | resolve.SF_INOUT;
            }
            sem[p].sym = sy;
            p = nodes[p].next as I64;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, body, 0);
        return;
    }
    resolve.scope_close(syms, names, rs, wk[f].a as I64);
    Bool falls = sem[x].ty == resolve.TY_VOID ||
        (resolve.is_errunion(sem[x].ty) && resolve.union_value(sem[x].ty) == resolve.TY_VOID);
    if (!falls && completes(sem, body)) {
        resolve.fail(toks, diag, rs, resolve.C_MISSING_RETURN, tok_of(nodes, x));
        return;
    }
    pop(cs);
}

// K_TEST on frame f: the body of test node x (`cint_ref` check_body("test", ...)): no
// parameters, no result, its statements in a scope of their own (SPEC-04 LS-232).
void h_test[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sym[_] syms,
        inout resolve.Name[_] names, inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    if (wk[f].state == 0) {
        wk[f].state = 1;
        rs[0].ctx = resolve.CTX_FUNCTION;
        rs[0].loops = 0;
        cs[0].result = resolve.TY_VOID;
        // `try` admits an error of any set, and `errdefer` is admitted (LS-315, LS-322).
        cs[0].in_test = 1;
        wk[f].a = resolve.scope_open(rs) as I32;
        _ = push(toks, nodes, wk, diag, rs, cs, K_BLOCK, nodes[x].b as I64, 0);
        return;
    }
    resolve.scope_close(syms, names, rs, wk[f].a as I64);
    cs[0].in_test = 0;
    pop(cs);
}

// K_MODVAR on frame f: the initializer of module-level variable node x (`cint_ref`
// check_module_var): a constant expression (C6004 with the LS-312 note).
void h_modvar[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs, inout CState[_] cs, I64 f) {
    I64 x = wk[f].node as I64;
    I64 init = nodes[x].b as I64;
    I64 sy = sem[x].sym;
    I64 step = wk[f].state as I64;
    wk[f].state = (step + 1) as I32;
    if (init < 0 && resolve.is_errset(syms[sy].ty)) {
        // Zero fill would make an error value 0, which none is (LS-314).
        resolve.fail(toks, diag, rs, resolve.C_ZERO_FILL, first(nodes, x));
    } else if (init < 0) {
        pop(cs);
    } else if (step == 0) {
        rs[0].ctx = resolve.CTX_MODULE;
        _ = push(toks, nodes, wk, diag, rs, cs, K_EXPECT, init, syms[sy].ty);
    } else if (step == 1) {
        if (!is_const(sem, init) && !is_errval(sem, init)) {
            resolve.fail_note(toks, nodes, diag, rs, resolve.C_CONST_REQUIRED, first(nodes, init));
            return;
        }
        _ = push(toks, nodes, wk, diag, rs, cs, K_FOLD, init, 0);
    } else {
        syms[sy].value = sem[init].bits;
        pop(cs);
    }
}

// ---------------------------------------------------------------- the machine

// Runs task `task` on node x until it and every task it starts are done, or an error.
void run[s, l, r](in U8[_] src, in scan.Token[_] toks, in parse.Node[_] nodes, inout resolve.Sem[_] sem,
        inout resolve.Sym[_] syms, inout resolve.Name[_] names, in limits.Decl[_] decls, inout parse.Frame[s] wk,
        inout U8[l] lits,
        inout limits.CompilerDiag[r] diag, inout U8[_] faults, inout fold.Folded[_] fres, inout fold.Work[_] z,
        in U8[_] path, inout resolve.RState[_] rs, inout CState[_] cs, I32 task, I64 x, I64 a) {
    I64 base = cs[0].sp;
    if (!push(toks, nodes, wk, diag, rs, cs, task, x, a)) {
        return;
    }
    while (cs[0].sp > base && rs[0].err == 0) {
        cs[0].steps += 1;
        I64 f = cs[0].sp - 1;
        switch (wk[f].kind) {
            case K_STMT: h_stmt(src, toks, nodes, sem, syms, names, decls, wk, diag, rs, cs, f);
            case K_BLOCK, K_CLAUSE: h_block(toks, nodes, sem, syms, names, wk, diag, rs, cs, f);
            case K_SWITCH: h_switch(toks, nodes, sem, wk, diag, rs, cs, f);
            case K_INFER: h_infer(src, toks, nodes, sem, syms, names, decls, wk, diag, rs, cs, f);
            case K_EXPECT: h_expect(src, toks, nodes, sem, wk, diag, rs, cs, f);
            case K_FOLD: h_fold(toks, nodes, sem, wk, diag, rs, cs, f);
            case K_EVAL: h_eval(src, toks, nodes, sem, syms, wk, lits, diag, faults, fres, z, path, rs, cs, f);
            case K_WALK: h_walk(src, toks, nodes, sem, wk, lits, diag, faults, fres, z, path, rs, cs, f);
            case K_GCONST: h_gconst(toks, nodes, sem, syms, wk, diag, rs, cs, f);
            case K_FUNC: h_func(src, toks, nodes, sem, syms, names, wk, diag, rs, cs, f);
            case K_TEST: h_test(toks, nodes, syms, names, wk, diag, rs, cs, f);
            case K_TYPE: h_type(src, toks, nodes, sem, syms, names, decls, wk, diag, rs, cs, f);
            case K_SIGNATURE: h_signature(src, toks, nodes, sem, syms, names, decls, wk, diag, rs, cs, f);
            case K_CLAMP: h_clamp(toks, nodes, sem, wk, diag, rs, cs, f);
            case K_LITERAL: h_literal(toks, nodes, sem, wk, diag, rs, cs, f);
            case K_PLACE: h_place(toks, nodes, sem, wk, diag, rs, cs, f);
            case K_KERNEL: h_kernel(src, toks, nodes, sem, syms, names, wk, diag, rs, cs, f);
            case K_DISPATCH: h_dispatch(src, toks, nodes, sem, syms, decls, wk, diag, rs, cs, f);
            case K_MEMBER: h_member(src, toks, nodes, sem, syms, names, decls, wk, diag, rs, cs, f);
            case K_MEMORY: h_memory(src, toks, nodes, sem, syms, names, wk, diag, rs, cs, f);
            default: h_modvar(toks, nodes, sem, syms, wk, diag, rs, cs, f);
        }
        if (cs[0].quiet < 0) {
            // A quiet evaluation failed: back to its K_CLAMP frame, which skips that call.
            I64 cf = -cs[0].quiet - 1;
            cs[0].sp = cf + 1;
            cs[0].quiet = 0;
            wk[cf].d = 0;
        }
    }
    cs[0].sp = base;
}

// Empties the Sem rows of nodes 0..nn.
void sem_clear(inout resolve.Sem[_] sem, I64 nn) {
    for x in 0..nn {
        sem[x].ty = resolve.TY_NONE;
        sem[x].sym = -1;
        sem[x].flags = 0;
        sem[x].opty = 0;
        sem[x].lit_at = -1;
        sem[x].lit_len = 0;
        sem[x].bits = 0;
    }
}

// Whether string tokens p and q have the same decoded bytes (test names, LS-233).
Bool same_string[n](in U8[n] src, in scan.Token[_] toks, I64 p, I64 q) {
    I64[5] gp;
    I64[5] gq;
    I64 kp = (toks[p].start as I64) + 1;
    I64 ep = (toks[p].start as I64) + (toks[p].len as I64) - 1;
    I64 kq = (toks[q].start as I64) + 1;
    I64 eq = (toks[q].start as I64) + (toks[q].len as I64) - 1;
    I64 ip = 0;
    I64 iq = 0;
    gp[4] = 0;
    gq[4] = 0;
    Bool same = true;
    Bool more = true;
    while (same && more) {
        while (ip == gp[4] && kp < ep) {
            kp = resolve.string_next(src, kp, ep, gp);
            ip = 0;
        }
        while (iq == gq[4] && kq < eq) {
            kq = resolve.string_next(src, kq, eq, gq);
            iq = 0;
        }
        if (ip == gp[4] || iq == gq[4]) {
            same = ip == gp[4] && iq == gq[4];
            more = false;
        } else if (gp[ip] != gq[iq]) {
            same = false;
        } else {
            ip += 1;
            iq += 1;
        }
    }
    return same;
}

// C3020 at the `test` of the first test whose name an earlier test of the module has
// (`cint_ref` Checker.check, after the module-level declarations). Returns whether there is one.
Bool duplicate_test[n, r](in U8[n] src, in scan.Token[_] toks, in parse.Node[_] nodes, I64 root,
        inout limits.CompilerDiag[r] diag, inout resolve.RState[_] rs) {
    I64 x = nodes[root].a as I64;
    while (x >= 0) {
        if (nodes[x].kind == parse.N_TEST) {
            I64 y = nodes[root].a as I64;
            while (y != x) {
                if (nodes[y].kind == parse.N_TEST && same_string(src, toks, tok_of(nodes, nodes[y].a as I64),
                        tok_of(nodes, nodes[x].a as I64))) {
                    resolve.fail(toks, diag, rs, C_TEST_NAME, tok_of(nodes, x));
                    return true;
                }
                y = nodes[y].next as I64;
            }
        }
        x = nodes[x].next as I64;
    }
    return false;
}

// ---------------------------------------------------------------- module state arguments

// C5012: an argument that is a module-level variable passed to a function that writes it
// (SPEC-04 LS-122; G-C2 review COR-6).
const I64 C_STATE_ARG = 5012;

// The module-level variable that place g is rooted at (`cint_ref` place_path): its symbol,
// -2 - its row for `alias.x` of an imported module, or -1 for any other expression.
I64 state_var(in parse.Node[_] nodes, in resolve.Sem[_] sem, in resolve.Sym[_] syms, in limits.Decl[_] decls,
        I64 g) {
    I64 e = g;
    while (nodes[e].kind == parse.N_INDEX ||
            (nodes[e].kind == parse.N_FIELD && (sem[e].flags & resolve.SEM_IMPORT) == 0)) {
        e = nodes[e].a as I64;
    }
    if (nodes[e].kind == parse.N_FIELD) {
        if (decls[sem[e].lit_at].kind == limits.DK_VAR) {
            return -2 - sem[e].lit_at;
        }
        return -1;
    }
    if (nodes[e].kind == parse.N_NAME && sem[e].sym >= 0 && syms[sem[e].sym].kind == resolve.SK_MODVAR) {
        return sem[e].sym;
    }
    return -1;
}

// What passing variable v (state_var) as argument q of call y gives: C5012 when the callee
// or a function of this module that it calls, directly or not, writes v by name; C9102 when
// that rests on what an imported function writes, which the declaration table does not
// record (a variable of this module cannot be written by an imported function); else 0. A
// search over this module's call graph from the callee: work row f of each function visited
// has `a` q, and rows nn and on are its queue.
I64 state_verdict[s](in parse.Node[_] nodes, I64 nn, in resolve.Sem[_] sem, in resolve.Sym[_] syms,
        in limits.Decl[_] decls, inout parse.Frame[s] wk, I64 y, I64 v, I64 q) {
    if (nodes[nodes[y].a as I64].kind == parse.N_FIELD) {
        if (v >= 0) {
            return 0;
        }
        return resolve.C_UNSUPPORTED;
    }
    I64 fn = syms[sem[y].sym].node;
    wk[fn].a = q as I32;
    wk[nn].a = fn as I32;
    I64 head = nn;
    I64 tail = nn + 1;
    Bool imported = false;
    while (head < tail) {
        I64 at = wk[head].a as I64;
        head += 1;
        I64 w = wk[at].b as I64;
        while (w >= 0) {
            if (state_var(nodes, sem, syms, decls, nodes[w].a as I64) == v) {
                return C_STATE_ARG;
            }
            w = wk[w].d as I64;
        }
        I64 c = wk[at].c as I64;
        while (c >= 0) {
            if (nodes[nodes[c].a as I64].kind == parse.N_FIELD) {
                imported = true;
            } else {
                I64 g = syms[sem[c].sym].node;
                if (wk[g].a as I64 != q) {
                    wk[g].a = q as I32;
                    wk[tail].a = g as I32;
                    tail += 1;
                }
            }
            c = wk[c].d as I64;
        }
    }
    if (imported && v < -1) {
        return resolve.C_UNSUPPORTED;
    }
    return 0;
}

// C5012 (or C9102, state_verdict) at the first argument, in parameter order, of the first
// call in check order whose argument is a module-level variable that the callee writes, as
// `cint_ref`'s _check_module_state_args, once the module is checked. The checker leaves in
// Sem each write's item (lit_at of an assignment) and each call's place and item (note_call);
// work rows 0..nn then hold per-node lists: an item's first write in `b` and first call in
// `c`, the next write or call of the same item in `d`. Each argument that names a
// module-level variable costs one O(n) search, so the pass is O(n^2) at worst.
void state_args[s, r](in scan.Token[_] toks, in parse.Node[_] nodes, I64 nn, in resolve.Sem[_] sem,
        in resolve.Sym[_] syms, in limits.Decl[_] decls, inout parse.Frame[s] wk, inout limits.CompilerDiag[r] diag,
        inout resolve.RState[_] rs) {
    for y in 0..nn {
        wk[y].a = -1;
        wk[y].b = -1;
        wk[y].c = -1;
        wk[y].d = -1;
    }
    for y in 0..nn {
        I32 k = nodes[y].kind;
        if ((k == parse.N_ASSIGN || k == parse.N_INCDEC) && sem[y].lit_at >= 0) {
            I64 item = sem[y].lit_at;
            wk[y].d = wk[item].b;
            wk[item].b = y as I32;
        } else if (k == parse.N_CALL && !is_builtin(nodes, sem, y) && sem[y].lit_len > 0) {
            I64 item = sem[y].opty;
            wk[y].d = wk[item].c;
            wk[item].c = y as I32;
        }
    }
    I64 best = -1;
    I64 best_arg = -1;
    I64 best_code = 0;
    for y in 0..nn {
        if (nodes[y].kind == parse.N_CALL && !is_builtin(nodes, sem, y) && sem[y].lit_len > 0 &&
                (best < 0 || sem[y].lit_len < sem[best].lit_len)) {
            I64 g = nodes[y].b as I64;
            I64 code = 0;
            while (g >= 0 && code == 0) {
                I64 v = state_var(nodes, sem, syms, decls, g);
                if (v != -1) {
                    code = state_verdict(nodes, nn, sem, syms, decls, wk, y, v, g);
                }
                if (code == 0) {
                    g = nodes[g].next as I64;
                }
            }
            if (code != 0) {
                best = y;
                best_arg = g;
                best_code = code;
            }
        }
    }
    if (best >= 0) {
        resolve.fail(toks, diag, rs, best_code, first(nodes, best_arg));
    }
}

// Checks module `module`, whose N_MODULE node is root among nodes 0..nn (compiler/parse.ci
// over the tokens toks of src), in `cint_ref`'s order: the subset gate (C9102), the
// module-level pass of compiler/resolve.ci, each constant, function, static_assert and
// module-level variable in source order, then the statements of a script. Tables: sem one
// row per node; syms (CINTC-02 symbols, tokens / 2 + 64); names (ordinary prefix plus
// the imported directory/index, limits.name_capacity); wk (the frame region, of which
// the checker uses nodes + 16 rows); lits (the literal-value table, (bytes + 1) / 2 + 64); faults (CINTC-14,
// 100 slots of 2,372 bytes); path the module's path, for fault records; decls the
// declaration table, whose blocks of the modules compiled before this one its imports read
// (each N_IMPORT node's `e` is the index of the module it names, compiler/main.ci). Returns
// 0, or the code of the first diagnostic, which is in `diag` (with its fault in fres for
// C6001).
export I64 check_module[m, s, l, r, y](in U8[_] src, in scan.Token[_] toks, in parse.Node[m] nodes, I64 nn, I64 root,
        inout resolve.Sem[_] sem, inout resolve.Sym[y] syms, inout resolve.Name[_] names, inout parse.Frame[s] wk,
        inout U8[l] lits, inout limits.CompilerDiag[r] diag, inout U8[_] faults, inout fold.Folded[_] fres,
        inout fold.Work[_] z, in U8[_] path, inout resolve.RState[_] rs, inout CState[_] cs, I64 module,
        in limits.Decl[_] decls) {
    resolve.resolve_init(names, rs, module, y);
    cs[0].base = nn;
    cs[0].sp = nn;
    cs[0].max_sp = 0;
    cs[0].result = resolve.TY_VOID;
    cs[0].lit_used = 0;
    cs[0].steps = 0;
    cs[0].quiet = 0;
    // The checker's own limit in the frame region (KR-02, KR-03): nodes + 16 rows, the node
    // table's extent plus 16, or the region's extent when that is smaller.
    cs[0].cap = m + 16;
    if (s < cs[0].cap) {
        cs[0].cap = s;
    }
    cs[0].in_test = 0;
    if (nn > cs[0].cap) {
        resolve.fail(toks, diag, rs, limits.C_NESTING, tok_of(nodes, root));
        return rs[0].err;
    }
    sem_clear(sem, nn);
    if (gate(src, toks, nodes, nn, sem, names, diag, rs)) {
        return rs[0].err;
    }
    // Each import's module and block, for resolve.resolve_globals's aliases.
    I64 imp = nodes[root].a as I64;
    while (imp >= 0) {
        if (nodes[imp].kind == parse.N_IMPORT) {
            sem[imp].opty = nodes[imp].e as I64;
            I64 blk = decl.block_of(decls, nodes[imp].e as I64);
            if (blk < 0) {
                // No block for the module the import names (a checker run without a build):
                // C9102 at the import, as before task 2.13 part (iii).
                I64 itk = tok_of(nodes, imp);
                resolve.fail_at(diag, rs, resolve.C_UNSUPPORTED, toks[itk].line as I64, toks[itk].col as I64,
                    parse.N_IMPORT as I64, 0);
                return rs[0].err;
            }
            sem[imp].bits = blk as U64;
        }
        imp = nodes[imp].next as I64;
    }

    if (resolve.resolve_globals(src, toks, nodes, sem, syms, names, diag, rs, root, decls) != 0) {
        return rs[0].err;
    }
    if (resolve.resolve_errsets(src, toks, nodes, sem, syms, names, diag, rs, root) != 0) {
        return rs[0].err;
    }
    rs[0].ctx = resolve.CTX_MODULE;
    I64 item = nodes[root].a as I64;
    while (item >= 0 && rs[0].err == 0) {
        if (nodes[item].kind == parse.N_STRUCT) {
            I64 fd = nodes[item].a as I64;
            while (fd >= 0 && rs[0].err == 0) {
                resolve.field_name(src, toks, nodes, diag, rs, item, fd);
                if (rs[0].err != 0) { return rs[0].err; }
                run(src, toks, nodes, sem, syms, names, decls, wk, lits, diag, faults, fres, z, path, rs, cs,
                    K_TYPE, nodes[fd].a as I64, -1);
                if (rs[0].err != 0) { return rs[0].err; }
                resolve.field_type(toks, nodes, sem, decls, diag, rs, fd);
                fd = nodes[fd].next as I64;
            }
        }
        item = nodes[item].next as I64;
    }
    if (rs[0].err != 0) { return rs[0].err; }
    resolve.struct_cycles(toks, nodes, sem, syms, diag, rs, root);
    // The arenas and pools after the structs (`cint_ref` check_memory_decl; box 12).
    item = nodes[root].a as I64;
    while (item >= 0 && rs[0].err == 0) {
        if (resolve.is_memory_decl(nodes, item)) {
            run(src, toks, nodes, sem, syms, names, decls, wk, lits, diag, faults, fres, z, path, rs, cs,
                K_MEMORY, item, 0);
        }
        item = nodes[item].next as I64;
    }
    item = nodes[root].a as I64;
    while (item >= 0 && rs[0].err == 0) {
        if (nodes[item].kind == parse.N_FUNC) {
            run(src, toks, nodes, sem, syms, names, decls, wk, lits, diag, faults, fres, z, path, rs, cs,
                K_SIGNATURE, item, 0);
        }
        item = nodes[item].next as I64;
    }
    // The kernels' signatures after the functions' (`cint_ref` kernel_signature).
    item = nodes[root].a as I64;
    while (item >= 0 && rs[0].err == 0) {
        if (nodes[item].kind == parse.N_KERNEL) {
            run(src, toks, nodes, sem, syms, names, decls, wk, lits, diag, faults, fres, z, path, rs, cs,
                K_SIGNATURE, item, 0);
        }
        item = nodes[item].next as I64;
    }
    if (rs[0].err != 0) { return rs[0].err; }
    if (resolve.resolve_remainder(src, toks, nodes, sem, syms, names, diag, rs, root, decls) != 0) {
        return rs[0].err;
    }
    if (duplicate_test(src, toks, nodes, root, diag, rs)) {
        return rs[0].err;
    }
    I64 x = nodes[root].a as I64;
    while (x >= 0 && rs[0].err == 0) {
        I32 k = nodes[x].kind;
        I32 task = 0;
        I64 a = 0;
        if (k == parse.N_VAR && (nodes[x].flags & parse.F_CONST) != 0) {
            a = sem[x].sym;
            if (syms[a].state != resolve.CS_DONE) {
                task = K_GCONST;
            }
        } else if (k == parse.N_FUNC) {
            task = K_FUNC;
        } else if (k == parse.N_TEST) {
            task = K_TEST;
        } else if (k == parse.N_KERNEL) {
            task = K_KERNEL;
        } else if (k == parse.N_STATIC_ASSERT) {
            rs[0].ctx = resolve.CTX_MODULE;
            cs[0].result = resolve.TY_VOID;
            task = K_STMT;
        } else if (k == parse.N_VAR && rs[0].script < 0 && !resolve.is_memory_decl(nodes, x)) {
            task = K_MODVAR;
        }
        if (task != 0) {
            run(src, toks, nodes, sem, syms, names, decls, wk, lits, diag, faults, fres, z, path, rs, cs, task, x, a);
        }
        x = nodes[x].next as I64;
    }
    if (rs[0].script >= 0 && rs[0].err == 0) {
        rs[0].ctx = resolve.CTX_SCRIPT;
        rs[0].loops = 0;
        cs[0].result = resolve.TY_VOID;
        x = nodes[root].a as I64;
        while (x >= 0 && rs[0].err == 0) {
            if (resolve.is_statement(nodes, x)) {
                run(src, toks, nodes, sem, syms, names, decls, wk, lits, diag, faults, fres, z, path, rs, cs, K_STMT,
                    x, 0);
            }
            x = nodes[x].next as I64;
        }
    }
    if (rs[0].err == 0) {
        state_args(toks, nodes, nn, sem, syms, decls, wk, diag, rs);
    }
    return rs[0].err;
}
