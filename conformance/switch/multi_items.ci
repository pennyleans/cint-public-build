// case: switch/multi_items
// clause: SPEC-04 8.5
// subset: cint-boot-1
// entry: run; args: none
// spec outcome: value I64 84 (the sum of kind(i) * (i + 1) for i = 0 to 9, with kinds 0, 1, 1, 1, 1, 2, 2, 2, 2, 1)

I64 kind(I64 code) {
    switch (code) {
        case 0:
            return 0;
        case 1..=4, 9:
            return 1;
        case 5..=8:
            return 2;
        default:
            return 9;
    }
}

export I64 run() {
    I64 s = 0;
    for i in 0..10 {
        s = s + kind(i) * (i + 1);
    }
    return s;
}
