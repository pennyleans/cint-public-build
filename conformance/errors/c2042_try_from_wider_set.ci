// case: errors/c2042_try_from_wider_set
// clause: SPEC-04 LS-97, LS-129; decision 2026-10-05, BX12-03, BX12-28
// subset: cint-core-1 (error sets, combined sets, `try`)
// entry: run; args: none
// spec outcome: compile error C2042 at 16:13, the `try`: ParseError, the set of run, does not hold the IoError values of IoOrParse (position: first character of the offending construct)

error IoError { closed, full }
error ParseError { empty, bad_digit, too_large }
error IoOrParse = IoError | ParseError;

IoOrParse!I64 read_digit() {
    return .closed;
}

export ParseError!I64 run() {
    I64 d = try read_digit();
    return d;
}
