// entry: run; args: none
// spec outcome: value I64 12, its low 64 bits (as%); prints the I256 value 12 and a line feed; fuel 1 (the entry); state.global wide.module_state_i256 s I256 12, and no line for the array g. Box 15, unit 1

I256[3] g;
I256 s = 7;

export I64 run() {
    g[1] = 5;
    s = s + g[1];
