// case: wide/mul_full_u256
// clause: SPEC-01 IM-6, IM-16, IM-51; SPEC-09 CONF-11 rule 14 (mul_full of U256 gives U512)
// subset: cint-core-1 (unsigned wide integers, built-in mul_full)
// entry: run; args: none
// spec outcome: value I64 2, its low 64 bits (as%); prints the U512 value (2^256 - 1)(2^256 - 2) = 2^512 - 3 * 2^256 + 2 and a line feed; fuel 1. Box 15, unit 1

export I64 run() {
    U256 a = U256.max;
    U256 b = U256.max - 1;
    U512 observed = mul_full(a, b);
    "{observed}\n";
    return observed as% I64;
}
