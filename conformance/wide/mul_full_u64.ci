// case: wide/mul_full_u64
// clause: SPEC-01 IM-6, IM-16, IM-51; SPEC-09 CONF-11 rule 14 (mul_full of U64 gives U128)
// subset: cint-core-1 (unsigned wide integers, built-in mul_full)
// entry: run; args: none
// spec outcome: value I64 1, its low 64 bits (as%); prints the U128 value (2^64 - 1)^2 = 2^128 - 2^65 + 1 and a line feed; fuel 1. Box 15, unit 1

export I64 run() {
    U64 a = U64.max;
    U128 observed = mul_full(a, a);
    "{observed}\n";
    return observed as% I64;
}
