// case: view/nested_array_field_outer_fault
// clause: SPEC-04 LS-64, LS-139, LS-278; SPEC-01 IM-186
// subset: cint-core-1
// entry: run; args: none
// spec outcome: fault E_BOUNDS at the outer index before inner index evaluation

struct O { I64[1] bits; }
I64 seen = 0;
I64 tick(I64 v) { seen = seen * 10 + v; return v; }
export I64 run() { O[1] a; a[tick(1)].bits[tick(0)] = tick(7); return 0; }
