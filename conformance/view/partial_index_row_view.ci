// case: view/partial_index_row_view
// clause: SPEC-04 LS-65, LS-117 (a partial index is a rank-1 view of a row, bound to a size parameter)
// subset: cint-core-1 (rank 2)
// entry: run; args: none
// spec outcome: value I64 5 (row 1 holds 1 and 4); fuel 6 (entry, call, 4 iterations)

I64 total[n](in I64[n] row) {
    I64 s = 0;
    for i in 0..n {
        s = s + row[i];
    }
    return s;
}

export I64 run() {
    I64[3, 4] m;
    m[1, 0] = 1;
    m[1, 3] = 4;
    m[2, 0] = 100;
    return total(m[1]);
}
