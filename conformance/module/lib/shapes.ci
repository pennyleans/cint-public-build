// Helper module of the G-C1 fixtures module/private_struct_c3008 (not a case).

export struct Pt {
    I64 x;
    I64 y;
}

struct Hidden {
    I64 a;
    I64 b;
}

export I64 norm1(Pt p) {
    return p.x + p.y;
}

export I64 hidden_sum(I64 a, I64 b) {
    Hidden h = Hidden(a, b);
    return h.a + h.b;
}
