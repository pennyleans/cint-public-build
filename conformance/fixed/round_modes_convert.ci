// case: fixed/round_modes_convert
// clause: SPEC-01 4.5, IM-68, IM-69 (each rounding mode converting -2.5, -1.25 and 2.5 to I32)
// subset: cint-core-1 (fixed point)
// entry: run; args: none
// spec outcome: value I64 0; prints `-3 -2 -2 -3 -2 -3 -2 -2 -3` and `-2 -1 -1 2 2`; fuel 1. Box 15, unit 1

export I64 run() {
    Q16.16 a = -2.5;
    Q16.16 b = -1.25;
    Q16.16 c = 2.5;
    "{a as I32 round floor} {a as I32 round ceil} {a as I32 round trunc} {a as I32 round away} {a as I32 round half_even} {a as I32 round half_away} {a as I32 round half_trunc} {a as I32 round half_up} {a as I32 round half_down}\n";
    "{b as I32 round floor} {b as I32 round ceil} {b as I32 round half_even} {c as I32} {c as I32 round half_down}\n";
    return 0;
}
