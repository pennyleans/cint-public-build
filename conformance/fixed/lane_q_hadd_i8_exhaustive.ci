// case: fixed/lane_q_hadd_i8_exhaustive
// clause: SPEC-01 IM-190 (`hadd` and `rhadd` on every I8 pair and every Q1.7 pair: floor((A + B) / 2) and floor((A + B + 1) / 2) on the raw values)
// subset: cint-core-1 (fixed point, lane Q)
// entry: run; args: none
// spec outcome: value I64 -8096146201322110976; prints `-8096146201322110976 6295905822029266944` twice (I8, then Q1.7: the raw values are the same), each line with a line feed; the digests equal Python's floor((a + b) / 2) and floor((a + b + 1) / 2) over the same order. S-1 U-1

export I64 run() {
    I64 hi = 0;
    I64 ri = 0;
    I64 hq = 0;
    I64 rq = 0;
    for i in 0..256 {
        I8 a = (i - 128) as I8;
        Q1.7 qa = Q1.7.raw(a);
        for j in 0..256 {
            I8 b = (j - 128) as I8;
            Q1.7 qb = Q1.7.raw(b);
            hi = hi *% 1000003 +% (hadd(a, b) as I64);
            ri = ri *% 1000003 +% (rhadd(a, b) as I64);
            hq = hq *% 1000003 +% (hadd(qa, qb).raw as I64);
            rq = rq *% 1000003 +% (rhadd(qa, qb).raw as I64);
        }
    }
    "{hi} {ri}\n{hq} {rq}\n";
    return hi;
}
