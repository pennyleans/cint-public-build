// case: fixed/lane_q_rshr_shift_fault
// clause: SPEC-01 IM-192, IM-45, IM-134 (`rshr` with a runtime count of 16 on I16 faults E_SHIFT, operation rshr.checked.i16.half_up, operands the value and the count, limit 15)
// subset: cint-core-1 (fixed point, lane Q)
// entry: run; args: none
// spec outcome: fault E_SHIFT at 8:12 (the callee name `rshr`), operation rshr.checked.i16.half_up, operands I16 1000 and I64 16, no exact, limit I64 15; stack depth 1; fuel 3. The value comes from a Q5.11's raw value, so that the frozen seed refuses the program as outside cint-boot-1 (C9100) rather than at the name `rshr`. S-1 U-1

I16 shift(I16 a, I64 k) {
    return rshr(a, k);
}

export I64 run() {
    Q5.11 x = Q5.11.raw(1000);
    I16 a = x.raw;
