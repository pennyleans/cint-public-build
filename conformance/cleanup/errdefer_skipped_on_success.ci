// case: cleanup/errdefer_skipped_on_success
// clause: SPEC-04 LS-185, LS-189; decision 2026-10-05, BX12-08
// subset: cint-core-1 (error sets, `try`, `defer`, `errdefer`, module-level variable)
// entry: run; args: none
// spec outcome: value I64 7, state trail I64 1: run returns success, so the defer runs and the errdefer does not; fuel 2

error ParseError { empty, bad_digit, too_large }

I64 trail = 0;

ParseError!I64 digit(U8 c) {
    if (c < '0' || c > '9') {
        return .bad_digit;
    }
    return (c - '0') as I64;
}

export ParseError!I64 run() {
    defer trail = trail * 10 + 1;
    errdefer trail = trail * 10 + 2;
    I64 d = try digit('7');
    return d;
}
