// subset: cint-boot-1
// entry: run; args: none
// spec outcome: value I64 0: in the constant expression `false && (1 / 0 == 0)` the skipped operand is not evaluated

export I64 run() {
    Bool b = false && (1 / 0 == 0);
    if (b) {
        return 1;
    }
    return 0;
}
