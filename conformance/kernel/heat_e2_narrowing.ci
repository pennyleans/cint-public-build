// spec outcome: fault E_NARROW at 20:24, phase work-item, address dispatch 0, work-item 28, step 25, operation as.checked.i64.i32, operand I64 -6442450941, exact -6442450941, limit I32 -2147483648; stack depth 1, stack 31:5; fuel 65. Box 09 rulings R7 and R9

export kernel diffuse[h, w](
    in  I32[h, w] u,
    in  I64       kn,
    in  I64       kd,
    out I32[h, w] v,
    out I64       total
) over [y: h, x: w] {
    I64 c = u[y, x] as I64;
    I32 r = u[y, x];
    if (y > 0 && y < h - 1 && x > 0 && x < w - 1) {
        I64 lap = (u[y - 1, x] as I64) + (u[y + 1, x] as I64)
                + (u[y, x - 1] as I64) + (u[y, x + 1] as I64) - 4 * c;
        I64 flux = div_round(kn * lap, kd, half_even);
        r = (c + flux) as I32;
    }
    v[y, x] = r;
    reduce total = sum(r);
}

export I64 run() {
    I32[8, 8] a;
    I32[8, 8] b;
    a[3, 4] = 2147483647;
    I64 total = 0;
    diffuse(a, 1, 1, b, total);
    return total;
}
