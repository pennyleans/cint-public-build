// case: kernel/scale_over_2d
// clause: SPEC-02 K-1, K-8, K-9 (the K-1 `scale` kernel, indexed form over a rank-2 space)
// subset: cint-core-1 (kernel)
// entry: run; args: none
// spec outcome: value I64 4214 (b[1, 2] = 42, b[0, 1] = 14); fuel 7 (entry, N = 6). Box 09 ruling R7

kernel scale[h, w](in I32[h, w] a, in I32 k, out I64[h, w] b) over [y: h, x: w] {
    b[y, x] = (a[y, x] as I64) * (k as I64);
}

export I64 run() {
    I32[2, 3] a = [[1, 2, 3], [4, 5, 6]];
    I64[2, 3] b;
    scale(a, 7, b);
    return b[1, 2] * 100 + b[0, 1];
}
