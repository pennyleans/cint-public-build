// case: kernel/fuel_before_overflow
// clause: SPEC-09 BACK-09 (its conformance case), SPEC-02 X-8 items 2 to 4, F-6a item 2
// subset: cint-core-1 (kernel)
// entry: run; args: none; fuel 6001
// spec outcome: fault E_FUEL at 9:5 (the loop keyword), phase work-item, address dispatch 0, work-item 500, step 1 (one counted operation before the first iteration's charge), operation fuel.charge, no operands, no exact, limit I64 6001; stack depth 1, stack 19:5; fuel 6001 (entry 1, N = 1000, then work-items 0 to 499 ten iterations each, so the dispatch consumes 6,000 and F = 5,000); the overflow of work-item 900 at 10:19, which a run without the budget reports, is not reported

kernel count_up[n](in I64[n] a, out I64[n] r) over [i: n] {
    I64 acc = a[i];
    for j in 0..10 {
        acc = acc + 1;
    }
    r[i] = acc;
}

export I64 run() {
    I64[1000] a;
    I64[1000] r;
    a[900] = 9223372036854775807;
    count_up(a, r);
    return r[999];
}
