// case: kernel/inout_copy_in_copy_out
// clause: SPEC-02 K-2, P-4 (a staged `inout` reads pre-dispatch values; unwritten elements keep theirs)
// subset: cint-core-1 (kernel)
// entry: run; args: none
// spec outcome: value I64 233 (t = [2, 3, 3]); fuel 4. Box 09 ruling R7

kernel shift_left[n](inout I64[n] t) over [i: n] {
    if (i + 1 < n) {
        t[i] = t[i + 1];
    }
}

export I64 run() {
    I64[3] t = [1, 2, 3];
    shift_left(t);
    return t[0] * 100 + t[1] * 10 + t[2];
}
