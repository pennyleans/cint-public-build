// case: memory/frame_arena_released_at_block_exit
// clause: SPEC-04 LS-110, LS-318; ref/OPEN.md REF-OQ-45
// subset: cint-core-1 (local arrays, loops)
// entry: run; args: none
// spec outcome: value I64 3 (0 + 1 + 2): each iteration's 1,500,000 elements are released when its block exits, so the 2,000,000 elements after the loop fit; fuel 4 (entry, 3 iterations)

export I64 run() {
    I64 s = 0;
    for i in 0..3 {
        I64[1_500_000] big;
        big[1_499_999] = i;
        s += big[1_499_999];
    }
    I64[2_000_000] after;
    return s + after[0];
}
