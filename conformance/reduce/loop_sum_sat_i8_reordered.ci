// case: reduce/loop_sum_sat_i8_reordered
// clause: SPEC-01 IM-73, IM-84 (the same elements in another order give another saturating total)
// subset: cint-core-1
// entry: run; args: none
// spec outcome: value I8 120 (0 +| 120 = 120; 120 +| -120 = 0; 0 +| 120 = 120); fuel 5

I8 fold_sat[n](in I8[n] xs) {
    I8 acc = 0;
    for i in 0..n {
        acc = acc +| xs[i];
    }
    return acc;
}

export I8 run() {
    I8[3] a;
    a[0] = 120;
    a[1] = -120;
    a[2] = 120;
    return fold_sat(a);
}
