// case: ternary/pt4_planes
// clause: SPEC-05 TR-PT4-1 to TR-PT4-3, TR-VAL-4, 9.1 (PT4 fields of every U8 value by sign extension and by bit planes; 32 fields of a U64 word deinterleaved into two planes; PT4 to PT5 repacking)
// subset: cint-core-1 (print statements)
// entry: run; args: none
// spec outcome: value I64 0 (81 valid bytes decode alike both ways and round trip, 175 bytes with a field 10 are flagged and the plane path reads that field as 0, and every word's planes match its fields); 280 output lines
// t27 set 1 (docs/design/notes/2026-10-05-t27-ternary-tests-scoping.md 5.2), with SPEC-05 12.2 PT4-01 to PT4-06.
// Where a fixture expects a fault of decode_pt4, the case prints the verdict the fault reports, not the fault record.
// Field d (0 to 3) of a byte is bits 2d and 2d + 1. Sign extension reads field f as f - ((f & 2) << 1); the plane
// path of 9.1 reads nonzero = bit 0 and negative = bit 1, P = nonzero & ~negative, N = nonzero & negative, so the
// invalid field 10 reads as 0, which 9.1 admits.
// Words: 8 raw words sm(44, i), i from 0 to 7, and 8 valid words whose field j holds the trit sm(45, 32i + j) % 3 - 1,
// with sm(s, i) output i (from 0) of SplitMix64 seeded with s, as in ternary/planes_add27.
// Output: one line per byte value 00 to ff, a count line, one line per word (its planes, its invalid fields, and for a
// valid word its 32 trits repacked as 7 PT5 bytes), one line per fixture, then the mismatch count.

const U64 GAMMA = 0x9E37_79B9_7F4A_7C15;
const U64 EVEN = 0x5555_5555_5555_5555;

U64 mix(U64 z0) {
    U64 z = (z0 ^ (z0 >> 30)) *% 0xBF58_476D_1CE4_E5B9;
    z = (z ^ (z >> 27)) *% 0x94D0_49BB_1331_11EB;
    return z ^ (z >> 31);
}

U64 sm(U64 seed, I64 i) {
    return mix(seed +% ((i as U64) +% 1) *% GAMMA);
}

U64 field(U64 w, I64 d) {
    return (w >> (2 * d)) & 3;
}

I64 sign_extend(U64 f) {
    return (f as I64) - (((f & 2) << 1) as I64);
}

I64 plane_trit(U64 f) {
    U64 nz = f & 1;
    U64 neg = (f >> 1) & 1;
    return ((nz & ~neg) as I64) - ((nz & neg) as I64);
}

U64 field_of(I64 t) {
    return t == 1 ? 1 : (t == -1 ? 3 : 0);
}

// The even bits of x gathered into its low 32 bits.
U64 even_bits(U64 x0) {
    U64 x = x0 & EVEN;
    x = (x | (x >> 1)) & 0x3333_3333_3333_3333;
    x = (x | (x >> 2)) & 0x0F0F_0F0F_0F0F_0F0F;
    x = (x | (x >> 4)) & 0x00FF_00FF_00FF_00FF;
    x = (x | (x >> 8)) & 0x0000_FFFF_0000_FFFF;
    x = (x | (x >> 16)) & 0x0000_0000_FFFF_FFFF;
    return x;
}

// One word: its planes against its 32 fields read one at a time.
I64 word(U64 w) {
    I64 bad = 0;
    U64 nz = even_bits(w);
    U64 neg = even_bits(w >> 1);
    U64 p = nz & ~neg;
    U64 n = nz & neg;
    I64 invalid = 0;
    for j in 0..32 {
        U64 f = field(w, j);
        invalid += f == 2 ? 1 : 0;
        bad += ((((p >> j) & 1) as I64) - (((n >> j) & 1) as I64)) != plane_trit(f) ? 1 : 0;
    }
    "word {w:016x}: plus {p:08x} minus {n:08x} invalid fields {invalid}";
    if (invalid == 0) {
        " pt5";
        for j in 0..7 {
            I64 b = 0;
            for e in 0..5 {
                I64 i = 5 * j + 4 - e;
                I64 t = i < 32 ? (((p >> i) & 1) as I64) - (((n >> i) & 1) as I64) : 0;
                b = b * 3 + t;
            }
            U8 ub = b as% U8;
            " {ub:02x}";
        }
    }
    "\n";
    return bad;
}

// The verdict of decode_pt4 on a row of nb bytes holding k trits: the first invalid byte in row order, or -1. A byte
// with both faults reports the reason of its lowest bad field; no fixture has both in one byte.
I64 verdict[nb](in U8[nb] row, I64 k) {
    I64 at = -1;
    I64 why = 0;
    for j in 0..nb {
        for d in 0..4 {
            U64 f = field(row[j] as U64, d);
            if (at < 0 && f == 2) {
                at = j;
                why = 1;
            } else if (at < 0 && 4 * j + d >= k && f != 0) {
                at = j;
                why = 2;
            }
        }
    }
    for j in 0..nb {
        " {row[j]:02x}";
    }
    " k {k}:";
    if (at < 0) {
        " valid, trits";
        for i in 0..k {
            " {sign_extend(field(row[i / 4] as U64, i % 4))}";
        }
        "\n";
    } else if (why == 1) {
        " byte {at} invalid field\n";
    } else {
        " byte {at} nonzero padding\n";
    }
    return at;
}

export I64 run() {
    I64 bad = 0;
    I64 nvalid = 0;
    for v in 0..256 {
        U64 w = v as U64;
        U8 ub = v as U8;
        Bool ok = true;
        for d in 0..4 {
            ok = ok && field(w, d) != 2;
        }
        if (ok) {
            nvalid += 1;
            "{ub:02x}: {sign_extend(field(w, 0))} {sign_extend(field(w, 1))} {sign_extend(field(w, 2))} {sign_extend(field(w, 3))}\n";
            U64 back = 0;
            for d in 0..4 {
                bad += sign_extend(field(w, d)) != plane_trit(field(w, d)) ? 1 : 0;
                back = back | (field_of(sign_extend(field(w, d))) << (2 * d));
            }
            bad += back != w ? 1 : 0;
        } else {
            "{ub:02x}: invalid, planes read {plane_trit(field(w, 0))} {plane_trit(field(w, 1))} {plane_trit(field(w, 2))} {plane_trit(field(w, 3))}\n";
        }
    }
    "valid {nvalid}, invalid {256 - nvalid}\n";
    bad += nvalid != 81 ? 1 : 0;

    for i in 0..8 {
        bad += word(sm(44, i));
    }
    for i in 0..8 {
        U64 w = 0;
        for j in 0..32 {
            I64 t = ((sm(45, 32 * i + j) % 3) as I64) - 1;
            w = w | (field_of(t) << (2 * j));
        }
        bad += word(w);
    }

    U8[1] one;
    U8[2] two;
    U64 a = field_of(1) | (field_of(-1) << 2) | (field_of(0) << 4) | (field_of(1) << 6);
    U8 a8 = a as U8;
    "PT4-01 [1, -1, 0, 1]: {a8:02x}\n";
    U8 b8 = field_of(-1) as U8;
    "PT4-02 [1, -1, 0, 1, -1]: {a8:02x} {b8:02x}\n";
    bad += a8 != 0x4d || b8 != 0x03 ? 1 : 0;
    one[0] = 0x02;
    "PT4-03";
    bad += verdict(one, 4) != 0 ? 1 : 0;
    two[0] = 0x4d;
    two[1] = 0x07;
    "PT4-04";
    bad += verdict(two, 5) != 1 ? 1 : 0;
    // PT4-05: repack5 of PT4 71 01 (5 trits) is PT5 64.
    two[0] = 0x71;
    two[1] = 0x01;
    I64 b = 0;
    for e in 0..5 {
        I64 i = 4 - e;
        b = b * 3 + sign_extend(field(two[i / 4] as U64, i % 4));
    }
    U8 r5 = b as% U8;
    "PT4-05 71 01 n 5: pt5 {r5:02x}\n";
    bad += r5 != 0x64 ? 1 : 0;
    "PT4-06 the valid bytes round trip: {nvalid}\n";
    "mismatches {bad}\n";
    return bad;
}
