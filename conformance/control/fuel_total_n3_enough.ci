// case: control/fuel_total_n3_enough
// clause: SPEC-01 10.2
// subset: cint-boot-1
// entry: total; args: I64[3] [1, 2, 3]; fuel 4
// spec outcome: value I64 6; fuel consumed 4 (call 1, three iterations)

export I64 total[n](in I64[n] xs) {
    I64 s = 0;
    for (I64 i = 0; i < n; i++) {
        s = s + xs[i];
    }
    return s;
}
